+// The one property the audio server writes (through the connection): "exclusive access owner", the pid holding hog mode,
+// or -1. It takes hog mode on the device before it builds its ports and gives up if refused. Other keys are accepted and
+// ignored.
+IOReturn
+IcelandAudioDevice::apply(OSObject *properties, IORegistryEntry *client)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	if (OSNumber *owner = OSDynamicCast(OSNumber, d->getObject("exclusive access owner"))) {
+		IOLockLock(lock);
+		hogOwner = int32_t(owner->unsigned32BitValue());
+		IOLockUnlock(lock);
+		setNumber(this, "exclusive access owner", uint32_t(hogOwner));
+		if (client) {
+			setNumber(client, "exclusive access owner", uint32_t(hogOwner));
+		}
+		IOLog("icesnddev: exclusive access owner %d\n", hogOwner);
+	}
+	return kIOReturnSuccess;
+}
