+bool
+IcelandAudioDevice::initDevice(bool input)
+{
+	if (!super::init(nullptr)) {
+		return false;
+	}
+	isInput = input;
+	hogOwner = -1;
+	lock = IOLockAlloc();
+	statusMemory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kShared, page_size, page_size);
+	ring = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kShared, kRingFrames * 2 * channels(), page_size);
+	if (!lock || !statusMemory || !ring) {
+		return false;
+	}
+	bzero(statusMemory->getBytesNoCopy(), page_size);
+	bzero(ring->getBytesNoCopy(), ring->getLength());
+	return true;
+}
+
+void
+IcelandAudioDevice::free()
+{
+	OSSafeReleaseNULL(statusMemory);
+	OSSafeReleaseNULL(ring);
+	if (lock) {
+		IOLockFree(lock);
+	}
+	lock = nullptr;
+	super::free();
+}
+
+// The description the audio server caches and classifies the device by. Published on the device and copied onto each user
+// client, since the server reads some keys through the service and some through the connection.
+void
+IcelandAudioDevice::publish(IORegistryEntry *e)
+{
+	// The audio server's VirtualAudio layer picks the physical-device class by the UID (piano's note): "Speaker", "Mic".
+	const char *uid = isInput ? "Mic" : "Speaker";
+	e->setProperty("device UID", uid);
+	e->setProperty("device name", uid);
+	e->setProperty("device manufacturer", "Apple Inc.");
+	e->setProperty("model UID", uid);
+	setNumber(e, "transport type", kTransportBuiltIn);
+	setNumber(e, "clock domain", 1);        // the server warns that a built-in device in clock domain 0 is unusual
+	setNumber(e, "output latency", kLatency);
+	setNumber(e, "input latency", kLatency);
+	setNumber(e, "output safety offset", kSafetyOffset);
+	setNumber(e, "input safety offset", kSafetyOffset);
+	setNumber(e, "io buffer frame size", kRingFrames);
+	setNumber(e, "sample rate", uint64_t(fixed64(kRate)), 64);
+	setNumber(e, "exclusive access owner", uint32_t(hogOwner));
+	e->setProperty("is running", running ? kOSBooleanTrue : kOSBooleanFalse);
+	e->setProperty("is private", kOSBooleanFalse);
+	e->setProperty("supports prewarming", kOSBooleanFalse);
+	e->setProperty("supports client description", kOSBooleanFalse);
+	e->setProperty("wants output trap", kOSBooleanFalse);
+	e->setProperty("wants input trap", kOSBooleanFalse);
+	// One direction each: the speaker device has an output stream, the microphone device an input stream.
+	if (OSArray *a = streams(channels(), isInput ? uint32_t(kTerminalMicrophone) : uint32_t(kTerminalSpeaker))) {
+		e->setProperty(isInput ? "input streams" : "output streams", a);
+		a->release();
+	}
+	if (OSArray *a = OSArray::withCapacity(1)) {
+		e->setProperty("controls", a);
+		a->release();
+	}
+	e->setProperty("iceland-audio-transport", "redwood-audio");
+}
+
+bool
+IcelandAudioDevice::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	publish(this);
+	setProperty("IOUserClientClass", "IcelandAudioUserClient");
+	registerService();
+	return true;
+}
