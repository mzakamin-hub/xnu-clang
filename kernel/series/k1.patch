+	if (fence != 0 && gGPULock != NULL) {
+		IOLockLock(gGPULock);
+		if (redwood_gpu_ready() && dada_gpu_rings()) {
+			/* (each ring's last that named it: a widget's drawing on ring 1 may still go on after backboardd's on ring 0) */
+			done = gpuWaitList(surface->drawnOn, 2, milliseconds);
+		} else {
+			done = !redwood_gpu_ready() || gpuWait(fence, milliseconds);
+		}
+		IOLockUnlock(gGPULock);
+	}
+	return done;
+}
