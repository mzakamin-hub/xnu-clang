+/* apm_module_param_data */
+static void
+au_param(uint8_t **o, uint32_t iid, uint32_t param_id, uint32_t size)
+{
+	au_put(o, iid);
+	au_put(o, param_id);
+	au_put(o, size);
+	au_put(o, 0);
+}
