+	.d_open = icegpu_open, .d_close = icegpu_close, .d_read = eno_rdwrt, .d_write = eno_rdwrt,
+	.d_ioctl = icegpu_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
