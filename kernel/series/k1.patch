+	    !read_ok ? "A READ FAILED" : loud ? "ABOVE STOCK" : !lim_ok || (uint32_t)((v >> 8) & 0xff) != amp_dcvos ||
+	    ((g >> 5) & 0x1f) != 5 ? "NOT AS STOCK" : "AS STOCK");
