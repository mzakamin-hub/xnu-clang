+/*
+ * audioreach_alloc_graph_pkt's payload for the one sub-graph / container / three modules (352 bytes); `fe_conn`
+ * (level D, icetone=2, Linux's order): + the FE-BE connection the BE's graph carries in Linux (topology.c
+ * audioreach_connect_sub_graphs puts it into the mixer's -- the back end's -- graph info: the stream's LOG 24582 output
+ * port 1 -> the back end's MFC 0x6062 input port 2; audioreach_populate_graph lists it first): 368 bytes
+ */
+#define TONE_IID_LOG            24582u
+static uint32_t
+au_graph_open(uint8_t *b, bool fe_conn)
+{
+	uint8_t *o = b;
+
+	/* sub-graph config: param data 16 + num 4 + apm_sub_graph_data 44 = 64 */
+	au_param(&o, APM_IID, 0x08001001, 64 - 16);
+	au_put(&o, 1);
+	au_put(&o, AU_SG); au_put(&o, 3);
+	au_put(&o, 0x0800100E); au_put(&o, 4); au_put(&o, AU_PERF_LOW_LATENCY);
+	au_put(&o, 0x0800100F); au_put(&o, 4); au_put(&o, 1);          /* direction TX */
+	au_put(&o, 0x08001010); au_put(&o, 4); au_put(&o, 1);          /* scenario: playback */
+	/* container config: 16 + 4 + apm_container_obj 60 = 80 */
+	au_param(&o, APM_IID, 0x08001000, 80 - 16);
+	au_put(&o, 1);
+	au_put(&o, AU_CONT); au_put(&o, 4);
+	au_put(&o, 0x08001011); au_put(&o, 8); au_put(&o, 1); au_put(&o, AU_CONT_TYPE_GC);
+	au_put(&o, 0x08001012); au_put(&o, 4); au_put(&o, 1);                          /* graph position: stream */
+	au_put(&o, 0x08001013); au_put(&o, 4); au_put(&o, 8192);                       /* stack size */
+	au_put(&o, 0x08001014); au_put(&o, 4); au_put(&o, 2);                          /* processor domain: ADSP */
+	/* module list: sizeof(apm_module_list_params) 20 + apm_mod_list_obj 12 + 3 x 8 = 56 */
+	au_param(&o, APM_IID, 0x08001002, 56 - 16);
+	au_put(&o, 1);
+	au_put(&o, AU_SG); au_put(&o, AU_CONT); au_put(&o, 3);
+	au_put(&o, AU_MOD_MFC); au_put(&o, AU_IID_MFC);
+	au_put(&o, AU_MOD_LOG); au_put(&o, AU_IID_LOG);
+	au_put(&o, AU_MOD_TDM); au_put(&o, AU_IID_TDM);
+	/* module properties: 16 + 4 + 3 x 24 = 92, aligned 96 */
+	au_param(&o, APM_IID, 0x08001003, 96 - 16);
+	au_put(&o, 3);
+	au_put(&o, AU_IID_MFC); au_put(&o, 1); au_put(&o, 0x08001015); au_put(&o, 8); au_put(&o, 1); au_put(&o, 1);
+	au_put(&o, AU_IID_LOG); au_put(&o, 1); au_put(&o, 0x08001015); au_put(&o, 8); au_put(&o, 1); au_put(&o, 1);
+	au_put(&o, AU_IID_TDM); au_put(&o, 1); au_put(&o, 0x08001015); au_put(&o, 8); au_put(&o, 1); au_put(&o, 0);
+	au_put(&o, 0);
+	/* module connections: 16 + 4 + 2 x 16 = 52, aligned 56 (+ the FE-BE one: 68, aligned 72) */
+	au_param(&o, APM_IID, 0x08001004, (fe_conn ? 72 : 56) - 16);
+	au_put(&o, fe_conn ? 3 : 2);
+	if (fe_conn) {
+		au_put(&o, TONE_IID_LOG); au_put(&o, 1); au_put(&o, AU_IID_MFC); au_put(&o, 2);
+	}
+	au_put(&o, AU_IID_MFC); au_put(&o, 1); au_put(&o, AU_IID_LOG); au_put(&o, 2);
+	au_put(&o, AU_IID_LOG); au_put(&o, 1); au_put(&o, AU_IID_TDM); au_put(&o, 2);
+	au_put(&o, 0);                  /* (pad to 8: 52 -> 56, 68 -> 72) */
+	return (uint32_t)(o - b);
+}
+
+/* q6apm_graph_mgmt_cmd for one sub-graph (16 + 4 + 4 = 24) */
+static uint32_t
+au_mgmt(uint8_t *b, uint32_t sg)
+{
+	uint8_t *o = b;
+
+	au_param(&o, APM_IID, 0x08001005, 24 - 16);
+	au_put(&o, 1);
+	au_put(&o, sg);
+	return (uint32_t)(o - b);
+}
+
+/* level D (built after C1; defined after the amplifiers' code): the stream graph, the amplifiers, the tone */
+static bool tone_fe_open(struct gchan *apps, bool fe_conn);
+static void tone_fe_close(struct gchan *apps);
+static bool tone_play(struct gchan *apps, vm_offset_t tlmm, uint32_t mode);
+static bool audio_tone(struct gchan *apps, uint32_t mode, uint32_t audio, uint32_t smmu);
+
+static uint32_t au_found_ctl[4];
+
+static void
+au_pins(vm_offset_t tlmm, bool on)
+{
+	for (unsigned i = 0; i < 4; i++) {
+		vm_offset_t ctl = tlmm + 0x1000UL * au_pins_n[i];
+
+		if (on) {
+			uint32_t v;
+
+			au_found_ctl[i] = rd(ctl);
+			v = (au_found_ctl[i] & ~0x3ffu) | 1u << 2 | (au_pin_ma[i] / 2 - 1) << 6;   /* no pull, function 1 */
+			if (v & (1u << 11)) {
+				v |= 1u << 12;
+			}
+			wr(ctl, v);
+		} else {
+			wr(ctl, au_found_ctl[i]);
+		}
+	}
+	settle();
+	say("audio: TDM pins %s: gpio122 %#x, gpio123 %#x, gpio124 %#x, gpio125 %#x\n", on ? "set (i2s0_*)" : "given back",
+	    rd(tlmm + 0x1000UL * 122), rd(tlmm + 0x1000UL * 123), rd(tlmm + 0x1000UL * 124), rd(tlmm + 0x1000UL * 125));
+}
+
+/* the clock and frame-sync pads sampled (their input bit follows the pad in any function): both levels = running */
+static void
+au_sample(vm_offset_t tlmm, const char *when)
+{
+	unsigned hi_sck = 0, hi_ws = 0, n = 4000;
+
+	for (unsigned i = 0; i < n; i++) {
+		hi_sck += rd(tlmm + 0x1000UL * 122 + 4) & 1;
+		hi_ws += rd(tlmm + 0x1000UL * 125 + 4) & 1;
+	}
+	say("audio: %s: bit clock pad high %u of %u, frame sync pad high %u of %u (%s)\n", when, hi_sck, n, hi_ws, n,
+	    hi_sck > 0 && hi_sck < n && hi_ws > 0 && hi_ws < n ? "BOTH TOGGLE: the TDM clock runs" : "not toggling");
+}
+
+/*
+ * tone 0: C1 alone. tone 1 / 2 (level D, from audio_tone with C2 set up): the back end as C1, and once it runs silence
+ * tone_play (the stream graph, the amplifiers, the tone) instead of the hold; tone 2 = Linux's order: the stream graph
+ * opened first, the FE-BE connection in the back end's GRAPH_OPEN. The stream graph is always closed before the back
+ * end. Returns C1's result, *tone_ok the tone's.
+ */
+static bool
+audio_c1(struct gchan *apps, uint32_t tone, bool *tone_ok)
+{
+	uint8_t b[400], *o;
+	uint32_t hold_s = 3;
+	vm_offset_t tlmm;
+	bool clock = false, opened = false, ok = true, fe_first = false;
+	int32_t s;
+
+	PE_parse_boot_argn("iceaudio_hold", &hold_s, sizeof(hold_s));
+	if (hold_s > 10) {
+		hold_s = 10;
+	}
+	tlmm = ml_io_map(0x0f100000UL, 0xb0000UL);
+	if (tlmm == 0) {
+		return false;
+	}
+	mark(M_AUDIO, MARK_BUSY);
+	say("audio: level C1: the speakers' back end (PRIMARY_TDM_RX_0), silence; %s\n", tone ?
+	    "then level D's tone through the stream graph" : "amplifiers untouched");
+	if (tone == 2) {
+		fe_first = tone_fe_open(apps, false);
+		if (!fe_first) {
+			say("audio: level D (Linux's order): the stream graph did not open: the back end is not started\n");
+			mark(M_AUDIO, MARK_FAIL);
+			return false;
+		}
+	}
+	au_sample(tlmm, "before");
+	au_pins(tlmm, true);
+	o = b;
+	au_param(&o, GPR_PRM_IID, PARAM_ID_RSC_AUDIO_HW_CLK, 4 + 16);
+	au_put(&o, 1);
+	au_put(&o, CLK_PRI_TDM_IBIT); au_put(&o, TDM_BCLK_HZ); au_put(&o, 1); au_put(&o, 0);
+	s = gpr_call(apps, GPR_PRM_IID, PRM_REQUEST_HW_RSC, b, (uint32_t)(o - b), PRM_RSP_REQUEST_HW_RSC,
+	    "PRM: PRI_TDM_IBIT 12.288 MHz requested");
+	clock = s == 0;
+	ok = clock;
+	if (ok) {
+		uint32_t n = au_graph_open(b, fe_first);
+
+		s = gpr_call(apps, APM_IID, APM_CMD_GRAPH_OPEN_, b, n, 0xffffffffu, fe_first ?
+		    "APM: GRAPH_OPEN sub-graph 0x4006 + the FE-BE connection LOG 24582:1 -> MFC 0x6062:2" :
+		    "APM: GRAPH_OPEN sub-graph 0x4006");
+		opened = s == 0;
+		ok = opened;
+	}
+	if (ok) {
+		o = b;
+		au_param(&o, AU_IID_MFC, 0x08001024, 24);
+		au_put(&o, 48000); au_put16(&o, 32); au_put16(&o, 8);
+		PE_parse_boot_argn("icesnd_six", &au_six, sizeof(au_six));
+		if (au_six) {           /* FL FR four times: every amplifier's slot carries its side */
+			for (unsigned i = 0; i < 4; i++) {
+				au_put16(&o, 1); au_put16(&o, 2);
+			}
+		} else {                /* (until round 6) FL FR FC LFE LS RS LB RB: only slots 0 / 1 carry sound */
+			au_put16(&o, 1); au_put16(&o, 2); au_put16(&o, 3); au_put16(&o, 6);
+			au_put16(&o, 4); au_put16(&o, 5); au_put16(&o, 8); au_put16(&o, 9);
+		}
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, (uint32_t)(o - b), 0xffffffffu, au_six ?
+		    "APM: MFC output 48 kHz / 32 bit / 8 ch, map FL FR x 4 (all six amplifiers fed, as Linux and stock)" :
+		    "APM: MFC output 48 kHz / 32 bit / 8 ch, map FL FR FC LFE LS RS LB RB (icesnd_six=0: the top pair only)") == 0;
+	}
+	if (ok) {
+		o = b;
+		au_param(&o, AU_IID_LOG, 0x08001026, 4);
+		au_put(&o, 1);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, (uint32_t)(o - b), 0xffffffffu, "APM: LOG enabled") == 0;
+	}
+	if (ok) {
+		o = b;
+		au_param(&o, AU_IID_LOG, 0x08001031, 12);
+		au_put(&o, 0x19ab); au_put(&o, 1); au_put(&o, 0);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, (uint32_t)(o - b), 0xffffffffu,
+		    "APM: LOG code 0x19ab tap 1") == 0;
+	}
+	if (ok) {   /* TDM: interface (44 -> 48), hardware endpoint format (28 -> 32), frame size factor (20 -> 24) */
+		bzero(b, 104);
+		o = b;
+		au_param(&o, AU_IID_TDM, 0x0800101B, 48 - 16);
+		au_put(&o, 0); au_put(&o, 0);
+		au_put16(&o, 1); au_put16(&o, 1);
+		au_put(&o, 0xff);
+		au_put16(&o, 8); au_put16(&o, 32);
+		au_put16(&o, 1); au_put16(&o, 0); au_put16(&o, 1); au_put16(&o, 0);
+		o = b + 48;
+		au_param(&o, AU_IID_TDM, 0x08001017, 32 - 16);
+		au_put(&o, 48000); au_put16(&o, 32); au_put16(&o, 8); au_put(&o, 1);
+		o = b + 80;
+		au_param(&o, AU_IID_TDM, 0x08001018, 24 - 16);
+		au_put(&o, 1);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, 104, 0xffffffffu,
+		    "APM: TDM 8 x 32 bit, 48 kHz, internal sync, long sync, delay 1") == 0;
+	}
+	if (ok) {
+		uint32_t n = au_mgmt(b, AU_SG);
+
+		ok = gpr_call(apps, APM_IID, APM_CMD_GRAPH_PREPARE_, b, n, 0xffffffffu, "APM: GRAPH_PREPARE") == 0;
+	}
+	if (ok) {
+		uint32_t n = au_mgmt(b, AU_SG);
+
+		ok = gpr_call(apps, APM_IID, APM_CMD_GRAPH_START_, b, n, 0xffffffffu, "APM: GRAPH_START") == 0;
+	}
+	if (ok && tone) {
+		say("audio: THE SPEAKER BACK END RUNS (silence): level D next\n");
+		au_sample(tlmm, "running");
+		*tone_ok = tone_play(apps, tlmm, tone);         /* (closes the stream graph itself) */
+		au_sample(tlmm, "after the tone, before the back end's stop");
+	} else if (ok) {
+		say("audio: THE SPEAKER BACK END RUNS (silence) -- held %u s\n", hold_s);
+		au_sample(tlmm, "running");
+		for (uint32_t i = 0; i < hold_s * 10; i++) {
+			g_pump();
+			sleep_ms(100);
+		}
+		au_sample(tlmm, "before the stop");
+	}
+	if (tone) {
+		tone_fe_close(apps);    /* (no-op unless the stream graph is still open: a failure before tone_play) */
+	}
+	if (opened) {
+		uint32_t n = au_mgmt(b, AU_SG);
+
+		(void)gpr_call(apps, APM_IID, APM_CMD_GRAPH_STOP_, b, n, 0xffffffffu, "APM: GRAPH_STOP");
+		n = au_mgmt(b, AU_SG);
+		(void)gpr_call(apps, APM_IID, APM_CMD_GRAPH_CLOSE_, b, n, 0xffffffffu, "APM: GRAPH_CLOSE");
+	}
+	if (clock) {
+		o = b;
+		au_param(&o, GPR_PRM_IID, PARAM_ID_RSC_AUDIO_HW_CLK, 4 + 4);
+		au_put(&o, 1);
+		au_put(&o, CLK_PRI_TDM_IBIT);
+		(void)gpr_call(apps, GPR_PRM_IID, PRM_RELEASE_HW_RSC, b, (uint32_t)(o - b), PRM_RSP_RELEASE_HW_RSC,
+		    "PRM: PRI_TDM_IBIT released");
+	}
+	au_pins(tlmm, false);
+	au_sample(tlmm, "after");
+	say("audio: level C1 %s\n", ok ? "PASS: opened, configured, started, stopped, closed, released" :
+	    "FAILED (see the step above; whatever was opened was closed again)");
+	mark(M_AUDIO, ok ? MARK_OK : MARK_FAIL);
+	return ok;
+}
+
+/*
+ * ---- apps SMMU, stream 0x1001 (q6apm-dais), read only (boot-arg iceaudio=1) ---------------------------------------
+ * apps_smmu: iommu@15000000 (0x100000, arm,mmu-500), as arm-smmu.h: sCR0 0x0, ID0 0x20 (NUMSMRG 7:0), ID1 0x24
+ * (PAGESIZE 31, NUMPAGENDXB 30:28, NUMCB 7:0); SMR(n) 0x800 + 4n (VALID 31, MASK 30:16, ID 15:0); S2CR(n) 0xc00 + 4n
+ * (TYPE 17:16: 0 translate, 1 bypass, 2 fault; CBNDX 7:0); GR1 = one page up, CBAR(n) = GR1 + 4n (TYPE 17:16, VMID
+ * 7:0); the context banks NUMPAGE pages up: SCTLR 0x0, TTBR0 0x20, TCR 0x30. Reads only; a bank is read only when an
+ * SMR matching the stream routes it there (a bank secure to us reads as zero, a non-secure read cannot fault).
+ */
+static void
+smmu_survey(void)
+{
+	/* q6apm-dais (audio data, 0x1001) and the ADSP FastRPC compute banks (sensor level 12, 0x1003-0x1007) */
+	static const uint32_t streams[6] = { 0x1001, 0x1003, 0x1004, 0x1005, 0x1006, 0x1007 };
+	vm_offset_t base = ml_io_map(0x15000000UL, 0x100000UL);
+	uint32_t id0, id1, nsmr, ncb, page, npage;
+
+	if (base == 0) {
+		return;
+	}
+	id0 = rd(base + 0x20);
+	id1 = rd(base + 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	page = (id1 >> 31) ? 0x10000 : 0x1000;
+	npage = 1u << (((id1 >> 28) & 7) + 1);
+	say("smmu: apps SMMU: sCR0 %#x, ID0 %#x (%u stream match registers), ID1 %#x (%u context banks, %u KB pages, "
+	    "banks from +%#x)\n", rd(base), id0, nsmr, id1, ncb, page / 1024, npage * page);
+	for (unsigned k = 0; k < 6; k++) {
+		uint32_t sid = streams[k], matches = 0;
+
+		for (uint32_t n = 0; n < nsmr && n < 128; n++) {
+			uint32_t smr = rd(base + 0x800 + 4 * n), id = smr & 0xffff, mask = (smr >> 16) & 0x7fff, s2cr;
+
+			if (!(smr >> 31) || ((sid ^ id) & ~mask & 0x7fff) != 0) {
+				continue;
+			}
+			matches++;
+			s2cr = rd(base + 0xc00 + 4 * n);
+			say("smmu: stream %#x matches SMR %u = %#x (id %#x mask %#x): S2CR %#x (type %u = %s, bank %u)\n", sid, n,
+			    smr, id, mask, s2cr, (s2cr >> 16) & 3, ((s2cr >> 16) & 3) == 0 ? "translate" : ((s2cr >> 16) & 3) == 1 ?
+			    "bypass" : "fault", s2cr & 0xff);
+			if (((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) < ncb &&
+			    npage * page + ((s2cr & 0xff) + 1) * page <= 0x100000) {
+				uint32_t cb = s2cr & 0xff, cbar = rd(base + page + 4 * cb);
+				vm_offset_t cbb = base + npage * page + cb * page;
+
+				say("smmu:   bank %u: CBAR %#x (type %u, vmid %u), SCTLR %#x (M %u), TCR %#x, TTBR0 %#x_%08x\n", cb,
+				    cbar, (cbar >> 16) & 3, cbar & 0xff, rd(cbb), rd(cbb) & 1, rd(cbb + 0x30), rd(cbb + 0x24),
+				    rd(cbb + 0x20));
+			}
+		}
+		say("smmu: stream %#x: %u matching stream match register(s)%s\n", sid, matches, matches ? "" :
+		    " -- none: not configured (the unmatched-stream default of sCR0 applies)");
+	}
+	/*
+	 * For audio C2's design (read only): which stream match registers are free (VALID 0), which context banks are
+	 * routed to by a valid S2CR, and which banks look unused (not routed, SCTLR.M 0, CBAR 0). A bank secure to us
+	 * reads as zero, so "looks unused" is only a candidate -- the design re-reads it right before any use.
+	 */
+	{
+		static uint8_t routed[256];
+		char line[200];
+		int n = 0;
+		uint32_t valid = 0, free_smr = 0, cand = 0, busy = 0;
+
+		bzero(routed, sizeof(routed));
+		line[0] = 0;
+		for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+			uint32_t smr = rd(base + 0x800 + 4 * i), s2cr = rd(base + 0xc00 + 4 * i);
+
+			if (smr >> 31) {
+				valid++;
+				if (((s2cr >> 16) & 3) == 0) {
+					routed[s2cr & 0xff] = 1;
+				}
+			} else {
+				if (free_smr < 12 && n < (int)sizeof(line) - 8) {
+					n += snprintf(line + n, sizeof(line) - (size_t)n, " %u", i);
+				}
+				free_smr++;
+			}
+		}
+		say("smmu: %u of %u stream match registers valid, %u free; first free:%s\n", valid, nsmr, free_smr, line);
+		n = 0;
+		line[0] = 0;
+		for (uint32_t cb = 0; cb < ncb && npage * page + (cb + 1) * page <= 0x100000; cb++) {
+			uint32_t sctlr = rd(base + npage * page + cb * page), cbar = rd(base + page + 4 * cb);
+
+			if (routed[cb] || (sctlr & 1) || cbar != 0) {
+				busy++;
+				continue;
+			}
+			if (cand < 12 && n < (int)sizeof(line) - 8) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " %u", cb);
+			}
+			cand++;
+		}
+		say("smmu: %u of %u context banks routed or set up, %u look unused; first unused:%s\n", busy, ncb, cand, line);
+	}
+}
+
+/*
+ * ---- Audio level C2 (boot-arg icesmmu=1, OFF by default: the owner's decision) -------------------------------------
+ * Option A of ICELAND-PLAN's morning question: the DSP's audio streams reach ONE buffer of ours through a context bank
+ * of ours. As Linux's arm-smmu / io-pgtable-arm for the q6apm-dais device (`iommus = <&apps_smmu 0x1001 0x80>,
+ * <&apps_smmu 0x1041 0x20>`):
+ *   SMR icesmmu_smr (9): VALID | MASK 0x80 << 16 | ID 0x1001; SMR icesmmu_smr + 1 (10): VALID | 0x20 << 16 | 0x1041;
+ *   their S2CRs: TYPE translate | CBNDX icesmmu_cb (7);
+ *   bank 7: CBA2R VA64; CBAR type 1 (stage 1, stage 2 bypass) | BPSHCFG NSH | MEMATTR WB; TCR2 PASIZE 40 bit;
+ *   TCR EPD1 | TG0 4K | SH0 inner | ORGN0/IRGN0 WBWA (the SMMU is dma-coherent) | T0SZ 32 (a 4 GB space, walk from
+ *   level 1); MAIR0 = io-pgtable's (NC 0x44, WBRWA 0xff, device 0x04, INC_OWBRWA 0xf4); TTBR0 = our level-1 table |
+ *   ASID 7 << 48; TLBIASID + sync; SCTLR CFRE | AFE | TRE | M | S1_ASIDPNE (no fault interrupt: nothing handles it);
+ *   one 64 KB buffer at IOVA 0x10000000: 16 level-3 pages, normal non-cacheable (the DSP is not coherent:
+ *   q6apm-dais has no dma-coherent), access flag, read/write, not executable.
+ * Before any write: the two SMRs must read invalid, their S2CRs as found by the survey, bank 7 unrouted, SCTLR.M 0, CBAR
+ * 0 -- else nothing is written. The DSP is then given the IOVA (APM_CMD_SHARED_MEM_MAP_REGIONS, as q6apm
+ * __q6apm_map_memory_fixed_region; its handle comes back), the bank's fault status read, the region unmapped
+ * (APM_CMD_SHARED_MEM_UNMAP_REGIONS), and everything put back in reverse: SMRs invalid first (the streams fault again
+ * as before), S2CRs, SCTLR 0, TLB, the bank's page registers (TTBR0, TCR, TCR2, MAIR0) to 0. Level D (the tone) uses
+ * the mapping in between.
+ * NOT put back: the bank's CBAR / CBA2R (global register space 1). ipad17f / 17g (31 Oct): writing CBAR(7) back to its
+ * found 0 (= type 0, a stage-2 context, VMID 0) was answered with a synchronous external abort (ESR "implementation
+ * specific error", PC on that very store; every write before it -- SMR, S2CR, SCTLR, TLBIASID, TLBSYNC, FSR, TTBR0,
+ * TCR, TCR2, MAIR0 -- went through): on this SoC the hypervisor (Gunyah) owns the stage-2 side of the apps SMMU and
+ * refuses a stage-2 context type from EL1. Linux never writes them on a teardown either: arm_smmu_destroy_domain_context
+ * -> arm_smmu_write_context_bank(idx) with no cfg writes SCTLR = 0 only, and arm_smmu_write_sme (S2CR, then SMR) for the
+ * streams. Bank 7 is left with our CBAR 0x1f300 / CBA2R 1 and SCTLR.M 0, unrouted (no SMR points at it): inert. The
+ * setup accepts that leftover (CBAR exactly ours) as free on a later C2 in the same boot.
+ */
+#define C2_IOVA                 0x10000000ull
+#define C2_BUF_SIZE             0x10000u
+#define C2_TABLES_SIZE          0x4000u         /* three 4 KB tables, whatever the kernel's page size (w4-audio) */
+#define C2_ASID                 7u
+#define C2_CBAR                 (1u << 16 | 3u << 8 | 0xfu << 12)       /* 0x1f300: type 1, BPSHCFG NSH, WB */
+/*
+ * The address the DSP is given (map and every data buffer): the IOVA with the stream tag in bits 32+, as q6apm-dai.c
+ * does: prtd->phys = dma_addr | (sid << 32), sid = the q6apm-dais node's first iommus SID 0x1001 & SID_MASK_DEFAULT
+ * (0xf) = 1; __q6apm_map_memory_fixed_region and q6apm_write_async pass it as lsw / msw. ipad17n (stage 3, 31 Oct)
+ * hard-hung the SoC at the DSP's first read of a buffer given as msw 0 (17m, the same set-up with no buffer sent,
+ * did not): without the tag the DSP's DMA does not go out as stream 0x1001 through bank 7 at IOVA 0x10000000.
+ * Read-only references that do the same (credited, nothing copied): superboyyy/hakios-arm64e-dada redwood_sound.c
+ * (AUDIO_STREAM_BITS 1 << 32 on every address, "the stream's low bits (0x1801 & 0xf)"; its SMMU undo writes SMR,
+ * S2CR, SCTLR only -- no CBAR, as C2's teardown now) and ShueiTsuki/data-a-live 0234/0271 (SPK_SID_INDEX 1 in the
+ * msw of the APM map and of every WR_SH_MEM_EP buffer; their first sound on SM8850).
+ */
+#define C2_SID_TAG              1ull
+#define C2_DSP_ADDR             (C2_IOVA | C2_SID_TAG << 32)
+
+/*
+ * ---- the UFS census around our apps-SMMU banks (7: audio C2, 8: FastRPC) ------------------------------------------
+ * As icepcie's around its bank 9 (hakios_iceland_pcie.c ufs_census): the UFS's stream in the shared apps SMMU -- SMR 0,
+ * S2CR 0, and the bank S2CR 0 routes to (its SCTLR, TTBR0 low) -- read before our first write to a bank and again after
+ * that bank is put back. A census that reads all-ones is not one: nothing is written then. Afterwards "unchanged" or
+ * "CHANGED" is logged (the put-back is complete either way). Reads only.
+ */
+struct ufs_census {
+	uint32_t v[4];
+};
+
+static bool
+ufs_census(vm_offset_t smmu, uint32_t page, uint32_t npage, uint32_t ncb, const char *who, const char *when,
+    struct ufs_census *c, bool compare)
+{
+	uint32_t s2cr0 = rd(smmu + 0xc00), v[4] = { rd(smmu + 0x800), s2cr0, 0, 0 }, bank = s2cr0 & 0xff;
+	bool routed = ((s2cr0 >> 16) & 3) == 0 && bank < ncb && npage * page + (bank + 1) * page <= 0x100000;
+
+	if (routed) {
+		v[2] = rd(smmu + npage * page + bank * page);
+		v[3] = rd(smmu + npage * page + bank * page + 0x20);
+	}
+	say("%s: smmu UFS %s: SMR0 %08x S2CR0 %08x bank %u SCTLR %08x TTBR0 %08x%s\n", who, when, v[0], v[1],
+	    routed ? bank : 0, v[2], v[3], !compare ? "" : memcmp(v, c->v, sizeof(v)) == 0 ? " (unchanged)" : " (CHANGED)");
+	if (!compare) {
+		memcpy(c->v, v, sizeof(v));
+		if (v[0] == 0xffffffffu || v[1] == 0xffffffffu || (routed && (v[2] == 0xffffffffu || v[3] == 0xffffffffu))) {
+			say("%s: smmu REFUSED: the UFS census reads all-ones: nothing written\n", who);
+			return false;
+		}
+	}
+	return true;
+}
+
+struct c2_state {
+	vm_offset_t smmu, cb;           /* the SMMU's registers, our bank's page */
+	uint32_t smr, bank, page, npage, ncb;
+	struct ufs_census census;
+	uint32_t found_smr[2], found_s2cr[2], found_cbar, found_cba2r;
+	vm_offset_t tables, buf;        /* kernel memory: 3 page tables (one 16 KB page), the 64 KB buffer */
+	bool live;
+};
+static struct c2_state c2;
+
+static void
+c2_tlb_sync(void)
+{
+	wr(c2.cb + 0x610, C2_ASID);                     /* CB_S1_TLBIASID */
+	wr(c2.cb + 0x7f0, 0);                           /* CB_TLBSYNC */
+	for (int i = 0; i < 1000 && (rd(c2.cb + 0x7f4) & 1); i++) {      /* CB_TLBSTATUS.SACTIVE */
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+}
+
+static void
+c2_clean(vm_offset_t va, vm_size_t size)
+{
+	for (vm_offset_t l = va & ~63ul; l < va + size; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	settle();
+}
+
+/* the bank and both SMRs set up; false (nothing written) if any of them is not as the survey found it */
+static bool
+c2_setup(void)
+{
+	uint32_t id0, id1, nsmr, ncb;
+	uint64_t *l1, *l2, *l3, pa1, pa2, pa3;
+
+	c2.smr = 9;
+	c2.bank = 7;
+	PE_parse_boot_argn("icesmmu_smr", &c2.smr, sizeof(c2.smr));
+	PE_parse_boot_argn("icesmmu_cb", &c2.bank, sizeof(c2.bank));
+	c2.smmu = ml_io_map(0x15000000UL, 0x100000UL);
+	if (c2.smmu == 0) {
+		return false;
+	}
+	id0 = rd(c2.smmu + 0x20);
+	id1 = rd(c2.smmu + 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	c2.page = (id1 >> 31) ? 0x10000 : 0x1000;
+	c2.npage = 1u << (((id1 >> 28) & 7) + 1);
+	if (c2.smr + 1 >= nsmr || c2.bank >= ncb || c2.npage * c2.page + (c2.bank + 1) * c2.page > 0x100000) {
+		say("c2: SMR %u / bank %u out of range (%u SMRs, %u banks): nothing written\n", c2.smr, c2.bank, nsmr, ncb);
+		return false;
+	}
+	c2.cb = c2.smmu + c2.npage * c2.page + c2.bank * c2.page;
+	for (int k = 0; k < 2; k++) {
+		c2.found_smr[k] = rd(c2.smmu + 0x800 + 4 * (c2.smr + k));
+		c2.found_s2cr[k] = rd(c2.smmu + 0xc00 + 4 * (c2.smr + k));
+	}
+	c2.found_cbar = rd(c2.smmu + c2.page + 4 * c2.bank);
+	c2.found_cba2r = rd(c2.smmu + c2.page + 0x800 + 4 * c2.bank);
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t s2cr = rd(c2.smmu + 0xc00 + 4 * i);
+
+		if ((rd(c2.smmu + 0x800 + 4 * i) >> 31) && ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == c2.bank) {
+			say("c2: bank %u is routed by SMR %u: nothing written\n", c2.bank, i);
+			return false;
+		}
+	}
+	if ((c2.found_smr[0] >> 31) || (c2.found_smr[1] >> 31) || (rd(c2.cb) & 1) || (c2.found_cbar != 0 &&
+	    c2.found_cbar != C2_CBAR)) {
+		say("c2: SMR %u %#x / %u %#x, bank %u SCTLR %#x CBAR %#x: not free: nothing written\n", c2.smr, c2.found_smr[0],
+		    c2.smr + 1, c2.found_smr[1], c2.bank, rd(c2.cb), c2.found_cbar);
+		return false;
+	}
+	c2.ncb = ncb;
+	if (!ufs_census(c2.smmu, c2.page, c2.npage, ncb, "c2", "before", &c2.census, false)) {
+		return false;
+	}
+	/*
+	 * page tables: level 1 at +0, level 2 at +4 KB, level 3 at +8 KB of 16 KB of zeroed memory; the 64 KB buffer.
+	 * (w4-audio: 16 KB by its size, C2_TABLES_SIZE, not "one page": iPadOS's kernel has 16 KB pages, this macOS kernel
+	 * 4 KB ones, and PAGE_SIZE gave the level 1 table alone -- tablet run w4-audio-2l 20261115-232933 stopped in a
+	 * translation fault on the level 2 entry, tables + 0x1400. Each table's physical address is looked up on its own.)
+	 */
+	if (kmem_alloc(kernel_map, &c2.tables, C2_TABLES_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS || kmem_alloc(kernel_map, &c2.buf, C2_BUF_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("c2: no memory\n");
+		return false;
+	}
+	l1 = (uint64_t *)c2.tables;
+	l2 = (uint64_t *)(c2.tables + 0x1000);
+	l3 = (uint64_t *)(c2.tables + 0x2000);
+	pa1 = kvtophys(c2.tables);
+	pa2 = kvtophys(c2.tables + 0x1000);
+	pa3 = kvtophys(c2.tables + 0x2000);
+	l1[(C2_IOVA >> 30) & 0x1ff] = pa2 | 3;                          /* table */
+	l2[(C2_IOVA >> 21) & 0x1ff] = pa3 | 3;                          /* table */
+	for (uint32_t i = 0; i < C2_BUF_SIZE / 0x1000; i++) {
+		uint64_t pa = kvtophys(c2.buf + i * 0x1000);
+
+		/* page | AF | inner shareable | unprivileged read/write | AttrIndx 0 (NC) | nG | XN */
+		l3[((C2_IOVA >> 12) & 0x1ff) + i] = (pa & 0xfffffffff000ull) | 3 | 1ull << 10 | 3ull << 8 | 1ull << 6 |
+		    0ull << 2 | 1ull << 11 | 3ull << 53;
+	}
+	c2_clean(c2.tables, C2_TABLES_SIZE);
+	c2_clean(c2.buf, C2_BUF_SIZE);
+	say("c2: tables at %#llx / %#llx / %#llx, buffer 64 KB at IOVA %#llx (first page %#llx)\n", pa1, pa2, pa3, C2_IOVA,
+	    kvtophys(c2.buf));
+	/* the bank, as arm_smmu_write_context_bank: CBA2R, CBAR, TCR2, TTBR0, TCR, MAIR, then SCTLR */
+	wr(c2.smmu + c2.page + 0x800 + 4 * c2.bank, 1);                /* VA64 */
+	wr(c2.smmu + c2.page + 4 * c2.bank, C2_CBAR);
+	wr(c2.cb + 0x10, 2);                                            /* TCR2: PASIZE 40 bit */
+	wr(c2.cb + 0x20, (uint32_t)pa1);
+	wr(c2.cb + 0x24, (uint32_t)(pa1 >> 32) | C2_ASID << 16);
+	wr(c2.cb + 0x30, 1u << 23 | 0u << 14 | 3u << 12 | 1u << 10 | 1u << 8 | 32u);
+	wr(c2.cb + 0x38, 0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24);
+	wr(c2.cb + 0x3c, 0);
+	c2_tlb_sync();
+	wr(c2.cb + 0x58, rd(c2.cb + 0x58));                            /* FSR: clear stale bits */
+	wr(c2.cb, 1u << 5 | 1u << 2 | 1u << 1 | 1u << 0 | 1u << 12);
+	settle();
+	/* the streams: S2CR first, SMR VALID last (arm_smmu_write_sme) */
+	wr(c2.smmu + 0xc00 + 4 * c2.smr, c2.bank);
+	wr(c2.smmu + 0xc00 + 4 * (c2.smr + 1), c2.bank);
+	settle();
+	wr(c2.smmu + 0x800 + 4 * c2.smr, 1u << 31 | 0x80u << 16 | 0x1001);
+	wr(c2.smmu + 0x800 + 4 * (c2.smr + 1), 1u << 31 | 0x20u << 16 | 0x1041);
+	settle();
+	c2.live = true;
+	say("c2: SMMU SET: SMR %u = %#x, SMR %u = %#x, S2CR %#x %#x; bank %u CBAR %#x SCTLR %#x TCR %#x TTBR0 %#x_%08x "
+	    "FSR %#x\n", c2.smr, rd(c2.smmu + 0x800 + 4 * c2.smr), c2.smr + 1, rd(c2.smmu + 0x800 + 4 * (c2.smr + 1)),
+	    rd(c2.smmu + 0xc00 + 4 * c2.smr), rd(c2.smmu + 0xc00 + 4 * (c2.smr + 1)), c2.bank,
+	    rd(c2.smmu + c2.page + 4 * c2.bank), rd(c2.cb), rd(c2.cb + 0x30), rd(c2.cb + 0x24), rd(c2.cb + 0x20),
+	    rd(c2.cb + 0x58));
+	return true;
+}
+
+static void
+c2_fault_report(const char *when)
+{
+	if (c2.live) {
+		say("c2: %s: bank %u FSR %#x FAR %#x_%08x FSYNR0 %#x\n", when, c2.bank, rd(c2.cb + 0x58), rd(c2.cb + 0x64),
+		    rd(c2.cb + 0x60), rd(c2.cb + 0x68));
+	}
+}
+
+/* one teardown write, named first: global space 0 (SMR / S2CR) or our bank's page */
+static void
+c2_twr(const char *reg, uint32_t off, uint32_t val, bool bank)
+{
+	vm_offset_t a = (bank ? c2.cb : c2.smmu) + off;
+
+	say("c2: teardown: %s %s+%#x (%#llx) = %#x\n", reg, bank ? "bank" : "GR0", off,
+	    0x15000000ull + (uint64_t)(a - c2.smmu), val);
+	wr(a, val);
+}
+
+static void
+c2_teardown(void)
+{
+	if (!c2.live) {
+		return;
+	}
+	c2_fault_report("before the teardown");
+	/*
+	 * Only accesses the setup made (and 17f / 17g's teardown passed) to the same registers, each named on the console
+	 * before it is made (a next failure names its register); no global-space register beyond SMR / S2CR, no
+	 * TLBIALLNSNH / TLBIVMID, no CBAR / CBA2R (see above). Linux's order: the streams (arm_smmu_write_sme) before the
+	 * bank (arm_smmu_write_context_bank SCTLR = 0); here SMR VALID first so a late DSP access faults at once.
+	 */
+	c2_twr("SMR (VALID off)", 0x800 + 4 * c2.smr, c2.found_smr[0], false);
+	c2_twr("SMR (VALID off)", 0x800 + 4 * (c2.smr + 1), c2.found_smr[1], false);
+	settle();
+	c2_twr("S2CR (as found)", 0xc00 + 4 * c2.smr, c2.found_s2cr[0], false);
+	c2_twr("S2CR (as found)", 0xc00 + 4 * (c2.smr + 1), c2.found_s2cr[1], false);
+	settle();
+	c2_twr("SCTLR (M off)", 0x0, 0, true);
+	settle();
+	say("c2: teardown: bank %u TLBIASID %u + TLBSYNC (as the setup)\n", c2.bank, C2_ASID);
+	c2_tlb_sync();
+	c2_twr("FSR (clear)", 0x58, rd(c2.cb + 0x58), true);
+	c2_twr("TTBR0 low", 0x20, 0, true);
+	c2_twr("TTBR0 high", 0x24, 0, true);
+	c2_twr("TCR", 0x30, 0, true);
+	c2_twr("TCR2", 0x10, 0, true);
+	c2_twr("MAIR0", 0x38, 0, true);
+	settle();
+	c2.live = false;
+	say("c2: SMMU PUT BACK: SMR %u = %#x, SMR %u = %#x, S2CR %#x %#x, bank %u SCTLR %#x TTBR0 %#x_%08x TCR %#x; CBAR %#x "
+	    "CBA2R %#x left as set (found %#x / %#x: the hypervisor refuses a stage-2 CBAR from EL1; unrouted, M off)\n",
+	    c2.smr, rd(c2.smmu + 0x800 + 4 * c2.smr), c2.smr + 1, rd(c2.smmu + 0x800 + 4 * (c2.smr + 1)),
+	    rd(c2.smmu + 0xc00 + 4 * c2.smr), rd(c2.smmu + 0xc00 + 4 * (c2.smr + 1)), c2.bank, rd(c2.cb), rd(c2.cb + 0x24),
+	    rd(c2.cb + 0x20), rd(c2.cb + 0x30), rd(c2.smmu + c2.page + 4 * c2.bank),
+	    rd(c2.smmu + c2.page + 0x800 + 4 * c2.bank), c2.found_cbar, c2.found_cba2r);
+	(void)ufs_census(c2.smmu, c2.page, c2.npage, c2.ncb, "c2", "after", &c2.census, true);
+	/* (the tables and the buffer stay allocated: a late DSP access would find a faulting stream, never freed memory) */
+}
+
+/*
+ * APM_CMD_SHARED_MEM_MAP_REGIONS as __q6apm_map_memory_fixed_region (the command at the GPR payload's start); the token
+ * is the front end's graph id (q6apm-dai.c q6apm_dai_memory_map: cpu_dai->driver->id): 1 for C2 / the tone as before,
+ * 2 (MultiMedia3, the capture front end) for 17r2
+ */
+static uint32_t c2_map_token = 1;
+
+static uint32_t
+c2_dsp_map(struct gchan *apps)
+{
+	uint8_t pkt[24 + 36];
+	uint32_t *w = (uint32_t *)pkt, seq = gpr_rx_seq, size = sizeof(pkt);
+	uint64_t t0 = now_us();
+
+	bzero(pkt, sizeof(pkt));
+	w[0] = 0 | 6u << 4 | size << 8;
+	w[1] = GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8;
+	w[2] = APM_IID;
+	w[3] = APM_IID;
+	w[4] = c2_map_token;                            /* token: the graph id */
+	w[5] = 0x0100100Cu;
+	w[6] = 3u | 1u << 16;                           /* SHMEM8_4K pool, one region */
+	w[7] = 0;                                       /* property flag */
+	w[8] = (uint32_t)C2_DSP_ADDR;
+	w[9] = (uint32_t)(C2_DSP_ADDR >> 32);           /* the stream tag (q6apm-dai: | sid << 32) */
+	w[10] = C2_BUF_SIZE;
+	if (!g_tx_data(apps, pkt, size)) {
+		return 0;
+	}
+	while (now_us() - t0 < 2000000ull && !g_broken) {
+		g_pump();
+		if (gpr_rx_seq != seq) {
+			seq = gpr_rx_seq;
+			if (gpr_rx_opcode == 0x02001001u) {
+				say("c2: APM: SHARED_MEM_MAP_REGIONS of IOVA %#llx (64 KB): HANDLE %#x\n", C2_IOVA, gpr_rx_w0);
+				return gpr_rx_w0;
+			}
+			if (gpr_rx_opcode == GPR_BASIC_RSP_RESULT && gpr_rx_w0 == 0x0100100Cu) {
+				say("c2: APM: SHARED_MEM_MAP_REGIONS: REFUSED (status %#x)\n", gpr_rx_w1);
+				return 0;
+			}
+		}
+		sleep_ms(1);
+	}
+	say("c2: APM: SHARED_MEM_MAP_REGIONS: NO ANSWER\n");
+	return 0;
+}
+
+static void
+c2_dsp_unmap(struct gchan *apps, uint32_t handle)
+{
+	uint8_t pkt[24 + 16 + 4];
+	uint32_t *w = (uint32_t *)pkt, seq = gpr_rx_seq, size = sizeof(pkt);
+	uint64_t t0 = now_us();
+
+	bzero(pkt, sizeof(pkt));
+	w[0] = 0 | 6u << 4 | size << 8;
+	w[1] = GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8;
+	w[2] = APM_IID;
+	w[3] = APM_IID;
+	w[4] = c2_map_token;
+	w[5] = 0x0100100Du;
+	w[6] = handle;
+	if (!g_tx_data(apps, pkt, size)) {
+		return;
+	}
+	while (now_us() - t0 < 2000000ull && !g_broken) {
+		g_pump();
+		if (gpr_rx_seq != seq) {
+			seq = gpr_rx_seq;
+			if (gpr_rx_opcode == GPR_BASIC_RSP_RESULT && gpr_rx_w0 == 0x0100100Du) {
+				say("c2: APM: SHARED_MEM_UNMAP_REGIONS %#x: %s (status %#x)\n", handle, gpr_rx_w1 ? "REFUSED" : "OK",
+				    gpr_rx_w1);
+				return;
+			}
+		}
+		sleep_ms(1);
+	}
+	say("c2: APM: SHARED_MEM_UNMAP_REGIONS: NO ANSWER\n");
+}
+
+/*
+ * ---- Sensor level 22a (boot-arg icefrpc=1, OFF by default): the apps-SMMU bank for FastRPC session 3 ------------------
+ * C2's method for the ADSP's FastRPC compute bank compute-cb@3 (kaanapali.dtsi fastrpc "fastrpcglink-apps-dsp":
+ * iommus <&apps_smmu 0x1003 0x80>, <&apps_smmu 0x1043 0x20>, dma-coherent): SMR icefrpc_smr (11) = VALID | 0x80 << 16 |
+ * 0x1003, SMR 12 = VALID | 0x20 << 16 | 0x1043, their S2CRs -> bank icefrpc_cb (8); bank 8 as C2's bank 7 (CBA2R VA64,
+ * CBAR 0x1f300, TCR2 40 bit, TCR as C2, MAIR0 io-pgtable's, TTBR0 our table | ASID 8 << 48, TLBIASID + sync, SCTLR as
+ * C2) -- except the pages: the bank is dma-coherent, so they are normal write-back cacheable (AttrIndx 1 = 0xff), inner
+ * shareable, as io-pgtable-arm with IOMMU_CACHE. One 64 KB buffer at IOVA 0x10000000. Nothing is sent to the DSP here
+ * (22b's attach will): the bank is set, read back, its FSR read after 2 s, and put back exactly as C2's teardown that
+ * 17i proved (SMR VALID off, S2CR as found, SCTLR 0, TLBIASID + TLBSYNC, FSR, TTBR0 / TCR / TCR2 / MAIR0 0; CBAR /
+ * CBA2R left as set: the hypervisor refuses a stage-2 CBAR from EL1). Each teardown write named first.
+ * FastRPC's address rule (for 22b): kaanapali_soc_data.sid_pos = 56 (fastrpc.c) -- the session's SID (the cb's reg,
+ * 3) goes into bits 56+ of every address the DSP is given (fastrpc_sid_offset), NOT bit 32 as q6apm's audio.
+ */
+#define FRPC_IOVA               0x10000000ull
+#define FRPC_ASID               8u
+#define FRPC_SID_POS            56u
+#define FRPC_SESSION            3u
+
+static struct {
+	vm_offset_t smmu, cb, tables, buf;
+	uint32_t smr, bank, page, npage, ncb, found_smr[2], found_s2cr[2], found_cbar;
+	struct ufs_census census;
+	bool live;
+} fx;
+
+static void
+fx_twr(const char *reg, uint32_t off, uint32_t val, bool bank)
+{
+	vm_offset_t a = (bank ? fx.cb : fx.smmu) + off;
+
+	say("frpc: teardown: %s %s+%#x (%#llx) = %#x\n", reg, bank ? "bank" : "GR0", off,
+	    0x15000000ull + (uint64_t)(a - fx.smmu), val);
+	wr(a, val);
+}
+
+static void
+fx_tlb_sync(void)
+{
+	wr(fx.cb + 0x610, FRPC_ASID);
+	wr(fx.cb + 0x7f0, 0);
+	for (int i = 0; i < 1000 && (rd(fx.cb + 0x7f4) & 1); i++) {
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+}
+
+static bool
+fx_setup(void)
+{
+	uint32_t id0, id1, nsmr, ncb;
+	uint64_t *l1, *l2, *l3, pa1, pa2, pa3;
+
+	fx.smr = 11;
+	fx.bank = 8;
+	PE_parse_boot_argn("icefrpc_smr", &fx.smr, sizeof(fx.smr));
+	PE_parse_boot_argn("icefrpc_cb", &fx.bank, sizeof(fx.bank));
+	fx.smmu = ml_io_map(0x15000000UL, 0x100000UL);         /* (kept: the SMMU's registers, as c2_setup) */
+	if (fx.smmu == 0) {
+		return false;
+	}
+	id0 = rd(fx.smmu + 0x20);
+	id1 = rd(fx.smmu + 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	fx.page = (id1 >> 31) ? 0x10000 : 0x1000;
+	fx.npage = 1u << (((id1 >> 28) & 7) + 1);
+	if (fx.smr + 1 >= nsmr || fx.bank >= ncb || fx.npage * fx.page + (fx.bank + 1) * fx.page > 0x100000 ||
+	    (fx.smr <= 10 && fx.smr + 1 >= 9) || fx.bank == 7) {
+		say("frpc: SMR %u / bank %u out of range or C2's (SMR 9/10, bank 7): nothing written\n", fx.smr, fx.bank);
+		return false;
+	}
+	fx.cb = fx.smmu + fx.npage * fx.page + fx.bank * fx.page;
+	for (int k = 0; k < 2; k++) {
+		fx.found_smr[k] = rd(fx.smmu + 0x800 + 4 * (fx.smr + k));
+		fx.found_s2cr[k] = rd(fx.smmu + 0xc00 + 4 * (fx.smr + k));
+	}
+	fx.found_cbar = rd(fx.smmu + fx.page + 4 * fx.bank);
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = rd(fx.smmu + 0x800 + 4 * i), s2cr = rd(fx.smmu + 0xc00 + 4 * i), id = smr & 0xffff,
+		    mask = (smr >> 16) & 0x7fff;
+
+		if ((smr >> 31) && ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == fx.bank) {
+			say("frpc: bank %u is routed by SMR %u: nothing written\n", fx.bank, i);
+			return false;
+		}
+		if ((smr >> 31) && (((0x1003u ^ id) & ~mask & 0x7fff) == 0 || ((0x1043u ^ id) & ~mask & 0x7fff) == 0)) {
+			say("frpc: stream 0x1003 / 0x1043 already matched by SMR %u (%#x): nothing written\n", i, smr);
+			return false;
+		}
+	}
+	if ((fx.found_smr[0] >> 31) || (fx.found_smr[1] >> 31) || (rd(fx.cb) & 1) || (fx.found_cbar != 0 &&
+	    fx.found_cbar != C2_CBAR)) {
+		say("frpc: SMR %u %#x / %u %#x, bank %u SCTLR %#x CBAR %#x: not free: nothing written\n", fx.smr,
+		    fx.found_smr[0], fx.smr + 1, fx.found_smr[1], fx.bank, rd(fx.cb), fx.found_cbar);
+		return false;
+	}
+	fx.ncb = ncb;
+	if (!ufs_census(fx.smmu, fx.page, fx.npage, ncb, "frpc", "before", &fx.census, false)) {
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &fx.tables, C2_TABLES_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS || kmem_alloc(kernel_map, &fx.buf, C2_BUF_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("frpc: no memory\n");
+		return false;
+	}
+	l1 = (uint64_t *)fx.tables;
+	l2 = (uint64_t *)(fx.tables + 0x1000);
+	l3 = (uint64_t *)(fx.tables + 0x2000);
+	pa1 = kvtophys(fx.tables);
+	pa2 = kvtophys(fx.tables + 0x1000);
+	pa3 = kvtophys(fx.tables + 0x2000);
+	l1[(FRPC_IOVA >> 30) & 0x1ff] = pa2 | 3;
+	l2[(FRPC_IOVA >> 21) & 0x1ff] = pa3 | 3;
+	for (uint32_t i = 0; i < C2_BUF_SIZE / 0x1000; i++) {
+		uint64_t pa = kvtophys(fx.buf + i * 0x1000);
+
+		/* page | AF | inner shareable | read/write | AttrIndx 1 (WBRWA: dma-coherent) | nG | XN */
+		l3[((FRPC_IOVA >> 12) & 0x1ff) + i] = (pa & 0xfffffffff000ull) | 3 | 1ull << 10 | 3ull << 8 | 1ull << 6 |
+		    1ull << 2 | 1ull << 11 | 3ull << 53;
+	}
+	c2_clean(fx.tables, C2_TABLES_SIZE);
+	c2_clean(fx.buf, C2_BUF_SIZE);
+	say("frpc: tables at %#llx / %#llx / %#llx, buffer 64 KB at IOVA %#llx (first page %#llx); the DSP would be given "
+	    "IOVA | %u << %u = %#llx (fastrpc.c kaanapali sid_pos)\n", pa1, pa2, pa3, FRPC_IOVA, kvtophys(fx.buf),
+	    FRPC_SESSION, FRPC_SID_POS, FRPC_IOVA | (uint64_t)FRPC_SESSION << FRPC_SID_POS);
+	wr(fx.smmu + fx.page + 0x800 + 4 * fx.bank, 1);
+	wr(fx.smmu + fx.page + 4 * fx.bank, C2_CBAR);
+	wr(fx.cb + 0x10, 2);
+	wr(fx.cb + 0x20, (uint32_t)pa1);
+	wr(fx.cb + 0x24, (uint32_t)(pa1 >> 32) | FRPC_ASID << 16);
+	wr(fx.cb + 0x30, 1u << 23 | 0u << 14 | 3u << 12 | 1u << 10 | 1u << 8 | 32u);
+	wr(fx.cb + 0x38, 0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24);
+	wr(fx.cb + 0x3c, 0);
+	fx_tlb_sync();
+	wr(fx.cb + 0x58, rd(fx.cb + 0x58));
+	wr(fx.cb, 1u << 5 | 1u << 2 | 1u << 1 | 1u << 0 | 1u << 12);
+	settle();
+	wr(fx.smmu + 0xc00 + 4 * fx.smr, fx.bank);
+	wr(fx.smmu + 0xc00 + 4 * (fx.smr + 1), fx.bank);
+	settle();
+	wr(fx.smmu + 0x800 + 4 * fx.smr, 1u << 31 | 0x80u << 16 | 0x1003);
+	wr(fx.smmu + 0x800 + 4 * (fx.smr + 1), 1u << 31 | 0x20u << 16 | 0x1043);
+	settle();
+	fx.live = true;
+	say("frpc: SMMU SET: SMR %u = %#x, SMR %u = %#x, S2CR %#x %#x; bank %u CBAR %#x SCTLR %#x TCR %#x TTBR0 %#x_%08x "
+	    "FSR %#x\n", fx.smr, rd(fx.smmu + 0x800 + 4 * fx.smr), fx.smr + 1, rd(fx.smmu + 0x800 + 4 * (fx.smr + 1)),
+	    rd(fx.smmu + 0xc00 + 4 * fx.smr), rd(fx.smmu + 0xc00 + 4 * (fx.smr + 1)), fx.bank,
+	    rd(fx.smmu + fx.page + 4 * fx.bank), rd(fx.cb), rd(fx.cb + 0x30), rd(fx.cb + 0x24), rd(fx.cb + 0x20),
+	    rd(fx.cb + 0x58));
+	return true;
+}
+
+static void
+fx_teardown(void)
+{
+	if (!fx.live) {
+		return;
+	}
+	say("frpc: before the teardown: bank %u FSR %#x FAR %#x_%08x FSYNR0 %#x\n", fx.bank, rd(fx.cb + 0x58),
+	    rd(fx.cb + 0x64), rd(fx.cb + 0x60), rd(fx.cb + 0x68));
+	fx_twr("SMR (VALID off)", 0x800 + 4 * fx.smr, fx.found_smr[0], false);
+	fx_twr("SMR (VALID off)", 0x800 + 4 * (fx.smr + 1), fx.found_smr[1], false);
+	settle();
+	fx_twr("S2CR (as found)", 0xc00 + 4 * fx.smr, fx.found_s2cr[0], false);
+	fx_twr("S2CR (as found)", 0xc00 + 4 * (fx.smr + 1), fx.found_s2cr[1], false);
+	settle();
+	fx_twr("SCTLR (M off)", 0x0, 0, true);
+	settle();
+	say("frpc: teardown: bank %u TLBIASID %u + TLBSYNC\n", fx.bank, FRPC_ASID);
+	fx_tlb_sync();
+	fx_twr("FSR (clear)", 0x58, rd(fx.cb + 0x58), true);
+	fx_twr("TTBR0 low", 0x20, 0, true);
+	fx_twr("TTBR0 high", 0x24, 0, true);
+	fx_twr("TCR", 0x30, 0, true);
+	fx_twr("TCR2", 0x10, 0, true);
+	fx_twr("MAIR0", 0x38, 0, true);
+	settle();
+	fx.live = false;
+	say("frpc: SMMU PUT BACK: SMR %u = %#x, SMR %u = %#x, S2CR %#x %#x, bank %u SCTLR %#x; CBAR %#x CBA2R %#x left as "
+	    "set (unrouted, M off)\n", fx.smr, rd(fx.smmu + 0x800 + 4 * fx.smr), fx.smr + 1,
+	    rd(fx.smmu + 0x800 + 4 * (fx.smr + 1)), rd(fx.smmu + 0xc00 + 4 * fx.smr), rd(fx.smmu + 0xc00 + 4 * (fx.smr + 1)),
+	    fx.bank, rd(fx.cb), rd(fx.smmu + fx.page + 4 * fx.bank), rd(fx.smmu + fx.page + 0x800 + 4 * fx.bank));
+	(void)ufs_census(fx.smmu, fx.page, fx.npage, fx.ncb, "frpc", "after", &fx.census, true);
+}
+
+/*
+ * ---- 22b / 22c: FastRPC on "fastrpcglink-apps-dsp" (icefrpc=2 / 3) ------------------------------------------------------
+ * One invoke = fastrpc.c's fastrpc_get_args + fastrpc_invoke_send for buffers inline in one 4 KB page of 22a's buffer
+ * (page `slot`): metadata = nscalars x {remote_buf pv/len 16, invoke_buf num/pgidx 8, phy_page addr/size 16}, the fd
+ * list (16 x 8), the crc list (64 x 4), 4 bytes; the buffers from ALIGN(metadata, 128), each at a 128 boundary
+ * (zero-length ones take no room); pv = our kernel address of the buffer, phy_page = its page's DSP address
+ * (IOVA | 3 << 56, kaanapali's sid_pos) and page count. The message (40 bytes) {client_id, tid, ctx = (index << 8) |
+ * (sequence << 16) | pd 2 (SENSORS_PD), handle, sc, addr = the page's DSP address, size 4096}; the answer
+ * fastrpc_invoke_rsp {ctx, retval}. Buffers are QAIC-marshalled as libhexagonrpc / the quic fastrpc stubs do: the
+ * primitive in-words in the first in-buffer, sequences after; the primitive outs in the first out-buffer.
+ *   22b (icefrpc=2): + fastrpc_init_attach(SENSORS_PD): handle 1 (FASTRPC_INIT_HANDLE), method 0 (INIT_ATTACH), in
+ *       {client_id 1}, sent with client_id 0 (kernel); at the end INIT_RELEASE (method 1, in {client_id}).
+ *   22c (icefrpc=3): + the reverse tunnel probe (hexagonrpcd's listener, GPL -- followed, not copied): adsp_listener
+ *       (static handle 3) init2 (method 3, no args), then next2 (method 4: in ret_rctx, ret_res, ret_outbufs[0];
+ *       out rctx, handle, sc, inbufs_len, inbufs[1024]) up to icefrpc_reqs (8) times / 20 s: each request the DSP
+ *       makes of us (apps_std file calls: the sensor registry / config files it wants) is LOGGED (handle, method,
+ *       in/out counts, its in-buffers as text) and answered "failed" (ret_res -1): no file is served yet (22c2).
+ * Refusals: 22b only after 22a's bank is set and the channel is open both ways; 22c only after the attach answered 0.
+ * If an invoke stays unanswered (next2 waits for the DSP by design), the bank is LEFT SET at the end (the DSP may
+ * still write its answer into the buffer: never into an unrouted stream) -- logged.
+ */
+#define FRPC_RMID_ATTACH        0u
+#define FRPC_RMID_RELEASE       1u
+#define FRPC_PD_SENSORS         2u
+#define FRPC_HANDLE_INIT        1u
+#define FRPC_HANDLE_LISTENER    3u
+
+static volatile uint64_t frpc_rsp_ctx;
+static volatile int32_t frpc_rsp_ret;
+static volatile uint32_t frpc_rsp_seq;
+static uint32_t frpc_seq;
+static bool frpc_outstanding;
+
+static void
+frpc_rx(const uint8_t *p, uint32_t len)
+{
+	if (len < 12) {
+		say("frpc: < %u bytes (too short for an answer)\n", len);
+		return;
+	}
+	frpc_rsp_ctx = (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+	frpc_rsp_ret = (int32_t)le32(p + 8);
+	frpc_rsp_seq++;
+}
+
+struct frpc_buf {
+	void *ptr;
+	uint32_t len;
+};
+
+static unsigned frpc_span = 1;         /* pages an invoke's buffer may take from its slot (22f: next2 takes 10) */
+
+/* one invoke; returns the DSP's retval, or INT32_MIN if no answer in wait_ms (then *outstanding) */
+static int32_t
+frpc_invoke(struct gchan *ch, uint32_t client_id, uint32_t handle, uint32_t method, struct frpc_buf *in, unsigned nin,
+    struct frpc_buf *out, unsigned nout, unsigned slot, uint32_t wait_ms, const char *what)
+{
+	const unsigned n = nin + nout;
+	vm_offset_t va = fx.buf + (vm_offset_t)slot * 0x1000;
+	uint64_t dsp = (FRPC_IOVA + (uint64_t)slot * 0x1000) | (uint64_t)FRPC_SESSION << FRPC_SID_POS, ctx, t0;
+	uint32_t meta = 40 * n + 8 * 16 + 4 * 64 + 4, off = (meta + 127) & ~127u, seq, sc, w[10];
+	uint8_t *b = (uint8_t *)va;
+	const uint32_t span = frpc_span * 0x1000u;
+
+	if (n > 8) {
+		return INT32_MIN;
+	}
+	bzero(b, span);
+	for (unsigned i = 0; i < n; i++) {
+		struct frpc_buf *x = i < nin ? &in[i] : &out[i - nin];
+		uint64_t pv = 0, page = 0, pages = 0;
+
+		if (x->len != 0) {
+			off = (off + 127) & ~127u;
+			if (off + x->len > span) {
+				say("frpc: %s: the buffers do not fit its pages: not sent\n", what);
+				return INT32_MIN;
+			}
+			pv = va + off;
+			page = (dsp + off) & ~0xfffull;
+			pages = (((dsp + off + x->len - 1) & ~0xfffull) - page) / 0x1000 + 1;
+			if (i < nin) {
+				memcpy(b + off, x->ptr, x->len);
+			}
+			off += x->len;
+		}
+		memcpy(b + 16 * i, &pv, 8);                                     /* remote_buf pv, len */
+		*(uint64_t *)(void *)(b + 16 * i + 8) = x->len;
+		*(uint32_t *)(void *)(b + 16 * n + 8 * i) = x->len ? 1 : 0;     /* invoke_buf num, pgidx */
+		*(uint32_t *)(void *)(b + 16 * n + 8 * i + 4) = i;
+		*(uint64_t *)(void *)(b + 24 * n + 16 * i) = page;              /* phy_page addr, size */
+		*(uint64_t *)(void *)(b + 24 * n + 16 * i + 8) = pages * 0x1000;
+	}
+	c2_clean(va, span);
+	frpc_seq++;
+	ctx = (uint64_t)((slot + 1) & 0xff) << 8 | (uint64_t)frpc_seq << 16 | FRPC_PD_SENSORS;
+	sc = (method & 0x1f) << 24 | (nin & 0xff) << 16 | (nout & 0xff) << 8;
+	w[0] = client_id;
+	w[1] = 1001;                                                            /* tid */
+	w[2] = (uint32_t)ctx;
+	w[3] = (uint32_t)(ctx >> 32);
+	w[4] = handle;
+	w[5] = sc;
+	w[6] = (uint32_t)dsp;
+	w[7] = (uint32_t)(dsp >> 32);
+	w[8] = (off + 0xfffu) & ~0xfffu;      /* roundup(msg_sz, PAGE_SIZE) */
+	w[9] = 0;
+	seq = frpc_rsp_seq;
+	say("frpc: > %s: handle %u sc %#x (method %u, %u in, %u out), ctx %#llx, buffer %#llx, %u bytes used\n", what,
+	    handle, sc, method, nin, nout, ctx, dsp, off);
+	if (!g_tx_data(ch, w, sizeof(w))) {
+		say("frpc: %s: NOT SENT\n", what);
+		return INT32_MIN;
+	}
+	frpc_outstanding = true;
+	for (t0 = now_us(); now_us() - t0 < (uint64_t)wait_ms * 1000ull && !g_broken && !adsp_stop_req;) {
+		g_pump();
+		if (frpc_rsp_seq != seq) {
+			seq = frpc_rsp_seq;
+			if (frpc_rsp_ctx != ctx) {
+				say("frpc: < an answer for ctx %#llx (not ours %#llx), retval %d\n", frpc_rsp_ctx, ctx, frpc_rsp_ret);
+				continue;
+			}
+			frpc_outstanding = false;
+			c2_clean(va, span);
+			off = (meta + 127) & ~127u;
+			for (unsigned i = 0; i < n; i++) {
+				struct frpc_buf *x = i < nin ? &in[i] : &out[i - nin];
+
+				if (x->len != 0) {
+					off = (off + 127) & ~127u;
+					if (i >= nin) {
+						memcpy(x->ptr, b + off, x->len);
+					}
+					off += x->len;
+				}
+			}
+			say("frpc: < %s: retval %d after %llu ms\n", what, frpc_rsp_ret, (now_us() - t0) / 1000);
+			return frpc_rsp_ret;
+		}
+		sleep_ms(1);
+	}
+	say("frpc: %s: NO ANSWER in %u ms (left outstanding)\n", what, wait_ms);
+	return INT32_MIN;
+}
+
+static struct gchan *
+frpc_channel(void)
+{
+	for (unsigned i = 0; i < g_nchan; i++) {
+		if (strcmp(g_chan[i].name, "fastrpcglink-apps-dsp") == 0 && !g_chan[i].closed && g_chan[i].offered &&
+		    g_chan[i].open_acked) {
+			return &g_chan[i];
+		}
+	}
+	return NULL;
+}
+
+/*
+ * 22c2 (icefrpc=3): hexagonrpcd's start_reverse_tunnel order (22c1 skipped the register step and next2 got no request
+ * in 8 s): remotectl_open("adsp_default_listener") on the DSP (static handle 0, method 0: in {name_len, err_len},
+ * name; out {handle, dlerr}, err[256]) -> adsp_default_listener_register (that handle, method 0, no args) -> the
+ * listener's init2 -> next2 loop. The DSP's requests come encoded as in-buffers ({u32 size, pad to 8, data} each,
+ * iobuffer.c) and are answered through next2's ret_outbufs in the same encoding. Ours:
+ *   handle 0 (our apps_remotectl), method 0 open(name): "apps_std" -> handle 1, "apps_mem" -> handle 2, else dlerr -1;
+ *   method 1 close: ok. Handle 1 (apps_std: the DSP's file calls) and 2 (apps_mem): LOGGED (method, in-buffers as text
+ *   -- the file names) and answered failed (result -1, empty out-buffers); no file is served yet (22c3).
+ */
+static uint32_t
+frpc_enc(uint8_t *o, uint32_t room, const void *const *p, const uint32_t *s, unsigned n)
+{
+	uint32_t at = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		if (at + 4 > room) {
+			return 0;
+		}
+		*(uint32_t *)(void *)(o + at) = s[i];
+		at += 4;
+		if (s[i] != 0) {
+			at = (at + 7) & ~7u;
+			if (at + s[i] > room) {
+				return 0;
+			}
+			memcpy(o + at, p[i], s[i]);
+			at += s[i];
+		}
+	}
+	return at;
+}
+
+/* the in-buffers of a request: up to 8, pointers into buf */
+static unsigned
+frpc_dec(const uint8_t *buf, uint32_t len, unsigned want, const uint8_t **p, uint32_t *s)
+{
+	uint32_t at = 0;
+	unsigned n = 0;
+
+	while (n < want && n < 8 && at + 4 <= len) {
+		s[n] = le32(buf + at);
+		at += 4;
+		if (s[n] != 0) {
+			at = (at + 7) & ~7u;
+			if (at + s[n] > len) {
+				break;
+			}
+		}
+		p[n] = buf + at;
+		at += s[n];
+		n++;
+	}
+	return n;
+}
+
+/*
+ * ---- 22c3: apps_std served read-only (icefrpc=3 with icefrpc_serve=1) ------------------------------------------------
+ * The behaviour of hexagonrpcd's apps_std.c / rpcd_builder.c (GPL: followed, not copied) over a tree in the root
+ * image, icefrpc_root (default /usr/share/iceland/qcom = iceland-firmware's usr/share/qcom/kaanapali/OnePlus/iceland
+ * sensors / odm / socinfo, packed into md1 by the userland build). The DSP's names map as hexagonrpcd's virtual tree:
+ *   /vendor/etc/sensors/config/X -> R/sensors/config/X, /vendor/etc/sensors/sns_reg_config -> R/sensors/sns_reg.conf,
+ *   /mnt/vendor/persist/sensors/registry/registry/X and /persist/... -> R/sensors/registry/X, /odm/etc/sensor/X ->
+ *   R/odm/sensor/X, /sys/devices/soc0/X -> R/socinfo/X, /vendor/etc/acdbdata/X -> R/acdb/X, /usr/lib/qcom/adsp/X and
+ *   ADSP_LIBRARY_PATH's relative names -> R/dsp/adsp/X; anything else, ".." or a write mode: refused.
+ * Methods (apps_std IDL ids): 19 fopen_with_env (env, delim, name, mode -> fd), 4 fread (fd, size -> written, eof,
+ * data; at most FRPC_READ_MAX per answer, the DSP reads on), 9 fseek (fd, offset, whence 0/1/2), 3 fclose, 31 stat
+ * (name -> 96 bytes: tsz, dev, ino, mode, nlink, rdev, size, times); every other method: AEE_EUNSUPPORTED (20).
+ * Errors: AEE_EFAILED (1), AEE_EBADPARM (14). Files are opened per call (vnode_open / vn_rdwr / vnode_close, kernel
+ * context, FREAD only); nothing is ever written. One line per open / stat (name, mapped path, result).
+ */
+#define FRPC_READ_MAX           32768u
+#define AEE_EFAILED             1u
+#define AEE_EBADPARM            14u
+#define AEE_EUNSUPPORTED        20u
+static char frpc_root[96] = "/redwood/usr/share/iceland/qcom";      /* (md1 is mounted on /redwood) */
+/* the ADSP service's FastRPC (iceadsp_frpc_serve): served and kept attached whatever the kit's boot-args say */
+static bool frpc_serve_forced, frpc_keep_forced;
+
+/* a file of the root that iceadsp_image() holds (the delivery's pack), before the volume is asked */
+static bool
+frpc_mem_file(const char *path, const uint8_t **p, uint64_t *len)
+{
+	size_t n = strlen(frpc_root);
+
+	return strncmp(path, frpc_root, n) == 0 && path[n] == '/' && iceadsp_image(path + n + 1, p, len);
+}
+static struct {
+	char path[200];
+	uint64_t pos, size;
+	bool used;
+} frpc_fd[24];
+static unsigned frpc_opens, frpc_open_fails, frpc_reads, frpc_bytes;
+
+static bool
+frpc_map(const char *env, const char *name, char *out, size_t room)
+{
+	static const struct {
+		const char *dsp, *ours;
+	} m[] = {
+		{ "/vendor/etc/sensors/config/", "/sensors/config/" }, { "/vendor/etc/sensors/sns_reg_config", "/sensors/sns_reg.conf" },
+		{ "/mnt/vendor/persist/sensors/registry/registry/", "/sensors/registry/" },
+		{ "/persist/sensors/registry/registry/", "/sensors/registry/" }, { "/odm/etc/sensor/", "/odm/sensor/" },
+		{ "/sys/devices/soc0/", "/socinfo/" }, { "/vendor/etc/acdbdata/", "/acdb/" }, { "/usr/lib/qcom/adsp/", "/dsp/adsp/" },
+	};
+
+	for (const char *c = name; *c != 0; c++) {
+		if (c[0] == '.' && c[1] == '.') {
+			return false;
+		}
+	}
+	if (name[0] != '/') {
+		if (env == NULL || strcmp(env, "ADSP_LIBRARY_PATH") != 0) {
+			return false;
+		}
+		return (size_t)snprintf(out, room, "%s/dsp/adsp/%s", frpc_root, name) < room;
+	}
+	for (size_t i = 0; i < sizeof(m) / sizeof(m[0]); i++) {
+		size_t n = strlen(m[i].dsp);
+
+		if (strncmp(name, m[i].dsp, n) == 0) {
+			return (size_t)snprintf(out, room, "%s%s%s", frpc_root, m[i].ours, name + n) < room;
+		}
+	}
+	return false;
+}
+
+/* the size (and whether it is a directory) of a file of the root image; false if it is not there */
+static bool
+frpc_stat_path(const char *path, uint64_t *size, bool *dir)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	bool ok;
+	const uint8_t *mem = NULL;
+	uint64_t mem_len = 0;
+
+	if (frpc_mem_file(path, &mem, &mem_len)) {
+		*size = mem_len;
+		*dir = false;
+		return true;
+	}
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return false;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	ok = vnode_getattr(vp, &va, ctx) == 0;
+	*size = ok ? va.va_data_size : 0;
+	*dir = vnode_isdir(vp);
+	vnode_put(vp);
+	return ok;
+}
+
+static int
+frpc_read_path(const char *path, uint64_t off, void *buf, uint32_t len, uint32_t *got)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0, e;
+	const uint8_t *mem = NULL;
+	uint64_t mem_len = 0;
+
+	*got = 0;
+	if (frpc_mem_file(path, &mem, &mem_len)) {
+		if (off < mem_len) {
+			*got = (uint32_t)LESSER((uint64_t)len, mem_len - off);
+			memcpy(buf, mem + off, *got);
+		}
+		return 0;
+	}
+	if ((e = vnode_open(path, FREAD, 0, 0, &vp, ctx)) != 0) {
+		return e;
+	}
+	e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, (off_t)off, UIO_SYSSPACE, 0, vfs_context_ucred(ctx),
+	    &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (e == 0) {
+		*got = len - (uint32_t)resid;
+	}
+	return e;
+}
+
+/* one apps_std call: *res = its result, out-buffers encoded into enc; returns the encoded length */
+static uint32_t
+frpc_apps_std(uint32_t method, const uint8_t *const *p, const uint32_t *s, unsigned got, unsigned nout, uint32_t *res,
+    uint8_t *enc, uint32_t room)
+{
+	static uint8_t data[FRPC_READ_MAX];
+	uint32_t po[24];
+	const void *pp[4] = { po, data, NULL, NULL };
+	uint32_t sz[4] = { 0, 0, 0, 0 };
+
+	bzero(po, sizeof(po));
+	*res = AEE_EUNSUPPORTED;
+	if (method == 19 && got >= 5) {                         /* fopen_with_env(env, delim, name, mode) -> fd */
+		char env[40], name[200], mode[8], path[300];
+		uint64_t size = 0;
+		bool dir = false;
+		unsigned f;
+
+		strlcpy(env, (const char *)p[1], LESSER(sizeof(env), (size_t)s[1] + 1));
+		strlcpy(name, (const char *)p[3], LESSER(sizeof(name), (size_t)s[3] + 1));
+		strlcpy(mode, (const char *)p[4], LESSER(sizeof(mode), (size_t)s[4] + 1));
+		sz[0] = 4;
+		if (mode[0] == 'w' || mode[0] == 'a' || strchr(mode, '+') != NULL) {
+			*res = AEE_EUNSUPPORTED;
+			say("frpc: 22c3: fopen(\"%s\", \"%s\"): a WRITE -- refused (nothing is written)\n", name, mode);
+		} else if (!frpc_map(env, name, path, sizeof(path))) {
+			*res = AEE_EBADPARM;
+			say("frpc: 22c3: fopen(\"%s\" via %s): not in our tree -- refused\n", name, env);
+		} else if (!frpc_stat_path(path, &size, &dir) || dir) {
+			*res = AEE_EFAILED;
+			frpc_open_fails++;
+			say("frpc: 22c3: fopen(\"%s\") -> %s: %s\n", name, path, dir ? "a directory" : "NOT THERE");
+		} else {
+			for (f = 0; f < 24 && frpc_fd[f].used; f++) {
+			}
+			if (f == 24) {
+				*res = AEE_EFAILED;
+			} else {
+				strlcpy(frpc_fd[f].path, path, sizeof(frpc_fd[f].path));
+				frpc_fd[f].pos = 0;
+				frpc_fd[f].size = size;
+				frpc_fd[f].used = true;
+				po[0] = f + 1;
+				*res = 0;
+				frpc_opens++;
+				say("frpc: 22c3: fopen(\"%s\") -> %s: fd %u, %llu bytes\n", name, path, f + 1, size);
+			}
+		}
+	} else if (method == 4 && got >= 1 && s[0] >= 8) {      /* fread(fd, size) -> written, eof, data */
+		uint32_t fd = le32(p[0]) - 1, want = le32(p[0] + 4), n = 0;
+
+		/*
+		 * 22f: as hexagonrpcd (alloc_outbufs4 + apps_std_fread): the data out-buffer is ALWAYS as long as the DSP asked
+		 * (zero after what was read), written = the bytes read, eof = written < asked. 22c3-22e answered with only the
+		 * bytes read (capped at 1536) and the DSP never went on from the lists.
+		 */
+		sz[0] = 8;
+		bzero(data, LESSER(want, (uint32_t)sizeof(data)));
+		if (want > sizeof(data)) {
+			*res = AEE_EFAILED;
+			say("frpc: 22c3: fread of %u bytes: more than our %u -- failed\n", want, (uint32_t)sizeof(data));
+		} else if (fd >= 24 || !frpc_fd[fd].used) {
+			*res = AEE_EFAILED;
+		} else {
+			if (frpc_read_path(frpc_fd[fd].path, frpc_fd[fd].pos, data, want, &n) != 0) {
+				*res = AEE_EFAILED;
+			} else {
+				frpc_fd[fd].pos += n;
+				po[0] = n;
+				po[1] = n < want ? 1 : 0;
+				sz[1] = want;
+				*res = 0;
+				frpc_reads++;
+				frpc_bytes += n;
+			}
+		}
+	} else if (method == 9 && got >= 1 && s[0] >= 12) {     /* fseek(fd, offset, whence) */
+		uint32_t fd = le32(p[0]) - 1, whence = le32(p[0] + 8);
+		int64_t off = (int32_t)le32(p[0] + 4), base;
+
+		if (fd >= 24 || !frpc_fd[fd].used || whence > 2) {
+			*res = AEE_EFAILED;
+		} else {
+			base = whence == 0 ? 0 : whence == 1 ? (int64_t)frpc_fd[fd].pos : (int64_t)frpc_fd[fd].size;
+			*res = base + off < 0 ? AEE_EFAILED : 0;
+			if (*res == 0) {
+				frpc_fd[fd].pos = (uint64_t)(base + off);
+			}
+		}
+	} else if (method == 3 && got >= 1 && s[0] >= 4) {      /* fclose(fd) */
+		uint32_t fd = le32(p[0]) - 1;
+
+		*res = fd < 24 && frpc_fd[fd].used ? 0 : AEE_EFAILED;
+		if (fd < 24) {
+			frpc_fd[fd].used = false;
+		}
+	} else if (method == 31 && got >= 2) {                  /* stat(name) -> 96 bytes */
+		char name[200], path[300];
+		uint64_t size = 0, v[12];
+		bool dir = false;
+
+		strlcpy(name, (const char *)p[1], LESSER(sizeof(name), (size_t)s[1] + 1));
+		sz[0] = 96;
+		if (!frpc_map(NULL, name, path, sizeof(path)) || !frpc_stat_path(path, &size, &dir)) {
+			*res = AEE_EFAILED;
+			say("frpc: 22c3: stat(\"%s\"): NOT THERE\n", name);
+		} else {
+			uint8_t *b = (uint8_t *)po;
+
+			bzero(v, sizeof(v));
+			memcpy(b + 0, &v[0], 8);                        /* tsz */
+			memcpy(b + 8, &v[0], 8);                        /* dev */
+			v[1] = frpc_opens + 1;
+			memcpy(b + 16, &v[1], 8);                       /* ino */
+			po[6] = dir ? 040555u : 0100444u;               /* mode */
+			po[7] = 1;                                      /* nlink */
+			memcpy(b + 32, &v[0], 8);                       /* rdev */
+			memcpy(b + 40, &size, 8);                       /* size; the times stay 0 */
+			*res = 0;
+			say("frpc: 22c3: stat(\"%s\") -> %s: %s, %llu bytes\n", name, path, dir ? "directory" : "file", size);
+		}
+	} else {
+		say("frpc: 22c3: apps_std method %u: not served (AEE_EUNSUPPORTED)\n", method);
+	}
+	if (*res != 0) {
+		/* (hexagonrpcd sends the out-buffers at their full asked sizes with a failed result too) */
+		bzero(sz, sizeof(sz));
+		sz[0] = method == 19 ? 4 : method == 4 ? 8 : method == 31 ? 96 : 0;
+		if (method == 4 && got >= 1 && s[0] >= 8 && le32(p[0] + 4) <= sizeof(data)) {
+			sz[1] = le32(p[0] + 4);
+			bzero(data, sz[1]);
+		}
+	}
+	return frpc_enc(enc, room, pp, sz, nout < 4 ? nout : 4);
+}
+
+static void
+frpc_listener_probe(struct gchan *ch)
+{
+	uint32_t reqs = 16, rctx = 0, res = 0xffffffffu, served = 0, hdl = 0, ret_len = 0, serve = 0, secs = 20, idle_ms = 8000;
+	uint64_t t0 = now_us();
+	int32_t r;
+	static uint8_t ret_enc[FRPC_READ_MAX + 256];
+
+	PE_parse_boot_argn("icefrpc_reqs", &reqs, sizeof(reqs));
+	PE_parse_boot_argn("icefrpc_serve", &serve, sizeof(serve));
+	if (frpc_serve_forced) {
+		serve = 1;              /* (the service: its root is set by iceadsp_frpc_serve) */
+	} else {
+		PE_parse_boot_argn("icefrpc_root", frpc_root, sizeof(frpc_root));
+	}
+	if (serve) {
+		uint32_t idle_s = 5;
+
+		reqs = reqs < 4000 ? 4000 : reqs;
+		secs = 60;
+		/* 22e: 22c3 / 22d's PD went quiet for 5 s after the two lists and was released at once (0 sensors): wait longer */
+		PE_parse_boot_argn("icefrpc_idle", &idle_s, sizeof(idle_s));
+		PE_parse_boot_argn("icefrpc_secs", &secs, sizeof(secs));
+		idle_s = idle_s < 1 ? 1 : idle_s > 120 ? 120 : idle_s;
+		secs = secs < 10 ? 10 : secs > 600 ? 600 : secs;
+		idle_ms = idle_s * 1000;
+		frpc_opens = frpc_open_fails = frpc_reads = frpc_bytes = 0;
+		say("frpc: 22c3: serving the DSP's apps_std calls read-only from %s (%u requests / %u s at most)\n", frpc_root,
+		    reqs, secs);
+	}
+	{
+		static const char name[] = "adsp_default_listener";
+		uint32_t pin[2] = { sizeof(name), 256 }, pout[2] = { 0, 0 };
+		static char err[256];
+		struct frpc_buf in[2] = { { pin, sizeof(pin) }, { (void *)(uintptr_t)name, sizeof(name) } },
+		    out[2] = { { pout, sizeof(pout) }, { err, sizeof(err) } };
+
+		r = frpc_invoke(ch, 1, 0, 0, in, 2, out, 2, 4, 3000, "remotectl_open(\"adsp_default_listener\")");
+		say("frpc: 22c2: remotectl_open: retval %d, handle %#x, dlerr %#x, \"%.60s\"\n", r, pout[0], pout[1], err);
+		if (r != 0 || pout[1] != 0) {
+			return;
+		}
+		hdl = pout[0];
+	}
+	r = frpc_invoke(ch, 1, hdl, 0, NULL, 0, NULL, 0, 5, 3000, "adsp_default_listener_register");
+	if (r != 0) {
+		say("frpc: 22c2: register %s\n", r == INT32_MIN ? "unanswered" : "refused");
+		return;
+	}
+	r = frpc_invoke(ch, 1, FRPC_HANDLE_LISTENER, 3, NULL, 0, NULL, 0, 2, 3000, "adsp_listener_init2");
+	if (r != 0) {
+		say("frpc: 22c2: init2 %s: no listener\n", r == INT32_MIN ? "unanswered" : "refused");
+		return;
+	}
+	while (served < reqs && now_us() - t0 < (uint64_t)secs * 1000000ull && !g_broken && !adsp_stop_req) {
+		uint32_t pin[4] = { rctx, res, ret_len, 1024 }, pout[4] = { 0 }, s[8] = { 0 }, nin, nout, method;
+		static uint8_t inbufs[1024];
+		const uint8_t *p[8] = { NULL };
+		struct frpc_buf in[2] = { { pin, sizeof(pin) }, { ret_enc, ret_len } }, out[2] = { { pout, sizeof(pout) },
+			                                                                       { inbufs, sizeof(inbufs) } };
+		char text[160];
+		unsigned t = 0, got;
+
+		bzero(inbufs, sizeof(inbufs));
+		if (serve) {
+			g_quiet = true;
+		}
+		frpc_span = 10;         /* (slots 6-15: up to 32 KB of answer data) */
+		r = frpc_invoke(ch, 1, FRPC_HANDLE_LISTENER, 4, in, 2, out, 2, 6, idle_ms, served ?
+		    "adsp_listener_next2 (our answer, then the next request)" : "adsp_listener_next2 (the first request)");
+		g_quiet = false;
+		frpc_span = 1;
+		if (r != 0) {
+			say("frpc: 22c2: next2 %s after %u request(s); served: %u opens, %u not there, %u reads, %u bytes\n",
+			    r == INT32_MIN ? "unanswered (no more requests for now)" : "refused", served, frpc_opens,
+			    frpc_open_fails, frpc_reads, frpc_bytes);
+			return;
+		}
+		method = (pout[2] >> 24) & 0x1f;
+		nin = (pout[2] >> 16) & 0xff;
+		nout = (pout[2] >> 8) & 0xff;
+		got = frpc_dec(inbufs, LESSER(pout[3], (uint32_t)sizeof(inbufs)), nin, p, s);
+		for (unsigned k = 0; k < got && t < sizeof(text) - 4; k++) {
+			for (uint32_t i = 0; i < s[k] && t < sizeof(text) - 4; i++) {
+				char c = (char)p[k][i];
+
+				text[t++] = (c >= 32 && c < 127) ? c : '.';
+			}
+			text[t++] = '|';
+		}
+		text[t] = 0;
+		if (!serve || pout[1] != 1 || (method != 4 && method != 9 && method != 3)) {
+			say("frpc: 22c2: THE DSP ASKS: rctx %#x handle %u method %u (%u in, %u out), in-buffers \"%s\"\n", pout[0],
+			    pout[1], method, nin, nout, text);
+		}
+		rctx = pout[0];
+		res = 0xffffffffu;
+		ret_len = 0;
+		if (pout[1] == 0 && method == 0 && got >= 2) {           /* remotectl open(name) */
+			static uint8_t errz[256];
+			uint32_t po[2] = { 0, 0 }, sz[2] = { sizeof(po), 0 }, h = 0;
+			const void *pp[2] = { po, errz };
+			char nm[32];
+
+			bzero(nm, sizeof(nm));
+			memcpy(nm, p[1], LESSER(s[1], (uint32_t)sizeof(nm) - 1));
+			h = strcmp(nm, "apps_std") == 0 ? 1 : strcmp(nm, "apps_mem") == 0 ? 2 : 0;
+			po[0] = h;
+			po[1] = h ? 0 : 0xffffffffu;
+			if (s[0] >= 8) {
+				sz[1] = LESSER(le32(p[0] + 4), (uint32_t)sizeof(errz));  /* the error text: as long as asked, empty */
+			}
+			ret_len = frpc_enc(ret_enc, sizeof(ret_enc), pp, sz, nout < 2 ? nout : 2);
+			res = h ? 0 : 0xffffffffu;
+			say("frpc: 22c2: our remotectl: open(\"%s\") -> %s\n", nm, h ? (h == 1 ? "handle 1 (apps_std)" :
+			    "handle 2 (apps_mem)") : "not here (dlerr -1)");
+		} else if (pout[1] == 0 && method == 1) {               /* remotectl close */
+			uint32_t po[1] = { 0 }, sz[2] = { 4, 0 };
+			const void *pp[2] = { po, NULL };
+
+			ret_len = frpc_enc(ret_enc, sizeof(ret_enc), pp, sz, nout < 2 ? nout : 2);
+			res = 0;
+		} else if (serve && pout[1] == 1) {
+			ret_len = frpc_apps_std(method, p, s, got, nout, &res, ret_enc, sizeof(ret_enc));
+		} else {
+			uint32_t sz[4] = { 0, 0, 0, 0 };
+			const void *pp[4] = { NULL };
+
+			ret_len = frpc_enc(ret_enc, sizeof(ret_enc), pp, sz, nout < 4 ? nout : 4);
+			say("frpc: 22c2: %s method %u: answered FAILED (no file served yet)\n", pout[1] == 1 ? "apps_std" :
+			    pout[1] == 2 ? "apps_mem" : "unknown handle", method);
+		}
+		served++;
+	}
+	say("frpc: 22c2: %u request(s); served: %u opens, %u not there, %u reads, %u bytes\n", served, frpc_opens,
+	    frpc_open_fails, frpc_reads, frpc_bytes);
+}
+
+/* 22a (+ 22b attach, + 22c probe): set, use, put back */
+static bool
+frpc_level_22a(uint32_t level)
+{
+	uint32_t fsr;
+	bool attached = false, leave = false;
+
+	mark(M_SNS, MARK_BUSY);
+	say("frpc: level 22%c (icefrpc=%u): apps-SMMU bank for FastRPC session %u (streams 0x1003/0x80, 0x1043/0x20)%s\n",
+	    'a' + (int)level - 1, level, FRPC_SESSION, level >= 3 ? " + attach to the sensors PD + the listener probe" :
+	    level == 2 ? " + attach to the sensors PD" : "; no DSP traffic");
+	if (!fx_setup()) {
+		say("frpc: 22a FAILED before any write or at the setup\n");
+		mark(M_SNS, MARK_FAIL);
+		return false;
+	}
+	if (level >= 2) {
+		struct gchan *ch = frpc_channel();
+		uint32_t client = 1;
+		struct frpc_buf in = { &client, sizeof(client) };
+		int32_t r;
+
+		if (ch == NULL) {
+			say("frpc: 22b REFUSED: \"fastrpcglink-apps-dsp\" is not open both ways\n");
+		} else {
+			r = frpc_invoke(ch, 0, FRPC_HANDLE_INIT, FRPC_RMID_ATTACH, &in, 1, NULL, 0, 0, 3000,
+			    "fastrpc_init_attach(SENSORS_PD)");
+			attached = r == 0;
+			say("frpc: 22b ATTACH %s (retval %d)\n", attached ? "PASS: the sensors PD took us" : "FAILED", r);
+			if (attached && level >= 3) {
+				frpc_listener_probe(ch);
+			} else if (level >= 3) {
+				say("frpc: 22c REFUSED: no attach\n");
+			}
+			uint32_t keep = 0;
+
+			PE_parse_boot_argn("icefrpc_keep", &keep, sizeof(keep));
+			keep |= frpc_keep_forced ? 1u : 0u;
+			if (attached && keep) {
+				/* 22e: the sensors PD stays attached (the SNS steps that follow need its registry): no release */
+				leave = true;
+				say("frpc: icefrpc_keep=1: the sensors PD stays attached (no INIT_RELEASE), bank 8 stays set\n");
+			} else if (attached && adsp_stop_req) {
+				/* the run ends: no release; the DSP is shut down next and bank 8 put back after it (adsp_down) */
+				leave = true;
+				say("frpc: the run ends: no INIT_RELEASE; bank 8 goes back after the DSP's shutdown\n");
+			} else if (attached) {
+				leave |= frpc_outstanding;
+				r = frpc_invoke(ch, 0, FRPC_HANDLE_INIT, FRPC_RMID_RELEASE, &in, 1, NULL, 0, 1, 3000,
+				    "INIT_RELEASE (put back)");
+				say("frpc: release: retval %d\n", r);
+			}
+			leave |= frpc_outstanding;
+		}
+	} else {
+		for (int i = 0; i < 2000 && !g_broken; i++) {
+			g_pump();
+			sleep_ms(1);
+		}
+	}
+	fsr = rd(fx.cb + 0x58);
+	if (leave) {
+		say("frpc: an invoke is still with the DSP: bank %u LEFT SET (FSR %#x), so its late answer lands in our buffer\n",
+		    fx.bank, fsr);
+	} else {
+		fx_teardown();
+	}
+	say("frpc: 22%c done: FSR %#x, attach %s, bank %s\n", 'a' + (int)level - 1, fsr, level >= 2 ? (attached ? "ok" :
+	    "FAILED") : "not asked", leave ? "LEFT SET" : "put back");
+	mark(M_SNS, (level < 2 || attached) && fsr != 0 && fsr != 0x400 ? MARK_FAIL : (level < 2 || attached) ? MARK_OK :
+	    MARK_FAIL);
+	return level < 2 || attached;
+}
+
+/* level C2 on its own: set up, map at the DSP, check, unmap, put back */
+static bool
+audio_c2(struct gchan *apps)
+{
+	uint32_t handle;
+	bool ok;
+
+	say("c2: level C2 (icesmmu=1, the owner's decision): option A, SMR %s, our own bank\n", "9/10 (icesmmu_smr)");
+	if (!c2_setup()) {
+		say("c2: level C2 FAILED before any write or at the setup\n");
+		return false;
+	}
+	handle = c2_dsp_map(apps);
+	c2_fault_report("after the map");
+	if (handle != 0) {
+		c2_dsp_unmap(apps, handle);
+	}
+	c2_teardown();
+	ok = handle != 0;
+	say("c2: level C2 %s\n", ok ? "PASS: bank set, the DSP took the buffer's IOVA, unmapped, everything put back" :
+	    "FAILED (the SMMU was put back)");
+	return ok;
+}
+
+/*
+ * ---- Microphone level E (boot-arg icemic=1, OFF by default; the owner's yes for these LPASS clock writes, 31 Oct) ----
+ * Only with icedsp=10 (GPR up: the APM ready and the PRM answering) and none of iceaudio / icesmmu / icetone in the same
+ * run. The path (DT/UCM): WCD9395 AMIC1/AMIC5 -> ADC1/ADC2 -> its SoundWire TX device -> swr2 (the TX macro's master)
+ * -> TX macro DEC0. E is the bus only: the clocks, the master, the enumeration; no codec register, no capture, no SMMU.
+ * Values (q90t tree): kaanapali.dtsi lpass_txmacro codec@6ae0000 ("qcom,sm8550-lpass-tx-macro": lpass_ver_11, flags
+ * RESET_SWR only -- no NPL clock), clocks mclk = q6prmcc LPASS_CLK_ID_TX_CORE_MCLK, macro = LPASS_HW_MACRO_VOTE, dcodec
+ * = LPASS_HW_DCODEC_VOTE, fsgen = lpass_vamacro (codec@7660000); swr2 soundwire@7630000 ("qcom,soundwire-v2.2.0",
+ * swrm_v2_0_data: 50 rows, 16 columns), iface clock = the TX macro's swclk gate, pinctrl tx_swr_active (lpass_tlmm
+ * pinctrl@7760000: gpio0 swr_tx_clk, gpio1/2/14 swr_tx_data, 2 mA, slew 1; clock bias off, data bus-hold); the board:
+ * &swr2 wcd_tx codec@0,3 "sdw20217010e00" (SoundWire 2, manufacturer 0x0217, part 0x010e, unique id 3), wcd939x
+ * reset-gpios tlmm 161 active low, supplies L15B / BOB1 / L1G (not voted here).
+ *   1. PRM (q6prm.c): PRM_CMD_REQUEST_HW_RSC PARAM_ID_RSC_HW_CORE hw block 1 (LPASS_HW_MACRO_VOTE -> Q6PRM_HW_CORE_ID_LPASS)
+ *      and 2 (DCODEC), then PARAM_ID_RSC_AUDIO_HW_CLK {TX_CORE_MCLK 0x30c, 19.2 MHz (tx_macro_probe clk_set_rate), attr
+ *      COUPLE_NO 1, root 0} -- the order Linux's clocks reach the DSP (lpass_tlmm's probe holds macro + dcodec first);
+ *      each answered with status 0 or nothing else is done (what was granted is released);
+ *   2. [icemic_fsgen=1] the VA macro's fsgen (lpass-va-macro.c va_clk_rsc_fs_gen_request + fsgen_gate_enable);
+ *   3. the TX macro: tx_macro_probe's SWR_CONTROL reset 1, clock 1, reset 0, then swclk_gate_enable (swr2's iface clock):
+ *      FREQ_MCLK bit 0, MCLK_CONTROL bit 0, FS_CNT_CONTROL bit 0, SWR_CONTROL bit 0 -- each a read-modify-write, read back;
+ *   4. swr2 only once MCLK_CONTROL and SWR_CONTROL read back enabled: ONE read of COMP_HW_VERSION (0x0); only if it is a
+ *      v2.x version (0x02xxxxxx): the state read, [icemic_pins=0: not] the four LPASS TLMM pads to swr_tx (only if each
+ *      is found as gpio or already swr_tx), qcom_swrm_init for v2 (FRAME_CTRL_BANK(0) rows 50 / cols 16 = 0xf, auto
+ *      enumeration on, MCP_CFG no-pings 0x1f, LINK_MANAGER_EE CPU, V2 CLK_CTRL start, CMD_FIFO_CFG 7 | continue, COMP_CFG
+ *      1 / 2, INTERRUPT_CLEAR all, COMP_CFG 3) -- except INTERRUPT_CPU_EN: left as found (no handler here: polled);
+ *      the frame generator awaited (LINK_STATUS bit 0), then MCP_SLV_STATUS polled icemic_ms (500) ms; each attached
+ *      device's ENUMERATOR_SLAVE_DEV_ID_1/2 read and decoded as sdw_extract_slave_id. Not done: the SCP writes the
+ *      SoundWire core makes after an attach, any WCD9395 register, the codec's reset pin (gpio161: read only) or supplies
+ *      -- unless icemic_power=1 (OFF by default): then mic_codec_power (below) first, before the PRM votes;
+ *   5. everything put back in reverse (swr2, pads, TX macro, VA) with the found values, read back, then the MCLK, dcodec
+ *      and macro released. No LPASS register is read after its clocks are given back.
+ * Lines: "mic: ...", the result "mic: E PASS ..." / "mic: E FAIL ..."; mark 25.
+ */
+#define mic(...) kit_line("mic: ", __VA_ARGS__)
+#define MIC_TXM_PHYS            0x06ae0000UL
+#define MIC_VA_PHYS             0x07660000UL
+#define MIC_SWR_PHYS            0x07630000UL
+#define MIC_LPI_PHYS            0x07760000UL
+#define MIC_CTL_OE              (1u << 9)
+#define MIC_CTL_EGPIO_PRESENT   (1u << 11)
+#define MIC_CTL_EGPIO_ENABLE    (1u << 12)
+#define MIC_TLMM161_PAGE        0x0f1a0000UL    /* tlmm 0x0f100000 + 0x1000 x 160 (16 KB aligned); gpio161 at +0x1000 */
+#define MIC_CLK_TX_CORE_MCLK    0x30cu
+#define MIC_MCLK_HZ             19200000u
+#define MIC_HW_LPASS            1u
+#define MIC_HW_DCODEC           2u
+/* TX / VA macro (lpass-tx-macro.c, lpass-va-macro.c) */
+#define TXM_MCLK_CONTROL        0x000u
+#define TXM_FS_CNT_CONTROL      0x004u
+#define TXM_SWR_CONTROL         0x008u
+#define TXM_TOP_CFG0            0x080u
+#define TXM_FREQ_MCLK           0x090u
+/* swr2 (soundwire/qcom.c, v2 layout) */
+#define SWR_HW_VERSION          0x0000u
+#define SWR_COMP_CFG            0x0004u
+#define SWR_LINK_MANAGER_EE     0x0018u
+#define SWR_COMP_PARAMS         0x0100u
+#define SWR_COMP_MASTER_ID      0x0104u
+#define SWR_CMD_FIFO_CFG        0x0314u
+#define SWR_ENUMERATOR_CFG      0x0500u
+#define SWR_DEV_ID_1(m)         (0x0530u + 0x8u * (m))
+#define SWR_DEV_ID_2(m)         (0x0534u + 0x8u * (m))
+#define SWR_FRAME_CTRL_BANK0    0x101Cu
+#define SWR_MCP_CFG             0x1048u
+#define SWR_MCP_STATUS          0x104Cu
+#define SWR_MCP_SLV_STATUS      0x1090u
+#define SWR_INT_STATUS          0x5000u
+#define SWR_INT_CPU_EN          0x5004u
+#define SWR_INT_CLEAR           0x5008u
+#define SWR_CMD_FIFO_STATUS     0x5050u
+#define SWR_CLK_CTRL            0x5060u
+#define SWR_LINK_STATUS         0x5064u
+#define WCD_SDW_MFG             0x0217u
+#define WCD_SDW_PART            0x010eu
+#define WCD_SDW_TX_UNIQUE       3u
+
+struct mic_blk {
+	const char *name;
+	uint64_t pa;
+	vm_offset_t va;
+};
+static unsigned mic_writes, mic_bad;
+
+static uint32_t
+mic_rd(const struct mic_blk *b, uint32_t off)
+{
+	return rd(b->va + off);
+}
+
+/* one write: the found value, the new one, the read-back (compared under `check`; 0 = write-only, nothing read) */
+static bool
+mic_wr(const struct mic_blk *b, uint32_t off, const char *reg, uint32_t val, uint32_t check)
+{
+	uint32_t was = check ? rd(b->va + off) : 0, now = 0;
+	bool ok;
+
+	wr(b->va + off, val);
+	settle();
+	if (check) {
+		now = rd(b->va + off);
+	}
+	ok = check == 0 || (now & check) == (val & check);
+	mic_writes++;
+	mic_bad += !ok;
+	if (check) {
+		mic("W %s %#llx %s: %#x -> %#x, read back %#x (%s)\n", b->name, b->pa + off, reg, was, val, now, ok ? "ok" :
+		    "NOT AS WANTED");
+	} else {
+		mic("W %s %#llx %s: %#x (write-only)\n", b->name, b->pa + off, reg, val);
+	}
+	return ok;
+}
+
+/* regmap_update_bits: written only if the value changes */
+static bool
+mic_upd(const struct mic_blk *b, uint32_t off, const char *reg, uint32_t mask, uint32_t bits)
+{
+	uint32_t was = rd(b->va + off), val = (was & ~mask) | (bits & mask);
+
+	if (val == was) {
+		mic("  %s %#llx %s: %#x already as wanted (mask %#x = %#x): not written\n", b->name, b->pa + off, reg, was, mask,
+		    bits);
+		return true;
+	}
+	return mic_wr(b, off, reg, val, mask);
+}
+
+/* one PRM request / release (q6prm.c's packets); the DSP's status, or -1 */
+static int32_t
+mic_prm(struct gchan *apps, bool request, uint32_t param_id, uint32_t id, uint32_t hz, const char *what)
+{
+	uint8_t b[64], *o = b;
+	uint32_t opcode = request ? PRM_REQUEST_HW_RSC : PRM_RELEASE_HW_RSC, rsp = request ? PRM_RSP_REQUEST_HW_RSC :
+	    PRM_RSP_RELEASE_HW_RSC, seq = gpr_rx_seq;
+	uint64_t t0 = now_us();
+
+	if (param_id == PARAM_ID_RSC_HW_CORE) {
+		au_param(&o, GPR_PRM_IID, param_id, 4);
+		au_put(&o, id);
+	} else if (request) {
+		au_param(&o, GPR_PRM_IID, param_id, 4 + 16);
+		au_put(&o, 1);
+		au_put(&o, id); au_put(&o, hz); au_put(&o, 1); au_put(&o, 0);
+	} else {
+		au_param(&o, GPR_PRM_IID, param_id, 4 + 4);
+		au_put(&o, 1);
+		au_put(&o, id);
+	}
+	mic("PRM > %s %#x, param %#x, id %#x%s: %s\n", request ? "REQUEST_HW_RSC" : "RELEASE_HW_RSC", opcode, param_id, id,
+	    param_id == PARAM_ID_RSC_AUDIO_HW_CLK && request ? ", 19.2 MHz, COUPLE_NO, root 0" : "", what);
+	if (!gpr_send(apps, GPR_PRM_IID, GPR_PRM_IID, opcode, b, (uint32_t)(o - b))) {
+		mic("PRM %s: NOT SENT\n", what);
+		return -1;
+	}
+	while (now_us() - t0 < 2000000ull && !g_broken) {
+		g_pump();
+		if (gpr_rx_seq != seq) {
+			seq = gpr_rx_seq;
+			if (gpr_rx_opcode == rsp || (gpr_rx_opcode == GPR_BASIC_RSP_RESULT && gpr_rx_w0 == opcode)) {
+				int32_t status = (int32_t)gpr_rx_w1;
+
+				mic("PRM < %s: %s (status %#x, answer %#x)\n", what, status == 0 ? "OK" : "REFUSED", status,
+				    gpr_rx_opcode);
+				return status;
+			}
+		}
+		sleep_ms(1);
+	}
+	mic("PRM %s: NO ANSWER in 2 s\n", what);
+	return -1;
+}
+
+/*
+ * Every mapping of level E is given back at its end, so it must be made unmappable: ml_io_map's mappings are permanent
+ * VM map entries, and ml_io_unmap of one panics in vm_map_delete ("Attempting to remove permanent VM map entry",
+ * ipad17h, 31 Oct, right after the gpio161 read). image_load's ml_io_map_unmappable / ml_io_unmap pair is the model.
+ */
+static vm_offset_t
+mic_map(vm_offset_t pa, vm_size_t size)
+{
+	return ml_io_map_unmappable(pa, size, VM_WIMG_IO);
+}
+
+/*
+ * [icemic_power=1, OFF by default; the main session decides] The codec powered up as Linux's wcd939x_probe does on
+ * this board (kaanapali-oneplus-iceland.dts wcd939x node: reset-gpios tlmm 161 ACTIVE_LOW, pinctrl wcd_default =
+ * gpio161 function gpio, drive-strength 4, bias-disable; vdd-rxtx / vdd-io / vdd-buck = vreg_l15b_1p8, vdd-mic-bias =
+ * vreg_bob1, vdd-px = vreg_l1g_1p2):
+ *   a. pinctrl default: gpio161 CTL = function 0 (gpio), 4 mA, no pull, OE as found (0);
+ *   b. devm_gpiod_get(OUT_LOW) of an active-low line = the pad driven HIGH (reset not asserted): IO out 1, then OE 1
+ *      (msm_gpio_direction_output: the value, then OE);
+ *   c. devm_regulator_bulk_get_enable: through our RPMh TCS (rpmh-regulator's commands, waited for), per regulator
+ *      the mode it sets at registration (regulator-initial-mode), then the enable (with the fixed voltage first):
+ *        L15B_E0 (pmh0101 ldo15, nldo530): MODE (+8) = 5 (AUTO -> NORMAL -> PMIC530 OPM), VOLTAGE (+0) = 1800 mV,
+ *                                            ENABLE (+4) = 1;
+ *        B1B_E0  (pmh0101 bob1):           MODE (+8) = 7 (HPM -> FAST -> PMIC5 BOB PWM), ENABLE (+4) = 1 (no voltage:
+ *                                            min != max, Linux sends none);
+ *        L1G_E0  (pmh0110 ldo1, nldo530):  MODE (+8) = 5, VOLTAGE (+0) = 1200 mV, ENABLE (+4) = 1;
+ *      all three addresses must be in cmd-db or nothing at all is written;
+ *   d. wcd939x_reset: the pad LOW (reset asserted) 30 us, HIGH again, 30 us.
+ * The pad is put back as found at level E's end (the codec held in reset again by its pull-down). The three RPMh votes
+ * stay (not released): our TCS writes the apps DRV's vote, and a release could take away a vote the boot chain left
+ * on the same DRV for the same rail (L15B is also the amplifiers' vddio) -- the same reason ACV is left alone.
+ * Returns true when the pad was written (so it must be put back).
+ */
+static bool
+mic_codec_power(vm_offset_t tlmm161, uint32_t *f_ctl, uint32_t *f_io)
+{
+	static const struct {
+		const char *name;
+		uint32_t mode, mv;              /* mv 0: no voltage command */
+	} sup[3] = { { "L15B_E0", 5, 1800 }, { "B1B_E0", 7, 0 }, { "L1G_E0", 5, 1200 } };
+	uint32_t addr[3], ctl, io;
+	unsigned done = 0, asked = 0;
+	vm_offset_t c = tlmm161 + 0x1000, o = tlmm161 + 0x1004;
+
+	for (unsigned i = 0; i < 3; i++) {
+		addr[i] = cmd_db_lookup(sup[i].name, NULL, NULL, 0);
+		mic("power: cmd-db %s = %#x\n", sup[i].name, addr[i]);
+		if (addr[i] == 0) {
+			mic("power: REFUSED: %s not in cmd-db: no pad write, no vote\n", sup[i].name);
+			return false;
+		}
+	}
+	*f_ctl = rd(c);
+	*f_io = rd(o);
+	/* a: pinctrl default */
+	ctl = (*f_ctl & ~0x3ffu) | 0u /* no pull */ | 0u << 2 /* gpio */ | 1u << 6 /* 4 mA */ | (*f_ctl & MIC_CTL_OE);
+	if (ctl & MIC_CTL_EGPIO_PRESENT) {
+		ctl |= MIC_CTL_EGPIO_ENABLE;
+	}
+	mic("power: W tlmm gpio161 CTL %#x -> %#x (pinctrl wcd_default: gpio, 4 mA, bias-disable)\n", *f_ctl, ctl);
+	wr(c, ctl);
+	settle();
+	/* b: gpiod_get OUT_LOW of an active-low line: the pad high */
+	mic("power: W tlmm gpio161 IO %#x -> 0x2 (out 1: reset not asserted)\n", *f_io);
+	wr(o, 2);
+	settle();
+	mic("power: W tlmm gpio161 CTL %#x -> %#x (OE 1)\n", ctl, ctl | MIC_CTL_OE);
+	ctl |= MIC_CTL_OE;
+	wr(c, ctl);
+	settle();
+	/* c: the supplies, through the exported vote (MODE, VOLTAGE, ENABLE each; logged as "RPMh vote: ...") */
+	for (unsigned i = 0; i < 3; i++) {
+		int r = hakios_iceland_rpmh_vote(sup[i].name, (int32_t)sup[i].mode, sup[i].mv * 1000u, true);
+
+		asked++;
+		done += r == 0;
+		mic("power: RPMh %s mode %u, %u mV, enable 1: %s\n", sup[i].name, sup[i].mode, sup[i].mv, r == 0 ? "done" :
+		    "NOT DONE");
+	}
+	if (done != asked) {
+		mic("power: %u of %u supply votes not done: NO RESET PULSE (the pad is put back at the end)\n", asked - done,
+		    asked);
+		return true;
+	}
+	/* d: wcd939x_reset (usleep_range(20, 30) after each edge) */
+	mic("power: W tlmm gpio161 IO -> 0 (reset asserted), 30 us, IO -> 0x2 (released), 30 us\n");
+	wr(o, 0);
+	settle();
+	delay_for_interval(30, NSEC_PER_USEC);
+	wr(o, 2);
+	settle();
+	delay_for_interval(30, NSEC_PER_USEC);
+	io = rd(o);
+	mic("power: gpio161 now ctl %#x io %#x (in %u): the codec is %s\n", rd(c), io, io & 1, (io & 1) ?
+	    "OUT OF RESET, SUPPLIES VOTED" : "STILL LOW (NOT out of reset)");
+	return true;
+}
+
+/*
+ * 17r1a (icemic_cmd=1 with icemic_power=1, after the enumeration): the WCD9395's registers read through swr2's
+ * command FIFO, as soundwire/qcom.c qcom_swrm_cmd_fifo_rd_cmd (v2 layout): CMD_FIFO_RD_CMD (+0x5024) = reg | id << 16 |
+ * dev << 20 | len 1 << 24 (id 1..14, rising), then CMD_FIFO_STATUS (+0x5050) bits 20:16 > 0 awaited, CMD_FIFO_RD_FIFO
+ * (+0x5040): data bits 7:0, its id bits 11:8 must match. The codec's registers sit below 0x8000 (wcd939x.h: 0x3000..)
+ * so no SCP page write. Read: DIGITAL_CHIP_ID0..3 (0x3401..0x3404) and EAR_STATUS_REG_1 -- wcd939x_bind's version
+ * check (CHIP_ID1, EAR_STATUS_REG_1). The only writes are the FIFO's own read commands (no codec register written).
+ */
+#define SWR_CMD_FIFO_RD_CMD     0x5024u
+#define SWR_CMD_FIFO_RD_FIFO    0x5040u
+static uint32_t mic_rcmd_id;
+
+static int32_t
+mic_cmd_read(const struct mic_blk *swr, unsigned dev, uint16_t reg)
+{
+	uint32_t val, st = 0, data = 0;
+
+	mic_rcmd_id = mic_rcmd_id >= 14 ? 1 : mic_rcmd_id + 1;
+	val = reg | mic_rcmd_id << 16 | (uint32_t)dev << 20 | 1u << 24;
+	delay_for_interval(100, NSEC_PER_USEC);
+	wr(swr->va + SWR_CMD_FIFO_RD_CMD, val);
+	delay_for_interval(250, NSEC_PER_USEC);
+	for (int i = 0; i < 20; i++) {
+		st = rd(swr->va + SWR_CMD_FIFO_STATUS);
+		if ((st >> 16) & 0x1f) {
+			break;
+		}
+		delay_for_interval(500, NSEC_PER_USEC);
+	}
+	if (!((st >> 16) & 0x1f)) {
+		mic("r1a: read of %#x: nothing in the read FIFO (status %#x)\n", reg, st);
+		return -1;
+	}
+	data = rd(swr->va + SWR_CMD_FIFO_RD_FIFO);
+	if (((data >> 8) & 0xf) != (mic_rcmd_id & 0xf)) {
+		mic("r1a: read of %#x: answer id %u, not ours %u (data %#x)\n", reg, (data >> 8) & 0xf, mic_rcmd_id, data);
+		return -1;
+	}
+	return (int32_t)(data & 0xff);
+}
+
+static bool
+mic_cmd_reads(const struct mic_blk *swr, unsigned dev)
+{
+	static const struct {
+		uint16_t reg;
+		const char *name;
+	} r[] = { { 0x3401, "DIGITAL_CHIP_ID0" }, { 0x3402, "DIGITAL_CHIP_ID1" }, { 0x3403, "DIGITAL_CHIP_ID2" },
+		  { 0x3404, "DIGITAL_CHIP_ID3" } };
+	int32_t v[4];
+	bool ok = true;
+
+	for (unsigned i = 0; i < 4; i++) {
+		v[i] = mic_cmd_read(swr, dev, r[i].reg);
+		ok &= v[i] >= 0;
+		mic("r1a: WCD9395 (device %u) %s %#x = %s%#x\n", dev, r[i].name, r[i].reg, v[i] < 0 ? "NO ANSWER " : "",
+		    v[i] < 0 ? 0 : (uint32_t)v[i]);
+	}
+	mic("r1a %s: the codec's registers %s over swr2's command FIFO\n", ok ? "PASS" : "FAIL", ok ? "READ" :
+	    "NOT ALL READ");
+	return ok;
+}
+
+/*
+ * 17r1b (icemic_cmd=2: after 17r1a's reads passed in the same run): the WCD9395 brought up for AMIC1 -> ADC1, as Linux:
+ * wcd939x_io_init (bind), wcd939x_set_micbias_data (MICB1 2.7 V = VOUT 0x22, MICB2-4 1.8 V = 0x10: the DT), then the
+ * DAPM order of AMIC1 -> ADC1: MIC BIAS1 (wcd939x_micbias_control MICB_ENABLE), ADC1 MUX = CH1_AMIC1, ADC1 PRE_PMU
+ * (wcd939x_codec_enable_adc), ADC1 REQ PRE_PMU (wcd939x_adc_enable_req, mode NORMAL 3). Each write is a
+ * read-modify-write over swr2's command FIFO (CMD_FIFO_WR_CMD +0x5020 = reg | id << 16 | dev << 20 | data << 24, as
+ * qcom_swrm_cmd_fifo_wr_cmd), read back and compared under its mask. Held 500 ms, every field read once more, then down
+ * in the reverse DAPM order (ADC1 REQ / ADC1 POST_PMD, MICB1 off), and the codec goes back into reset with gpio161
+ * (every register to its reset value). No SoundWire port / stream (17r1c), no TX macro decimator, no DSP.
+ */
+#define SWR_CMD_FIFO_WR_CMD     0x5020u
+static uint32_t mic_wcmd_id;
+static unsigned mic_cdc_writes, mic_cdc_bad;
+static const char *mic_tag = "r1b";     /* the line prefix of the codec writes: r1b, r1c */
+
+static bool
+mic_cmd_write(const struct mic_blk *swr, unsigned dev, uint16_t reg, uint8_t val)
+{
+	mic_wcmd_id = mic_wcmd_id >= 14 ? 1 : mic_wcmd_id + 1;
+	wr(swr->va + SWR_CMD_FIFO_WR_CMD, reg | mic_wcmd_id << 16 | (uint32_t)dev << 20 | (uint32_t)val << 24);
+	delay_for_interval(100, NSEC_PER_USEC);
+	return true;
+}
+
+/* snd_soc_component_write_field: the field `mask` set to `field` (shifted into the mask), read back */
+static bool
+mic_cdc_field(const struct mic_blk *swr, unsigned dev, uint16_t reg, const char *name, uint8_t mask, uint8_t field)
+{
+	int32_t was = mic_cmd_read(swr, dev, reg), now;
+	unsigned shift = (unsigned)__builtin_ctz(mask);
+	uint8_t val;
+	bool ok;
+
+	if (was < 0) {
+		mic("%s: W %s %#x: NOT READ: not written\n", mic_tag, name, reg);
+		mic_cdc_bad++;
+		return false;
+	}
+	val = (uint8_t)((was & ~mask) | ((field << shift) & mask));
+	if (val != (uint8_t)was) {
+		(void)mic_cmd_write(swr, dev, reg, val);
+		mic_cdc_writes++;
+	}
+	now = mic_cmd_read(swr, dev, reg);
+	ok = now >= 0 && ((uint32_t)now & mask) == (val & mask);
+	mic_cdc_bad += !ok;
+	mic("%s: W %s %#x [mask %#x] = %u: %#x -> %#x, read back %#x (%s)\n", mic_tag, name, reg, mask, field, was, val,
+	    now < 0 ? 0 : (uint32_t)now, ok ? "ok" : now < 0 ? "NOT READ" : "NOT AS WANTED");
+	return ok;
+}
