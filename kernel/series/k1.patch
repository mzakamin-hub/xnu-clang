+/*
+ * iceland 35km1 (boot-arg icekm=S, the thread in RedwoodGPU.cpp): the zones' wired memory and the six biggest, read only.
+ * A line "icekmz: ", under 190 characters, ";;".
+ */
+void ice_zone_census(uint64_t secs);
+
+void
+ice_zone_census(uint64_t secs)
+{
+	zone_t top[6] = { };
+	uint64_t size[6] = { }, all = 0;
+	char line[186];
+	int at;
+
+	zone_index_foreach(zid) {
+		zone_t z = zone_by_id(zid);
+		uint64_t bytes = ptoa_64(zone_scale_for_percpu(z, z->z_wired_cur));
+
+		all += bytes;
+		for (int i = 0; i < 6; i++) {
+			if (bytes > size[i]) {
+				for (int j = 5; j > i; j--) {
+					top[j] = top[j - 1];
+					size[j] = size[j - 1];
+				}
+				top[i] = z;
+				size[i] = bytes;
+				break;
+			}
+		}
+	}
+	at = snprintf(line, sizeof(line), "icekmz: %llu s zones %lluM wired; top:", secs, all >> 20);
+	for (int i = 0; i < 6 && top[i] != NULL && at < 140; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %s%s %lluM", zone_heap_name(top[i]), zone_name(top[i]),
+		    size[i] >> 20);
+	}
+	printf("%s;;\n", line);
+}
+
+static void
+ice_zone_leak_say(zone_t z, const char * why, uint64_t secs)
+{
+#if ZALLOC_ENABLE_LOGGING || CONFIG_ZLEAKS
+	vm_address_t bt[BTLOG_MAX_DEPTH];
+	uint32_t len = 0, count;
+	btlog_t log = z != NULL ? z->z_btlog : NULL;
+	char line[186];
+	int at;
+
+	if (log == NULL || btlog_get_type(log) != BTLOG_HASH) {
+		if (z != NULL && secs == 0) {
+			printf("icezl: %s: zone %s%s has no leak log;;\n", why, zone_heap_name(z), zone_name(z));
+		}
+		return;
+	}
+	count = btlog_guess_top(log, bt, &len);
+	printf("icezl: %llu s %s: zone %s%s, %u allocated, %lluM wired; top backtrace %u outstanding, %u frames;;\n", secs,
+	    why, zone_heap_name(z), zone_name(z), (unsigned)zone_count_allocated(z), ptoa_64(z->z_wired_cur) >> 20, count, len);
+	for (uint32_t i = 0; i < len; i += 6) {
+		at = snprintf(line, sizeof(line), "icezl:   bt %u:", i);
+		for (uint32_t j = i; j < len && j < i + 6 && at < 160; j++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %lx", (unsigned long)VM_KERNEL_UNSLIDE(bt[j]));
+		}
+		printf("%s;;\n", line);
+	}
+#else
+	(void)z;
+	(void)why;
+	(void)secs;
+#endif
+}
+
+static TUNABLE(uint32_t, ice_zl_seconds, "icezl", 0);
+static thread_call_t ice_zl_call;
+
+static void
+ice_zone_leak_arm(void)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ice_zl_seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(ice_zl_call, deadline);
+}
+
+static void
+ice_zone_leak_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t ns, secs;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	secs = ns / NSEC_PER_SEC;
+	ice_zone_census(secs);
+#if ZALLOC_ENABLE_LOGGING || CONFIG_ZLEAKS
+	zone_foreach(z) {
+		if (z->z_btlog != NULL) {
+			ice_zone_leak_say(z, "log", secs);
+		}
+	}
+#endif
+	ice_zone_leak_arm();
+}
+
+__startup_func
+static void
+ice_zone_leak_init(void)
+{
+	if (ice_zl_seconds == 0) {
+		return;
+	}
+	ice_zl_seconds = MIN(ice_zl_seconds, 3600u);
+	ice_zl_call = thread_call_allocate_with_options(ice_zone_leak_tick, NULL, THREAD_CALL_PRIORITY_KERNEL,
+	    THREAD_CALL_OPTIONS_ONCE);
+	printf("icezl: zone census and leak logs every %u s (read only);;\n", ice_zl_seconds);
+	ice_zone_leak_arm();
+}
+STARTUP(THREAD_CALL, STARTUP_RANK_LAST, ice_zone_leak_init);
