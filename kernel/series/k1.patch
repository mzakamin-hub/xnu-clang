+	}
+	return v != 0;
+}
+
+/* the nm_modem host capability (tools/mk-ath12k.sh 21): boot-arg dadawifi_nmmodem=1, "not a Qualcomm platform" + internal sleep clock */
+int hakios_dada_wifi_nm_modem(void);
