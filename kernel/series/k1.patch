+// ---- sheng's build-gop-legacy-display-27.py:343-374: the client's default surface, the surface's allocation -------------------
+OSObject *native_legacy_default_surface_create(OSObject *root, uint32_t width, uint32_t height)
+{
+	if (!root || !width || !height || width > 16384 || height > 16384) {
+		return nullptr;
+	}
+	const uint64_t stride = (uint64_t(width) * 4 + 127) & ~uint64_t(127);
+	const uint64_t bytes = (stride * height + 4095) & ~uint64_t(4095);
+	OSDictionary *properties = OSDictionary::withCapacity(6);
+	if (!properties) {
+		return nullptr;
+	}
+	const char *keys[] = {"IOSurfaceWidth", "IOSurfaceHeight", "IOSurfaceBytesPerRow", "IOSurfaceBytesPerElement",
+		              "IOSurfacePixelFormat", "IOSurfaceAllocSize"};
+	const uint64_t values[] = {width, height, stride, 4, 0x42475241, bytes};
+	bool valid = true;
+	for (unsigned i = 0; i < 6 && valid; ++i) {
+		OSNumber *number = OSNumber::withNumber(values[i], 64);
+		valid = number && properties->setObject(keys[i], number);
+		OSSafeReleaseNULL(number);
+	}
+	OSObject *surface = valid ? native_legacy_surface_create(root, nullptr, properties) : nullptr;
+	properties->release();
+	if (!surface) {
+		IOLog("disp: default surface: the factory failed\n");
+		return nullptr;
+	}
+	IOReturn status = native_legacy_surface_allocate(surface);
+	IOMemoryDescriptor *memory = native_legacy_surface_descriptor(surface);
+	valid = status == kIOReturnSuccess && memory && memory->getLength() >= bytes && native_legacy_surface_width(surface) == width &&
+	    native_legacy_surface_height(surface) == height && native_legacy_surface_stride(surface) == stride &&
+	    native_legacy_surface_format(surface) == 0x42475241 && native_legacy_surface_planes(surface) == 0;
+	IOLog("disp: default surface %ux%u stride %llu: status %#x valid %u\n", width, height, stride, status, valid);
+	if (!valid) {
+		surface->release();
+		return nullptr;
+	}
+	return surface;
+}
+
+uint64_t native_legacy_surface_allocation(OSObject *surface)
+{
+	IOMemoryDescriptor *memory = native_legacy_surface_descriptor(surface);
+	return memory ? memory->getLength() : 0;
+}
