+	    "button-events=%u (reports %u, power left out %u) led-reports=%u (last %02x) driver=%u clients=%u\n", why, gC.commands,
+	    gC.keyboard, gC.consumer, gC.bad, gC.dropped, gC.sendErrors, gC.releases, gC.autoReleases, gC.buttonEvents,
+	    gC.buttonReports, gC.powerMasked, gC.leds, gC.lastLeds, gDriverSeen ? 1 : 0, clients(false));
