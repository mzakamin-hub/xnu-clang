+/* w5-bt: icepac=1 prints where a user process failed pointer authentication (off by default) */
+static void
+icepac_report(arm_saved_state_t *state, uint64_t esr, uint32_t instr, const char *why)
+{
+	uint32_t on = 0;
+	char     name[33];
+	uint64_t fp;
+	int      frames;
+
+	if (!PE_parse_boot_argn("icepac", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	name[0] = 0;
+	proc_selfname(name, sizeof(name));
+	printf("icepac: %s pid %d %s esr 0x%llx instr 0x%08x pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx"
+	    " x0 0x%llx x1 0x%llx x2 0x%llx x8 0x%llx x16 0x%llx x17 0x%llx\n", why, proc_selfpid(), name,
+	    (unsigned long long)esr, instr, (unsigned long long)get_saved_state_pc(state),
+	    (unsigned long long)get_saved_state_lr(state), (unsigned long long)get_saved_state_sp(state),
+	    (unsigned long long)get_saved_state_fp(state), (unsigned long long)get_saved_state_reg(state, 0),
+	    (unsigned long long)get_saved_state_reg(state, 1), (unsigned long long)get_saved_state_reg(state, 2),
+	    (unsigned long long)get_saved_state_reg(state, 8), (unsigned long long)get_saved_state_reg(state, 16),
+	    (unsigned long long)get_saved_state_reg(state, 17));
+	icepac_where(get_saved_state_pc(state), "pc");
+	icepac_where(get_saved_state_lr(state), "lr");
+	for (fp = get_saved_state_fp(state), frames = 0; frames < 12 && fp != 0 && (fp & 0xf) == 0; frames++) {
+		uint64_t frame[2], next;
+
+		if (copyin(fp, (char *)frame, sizeof(frame)) != 0) {
+			break;
+		}
+		icepac_where(frame[1], "fp");
+		next = frame[0];
+		if (next <= fp) {
+			break;                  /* the frame pointer does not grow upward */
+		}
+		fp = next;
+	}
+}
