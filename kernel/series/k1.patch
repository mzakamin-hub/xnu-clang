+/*
+ * Lines worth keeping whatever the ring loses: a driver's or a library's of ours being brought up
+ * ("dtouch: ", "dgpu: ", "redwood26: ", "exec: ") are copied here as they pass, and appended to the log on
+ * the way out (the stock daemons' chatter can push them out of the ring in a minute).
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#define LOADER_KEEP_SIZE (16 * 1024)   /* (macOS: the collection's __DATA budget, see LOADER_LOG_SIZE) */
+#else
+#define LOADER_KEEP_SIZE (384 * 1024)  /* (iceland: its drivers' lines too, run ipad8b lost the GPU survey between head and ring) */
+#endif
+static char     loader_keep[LOADER_KEEP_SIZE];
+static uint32_t loader_keep_len;
+static char     loader_keep_line[512];
