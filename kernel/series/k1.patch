+/*
+ * The system shader cache of the Metal plugin (shc1; UniXNU gpucache-system-shader-cache-view, ported). The render server compiles
+ * the system's shader libraries ahead of use and every other process should read the results, but no path is both writable by the
+ * render server's sandbox and readable by the other sandboxes. So the cache is a directory under /private/var/tmp that belongs to the
+ * render server's user (_windowserver, 88) and that nobody else may write, and the same directory is shown read-only under
+ * /Library/GPUBundles, which every sandbox with graphics access may read. The readers trust it only for that owner and mode (the
+ * plugin checks every level). Only a directory is taken (looked up without following a link), its owner and mode are set at every
+ * boot, and the mount point must be a directory too. Not made with gpu-prime-system=0; without it the plugin keeps its per-process
+ * caches. No status word (the collection's __DATA has no room): one line, step 1 the directory, 2 its attributes, 3 the mount point,
+ * 4 the mount, and the errno. The mkdir path goes at scratch + 0xc00, as native_gpu_addon_parents' (the bind's arguments end at 0xb29).
+ */
+static void
+native_owner_macos_gpu_shader_cache(proc_t p, user_addr_t scratch)
+{
+	static const char cache[] = "/private/var/tmp/NativeAdrenoMetal.cache";
+	static const char point[] = "/Library/GPUBundles/NativeAdrenoMetal.cache";
+	struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+	vfs_context_t ctx = vfs_context_kernel();
+	int32_t result = 0;
+	uint32_t asked = 1;
+	int error = 0;
+	int step = 0;
+
+	if (PE_parse_boot_argn("gpu-prime-system", &asked, sizeof(asked)) && asked == 0) {
+		return;
+	}
+	while (!error && ++step <= 3) {
+		/* 1: the cache directory, 2: its owner and mode, 3: the mount point; 1 and 3 each made if missing, then checked. */
+		const char *path = step == 3 ? point : cache;
+		vnode_t vp = NULLVP;
+		if (step != 2) {
+			error = copyout(path, request.path, strlen(path) + 1);
+			if (!error) error = mkdir(p, &request, &result);
+			if (error == EEXIST) error = 0;
+		}
+		if (!error && !(error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx))) {
+			if (vnode_vtype(vp) != VDIR) {
+				error = ENOTDIR;
+			} else if (step == 2) {
+				struct vnode_attr va;
+				VATTR_INIT(&va);
+				VATTR_SET(&va, va_uid, 88);
+				VATTR_SET(&va, va_gid, 0);
+				VATTR_SET(&va, va_mode, 0755);
+				error = vnode_setattr(vp, &va, ctx);
+			}
+			vnode_put(vp);
+		}
+	}
+	if (!error) {
+		step = 4;
+		error = native_cryptex_os_bind(p, scratch, cache, point, 0);
+	}
+	printf("owner Data: GPU shader cache %s shown at %s: step %d, %d\n", cache, point, step, error);
+}
