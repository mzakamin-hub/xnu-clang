+/* gains1: keep the n largest (bytes, then the caller copies its row in at the returned slot); -1 when not among them */
+static int
+iceland_top_slot(uint64_t *top, uint64_t bytes)
+{
+	int at = -1;
+
+	for (int i = 0; i < ICEMEM_TOP; i++) {
