+/* ---- the serial engine: uart18 = QUP wrapper 3 SE5, FIFO mode (hakios_iceland_harvest.c h_*) ---- */
+static uint32_t txdepth = 16, rxdepth = 16, oversampling = 16, dfs[8];
+static bool dfs_en, rcg_saved, se_saved;
+static uint32_t rcg0[4];                /* CFG, M, N, D as found */
+static const uint32_t se_regs[] = { 0x28, 0xe30, 0x24, 0xe1c, 0x258, 0xe18, 0x810, 0x814, 0x614, 0x644, 0x260, 0x264, 0x284,
+	                            0x288, 0x25c, 0x2a4, 0x280, 0x2a8, 0x268, 0x28c, 0x26c, 0x294, 0x22c, 0x7c, 0x48, 0x4c, 0x2ac };
+#define SE_NREGS        (sizeof(se_regs) / sizeof(se_regs[0]))
+static uint32_t se_saved_v[SE_NREGS];
+
+/* reads, and the S5 branch vote (the one Linux's "se" clock makes); the SE is read only with every wrap3 clock on */
+static bool
+se_probe(void)
+{
+	static const uint32_t cbcr[] = { 0x233f0, 0x233f4, 0x233f8, 0x2340c, 0xa8630 };
+	vm_offset_t qup = iomap(QUP3_PA, PAGE_SIZE);
+	uint32_t fw, p0, p1, hwver;
+	bool on = true;
+	int proto;
+
+	gcc = iomap(GCC_PA, 0xb0000);
+	se = iomap(SE5_PA, 0x4000);
+	for (int i = 0; i < 4; i++) {
+		pad[i] = iomap(TLMM_PA + 0x1000u * (24 + (uint32_t)i), PAGE_SIZE);
+	}
+	if (gcc == 0 || qup == 0 || se == 0 || pad[0] == 0 || pad[1] == 0 || pad[2] == 0 || pad[3] == 0) {
+		say("REFUSED: GCC / QUP3 / SE5 / TLMM not mapped\n");
+		return false;
+	}
+	for (int i = 0; i < 4; i++) {
+		pad0[i] = rd(pad[i], 0);
+	}
+	vote0 = rd(gcc, GCC_VOTE);
+	say("wrap3 votes 0x52018 %08x (m_ahb %u s_ahb %u core %u core2x %u s5 %u)\n", vote0, (vote0 >> 8) & 1, (vote0 >> 9) & 1,
+	    (vote0 >> 10) & 1, (vote0 >> 11) & 1, (vote0 >> 17) & 1);
+	dfs_en = rd(gcc, S5_RCG + 0x14) & 1;
+	for (int l = 0; l < 8; l++) {
+		uint32_t cfg = rd(gcc, S5_RCG + 0x1c + 4 * (uint32_t)l), src = (cfg >> 8) & 7, hid = cfg & 0x1f, mode = (cfg >> 12) & 3;
+		uint64_t p = src == 0 ? 19200000ull : src == 1 ? 600000000ull : src == 6 ? 300000000ull : 0, f = p;
+
+		if (hid) {
+			f = f * 2 / (hid + 1);
+		}
+		if (mode && p) {
+			uint32_t m = rd(gcc, S5_RCG + 0x5c + 4 * (uint32_t)l) & 0xffff;
+			uint32_t n = ((~rd(gcc, S5_RCG + 0x9c + 4 * (uint32_t)l)) & 0xffff) + m;
+
+			f = n ? f * m / n : 0;
+		}
+		dfs[l] = (uint32_t)f;
+	}
+	say("S5 RCG cmd %08x cfg %08x m %08x n %08x d %08x; CMD_DFSR %08x (DFS %s); levels Hz: %u %u %u %u %u %u %u %u\n",
+	    rd(gcc, S5_RCG), rd(gcc, S5_RCG + 4), rd(gcc, S5_RCG + 8), rd(gcc, S5_RCG + 0xc), rd(gcc, S5_RCG + 0x10),
+	    rd(gcc, S5_RCG + 0x14), dfs_en ? "on" : "off", dfs[0], dfs[1], dfs[2], dfs[3], dfs[4], dfs[5], dfs[6], dfs[7]);
+	if (!((vote0 >> 17) & 1)) {
+		done |= D_S5;
+		pw(gcc, "gcc", GCC_VOTE, vote0 | (1u << 17));
+		for (int i = 0; i < 100 && (rd(gcc, 0xa8630) >> 31); i++) {
+			delay(10);
+		}
+	}
+	/*
+	 * m_ahb / s_ahb are hardware-gated (gcc-kaanapali.c:2727-2750, hwcg bit 1): idle, a voted one may read off and
+	 * starts with the bus access, so for those two the vote counts; core, core_2x and s5 must read on.
+	 */
+	for (int i = 0; i < 5; i++) {
+		bool off = rd(gcc, cbcr[i]) >> 31;
+
+		on = on && (!off || (i < 2 && ((rd(gcc, GCC_VOTE) >> (8 + i)) & 1)));
+	}
+	on = on && ((rd(gcc, GCC_VOTE) >> 8) & 0xf) == 0xf;
+	say("CBCR m_ahb %08x s_ahb %08x core %08x core2x %08x s5 %08x; votes %08x: %s\n", rd(gcc, cbcr[0]), rd(gcc, cbcr[1]),
+	    rd(gcc, cbcr[2]), rd(gcc, cbcr[3]), rd(gcc, cbcr[4]), rd(gcc, GCC_VOTE), on ? "on" : "a wrap3 clock is OFF or not voted");
+	if (!on) {
+		say("REFUSED: a wrap3 clock is off: the engine's registers are not read\n");
+		return false;
+	}
+	hwver = rd(qup, 4);
+	fw = rd(se, 0x68);
+	p0 = rd(se, 0xe24);
+	p1 = rd(se, 0xe28);
+	proto = (int)((fw >> 8) & 0xff);
+	txdepth = (p0 >> 16) & 0x3f;
+	rxdepth = (p1 >> 16) & 0x3f;
+	oversampling = hwver >= 0x20050000u ? 16 : 32;
+	say("QUP_HW_VER %08x; SE5 GENI_FW_REVISION_RO %08x (protocol %d; 2 = UART) STATUS %08x; FIFO depths tx %u rx %u; IOS %08x; "
+	    "pads gpio24-27 ctl %08x %08x %08x %08x\n", hwver, fw, proto, rd(se, 0x40), txdepth, rxdepth, rd(se, 0x908), pad0[0],
+	    pad0[1], pad0[2], pad0[3]);
+	if (proto != 2 || txdepth == 0 || rxdepth < 4 || (((pad0[0] | pad0[1] | pad0[2] | pad0[3]) >> 2) & 0xf) != 0) {
+		say("REFUSED: the engine does not run UART firmware, or a pad is not a plain GPIO: nothing written to them\n");
+		return false;
+	}
+	return true;
+}
+
+/* DFS off: the rate through the RCG itself (M / N / D, CFG, CMD update), the values as found kept for the undo */
+static bool
+rcg_set(uint32_t src, uint32_t m, uint32_t n)
+{
+	uint32_t cfg, d;
+
+	if (!rcg_saved) {
+		for (uint32_t i = 0; i < 4; i++) {
+			rcg0[i] = rd(gcc, S5_RCG + 4 + 4 * i);
+		}
+		rcg_saved = true;
+	}
+	cfg = (rcg0[0] & ~(0x1fu | 7u << 8 | 3u << 12)) | 1u | src << 8 | (n != 0 && m != n ? 2u << 12 : 0);
+	if (n != 0) {
+		d = n;
+		if (d < m) {
+			d = m;
+		}
+		if (d > 2 * (n - m)) {
+			d = 2 * (n - m);
+		}
+		wr(gcc, S5_RCG + 8, m & 0xffff);
+		wr(gcc, S5_RCG + 0xc, ~(n - m) & 0xffff);
+		wr(gcc, S5_RCG + 0x10, ~d & 0xffff);
+	}
+	wr(gcc, S5_RCG + 4, cfg);
+	wr(gcc, S5_RCG, rd(gcc, S5_RCG) | 1u);
+	for (int i = 0; i < 500 && (rd(gcc, S5_RCG) & 1u); i++) {
+		delay(2);
+	}
+	say("S5 RCG <- src %u m %u n %u: cfg %08x m %08x n %08x d %08x cmd %08x (%s); found cfg %08x m %08x n %08x d %08x\n", src, m,
+	    n, rd(gcc, S5_RCG + 4), rd(gcc, S5_RCG + 8), rd(gcc, S5_RCG + 0xc), rd(gcc, S5_RCG + 0x10), rd(gcc, S5_RCG),
+	    (rd(gcc, S5_RCG) & 1u) ? "UPDATE NOT taken" : "updated", rcg0[0], rcg0[1], rcg0[2], rcg0[3]);
+	return !(rd(gcc, S5_RCG) & 1u);
+}
+
+static void
+rcg_restore(void)
+{
+	if (!rcg_saved) {
+		return;
+	}
+	wr(gcc, S5_RCG + 8, rcg0[1]);
+	wr(gcc, S5_RCG + 0xc, rcg0[2]);
+	wr(gcc, S5_RCG + 0x10, rcg0[3]);
+	wr(gcc, S5_RCG + 4, rcg0[0]);
+	wr(gcc, S5_RCG, rd(gcc, S5_RCG) | 1u);
+	for (int i = 0; i < 500 && (rd(gcc, S5_RCG) & 1u); i++) {
+		delay(2);
+	}
+	say("S5 RCG put back: cfg %08x m %08x n %08x d %08x (found %08x %08x %08x %08x) cmd %08x\n", rd(gcc, S5_RCG + 4),
+	    rd(gcc, S5_RCG + 8), rd(gcc, S5_RCG + 0xc), rd(gcc, S5_RCG + 0x10), rcg0[0], rcg0[1], rcg0[2], rcg0[3], rd(gcc, S5_RCG));
+	rcg_saved = false;
+}
+
+static bool
+se_baud(uint32_t baud)
+{
+	uint64_t want = (uint64_t)baud * oversampling;
+
+	if (!dfs_en) {
+		/* gcc-kaanapali.c's S5 rates that divide a UART rate: Hz, source (0 XO, 6 GPLL0 even 300 MHz), M, N */
+		static const struct {
+			uint32_t hz, src, m, n;
+		} f[] = { { 7372800, 6, 384, 15625 }, { 14745600, 6, 768, 15625 }, { 19200000, 0, 0, 0 },
+			  { 29491200, 6, 1536, 15625 }, { 32000000, 6, 8, 75 }, { 48000000, 6, 4, 25 }, { 51200000, 6, 64, 375 },
+			  { 64000000, 6, 16, 75 }, { 96000000, 6, 8, 25 } };
+
+		for (unsigned i = 0; i < sizeof(f) / sizeof(f[0]); i++) {
+			if (f[i].hz % want == 0) {
+				uint32_t div = (uint32_t)(f[i].hz / want);
+
+				if (!rcg_set(f[i].src, f[i].m, f[i].n)) {
+					return false;
+				}
+				wr(se, 0x7c, 0);
+				wr(se, 0x48, div << 4 | 1);
+				wr(se, 0x4c, div << 4 | 1);
+				say("%u baud: RCG %u Hz / %u / oversampling %u\n", baud, f[i].hz, div, oversampling);
+				return true;
+			}
+		}
+		say("no RCG rate is a multiple of %u x %u\n", baud, oversampling);
+		return false;
+	}
+	for (uint32_t l = 0; l < 8; l++) {
+		if (dfs[l] != 0 && dfs[l] % want == 0) {
+			uint32_t div = (uint32_t)(dfs[l] / want);
+
+			wr(se, 0x7c, l);
+			wr(se, 0x48, div << 4 | 1);
+			wr(se, 0x4c, div << 4 | 1);
+			say("%u baud: DFS level %u (%u Hz) / %u / oversampling %u\n", baud, l, dfs[l], div, oversampling);
+			return true;
+		}
+	}
+	say("no DFS level is a multiple of %u x %u\n", baud, oversampling);
+	return false;
+}
+
+/* b then b2 through the M sequencer, one byte per FIFO word; false on a timeout (the command cancelled) */
+static bool
+se_tx(const uint8_t *b, int n, const uint8_t *b2, int n2)
+{
+	int total = n + n2;
+	uint64_t dl, t0;
+
+	wr(se, 0x618, 0xffffffffu);
+	wr(se, 0x270, (uint32_t)total);
+	wr(se, 0x600, 1u << 27);                /* UART_START_TX */
+	nanoseconds_to_absolutetime(50000000ull + (uint64_t)total * 100000ull, &dl);
+	t0 = mach_absolute_time();
+	for (int i = 0; i < total; i++) {
+		while ((rd(se, 0x800) & 0x0fffffffu) >= txdepth) {
+			if (mach_absolute_time() - t0 > dl) {
+				goto stuck;
+			}
+		}
+		wr(se, 0x700, i < n ? b[i] : b2[i - n]);
+	}
+	while (!(rd(se, 0x610) & 1u)) {
+		if (mach_absolute_time() - t0 > dl) {
+			goto stuck;
+		}
+	}
+	wr(se, 0x618, 1u);
+	return true;
+stuck:
+	say("TX stuck (%d bytes; TX_FIFO %08x M_IRQ %08x STATUS %08x IOS %08x): cancelled\n", total, rd(se, 0x800), rd(se, 0x610),
+	    rd(se, 0x40), rd(se, 0x908));
+	wr(se, 0x604, 1u << 2);                 /* M_GENI_CMD_CANCEL */
+	delay(1000);
+	if (!(rd(se, 0x610) & (1u << 4))) {
+		wr(se, 0x604, 1u << 1);             /* M_GENI_CMD_ABORT */
+		delay(1000);
+	}
+	wr(se, 0x618, 0xffffffffu);
+	return false;
+}
+
+/* RX for cap_us, or until one whole H4 event is in r */
+static int
+se_rx(uint32_t cap_us, uint8_t *r, int rmax)
+{
+	uint64_t dl, t0 = mach_absolute_time();
+	int m = 0, drop = 0;
+	const bool ibs = b4_chip_ibs();
+
+	nanoseconds_to_absolutetime((uint64_t)cap_us * 1000ull, &dl);
+	do {
+		while (rd(se, 0x804) & 0x1ffffffu) {
+			uint32_t v = rd(se, 0x780);
+
+			if (ibs && m == 0 && (uint8_t)v >= 0xfc && (uint8_t)v <= 0xfe) {
+				b4_chip_byte((uint8_t)v);       /* bt4: an in-band sleep byte before the reply (a wake: acknowledged) */
+				continue;
+			}
+			if (m < rmax) {
+				r[m++] = (uint8_t)v;
+			} else {
+				drop++;
+			}
+		}
+		if (m >= 3 && r[0] == 0x04 && m >= 3 + r[2]) {
+			break;
+		}
+	} while (mach_absolute_time() - t0 < dl);
+	if (drop) {
+		say("RX: %d bytes beyond the %d-byte buffer dropped\n", drop, rmax);
+	}
+	return m;
+}
+
+/* geni_se_init's order, FIFO mode, 8N1, CTS ignored, RFR automatic, 115200; the registers as found saved first */
+static bool
+se_setup(void)
+{
+	for (unsigned i = 0; i < SE_NREGS; i++) {
+		se_saved_v[i] = rd(se, se_regs[i]);
+	}
+	se_saved = true;
+	done |= D_SE;
+	wr(se, 0x634, 1u << 1);                 /* S_GENI_CMD_ABORT: no read left running */
+	delay(1000);
+	wr(se, 0xe18, 0);
+	wr(se, 0x618, 0xffffffffu);
+	wr(se, 0x648, 0xffffffffu);
+	wr(se, 0xc44, 0xffffffffu);
+	wr(se, 0xd44, 0xffffffffu);
+	wr(se, 0x28, rd(se, 0x28) | 0x7fu);
+	wr(se, 0xe30, rd(se, 0xe30) | 0xfu);
+	wr(se, 0x24, 0x7fu);
+	wr(se, 0x20, 1u);                       /* FORCE_DEFAULT */
+	wr(se, 0xe1c, rd(se, 0xe1c) | 0xfu);
+	wr(se, 0x258, rd(se, 0x258) & ~1u);     /* FIFO mode */
+	wr(se, 0x810, 2);
+	wr(se, 0x814, rxdepth - 2);
+	wr(se, 0x614, rd(se, 0x614) | 0x31u);
+	wr(se, 0x644, rd(se, 0x644) | 0x21u);
+	wr(se, 0x260, 0xf);                     /* one byte per FIFO word */
+	wr(se, 0x264, 0);
+	wr(se, 0x284, 0xf);
+	wr(se, 0x288, 0);
+	wr(se, 0x25c, 1u << 1);                 /* CTS ignored */
+	wr(se, 0x2a4, 0);
+	wr(se, 0x280, 0);
+	wr(se, 0x2a8, 0);
+	wr(se, 0x268, 8);
+	wr(se, 0x28c, 8);
+	wr(se, 0x26c, 0);
+	wr(se, 0x294, 16 * 10);
+	wr(se, 0x22c, 0);                       /* no loopback */
+	wr(se, 0x2ac, 0);                       /* RFR automatic */
+	if (!se_baud(115200)) {
+		return false;
+	}
+	wr(se, 0x630, 1u << 27);                /* S: UART_START_READ */
+	return true;
+}
+
+static void
+se_restore(void)
+{
+	if (!se_saved) {
+		return;
+	}
+	wr(se, 0x634, 1u << 1);                 /* S abort */
+	wr(se, 0x604, 1u << 2);                 /* M cancel */
+	delay(1000);
+	wr(se, 0x618, 0xffffffffu);
+	wr(se, 0x648, 0xffffffffu);
+	for (unsigned i = 0; i < SE_NREGS; i++) {
+		wr(se, se_regs[i], se_saved_v[i]);
+	}
+	rcg_restore();
+	se_saved = false;
+}
+
+/* ---- H4 helpers ---- */
+static void
+hexs(char *hex, const uint8_t *r, int m, int maxb)
+{
+	int k = m < maxb ? m : maxb;
+
+	for (int i = 0; i < k; i++) {
+		snprintf(hex + 3 * i, 4, "%02x ", r[i]);
+	}
+	hex[k ? 3 * k - 1 : 0] = 0;
+}
+
+/* where the command complete for opcode (and EDL reply type, if >= 0) starts in r, -1 if none */
+static int
+cc_at(const uint8_t *r, int m, uint16_t opcode, int rtype)
+{
+	for (int i = 0; i + 6 < m; i++) {
+		if (r[i] == 0x04 && r[i + 1] == 0x0e && r[i + 4] == (opcode & 0xff) && r[i + 5] == (opcode >> 8)) {
+			if (rtype >= 0 && (i + 7 >= m || r[i + 7] != rtype)) {
+				continue;
+			}
+			return i;
+		}
+	}
+	return -1;
+}
+
+static uint8_t reply[96];
+static int reply_n;
+
+/* one command and its reply (in reply[]); the status of its command complete, -1 none, -2 TX failed */
+static int
+cmd(const char *name, const uint8_t *b, int n, uint32_t cap_us, int opcode, int rtype)
+{
+	char hex[40 * 3 + 1];
+	int at, st = -1;
+
+	reply_n = 0;
+	if (!se_tx(b, n, NULL, 0)) {
+		say("%s: TX FAILED\n", name);
+		return -2;
+	}
+	reply_n = se_rx(cap_us, reply, (int)sizeof(reply));
+	if (opcode >= 0 && (at = cc_at(reply, reply_n, (uint16_t)opcode, rtype)) >= 0) {
+		st = reply[at + 6];
+	}
+	hexs(hex, reply, reply_n, 40);
+	say("%s: %d bytes [%s] status %d\n", name, reply_n, hex, st);
+	return st;
+}
+
+static const uint8_t c_reset[] = { 0x01, 0x03, 0x0c, 0x00 };
+static const uint8_t c_lver[] = { 0x01, 0x01, 0x10, 0x00 };
+static const uint8_t c_qver[] = { 0x01, 0x00, 0xfc, 0x01, 0x19 };       /* EDL_PATCH_VER_REQ_CMD */
+static const uint8_t c_bid[] = { 0x01, 0x00, 0xfc, 0x01, 0x23 };        /* EDL_GET_BID_REQ_CMD */
+static const uint8_t c_build[] = { 0x01, 0x00, 0xfc, 0x01, 0x20 };      /* EDL_GET_BUILD_INFO_CMD */
+
+static bool
+build_string(const char *when, char *txt, size_t max)
+{
+	int st = cmd("QCA build info", c_build, (int)sizeof(c_build), 60000, 0xfc00, 0x20), at, k = 0;
+
+	txt[0] = 0;
+	if (st != 0 || (at = cc_at(reply, reply_n, 0xfc00, 0x20)) < 0) {
+		return false;
+	}
+	for (int i = at + 9; i < reply_n && k < (int)max - 1; i++) {
+		txt[k++] = (reply[i] >= 0x20 && reply[i] < 0x7f) ? (char)reply[i] : '.';
+	}
+	txt[k] = 0;
+	say("build string %s: \"%s\"\n", when, txt);
+	return true;
+}
+
+static bool
+local_version(const char *when)
+{
+	int st = cmd("HCI Read_Local_Version", c_lver, (int)sizeof(c_lver), 100000, 0x1001, -1), at;
+
+	if (st != 0 || (at = cc_at(reply, reply_n, 0x1001, -1)) < 0 || at + 14 >= reply_n) {
+		say("Read_Local_Version %s: no good answer (status %d)\n", when, st);
+		return false;
+	}
+	say("Read_Local_Version %s: HCI %#x rev %#x, LMP %#x subversion %#x, manufacturer %#x%s\n", when, reply[at + 7],
+	    reply[at + 8] | reply[at + 9] << 8, reply[at + 10], reply[at + 13] | reply[at + 14] << 8,
+	    reply[at + 11] | reply[at + 12] << 8, (reply[at + 11] | reply[at + 12] << 8) == 0x1d ? " (Qualcomm)" : "");
+	return true;
+}
+
+/* ---- (a) ---- */
+static bool
+bt_enable(void)
+{
+	bool ok;
+
+	if (pin0.mode == 1 && (pin0.src & 0x80)) {
+		/* bt1: found driven high (icebt_pinout): low first, so the chip starts from its reset; the undo puts it back */
+		done |= D_EN;
+		if (!spmi_wr("DIG_OUT_SOURCE_CTL (bt-enable low first)", 0x44, (uint8_t)(pin0.src & 0x0f))) {
+			return false;
+		}
+		nap(200);
+	}
+	done |= D_GPIO;
+	ok = spmi_wr("DIG_VIN_CTL (power-source 1)", 0x41, 1) && spmi_wr("DIG_PULL_CTL (bias-disable)", 0x42, 5) &&
+	    spmi_wr("MODE_CTL (digital output, low)", 0x40, 1);
+	if (!ok) {
+		return false;
+	}
+	nap(10);
+	done |= D_EN;
+	if (!spmi_wr("DIG_OUT_SOURCE_CTL (bt-enable HIGH)", 0x44, (uint8_t)(0x80 | (pin0.src & 0x0f)))) {
+		return false;
+	}
+	nap(100);                               /* pwrseq-qcom-wcn: 100 ms for the WCN7860 */
+	pads_log("+100 ms");
+	return true;
+}
+
+static uint32_t soc_bid;
+static char fw_label[64];                       /* the patched build string, for kern.qbt_firmware */
+
+static bool
+stage_a(void)
+{
+	static const uint32_t pull[4] = { 1, 1, 3, 3 };         /* 24 / 25 pull-down, 26 / 27 pull-up */
+	uint8_t junk[96];
+	char txt[97];
+	int at, st, j;
+
+	b4_note_nvm(0);                                 /* bt4: a fresh bring-up: the ROM's in-band sleep is off */
+	if (!se_setup()) {
+		return false;
+	}
+	done |= D_PADS;
+	for (int i = 0; i < 4; i++) {
+		pw(pad[i], "pad", 0, (pad0[i] & ~(0xfu << 2) & ~3u & ~(7u << 6) & ~(1u << 9)) | (1u << 2) | pull[i]);
+	}
+	nap(5);
+	j = se_rx(5000, junk, (int)sizeof(junk));
+	say("SE5 in UART mode at 115200, pads on qup3_se5; IOS %08x (CTS in %u); %d bytes in the first 5 ms\n", rd(se, 0x908),
+	    (rd(se, 0x908) >> 1) & 1, j);
+	if (cmd("HCI_Reset at 115200", c_reset, (int)sizeof(c_reset), 100000, 0x0c03, -1) != 0) {
+		/* no answer: hci_qca's in-band wake byte (0xfd, also stage b's first byte), then the reset once more */
+		static const uint8_t ibs_wake[] = { 0xfd };
+
+		(void)cmd("IBS wake 0xfd", ibs_wake, 1, 10000, -1, -1);
+		if (cmd("HCI_Reset at 115200, after the wake", c_reset, (int)sizeof(c_reset), 100000, 0x0c03, -1) != 0) {
+			say("(a) FAILED: the controller does not answer HCI_Reset\n");
+			return false;
+		}
+	}
+	st = cmd("QCA version", c_qver, (int)sizeof(c_qver), 100000, 0xfc00, 0x19);
+	if (st == 0 && (at = cc_at(reply, reply_n, 0xfc00, 0x19)) >= 0 && at + 20 < reply_n) {
+		say("QCA version: product %#x patch %#x ROM %#x SoC %#x (the iPadOS target read 0x21 / 0x6d58 / 0x200 / 0x40210200)\n",
+		    (uint32_t)reply[at + 9] | (uint32_t)reply[at + 10] << 8 | (uint32_t)reply[at + 11] << 16 |
+		    (uint32_t)reply[at + 12] << 24, (uint32_t)reply[at + 13] | (uint32_t)reply[at + 14] << 8,
+		    (uint32_t)reply[at + 15] | (uint32_t)reply[at + 16] << 8, (uint32_t)reply[at + 17] |
+		    (uint32_t)reply[at + 18] << 8 | (uint32_t)reply[at + 19] << 16 | (uint32_t)reply[at + 20] << 24);
+	}
+	st = cmd("QCA board id", c_bid, (int)sizeof(c_bid), 100000, 0xfc00, 0x23);
+	if (st == 0 && (at = cc_at(reply, reply_n, 0xfc00, 0x23)) >= 0 && at + 10 < reply_n) {
+		soc_bid = (uint32_t)reply[at + 9] << 8 | reply[at + 10];
+		say("board id %#x\n", soc_bid);
+	}
+	(void)build_string("before any download", txt, sizeof(txt));
+	if (!local_version("(a)")) {
+		say("(a) FAILED\n");
+		return false;
+	}
+	say("(a) PASS: bt-enable high, the controller answers HCI over uart18 at 115200\n");
+	return true;
+}
+
+/* ---- (b): the download (hakios_iceland_harvest.c f4_*, btqca's order) ---- */
+static const uint8_t fw_sha[32] = {             /* iceland-firmware qca/brhbtfw20.mbn */
+	0x74, 0xee, 0x83, 0x2c, 0xd7, 0x24, 0xfb, 0x6a, 0x43, 0x91, 0xbc, 0x06, 0xf4, 0xb0, 0xd9, 0x69,
+	0x7d, 0x36, 0xb4, 0x60, 0xe7, 0xf4, 0xb1, 0x4f, 0xb6, 0xbc, 0x14, 0xb6, 0x9e, 0x7c, 0xc2, 0x87,
+};
+static const struct {
+	const char *name;                       /* the pack's record */
+	uint8_t sha[32];
+} nvms[4] = {
+	{ "brhbtnv20.b2e", { 0xaa, 0xa2, 0x26, 0x1d, 0x86, 0xb7, 0x9d, 0xa1, 0x56, 0x1a, 0xc6, 0x42, 0xf5, 0x92, 0x50, 0x6a,
+			     0x3d, 0x4d, 0x7d, 0x71, 0xb7, 0xd2, 0x87, 0x73, 0x06, 0x33, 0x4f, 0xbc, 0xe4, 0x39, 0xd8, 0x60 } },
+	/* one content for .b34-.b39, .b41, .b44, .b46, .b47 */
+	{ "brhbtnv20.b34", { 0x83, 0xda, 0xa4, 0x43, 0x10, 0x1d, 0x92, 0x8b, 0x47, 0x8c, 0x0a, 0x8e, 0xd9, 0xaa, 0x64, 0x0e,
+			     0x4f, 0xed, 0x37, 0x4e, 0x3a, 0x62, 0x01, 0x90, 0x09, 0x3e, 0x01, 0x76, 0x42, 0xd0, 0xd4, 0x06 } },
+	{ "brhbtnv20.b3e", { 0x06, 0x90, 0xba, 0x88, 0x94, 0x98, 0xdc, 0x37, 0xd7, 0x61, 0x1d, 0x0b, 0x8f, 0x37, 0x43, 0xd3,
+			     0xb2, 0x25, 0xb1, 0xfd, 0xd4, 0xfd, 0xf3, 0xf6, 0x8e, 0x60, 0x46, 0x1d, 0x50, 0x97, 0xe1, 0x7a } },
+	{ "brhbtnv20.bin", { 0x96, 0x71, 0xc2, 0xf0, 0xc1, 0xa8, 0x60, 0xd0, 0xc4, 0x95, 0x5e, 0x04, 0x27, 0xc5, 0x1b, 0x0f,
+			     0x8a, 0xe1, 0x77, 0xb7, 0x3f, 0xb2, 0xa9, 0x33, 0xb8, 0x38, 0x10, 0x2a, 0x5f, 0x05, 0x56, 0x98 } },
+};
+/* stage b's patched NVM copy and stage c's address hashes: allocated by the thread (not in __DATA, which is full) */
+#define NVM_MAX         16384u
+#define HB_SEEN_N       1024u
+static uint8_t *nvm_copy;
+static uint64_t *hb_seen;
+
+static const uint8_t *
+blob(const char *name, const uint8_t *want, uint64_t *size)
+{
+	const uint8_t *d = hakios_iceland_wifi_blob(name, size);
+	uint8_t dg[32];
+	SHA256_CTX c;
+
+	if (d == NULL || *size == 0 || *size > (1u << 20)) {
+		return NULL;
+	}
+	SHA256_Init(&c);
+	SHA256_Update(&c, d, (size_t)*size);
+	SHA256_Final(dg, &c);
+	return memcmp(dg, want, 32) == 0 ? d : NULL;
+}
+
+/* 243-byte segments: 01 00 fc <n+2> 1e <n> <data>; ack_each: every segment answered (NVM), else only the last (patch) */
+static bool
+send_file(const char *what, const uint8_t *d, uint32_t size, bool ack_each)
+{
+	uint8_t hdr[6], r[96];
+	char hex[24 * 3 + 1];
+	uint32_t off = 0, seg = 0, noisy = 0;
+	uint64_t t0 = mach_absolute_time(), el;
+	int m, at;
+
+	say("%s: %u bytes, %u segments\n", what, size, (size + 242) / 243);
+	while (off < size) {
+		uint32_t n = size - off < 243 ? size - off : 243;
+		bool last = off + n >= size || n < 243;
+
+		if (stop_req) {
+			say("%s: the run ends: stopped at segment %u\n", what, seg);
+			return false;
+		}
+		hdr[0] = 0x01;
+		hdr[1] = 0x00;
+		hdr[2] = 0xfc;
+		hdr[3] = (uint8_t)(n + 2);
+		hdr[4] = 0x1e;
+		hdr[5] = (uint8_t)n;
+		if (!se_tx(hdr, 6, d + off, (int)n)) {
+			say("%s segment %u: TX failed\n", what, seg);
+			return false;
+		}
+		if (ack_each || last) {
+			m = se_rx(last ? 1000000 : 60000, r, (int)sizeof(r));
+			at = cc_at(r, m, 0xfc00, 0x1e);
+			if (at < 0 || r[at + 6] != 0) {
+				hexs(hex, r, m, 24);
+				say("%s segment %u (%u bytes at %u%s): no good command complete: %d bytes [%s]\n", what, seg, n, off,
+				    last ? ", last" : "", m, hex);
+				return false;
+			}
+		} else {
+			m = se_rx(100, r, (int)sizeof(r));
+			if (m > 0) {
+				if (noisy++ < 5) {
+					hexs(hex, r, m, 16);
+					say("%s segment %u: unexpected %d bytes [%s]\n", what, seg, m, hex);
+				}
+				at = cc_at(r, m, 0xfc00, -1);
+				if ((at >= 0 && r[at + 6] != 0) || (m >= 2 && r[0] == 0x04 && r[1] == 0x10)) {
+					say("%s segment %u: the chip reported an error: stopped\n", what, seg);
+					return false;
+				}
+			}
+		}
+		off += n;
+		seg++;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+	say("%s: %u bytes in %u segments taken (%llu ms, %u unexpected replies)\n", what, size, seg, el / 1000000, noisy);
+	return true;
+}
+
+static bool
+stage_b(void)
+{
+	static const uint8_t ibs_wake[] = { 0xfd };
+	static const uint8_t peri[] = { 0x31, 0x00, 0xf1, 0xff, 0x02, 0x02, 0x11 };     /* peripheral baud 3.2 M */
+	static const uint8_t hbaud[] = { 0x01, 0x48, 0xfc, 0x01, 0x11 };                 /* QCA_BAUDRATE_3200000 */
+	static const uint8_t nolog[] = { 0x01, 0x17, 0xfc, 0x02, 0x14, 0x00 };
+	uint64_t fsz = 0, nsz = 0;
+	const uint8_t *fw = blob("brhbtfw20.mbn", fw_sha, &fsz), *nv = NULL;
+	uint8_t junk[96];
+	char txt[97];
+	uint32_t nvm_mode = 0;
+	int j, which;
+	bool patched;
+
+	which = soc_bid == 0x2e ? 0 : soc_bid == 0x3e ? 2 : ((soc_bid >= 0x34 && soc_bid <= 0x39) || soc_bid == 0x41 ||
+	    soc_bid == 0x44 || soc_bid == 0x46 || soc_bid == 0x47) ? 1 : 3;
+	nv = blob(nvms[which].name, nvms[which].sha, &nsz);
+	if (nv == NULL && which != 3) {
+		which = 3;                      /* qca_get_alt_nvm_file: the .bin */
+		nv = blob(nvms[3].name, nvms[3].sha, &nsz);
+	}
+	if (fw == NULL || nv == NULL || nsz < 8 || nsz > NVM_MAX || nvm_copy == NULL) {
+		say("(b) not run: %s is not in this kernel's pack with iceland-firmware's sha256: nothing sent\n",
+		    fw == NULL ? "brhbtfw20.mbn" : "the NVM file");
+		return false;
+	}
+	say("rampatch brhbtfw20.mbn %llu B, NVM %s %llu B for board id %#x: sha256 as pinned\n", fsz, nvms[which].name, nsz, soc_bid);
+	/* hci_qca qca_setup for the WCN7860: the peripheral baud, then qca_set_speed(operating) */
+	(void)cmd("IBS wake 0xfd", ibs_wake, 1, 10000, -1, -1);
+	(void)cmd("peripheral baud 3.2 M", peri, (int)sizeof(peri), 100000, -1, -1);
+	wr(se, 0x2ac, (1u << 31) | (1u << 1));          /* RFR not ready while both sides change speed */
+	if (!se_tx(hbaud, (int)sizeof(hbaud), NULL, 0)) {
+		return false;
+	}
+	nap(5);
+	if (!se_baud(3200000)) {
+		return false;
+	}
+	wr(se, 0x2ac, 0);                               /* RFR automatic again */
+	j = se_rx(20000, junk, (int)sizeof(junk));
+	say("20 ms after the switch: %d bytes discarded; IOS %08x (CTS in %u)\n", j, rd(se, 0x908), (rd(se, 0x908) >> 1) & 1);
+	if (!((rd(se, 0x908) >> 1) & 1)) {
+		wr(se, 0x25c, 0);                           /* the chip asserts CTS: honour it */
+		say("CTS asserted by the chip: flow control on\n");
+	}
+	if (cmd("QCA version at 3.2 Mbaud", c_qver, (int)sizeof(c_qver), 100000, 0xfc00, 0x19) != 0) {
+		say("(b) FAILED: no answer at 3.2 Mbaud\n");
+		return false;
+	}
+	if (!send_file("rampatch", fw, (uint32_t)fsz, false)) {
+		say("(b) FAILED in the rampatch\n");
+		return false;
+	}
+	nap(10);
+	/*
+	 * the NVM's tags as btqca walks them (b4_nvm). bt1..bt3: tag 17's in-band sleep bit and tag 27's deep sleep off (no IBS
+	 * here). bt4, icebt_nvm (built in 3): bit 1 = Linux's tag 17 (in-band sleep on, its baud byte QCA_BAUDRATE_3200000), only
+	 * with stage d (where the wake bytes are answered and b4_ibs_* runs); bit 2 = tag 27's deep sleep left on, as Linux does
+	 */
+	memcpy(nvm_copy, nv, (size_t)nsz);
+	nvm_mode = b4_kit() ? 3 : 0;            /* laneD: 3 only with the kit (icebt4=1); 0 = bt3 = install65 */
+	(void)PE_parse_boot_argn("icebt_nvm", &nvm_mode, sizeof(nvm_mode));
+	if (!b4_here()) {
+		nvm_mode &= ~1u;
+	}
+	b4_note_nvm(b4_nvm(nvm_copy, (uint32_t)nsz, nvm_mode, 0x11));
+	if (!send_file("NVM", nvm_copy, (uint32_t)nsz, true)) {
+		say("(b) FAILED in the NVM\n");
+		return false;
+	}
+	(void)cmd("disable SoC logging", nolog, (int)sizeof(nolog), 60000, 0xfc17, -1);
+	if (cmd("HCI_Reset", c_reset, (int)sizeof(c_reset), 200000, 0x0c03, -1) != 0) {
+		say("(b) FAILED: no HCI_Reset answer after the download\n");
+		return false;
+	}
+	/* the ROM says "BTFW.GANGES...ROM", the patched build "BTFW.BRAHMA..." (as Linux on this tablet reads it) */
+	patched = build_string("after the download", txt, sizeof(txt)) && strnstr(txt, "BRAHMA", sizeof(txt)) != NULL;
+	strlcpy(fw_label, txt, sizeof(fw_label));
+	if (!local_version("(b)") || !patched) {
+		say("(b) NOT PASSED: %s\n", patched ? "no Read_Local_Version" : "the build string is not the patched one");
+		return false;
+	}
+	say("(b) PASS: rampatch + NVM taken at 3.2 Mbaud, the patched controller answers HCI\n");
+	return true;
+}
+
+/* ---- (c): the controller set up and one passive LE scan, counted (hakios_iceland_harvest.c hb_*) ---- */
+#define S_ERR   ((1u << 9) | (1u << 10) | (1u << 11) | (1u << 12) | (1u << 24) | (1u << 25))
+static struct {
+	uint32_t ev, cc, cs, stray, malformed, unexpected, hwerr, vendor, other;
+	uint32_t adv, adv_pub, adv_rand, rssi[8], uart_err, sent, ok, timeout, tx_fail, fifo_max;
+} hb;
+static uint32_t hb_distinct;
+static uint8_t hb_buf[260], hb_reply[64];
+static int hb_n, hb_st, hb_rlen;
+static uint16_t hb_want;
+
+/* distinct advertiser addresses as 64-bit hashes in memory only: never logged */
+static void
+hb_seen_add(uint8_t at, const uint8_t *a)
+{
+	uint64_t h = 1469598103934665603ull;
+
+	h = (h ^ at) * 1099511628211ull;
+	for (int i = 0; i < 6; i++) {
+		h = (h ^ a[i]) * 1099511628211ull;
+	}
+	if (h == 0) {
+		h = 1;
+	}
+	for (unsigned i = 0, s = (unsigned)(h & (HB_SEEN_N - 1)); i < HB_SEEN_N; i++, s = (s + 1) & (HB_SEEN_N - 1)) {
+		if (hb_seen[s] == h) {
+			return;
+		}
+		if (hb_seen[s] == 0) {
+			hb_seen[s] = h;
+			hb_distinct++;
+			return;
+		}
+	}
+}
+
+static void
+hb_event(const uint8_t *e)
+{
+	uint8_t ev = e[1], plen = e[2];
+	const uint8_t *p = e + 3;
+
+	hb.ev++;
+	if (ev == 0x0e || ev == 0x0f) {
+		uint16_t op;
+		int st;
+
+		if ((ev == 0x0e && plen < 3) || (ev == 0x0f && plen < 4)) {
+			hb.malformed++;
+			return;
+		}
+		if (ev == 0x0e) {
+			hb.cc++;
+			op = (uint16_t)(p[1] | p[2] << 8);
+			st = plen >= 4 ? p[3] : 0;
+		} else {
+			hb.cs++;
+			op = (uint16_t)(p[2] | p[3] << 8);
+			st = p[0];
+		}
+		if (op == 0) {
+			return;                         /* command credits only */
+		}
+		if (hb_want != 0 && op == hb_want && hb_st < 0) {
+			hb_st = st;
+			hb_rlen = (int)plen < (int)sizeof(hb_reply) ? (int)plen : (int)sizeof(hb_reply);
+			memcpy(hb_reply, p, (size_t)hb_rlen);
+		} else {
+			hb.unexpected++;
+		}
+		return;
+	}
+	if (ev == 0x3e) {
+		int num, off = 2;
+
+		if (plen < 2 || p[0] != 0x02) {
+			hb.other++;
+			return;
+		}
+		num = p[1];
+		for (int k = 0; k < num; k++) {
+			uint8_t at, dl;
+			int8_t rssi;
+
+			if (off + 9 > plen) {
+				hb.malformed++;
+				break;
+			}
+			at = p[off + 1];
+			dl = p[off + 8];
+			if (off + 9 + dl + 1 > plen) {
+				hb.malformed++;
+				break;
+			}
+			rssi = (int8_t)p[off + 9 + dl];
+			hb.adv++;
+			if (at & 1) {
+				hb.adv_rand++;
+			} else {
+				hb.adv_pub++;
+			}
+			hb.rssi[rssi == 127 ? 7 : rssi >= -40 ? 0 : rssi >= -50 ? 1 : rssi >= -60 ? 2 : rssi >= -70 ? 3 :
+			    rssi >= -80 ? 4 : rssi >= -90 ? 5 : 6]++;
+			hb_seen_add(at, p + off + 2);
+			off += 10 + dl;
+		}
+		return;
+	}
+	if (ev == 0x10) {
+		if (hb.hwerr++ < 3) {
+			say("HARDWARE ERROR event, code %#x\n", plen >= 1 ? p[0] : 0xffu);
+		}
+		return;
+	}
+	if (ev == 0xff) {
+		hb.vendor++;
+		return;
+	}
+	hb.other++;
+}
+
+static void
+hb_byte(uint8_t b)
+{
+	if (hb_n == 0 && b != 0x04) {
+		hb.stray++;
+		return;
+	}
+	hb_buf[hb_n++] = b;
+	if (hb_n == 2 && (b == 0 || (b > 0x58 && b != 0xff))) {
+		hb.stray++;                             /* not an event code: the 04 was a stray byte */
+		hb_n = 0;
+		if (b == 0x04) {
+			hb_buf[hb_n++] = b;
+		}
+		return;
+	}
+	if (hb_n >= 3 && hb_n == 3 + hb_buf[2]) {
+		hb_event(hb_buf);
+		hb_n = 0;
+	}
+}
+
+/* drain RX for up to us (to the reply for hb_want when stop); RFR is automatic, so the chip waits while we sleep */
+static void
+hb_pump(uint32_t us, bool stop)
+{
+	uint64_t dl, idle, t0 = mach_absolute_time(), last = t0, now;
+
+	nanoseconds_to_absolutetime((uint64_t)us * 1000ull, &dl);
+	nanoseconds_to_absolutetime(300000ull, &idle);
+	for (;;) {
+		uint32_t fill = rd(se, 0x804) & 0x1ffffffu, s;
+		bool got = fill != 0;
+
+		if (fill > hb.fifo_max) {
+			hb.fifo_max = fill;
+		}
+		while (rd(se, 0x804) & 0x1ffffffu) {
+			hb_byte((uint8_t)rd(se, 0x780));
+		}
+		s = rd(se, 0x640) & S_ERR;
+		if (s) {
+			hb.uart_err++;
+			wr(se, 0x648, s);
+		}
+		if (stop && hb_st >= 0) {
+			return;
+		}
+		now = mach_absolute_time();
+		if (now - t0 >= dl || stop_req) {
+			return;
+		}
+		if (got) {
+			last = now;
+		} else if (now - last > idle) {
+			IOSleep(1);
+		}
+	}
+}
+
+static int
+hb_cmd(const char *name, const uint8_t *b, int n)
+{
+	hb_want = (uint16_t)(b[1] | b[2] << 8);
+	hb_st = -1;
+	hb_rlen = 0;
+	hb.sent++;
+	if (!se_tx(b, n, NULL, 0)) {
+		hb.tx_fail++;
+		hb_want = 0;
+		say("%s: TX FAILED\n", name);
+		return -2;
+	}
+	hb_pump(200000, true);
+	hb_want = 0;
+	if (hb_st < 0) {
+		hb.timeout++;
+	} else if (hb_st == 0) {
+		hb.ok++;
+	}
+	say("%s: status %d%s\n", name, hb_st, hb_st < 0 ? " (TIMEOUT)" : "");
+	return hb_st;
+}
+
+static bool
+stage_c(void)
+{
+	static const uint8_t evmask[] = { 0x01, 0x01, 0x0c, 0x08, 0xff, 0xff, 0xfb, 0xff, 0x07, 0xf8, 0xbf, 0x3d };
+	static const uint8_t leevmask[] = { 0x01, 0x01, 0x20, 0x08, 0x1f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
+	static const uint8_t bdaddr[] = { 0x01, 0x09, 0x10, 0x00 };
+	static const uint8_t feat[] = { 0x01, 0x03, 0x10, 0x00 };
+	static const uint8_t lefeat[] = { 0x01, 0x03, 0x20, 0x00 };
+	static const uint8_t bufsz[] = { 0x01, 0x05, 0x10, 0x00 };
+	static const uint8_t lebuf[] = { 0x01, 0x02, 0x20, 0x00 };
+	static const uint8_t wscan0[] = { 0x01, 0x1a, 0x0c, 0x01, 0x00 };
+	static const uint8_t scanpar[] = { 0x01, 0x0b, 0x20, 0x07, 0x00, 0x60, 0x00, 0x60, 0x00, 0x00, 0x00 };      /* PASSIVE */
+	static const uint8_t scan_on[] = { 0x01, 0x0c, 0x20, 0x02, 0x01, 0x00 };
+	static const uint8_t scan_off[] = { 0x01, 0x0c, 0x20, 0x02, 0x00, 0x00 };
+	int bad = 0, st;
+	bool set = false;
+
+	if (hb_seen == NULL) {
+		say("(c) no scan: no memory for the address hashes\n");
+		return false;
+	}
+	memset(&hb, 0, sizeof(hb));
+	memset(hb_seen, 0, HB_SEEN_N * sizeof(*hb_seen));
+	hb_distinct = 0;
+	hb_n = 0;
+	wr(se, 0x644, rd(se, 0x644) | S_ERR);
+	wr(se, 0x648, S_ERR);
+	hb_pump(20000, false);
+	memset(&hb, 0, sizeof(hb));
+	bad += hb_cmd("HCI_Reset", c_reset, (int)sizeof(c_reset)) != 0;
+	bad += hb_cmd("Set_Event_Mask (LE Meta on)", evmask, (int)sizeof(evmask)) != 0;
+	bad += hb_cmd("LE_Set_Event_Mask 0x1f", leevmask, (int)sizeof(leevmask)) != 0;
+	st = hb_cmd("Read_BD_ADDR (the address is not logged)", bdaddr, (int)sizeof(bdaddr));
+	bad += st != 0;
+	for (int k = 0; st == 0 && hb_rlen >= 10 && k < 6; k++) {
+		set = set || hb_reply[4 + k] != 0;
+	}
+	say("Read_BD_ADDR: address %s\n", set ? "set" : "zero / none");
+	bad += hb_cmd("Read_Local_Version", c_lver, (int)sizeof(c_lver)) != 0;
+	st = hb_cmd("Read_Local_Supported_Features", feat, (int)sizeof(feat));
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 12) {
+		say("LMP features: LE supported %u, BR/EDR not supported %u, simultaneous LE + BR/EDR %u\n", (hb_reply[8] >> 6) & 1,
+		    (hb_reply[8] >> 5) & 1, (hb_reply[10] >> 1) & 1);
+	}
+	bad += hb_cmd("LE_Read_Local_Supported_Features", lefeat, (int)sizeof(lefeat)) != 0;
+	st = hb_cmd("Read_Buffer_Size", bufsz, (int)sizeof(bufsz));
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 11) {
+		say("buffers: ACL %u bytes x %u, SCO %u bytes x %u\n", hb_reply[4] | hb_reply[5] << 8, hb_reply[7] | hb_reply[8] << 8,
+		    hb_reply[6], hb_reply[9] | hb_reply[10] << 8);
+	}
+	bad += hb_cmd("LE_Read_Buffer_Size", lebuf, (int)sizeof(lebuf)) != 0;
+	bad += hb_cmd("Write_Scan_Enable 0", wscan0, (int)sizeof(wscan0)) != 0;
+	bad += hb_cmd("LE_Set_Scan_Parameters PASSIVE 60/60 ms", scanpar, (int)sizeof(scanpar)) != 0;
+	if (bad != 0 || stop_req) {
+		say("(c) no scan: %d set-up steps did not answer status 0\n", bad);
+		return false;
+	}
+	st = hb_cmd("LE_Set_Scan_Enable 1 (passive)", scan_on, (int)sizeof(scan_on));
+	if (st == 0) {
+		for (int i = 0; i < 10 && !stop_req; i++) {
+			hb_pump(1000000, false);
+		}
+		st = hb_cmd("LE_Set_Scan_Enable 0", scan_off, (int)sizeof(scan_off));
+		hb_pump(50000, false);
+	}
+	say("10 s passive scan: %u advertising reports, %u distinct addresses (%u public-type / %u random-type reports)\n", hb.adv,
+	    hb_distinct, hb.adv_pub, hb.adv_rand);
+	say("RSSI dBm: >=-40 %u, -41..-50 %u, -51..-60 %u, -61..-70 %u, -71..-80 %u, -81..-90 %u, <-90 %u, n/a %u\n", hb.rssi[0],
+	    hb.rssi[1], hb.rssi[2], hb.rssi[3], hb.rssi[4], hb.rssi[5], hb.rssi[6], hb.rssi[7]);
+	say("link: commands %u ok %u TIMEOUTS %u TX failed %u; events %u (CC %u CS %u vendor %u other %u); stray bytes %u, "
+	    "malformed %u, unexpected %u, HW errors %u, UART errors %u; RX FIFO max fill %u of %u\n", hb.sent, hb.ok, hb.timeout,
+	    hb.tx_fail, hb.ev, hb.cc, hb.cs, hb.vendor, hb.other, hb.stray, hb.malformed, hb.unexpected, hb.hwerr, hb.uart_err,
+	    hb.fifo_max, rxdepth);
+	bad = hb_cmd("final HCI_Reset", c_reset, (int)sizeof(c_reset));
+	if (st != 0 || bad != 0 || hb.adv == 0) {
+		say("(c) NOT PASSED: %s\n", st != 0 || bad != 0 ? "a scan command or the reset did not answer status 0" :
+		    "the scan ran but heard no advertiser");
+		return false;
+	}
+	say("(c) PASS: the controller is up and the passive scan heard advertisers\n");
+	return true;
+}
+
+/*
+ * ---- (d): the controller handed to macOS's bluetoothd over /dev/cu.BLTH ----
+ *
+ * What the daemon looks for (names in the 26C5035r bluetoothd and BlueTool; the node's use as UniXNU/QcaBluetooth's
+ * src/qbt_tty.c describes it, BSD-2-Clause-Patent, nothing copied): the serial device /dev/cu.BLTH, opened, set raw
+ * with termios ioctls, then select + read on one thread and write on another, H4 framing; a service named "bluetooth"
+ * in the device tree with transport-encoding, transport-speed and local-mac-address (iokit/Kernel/RedwoodBT.cpp).
+ *
+ * The daemon is not patched. What stands between it and the Qualcomm controller is here, each with a boot-arg:
+ *   icebt_vsc=1     (default) a vendor command (OGF 0x3f) is never sent to the chip: the daemon takes a controller it
+ *                   does not know for a Broadcom one, and Qualcomm's own vendor commands share the range (0xfc00 is
+ *                   its download, 0xfc48 its baud rate). Answered here: Command Complete, status 0, the command's
+ *                   first parameter byte and 8 zero bytes (hakios_dada_wifi.c bt_answer_vendor, the iPadOS target)
+ *   icebt_fake=0xOP[,0xOP...]  standard commands answered here with status 0 (default 0x0c5b,0x0c5a: Default
+ *                   Erroneous Data Reporting, which this chip family refuses; then Supported Commands octet 18
+ *                   bits 2-3 are set in the chip's answer); icebt_fake=0 none
+ *   icebt_soft=1    (default) a standard command the chip answers with status 0x01 (unknown) or 0x11 (unsupported)
+ *                   reaches the daemon as status 0, where the length of its answer is known (ret_len: the commands
+ *                   that set something, and the reads listed there with zeroes); the trace keeps the chip's status
+ *   icebt_lemask=1  (default) LE_Set_Event_Mask (0x2001) goes out with bit 12 (LE Extended Advertising Report) set;
+ *                   icebt_lemask=3 (gains1, R1) also bit 11 (LE PHY Update Complete) and LE 2M PHY (feature bit 8)
+ *                   cleared in the 0x2003 answer: QcaBluetooth PR #5's 0x101f -> 0x181f and its Type 0 LE baseline
+ *   icebt_chipid=0xNN (default 0: none) the vendor answer to 0xfc79 (Broadcom's Read Verbose Config Version Info)
+ *                   carries chip id NN. With none the daemon keeps chipset 1 (BCM_4350C2) and its model's setChipset
+ *                   answers 1 for that value, so the stack terminates ("Terminating stack...") and the H4 pre-stop's
+ *                   empty extension faults (w5-bt, icepac run pac1). 0x98 = BCM_4378, 0x96 = BCM_4364B3, 0x5c = BCM_4350
+ *   icebt_mfr=N     (default 0: the chip's) Read Local Version Information reaches the daemon with manufacturer N
+ *                   (15 = Broadcom), for a daemon that pairs the chipset with the manufacturer
+ *   icebt_legacy=1  (default 0) the chip's LE features and supported commands lose extended / periodic advertising
+ *                   and extended scanning, so a host that asks first stays with the legacy commands
+ *   icebt_kick=1    (default) bluetoothd started before the controller was up and did not open the node within
+ *                   icebt_kick_s (10) seconds of it: one SIGTERM, launchd starts it again
+ *   icebt_vmm=0     (default) kern.hv_vmm_present reads 0 for bluetoothd and BlueTool: the loader's tree carries
+ *                   vmm-present for other components, and the daemon, told 1, skips the controller altogether
+ *   icebt_trace=N   0 none, 1 (default, w5-bt) opcodes and statuses, 2 + the parameter bytes of commands and answers that
+ *                   hold no address, key or name; at most icebt_trace_max (300) lines, then counts only
+ *   icebt_pair=1    (default 0, w7-bt) pairing diagnostics, see "pairing" below; icebt_pair_max=N its lines (400)
+ *   icebt_lediag=1  (default 1, gains2; only with icebt_pair) the LE link's own steps in the pairing lines, see below
+ *   icebt_lesec=N   (default 0: off, bt2) an LE peer that stays silent until it is encrypted gets paired first: see
+ *                   "LE security first" below; N is the wait in ms (1..99: 1500), icebt_lesec_err=E the ATT error (5)
+ * Under QEMU (PSCI over hvc) icebt=4 runs the same code against a stand-in controller in this file (canned answers,
+ * one made-up advertiser while a scan is on): no hardware is touched, and the lines say "sim".
+ */
+#define TTY_FIFO        16384u
+#define PKT_MAX         4400u
+#define OPS_N           160u
+#define SIM_RING        4096u
+
+extern void RedwoodBTStartMac(const uint8_t *address, uint32_t speed);          /* iokit/Kernel/RedwoodBT.cpp */
+
+static LCK_GRP_DECLARE(sv_grp, "icebt");
+static LCK_MTX_DECLARE(sv_lock, &sv_grp);
+static struct {
+	uint8_t *rx, *tx;                       /* to the client, from the client */
+	uint32_t rx_head, rx_len, tx_head, tx_len;
+	int major;
+	void *node;
+	bool open, up, gone, sim, fresh, rsel_used, wsel_used;
+	struct selinfo rsel, wsel;
+	uint8_t termios[72];
+	int pid;
+} sv = { .major = -1 };
+static struct {
+	uint32_t opens, closes, cmd, cmd_local, cmd_sent, acl_tx, acl_rx, other_tx, ev, cc, cs, cc_bad, rewritten, mask_or;
+	uint32_t adv, hwerr, stray, h_stray, big, dropped, uart_err, tx_fail, scan_on, reset_ok, kicked, sup_patched, legacy;
+} sd;
+static struct sv_op {
+	uint16_t op, n;
+	uint8_t st, how;                        /* how: 1 sent, 2 answered here, 4 the chip's refusal turned into status 0 */
+} *ops;
+static uint32_t ops_n, tr_level = 1, tr_max = 300, tr_lines, vsc_local = 1, soft = 1, lemask = 1, legacy_only;
+static uint32_t fake[8] = { 0x0c5b, 0x0c5a }, speed_now = 3200000;
+static uint32_t chipid;                  /* icebt_chipid: the chip id byte of the 0xfc79 answer (0: none) */
+static uint32_t mfr;                     /* icebt_mfr: Read Local Version's manufacturer for the client (0: the chip's) */
+static uint8_t *hp, *cp, *simr;
+static uint32_t hp_n, hp_need, hp_skip, cp_n, cp_need, sim_in, sim_out;
+static bool sim_scan, sim_ext;
+static uint64_t sim_next;
+
+/*
+ * ---- pairing (w7-bt, icebt_pair=1; default 0: none of this runs) ----
+ * Pairing had never been tried through the node. Nothing here changes what the daemon or the chip is sent, except
+ * that the framer takes event 0x59 (Encryption Change v2, Core 5.3), which it otherwise drops as a stray byte; the
+ * chip sends it when the daemon's page-2 event mask (bit 25) asks for it. The rest is lines "icebt: pair: ", a budget
+ * of their own (icebt_pair_max, 400: the icebt_trace lines are spent by the start-up):
+ *   - the event masks the daemon sets (0x0c01, 0x0c63, 0x2001) as values, with the pairing events left masked off
+ *   - commands: link control (OGF 1, inquiry and remote name aside), stored link keys, SSP / Secure Connections
+ *     modes, the LE connection, encryption, key and privacy commands, and each vendor command answered here (its
+ *     first two): opcode and length only; their Command Complete / Status: the status
+ *   - events: connection, disconnection (reason), authentication, encryption change and key refresh (status,
+ *     handle, on/off), IO capability response (IO capability, OOB, AuthReq), link key notification (key type), the
+ *     request events by name; LE connection complete (status, handle, role), LTK request (handle), P-256 / DHKey
+ *     completion (status)
+ *   - ACL frames on L2CAP CID 6 (LE SMP) or 7 (BR/EDR SMP): the SMP code; for a pairing request / response its IO
+ *     capability, OOB flag, AuthReq, maximum key size and key distribution; for a failure its reason
+ * Never logged: an address, a link key, LTK, IRK, CSRK, EDIV / Rand, confirm or random value, public key, DHKey
+ * check, the numeric comparison value, a passkey, a name or a class of device. The state lives behind the opcode
+ * table (one allocation in sv_prepare): nothing is added to __DATA.
+ *
+ * gains2 (21 Nov, the BLE keyboard that would not pair, install63-proof-pair-2 432.87-465.34 s): the daemon connected
+ * (200d), took the link (2012, 041d, 2016), sent vendor fdc1, and 30 s later dropped it (0406, reason 0x16) with zero SMP
+ * frames; its own log: "Timeout waiting for ATT response, forcing a disconnect ... AttOpcode: MTU Request" (GATT status
+ * 722) after "TS_LE_EncryptionCompleteCb ... STATUS 4803" at the connection. Read in the 26C5035r bluetoothd (arm64e
+ * slice 82e244d5): fdc1 is _BCM_LeSetPrioritizationThreshold(handle, threshold, cb) (the call at 0x1001da8e4: OCF
+ * 0x1c1, three bytes: handle, threshold) and its completion 0x1001b1748 ("status %d, hlCb 0x%x") hands only the status
+ * on; status 0 is what a Broadcom part answers, so the local answer is the right one and stays. 4803 comes from the LE
+ * security manager's long-term-key reply path (0x10025c774: "Failed to send the encryption failed callback"), not from
+ * a vendor completion; no other vendor command was sent on the LE link. The daemon reads GATT before it pairs (an HID
+ * keyboard's service asks for encryption), so the first missing step is the ATT MTU exchange. icebt_lediag=1 shows the
+ * LE link around it (no value, address or key): the connection completes with status, role, interval, latency and
+ * timeout (the enhanced forms carry a status too: the old parse read it as the handle), connection updates, remote
+ * features and version completes, data length and PHY changes, the peer's L2CAP connection parameter requests on CID 5
+ * with their responses, the first 48 ATT PDUs on CID 4 by opcode and length (MTU values and error codes shown, attribute
+ * values never), and in the summary the link's ACL frames each way against the controller's completed-packet counts and
+ * buffers, so a host that never sends, a controller that never completes and a peer that never answers can be told
+ * apart. icebt_lediag=0 turns these lines off.
+ */
+struct pr_state {
+	uint32_t on, lines, max, hidden, smp_in, smp_out, keyreq, keynote, encchg, smpfail;
+	uint32_t ev59;          /* bt1: icebt_ev59 (default 1): the framer takes event 0x59 without icebt_pair */
+	/* gains2: icebt_lediag (default 1, only with icebt_pair); le_handle is the last LE link's handle + 1 (0: none) */
+	uint32_t lediag, le_handle, le_out, le_in, le_done, done_all, att_lines, att_out, att_in, buf_acl, buf_le, sig;
+};
+#define PR      ((struct pr_state *)(void *)(ops + OPS_N))
+#define PR_ON   (ops != NULL && PR->on != 0)
+
+/*
+ * ---- LE security first (bt2, icebt_lesec=N; default 0: none of this runs) ----
+ * The Lenovo BLE keyboard (gains2 consoles g2 / g3) takes the LE link, answers the link layer (version, features,
+ * acknowledges the host's ATT Exchange MTU Request: Number Of Completed Packets) and then sends nothing at all, no ATT,
+ * no L2CAP, no SMP, for 30 s, until the 26C5035r daemon gives up ("Timeout waiting for ATT response ... MTU Request",
+ * disconnect 0x16). Under Fedora, same chip, same keyboard, BlueZ pairs first (SMP before ATT) and the keyboard answers
+ * everything once the link is encrypted. The daemon reads GATT before it pairs and has no own timer that pairs a silent
+ * peer; but its ATT client pairs when a request is refused for security (bluetoothd 26C5035r arm64e 82e244d5, read in
+ * the disassembly): the Error Response handler 0x10022f2f8 takes codes 5 / 8 / 0xc / 0xf for the outstanding request;
+ * on an unbonded link (0x10025c260) code 5 (Insufficient Authentication) or 0xf (Insufficient Encryption) with the
+ * bearer's startAutoPairing (+0x63, set to 1 when the GATT client is made, 0x1002511b8) calls StartPairing(link, MITM)
+ * 0x100267d58 (central: an SMP Pairing Request), keeps the request and stops its ATT timer; code 8 (Insufficient
+ * Authorization) does the same without looking at startAutoPairing. When the security completes, 0x10022f250 (the
+ * bearer callback table 0x100b3a6f0) sends the same request again (0x10022c810), or on failure ends it with code 0xf.
+ * So, with icebt_lesec=N: an LE link (the controller's connection complete, status 0) that is not encrypted and has
+ * brought no ACL in at all, whose host ATT request has had no answer for N ms (1..99: 1500), gets ONE ATT Error
+ * Response for that request from here (code icebt_lesec_err, default 5; the attribute handle 0 for an MTU request).
+ * Nothing is sent to the chip. The daemon pairs, the encrypted peer answers the request sent again. A peer that later
+ * still answers the refused request would hand the daemon a second response: the first response on that link whose
+ * opcode answers the refused request while the host has no such request open is dropped here (a peer never sends an
+ * unrequested response). A link that brings any ACL in, or is encrypted, is never touched. Lines "icebt: lesec: ...".
+ * The state lives behind w7-bt's PR (one allocation in sv_prepare): nothing is added to __DATA.
+ */
+#define LS_N    4u
+struct ls_link {
+	uint32_t h1;            /* the handle + 1 (0: a free slot) */
+	uint32_t enc, in;       /* encrypted; ACL frames in on this link */
+	uint32_t req, att_h, t; /* the host's open ATT request: opcode + 1 (0: none), its attribute handle, since (ms) */
+	uint32_t done, late;    /* the error was handed over; the refused opcode + 1 while its late answer may come */
+};
+struct ls_state {
+	uint32_t wait_ms, err, injected, dropped;
+	struct ls_link l[LS_N];
+};
+#define LS      ((struct ls_state *)(void *)(PR + 1))
+#define LS_ON   (ops != NULL && LS->wait_ms != 0)
+/* ATT client requests that take a response (Core 5.4 Vol 3 Part F 3.4.8), and the responses */
+#define LS_REQ  ((1ull << 0x02) | (1ull << 0x04) | (1ull << 0x06) | (1ull << 0x08) | (1ull << 0x0a) | (1ull << 0x0c) | \
+	         (1ull << 0x0e) | (1ull << 0x10) | (1ull << 0x12) | (1ull << 0x16) | (1ull << 0x18) | (1ull << 0x20))
+#define LS_RSP  ((LS_REQ << 1) | (1ull << 0x01))
+
+/*
+ * ---- LE ACL packet boundary (bt2 run 2, icebt_lepb; default 1) ----
+ * bt2-lesec-1 (tablet, 21 Nov): the shim's ATT refusal made the 26C5035r daemon send an SMP Pairing Request, and no LE
+ * peer (three keyboards and another device) ever sent a byte back, while the link layer kept working (connection,
+ * remote version and features, a PHY update, Number Of Completed Packets for every host frame) and classic ACL comes
+ * in both ways. A peer always answers a Pairing Request: the peers never got our L2CAP frames. The daemon starts every
+ * ACL frame with packet boundary 0b10 "first automatically flushable" (the ACL sender 0x10020d2f0: w19 = 2, PB 0b00 only
+ * for a frame marked non-flushable when the controller's features allow it, 0b11 for one kind; the LE writer 0x1001ad318
+ * passes it through; PB 0b00 without that feature triggers a diagnostic capture), evidently fine with Apple's Broadcom
+ * parts. On LE-U the start of an L2CAP PDU from the host is PB 0b00 (Core 5.4 Vol 4 Part E 5.4.2;
+ * Linux l2cap_core: LE links always ACL_START_NO_FLUSH; Fedora's btmon on this chip: host LE-ACL flags 0x00, controller
+ * flags 0x02). icebt_lepb=1: an ACL frame from the host on an LE handle (from the controller's LE connection complete,
+ * any role) with PB 0b10 or 0b11 goes to the chip as PB 0b00; continuations (0b01) and BR/EDR frames are untouched.
+ * The first frames rewritten are logged ("icebt: lepb:"), the counts by PB in each summary. icebt_lepb=0: as before.
+ * bt2-lepb-2 (tablet): no rewrite ever fired, the daemon already sends LE starts as PB 00 (its "reliable" frames, with
+ * the chip's non-flushable PB feature): PB was not the cause. bt2c: icebt_lefix defaults to 7, and each LE link's end
+ * logs its frames from the host, the chip's completions for them and its frames to the host ("icebt: le: handle ...
+ * ended"), plus LE Create Connection's own address type (never an address).
+ * icebt_lefix=bits (default 7 since bt2c; 0: the daemon's set-up), the other host set-up differences against Fedora's
+ * btmon: 1: LE Set Host
+ * Feature bit 38 (Connection Subrating) and LE Set Default Subrate (0x207d) answered here, not sent (BlueZ sends
+ * neither); 2: Host Buffer Size (0x0c33) and Set Controller To Host Flow Control (0x0c31) answered here (BlueZ sends
+ * neither; the daemon sends flow control off); 4: Write LE Host Support's Simultaneous byte sent as 0 (BlueZ: 01 00,
+ * the daemon 01 01). The parameters of these five commands are logged as sent ("icebt: le: >"). Heap state, after LS.
+ */
+#define LP_N    8u
+struct lp_state {
+	uint32_t pb, fix;               /* icebt_lepb, icebt_lefix */
+	uint32_t pbn[4], rewritten, shown, logged;
+	uint32_t h1[LP_N];              /* the LE links' handles + 1 */
+	uint32_t out[LP_N], done[LP_N], in[LP_N];       /* bt2c: per link ACL from the host, completed by the chip, to the host */
+};
+#define LP      ((struct lp_state *)(void *)(LS + 1))
+
+/*
+ * ---- the inbound accounting at the transport (bt3, icebt_rxlog; default 1; 0: no lines) ----
+ * bt2c (tablet, 22 Nov): the LE link to the keyboard came up (connection, remote version and features), the chip completed
+ * all 3 host frames (Number Of Completed Packets), and not one ACL frame came in for the whole boot; a Nordic-made LE peer
+ * (bt2-lesec-1, handle 3, PHY moved to 2M) was just as silent, while classic peers bring ACL in through the same framer.
+ * The framer's counters (stray 0, oversize 0, client drops 0, UART errors 0) said nothing was lost here, but two things
+ * were never seen: an H4 ISO (0x05) or SCO (0x03) packet goes to the daemon uncounted (an ISO header frames like ACL's:
+ * an LE ACL frame the chip typed 0x05 would vanish in the daemon without a trace), and how long the chip takes to
+ * complete an LE frame (about one connection interval means the peer's link layer acknowledged it on air; at once means
+ * the chip only queued it). So, at the lowest layer we own, with no new static data (heap, after LP):
+ *   - every byte read from the UART, every packet by H4 type, ACL / ISO / SCO by handle (frames, the PB and BC flag
+ *     values seen, the link kind from its connection complete: L LE, B BR/EDR, ? none: unrouted), the chip's log frames
+ *     (handle 0x2edc), the first stray bytes' values, packets dropped because nobody reads the node (by type), and the
+ *     engine's error bits; lines "icebt: rx: " in each summary and at every LE link's end;
+ *   - while an LE link is up, one line per packet each way except advertising reports (icebt_rxlog lines, 160; N > 1
+ *     sets the budget): type, handle, PB, BC, length, and for a first fragment on a fixed L2CAP channel (CID 1..7) the
+ *     CID and its first byte (the ATT / SMP / signalling code: never a value, address or key; a dynamic channel's payload
+ *     shows CID 0, op 0); events by code and handle (Command Complete / Status
+ *     by opcode); Number Of Completed Packets for an LE link with the milliseconds since that frame went to the chip;
+ *   - icebt_iso2acl (default 1; 0 off): an H4 ISO packet whose handle is an LE ACL link's (never legitimate: handles are
+ *     unique per controller) is handed on as the ACL frame it must be, counted and logged.
+ */
+#define RX_H    8u
+#define RX_L    4u
+struct rx_h {
+	uint32_t h1, kind, acl, iso, sco, pbm, bcm;     /* handle + 1; kind: 1 LE, 2 BR/EDR, 0 no connection seen */
+};
+struct rx_l {
+	uint32_t h1, q[8], qn, sent, done, lost, lo, hi;        /* an LE link: send times (ms) of frames not yet completed */
+};
+struct rx_state {
+	uint32_t on, max, lines, iso2acl, retyped, stray_n, uerr, dbg;
+	uint64_t bytes;
+	uint32_t pkt[6];                /* by H4 type 0x02..0x05 at [2..5]; any other at [0] */
+	uint32_t drop[6];               /* to nobody (no client), the same index */
+	uint8_t stray[8];
+	struct rx_h h[RX_H];
+	struct rx_l l[RX_L];
+};
+#define RX      ((struct rx_state *)(void *)(LP + 1))
+
+/*
+ * ---- bt4 (23 Nov): the controller set-up Fedora runs on this chip ----
+ * bt3 left three differences between this controller and the one Fedora pairs the same BLE keyboard with (REPORT-bt3a items
+ * 4-5): no public address of its own, Linux's NVM edits undone, no in-band sleep. Fixes 1 and 2 of the owner's "All fixed"
+ * (23 Nov); fix 3, the Type-0 persona, is the addon's patched daemon and bsd/kern/kern_exec.c. Each is its own switch, built
+ * in (pexpert/arm/pe_builtin_args.c), code default 0 (off); facts from the owner's linux a2e1ea44 and tb323fu-linux aecc452
+ * (both read, nothing copied):
+ *   icebt_bdaddr=1  btqca.c:1014-1034 qca_set_bdaddr: EDL 0xfc14 with the 6 address bytes most significant first (baswap of
+ *                   bdaddr_t; Fedora's btmon on this chip: plen 6, Command Complete status 0 in 2.5 ms); tb323fu-gen-ids:15-29:
+ *                   the address is the first 6 bytes of sha256("<label>:<id>"), bit 1 (locally administered) set, bit 0
+ *                   (multicast) clear. Here label "iceland-bt" and id the SoC's serial (SMEM item 137 socinfo, serial_num at
+ *                   offset 96, Linux's /sys/devices/soc0/serial_number: socinfo.h:24-57, smem.c qcom_smem_get: the global
+ *                   partition of hosts 0xfffe / 0xfffe, else the global heap's table). Sent in stage d, before Read_BD_ADDR,
+ *                   so the address the service publishes is this one. Neither the id nor the address is logged: a 16-bit tag
+ *                   (sha256 of the address, first 2 bytes) only.
+ *   icebt_nvm=3     btqca.c:418-444: tag 17 (EDL_TAG_ID_HCI) data[0] |= 0x80 (software in-band sleep) and data[1] = the
+ *                   user baud (WCN3991 and later); tag 27 (deep sleep) data[0] |= 1. Bits: 1 = tag 17, 2 = tag 27.
+ *   icebt_ibs=1     hci_qca.c:43-51, 389-548, 760-990: WAKE_IND 0xfd, WAKE_ACK 0xfc, SLEEP_IND 0xfe, single bytes between
+ *                   packets. The host wakes the chip before a frame when its own side sleeps (WAKE_IND, again after 100 ms
+ *                   without an ACK), acknowledges every wake the chip sends, and sends SLEEP_IND after 2 s without a frame;
+ *                   hci_qca.c:2109 arms it after qca_uart_setup, tb323fu 0030 only once the operating speed is set ("at init
+ *                   speed this ROM stops answering after an IBS sleep/wake cycle"). Here: armed at the start of stage d (after
+ *                   (b) at 3.2 Mbaud) with a first wake; no ACK to 3 wakes in a row (300 ms) turns it off for the boot, logged,
+ *                   and frames go out without it, instead of holding the link. Never with tag 17's bit off.
+ */
+struct b4_state {
+	uint32_t addr_on, nvm, ibs;             /* icebt_bdaddr, icebt_nvm, icebt_ibs */
+	uint32_t nvm_done;                      /* the icebt_nvm bits stage b applied */
+	uint32_t on, tx, rx, t_tx;              /* IBS armed; tx 0 asleep, 1 waking, 2 awake; rx 0 asleep, 1 awake; last frame (ms) */
+	uint32_t wake_out, again, ack_in, wake_in, ack_out, slp_in, slp_out, fell, max_ms;
+	int addr_st;                            /* 0xfc14's status (-3: not sent) */
+	uint8_t addr[6], sim_addr[6];           /* the unit's address (most significant first); the stand-in's once set */
+	uint32_t col_n, col_k, col_len;         /* b4_xchg: event bytes kept; bytes and length of the packet being read */
+	uint8_t col_h[5], col[96];
+};
+#ifndef B4
+#define B4      ((struct b4_state *)(void *)(RX + 1))
+#endif
+static void b4_tx1(uint8_t b);                          /* one IBS byte to the chip (not gated) */
+static bool b4_txn(const uint8_t *p, uint32_t n);       /* one packet to the chip (not gated) */
+static bool b4_rx1(uint8_t *b);                         /* the chip's next byte, if any */
+static uint32_t b4_ms(void);
+static void b4_pause(void);
+
+/* the unit's address from its id: sha256("iceland-bt:" id), the first 6 bytes, locally administered, not multicast */
+static void
+b4_addr(const char *id, uint8_t a[6])
+{
+	SHA256_CTX c;
+	uint8_t d[32];
+
+	SHA256_Init(&c);
+	SHA256_Update(&c, "iceland-bt:", 11);
+	SHA256_Update(&c, id, strlen(id));
+	SHA256_Final(d, &c);
+	memcpy(a, d, 6);
+	a[0] = (uint8_t)((a[0] | 0x02) & ~0x01);
+	memset(d, 0, sizeof(d));
+}
+
+/* what the log shows of an address: the first 2 bytes of its sha256 */
+static uint32_t
+b4_tag(const uint8_t a[6])
+{
+	SHA256_CTX c;
+	uint8_t d[32];
+
+	SHA256_Init(&c);
+	SHA256_Update(&c, a, 6);
+	SHA256_Final(d, &c);
+	return (uint32_t)d[0] << 8 | d[1];
+}
+
+/* an aligned little-endian word of the shared memory, 0 outside it */
+static uint32_t
+b4_w(const volatile uint8_t *m, uint32_t sz, uint32_t o)
+{
+	return (o & 3) || o > sz - 4 ? 0 : *(const volatile uint32_t *)(const volatile void *)(m + o);
+}
+
+/* SMEM item 137 (socinfo): its serial_num, 0 if none; *how 1 = the global partition, 2 = the global heap */
+static uint32_t
+b4_smem_serial(const volatile uint8_t *m, uint32_t sz, uint32_t *how)
+{
+	uint32_t top = sz - 0x1000, n = 0, at = 0, isz = 0;
+
+	*how = 0;
+	if (b4_w(m, sz, top) == 0x434f5424 && b4_w(m, sz, top + 4) == 1 && (n = b4_w(m, sz, top + 8)) <= 64) {     /* "$TOC" */
+		for (uint32_t i = 0; i < n && at == 0; i++) {
+			uint32_t e = top + 32 + 48 * i, off = b4_w(m, sz, e), psz = b4_w(m, sz, e + 4), cl = b4_w(m, sz, e + 16);
+			uint32_t fu = 0, fc = 0, p, back;
+
+			if (off == 0 || psz < 32 || off > top || psz > top - off || b4_w(m, sz, e + 12) != 0xfffefffe ||
+			    b4_w(m, sz, off) != 0x54525024 || (fu = b4_w(m, sz, off + 12)) > psz || (fc = b4_w(m, sz, off + 16)) > psz) {
+				continue;                       /* not the global partition ("$PRT", hosts 0xfffe / 0xfffe) */
+			}
+			for (p = 32; p + 16 <= fu;) {           /* uncached items from the start */
+				uint32_t h = b4_w(m, sz, off + p), size = b4_w(m, sz, off + p + 4), pad = b4_w(m, sz, off + p + 8);
+
+				if ((h & 0xffff) != 0xa5a5 || size > psz || (pad & 0xffff) > size) {
+					break;
+				}
+				if (h >> 16 == 137) {
+					at = off + p + 16 + (pad >> 16);
+					isz = size - (pad & 0xffff);
+					break;
+				}
+				p += 16 + (pad >> 16) + size;
+			}
+			back = cl != 0 && !(cl & (cl - 1)) ? (16 + cl - 1) & ~(cl - 1) : 16;
+			for (p = psz - back; at == 0 && p > fc && p < psz;) {   /* cached items from the end */
+				uint32_t h = b4_w(m, sz, off + p), size = b4_w(m, sz, off + p + 4), pad = b4_w(m, sz, off + p + 8);
+
+				if ((h & 0xffff) != 0xa5a5 || size > p || (pad & 0xffff) > size) {
+					break;
+				}
+				if (h >> 16 == 137) {
+					at = off + p - size;
+					isz = size - (pad & 0xffff);
+				} else if (size + back > p) {
+					break;
+				} else {
+					p -= size + back;
+				}
+			}
+			*how = at != 0 ? 1 : 0;
+		}
+	}
+	if (at == 0 && b4_w(m, sz, 208 + 16 * 137) == 1 && (b4_w(m, sz, 208 + 16 * 137 + 12) & ~3u) == 0) {
+		at = b4_w(m, sz, 208 + 16 * 137 + 4);   /* the heap's table: allocated, offset, size, aux base 0 */
+		isz = b4_w(m, sz, 208 + 16 * 137 + 8);
+		*how = 2;
+	}
+	if (at == 0 || isz < 100 || at > sz || isz > sz - at) {
+		*how = 0;
+		return 0;
+	}
+	return b4_w(m, sz, at + 96);
+}
+
+/* btqca's NVM walk: mode bit 1 = tag 17's in-band sleep on and its baud byte, bit 2 = tag 27's deep sleep on; a clear bit
+ * keeps bt1's edit (off). Returns the bits applied. */
+static uint32_t
+b4_nvm(uint8_t *nv, uint32_t nsz, uint32_t mode, uint8_t baud)
+{
+	uint32_t idx = 4, type = nv[0], len = (uint32_t)nv[1] | (uint32_t)nv[2] << 8 | (uint32_t)nv[3] << 16, p = 0, done = 0;
+
+	if (type == 4) {
+		type = nv[4];
+		len = (uint32_t)nv[5] | (uint32_t)nv[6] << 8 | (uint32_t)nv[7] << 16;
+		idx = 8;
+	}
+	if (type != 2 || len > nsz - idx) {
+		return 0;
+	}
+	while (p + 12 <= len) {
+		uint8_t *t = nv + idx + p, was;
+		uint32_t tid = (uint32_t)t[0] | (uint32_t)t[1] << 8, tlen = (uint32_t)t[2] | (uint32_t)t[3] << 8;
+
+		if (tlen > len - p - 12) {
+			break;
+		}
+		if (tid == 17 && tlen >= 3) {
+			uint8_t wb = t[13];
+
+			was = t[12];
+			if (mode & 1) {
+				t[12] |= 0x80;
+				t[13] = baud;
+				done |= 1;
+			} else {
+				t[12] &= 0x7f;
+			}
+			say("NVM tag 17: data[0] %02x -> %02x, baud %02x -> %02x\n", was, t[12], wb, t[13]);
+		} else if (tid == 27 && tlen >= 1) {
+			was = t[12];
+			if (mode & 2) {
+				t[12] |= 1;
+				done |= 2;
+			} else {
+				t[12] &= (uint8_t)~1u;
+			}
+			say("NVM tag 27: data[0] %02x -> %02x\n", was, t[12]);
+		}
+		p += 12 + tlen;
+	}
+	return done;
+}
+
+/* an IBS byte from the chip between two packets (device_want_to_wakeup / _to_sleep / device_woke_up) */
+static void
+b4_ibs_in(struct b4_state *s, uint8_t b)
+{
+	if (b == 0xfd) {
+		s->wake_in++;
+		s->rx = 1;
+		b4_tx1(0xfc);                           /* every wake is acknowledged */
+		s->ack_out++;
+	} else if (b == 0xfe) {
+		s->slp_in++;
+		s->rx = 0;
+	} else {
+		s->ack_in++;
+		if (s->tx == 1) {
+			s->tx = 2;
+			s->t_tx = b4_ms();
+		}
+	}
+}
+
+/* before a frame: the chip woken when this side sleeps; the bytes read meanwhile go to feed (which hands an IBS byte between
+ * two packets to b4_ibs_in). No ACK to 3 wakes 100 ms apart: IBS off for the boot. */
+static bool
+b4_ibs_wake(struct b4_state *s, void (*feed)(uint8_t))
+{
+	uint32_t t0 = b4_ms(), t;
+	uint8_t b;
+
+	if (s->tx == 2) {
+		s->t_tx = t0;
+		return true;
+	}
+	s->tx = 1;
+	for (uint32_t k = 0; k < 3 && s->tx == 1; k++) {
+		b4_tx1(0xfd);
+		s->wake_out++;
+		s->again += k != 0;
+		for (t = b4_ms(); s->tx == 1 && b4_ms() - t < 100;) {
+			if (b4_rx1(&b)) {
+				feed(b);
+			} else {
+				b4_pause();
+			}
+		}
+	}
+	if (s->tx == 2) {
+		t = b4_ms() - t0;
+		s->max_ms = t > s->max_ms ? t : s->max_ms;
+		return true;
+	}
+	s->on = 0;
+	s->tx = 0;
+	s->fell++;
+	say("ibs: no WAKE_ACK to 3 wakes: in-band sleep OFF for this boot\n");
+	return false;
+}
+
+/* the pump's tick: 2 s without a frame out, this side sleeps (SLEEP_IND) */
+static void
+b4_ibs_tick(struct b4_state *s)
+{
+	if (s->on && s->tx == 2 && b4_ms() - s->t_tx >= 2000) {
+		b4_tx1(0xfe);
+		s->tx = 0;
+		s->slp_out++;
+	}
+}
+
+/* b4_xchg's reader: the events into col, ACL skipped, an IBS byte between two packets to b4_ibs_in */
+static void
+b4_col(uint8_t b)
+{
+	struct b4_state *s = B4;
+	uint32_t hdr;
+
+	if (s->col_k == 0 && b >= 0xfc && b <= 0xfe) {
+		b4_ibs_in(s, b);
+		return;
+	}
+	if (s->col_k == 0 && b != 0x04 && b != 0x02) {
+		return;                                 /* a stray byte */
+	}
+	if (s->col_k < 5) {
+		s->col_h[s->col_k] = b;
+	}
+	s->col_k++;
+	hdr = s->col_h[0] == 0x04 ? 3 : 5;
+	if (s->col_k == hdr) {
+		s->col_len = hdr + (hdr == 3 ? s->col_h[2] : ((uint32_t)s->col_h[3] | (uint32_t)s->col_h[4] << 8));
+	}
+	if (s->col_h[0] == 0x04 && s->col_n < sizeof(s->col)) {
+		s->col[s->col_n++] = b;
+	}
+	if (s->col_k >= hdr && s->col_k == s->col_len) {
+		s->col_k = 0;
+	}
+}
+
+/* one command to the chip outside the node (stage d, before the service): the chip woken first under IBS; the status of its
+ * Command Complete (the events in col), -1 none in cap_ms, -2 not sent */
+static int
+b4_xchg(const uint8_t *c, uint32_t n, uint16_t op, uint32_t cap_ms)
+{
+	struct b4_state *s = B4;
+	uint32_t t;
+	uint8_t b;
+	int at;
+
+	s->col_n = s->col_k = 0;
+	if (s->on) {
+		(void)b4_ibs_wake(s, b4_col);
+		s->col_n = s->col_k = 0;
+	}
+	if (!b4_txn(c, n)) {
+		return -2;
+	}
+	for (t = b4_ms(); b4_ms() - t < cap_ms;) {
+		if (!b4_rx1(&b)) {
+			b4_pause();
+			continue;
+		}
+		b4_col(b);
+		if (s->col_k == 0 && (at = cc_at(s->col, (int)s->col_n, op, -1)) >= 0 && at + 6 < (int)s->col_n) {
+			return s->col[at + 6];
+		}
+	}
+	return -1;
+}
+/* ---- the end of bt4's pure block (runs/bt4/scripts/b4-test.sh cuts it) ---- */
+
+#define pr_say(...)     do { if (PR->lines < PR->max) { PR->lines++; say("pair: " __VA_ARGS__); } else { PR->hidden++; } } while (0)
+
+static uint32_t
+pr_handle(const uint8_t *p)
+{
+	return (uint32_t)(p[0] | p[1] << 8) & 0xfffu;
+}
+
+static uint64_t
+pr_le64(const uint8_t *p)
+{
+	uint64_t v = 0;
+
+	for (int i = 7; i >= 0; i--) {
+		v = v << 8 | p[i];
+	}
+	return v;
+}
+
+/* the commands whose opcode the pairing trace shows (the event masks are shown with their values) */
+static bool
+pr_op(uint16_t op)
+{
+	static const uint16_t list[] = { 0x0c0d, 0x0c11, 0x0c12, 0x0c55, 0x0c56, 0x0c6d, 0x0c79, 0x0c7a, 0x200d, 0x200e, 0x2010,
+		                         0x2011, 0x2012, 0x2013, 0x2016, 0x2017, 0x2018, 0x2019, 0x201a, 0x201b, 0x2025, 0x2026, 0x2027,
+		                         0x2028, 0x2029, 0x202d, 0x202e, 0x2043, 0x204e, 0x205e };
+	uint16_t ocf = op & 0x3ff;
+
+	if ((op >> 10) == 1) {
+		return ocf > 0x04 && ocf != 0x19 && ocf != 0x1a;
+	}
+	for (unsigned i = 0; i < sizeof(list) / sizeof(list[0]); i++) {
+		if (list[i] == op) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* gains2: the vendor commands the 26C5035r bluetoothd sends, by the name its own assertion strings give the sender */
+static const char *
+pr_vendor_name(uint16_t op)
+{
+	switch (op) {
+	case 0xfc79: return " (ReadFWInfo)";
+	case 0xfce2: return " (Olympic, sub-command in byte 0)";
+	case 0xfce9: return " (LEMeta, sub-command in byte 0)";
+	case 0xfd3c: return " (WriteLELocalSupportedFeatures)";
+	case 0xfd47: return " (EnableExtendedDuplicateFilter)";
+	case 0xfd48: return " (CreateMultipleAdvInstance)";
+	case 0xfd4e: return " (UpdateMultipleAdvInstanceAddress)";
+	case 0xfdc1: return " (LeSetPrioritizationThreshold: handle, threshold; the daemon reads the status only)";
+	case 0xfdf2: return " (BeamformingMRCEnableVSE)";
+	default: return "";
+	}
+}
+
+static void
+pr_cmd(const uint8_t *p, uint32_t n, uint16_t op, bool here, const struct sv_op *o)
+{
+	uint64_t m;
+
+	if (op == 0x0c01 && n >= 12) {
+		/* Connection Complete / Request, Disconnection, Authentication, Encryption Change, PIN / Link Key Request,
+		 * Link Key Notification, Key Refresh, IO Capability Request / Response, User Confirmation / Passkey Request,
+		 * Remote OOB, Simple Pairing Complete, Passkey / Keypress Notification, Remote Host Features, LE Meta */
+		m = pr_le64(p + 4);
+		pr_say("> Set_Event_Mask %#018llx: pairing events masked off %#llx\n", m, 0x3c3f800000e000bcull & ~m);
+	} else if (op == 0x0c63 && n >= 12) {
+		m = pr_le64(p + 4);
+		pr_say("> Set_Event_Mask_Page_2 %#018llx: Encryption_Change_v2 (0x59) %s, Authenticated_Payload_Timeout %s\n", m,
+		    (m >> 25) & 1 ? "on" : "off", (m >> 23) & 1 ? "on" : "off");
+	} else if (op == 0x2001 && n >= 12) {
+		/* Connection Complete, LTK Request, P-256 / DHKey Complete, Enhanced Connection Complete */
+		m = pr_le64(p + 4);
+		pr_say("> LE_Set_Event_Mask %#018llx (as sent): LE pairing events masked off %#llx\n", m, 0x391ull & ~m);
+	} else if ((op >> 10) == 0x3f) {
+		if (here && o != NULL && o->n <= 2) {
+			pr_say("> vendor %04x n %u: answered here, not sent%s\n", op, n - 4, pr_vendor_name(op));
+		}
+	} else if (pr_op(op)) {
+		pr_say("> cmd %04x n %u%s\n", op, n - 4, here ? " (answered here)" : "");
+	}
+}
+
+static void
+pr_evt(const uint8_t *p, uint32_t n)
+{
+	uint16_t op;
+
+	switch (p[1]) {
+	case 0x03:
+		if (n >= 14) {
+			pr_say("< Connection_Complete st %#x handle %#x link type %u encryption %u\n", p[3], pr_handle(p + 4), p[12], p[13]);
+		}
+		break;
+	case 0x04:
+		if (n >= 13) {
+			pr_say("< Connection_Request link type %u\n", p[12]);
+		}
+		break;
+	case 0x05:
+		if (n >= 7) {
+			pr_say("< Disconnection_Complete st %#x handle %#x reason %#x\n", p[3], pr_handle(p + 4), p[6]);
+		}
+		break;
+	case 0x06:
+		if (n >= 6) {
+			pr_say("< Authentication_Complete st %#x handle %#x\n", p[3], pr_handle(p + 4));
+		}
+		break;
+	case 0x08:
+	case 0x59:
+		PR->encchg++;
+		if (p[1] == 0x59 && n >= 8) {
+			pr_say("< Encryption_Change_v2 st %#x handle %#x on %u key size %u\n", p[3], pr_handle(p + 4), p[6], p[7]);
+		} else if (n >= 7) {
+			pr_say("< Encryption_Change st %#x handle %#x on %u\n", p[3], pr_handle(p + 4), p[6]);
+		}
+		break;
+	case 0x30:
+		if (n >= 6) {
+			pr_say("< Encryption_Key_Refresh_Complete st %#x handle %#x\n", p[3], pr_handle(p + 4));
+		}
+		break;
+	case 0x16:
+		pr_say("< PIN_Code_Request (legacy pairing)\n");
+		break;
+	case 0x17:
+		PR->keyreq++;
+		pr_say("< Link_Key_Request\n");
+		break;
+	case 0x18:
+		PR->keynote++;
+		if (n >= 26) {
+			pr_say("< Link_Key_Notification key type %u (the key is not shown)\n", p[25]);
+		}
+		break;
+	case 0x31:
+		pr_say("< IO_Capability_Request\n");
+		break;
+	case 0x32:
+		if (n >= 12) {
+			pr_say("< IO_Capability_Response io %u oob %u auth %#x\n", p[9], p[10], p[11]);
+		}
+		break;
+	case 0x33:
+		pr_say("< User_Confirmation_Request (the value is not shown)\n");
+		break;
+	case 0x34:
+		pr_say("< User_Passkey_Request\n");
+		break;
+	case 0x35:
+		pr_say("< Remote_OOB_Data_Request\n");
+		break;
+	case 0x36:
+		if (n >= 4) {
+			pr_say("< Simple_Pairing_Complete st %#x\n", p[3]);
+		}
+		break;
+	case 0x3b:
+		pr_say("< User_Passkey_Notification (the passkey is not shown)\n");
+		break;
+	case 0x3c:
+		if (n >= 10) {
+			pr_say("< Keypress_Notification type %u\n", p[9]);
+		}
+		break;
+	case 0x3d:
+		pr_say("< Remote_Host_Supported_Features_Notification\n");
+		break;
+	case 0x57:
+		if (n >= 5) {
+			pr_say("< Authenticated_Payload_Timeout_Expired handle %#x\n", pr_handle(p + 3));
+		}
+		break;
+	case 0x0c:
+		if (PR->lediag && n >= 11) {
+			pr_say("< Read_Remote_Version_Complete st %#x handle %#x version %u manufacturer %u subversion %#x\n", p[3],
+			    pr_handle(p + 4), p[6], (uint32_t)(p[7] | p[8] << 8), (uint32_t)(p[9] | p[10] << 8));
+		}
+		break;
+	case 0x13:
+		/* gains2: Number Of Completed Packets: counted (the link's against all), never a line each */
+		for (uint32_t k = 0; PR->lediag && n >= 4 && k < p[3] && 4 + 4 * k + 4 <= n; k++) {
+			const uint32_t h = pr_handle(p + 4 + 4 * k), c = (uint32_t)(p[6 + 4 * k] | p[7 + 4 * k] << 8);
+
+			PR->done_all += c;
+			if (PR->le_handle != 0 && h == PR->le_handle - 1) {
+				PR->le_done += c;
+			}
+		}
+		break;
+	case 0x1a:
+		if (PR->lediag && n >= 4) {
+			pr_say("< Data_Buffer_Overflow link type %u\n", p[3]);
+		}
+		break;
+	case 0x0e:
+		if (n >= 7) {
+			op = (uint16_t)(p[4] | p[5] << 8);
+			if (PR->lediag && p[6] == 0 && ((op == 0x1005 && n >= 14) || (op == 0x2002 && n >= 10) || (op == 0x2060 && n >= 13))) {
+				if (op == 0x1005) {
+					PR->buf_acl = (uint32_t)(p[10] | p[11] << 8);
+				} else {
+					PR->buf_le = p[9];
+				}
+				pr_say("< cc %04x: %s buffers %u of %u B\n", op, op == 0x1005 ? "ACL" : "LE ACL", op == 0x1005 ?
+				    PR->buf_acl : PR->buf_le, (uint32_t)(p[7] | p[8] << 8));
+			}
+			if (pr_op(op) || op == 0x0c01 || op == 0x0c63 || op == 0x2001) {
+				pr_say("< cc %04x st %#x\n", op, p[6]);
+			}
+		}
+		break;
+	case 0x0f:
+		if (n >= 7) {
+			op = (uint16_t)(p[5] | p[6] << 8);
+			if (pr_op(op)) {
+				pr_say("< cs %04x st %#x\n", op, p[3]);
+			}
+		}
+		break;
+	case 0x3e:
+		if ((p[3] == 0x01 || p[3] == 0x0a || p[3] == 0x29) && n >= 8) {
+			/* gains2: v1, enhanced and enhanced v2 alike: status, handle, role, then (addresses not shown) the interval,
+			 * latency and supervision timeout; the enhanced forms carry two more addresses before them */
+			const uint32_t at = p[3] == 0x01 ? 15 : 27;
+
+			if (p[4] == 0) {
+				PR->le_handle = pr_handle(p + 5) + 1;
+			}
+			if (PR->lediag && n >= at + 6) {
+				pr_say("< LE_%sConnection_Complete%s st %#x handle %#x role %u interval %u latency %u timeout %u\n",
+				    p[3] == 0x01 ? "" : "Enhanced_", p[3] == 0x29 ? "_v2" : "", p[4], pr_handle(p + 5), p[7],
+				    (uint32_t)(p[at] | p[at + 1] << 8), (uint32_t)(p[at + 2] | p[at + 3] << 8),
+				    (uint32_t)(p[at + 4] | p[at + 5] << 8));
+			} else {
+				pr_say("< LE_%sConnection_Complete st %#x handle %#x role %u\n", p[3] == 0x01 ? "" : "Enhanced_", p[4],
+				    pr_handle(p + 5), p[7]);
+			}
+		} else if (PR->lediag && p[3] == 0x03 && n >= 13) {
+			pr_say("< LE_Connection_Update_Complete st %#x handle %#x interval %u latency %u timeout %u\n", p[4],
+			    pr_handle(p + 5), (uint32_t)(p[7] | p[8] << 8), (uint32_t)(p[9] | p[10] << 8), (uint32_t)(p[11] | p[12] << 8));
+		} else if (PR->lediag && p[3] == 0x04 && n >= 15) {
+			pr_say("< LE_Read_Remote_Features_Complete st %#x handle %#x features %#018llx\n", p[4], pr_handle(p + 5),
+			    pr_le64(p + 7));
+		} else if (PR->lediag && p[3] == 0x06 && n >= 14) {
+			pr_say("< LE_Remote_Connection_Parameter_Request handle %#x interval %u-%u latency %u timeout %u\n",
+			    pr_handle(p + 4), (uint32_t)(p[6] | p[7] << 8), (uint32_t)(p[8] | p[9] << 8), (uint32_t)(p[10] | p[11] << 8),
+			    (uint32_t)(p[12] | p[13] << 8));
+		} else if (PR->lediag && p[3] == 0x07 && n >= 14) {
+			pr_say("< LE_Data_Length_Change handle %#x tx %u B %u us, rx %u B %u us\n", pr_handle(p + 4),
+			    (uint32_t)(p[6] | p[7] << 8), (uint32_t)(p[8] | p[9] << 8), (uint32_t)(p[10] | p[11] << 8),
+			    (uint32_t)(p[12] | p[13] << 8));
+		} else if (PR->lediag && p[3] == 0x0c && n >= 9) {
+			pr_say("< LE_PHY_Update_Complete st %#x handle %#x tx %u rx %u\n", p[4], pr_handle(p + 5), p[7], p[8]);
+		} else if (PR->lediag && p[3] == 0x14 && n >= 7) {
+			pr_say("< LE_Channel_Selection_Algorithm handle %#x algorithm %u\n", pr_handle(p + 4), p[6]);
+		} else if (n >= 7 && p[3] == 0x05) {
+			pr_say("< LE_Long_Term_Key_Request handle %#x (EDIV / Rand not shown)\n", pr_handle(p + 4));
+		} else if (n >= 5 && (p[3] == 0x08 || p[3] == 0x09)) {
+			pr_say("< LE_%s_Complete st %#x\n", p[3] == 0x08 ? "Read_Local_P-256_Public_Key" : "Generate_DHKey", p[4]);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+/* H4 ACL: handle + flags (2), length (2); the first fragment's L2CAP header: length (2), CID (2); then the SMP code */
+static void
+pr_acl(bool in, const uint8_t *p, uint32_t n)
+{
+	uint32_t hf = (uint32_t)(p[1] | p[2] << 8), cid;
+	const char *d = in ? "<" : ">";
+
+	if (PR->lediag && PR->le_handle != 0 && (hf & 0xfff) == PR->le_handle - 1) {
+		if (in) {
+			PR->le_in++;
+		} else {
+			PR->le_out++;
+		}
+	}
+	if (n < 10 || ((hf >> 12) & 3) == 1) {
+		return;
+	}
+	cid = (uint32_t)(p[7] | p[8] << 8);
+	if (PR->lediag && cid == 4) {
+		/* gains2: ATT by opcode and length; the MTU and an error response's request / handle / code; never a value */
+		if (in) {
+			PR->att_in++;
+		} else {
+			PR->att_out++;
+		}
+		if (PR->att_lines < 48) {
+			PR->att_lines++;
+			if ((p[9] == 0x02 || p[9] == 0x03) && n >= 12) {
+				pr_say("%s ATT %s handle %#x mtu %u\n", d, p[9] == 0x02 ? "Exchange_MTU_Request" : "Exchange_MTU_Response",
+				    hf & 0xfff, (uint32_t)(p[10] | p[11] << 8));
+			} else if (p[9] == 0x01 && n >= 14) {
+				pr_say("%s ATT Error_Response handle %#x request %#x attribute %#x error %#x\n", d, hf & 0xfff, p[10],
+				    (uint32_t)(p[11] | p[12] << 8), p[13]);
+			} else {
+				pr_say("%s ATT opcode %#x handle %#x n %u\n", d, p[9], hf & 0xfff, n);
+			}
+		}
+		return;
+	}
+	if (PR->lediag && cid == 5 && n >= 13) {
+		/* gains2: LE signalling: connection parameter update request / response, command reject */
+		PR->sig++;
+		if (p[9] == 0x12 && n >= 21) {
+			pr_say("%s L2CAP Connection_Parameter_Update_Request id %u handle %#x interval %u-%u latency %u timeout %u\n",
+			    d, p[10], hf & 0xfff, (uint32_t)(p[13] | p[14] << 8), (uint32_t)(p[15] | p[16] << 8),
+			    (uint32_t)(p[17] | p[18] << 8), (uint32_t)(p[19] | p[20] << 8));
+		} else if ((p[9] == 0x13 || p[9] == 0x01) && n >= 15) {
+			pr_say("%s L2CAP %s id %u handle %#x %s %#x\n", d, p[9] == 0x13 ? "Connection_Parameter_Update_Response" :
+			    "Command_Reject", p[10], hf & 0xfff, p[9] == 0x13 ? "result" : "reason", (uint32_t)(p[13] | p[14] << 8));
+		} else {
+			pr_say("%s L2CAP signalling code %#x id %u handle %#x n %u\n", d, p[9], p[10], hf & 0xfff, n);
+		}
+		return;
+	}
+	if (cid != 6 && cid != 7) {
+		return;
+	}
+	if (in) {
+		PR->smp_in++;
+	} else {
+		PR->smp_out++;
+	}
+	if ((p[9] == 0x01 || p[9] == 0x02) && n >= 16) {
+		pr_say("%s SMP %s (cid %u) handle %#x: io %u oob %u auth %#x key size %u keys %#x / %#x\n", d,
+		    p[9] == 0x01 ? "Pairing_Request" : "Pairing_Response", cid, hf & 0xfff, p[10], p[11], p[12], p[13], p[14], p[15]);
+	} else if (p[9] == 0x05 && n >= 11) {
+		PR->smpfail++;
+		pr_say("%s SMP Pairing_Failed (cid %u) handle %#x reason %#x\n", d, cid, hf & 0xfff, p[10]);
+	} else if (p[9] == 0x0b && n >= 11) {
+		pr_say("%s SMP Security_Request (cid %u) handle %#x auth %#x\n", d, cid, hf & 0xfff, p[10]);
+	} else {
+		pr_say("%s SMP code %#x (cid %u) handle %#x n %u (contents not shown)\n", d, p[9], cid, hf & 0xfff, n);
+	}
+}
+
+static struct sv_op *
+op_slot(uint16_t op)
+{
+	for (uint32_t i = 0; i < ops_n; i++) {
+		if (ops[i].op == op) {
+			return &ops[i];
+		}
+	}
+	if (ops_n >= OPS_N) {
+		return NULL;
+	}
+	ops[ops_n].op = op;
+	ops[ops_n].n = 0;
+	ops[ops_n].st = 0xff;
+	ops[ops_n].how = 0;
+	return &ops[ops_n++];
+}
+
+/* true: the parameters of this command and of its answer hold no address, key, name or advertising data */
+static bool
+op_public(uint16_t op)
+{
+	static const uint16_t le[] = { 0x2001, 0x2002, 0x2003, 0x2007, 0x200a, 0x200b, 0x200c, 0x200f, 0x2010, 0x201c, 0x2022,
+		                       0x2023, 0x2024, 0x2029, 0x202a, 0x202d, 0x202e, 0x202f, 0x2030, 0x2031, 0x2032, 0x2039, 0x203a,
+		                       0x203b, 0x203d, 0x2041, 0x2042, 0x2049, 0x204a, 0x204b, 0x204c, 0x204d, 0x2060, 0x2063, 0x2074 };
+	uint16_t ogf = op >> 10;
+
+	if (ogf == 0x3f) {
+		return op != 0xfc01;                    /* Broadcom's Write_BD_ADDR */
+	}
+	if (ogf == 3) {
+		return op != 0x0c05 && op != 0x0c13 && op != 0x0c14 && op != 0x0c51 && op != 0x0c52 && op != 0x0c0d && op != 0x0c11 &&
+		       op != 0x0c12;
+	}
+	if (ogf == 4) {
+		return op != 0x1009;
+	}
+	if (ogf == 8) {
+		for (unsigned i = 0; i < sizeof(le) / sizeof(le[0]); i++) {
+			if (le[i] == op) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static void
+tr(const char *what, uint16_t op, int st, const uint8_t *p, uint32_t n, const char *note)
+{
+	char hex[28 * 3 + 1];
+
+	if (tr_level == 0 || tr_lines >= tr_max) {
+		return;
+	}
+	hex[0] = 0;
+	if (tr_level >= 2 && p != NULL && n != 0 && op_public(op)) {
+		hexs(hex, p, (int)n, 28);
+	}
+	if (++tr_lines == tr_max) {
+		say("hci: %u trace lines: from here counts only (icebt_trace_max)\n", tr_max);
+	}
+	if (st >= 0) {
+		say("hci %s %04x st %#x n %u [%s]%s\n", what, op, st, n, hex, note);
+	} else {
+		say("hci %s %04x n %u [%s]%s\n", what, op, n, hex, note);
+	}
+}
+
+/* ---- the node's two FIFOs (sv_lock held) ---- */
+static void
+fifo_put(uint8_t *f, uint32_t head, uint32_t *len, const uint8_t *d, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		f[(head + *len + i) % TTY_FIFO] = d[i];
+	}
+	*len += n;
+}
+
+static void
+fifo_get(const uint8_t *f, uint32_t *head, uint32_t *len, uint8_t *d, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		d[i] = f[(*head + i) % TTY_FIFO];
+	}
+	*head = (*head + n) % TTY_FIFO;
+	*len -= n;
+}
+
+static void
+wake_readers(void)
+{
+	wakeup(&sv.rx_len);
+	if (sv.rsel_used) {
+		sv.rsel_used = false;
+		selwakeup(&sv.rsel);
+	}
+}
+
+static void
+wake_writers(void)
+{
+	wakeup(&sv.tx_len);
+	if (sv.wsel_used) {
+		sv.wsel_used = false;
+		selwakeup(&sv.wsel);
+	}
+}
+
+/* one whole H4 packet to the client; dropped when nobody has the node open or it does not read */
+static void
+host_emit(const uint8_t *p, uint32_t n)
+{
+	lck_mtx_lock(&sv_lock);
+	if (!sv.open || n > TTY_FIFO - sv.rx_len) {
+		sd.dropped++;
+		if (ops != NULL) {
+			RX->drop[p[0] >= 2 && p[0] <= 5 ? p[0] : 0]++;  /* bt3: by H4 type */
+		}
+	} else {
+		fifo_put(sv.rx, sv.rx_head, &sv.rx_len, p, n);
+		wake_readers();
+	}
+	lck_mtx_unlock(&sv_lock);
+}
+
+/* ---- LE security first (bt2, icebt_lesec): the pump thread only ---- */
+static uint32_t
+ls_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return (uint32_t)(ns / 1000000ull);
+}
+
+/* the link's slot; fresh: a new connection's (cleared), else the known one or NULL */
+static struct ls_link *
+ls_link(uint32_t h, bool fresh)
+{
+	struct ls_link *f = NULL;
+
+	for (uint32_t i = 0; i < LS_N; i++) {
+		if (LS->l[i].h1 == h + 1) {
+			f = &LS->l[i];
+			break;
+		}
+		if (fresh && f == NULL && LS->l[i].h1 == 0) {
+			f = &LS->l[i];
+		}
+	}
+	if (fresh && f != NULL) {
+		memset(f, 0, sizeof(*f));
+		f->h1 = h + 1;
+	}
+	return f;
+}
+
+/* H4 ACL from the host: an ATT request on CID 4 opens the link's request */
+static void
+ls_out(const uint8_t *p, uint32_t n)
+{
+	const uint32_t hf = (uint32_t)(p[1] | p[2] << 8);
+	struct ls_link *k;
+
+	if (n < 10 || ((hf >> 12) & 3) == 1 || (uint32_t)(p[7] | p[8] << 8) != 4 || p[9] > 0x20 || !((LS_REQ >> p[9]) & 1)) {
+		return;
+	}
+	if ((k = ls_link(hf & 0xfff, false)) == NULL) {
+		return;
+	}
+	k->req = p[9] + 1u;
+	k->att_h = p[9] == 0x02 || p[9] == 0x18 || n < 12 ? 0 : (uint32_t)(p[10] | p[11] << 8);
+	k->t = ls_ms();
+}
+
+/* H4 ACL from the controller; true: drop it (the late answer to a request already answered from here) */
+static bool
+ls_in(const uint8_t *p, uint32_t n)
+{
+	const uint32_t hf = (uint32_t)(p[1] | p[2] << 8);
+	struct ls_link *k = ls_link(hf & 0xfff, false);
+	uint32_t op, to;
+
+	if (k == NULL) {
+		return false;
+	}
+	k->in++;
+	if (n < 10 || ((hf >> 12) & 3) == 1 || (uint32_t)(p[7] | p[8] << 8) != 4 || p[9] > 0x21 || !((LS_RSP >> p[9]) & 1)) {
+		return false;
+	}
+	op = p[9];
+	if (op == 0x01 && n < 11) {
+		return false;
+	}
+	to = op == 0x01 ? p[10] : op - 1u;              /* the request this response answers */
+	if (k->req == to + 1) {
+		k->req = 0;                             /* the answer to the host's open request: passed on */
+		return false;
+	}
+	if (k->late == to + 1 && (uint32_t)(p[5] | p[6] << 8) + 4 == (uint32_t)(p[3] | p[4] << 8)) {
+		k->late = 0;
+		LS->dropped++;
+		say("lesec: handle %#x: a late ATT response %#x to the refused request %#x dropped (the host had its answer)\n",
+		    hf & 0xfff, op, to);
+		return true;
+	}
+	return false;
+}
+
+/* H4 events: a new LE link where this side is the central, its encryption, its end (a reset: sv's caller clears all) */
+static void
+ls_evt(const uint8_t *p, uint32_t n)
+{
+	struct ls_link *k;
+
+	if (p[1] == 0x3e && n >= 8 && (p[3] == 0x01 || p[3] == 0x0a || p[3] == 0x29) && p[4] == 0 && p[7] == 0) {
+		if (ls_link(pr_handle(p + 5), true) == NULL) {
+			say("lesec: handle %#x: no free slot (%u links), not watched\n", pr_handle(p + 5), LS_N);
+		}
+	} else if (p[1] == 0x3e && n >= 8 && (p[3] == 0x01 || p[3] == 0x0a || p[3] == 0x29) && p[4] == 0 &&
+	    (k = ls_link(pr_handle(p + 5), false)) != NULL) {
+		k->h1 = 0;                              /* the handle now carries a link where this side is the peripheral */
+	} else if ((p[1] == 0x08 || p[1] == 0x59) && n >= 7 && p[3] == 0 && (k = ls_link(pr_handle(p + 4), false)) != NULL) {
+		k->enc = p[6] != 0;
+		if (k->done) {
+			say("lesec: handle %#x: encryption %s after the refusal\n", k->h1 - 1, p[6] ? "on" : "off");
+		}
+	} else if (p[1] == 0x05 && n >= 7 && p[3] == 0 && (k = ls_link(pr_handle(p + 4), false)) != NULL) {
+		if (k->done) {
+			say("lesec: handle %#x: link ended (reason %#x), ACL in %u, encrypted %u\n", k->h1 - 1, p[6], k->in, k->enc);
+		}
+		k->h1 = 0;
+	}
+}
+
+/* each pump turn: a silent, unencrypted link whose request waited wait_ms gets one Error Response from here */
+static void
+ls_tick(void)
+{
+	uint32_t t = 0;
+
+	for (uint32_t i = 0; i < LS_N; i++) {
+		struct ls_link *k = &LS->l[i];
+		uint8_t e[14];
+		uint32_t h;
+
+		if (k->h1 == 0 || k->req == 0 || k->enc || k->in != 0 || k->done) {
+			continue;
+		}
+		if (t == 0) {
+			t = ls_ms() | 1;
+		}
+		if (t - k->t < LS->wait_ms) {
+			continue;
+		}
+		/* H4 ACL, handle with PB 10 (first, flushable); L2CAP length 5, CID 4; ATT Error Response: request, handle, code */
+		h = k->h1 - 1;
+		e[0] = 0x02;
+		e[1] = (uint8_t)h;
+		e[2] = (uint8_t)(0x20 | (h >> 8));
+		e[3] = 9;
+		e[4] = 0;
+		e[5] = 5;
+		e[6] = 0;
+		e[7] = 4;
+		e[8] = 0;
+		e[9] = 0x01;
+		e[10] = (uint8_t)(k->req - 1);
+		e[11] = (uint8_t)k->att_h;
+		e[12] = (uint8_t)(k->att_h >> 8);
+		e[13] = (uint8_t)LS->err;
+		k->done = 1;
+		k->late = k->req;
+		k->req = 0;
+		LS->injected++;
+		say("lesec: handle %#x: ATT request %#x unanswered for %u ms on an unencrypted link that brought no data in: "
+		    "Error_Response code %#x for it handed to the host (not to the chip), so the host pairs first and sends it again\n",
+		    h, e[10], t - k->t, LS->err);
+		host_emit(e, sizeof(e));
+	}
+}
+
+/* ---- LE ACL packet boundary (bt2 run 2, icebt_lepb / icebt_lefix): the pump thread only ---- */
+static uint32_t *
+lp_slot(uint32_t h)
+{
+	for (uint32_t i = 0; i < LP_N; i++) {
+		if (LP->h1[i] == h + 1) {
+			return &LP->h1[i];
+		}
+	}
+	return NULL;
+}
+
+/* events: an LE connection (either role) adds its handle; a disconnection or a BR/EDR connection on it removes it */
+static void
+lp_evt(const uint8_t *p, uint32_t n)
+{
+	uint32_t *s;
+
+	if (p[1] == 0x3e && n >= 8 && (p[3] == 0x01 || p[3] == 0x0a || p[3] == 0x29) && p[4] == 0) {
+		if (lp_slot(pr_handle(p + 5)) == NULL && (s = lp_slot(0xffffffffu)) != NULL) {
+			*s = pr_handle(p + 5) + 1;      /* lp_slot(-1) finds a free (0) slot */
+			LP->out[s - LP->h1] = LP->done[s - LP->h1] = LP->in[s - LP->h1] = 0;
+		}
+	} else if (p[1] == 0x13 && n >= 4) {
+		/* bt2c: Number Of Completed Packets per LE link (does the chip finish every host frame, or stop after the first?) */
+		for (uint32_t k = 0; k < p[3] && 4 + 4 * k + 4 <= n; k++) {
+			if ((s = lp_slot(pr_handle(p + 4 + 4 * k))) != NULL) {
+				LP->done[s - LP->h1] += (uint32_t)(p[6 + 4 * k] | p[7 + 4 * k] << 8);
+			}
+		}
+	} else if (((p[1] == 0x05 && n >= 7) || (p[1] == 0x03 && n >= 7)) && p[3] == 0 && (s = lp_slot(pr_handle(p + 4))) != NULL) {
+		if (p[1] == 0x05) {
+			say("le: handle %#x ended (reason %#x): ACL from the host %u, completed by the chip %u, ACL to the host %u\n",
+			    *s - 1, p[6], LP->out[s - LP->h1], LP->done[s - LP->h1], LP->in[s - LP->h1]);
+		}
+		*s = 0;
+	}
+}
+
+/* bt2c: ACL from the controller on an LE link: counted for the link's end line */
+static void
+lp_in(const uint8_t *p, uint32_t n)
+{
+	uint32_t *s;
+
+	if (n >= 5 && (s = lp_slot((uint32_t)(p[1] | p[2] << 8) & 0xfff)) != NULL) {
+		LP->in[s - LP->h1]++;
+	}
+}
+
+/* ACL from the host: on an LE handle a start with PB 0b10 / 0b11 goes out as 0b00 */
+static void
+lp_out(uint8_t *p, uint32_t n)
+{
+	const uint32_t hf = (uint32_t)(p[1] | p[2] << 8), pb = (hf >> 12) & 3;
+	uint32_t *s;
+
+	if (n < 5 || (s = lp_slot(hf & 0xfff)) == NULL) {
+		return;
+	}
+	LP->out[s - LP->h1]++;
+	LP->pbn[pb]++;
+	if (LP->pb == 0 || (pb != 2 && pb != 3)) {
+		return;
+	}
+	p[2] &= 0xcf;
+	LP->rewritten++;
+	if (LP->shown < 6) {
+		LP->shown++;
+		say("lepb: handle %#x: LE ACL from the host with PB %u%u sent to the chip as PB 00 (start, non-flushable: LE's "
+		    "only start), %u B\n", hf & 0xfff, pb >> 1, pb & 1, n);
+	}
+}
+
+/* commands from the host: the five set-up commands BlueZ differs on are logged as sent; true: answer here (icebt_lefix) */
+static bool
+lp_cmd(uint8_t *p, uint32_t n, uint16_t op)
+{
+	char hex[16 * 3 + 1];
+	bool here = false;
+
+	if (LP->pb == 0 && LP->fix == 0) {
+		return false;                   /* laneD: the kit off: install65's path, no lines */
+	}
+	/* bt2c: LE Create Connection (legacy / extended): the own address type only (public 0, random 1, RPA 2 / 3), never an
+	 * address; it says whether the chip's public address (the firmware default here) is what the peer sees */
+	if ((op == 0x200d && n >= 4 + 13) || (op == 0x2043 && n >= 4 + 3)) {
+		if (LP->logged < 24) {
+			LP->logged++;
+			say("le: > %04x own address type %u\n", op, op == 0x200d ? p[4 + 12] : p[4 + 1]);
+		}
+		return false;
+	}
+	if (op != 0x0c31 && op != 0x0c33 && op != 0x0c6d && op != 0x2074 && op != 0x207d) {
+		return false;
+	}
+	if ((LP->fix & 1) && (op == 0x207d || (op == 0x2074 && n >= 6 && p[4] == 38))) {
+		here = true;
+	} else if ((LP->fix & 2) && (op == 0x0c31 || op == 0x0c33)) {
+		here = true;
+	} else if ((LP->fix & 4) && op == 0x0c6d && n >= 6) {
+		p[5] = 0;
+	}
+	if (LP->logged < 24) {
+		LP->logged++;
+		hex[0] = 0;
+		hexs(hex, p + 4, (int)(n - 4), 16);
+		say("le: > %04x [%s]%s\n", op, hex, here ? " answered here, not sent (icebt_lefix)" : (LP->fix & 4) && op == 0x0c6d ?
+		    " (Simultaneous 0: icebt_lefix)" : "");
+	}
+	return here;
+}
+
+/* ---- the inbound accounting (bt3, icebt_rxlog / icebt_iso2acl): the pump thread only ---- */
+static uint32_t
+rx_ix(uint8_t t)
+{
+	return t >= 2 && t <= 5 ? t : 0;
+}
+
+/* the handle's row (made for a new handle while there is room), or NULL */
+static struct rx_h *
+rx_row(uint32_t h, bool make)
+{
+	for (uint32_t i = 0; i < RX_H; i++) {
+		if (RX->h[i].h1 == h + 1) {
+			return &RX->h[i];
+		}
+	}
+	for (uint32_t i = 0; make && i < RX_H; i++) {
+		if (RX->h[i].h1 == 0) {
+			RX->h[i].h1 = h + 1;
+			return &RX->h[i];
+		}
+	}
+	return NULL;
+}
+
+/* an LE link's frames on their way; fresh: a new connection's (cleared) */
+static struct rx_l *
+rx_link(uint32_t h, bool fresh)
+{
+	struct rx_l *f = NULL;
+
+	for (uint32_t i = 0; i < RX_L; i++) {
+		if (RX->l[i].h1 == h + 1) {
+			f = &RX->l[i];
+			break;
+		}
+		if (fresh && f == NULL && RX->l[i].h1 == 0) {
+			f = &RX->l[i];
+		}
+	}
+	if (fresh && f != NULL) {
+		memset(f, 0, sizeof(*f));
+		f->h1 = h + 1;
+	}
+	return f;
+}
+
+static bool
+rx_any_le(void)
+{
+	for (uint32_t i = 0; i < LP_N; i++) {
+		if (LP->h1[i] != 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* one line for an ACL / ISO / SCO packet: type, handle, flags, length; a first fragment's CID and first opcode byte */
+static void
+rx_line(char d, const uint8_t *p, uint32_t n)
+{
+	uint32_t hf = (uint32_t)(p[1] | p[2] << 8), pb = (hf >> 12) & 3;
+	bool l2 = p[0] != 0x03 && n >= 10 && pb != 1 && p[8] == 0 && p[7] <= 7;  /* fixed channels only: their codes */
+
+	if (RX->on == 0 || RX->lines >= RX->max) {
+		return;
+	}
+	RX->lines++;
+	say("rx: %c %s h %#x pb %u bc %u n %u cid %#x op %#x\n", d, p[0] == 0x02 ? "acl" : p[0] == 0x05 ? "iso" : "sco",
+	    hf & 0xfff, pb, hf >> 14, n, l2 ? (uint32_t)(p[7] | p[8] << 8) : 0, l2 ? p[9] : 0);
+}
+
+/* an event's connection handle where it has one (0xfff: none) */
+static uint32_t
+rx_ev_handle(const uint8_t *p, uint32_t n)
+{
+	if (p[1] == 0x03 || p[1] == 0x05 || p[1] == 0x08 || p[1] == 0x0c || p[1] == 0x13 || p[1] == 0x30 || p[1] == 0x59) {
+		return n >= 6 ? pr_handle(p + 4) : 0xfff;       /* (status or count), handle */
+	}
+	if (p[1] == 0x3e && n >= 6 && (p[3] == 0x05 || p[3] == 0x06 || p[3] == 0x07 || p[3] == 0x14)) {
+		return pr_handle(p + 4);                        /* subevent, handle */
+	}
+	if (p[1] == 0x3e && n >= 7 && (p[3] == 0x01 || p[3] == 0x0a || p[3] == 0x29 || p[3] == 0x03 || p[3] == 0x04 ||
+	    p[3] == 0x0c)) {
+		return pr_handle(p + 5);                        /* subevent, status, handle */
+	}
+	return 0xfff;
+}
+
+/* the totals: in each summary and at every LE link's end */
+static void
+rx_summary(void)
+{
+	char s[8 * 3 + 4] = "", t[RX_H * 40 + 1] = "";
+	int at = 0;
+
+	for (uint32_t i = 0; i < RX->stray_n && i < 8; i++) {
+		at += scnprintf(s + at, sizeof(s) - (size_t)at, "%s%02x", i ? " " : " [", RX->stray[i]);
+	}
+	if (at != 0) {
+		strlcat(s, "]", sizeof(s));
+	}
+	say("rx: bytes %llu; ev %u acl %u sco %u iso %u other %u; strays %u%s; to nobody ev %u acl %u other %u; soc log %u; "
+	    "iso as acl %u; uart %#x; lines %u/%u\n", (unsigned long long)RX->bytes, RX->pkt[4], RX->pkt[2], RX->pkt[3], RX->pkt[5],
+	    RX->pkt[0], sd.stray, s, RX->drop[4], RX->drop[2], RX->drop[0] + RX->drop[3] + RX->drop[5], RX->dbg, RX->retyped,
+	    RX->uerr, RX->lines, RX->max);
+	at = 0;
+	for (uint32_t i = 0; i < RX_H; i++) {
+		if (RX->h[i].h1 != 0) {
+			at += scnprintf(t + at, sizeof(t) - (size_t)at, " %x%c a%u i%u s%u pb%x bc%x", RX->h[i].h1 - 1,
+			    "?LB"[RX->h[i].kind % 3], RX->h[i].acl, RX->h[i].iso, RX->h[i].sco, RX->h[i].pbm, RX->h[i].bcm);
+		}
+	}
+	say("rx: in by handle:%s\n", at ? t : " none");
+}
+
+/* every packet from the controller, before the rest of c2h_packet; may turn an ISO packet on an LE ACL link into ACL */
+static void
+rx_in(uint8_t *p, uint32_t n)
+{
+	uint32_t h = n >= 3 ? (uint32_t)(p[1] | p[2] << 8) & 0xfff : 0xfff;
+	bool win = rx_any_le();
+	struct rx_h *r;
+	struct rx_l *l;
+
+	if (p[0] == 0x05 && n >= 5 && RX->iso2acl && lp_slot(h) != NULL) {
+		p[0] = 0x02;
+		if (RX->retyped++ < 4) {
+			say("rx: iso frame on LE link %#x passed on as ACL (icebt_iso2acl)\n", h);
+		}
+	}
+	RX->pkt[rx_ix(p[0])]++;
+	if (p[0] != 0x04) {
+		RX->dbg += h == 0xedc;                  /* the SoC's log frames (handle 0x2edc) */
+		if ((r = rx_row(h, true)) != NULL) {
+			r->acl += p[0] == 0x02;
+			r->iso += p[0] == 0x05;
+			r->sco += p[0] == 0x03;
+			r->pbm |= 1u << ((p[2] >> 4) & 3);
+			r->bcm |= 1u << (p[2] >> 6);
+		}
+		if (win) {
+			rx_line('<', p, n);
+		}
+		return;
+	}
+	if (n < 4) {
+		return;
+	}
+	if ((p[1] == 0x03 && n >= 7 && p[3] == 0) || (p[1] == 0x3e && n >= 8 && p[4] == 0 &&
+	    (p[3] == 0x01 || p[3] == 0x0a || p[3] == 0x29))) {
+		h = p[1] == 0x03 ? pr_handle(p + 4) : pr_handle(p + 5);
+		if ((r = rx_row(h, true)) != NULL) {
+			r->kind = p[1] == 0x03 ? 2 : 1;
+		}
+		if (p[1] == 0x3e) {
+			(void)rx_link(h, true);
+			win = true;
+		}
+	} else if (p[1] == 0x0e && n >= 7 && p[4] == 0x03 && p[5] == 0x0c && p[6] == 0) {
+		memset(RX->l, 0, sizeof(RX->l));        /* HCI_Reset: no link left */
+	}
+	if (p[1] == 0x13) {
+		/* Number Of Completed Packets: for an LE link, the milliseconds since the oldest completed frame went out */
+		for (uint32_t k = 0; k < p[3] && 4 + 4 * k + 4 <= n; k++) {
+			uint32_t c = (uint32_t)(p[6 + 4 * k] | p[7 + 4 * k] << 8), c0 = c, t = ls_ms(), ms = 0;
+
+			if ((l = rx_link(pr_handle(p + 4 + 4 * k), false)) == NULL) {
+				continue;
+			}
+			for (; c > 0 && l->qn > 0; c--) {
+				ms = t - l->q[0];
+				memmove(l->q, l->q + 1, sizeof(l->q[0]) * (--l->qn));
+				l->done++;
+				l->lo = l->done == 1 || ms < l->lo ? ms : l->lo;
+				l->hi = ms > l->hi ? ms : l->hi;
+			}
+			if (RX->on && RX->lines < RX->max) {
+				RX->lines++;
+				say("rx: < nocp h %#x k %u: %u ms after its frame\n", l->h1 - 1, c0, ms);
+			}
+		}
+		return;
+	}
+	if (win && RX->on && RX->lines < RX->max && !(p[1] == 0x3e && (p[3] == 0x02 || p[3] == 0x0d || p[3] == 0x0b))) {
+		RX->lines++;
+		say("rx: < ev %#x.%#x h %#x n %u\n", p[1], p[1] == 0x0e && n >= 6 ? (uint32_t)(p[4] | p[5] << 8) :
+		    p[1] == 0x0f && n >= 7 ? (uint32_t)(p[5] | p[6] << 8) : p[1] == 0x3e ? p[3] : 0, rx_ev_handle(p, n), n);
+	}
+	if (p[1] == 0x05 && n >= 7 && p[3] == 0 && (l = rx_link(pr_handle(p + 4), false)) != NULL) {
+		/* an LE link's end: its frames out, their completions and the milliseconds they took, then the totals */
+		r = rx_row(l->h1 - 1, false);
+		say("rx: le %#x ended: out %u completed %u (%u..%u ms), %u never; in acl %u iso %u\n", l->h1 - 1, l->sent, l->done,
+		    l->lo, l->hi, l->qn + l->lost, r ? r->acl : 0, r ? r->iso : 0);
+		l->h1 = 0;
+		rx_summary();
+	}
+}
+
+/* ACL from the host: on an LE link, its line and its send time for the completion's */
+static void
+rx_out(const uint8_t *p, uint32_t n)
+{
+	struct rx_l *l = rx_link((uint32_t)(p[1] | p[2] << 8) & 0xfff, false);
+
+	if (l == NULL) {
+		return;
+	}
+	l->sent++;
+	if (l->qn == 8) {
+		memmove(l->q, l->q + 1, sizeof(l->q[0]) * 7);
+		l->qn = 7;
+		l->lost++;
+	}
+	l->q[l->qn++] = ls_ms();
+	rx_line('>', p, n);
+}
+
+/* ---- the stand-in controller (QEMU only) ---- */
+static void
+sim_put(const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n && sim_in - sim_out < SIM_RING; i++) {
+		simr[sim_in++ % SIM_RING] = p[i];
+	}
+}
+
+static void
+sim_cc(uint16_t op, const uint8_t *ret, uint32_t n)
+{
+	uint8_t e[7] = { 0x04, 0x0e, (uint8_t)(4 + n), 0x01, (uint8_t)op, (uint8_t)(op >> 8), 0x00 };
+
+	sim_put(e, 7);
+	sim_put(ret, n);
+}
+
+static void
+sim_cmd(const uint8_t *p, uint32_t n)
+{
+	static const uint8_t ver[] = { 0x0c, 0x00, 0x00, 0x0c, 0x1d, 0x00, 0x00, 0x00 };
+	static const uint8_t feat[] = { 0xff, 0xfe, 0x8f, 0xfe, 0xd8, 0x3f, 0x5b, 0x87 };
+	static const uint8_t bufsz[] = { 0xfd, 0x03, 0x3c, 0x08, 0x00, 0x08, 0x00 };
+	static const uint8_t addr[] = { 0x4d, 0x51, 0x00, 0x00, 0x00, 0x02 };
+	static const uint8_t lebuf[] = { 0xfb, 0x00, 0x08 };
+	static const uint8_t lefeat[] = { 0xff, 0x79, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00 };
+	static const uint8_t maxdl[] = { 0xfb, 0x00, 0x48, 0x08, 0xfb, 0x00, 0x48, 0x08 };
+	static const uint8_t iac[] = { 0x01, 0x33, 0x8b, 0x9e };
+	uint8_t z[72];
+	uint16_t op;
+
+	if (n < 4 || p[0] != 0x01) {
+		return;                                 /* data to a link that does not exist: gone */
+	}
+	op = (uint16_t)(p[1] | p[2] << 8);
+	memset(z, 0, sizeof(z));
+	if ((op >> 10) == 1 && op != 0x0402 && op != 0x0408 && op != 0x040b && op != 0x040c && op != 0x040d && op != 0x040e) {
+		uint8_t e[7] = { 0x04, 0x0f, 0x04, 0x00, 0x01, (uint8_t)op, (uint8_t)(op >> 8) };
+
+		sim_put(e, 7);                          /* link control: Command Status, and nothing follows */
+		return;
+	}
+	switch (op) {
+	case 0x0c03:
+		sim_scan = false;
+		sim_cc(op, NULL, 0);
+		break;
+	case 0x1001:
+		sim_cc(op, ver, sizeof(ver));
+		break;
+	case 0x1002:
+		memset(z, 0xff, 40);
+		z[18] &= (uint8_t)~0x0c;                /* as the chip family: no Default Erroneous Data Reporting */
+		sim_cc(op, z, 64);
+		break;
+	case 0x1003:
+		sim_cc(op, feat, sizeof(feat));
+		break;
+	case 0x1004:
+		z[0] = n > 4 ? p[4] : 0;
+		z[1] = 2;
+		if (z[0] == 0) {
+			memcpy(z + 2, feat, 8);
+		} else if (z[0] == 1) {
+			z[2] = 0x0f;
+		}
+		sim_cc(op, z, 10);
+		break;
+	case 0x1005:
+		sim_cc(op, bufsz, sizeof(bufsz));
+		break;
+	case 0x1009:
+		if (B4->sim_addr[0] != 0) {             /* bt4: the address 0xfc14 set, least significant byte first */
+			for (int i = 0; i < 6; i++) {
+				z[i] = B4->sim_addr[5 - i];
+			}
+			sim_cc(op, z, 6);
+			break;
+		}
+		sim_cc(op, addr, sizeof(addr));
+		break;
+	case 0xfc14:                                    /* bt4: QCA EDL write BD address, most significant byte first */
+		if (n >= 10) {
+			memcpy(B4->sim_addr, p + 4, 6);
+		}
+		sim_cc(op, NULL, 0);
+		break;
+	case 0x100b:
+		sim_cc(op, z, 2);
+		break;
+	case 0x2002:
+		sim_cc(op, lebuf, sizeof(lebuf));
+		break;
+	case 0x2003:
+		sim_cc(op, lefeat, sizeof(lefeat));
+		break;
+	case 0x2018:
+	case 0x201c:
+		z[0] = 0xff;
+		z[1] = 0xff;
+		z[2] = 0xff;
+		z[3] = 0xff;
+		z[4] = 0xff;
+		z[5] = 0x03;
+		sim_cc(op, z, 8);
+		break;
+	case 0x202f:
+		sim_cc(op, maxdl, sizeof(maxdl));
+		break;
+	case 0x2023:
+		sim_cc(op, maxdl, 4);
+		break;
+	case 0x0c38:
+	case 0x0c39:
+		sim_cc(op, iac, sizeof(iac));
+		break;
+	case 0x0c14:
+		if (SIM_RING - (sim_in - sim_out) < 300) {
+			break;
+		}
+		sim_cc(op, z, 60);
+		sim_put(z, 60);
+		sim_put(z, 60);
+		sim_put(z, 68);                         /* 248 bytes of name: the event's length byte is patched below */
+		simr[(sim_in - 248 - 5) % SIM_RING] = (uint8_t)(4 + 248);
+		break;
+	case 0x0c1b:
+	case 0x0c1d:
+		z[0] = 0x00;
+		z[1] = 0x08;
+		z[2] = 0x12;
+		sim_cc(op, z, 4);
+		break;
+	case 0x0c23:
+		sim_cc(op, z, 3);
+		break;
+	case 0x0c25:
+	case 0x0c6c:
+	case 0x204a:
+	case 0x0c61:
+		sim_cc(op, z, 2);
+		break;
+	case 0x200c:
+		sim_scan = n > 4 && p[4] != 0;
+		sim_ext = false;
+		sim_cc(op, NULL, 0);
+		break;
+	case 0x2042:
+		sim_scan = n > 4 && p[4] != 0;
+		sim_ext = true;
+		sim_cc(op, NULL, 0);
+		break;
+	case 0x0c5a:
+	case 0x0c5b: {
+		uint8_t e[7] = { 0x04, 0x0e, 0x04, 0x01, (uint8_t)op, (uint8_t)(op >> 8), 0x01 };
+
+		sim_put(e, 7);                          /* refused, as the chip family does */
+		break;
+	}
+	case 0x080f:                                    /* w5-bt: Write_Default_Link_Policy_Settings, status only, as the chip */
+	case 0x0c01:
+	case 0x0c05:
+	case 0x0c13:
+	case 0x0c18:
+	case 0x0c1a:
+	case 0x0c1c:
+	case 0x0c1e:
+	case 0x0c24:
+	case 0x0c26:
+	case 0x0c31:
+	case 0x0c33:
+	case 0x0c35:
+	case 0x0c3a:
+	case 0x0c43:
+	case 0x0c45:
+	case 0x0c47:
+	case 0x0c52:
+	case 0x0c56:
+	case 0x0c63:
+	case 0x0c6d:
+	case 0x0c7a:
+	case 0x2001:
+	case 0x2005:
+	case 0x2006:
+	case 0x2008:
+	case 0x2009:
+	case 0x200a:
+	case 0x200b:
+	case 0x2010:
+	case 0x2011:
+	case 0x2012:
+	case 0x2024:
+	case 0x2027:
+	case 0x2028:
+	case 0x202d:
+	case 0x202e:
+	case 0x2031:
+	case 0x2041:
+		if (op != 0x0c35) {
+			sim_cc(op, NULL, 0);
+		}
+		break;
+	default:
+		if ((op >> 10) == 8 || (op >> 10) == 3 || (op >> 10) == 4 || (op >> 10) == 5) {
+			sim_cc(op, z, 1);               /* a read this table does not know: one zero byte */
+		} else {
+			uint8_t e[7] = { 0x04, 0x0e, 0x04, 0x01, (uint8_t)op, (uint8_t)(op >> 8), 0x01 };
+
+			sim_put(e, 7);
+		}
+		break;
+	}
+}
+
+/* while a scan is on: one made-up advertiser a second (random static address, flags, the name "icebt-sim") */
+static void
+sim_tick(void)
+{
+	static const uint8_t legacy[] = { 0x04, 0x3e, 0x1a, 0x02, 0x01, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xc6, 0x0e,
+		                          0x02, 0x01, 0x06, 0x0a, 0x09, 'i', 'c', 'e', 'b', 't', '-', 's', 'i', 'm', 0xc4 };
+	static const uint8_t ext[] = { 0x04, 0x3e, 0x28, 0x0d, 0x01, 0x13, 0x00, 0x01, 0x11, 0x22, 0x33, 0x44, 0x55, 0xc6, 0x01,
+		                       0x00, 0xff, 0x7f, 0xc4, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x0e,
+		                       0x02, 0x01, 0x06, 0x0a, 0x09, 'i', 'c', 'e', 'b', 't', '-', 's', 'i', 'm' };
+	uint64_t now = mach_absolute_time(), iv;
+
+	if (!sim_scan || now < sim_next) {
+		return;
+	}
+	nanoseconds_to_absolutetime(1000000000ull, &iv);
+	sim_next = now + iv;
+	if (sim_ext) {
+		sim_put(ext, sizeof(ext));
+	} else {
+		sim_put(legacy, sizeof(legacy));
+	}
+}
+
+/* ---- the link under the node: uart18, or the stand-in ---- */
+static void c2h_byte(uint8_t b);
+
+/* bt4's hooks: the bytes under the in-band sleep gate; the stand-in acknowledges a wake at once */
+static void
+b4_tx1(uint8_t b)
+{
+	static const uint8_t ack = 0xfc;
+
+	if (sv.sim) {
+		if (b == 0xfd) {
+			sim_put(&ack, 1);
+		}
+		return;
+	}
+	(void)se_tx(&b, 1, NULL, 0);
+}
+
+static bool
+b4_txn(const uint8_t *p, uint32_t n)
+{
+	if (sv.sim) {
+		sim_cmd(p, n);
+		return true;
+	}
+	return se_tx(p, (int)n, NULL, 0);
+}
+
+static bool
+link_tx(const uint8_t *p, uint32_t n)
+{
+	if (ops != NULL && B4->on) {
+		(void)b4_ibs_wake(B4, c2h_byte);        /* bt4: the chip woken first when this side sleeps */
+	}
+	return b4_txn(p, n);
+}
+
+static bool
+link_rx(uint8_t *b)
+{
+	if (sv.sim) {
+		if (sim_in == sim_out) {
+			return false;
+		}
+		*b = simr[sim_out++ % SIM_RING];
+		return true;
+	}
+	if ((rd(se, 0x804) & 0x1ffffffu) == 0) {
+		return false;
+	}
+	*b = (uint8_t)rd(se, 0x780);
+	return true;
+}
+
+static bool
+b4_rx1(uint8_t *b)
+{
+	return link_rx(b);
+}
+
+static uint32_t
+b4_ms(void)
+{
+	return ls_ms();
+}
+
+static void
+b4_pause(void)
+{
+	delay(20);
+}
+
+static bool
+b4_here(void)
+{
+	return ops != NULL;
+}
+
+/* stage b applied these icebt_nvm bits; in-band sleep is armed (again) only by stage d */
+static void
+b4_note_nvm(uint32_t done)
+{
+	if (ops != NULL) {
+		B4->nvm_done = done;
+		B4->on = 0;
+	}
+}
+
+/* the chip's in-band sleep is on (tag 17's bit sent) or this side's is armed */
+static bool
+b4_chip_ibs(void)
+{
+	return ops != NULL && ((B4->nvm_done & 1) || B4->on);
+}
+
+static void
+b4_chip_byte(uint8_t b)
+{
+	if (ops != NULL) {
+		b4_ibs_in(B4, b);
+	}
+}
+
+/* ---- the client's packets ---- */
+/* the return parameters after the status: commands that set something have none; the reads listed here have these many;
+ * any other read (-1) is not answered for the chip */
+static int
+ret_len(uint16_t op)
+{
+	static const struct {
+		uint16_t op;
+		uint8_t n;
+	} reads[] = { { 0x0c5a, 1 }, { 0x1005, 7 }, { 0x2002, 3 }, { 0x2003, 8 }, { 0x2007, 1 }, { 0x200f, 1 }, { 0x201c, 8 },
+		      { 0x2023, 4 }, { 0x2029, 1 }, { 0x202f, 8 }, { 0x203a, 2 }, { 0x203b, 1 }, { 0x204a, 2 }, { 0x204b, 4 } };
+	/* commands without return parameters that a host sends at start-up (Core 5.4 Vol 4 Part E 7.3, 7.8) */
+	static const uint16_t sets[] = { 0x0c01, 0x0c05, 0x0c0a, 0x0c13, 0x0c18, 0x0c1a, 0x0c1c, 0x0c1e, 0x0c24, 0x0c26, 0x0c31,
+		                         0x0c33, 0x0c3a, 0x0c43, 0x0c45, 0x0c47, 0x0c52, 0x0c56, 0x0c5b, 0x0c63, 0x0c6d, 0x0c7a, 0x0c82,
+		                         0x2001, 0x2005, 0x2006, 0x2008, 0x2009, 0x200a, 0x200b, 0x200c, 0x2010, 0x2011, 0x2012,
+		                         0x2024, 0x2027, 0x2028, 0x202d, 0x202e, 0x2031, 0x2041, 0x2042, 0x204d, 0x204e, 0x2063, 0x2074,
+		                         0x207d };
+
+	for (unsigned i = 0; i < sizeof(reads) / sizeof(reads[0]); i++) {
+		if (reads[i].op == op) {
+			return reads[i].n;
+		}
+	}
+	for (unsigned i = 0; i < sizeof(sets) / sizeof(sets[0]); i++) {
+		if (sets[i] == op) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static void
+answer_here(const uint8_t *p, uint32_t n, const char *why)
+{
+	uint16_t op = (uint16_t)(p[1] | p[2] << 8);
+	uint8_t e[7 + 9] = { 0x04, 0x0e, 0x04, 0x01, p[1], p[2], 0x00 };
+	uint32_t len = 7;
+
+	if ((op >> 10) == 0x3f) {
+		e[7] = n > 4 ? p[4] : 0;                /* often the sub-opcode; then 8 zero bytes */
+		if (op == 0xfc79 && chipid != 0) {
+			e[7] = (uint8_t)chipid;         /* Read Verbose Config Version Info: chip id, then 0s */
+		}
+		len = 7 + 9;
+	} else {
+		len = 7 + (ret_len(op) > 0 ? (uint32_t)ret_len(op) : 0);
+	}
+	e[2] = (uint8_t)(len - 3);
+	sd.cmd_local++;
+	tr("< cc", op, 0, e + 7, len - 7, why);
+	host_emit(e, len);
+}
+
+static void
+h2c_packet(uint8_t *p, uint32_t n)
+{
+	struct sv_op *o;
+	uint16_t op;
+	bool here = false;
+
+	if (p[0] != 0x01) {
+		if (p[0] == 0x02) {
+			sd.acl_tx++;
+			if (ops != NULL) {
+				lp_out(p, n);           /* bt2: icebt_lepb, before the trace sees it */
+			}
+			if (PR_ON) {
+				pr_acl(false, p, n);
+			}
+			if (LS_ON) {
+				ls_out(p, n);
+			}
+			if (ops != NULL) {
+				rx_out(p, n);                   /* bt3: as sent, and its send time */
+			}
+		} else {
+			sd.other_tx++;
+		}
+		if (!link_tx(p, n)) {
+			sd.tx_fail++;
+		}
+		return;
+	}
+	op = (uint16_t)(p[1] | p[2] << 8);
+	sd.cmd++;
+	if ((op >> 10) == 0x3f) {
+		here = vsc_local != 0;
+	} else {
+		for (unsigned k = 0; k < 8; k++) {
+			here = here || (fake[k] != 0 && fake[k] == op);
+		}
+		if (ops != NULL && lp_cmd(p, n, op)) {
+			here = true;                    /* bt2: icebt_lefix */
+		}
+	}
+	o = op_slot(op);
+	if (o != NULL) {
+		o->n++;
+		o->how |= here ? 2 : 1;
+	}
+	/*
+	 * gains1 (R1), icebt_lemask=3 (bit 1 of the word; default 1, so OFF): QcaBluetooth PR #5 (013f931e, open) on the same
+	 * 26C5035r host: its third-party LE event mask 0x101f lacks LE PHY Update Complete (subevent 0x0c = mask bit 11), and
+	 * a PHY change the controller makes is then never reported, which can stall an LE link's negotiation. Here the
+	 * daemon's 0x2001 goes out with bit 11 set as well (0x101f -> 0x181f), and LE 2M stays unset in what the host learns
+	 * of the controller (the 0x2003 answer below), as PR #5 leaves it unset in its Type 0 capability cache.
+	 */
+	const uint8_t le_or = (uint8_t)((lemask & 1 ? 0x10 : 0) | (lemask & 2 ? 0x08 : 0));
+
+	if (op == 0x2001 && le_or && n >= 12 && (p[5] & le_or) != le_or) {
+		p[5] |= le_or;                          /* bit 12: LE Extended Advertising Report; bit 11: LE PHY Update Complete */
+		sd.mask_or++;
+		tr("> cmd", op, -1, p + 4, n - 4, lemask & 2 ? " (bits 12 and 11 set here)" : " (bit 12 set here)");
+	} else {
+		tr("> cmd", op, -1, p + 4, n - 4, here ? " (not sent)" : "");
+	}
+	if (PR_ON) {
+		pr_cmd(p, n, op, here, o);
+	}
+	if (op == 0x200c || op == 0x2042) {
+		sd.scan_on += n > 4 && p[4] != 0;
+	}
+	if (here) {
+		answer_here(p, n, (op >> 10) == 0x3f ? " (answered here: vendor)" : " (answered here: icebt_fake)");
+		if (o != NULL) {
+			o->st = 0;
+		}
+		return;
+	}
+	sd.cmd_sent++;
+	if (!link_tx(p, n)) {
+		sd.tx_fail++;
+		say("hci: command %04x: TX FAILED\n", op);
+	}
+}
+
+static void
+h2c_byte(uint8_t b)
+{
+	uint32_t hdr;
+
+	if (hp_skip != 0) {
+		hp_skip--;
+		return;
+	}
+	if (hp_n == 0 && b != 0x01 && b != 0x02 && b != 0x03 && b != 0x05) {
+		sd.h_stray++;
+		return;
+	}
+	hp[hp_n++] = b;
+	hdr = hp[0] == 0x01 || hp[0] == 0x03 ? 4 : 5;
+	if (hp_n == hdr) {
+		hp_need = hdr + (hp[0] == 0x01 || hp[0] == 0x03 ? hp[3] : hp[0] == 0x02 ? (uint32_t)(hp[3] | hp[4] << 8) :
+		    (uint32_t)((hp[3] | hp[4] << 8) & 0x3fff));
+		if (hp_need > PKT_MAX) {
+			sd.big++;
+			hp_skip = hp_need - hp_n;
+			hp_n = 0;
+			return;
+		}
+	}
+	if (hp_n >= hdr && hp_n == hp_need) {
+		h2c_packet(hp, hp_n);
+		hp_n = 0;
+	}
+}
+
+/* ---- the controller's packets ---- */
+static void
+c2h_packet(uint8_t *p, uint32_t n)
+{
+	struct sv_op *o;
+	uint16_t op;
+	uint8_t e[7 + 8];
+
+	if (ops != NULL) {
+		rx_in(p, n);                            /* bt3: icebt_rxlog, icebt_iso2acl (may retype p[0]) */
+	}
+	if (p[0] != 0x04) {
+		if (p[0] == 0x02) {
+			sd.acl_rx++;
+			if (PR_ON) {
+				pr_acl(true, p, n);
+			}
+			if (ops != NULL) {
+				lp_in(p, n);            /* bt2c: per-link counts */
+			}
+			if (LS_ON && ls_in(p, n)) {
+				return;
+			}
+		}
+		host_emit(p, n);
+		return;
+	}
+	sd.ev++;
+	if (PR_ON) {
+		pr_evt(p, n);
+	}
+	if (LS_ON) {
+		ls_evt(p, n);
+	}
+	if (ops != NULL) {
+		lp_evt(p, n);
+	}
+	if (p[1] == 0x0e && p[2] >= 3) {
+		int st = p[2] >= 4 ? p[6] : 0;
+
+		sd.cc++;
+		op = (uint16_t)(p[4] | p[5] << 8);
+		o = op != 0 ? op_slot(op) : NULL;
+		if (o != NULL) {
+			o->st = (uint8_t)st;
+		}
+		if (op == 0x0c03 && st == 0) {
+			sd.reset_ok++;
+			if (LS_ON) {
+				memset(LS->l, 0, sizeof(LS->l));        /* bt2: a reset ends every link */
+			}
+			if (ops != NULL) {
+				memset(LP->h1, 0, sizeof(LP->h1));
+			}
+		}
+		if (st != 0) {
+			sd.cc_bad++;
+		}
+		if (op == 0x1002 && st == 0 && n >= 7 + 64) {
+			tr("< cc", op, st, p + 7, n - 7, " (as the chip said it; octets 28.. below)");
+			tr("< cc", op, st, p + 7 + 28, n - 7 - 28, " (octets 28..55)");
+			if (fake[0] != 0 || fake[1] != 0) {
+				p[7 + 18] |= 0x0c;              /* Read / Write Default Erroneous Data Reporting: answered here */
+				sd.sup_patched++;
+			}
+			if (legacy_only) {
+				p[7 + 36] &= 0x01;
+				p[7 + 37] = 0;
+				p[7 + 38] &= 0x80;
+				sd.legacy++;
+			}
+		} else if (op == 0x1001 && st == 0 && n >= 7 + 8 && mfr != 0) {
+			tr("< cc", op, st, p + 7, n - 7, " (as the chip said it; manufacturer replaced for the client)");
+			p[7 + 4] = (uint8_t)mfr;
+			p[7 + 5] = (uint8_t)(mfr >> 8);
+		} else if (op == 0x2003 && st == 0 && n >= 7 + 8 && (legacy_only || (lemask & 2))) {
+			tr("< cc", op, st, p + 7, n - 7, legacy_only && (lemask & 2) ? " (as the chip said it; bits 8, 12-13 cleared for "
+			    "the client)" : legacy_only ? " (as the chip said it; bits 12-13 cleared for the client)" :
+			    " (as the chip said it; bit 8, LE 2M, cleared for the client)");
+			p[7 + 1] &= (uint8_t)~((legacy_only ? 0x30 : 0) | (lemask & 2 ? 0x01 : 0));   /* gains1 (R1): LE 2M PHY is bit 8 */
+			sd.legacy++;
+		} else if (st != 0 && soft && (op >> 10) != 0x3f && (st == 0x01 || st == 0x11) && ret_len(op) >= 0) {
+			uint32_t len = 7 + (uint32_t)ret_len(op);
+
+			tr("< cc", op, st, NULL, 0, " (the chip refuses it: status 0 for the client)");
+			memset(e, 0, sizeof(e));
+			memcpy(e, p, 6);
+			e[2] = (uint8_t)(len - 3);
+			sd.rewritten++;
+			if (o != NULL) {
+				o->how |= 4;
+			}
+			host_emit(e, len);
+			return;
+		} else {
+			tr("< cc", op, st, p + 7, n > 7 ? n - 7 : 0, "");
+		}
+		host_emit(p, n);
+		return;
+	}
+	if (p[1] == 0x0f && p[2] >= 4) {
+		sd.cs++;
+		op = (uint16_t)(p[5] | p[6] << 8);
+		o = op != 0 ? op_slot(op) : NULL;
+		if (o != NULL) {
+			o->st = p[3];
+		}
+		if (p[3] == 0x01 && soft && op != 0 && (op >> 10) != 0x3f && (op >> 10) != 1 && ret_len(op) >= 0) {
+			uint32_t len = 7 + (uint32_t)ret_len(op);
+
+			tr("< cs", op, p[3], NULL, 0, " (the chip does not know it: Command Complete, status 0, for the client)");
+			memset(e, 0, sizeof(e));
+			e[0] = 0x04;
+			e[1] = 0x0e;
+			e[2] = (uint8_t)(len - 3);
+			e[3] = p[4];
+			e[4] = p[5];
+			e[5] = p[6];
+			sd.rewritten++;
+			if (o != NULL) {
+				o->how |= 4;
+			}
+			host_emit(e, len);
+			return;
+		}
+		tr("< cs", op, p[3], NULL, 0, "");
+		host_emit(p, n);
+		return;
+	}
+	if (p[1] == 0x3e && p[2] >= 2 && (p[3] == 0x02 || p[3] == 0x0d || p[3] == 0x0b)) {
+		sd.adv += p[4];                         /* advertising reports: counted, never shown */
+		/* w5-bt: the first report's advertiser, as a hash in memory only (hb_seen_add), for a distinct count */
+		if (hb_seen == NULL) {
+		} else if (p[3] == 0x02 && p[4] >= 1 && n >= 13) {
+			hb_seen_add(p[6], p + 7);
+		} else if (p[3] == 0x0d && p[4] >= 1 && n >= 14) {
+			hb_seen_add(p[7], p + 8);
+		}
+	} else if (p[1] == 0x10) {
+		if (sd.hwerr++ < 3) {
+			say("hci: HARDWARE ERROR event, code %#x\n", p[2] >= 1 ? p[3] : 0xffu);
+		}
+	} else if (p[1] != 0x13 && p[1] != 0x1a) {
+		tr(p[1] == 0x3e ? "< le-meta" : "< ev", p[1] == 0x3e ? p[3] : p[1], -1, NULL, p[2], "");
+	}
+	host_emit(p, n);
+}
+
+static void
+c2h_byte(uint8_t b)
+{
+	uint32_t hdr;
+
+	if (ops != NULL) {
+		RX->bytes++;                            /* bt3: every byte from the link */
+	}
+	if (cp_n == 0 && b >= 0xfc && b <= 0xfe && b4_chip_ibs()) {
+		b4_ibs_in(B4, b);                       /* bt4: in-band sleep, between two packets */
+		return;
+	}
+	if (cp_n == 0 && b != 0x04 && b != 0x02 && b != 0x03 && b != 0x05) {
+		if (ops != NULL && RX->stray_n++ < 8) {
+			RX->stray[RX->stray_n - 1] = b; /* bt3: the first stray bytes' values */
+		}
+		sd.stray++;
+		return;
+	}
+	cp[cp_n++] = b;
+	if (cp[0] == 0x04 && cp_n == 2 && (b == 0 || (b > (PR_ON || (ops != NULL && PR->ev59) ? 0x59 : 0x58) && b != 0xff))) {
+		if (ops != NULL && RX->stray_n++ < 8) {
+			RX->stray[RX->stray_n - 1] = 0x04;
+		}
+		sd.stray++;                             /* not an event code: the 04 was a stray byte */
+		cp_n = 0;
+		if (b == 0x04) {
+			cp[cp_n++] = b;
+		}
+		return;
+	}
+	hdr = cp[0] == 0x04 ? 3 : cp[0] == 0x03 ? 4 : 5;
+	if (cp_n == hdr) {
+		cp_need = hdr + (cp[0] == 0x04 ? cp[2] : cp[0] == 0x03 ? cp[3] : cp[0] == 0x02 ? (uint32_t)(cp[3] | cp[4] << 8) :
+		    (uint32_t)((cp[3] | cp[4] << 8) & 0x3fff));
+		if (cp_need > PKT_MAX) {
+			sd.big++;
+			cp_n = 0;                       /* cannot be a packet: the stream is searched for the next type byte */
+			return;
+		}
+	}
+	if (cp_n >= hdr && cp_n == cp_need) {
+		c2h_packet(cp, cp_n);
+		cp_n = 0;
+	}
+}
+
+/* ---- /dev/cu.BLTH ---- */
+static int
+sv_open(__unused dev_t dev, __unused int flags, __unused int devtype, struct proc *p)
+{
+	struct timespec ts = { 60, 0 };
+	int error = 0;
+
+	lck_mtx_lock(&sv_lock);
+	if (sv.open) {
+		lck_mtx_unlock(&sv_lock);
+		return EBUSY;
+	}
+	sv.open = true;
+	/* the node is there before the controller is up: the opener waits for it here */
+	while (!sv.up && !sv.gone && error == 0) {
+		error = msleep(&sv.up, &sv_lock, PZERO | PCATCH, "icebt-open", &ts);
+	}
+	if (error == 0 && (!sv.up || sv.gone)) {
+		error = ENXIO;
+	}
+	if (error != 0) {
+		sv.open = false;
+	} else {
+		sv.rx_head = sv.rx_len = sv.tx_head = sv.tx_len = 0;
+		sv.fresh = true;                        /* the pump drops what the last client left half-sent */
+		memset(sv.termios, 0, sizeof(sv.termios));
+		sv.pid = proc_pid(p);
+		sd.opens++;
+	}
+	lck_mtx_unlock(&sv_lock);
+	if (sd.opens <= 12 || error != 0) {
+		say("/dev/cu.BLTH opened by %s[%d]: %s (%d)\n", proc_best_name(p), proc_pid(p), error ? "REFUSED" : "ok", error);
+	}
+	return error == EWOULDBLOCK ? EIO : error;
+}
+
+static int
+sv_close(__unused dev_t dev, __unused int flags, __unused int devtype, struct proc *p)
+{
+	lck_mtx_lock(&sv_lock);
+	sv.open = false;
+	sv.rx_head = sv.rx_len = sv.tx_head = sv.tx_len = 0;
+	sd.closes++;
+	wake_readers();
+	wake_writers();
+	lck_mtx_unlock(&sv_lock);
+	if (sd.closes <= 12) {
+		say("/dev/cu.BLTH closed by %s[%d]\n", proc_best_name(p), proc_pid(p));
+	}
+	return 0;
+}
+
+static int
+sv_read(__unused dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t chunk[512];
+	int error = 0;
+
+	lck_mtx_lock(&sv_lock);
+	while (sv.rx_len == 0 && error == 0) {
+		if (sv.gone) {
+			error = EIO;
+		} else if (ioflag & IO_NDELAY) {
+			error = EAGAIN;
+		} else {
+			error = msleep(&sv.rx_len, &sv_lock, PZERO | PCATCH, "icebt-read", NULL);
+		}
+	}
+	while (error == 0 && sv.rx_len != 0 && uio_resid(uio) > 0) {
+		uint32_t n = sv.rx_len < sizeof(chunk) ? sv.rx_len : (uint32_t)sizeof(chunk);
+
+		if ((user_ssize_t)n > uio_resid(uio)) {
+			n = (uint32_t)uio_resid(uio);
+		}
+		fifo_get(sv.rx, &sv.rx_head, &sv.rx_len, chunk, n);
+		lck_mtx_unlock(&sv_lock);
+		error = uiomove((const char *)chunk, (int)n, uio);
+		lck_mtx_lock(&sv_lock);
+	}
+	lck_mtx_unlock(&sv_lock);
+	return error;
+}
+
+static int
+sv_write(__unused dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t chunk[512];
+	int error = 0;
+
+	while (uio_resid(uio) > 0 && error == 0) {
+		uint32_t n = uio_resid(uio) < (user_ssize_t)sizeof(chunk) ? (uint32_t)uio_resid(uio) : (uint32_t)sizeof(chunk);
+
+		lck_mtx_lock(&sv_lock);
+		while (error == 0 && n > TTY_FIFO - sv.tx_len) {
+			if (sv.gone) {
+				error = EIO;
+			} else if (ioflag & IO_NDELAY) {
+				error = EAGAIN;
+			} else {
+				error = msleep(&sv.tx_len, &sv_lock, PZERO | PCATCH, "icebt-write", NULL);
+			}
+		}
+		lck_mtx_unlock(&sv_lock);
+		if (error != 0) {
+			break;
+		}
+		error = uiomove((char *)chunk, (int)n, uio);
+		if (error != 0) {
+			break;
+		}
+		lck_mtx_lock(&sv_lock);
+		if (sv.gone || n > TTY_FIFO - sv.tx_len) {
+			error = EIO;                    /* one writer (the daemon's HCI thread): a second one is told, not mixed in */
+		} else {
+			fifo_put(sv.tx, sv.tx_head, &sv.tx_len, chunk, n);
+		}
+		lck_mtx_unlock(&sv_lock);
+		wakeup(&sd);                            /* the pump */
+	}
+	return error;
+}
+
+static int
+sv_select(__unused dev_t dev, int which, void *wql, struct proc *p)
+{
+	int ready = 0;
+
+	lck_mtx_lock(&sv_lock);
+	if (which == FREAD) {
+		if (sv.rx_len != 0 || sv.gone) {
+			ready = 1;
+		} else {
+			sv.rsel_used = true;
+			selrecord(p, &sv.rsel, wql);
+		}
+	} else if (which == FWRITE) {
+		if (sv.tx_len < TTY_FIFO || sv.gone) {
+			ready = 1;
+		} else {
+			sv.wsel_used = true;
+			selrecord(p, &sv.wsel, wql);
+		}
+	}
+	lck_mtx_unlock(&sv_lock);
+	return ready;
+}
+
+/* the ioctls of a 64-bit client (sys/ttycom.h, sys/filio.h, IOKit/serial/ioss.h): the line is the bring-up's, 8N1 with
+ * RTS / CTS at 3.2 Mbaud, so what a client sets is kept and said back, not applied */
+static int
+sv_ioctl(__unused dev_t dev, u_long ioc, caddr_t data, __unused int fflag, __unused struct proc *p)
+{
+	static uint32_t ioc_shown;
+	int error = 0, v;
+
+	lck_mtx_lock(&sv_lock);
+	switch ((uint32_t)ioc) {
+	case 0x40487413u:                               /* TIOCGETA */
+		memcpy(data, sv.termios, sizeof(sv.termios));
+		break;
+	case 0x80487414u:                               /* TIOCSETA, TIOCSETAW, TIOCSETAF */
+	case 0x80487415u:
+	case 0x80487416u:
+		memcpy(sv.termios, data, sizeof(sv.termios));
+		break;
+	case 0x80085402u:                               /* IOSSIOSPEED */
+		memcpy(sv.termios + 56, data, 8);
+		memcpy(sv.termios + 64, data, 8);
+		break;
+	case 0x80047410u:                               /* TIOCFLUSH */
+		memcpy(&v, data, sizeof(v));
+		if (v == 0 || (v & FREAD)) {
+			sv.rx_head = sv.rx_len = 0;
+		}
+		break;
+	case 0x40047473u:                               /* TIOCOUTQ */
+		v = (int)sv.tx_len;
+		memcpy(data, &v, sizeof(v));
+		break;
+	case 0x4004667fu:                               /* FIONREAD */
+		v = (int)sv.rx_len;
+		memcpy(data, &v, sizeof(v));
+		break;
+	case 0x4004746au:                               /* TIOCMGET: DTR RTS CTS CAR DSR */
+		v = 0x002 | 0x004 | 0x020 | 0x040 | 0x100;
+		memcpy(data, &v, sizeof(v));
+		break;
+	case 0x2000745eu: {                             /* TIOCDRAIN */
+		struct timespec ts = { 1, 0 };
+
+		while (sv.tx_len != 0 && !sv.gone && error == 0) {
+			error = msleep(&sv.tx_len, &sv_lock, PZERO | PCATCH, "icebt-drain", &ts);
+		}
+		if (error == EWOULDBLOCK) {
+			error = 0;
+		}
+		break;
+	}
+	case 0x2000740du:                               /* TIOCEXCL, TIOCNXCL */
+	case 0x2000740eu:
+	case 0x8004746du:                               /* TIOCMSET, TIOCMBIS, TIOCMBIC */
+	case 0x8004746cu:
+	case 0x8004746bu:
+	case 0x20007479u:                               /* TIOCSDTR, TIOCCDTR */
+	case 0x20007478u:
+	case 0x8004667eu:                               /* FIONBIO, FIOASYNC */
+	case 0x8004667du:
+		break;
+	default:
+		error = ENOTTY;
+		break;
+	}
+	lck_mtx_unlock(&sv_lock);
+	if (ioc_shown < 24) {
+		ioc_shown++;
+		say("/dev/cu.BLTH ioctl %#lx: %d\n", ioc, error);
+	}
+	return error;
+}
+
+static const struct cdevsw sv_cdevsw = {
+	.d_open = sv_open, .d_close = sv_close, .d_read = sv_read, .d_write = sv_write, .d_ioctl = sv_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = sv_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+/* the buffers and the node, at the thread's start (devfs may not take nodes yet: tried for a minute) */
+static bool
+sv_prepare(void)
+{
+	char list[96] = { 0 };
+	uint32_t kit;
+
+	sv.rx = kalloc_data(TTY_FIFO, Z_WAITOK | Z_ZERO);
+	sv.tx = kalloc_data(TTY_FIFO, Z_WAITOK | Z_ZERO);
+	hp = kalloc_data(PKT_MAX + 8, Z_WAITOK | Z_ZERO);
+	cp = kalloc_data(PKT_MAX + 8, Z_WAITOK | Z_ZERO);
+	ops = kalloc_data(OPS_N * sizeof(*ops) + sizeof(struct pr_state) + sizeof(struct ls_state) + sizeof(struct lp_state) +
+	    sizeof(struct rx_state) + sizeof(struct b4_state), Z_WAITOK | Z_ZERO);    /* + PR, LS, LP, RX, B4 */
+	if (sv.sim) {
+		simr = kalloc_data(SIM_RING, Z_WAITOK | Z_ZERO);
+	}
+	if (sv.rx == NULL || sv.tx == NULL || hp == NULL || cp == NULL || ops == NULL || (sv.sim && simr == NULL)) {
+		say("(d) no memory for the node's buffers\n");
+		return false;
+	}
+	(void)PE_parse_boot_argn("icebt_vsc", &vsc_local, sizeof(vsc_local));
+	(void)PE_parse_boot_argn("icebt_soft", &soft, sizeof(soft));
+	(void)PE_parse_boot_argn("icebt_lemask", &lemask, sizeof(lemask));
+	(void)PE_parse_boot_argn("icebt_legacy", &legacy_only, sizeof(legacy_only));
+	(void)PE_parse_boot_argn("icebt_trace", &tr_level, sizeof(tr_level));
+	(void)PE_parse_boot_argn("icebt_trace_max", &tr_max, sizeof(tr_max));
+	(void)PE_parse_boot_argn("icebt_chipid", &chipid, sizeof(chipid));
+	PR->max = 400;
+	/*
+	 * bt1: the 26C5035r daemon sets Set_Event_Mask_Page_2 bit 25 (Encryption Change v2, the QEMU trace of w7-bt
+	 * console-run1: 0x0000000002000000), so the chip answers the first encryption change - the first pairing - with
+	 * event 0x59, which the framer dropped as a stray byte unless icebt_pair was on. icebt_ev59=0 is install6's framer.
+	 */
+	PR->ev59 = 1;
+	(void)PE_parse_boot_argn("icebt_ev59", &PR->ev59, sizeof(PR->ev59));
+	kit = b4_kit();
+	PR->on = kit;                           /* laneD: bt4a's line had icebt_pair=1 */
+	(void)PE_parse_boot_argn("icebt_pair", &PR->on, sizeof(PR->on));
+	(void)PE_parse_boot_argn("icebt_pair_max", &PR->max, sizeof(PR->max));
+	PR->lediag = 1;                         /* gains2: icebt_lediag=0 on a line turns the LE lines off */
+	(void)PE_parse_boot_argn("icebt_lediag", &PR->lediag, sizeof(PR->lediag));
+	if (PR->on) {
+		say("(d) icebt_pair=%u: pairing lines (at most %u; no address, key or passkey), the daemon's event masks, event "
+		    "0x59 framed\n", PR->on, PR->max);
+	}
+	/* bt2: LE security first (see its comment); 1..99 mean the default wait, at most 20 s (the daemon's ATT timeout is 30) */
+	LS->wait_ms = kit;                      /* laneD: bt4a's line had icebt_lesec=1 */
+	(void)PE_parse_boot_argn("icebt_lesec", &LS->wait_ms, sizeof(LS->wait_ms));
+	LS->wait_ms = LS->wait_ms == 0 ? 0 : LS->wait_ms < 100 ? 1500 : LS->wait_ms > 20000 ? 20000 : LS->wait_ms;
+	LS->err = 0x05;
+	(void)PE_parse_boot_argn("icebt_lesec_err", &LS->err, sizeof(LS->err));
+	if (LS->wait_ms != 0) {
+		say("(d) icebt_lesec: an unencrypted LE link (this side central) that brought no data in gets ATT error %#x for a "
+		    "request unanswered for %u ms, once, so the host pairs first\n", LS->err & 0xff, LS->wait_ms);
+	}
+	/*
+	 * bt2 run 2: LE ACL packet boundary and the A/B set-up switches, see their comment. laneD: bt2c/bt3/bt4 made pb 1,
+	 * lefix 7, rxlog 1, iso2acl 1 the defaults; here they are those values only with the kit (icebt4=1 / iceld=..1..), and
+	 * 0 otherwise, so a kernel without the kit's word behaves as install65's (bt1 + gains1/gains2 Bluetooth).
+	 */
+	LP->pb = kit ? 1 : 0;
+	LP->fix = kit ? 7 : 0;                  /* bt2c: Fedora's LE set-up (bt2-lepb-2: PB was 00 already) */
+	(void)PE_parse_boot_argn("icebt_lepb", &LP->pb, sizeof(LP->pb));
+	(void)PE_parse_boot_argn("icebt_lefix", &LP->fix, sizeof(LP->fix));
+	/* bt3: the inbound accounting (see its comment): 1 = the default budget of 160 lines, N > 1 = N lines, 0 = no lines */
+	RX->on = kit ? 1 : 0;
+	RX->iso2acl = kit ? 1 : 0;
+	(void)PE_parse_boot_argn("icebt_rxlog", &RX->on, sizeof(RX->on));
+	(void)PE_parse_boot_argn("icebt_iso2acl", &RX->iso2acl, sizeof(RX->iso2acl));
+	RX->max = RX->on > 1 ? RX->on : 160;
+	/* bt4: the unit address, Linux's NVM edits, in-band sleep (see the bt4 block); icebt_t0 is read by kern_exec.c */
+	B4->addr_on = kit ? 1 : 0;
+	B4->nvm = kit ? 3 : 0;
+	B4->ibs = kit ? 1 : 0;
+	(void)PE_parse_boot_argn("icebt_bdaddr", &B4->addr_on, sizeof(B4->addr_on));
+	(void)PE_parse_boot_argn("icebt_nvm", &B4->nvm, sizeof(B4->nvm));
+	(void)PE_parse_boot_argn("icebt_ibs", &B4->ibs, sizeof(B4->ibs));
+	B4->addr_st = -3;
+	if (kit || LP->pb || LP->fix || RX->on || RX->iso2acl || B4->addr_on || B4->nvm || B4->ibs) {
+		say("(d) laneD icebt4 %u: icebt_lepb=%u, icebt_lefix=%#x, icebt_rxlog %u (%u lines), icebt_iso2acl %u; bt4: "
+		    "icebt_bdaddr %u, icebt_nvm %#x, icebt_ibs %u\n", kit, LP->pb, LP->fix, RX->on, RX->on ? RX->max : 0,
+		    RX->iso2acl, B4->addr_on, B4->nvm, B4->ibs);
+	}
+	if (hb_seen == NULL) {                  /* w5-bt: address hashes for the distinct count, in memory only */
+		hb_seen = kalloc_data(HB_SEEN_N * sizeof(*hb_seen), Z_WAITOK | Z_ZERO);
+	}
+	hb_distinct = 0;
+	(void)PE_parse_boot_argn("icebt_mfr", &mfr, sizeof(mfr));
+	if (PE_parse_boot_arg_str("icebt_fake", list, sizeof(list))) {
+		const char *q = list;
+
+		memset(fake, 0, sizeof(fake));
+		for (unsigned k = 0; *q != 0 && k < 8; k++) {
+			fake[k] = (uint32_t)strtoul(q, (char **)(uintptr_t)&q, 0);
+			while (*q == ',') {
+				q++;
+			}
+		}
+	}
+	for (int i = 0; i < 600 && sv.node == NULL && !stop_req; i++) {
+		if (sv.major < 0) {
+			sv.major = cdevsw_add(-1, &sv_cdevsw);
+			if (sv.major >= 0) {
+				(void)cdevsw_setkqueueok(sv.major, &sv_cdevsw, 0);
+			}
+		}
+		if (sv.major >= 0) {
+			sv.node = devfs_make_node(makedev(sv.major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "cu.BLTH");
+		}
+		if (sv.node == NULL) {
+			IOSleep(100);
+		}
+	}
+	say("(d) /dev/cu.BLTH %s (major %d)%s; vendor commands %s, icebt_fake %#x %#x %#x %#x, soft %u, lemask %u, legacy %u, trace %u / %u lines, chipid %#x, mfr %#x\n",
+	    sv.node ? "made" : "NOT made", sv.major, sv.sim ? "; sim: QEMU's stand-in controller, no hardware" : "",
+	    vsc_local ? "answered here" : "SENT to the chip", fake[0], fake[1], fake[2], fake[3], soft, lemask, legacy_only,
+	    tr_level, tr_max, chipid, mfr);
+	return sv.node != NULL;
+}
+
+static int
+kick_one(proc_t p, __unused void *arg)
+{
+	if (strncmp(proc_best_name(p), "bluetoothd", 11) == 0) {
+		say("(d) bluetoothd[%d] has not opened the node: SIGTERM once, launchd starts it again (icebt_kick)\n", proc_pid(p));
+		psignal(p, SIGTERM);
+		sd.kicked++;
+	}
+	return PROC_RETURNED;
+}
