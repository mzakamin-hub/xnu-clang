+/* ---- the clock controller ---------------------------------------------------------------------------------------- */
+
+static bool
+gdsc_on(const char *name, uint32_t off, uint32_t *found)
+{
+	*found = rd(cam.cc + off);
+	if ((*found & GDSC_WAITS_MASK) != GDSC_WAITS || (*found & 6)) {
+		cwl(name, cam.cc, off, (*found & ~(GDSC_WAITS_MASK | 6u)) | GDSC_WAITS);   /* gdsc_init: the waits, no hardware control */
+	}
+	cwl(name, cam.cc, off, rd(cam.cc + off) & ~GDSC_COLLAPSE);
+	if (!cam_wait(cam.cc + off + 4, GDSC_CFG_UP, GDSC_CFG_UP, 2000)) {
+		say("%s does not come up: %#x cfg %#x\n", name, rd(cam.cc + off), rd(cam.cc + off + 4));
+		return false;
+	}
+	wait_us(1);
+	cwl(name, cam.cc, off, rd(cam.cc + off) | GDSC_RETAIN);
+	say("%s on: %#x cfg %#x\n", name, rd(cam.cc + off), rd(cam.cc + off + 4));
+	return true;
+}
+
+static void
+gdsc_off(const char *name, uint32_t off, uint32_t found)
+{
+	cwl(name, cam.cc, off, rd(cam.cc + off) | GDSC_COLLAPSE);
+	if (!cam_wait(cam.cc + off + 4, GDSC_CFG_DOWN, GDSC_CFG_DOWN, 2000)) {
+		say("%s does not go down: %#x cfg %#x\n", name, rd(cam.cc + off), rd(cam.cc + off + 4));
+	}
+	if ((rd(cam.cc + off) & (GDSC_WAITS_MASK | GDSC_RETAIN | 6u)) != (found & (GDSC_WAITS_MASK | GDSC_RETAIN | 6u))) {
+		cwl(name, cam.cc, off, (rd(cam.cc + off) & ~(GDSC_WAITS_MASK | GDSC_RETAIN | 6u)) |
+		    (found & (GDSC_WAITS_MASK | GDSC_RETAIN | 6u)));
+	}
+}
