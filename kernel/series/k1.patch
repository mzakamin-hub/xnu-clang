+#define STDERR_LOG_PID1_LINES_PER_SECOND        256
+#define STDERR_LOG_PID1_UNLIMITED_AFTER_SEC     100
+#define STDERR_LOG_LINE_BYTES                   512
+#define STDERR_LOG_PATH_BYTES                   256
