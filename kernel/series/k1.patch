+static void
+pcie_d1(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t off;
+	} cbcr[] = {
+		{ "slv_axi", 0x6b020 }, { "mstr_axi", 0x6b030 }, { "cfg_ahb", 0x6b040 }, { "aux", 0x6b044 }, { "slv_q2a", 0x6b01c },
+		{ "cnoc_sf_axi", 0x10058 }, { "aggre_noc_axi", 0x10068 }, { "ddrss_sf_qtb", 0x1007c }, { "phy_rchng", 0x6b074 },
+		{ "phy_aux", 0x6b054 }, { "pipe (not voted)", 0x6b064 },
+	};
+	vm_offset_t gcc = ml_io_map_unmappable(GCC_PA, 0x70000, VM_WIMG_IO);
+	vm_offset_t tcsr = ml_io_map_unmappable(0x01fc0000u + 0x15000u, PAGE_SIZE, VM_WIMG_IO);
+	uint32_t g0, g1, v0, v8, v18, t0;
+	int release = 0;
+	bool ok = true;
+
+	PE_parse_boot_argn("icepcie_release", &release, sizeof(release));
+	if (gcc == 0 || tcsr == 0) {
+		say("icepcie: GCC / TCSR not mapped: refused\n");
+		return;
+	}
+	g0 = GCC_RD(0x6b004);
+	g1 = GCC_RD(0x6c000);
+	v0 = GCC_RD(0x52000);
+	v8 = GCC_RD(0x52008);
+	v18 = GCC_RD(0x52018);
+	t0 = *(volatile uint32_t *)(tcsr + 0x44);
+	say("icepcie: as found: gdsc %08x / phy gdsc %08x, votes 52000 %08x 52008 %08x 52018 %08x, tcsr clkref %08x, "
+	    "rcg aux %08x/%08x rchng %08x/%08x, pipe mux %08x\n", g0, g1, v0, v8, v18, t0, GCC_RD(0x6b094), GCC_RD(0x6b098),
+	    GCC_RD(0x6b078), GCC_RD(0x6b07c), GCC_RD(0x6b090));
+	if ((g0 >> 31) || (g1 >> 31)) {
+		say("icepcie: a PCIe GDSC is already on (someone else's): REFUSED, nothing done\n");
+		return;
+	}
+	int r1 = hakios_iceland_rpmh_vote("L3I_E0", 5, 880000, true);
+	int r2 = r1 == 0 ? hakios_iceland_rpmh_vote("L1D_E0", 5, 1200000, true) : -9;
+	say("icepcie: vote L3I_E0 mode 5 880000 uV -> %d, L1D_E0 mode 5 1200000 uV -> %d\n", r1, r2);
+	if (r1 != 0 || r2 != 0) {
+		if (r1 == 0) {
+			say("icepcie: release L3I_E0 -> %d\n", hakios_iceland_rpmh_release("L3I_E0"));
+		}
+		say("icepcie: a PHY supply vote was not done: REFUSED\n");
+		return;
+	}
+	ok = pcie_gdsc_on(gcc, 0x6b004) && pcie_gdsc_on(gcc, 0x6c000);
+	if (ok) {
+		*(volatile uint32_t *)(tcsr + 0x44) = t0 | 1u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: tcsr +15044 <- %08x (read back %08x)\n", t0 | 1u, *(volatile uint32_t *)(tcsr + 0x44));
+		GCC_WR(0x52008, v8 | 0x6fu);
+		GCC_WR(0x52000, v0 | (1u << 12) | (1u << 19) | (1u << 22));
+		GCC_WR(0x52018, v18 | (1u << 31));
+		delay(1000);
+		for (unsigned i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); i++) {
+			uint32_t c = GCC_RD(cbcr[i].off);
+			say("icepcie: cbcr %-16s +%05x = %08x (%s)\n", cbcr[i].name, cbcr[i].off, c, (c >> 31) ? "clock OFF" : "clock on");
+		}
+		if (!(GCC_RD(0x6b040) >> 31) && (GCC_RD(0x6c000) >> 31)) {
+			vm_offset_t phy = ml_io_map_unmappable(0x01c06000u, 0x2000, VM_WIMG_IO);
+			if (phy != 0) {
+				say("icepcie: phy serdes +1000: %08x %08x %08x %08x; pcs +1400: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				    io_rd(phy, 0x1000), io_rd(phy, 0x1004), io_rd(phy, 0x1008), io_rd(phy, 0x100c), io_rd(phy, 0x1400),
+				    io_rd(phy, 0x1404), io_rd(phy, 0x1408), io_rd(phy, 0x140c), io_rd(phy, 0x1410), io_rd(phy, 0x1414),
+				    io_rd(phy, 0x1418), io_rd(phy, 0x141c));
+			}
+		} else {
+			say("icepcie: PHY not read (cfg_ahb not running or the PHY GDSC off)\n");
+		}
+		if (icepcie >= 2) {
+			if (!(GCC_RD(0x6b040) >> 31) && !(GCC_RD(0x6b044) >> 31) && !(GCC_RD(0x6b054) >> 31) &&
+			    !(GCC_RD(0x6b074) >> 31) && (GCC_RD(0x6c000) >> 31)) {
+				pcie_d2(gcc);
+			} else {
+				say("icepcie: 23d2 REFUSED: 23d1's clocks / PHY GDSC not all on in this run\n");
+			}
+		}
+		IOSleep(2000);
+		say("icepcie: PCIe0 power and clocks HELD 2 s: undoing\n");
+	} else {
+		say("icepcie: a GDSC did not come on: undoing what was done\n");
+	}
+	if (icepcie_lx) {
+		return;  /* (B) route: leave the PCIe0 power/clocks on for the Linux ath12k driver */
+	}
+	/* undo, in reverse */
+	if (ok) {
+		GCC_WR(0x52018, v18);
+		GCC_WR(0x52000, v0);
+		GCC_WR(0x52008, v8);
+		*(volatile uint32_t *)(tcsr + 0x44) = t0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: tcsr +15044 back <- %08x (read back %08x)\n", t0, *(volatile uint32_t *)(tcsr + 0x44));
+	}
+	GCC_WR(0x6c000, g1);
+	GCC_WR(0x6b004, g0);
+	IOSleep(10);
+	say("icepcie: put back: gdsc %08x (found %08x), phy gdsc %08x (found %08x), votes %08x %08x %08x\n", GCC_RD(0x6b004), g0,
+	    GCC_RD(0x6c000), g1, GCC_RD(0x52000), GCC_RD(0x52008), GCC_RD(0x52018));
+	if (release) {
+		say("icepcie: release L1D_E0 -> %d, L3I_E0 -> %d\n", hakios_iceland_rpmh_release("L1D_E0"),
+		    hakios_iceland_rpmh_release("L3I_E0"));
+	} else {
+		say("icepcie: L3I_E0 / L1D_E0 stay voted (icepcie_release=1 releases them)\n");
+	}
+	say("icepcie: %s\n", ok ? "done (23d1 PASS if every CBCR above said clock on)" : "REFUSED / FAILED, all put back");
+}
