+/*
+ * gains1 (21 Nov), the iceland memory telemetry's kernel half (osfmk/arm64/hakios_memtel.c, icemem=): one snapshot of
+ * what a wired-memory spike can be read from, into the caller's record (its stack; nothing is kept here). The page
+ * counts; the compressor (its resident pages, the pages compressed into them, its bytes); every zone's wired and
+ * allocated bytes and the five largest zones by wired bytes (the vm_page array's zone left out of the five, as the
+ * panic log's "Largest zones" does); kalloc's large allocations; and the five largest wired allocation sites by
+ * their live totals (VM_TAG_ACTIVE_UPDATE is 1 here): a tag's name, a kext's bundle id, a named site, or a kernel
+ * site's unslid address -- who holds the wired pages. Site totals are raw (a site that maps another's memory counts
+ * it too, as vm_page_diagnose's subtotals correct for); the zones are read without a lock, as the panic path reads them.
+ */
+void
+iceland_memsnap_take(struct iceland_memsnap *m)
+{
+	bzero(m, sizeof(*m));
+	m->wired = vm_page_wire_count;
+	m->free = vm_page_free_count;
+	m->active = vm_page_active_count;
+	m->inactive = vm_page_inactive_count;
+	m->speculative = vm_page_speculative_count;
+	m->cmp_resident = VM_PAGE_COMPRESSOR_COUNT;
+	m->cmp_pages_in = c_segment_pages_compressed;
+	m->cmp_bytes = os_atomic_load(&compressor_bytes_used, relaxed);
+	m->kalloc_large = counter_load(&kalloc_large_total);
+
+	zone_index_foreach(zid) {
+		zone_t z = &zone_array[zid];
+		const uint64_t w = zone_size_wired(z);
+		int at;
+
+		m->zones_wired += w;
+		m->zones_alloc += zone_size_allocated(z);
+		if (zid == ZONE_ID_VM_PAGES || (at = iceland_top_slot(m->zone_bytes, w)) < 0) {
+			continue;
+		}
+		memmove(&m->zone_bytes[at + 1], &m->zone_bytes[at], (ICEMEM_TOP - 1 - at) * sizeof(m->zone_bytes[0]));
+		memmove(m->zone_name[at + 1], m->zone_name[at], (ICEMEM_TOP - 1 - at) * ICEMEM_NAME);
+		m->zone_bytes[at] = w;
+		snprintf(m->zone_name[at], ICEMEM_NAME, "%s%s", zone_heap_name(z), z->z_name);
+	}
+
+	lck_ticket_lock(&vm_allocation_sites_lock, &vm_page_lck_grp_bucket);
