+
+/* ---- w3-net (boot-arg icewifi_net=1, macOS): the joined station's frames on macOS's own en0 (hakios_iceland_net.c) ---- */
+extern uint32_t hakios_iceland_net_mode(void);
+extern void hakios_iceland_net_init(void);
+extern void hakios_iceland_net_rx(const uint8_t *eth, size_t len);
