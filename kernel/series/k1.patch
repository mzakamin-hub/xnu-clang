+        const uint32_t *lower=fy?reinterpret_cast<const uint32_t *>(src+(uint64_t)y1*sourceStride):upper;
+        volatile uint32_t *out=reinterpret_cast<volatile uint32_t *>(dst+(uint64_t)row*destinationStride);
