+	PAC_STD_READ_KEY(APIAKeyHi_EL1, reg[1]);
+	PAC_STD_READ_KEY(APIBKeyLo_EL1, reg[2]);
+	PAC_STD_READ_KEY(APIBKeyHi_EL1, reg[3]);
+	PAC_STD_READ_KEY(APDAKeyLo_EL1, reg[4]);
+	PAC_STD_READ_KEY(APDAKeyHi_EL1, reg[5]);
+	PAC_STD_READ_KEY(APDBKeyLo_EL1, reg[6]);
+	PAC_STD_READ_KEY(APDBKeyHi_EL1, reg[7]);
+	PAC_STD_READ_KEY(APGAKeyLo_EL1, reg[8]);
+	PAC_STD_READ_KEY(APGAKeyHi_EL1, reg[9]);
