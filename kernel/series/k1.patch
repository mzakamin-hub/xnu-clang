+/*
+ * bt4: the unit's id for icebt_bdaddr, the SoC serial in SMEM socinfo (read only; the mapping undone). SMEM as
+ * hakios_iceland_battery.c finds it (kaanapali.dtsi smem@81d00000, 2 MB), refused where those pages are the kernel's RAM. Under
+ * QEMU there is no unit: the stand-in gets an address made from its own name, so the path runs there too. The id is never logged.
+ */
+#define B4_SMEM_PA      0x81d00000ull
+#define B4_SMEM_SZ      0x00200000u
+extern boolean_t pmap_valid_page(ppnum_t pn);
+
+/* l7bt, 24 Nov: ml_io_map gives a PERMANENT kernel mapping here; ml_io_unmap of it panics in vm_map_delete
+ * ("Attempting to remove permanent VM map entry", 2 MiB). SMEM is mapped once and kept for the boot. */
+static vm_offset_t b4_smem_va;
+
+static const char *
+b4_unit_id(char *id, size_t n)
+{
+	uint32_t how = 0, serial;
+	vm_offset_t m;
+
+	if (sv.sim) {
+		strlcpy(id, "qemu-stand-in", n);
+		return "the QEMU stand-in (no unit)";
+	}
+	for (uint64_t pa = B4_SMEM_PA; pa < B4_SMEM_PA + B4_SMEM_SZ; pa += PAGE_SIZE) {
+		if (pmap_valid_page((ppnum_t)atop_64(pa))) {
+			strlcpy(id, "SMEM is kernel RAM here", n);
+			return NULL;
+		}
+	}
+	if (b4_smem_va == 0) {
+		b4_smem_va = ml_io_map(B4_SMEM_PA, B4_SMEM_SZ);
+	}
+	m = b4_smem_va;
+	if (m == 0) {
+		strlcpy(id, "SMEM not mapped", n);
+		return NULL;
+	}
+	serial = b4_smem_serial((const volatile uint8_t *)m, B4_SMEM_SZ, &how);
+	/* kept mapped: see b4_smem_va */
+	if (serial == 0) {
+		strlcpy(id, "no socinfo serial in SMEM", n);
+		return NULL;
+	}
+	snprintf(id, n, "%08x", serial);
+	return how == 1 ? "SMEM socinfo serial (global partition)" : "SMEM socinfo serial (global heap)";
+}
+
+/* icebt_bdaddr: the unit's address through EDL 0xfc14, before Read_BD_ADDR and the service */
+static void
+b4_set_addr(void)
+{
+	struct b4_state *s = B4;
+	uint8_t c[10] = { 0x01, 0x14, 0xfc, 0x06 };
+	char id[48];
+	const char *src = b4_unit_id(id, sizeof(id));
+
+	if (src == NULL) {
+		say("bdaddr: no unit id (%s): the firmware's address stays\n", id);
+		return;
+	}
+	b4_addr(id, s->addr);
+	memset(id, 0, sizeof(id));
+	memcpy(c + 4, s->addr, 6);                      /* most significant first, as qca_set_bdaddr sends it */
+	s->addr_st = b4_xchg(c, (uint32_t)sizeof(c), 0xfc14, 200);
+	memset(c, 0, sizeof(c));
+	say("bdaddr: unit id from %s; EDL 0xfc14 status %d (tag %04x)\n", src, s->addr_st, b4_tag(s->addr));
+}
+
+/* icebt_ibs: armed with a first wake, only once tag 17's bit went to the chip (the stand-in: always) */
+static void
+b4_ibs_arm(void)
+{
+	struct b4_state *s = B4;
+
+	if (s->fell != 0 || (!(s->nvm_done & 1) && !sv.sim)) {
+		say("ibs: not armed (%s)\n", s->fell ? "off for this boot" : "tag 17's in-band sleep bit not sent: icebt_nvm");
+		return;
+	}
+	s->on = 1;
+	s->tx = s->rx = 0;
+	s->col_n = s->col_k = 0;
+	if (b4_ibs_wake(s, b4_col)) {
+		say("ibs: armed at %u baud, WAKE_ACK in %u ms\n", speed_now, s->max_ms);
+	}
+}
+
+static bool
+stage_d(void)
+{
+	static const uint8_t c_bdaddr[] = { 0x01, 0x09, 0x10, 0x00 };
+	uint8_t r[32], shown[6] = { 0x02, 0x00, 0x00, 0x00, 0x51, 0x4d };
+	uint32_t kick = 1, kick_s = 10;
+	uint64_t t_up, t_stat, iv60, now, idle_since;
+	int m = 0, at = -1, st;
+	bool kicked = false, fine;
+
+	(void)PE_parse_boot_argn("icebt_kick", &kick, sizeof(kick));
+	(void)PE_parse_boot_argn("icebt_kick_s", &kick_s, sizeof(kick_s));
+	if (!sv.sim) {
+		wr(se, 0x644, rd(se, 0x644) | S_ERR);
+		wr(se, 0x648, S_ERR);
+		(void)se_rx(20000, r, (int)sizeof(r));
+	}
+	/* bt4: in-band sleep armed now that (b) runs at 3.2 Mbaud, then the unit's address, both before the service */
+	if (B4->ibs) {
+		b4_ibs_arm();
+	}
+	if (B4->addr_on) {
+		b4_set_addr();
+	}
+	if (!sv.sim || B4->addr_st == 0) {
+		/* the controller's address for the device tree; its bytes are never logged whole (bt4: the unit's never at all) */
+		st = b4_xchg(c_bdaddr, (uint32_t)sizeof(c_bdaddr), 0x1009, 100);
+		m = (int)B4->col_n;
+		at = cc_at(B4->col, m, 0x1009, -1);
+		if (st != 0 || at < 0 || at + 12 >= m) {
+			say("(d) FAILED: no Read_BD_ADDR answer (%d bytes)\n", m);
+			return false;
+		}
+		for (int i = 0; i < 6; i++) {
+			shown[i] = B4->col[at + 12 - i];
+		}
+		fine = (shown[0] | shown[1] | shown[2] | shown[3] | shown[4] | shown[5]) != 0;
+		if (B4->addr_st == 0) {
+			say("(d) the controller's address: the unit's, %s (tag %04x)\n", memcmp(shown, B4->addr, 6) == 0 ? "read back" :
+			    "NOT read back", b4_tag(shown));
+		} else {
+			say("(d) the controller's address: %s (**:**:**:**:%02x:%02x)\n", !fine ? "ALL ZERO: not published" :
+			    (shown[0] | shown[1] | shown[2] | shown[3]) == 0 && shown[4] == 0x5a && shown[5] == 0xad ?
+			    "the firmware's default, the same on every unit" : "set", shown[4], shown[5]);
+		}
+		if (!fine) {
+			return false;
+		}
+	}
+	if (sv.sim) {
+		strlcpy(fw_label, "icebt-sim", sizeof(fw_label));
+	}
+	RedwoodBTStartMac(shown, speed_now);
+	lck_mtx_lock(&sv_lock);
+	sv.up = true;
+	wakeup(&sv.up);
+	lck_mtx_unlock(&sv_lock);
+	say("(d) the controller is up for /dev/cu.BLTH: the service \"bluetooth\" is published; serving until the run ends\n");
+	t_up = t_stat = idle_since = mach_absolute_time();
+	nanoseconds_to_absolutetime(60000000000ull, &iv60);
+	while (!stop_req) {
+		uint8_t chunk[256], b;
+		uint32_t n, room;
+		bool did = false;
+
+		/* the client's bytes, while its FIFO has room for the answers made here */
+		lck_mtx_lock(&sv_lock);
+		if (sv.fresh) {
+			sv.fresh = false;
+			hp_n = hp_skip = 0;
+		}
+		room = TTY_FIFO - sv.rx_len;
+		n = room >= PKT_MAX ? (sv.tx_len < sizeof(chunk) ? sv.tx_len : (uint32_t)sizeof(chunk)) : 0;
+		if (n != 0) {
+			fifo_get(sv.tx, &sv.tx_head, &sv.tx_len, chunk, n);
+			wake_writers();
+		}
+		lck_mtx_unlock(&sv_lock);
+		for (uint32_t i = 0; i < n; i++) {
+			h2c_byte(chunk[i]);
+		}
+		did = n != 0;
+		/* the controller's bytes, while the client's FIFO has room for a whole packet (RFR holds the chip meanwhile);
+		 * with no client they are read and dropped */
+		if (sv.sim) {
+			sim_tick();
+		}
+		for (int k = 0; k < 4096; k++) {
+			if (cp_n == 0) {
+				/* between two packets: the next one is read only with room for the largest (PKT_MAX) */
+				lck_mtx_lock(&sv_lock);
+				room = TTY_FIFO - sv.rx_len;
+				lck_mtx_unlock(&sv_lock);
+				if (room < PKT_MAX && sv.open) {
+					break;
+				}
+			}
+			if (!link_rx(&b)) {
+				break;
+			}
+			c2h_byte(b);
+			did = true;
+		}
+		if (!sv.sim) {
+			uint32_t s = rd(se, 0x640) & S_ERR;
+
+			if (s) {
+				sd.uart_err++;
+				RX->uerr |= s;                  /* bt3: which of the engine's error bits */
+				wr(se, 0x648, s);
+			}
+		}
+		if (LS_ON) {
+			ls_tick();                      /* bt2: icebt_lesec */
+		}
+		b4_ibs_tick(B4);                        /* bt4: this side sleeps after 2 s without a frame */
+		now = mach_absolute_time();
+		if (kick && !kicked && sd.opens == 0 && now - t_up > (uint64_t)kick_s * (iv60 / 60)) {
+			kicked = true;
+			proc_iterate(PROC_ALLPROCLIST, kick_one, NULL, NULL, NULL);
+			if (sd.kicked == 0) {
+				say("(d) no bluetoothd process to tell (icebt_kick)\n");
+			}
+		}
+		if (now - t_stat > iv60) {
+			static uint32_t shown_n;
+
+			t_stat = now;
+			if (shown_n++ < 12) {
+				sv_summary("so far");
+			}
+		}
+		if (did) {
+			idle_since = now;
+		} else {
+			/* nothing either way: 1 ms naps for the first 50 ms, then 5 ms (a write to the node wakes the pump) */
+			struct timespec ts = { 0, now - idle_since > iv60 / 1200 ? 5000000 : 1000000 };
+
+			lck_mtx_lock(&sv_lock);
+			(void)msleep(&sd, &sv_lock, PZERO, "icebt-pump", &ts);
+			lck_mtx_unlock(&sv_lock);
+		}
+	}
+	lck_mtx_lock(&sv_lock);
+	sv.gone = true;
+	sv.up = false;
+	wakeup(&sv.up);
+	wake_readers();
+	wake_writers();
+	lck_mtx_unlock(&sv_lock);
+	sv_summary("the run's end");
+	fine = sd.opens != 0 && sd.reset_ok != 0;
+	say("(d) %s: %s\n", fine && sd.scan_on != 0 && sd.adv != 0 ? "PASS" : fine ? "PARTLY" : "NOT PASSED",
+	    sd.opens == 0 ? "nobody opened /dev/cu.BLTH" : sd.reset_ok == 0 ? "the node was opened but no HCI_Reset was answered" :
+	    sd.scan_on == 0 ? "the daemon drove the controller, but asked for no LE scan" : sd.adv == 0 ?
+	    "the daemon scanned, no advertising report came" : "the daemon drove the controller and its scan heard advertisers");
+	return fine;
+}
+
+/* ---- the undo, in reverse; also at a panic's end with the other cores off (quiesced: no sleep, no lock) ---- */
+static void
+bt_down(const char *why)
+{
+	uint32_t d = done;
+
+	if (d == 0 || !__sync_bool_compare_and_swap(&down_once, 0, 1)) {
+		return;
+	}
+	say("undo (%s): done %#x\n", why, d);
+	if (d & D_PADS) {
+		for (int i = 0; i < 4; i++) {
+			pw(pad[i], "pad", 0, pad0[i]);
+		}
+	}
+	if (d & D_SE) {
+		se_restore();
+		say("SE5 registers put back as found (%u)\n", (unsigned)SE_NREGS);
+	}
+	if (d & D_S5) {
+		pw(gcc, "gcc", GCC_VOTE, rd(gcc, GCC_VOTE) & ~(1u << 17));      /* only the bit set here */
+	}
+	if (d & D_EN) {
+		(void)spmi_wr("DIG_OUT_SOURCE_CTL (as found: low)", 0x44, (uint8_t)pin0.src);   /* bt-enable low: the chip's BT off */
+		nap(10);
+	}
+	if (d & D_GPIO) {
+		(void)spmi_wr("MODE_CTL (as found)", 0x40, (uint8_t)pin0.mode);
+		(void)spmi_wr("DIG_PULL_CTL (as found)", 0x42, (uint8_t)pin0.pull);
+		(void)spmi_wr("DIG_VIN_CTL (as found)", 0x41, (uint8_t)pin0.vin);
+	}
+	if (d & D_RAIL) {
+		hakios_iceland_wcn_rails_put("icebt");          /* after bt-enable is low; the votes stay */
+	}
+	say("undo done: bt-enable MODE_CTL %02x DIG_OUT_SRC %02x RT_STS %02x; vote %08x; pads %08x %08x %08x %08x\n",
+	    obsv ? (uint32_t)spmi_rd(0x40) & 0xff : 0, obsv ? (uint32_t)spmi_rd(0x44) & 0xff : 0,
+	    obsv ? (uint32_t)spmi_rd(0x10) & 0xff : 0, gcc ? rd(gcc, GCC_VOTE) : 0, pad[0] ? rd(pad[0], 0) : 0,
+	    pad[1] ? rd(pad[1], 0) : 0, pad[2] ? rd(pad[2], 0) : 0, pad[3] ? rd(pad[3], 0) : 0);
+}
+
+static void
+icebt_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)parameter, delay_s = 45, retry = 2;
+	bool ok = true, node = false, served = false;
+	const char *why = NULL;
+
+	PE_parse_boot_argn("icebt_delay", &delay_s, sizeof(delay_s));
+	say("stage %u (1 = a: version, 2 = + b: firmware, 3 = + c: passive scan, 4 = a, b + d: bluetoothd's /dev/cu.BLTH), "
+	    "first read in %u s\n", stage, delay_s);
+	if (stage >= 4) {
+		node = sv_prepare();            /* the node first: the daemon's open waits for the controller */
+	}
+	for (uint32_t i = 0; i < delay_s * 10 && !stop_req; i++) {
+		IOSleep(100);
+	}
+	busy = 1;
+	if (stop_req || (sv.sim && !node)) {
+		say("the run ends before the start: nothing touched\n");
+		lck_mtx_lock(&sv_lock);
+		sv.gone = true;                         /* an opener waiting for the controller is told */
+		wakeup(&sv.up);
+		lck_mtx_unlock(&sv_lock);
+		busy = 0;
+		return;
+	}
+	if (sv.sim) {
+		ok = stage_d();
+		say("ended (sim): %s\n", ok ? "the stand-in controller was driven" : "see above");
+		busy = 0;
+		return;
+	}
+	if (stage >= 2) {
+		nvm_copy = kalloc_data(NVM_MAX, Z_WAITOK | Z_ZERO);
+	}
+	if (stage == 3) {
+		hb_seen = kalloc_data(HB_SEEN_N * sizeof(*hb_seen), Z_WAITOK | Z_ZERO);
+	}
+	/*
+	 * bt1: icebt_retry=N (default 2; 0 = install6's single try): with stage d asked for, a bring-up that fails before
+	 * the service is published is undone (bt_down: bt-enable low, everything as found) and tried again after 15 s,
+	 * N times at most. bluetoothd only finds a controller once the service "bluetooth" is published: without it, it
+	 * takes the Mac default (PCIe, BCM_4350C2), fails "chip boot failure" and launchd restarts it every 10 s (the
+	 * installed system's menu boot of 21 Nov). The reason of the last failure is kern.qbt_firmware ("not up: ...").
+	 */
+	(void)PE_parse_boot_argn("icebt_retry", &retry, sizeof(retry));
+	if (!spmi_resolve()) {
+		retry = 0;                              /* no channel this kernel may write: nothing to try again */
+		ok = false;
+		why = "spmi";
+	}
+	for (uint32_t attempt = 0; why == NULL; attempt++) {
+		why = !pin_found() ? "pin" : !rails_take() ? "rails" : !se_probe() ? "engine" : NULL;
+		if (why == NULL) {
+			pads_log("before");
+			why = stop_req ? "stopped" : !bt_enable() ? "(a) bt-enable" : !stage_a() ? "(a) HCI" : NULL;
+		}
+		if (why == NULL && stage >= 2) {
+			why = stop_req ? "stopped" : !stage_b() ? "(b) download" : NULL;
+		}
+		ok = why == NULL;
+		if (ok && stage == 3 && !stop_req) {
+			ok = stage_c();
+		}
+		if (ok && stage >= 4 && node && !stop_req) {
+			served = true;
+			ok = stage_d();                 /* until the run ends */
+			why = ok || stop_req ? NULL : "(d) BD_ADDR";
+		}
+		if (why == NULL || stop_req || stage < 4 || !node || attempt >= retry) {
+			break;
+		}
+		snprintf(fw_label, sizeof(fw_label), "not up: %s (try %u of %u)", why, attempt + 1, retry + 1);
+		say("try %u of %u failed (%s): undone, again in 15 s (icebt_retry)\n", attempt + 1, retry + 1, why);
+		bt_down("a try failed");
+		done = 0;                               /* bt_down undid all of it: the next try starts from as found */
+		down_once = 0;
+		served = false;
+		for (uint32_t i = 0; i < 150 && !stop_req; i++) {
+			IOSleep(100);
+		}
+		why = stop_req ? "stopped" : NULL;
+	}
+	if (why != NULL) {
+		ok = false;
+		snprintf(fw_label, sizeof(fw_label), "not up: %s", why);
+	}
+	if (stage >= 4) {
+		if (!served || why != NULL) {
+			ok = false;
+			lck_mtx_lock(&sv_lock);
+			sv.gone = true;                 /* an opener waiting for the controller is told */
+			wakeup(&sv.up);
+			lck_mtx_unlock(&sv_lock);
+			say("(d) not served: %s\n", !node ? "no /dev/cu.BLTH" : why != NULL ? why : "stopped");
+		}
+	}
+	bt_down(ok ? "the stage's end" : "stopped");
+	say("ended: %s\n", ok ? "every stage asked for PASSED" : "see above");
+	if (nvm_copy != NULL) {
+		kfree_data(nvm_copy, NVM_MAX);
+		nvm_copy = NULL;
+	}
+	if (hb_seen != NULL) {
+		kfree_data(hb_seen, HB_SEEN_N * sizeof(*hb_seen));
+		hb_seen = NULL;
+	}
+	busy = 0;
+}
+
+/*
+ * ---- what the board's BlueTool reads ----
+ * macOS's bluetoothd asks the service com.apple.BlueTool to start the controller before it opens /dev/cu.BLTH. Apple's
+ * BlueTool has no boot script for this board and leaves (QEMU run 20261116-050631-w4bt-a43ea3c-bt4c-cpus8). The one in
+ * the add-on's sbin is UniXNU/QcaBluetooth's userland/BlueTool.c unchanged, which answers from three sysctls (its
+ * README, "Kernel interface"); these are they, over stage d's state. The controller is brought up by the stage, not by a
+ * request: a read waits (30 s at most) for it and says how it went. Without icebt=4 each read fails with ENXIO.
+ *   kern.qbt_power_on  0 once the controller is up for the node (a read, because BlueTool's sandbox denies writes)
+ *   kern.qbt_boot      the same state: 0 up, ENETDOWN (50) when the stage ended or failed
+ *   kern.qbt_firmware  the patched firmware's build string
+ */
+static int
+qbt_state(void)
+{
+	struct timespec ts = { 30, 0 };
+	int error = 0;
+
+	lck_mtx_lock(&sv_lock);
+	while (!sv.up && !sv.gone && error == 0) {
+		error = msleep(&sv.up, &sv_lock, PZERO | PCATCH, "icebt-qbt", &ts);
+	}
+	if (error == 0 && !sv.up) {
+		error = ENETDOWN;
+	}
+	lck_mtx_unlock(&sv_lock);
+	return error == EWOULDBLOCK ? EINPROGRESS : error;
+}
+
+static int
+qbt_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1)
+	static uint32_t told[2];
+	int value;
+
+	if (sv.node == NULL) {
+		return ENXIO;
+	}
+	if (req->newptr) {
+		return EPERM;
+	}
+	if (!req->oldptr) {
+		value = 0;
+		return SYSCTL_OUT(req, &value, sizeof(value));
+	}
+	value = qbt_state();
+	if (value == EINTR || value == ERESTART) {
+		return value;
+	}
+	if (told[arg2 & 1] < 6) {
+		told[arg2 & 1]++;
+		say("(d) kern.%s read by %s[%d]: %d\n", arg2 ? "qbt_power_on" : "qbt_boot", proc_best_name(current_proc()),
+		    proc_pid(current_proc()), value);
+	}
+	return SYSCTL_OUT(req, &value, sizeof(value));
+}
+SYSCTL_PROC(_kern, OID_AUTO, qbt_boot, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, qbt_sysctl, "I",
+    "icebt=4: the Bluetooth controller's state for BlueTool (0 = up)");
+SYSCTL_PROC(_kern, OID_AUTO, qbt_power_on, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 1, qbt_sysctl, "I",
+    "icebt=4: waits for the Bluetooth controller, 0 = up");
+SYSCTL_STRING(_kern, OID_AUTO, qbt_firmware, CTLFLAG_RD | CTLFLAG_LOCKED, fw_label, sizeof(fw_label),
+    "icebt=4: the Bluetooth firmware's build string");
+
+/* ---- entry points ---- */
+/* for kern.hv_vmm_present (bsd/kern/hvg_sysctl.c): 1 when the caller is bluetoothd or BlueTool and stage d is asked for.
+ * Boot-arg icebt_vmm=1 leaves the sysctl alone. */
+int hakios_iceland_bt_no_vmm(void);
+
+int
+hakios_iceland_bt_no_vmm(void)
+{
+	static uint32_t told;
+	const char *name;
+	uint32_t keep = 0;
+
+	if (sv.node == NULL || (PE_parse_boot_argn("icebt_vmm", &keep, sizeof(keep)) && keep != 0)) {
+		return 0;
+	}
+	name = proc_best_name(current_proc());
+	if (strncmp(name, "bluetoothd", 11) != 0 && strncmp(name, "BlueTool", 9) != 0) {
+		return 0;
+	}
+	if (told < 4) {
+		told++;
+		say("(d) kern.hv_vmm_present read by %s[%d]: told 0 (the tree says vmm-present)\n", name, proc_pid(current_proc()));
+	}
+	return 1;
+}
+
+void
+hakios_iceland_bt_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icebt", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	if (stage > 4) {
+		stage = 4;
+	}
+	if (psci_smp_hvc && stage < 4) {
+		say("PSCI is over hvc here: not the Pad, no WCN7860, nothing touched\n");
+		return;
+	}
+	sv.sim = psci_smp_hvc != 0;             /* QEMU: stage d against the stand-in controller, no hardware */
+	if (kernel_thread_start(icebt_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* the run's end, from a thread (reset-after): the stage ends at its next step and undoes itself; 5 s at most, then here */
+void
+hakios_iceland_bt_stop(void)
+{
+	stop_req = 1;
+	for (int i = 0; i < 100 && busy; i++) {
+		IOSleep(50);
+	}
+	bt_down(busy ? "stop, the stage did not end" : "stop");
+}
+
+/* from loader_return() (A3 re-entry, a panic's end): the undo, no waiting on a thread */
+void
+hakios_iceland_bt_quiesce(void)
+{
+	stop_req = 1;
+	quiesced = 1;
+	bt_down("quiesce");
+}
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/bsd/dev/hakios_iceland_buttons.c b/bsd/dev/hakios_iceland_buttons.c
new file mode 100644
index 0000000000000000000000000000000000000000..48a878c110f44ede2d3838a271b18d7b1c6f0d61
--- /dev/null
+++ b/bsd/dev/hakios_iceland_buttons.c
@@ -0,0 +1,988 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") keys -- power, volume up, volume down -- as button records for
+ * /dev/redwood-touch (sys/redwood_input.h). Only with boot-arg icebuttons=N; without it nothing here touches the
+ * hardware. The method is redwood_buttons.c's (HakiOS: poll the PMIC inputs through the arbiter's observer channels,
+ * a change believed after two looks in a row, a key believed only once it has been seen released); every value is the
+ * Pad's own:
+ *   pmk8850.dtsi                 PMK8850 on spmi_bus0, SID 0: pon@1300 "hlos" (qcom,pmk8350-pon): pwrkey = power,
+ *                                resin = volume up (kaanapali-oneplus-iceland.dts: &pon_resin { linux,code =
+ *                                KEY_VOLUMEUP })
+ *   kaanapali-oneplus-iceland.dts gpio-keys key-volume-down: <&pmh0101_gpios 6 GPIO_ACTIVE_LOW>, input with pull-up
+ *                                (key_vol_down_default); pmh0101.dtsi: PMH0101 on spmi_bus0, SID 1, gpio@8800 -- gpio6 is
+ *                                pin 5 (pinctrl-spmi-gpio: DT number - 1), registers 0x8d00
+ *   kaanapali.dtsi               arbiter@c400000 (qcom,glymur-spmi-pmic-arb = v8; Linux on this tablet: "PMIC arbiter
+ *                                version v8 (0x80000001)"): core 0xc400000, chnls 0xc900000, obsrvr 0xc4c0000, chnl_map
+ *                                0xc403000; spmi_bus0 cnfg 0xc426000, chnl_owner 0xc42a000; qcom,ee = 0
+ *   spmi-pmic-arb.c (v8)         apid counts per bus in core FEATURES + 4 * bus ([12:0]); bus 0's apids first; chnl_map
+ *                                + 4 * apid: [12:0] ppid (sid << 8 | peripheral), [31] irq owner; chnl_owner + 4 *
+ *                                (apid - base): [2:0] owner ee; observer channel = obsrvr + 0x40000 * ee + 0x20 * apid:
+ *                                CMD 0x00 = (op 1 "extended read long") << 27 | reg << 4 | (bytes - 1), STATUS 0x08
+ *                                ([0] done, [1] failed, [2] denied, [3] dropped), RDATA0 0x18, RDATA1 0x1c
+ *   pm8941-pwrkey.c              PON_RT_STS 0x10: [7] KPDPWR_N (power), [6] RESIN_N (volume up); type 0x01 subtype 0x09
+ *   pinctrl-spmi-gpio.c          GPIO type 0x10, LV/MV subtypes 0x10..0x15; RT_STS 0x10 [0] the level; MODE_CTL 0x40,
+ *                                DIG_PULL_CTL 0x42 ([2:0] 0..3 up, 4 down, 5 none), EN_CTL 0x46 ([7])
+ *
+ * READS, and only under iceskin=2 one write: the observer channels are read through their command words; the arming pass
+ * of iceskin=2 (below, the owner's yes) writes twelve staging bytes, two clear registers and the trigger of SID 0's SDAM
+ * page 0x090 and nothing else -- no other register of it, no other page, no other peripheral. Otherwise no PMIC write.
+ *
+ *   icebuttons=1  map the arbiter, read its version and bus 0's apid range
+ *   icebuttons=2  ... and find the two peripherals' channels
+ *   icebuttons=3  ... and read their type / subtype (the first SPMI transfers)
+ *   icebuttons=4  ... and how the inputs are set up, what they say now
+ *   icebuttons=5  ... and watch them every 16 ms, posting REDWOOD_BUTTON_LOCK / _VOLUME_UP / _VOLUME_DOWN; on macOS each
+ *                 change also goes to the HID keyboard (icehid=1): volume up and down as consumer keys
+ *   icebuttons_debounce=N  (w3-keys) a change is believed after N looks in a row that agree (2..8; default 3 = 48 ms).
+ *                 Three, not the two of before: on the same SoC a USB unplug disturbs PMK's PON real-time status for two
+ *                 polls, which two looks take for a power press (u0er/unixnu-xiaomi17u 009ae8a, xnu/patches/0479: a fact
+ *                 only, that tree has no licence). The shortest real press seen here was 170 ms (kbd-1, 15 Nov: 5 volume
+ *                 down, 3 volume up, 170..968 ms); 19 tablet runs with icebuttons=5 (13-15 Nov) logged no power press
+ *                 and no key under 100 ms. The summary counts every raw change of each input: a clean press is two
+ *                 (down, up), so "raw changes" above twice the presses is bounce the looks filtered out.
+ *   iceskin=1     read the PMK8850 ADC's thermal-monitor results (the shell's skin, board, chg-cp, wlan thermistors);
+ *                 READ ONLY -- Linux arms the ADC's TMs, so a warm reboot from Linux may show them, a cold PMIC 0
+ *   iceskin=2     ... and, once, about 25 s in, arm slots 1 (xo), 2 (board), 4 (wlan) and 6 (skin) of page 0x090: the
+ *                 owner's yes of 16 Nov 22:5x, these registers and nothing else -- 0x4f..0x5a (the twelve staging
+ *                 bytes), 0x4c and 0x4d (a slot's clear flags), 0xe5 (the trigger). Refused instead: 0x10..0x18 (the
+ *                 interrupt block), 0x40..0x44, 0xe6, any other register, page 0x091, any other peripheral, and an apid
+ *                 whose chnl_owner is not our ee 0. Guards: only when 0x47 (TM_EN_STS) reads 0x00 (a reboot from Linux
+ *                 may have armed them: then no writes at all), every staging byte read back and equal, the trigger
+ *                 confirmed by the handshake; a failure disarms what was armed so far. One pass, never retried: the
+ *                 thread goes on reading. A reset clears the arming (R2-R4 read TM_EN_STS 0 after every reboot).
+ *                 Linux: qcom-spmi-adc-tm5-gen3.c:212-285 (arm), :168-208 (disarm), qcom-spmi-adc5-gen3.c:176-214
+ *                 (handshake), qcom-adc5-gen3-common.h (the offsets).
+ * Lines go to the kernel log, prefixed "icebuttons:" ("iceskin:" for the ADC probe).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/param.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+#define say(...) printf("icebuttons: " __VA_ARGS__)
+#define say_skin(...) printf("iceskin: " __VA_ARGS__)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint32_t psci_smp_hvc;           /* osfmk/arm64/psci_smp.c: 1 = QEMU's virt, not the Pad */
+
+void hakios_iceland_buttons_init(void);
+#if defined(XNU_TARGET_OS_OSX)
+/* macOS: the keys as the HID keyboard's consumer keys (iokit/Native/IcelandHid/IcelandHidProbe.cpp; returns at once without icehid=1) */
+extern void iceland_hid_button(uint32_t button, int pressed);
+#endif
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+/* ---- the PMIC arbiter (v8) ------------------------------------------------------------------------------------- */
+
+#define ARB_CORE_PHYS           0x0c400000UL
+#define ARB_CORE_SIZE           0x3000UL
+#define ARB_CHNL_MAP_PHYS       0x0c403000UL
+#define ARB_CHNL_MAP_SIZE       0x8000UL
+#define ARB_BUS0_OWNER_PHYS     0x0c42a000UL    /* spmi_bus0 "chnl_owner" */
+#define ARB_BUS0_OWNER_SIZE     0x8000UL
+#define ARB_OBSERVER_PHYS       0x0c4c0000UL
+#define ARB_CHNLS_PHYS          0x0c900000UL    /* the write channels, 0x200 each (hakios_iceland_camera.c's sp_write) */
+#define ARB_EE                  0               /* qcom,ee */
+#define ARB_OBSERVER_SIZE       0x40000UL       /* ee 0's observer channels */
+#define ARB_VERSION             0x000
+#define ARB_FEATURES(bus)       (0x004 + 4 * (bus))
+#define ARB_VERSION_8           0x80000000u
+#define ARB_VERSION_9           0x90000000u
+#define ARB_MAX_APIDS           8192
+
+#define OBS_CMD                 0x00
+#define OBS_STATUS              0x08
+#define OBS_RDATA0              0x18
+#define OBS_RDATA1              0x1c
+#define STATUS_DONE             0x1
+#define STATUS_ERRORS           0xfe
+#define CMD_READ                (1u << 27)      /* PMIC_ARB_OP_EXT_READL */
+#define READ_TIMEOUT_US         1000            /* PMIC_ARB_TIMEOUT_US */
+
+static vm_offset_t arb_core, arb_map, arb_owner, arb_obs;
+static uint32_t bus0_apids;
+
+struct peripheral {
+	const char *name;
+	uint16_t ppid;                          /* sid << 8 | peripheral */
+	uint16_t apid;
+	uint8_t owner;                          /* its chnl_owner's ee, as find_apid read it */
+	bool found;
+};
+static struct peripheral pon = { .name = "PMK8850 PON (hlos)", .ppid = 0x013 };     /* SID 0, 0x1300 */
+static struct peripheral pin = { .name = "PMH0101 gpio6", .ppid = 0x18d };          /* SID 1, 0x8d00 */
+static struct peripheral vadc0 = { .name = "PMK8850 vadc 0x90", .ppid = 0x090 };    /* SID 0, SDAM page 0x90 */
+static struct peripheral vadc1 = { .name = "PMK8850 vadc 0x91", .ppid = 0x091 };    /* SID 0, SDAM page 0x91 */
+
+static struct {
+	uint64_t reads, failed, total_ns, longest_ns, last_ns;
+} bus;
+
+/*
+ * The arbiter and bus 0's channel tables, mapped and checked once for both threads here: the buttons' steps and
+ * iceskin's reads. arb_state: 0 not begun, 1 in progress, 2 mapped, 3 failed. The caller that is not first waits
+ * 10 ms at a time -- both are kernel threads, so delay_for_interval is the wait -- until the first says which.
+ * `who` ends the failure lines ("no buttons", "no iceskin"). ONLY READS: the core's registers and the tables.
+ */
+static volatile uint32_t arb_state;
+
+static bool
+arb_setup(const char *who)
+{
+	uint32_t state = 0, version;
+
+	if (!__atomic_compare_exchange_n(&arb_state, &state, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		while (__atomic_load_n(&arb_state, __ATOMIC_ACQUIRE) == 1) {
+			delay_for_interval(10, NSEC_PER_MSEC);
+		}
+		return arb_state == 2;
+	}
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	if (arb_core != 0) {
+		version = rd(arb_core + ARB_VERSION);
+		bus0_apids = rd(arb_core + ARB_FEATURES(0)) & 0x1fff;
+		say("arbiter version %#x; bus 0: %u apids (from 0), bus 1: %u\n", version, bus0_apids,
+		    rd(arb_core + ARB_FEATURES(1)) & 0x1fff);
+		if (version < ARB_VERSION_8 || version >= ARB_VERSION_9) {
+			say("not a version 8 arbiter: %s\n", who);
+		} else if (bus0_apids == 0 || bus0_apids > ARB_MAX_APIDS || bus0_apids * 4 > ARB_CHNL_MAP_SIZE ||
+		    bus0_apids * 0x20 > ARB_OBSERVER_SIZE) {
+			say("bus 0's apid count %u is out of range: %s\n", bus0_apids, who);
+		} else {
+			arb_map = ml_io_map(ARB_CHNL_MAP_PHYS, ARB_CHNL_MAP_SIZE);
+			arb_owner = ml_io_map(ARB_BUS0_OWNER_PHYS, ARB_BUS0_OWNER_SIZE);
+			arb_obs = ml_io_map(ARB_OBSERVER_PHYS + 0x40000UL * ARB_EE, ARB_OBSERVER_SIZE);
+			if (arb_map != 0 && arb_owner != 0 && arb_obs != 0) {
+				__atomic_store_n(&arb_state, 2, __ATOMIC_RELEASE);
+				return true;
+			}
+			say("no memory for the arbiter's registers: %s\n", who);
+		}
+	}
+	__atomic_store_n(&arb_state, 3, __ATOMIC_RELEASE);
+	return false;
+}
+
+static const char *
+spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count, uint32_t *status_out)
+{
+	vm_offset_t ch = arb_obs + 0x20UL * p->apid;
+	uint64_t start = mach_absolute_time(), now, limit, taken;
+	uint32_t status, data[2];
+	const char *problem = NULL;
+
+	nanoseconds_to_absolutetime(READ_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &limit);
+	redwood_spmi_lock();
+	wr(ch + OBS_CMD, CMD_READ | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(ch + OBS_STATUS);
+		now = mach_absolute_time();
+	} while (!(status & STATUS_DONE) && now - start < limit);
+	data[0] = rd(ch + OBS_RDATA0);
+	data[1] = count > 4 ? rd(ch + OBS_RDATA1) : 0;
+	redwood_spmi_unlock();
+
+	if (status_out) {
+		*status_out = status;
+	}
+	if (!(status & STATUS_DONE)) {
+		problem = "no answer from the arbiter";
+	} else if (status & 0x4) {
+		problem = "denied";
+	} else if (status & 0x2) {
+		problem = "failed (nobody at that address?)";
+	} else if (status & 0x8) {
+		problem = "dropped";
+	} else if (status & STATUS_ERRORS) {
+		problem = "an error bit";
+	} else {
+		for (uint32_t i = 0; i < count; i++) {
+			bytes[i] = (uint8_t)(data[i / 4] >> (8 * (i % 4)));
+		}
+	}
+	absolutetime_to_nanoseconds(now - start, &taken);
+	bus.reads++;
+	bus.total_ns += taken;
+	bus.last_ns = taken;
+	if (taken > bus.longest_ns) {
+		bus.longest_ns = taken;
+	}
+	if (problem != NULL) {
+		bus.failed++;
+	}
+	return problem;
+}
+
+/* _pmic_arb_read_apid_map: the first apid of the ppid, unless a later one is written by our ee */
+static void
+find_apid(struct peripheral *p)
+{
+	for (uint32_t apid = 0; apid < bus0_apids; apid++) {
+		uint32_t map = rd(arb_map + 4UL * apid), owner;
+
+		if (map == 0 || (map & 0x1fff) != p->ppid) {
+			continue;
+		}
+		owner = rd(arb_owner + 4UL * apid) & 7;
+		say("apid %u is %s (map %#x): written by ee %u%s\n", apid, p->name, map, owner,
+		    (map & 0x80000000u) ? ", irq owner" : "");
+		if (!p->found || owner == ARB_EE) {
+			p->found = true;
+			p->apid = (uint16_t)apid;
+			p->owner = (uint8_t)owner;
+		}
+	}
+	if (!p->found) {
+		say("no apid on bus 0 is %s (ppid %#x)\n", p->name, p->ppid);
+	}
+}
+
+static bool
+identify(const struct peripheral *p, uint8_t type, uint8_t sub_from, uint8_t sub_to)
+{
+	uint8_t is[2];
+	uint32_t status;
+	const char *problem;
+
+	if (!p->found) {
+		return false;
+	}
+	problem = spmi_read(p, 0x04, is, 2, &status);
+	if (problem != NULL) {
+		say("%s: reading its type: %s (status %#x)\n", p->name, problem, status);
+		return false;
+	}
+	say("%s: type %#x, subtype %#x (%llu us)\n", p->name, is[0], is[1], bus.last_ns / 1000);
+	if (is[0] != type || is[1] < sub_from || is[1] > sub_to) {
+		say("%s: not the expected type %#x / subtype %#x..%#x: left alone\n", p->name, type, sub_from, sub_to);
+		return false;
+	}
+	return true;
+}
+
+/* ---- the keys --------------------------------------------------------------------------------------------------- */
+
+#define PON_KPDPWR              0x80
+#define PON_RESIN               0x40
+#define GPIO_LEVEL              0x01
+#define POLL_MS                 16
+
+static uint32_t debounce_looks = 3;     /* icebuttons_debounce */
+
+static struct button {
+	const char *name;
+	uint32_t record;
+	bool usable, live, last, down;
+	uint64_t since;
+	uint32_t presses;
+	uint32_t same, flips;                   /* looks in a row that agree; raw changes of the input since it is believed */
+} power = { .name = "power", .record = REDWOOD_BUTTON_LOCK },
+    volume_up = { .name = "volume up", .record = REDWOOD_BUTTON_VOLUME_UP },
+    volume_down = { .name = "volume down", .record = REDWOOD_BUTTON_VOLUME_DOWN };
+
+static void
+look(struct button *b, bool pressed)
+{
+	uint64_t now = mach_absolute_time(), held, up;
+	bool steady;
+
+	if (pressed == b->last) {
+		b->same++;
+	} else {
+		b->same = 1;
+		if (b->live) {
+			b->flips++;
+		}
+	}
+	steady = b->same >= debounce_looks;
+	b->last = pressed;
+	if (!b->usable || !steady) {
+		return;
+	}
+	if (!b->live) {
+		if (!pressed) {
+			b->live = true;
+			say("%s is released now: believed from here on\n", b->name);
+		}
+		return;
+	}
+	if (pressed == b->down) {
+		return;
+	}
+	b->down = pressed;
+	absolutetime_to_nanoseconds(now, &up);
+	if (pressed) {
+		b->since = now;
+		b->presses++;
+		say("%s PRESSED at %llu.%03llu s\n", b->name, up / NSEC_PER_SEC, up / NSEC_PER_MSEC % 1000);
+	} else {
+		absolutetime_to_nanoseconds(now - b->since, &held);
+		say("%s released at %llu.%03llu s, after %llu ms\n", b->name, up / NSEC_PER_SEC, up / NSEC_PER_MSEC % 1000,
+		    held / NSEC_PER_MSEC);
+	}
+	redwood_touch_post(pressed ? REDWOOD_BUTTON_DOWN : REDWOOD_BUTTON_UP, b->record, 0, 0);
+#if defined(XNU_TARGET_OS_OSX)
+	/* volume up / down: consumer usages 0xE9 / 0xEA; power is left out there unless icehid_power=1 (or 2..4: shortcuts) */
+	iceland_hid_button(b->record, pressed);
+	if (pressed) {
+		extern void hakios_user_active(const char *why);
+
+		hakios_user_active(b->name);    /* gains1 (P1): a dark display asks powerd for the user (IOPMrootDomain.cpp) */
+	}
+#endif
+}
+
+static void
+pon_setup(void)
+{
+	uint8_t r[8];
+	const char *problem = spmi_read(&pon, 0x10, r, 8, NULL);
+
+	if (problem != NULL) {
+		say("%s: %s\n", pon.name, problem);
+		return;
+	}
+	say("PON: status %#x (power %s, volume up %s); interrupts: type %#x, high %#x, low %#x, enabled %#x\n", r[0],
+	    (r[0] & PON_KPDPWR) ? "HELD" : "released", (r[0] & PON_RESIN) ? "HELD" : "released", r[1], r[2], r[3], r[5]);
+	power.usable = volume_up.usable = true;
+	power.last = r[0] & PON_KPDPWR;
+	volume_up.last = r[0] & PON_RESIN;
+}
+
+static void
+pin_setup(void)
+{
+	uint8_t c[8], status = 0;
+	unsigned mode, pull;
+	const char *problem = spmi_read(&pin, 0x40, c, 8, NULL);
+
+	if (problem == NULL) {
+		problem = spmi_read(&pin, 0x10, &status, 1, NULL);
+	}
+	if (problem != NULL) {
+		say("%s: %s\n", pin.name, problem);
+		return;
+	}
+	mode = c[0] & 3;
+	pull = c[2] & 7;
+	say("volume down's pin: mode %u, vin %u, pull %u, %s; 0x40.. %02x %02x %02x %02x %02x %02x %02x %02x; level %s\n",
+	    mode, c[1] & 7, pull, (c[6] & 0x80) ? "enabled" : "DISABLED", c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7],
+	    (status & GPIO_LEVEL) ? "high (released)" : "LOW (held)");
+	if ((mode != 0 && mode != 2) || pull >= 4 || !(c[6] & 0x80)) {
+		say("volume down's pin is not an enabled input with a pull-up; making it one is a PMIC write, not done here: "
+		    "volume down left alone\n");
+		return;
+	}
+	volume_down.usable = true;
+	volume_down.last = !(status & GPIO_LEVEL);
+}
+
+static void
+poll_once(void)
+{
+	static unsigned said;
+	uint8_t s;
+	const char *problem;
+
+	if (power.usable) {
+		problem = spmi_read(&pon, 0x10, &s, 1, NULL);
+		if (problem == NULL) {
+			look(&power, s & PON_KPDPWR);
+			look(&volume_up, s & PON_RESIN);
+		} else if (said++ < 8) {
+			say("reading %s: %s\n", pon.name, problem);
+		}
+	}
+	if (volume_down.usable) {
+		problem = spmi_read(&pin, 0x10, &s, 1, NULL);
+		if (problem == NULL) {
+			look(&volume_down, !(s & GPIO_LEVEL));
+		} else if (said++ < 8) {
+			say("reading %s: %s\n", pin.name, problem);
+		}
+	}
+}
+
+static void
+summary(void)
+{
+	say("so far %u power, %u volume up, %u volume down presses; %llu reads, %llu us each (longest %llu), %llu failed\n",
+	    power.presses, volume_up.presses, volume_down.presses, bus.reads, bus.reads ? bus.total_ns / bus.reads / 1000 : 0,
+	    bus.longest_ns / 1000, bus.failed);
+	if (power.flips + volume_up.flips + volume_down.flips != 0) {
+		say("raw changes: power %u, volume up %u, volume down %u (two a clean press; more is bounce filtered by %u looks)\n",
+		    power.flips, volume_up.flips, volume_down.flips, debounce_looks);
+	}
+}
+
+static void
+icebuttons_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t steps = (uint32_t)(uintptr_t)parameter;
+	bool pon_ok, pin_ok;
+
+	say("step 1: the arbiter (core %#lx, chnl_map %#lx, bus 0 owners %#lx, observer %#lx)\n", ARB_CORE_PHYS,
+	    ARB_CHNL_MAP_PHYS, ARB_BUS0_OWNER_PHYS, ARB_OBSERVER_PHYS);
+	if (!arb_setup("no buttons")) {
+		return;
+	}
+	if (steps < 2) {
+		return;
+	}
+	say("step 2: the peripherals' channels\n");
+	find_apid(&pon);
+	find_apid(&pin);
+	if (steps < 3) {
+		return;
+	}
+	say("step 3: what they are\n");
+	pon_ok = identify(&pon, 0x01, 0x09, 0x09);
+	pin_ok = identify(&pin, 0x10, 0x10, 0x15);
+	if (steps < 4) {
+		return;
+	}
+	say("step 4: the inputs\n");
+	if (pon_ok) {
+		pon_setup();
+	}
+	if (pin_ok) {
+		pin_setup();
+	}
+	if (!power.usable && !volume_down.usable) {
+		say("nothing readable: no buttons\n");
+		return;
+	}
+	power.live = power.usable && !power.last;
+	volume_up.live = volume_up.usable && !volume_up.last;
+	volume_down.live = volume_down.usable && !volume_down.last;
+	if (power.last || volume_up.last || volume_down.last) {
+		say("held before watching:%s%s%s (believed once released)\n", power.last ? " power" : "",
+		    volume_up.last ? " volume-up" : "", volume_down.last ? " volume-down" : "");
+	}
+	if (steps < 5) {
+		summary();
+		return;
+	}
+	say("step 5: watching%s%s%s every %u ms (power = the lock button)\n", power.usable ? " power" : "",
+	    volume_up.usable ? " volume-up" : "", volume_down.usable ? " volume-down" : "", POLL_MS);
+	for (unsigned tick = 1;; tick++) {
+		poll_once();
+		if (tick % (60 * 1000 / POLL_MS) == 0 || tick == 10 * 1000 / POLL_MS) {
+			summary();
+		}
+		if (bus.failed >= 1000 && bus.failed * 2 > bus.reads) {
+			say("more than half of %llu reads failed: giving up\n", bus.reads);
+			return;
+		}
+		delay_for_interval(POLL_MS, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- the ADC's thermal monitors (iceskin) ----------------------------------------------------------------------- */
+
+/*
+ * iceskin: the shell's thermistors through the PMK8850's ADC (Linux's pmk8850 vadc, on the SPMI SDAM pages 0x90 and
+ * 0x91), read through the same observer channels; written to only under iceskin=2 (the arming below). Page 0x90's slots
+ * as Linux's thermal monitor arms them: 1 xo, 2 board, 3 flash, 4 wlan, 5 chg_cp, 6 skin, 7 usb_therm (slot 0 is the
+ * shared immediate-conversion slot, ignored); page 0x91's 0 and 1: usb_temp_l / usb_temp_r.
+ */
+#define VADC_HS                 0x45                    /* handshake: [0] ready */
+#define VADC_TM_EN_STS          0x47                    /* [n] slot n armed */
+#define VADC_SLOT(n)            (0x5c + 2 * (n))        /* result slot n: a u16, little endian */
+#define VADC_CLR_HI             0x4c                    /* a slot's high-threshold flag, [n] = slot n: write 1 to clear */
+#define VADC_CLR_LO             0x4d                    /* its low-threshold flag */
+#define VADC_STAGE              0x4f                    /* 0x4f..0x5a: the twelve staging bytes a trigger consumes */
+#define VADC_TM_CTL             0x50                    /* [7] enabled, [2:0] the slot */
+#define VADC_TM_INTERVAL        0x51                    /* the measurement interval's index */
+#define VADC_DIG_PARAM          0x52                    /* [5:4] CAL_SEL, [3:2] DEC_RATIO_SEL */
+#define VADC_CONV_REQ           0xe5                    /* the PBS trigger; it self-clears */
+#define VADC_HS_TRIES           150                     /* Linux's 150 x 100 us = 15 ms */
+#define VADC_HS_US              100
+
+/* page 0x90's four slots as Linux's thermal monitor arms them, in the owner's order: slot, AMUX channel, SID byte */
+static const struct tm_slot {
+	uint8_t slot, chan, sid;
+	const char *what;
+} tm_slots[] = {
+	{ 1, 0x44, 0x00, "xo" },
+	{ 2, 0x48, 0x01, "board" },
+	{ 4, 0x46, 0x01, "wlan" },
+	{ 6, 0x44, 0x01, "skin" },
+};
+#define TM_SLOTS                (sizeof(tm_slots) / sizeof(tm_slots[0]))
+
+static vm_offset_t vadc_chnl;                           /* page 0x90's write channel, mapped at its first write */
+/* the proof of the allow-list: every write command sent, counted per register of page 0x90, and the refusals */
+static uint16_t skin_wcount[256];
+static uint32_t skin_refused;
+
+/* one line: each register of page 0x90 written and how often, the refusals; skin_write is this file's only write path */
+static void
+skin_writes_report(void)
+{
+	char line[200];
+	int at = 0;
+	uint32_t total = 0;
+
+	line[0] = 0;                            /* (snprintf terminates each piece; nothing written: an empty list) */
+
+	for (unsigned reg = 0; reg < 256 && at >= 0 && (size_t)at < sizeof(line); reg++) {
+		if (skin_wcount[reg] != 0) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %02x:%u", reg, skin_wcount[reg]);
+			total += skin_wcount[reg];
+		}
+	}
+	say_skin("writes to page 0x90: %u (reg:count)%s; refused %u; no other page or peripheral\n", total, line,
+	    skin_refused);
+}
+
+static uint32_t therm_ohm[5];                           /* skin, board, chg_cp, wlan, xo: as last read; 0 = none */
+
+/* slot n's thermistor in ohms, a fraction of a 100 kOhm pull-up: code 0 = nothing measured, 0xffff = open */
+static uint32_t
+ntc_ohm(const uint8_t *b)
+{
+	uint32_t code = (uint32_t)b[0] | (uint32_t)b[1] << 8;
+	uint64_t ohm;
+
+	if (code == 0) {
+		return 0;
+	}
+	if (code == 0xffff) {
+		return 0xffffffffu;
+	}
+	ohm = (uint64_t)code * 100000 / (65535 - code);
+	return ohm > 0xffffffffu ? 0xffffffffu : (uint32_t)ohm;
+}
+
+/* one read for the probe: on a problem one short line (at most 10 of them) and false; the next look comes anyway */
+static bool
+skin_read(const struct peripheral *p, uint8_t page, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	static unsigned said;
+	const char *problem = spmi_read(p, reg, bytes, count, NULL);
+
+	if (problem == NULL) {
+		return true;
+	}
+	if (said++ < 10) {
+		say_skin("reading %#x reg %#x: %s\n", page, reg, problem);
+	}
+	return false;
+}
+
+/* ---- iceskin=2's arming: the one write this file has ------------------------------------------------------------ */
+
+/*
+ * The owner approved exactly these writes to the PMK8850's ADC page 0x090 (SID 0, ppid 0x090; never page 0x091, never
+ * another peripheral): the twelve staging bytes 0x4f..0x5a, the two clear registers 0x4c / 0x4d, and the trigger 0xe5.
+ * The allow-list is in skin_writable(): anything else is refused before a channel is even mapped, so no other register
+ * of the page (0x10..0x18 the interrupt block, 0x40..0x44, 0xe6) can be written by a mistake here.
+ */
+
+/* a command's status word, polled (no sleep: the bus lock is held) for at most 1 ms, as PMIC_ARB_TIMEOUT_US */
+static uint32_t
+chnl_done(vm_offset_t status_reg)
+{
+	uint64_t limit, start = mach_absolute_time();
+	uint32_t status;
+
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &limit);
+	do {
+		status = rd(status_reg);
+	} while (!(status & 1) && mach_absolute_time() - start < limit);
+	return status;
+}
+
+/* the owner's list of registers, and only page 0x090's: the staging block, a slot's two clear flags, the trigger */
+static bool
+skin_writable(uint8_t reg)
+{
+	return (reg >= VADC_STAGE && reg <= 0x5a) || reg == VADC_CLR_HI || reg == VADC_CLR_LO || reg == VADC_CONV_REQ;
+}
+
+/* one byte to page 0x90, hakios_iceland_camera.c's sp_write: only to the apps' channel, true only on status exactly 1 */
+static bool
+skin_write(uint8_t reg, uint8_t val)
+{
+	vm_offset_t ch;
+	uint32_t status;
+
+	if (!skin_writable(reg)) {
+		skin_refused++;
+		say_skin("reg %#x <- %02x REFUSED: not an approved register\n", reg, val);
+		return false;
+	}
+	if (!vadc0.found || vadc0.owner != ARB_EE) {
+		skin_refused++;
+		say_skin("reg %#x <- %02x REFUSED: not the apps' page\n", reg, val);
+		return false;
+	}
+	skin_wcount[reg]++;                     /* every write command sent to the PMIC, by register (the summary line) */
+	if (vadc_chnl == 0) {
+		vm_offset_t phys = ARB_CHNLS_PHYS + 0x200UL * vadc0.apid, page = phys & ~(vm_offset_t)PAGE_MASK;
+		vm_offset_t v = ml_io_map(page, PAGE_SIZE);
+
+		if (v == 0) {
+			say_skin("page 0x90's write channel is not mapped: no write\n");
+			return false;
+		}
+		vadc_chnl = v + (phys - page);
+	}
+	ch = vadc_chnl;
+	redwood_spmi_lock();
+	wr(ch + 0x10, val);
+	wr(ch + 0x00, (uint32_t)reg << 4);                              /* EXT_WRITEL, one byte */
+	status = chnl_done(ch + 0x08);
+	redwood_spmi_unlock();
+	if (status != 1) {
+		say_skin("reg %#x <- %02x: status %#x\n", reg, val, status);
+	}
+	return status == 1;
+}
+
+/* one byte of page 0x90 through the observer, as the read loop reads */
+static bool
+skin_byte(uint8_t reg, uint8_t *val)
+{
+	return skin_read(&vadc0, 0x90, reg, val, 1);
+}
+
+/* a staging byte: written, then read back through the observer; the difference is the failure */
+static bool
+skin_write_back(uint8_t reg, uint8_t val)
+{
+	uint8_t back = 0;
+
+	if (!skin_write(reg, val)) {
+		return false;
+	}
+	if (!skin_byte(reg, &back)) {
+		return false;
+	}
+	if (back != val) {
+		say_skin("reg %#x: %02x reads %02x\n", reg, val, back);
+		return false;
+	}
+	return true;
+}
+
+/* Linux's vadc_handshake (qcom-spmi-adc5-gen3.c:176-214): ready 1 and the trigger consumed 0, 100 us apart, 150 tries */
+static bool
+wait_hs(void)
+{
+	uint8_t hs = 0, req = 0;
+
+	for (unsigned tries = 0; tries < VADC_HS_TRIES; tries++) {
+		if (skin_byte(VADC_HS, &hs) && skin_byte(VADC_CONV_REQ, &req) && hs == 0x01 && req == 0x00) {
+			return true;
+		}
+		delay_for_interval(VADC_HS_US, NSEC_PER_USEC);
+	}
+	return false;
+}
+
+/*
+ * One slot as qcom-spmi-adc-tm5-gen3.c:212-285 arms it: the twelve staging bytes (each read back), the trigger (no read
+ * back: it self-clears), then the handshake again -- E5 back to 0 is the trigger consumed. `step` names where it stopped.
+ */
+static bool
+arm_slot(const struct tm_slot *s, const char **step)
+{
+	struct {
+		uint8_t reg, val;
+	} block[] = {
+		{ VADC_STAGE, s->sid },                                 /* TM_SID: the page's SID byte */
+		{ VADC_TM_CTL, 0x80 | s->slot },                        /* enabled, this slot */
+		{ VADC_TM_INTERVAL, 0x04 },                             /* 1 s */
+		{ VADC_DIG_PARAM, 0x00 },                               /* below: the byte as it reads, two fields set */
+		{ 0x53, 0x80 },                                         /* FAST_AVG enable */
+		{ 0x54, s->chan },                                      /* the AMUX channel */
+		{ 0x55, 0x02 },                                         /* settle: 200 us */
+		{ 0x56, 0x00 },                                         /* CH_EN: no threshold interrupt */
+		{ 0x57, 0x00 },
+		{ 0x58, 0x00 },
+		{ 0x59, 0x00 },
+		{ 0x5a, 0xf0 },
+	};
+	uint8_t dig = 0;
+
+	*step = "the handshake before it";
+	if (!wait_hs()) {
+		return false;
+	}
+	*step = "its DIG_PARAM";
+	if (!skin_byte(VADC_DIG_PARAM, &dig)) {
+		return false;
+	}
+	dig = (uint8_t)((dig & ~0x3cu) | 0x10 | 0x04);                  /* CAL_SEL 1 = ratiometric, DEC_RATIO_SEL 1 */
+	block[3].val = dig;
+	*step = "a staging byte";
+	for (unsigned i = 0; i < sizeof(block) / sizeof(block[0]); i++) {
+		if (!skin_write_back(block[i].reg, block[i].val)) {
+			return false;
+		}
+	}
+	*step = "the trigger";
+	if (!skin_write(VADC_CONV_REQ, 0x01)) {
+		return false;
+	}
+	*step = "the handshake after the trigger";
+	return wait_hs();
+}
+
+/* adc_tm5_gen3_disable_channel (qcom-spmi-adc-tm5-gen3.c:168-208) for each slot armed so far, in its order */
+static void
+skin_disarm(uint32_t armed)
+{
+	for (uint8_t slot = 0; slot < 8; slot++) {
+		bool ok = true;
+
+		if (!(armed & 1u << slot)) {
+			continue;
+		}
+		if (!wait_hs()) {
+			ok = false;
+		}
+		if (ok) {
+			ok = skin_write(VADC_CLR_HI, 1u << slot) && skin_write(VADC_CLR_LO, 1u << slot) &&
+			    skin_write(VADC_TM_INTERVAL, 0x00) && skin_write(VADC_TM_CTL, 0x80 | slot) &&
+			    skin_write(VADC_CONV_REQ, 0x01);
+		}
+		if (ok) {
+			ok = wait_hs();
+		}
+		if (ok) {
+			say_skin("disarmed slot %u\n", slot);
+		} else {
+			say_skin("slot %u: not disarmed\n", slot);
+		}
+	}
+}
+
+/*
+ * iceskin=2's one arming pass (the owner's yes, 16 Nov 22:5x), before the read loop: the guards first, then the four
+ * slots in order, then the check (TM_EN_STS's four bits, 2.5 s later a non-zero result in each slot). Any failure disarms
+ * what was armed and stops: one pass, no retry, and the thread reads on. A reset clears the arming.
+ */
+static bool
+skin_arm(void)
+{
+	uint32_t armed = 0;
+	uint8_t sts = 0, r[2];
+	const char *step = "";
+	bool ok = true;
+
+	if (psci_smp_hvc != 0) {
+		say_skin("PSCI over hvc: not the Pad, no arming\n");
+		return false;
+	}
+	if (!vadc0.found || vadc0.owner != ARB_EE) {
+		say_skin("not the apps' page: no arming\n");
+		return false;
+	}
+	if (!skin_byte(VADC_TM_EN_STS, &sts)) {
+		return false;
+	}
+	if (sts != 0x00) {
+		say_skin("TM already armed (%02x): no writes\n", sts);
+		return false;
+	}
+	say_skin("TM_EN_STS before: %02x; arming slots 1 2 4 6\n", sts);
+	for (unsigned i = 0; i < TM_SLOTS; i++) {
+		/* counted as armed before the attempt: a slot that fails at or after its trigger is disarmed too (the
+		 * disable sequence on a slot that was never armed only rewrites the staging block and triggers once more) */
+		armed |= 1u << tm_slots[i].slot;
+		if (!arm_slot(&tm_slots[i], &step)) {
+			say_skin("slot %u (%s): %s: not armed\n", tm_slots[i].slot, tm_slots[i].what, step);
+			ok = false;
+			break;
+		}
+	}
+	if (ok && !skin_byte(VADC_TM_EN_STS, &sts)) {
+		ok = false;
+	}
+	if (ok && (sts & 0x56) != 0x56) {
+		say_skin("TM_EN_STS %02x, not 0x56: not armed\n", sts);
+		ok = false;
+	}
+	if (ok) {
+		delay_for_interval(2500, NSEC_PER_MSEC);
+		for (unsigned i = 0; i < TM_SLOTS; i++) {
+			if (!skin_read(&vadc0, 0x90, VADC_SLOT(tm_slots[i].slot), r, 2) || (r[0] == 0 && r[1] == 0)) {
+				say_skin("slot %u (%s) has no result: not armed\n", tm_slots[i].slot, tm_slots[i].what);
+				ok = false;
+				break;
+			}
+		}
+	}
+	if (!ok) {
+		skin_disarm(armed);
+		if (skin_byte(VADC_TM_EN_STS, &sts)) {
+			say_skin("TM_EN_STS after the disarm: %02x\n", sts);
+		}
+		skin_writes_report();
+		return false;
+	}
+	say_skin("armed slots 1 2 4 6 (TM_EN_STS after: %02x)\n", sts);
+	skin_writes_report();
+	return true;
+}
+
+static void
+iceskin_thread(void *parameter, __unused wait_result_t result)
+{
+	uint8_t h[3], a[8], b[8], tm1, u[4];
+	uint32_t v[8], level = (uint32_t)(uintptr_t)parameter;
+	const char *how = "read only (no PMIC write)";
+	unsigned lines = 0;
+
+	delay_for_interval(25, NSEC_PER_SEC);   /* (the buttons have had the arbiter by then; the PMIC is long up) */
+	/* QEMU's virt machine (PSCI over HVC) has no SPMI arbiter at these addresses: nothing is mapped, read or written */
+	if (psci_smp_hvc != 0) {
+		say_skin("PSCI over hvc: not the Pad, nothing mapped, read or written\n");
+		return;
+	}
+	if (!arb_setup("no iceskin")) {
+		say_skin("no arbiter: nothing to read\n");
+		return;
+	}
+	find_apid(&vadc0);
+	find_apid(&vadc1);
+	if (!vadc0.found || !vadc1.found) {
+		say_skin("the ADC is not on bus 0: nothing to read\n");
+		return;
+	}
+	if (level >= 2 && skin_arm()) {
+		how = "slots 1 2 4 6 armed by us";
+	}
+	say_skin("the ADC's thermal monitors every 5 s, %s\n", how);
+	for (;;) {
+		if (skin_read(&vadc0, 0x90, VADC_HS, h, 3) &&                /* 0x45..0x47 */
+		    skin_read(&vadc0, 0x90, VADC_SLOT(0), a, 8) &&           /* slots 0..3 */
+		    skin_read(&vadc0, 0x90, VADC_SLOT(4), b, 8) &&           /* slots 4..7 */
+		    skin_read(&vadc1, 0x91, VADC_TM_EN_STS, &tm1, 1) &&
+		    skin_read(&vadc1, 0x91, VADC_SLOT(0), u, 4)) {           /* usb_temp_l, usb_temp_r */
+			for (unsigned n = 0; n < 4; n++) {
+				v[n] = ntc_ohm(&a[2 * n]);
+				v[4 + n] = ntc_ohm(&b[2 * n]);
+			}
+			therm_ohm[0] = v[6];            /* skin */
+			therm_ohm[1] = v[2];            /* board */
+			therm_ohm[2] = v[5];            /* the charge pump */
+			therm_ohm[3] = v[4];            /* wlan */
+			therm_ohm[4] = v[1];            /* xo */
+			say_skin("hs %02x tm %02x/%02x xo %u board %u wlan %u cp %u skin %u usb %u %u %u (ohm)\n", h[0], h[2],
+			    tm1, v[1], v[2], v[4], v[5], v[6], v[7], ntc_ohm(&u[0]), ntc_ohm(&u[2]));
+		}
+		lines++;
+		delay_for_interval(lines < 60 ? 5000 : 30000, NSEC_PER_MSEC);
+	}
+}
+
+/* the thermistors as last read (0 skin, 1 board, 2 chg_cp, 3 wlan, 4 xo; 0 = no reading), for later use */
+uint32_t hakios_iceland_skin_ohm(unsigned which);
+uint32_t
+hakios_iceland_skin_ohm(unsigned which)
+{
+	return which < 5 ? therm_ohm[which] : 0;
+}
+
+/*
+ * w5-shell: the thermistors' temperatures. The 100 kOhm NTC's resistance at each whole degree from -40 C (row i = -40 + i
+ * C), the owner's Linux's adcmap7_100k (a2e1ea44d3c3 drivers/iio/adc/qcom-vadc-common.c:121-; its y is the temperature x
+ * 1024, so a Linux reading is 2.4 % high; here the degree is the row). Plain static: __TEXT has little room. Linux's
+ * qcom_vadc_map_voltage_temp interpolates linearly between two rows; so does this.
+ */
+static uint32_t ntc100k_ohm[] = {
+	4250657, 3962085, 3694875, 3447322, 3217867, 3005082, 2807660, 2624405,
+	2454218, 2296094, 2149108, 2012414, 1885232, 1766846, 1656598, 1553884,
+	1458147, 1368873, 1285590, 1207863, 1135290, 1067501, 1004155, 944935,
+	889550, 837731, 789229, 743813, 701271, 661405, 624032, 588982,
+	556100, 525239, 496264, 469050, 443480, 419448, 396851, 375597,
+	355598, 336775, 319052, 302359, 286630, 271806, 257829, 244646,
+	232209, 220471, 209390, 198926, 189040, 179698, 170868, 162519,
+	154622, 147150, 140079, 133385, 127046, 121042, 115352, 109960,
+	104848, 100000, 95402, 91038, 86897, 82965, 79232, 75686,
+	72316, 69114, 66070, 63176, 60423, 57804, 55312, 52940,
+	50681, 48531, 46482, 44530, 42670, 40897, 39207, 37595,
+	36057, 34590, 33190, 31853, 30577, 29358, 28194, 27082,
+	26020, 25004, 24033, 23104, 22216, 21367, 20554, 19776,
+	19031, 18318, 17636, 16982, 16355, 15755, 15180, 14628,
+	14099, 13592, 13106, 12640, 12192, 11762, 11350, 10954,
+	10574, 10209, 9858, 9521, 9197, 8886, 8587, 8299,
+	8023, 7757, 7501, 7254, 7017, 6789, 6570, 6358,
+	6155, 5959, 5770, 5588, 5412, 5243, 5080, 4923,
+	4771, 4625, 4484, 4348, 4217, 4090, 3968, 3850,
+	3736, 3626, 3519, 3417, 3317, 3221, 3129, 3039,
+	2952, 2868, 2787, 2709, 2633, 2560, 2489, 2420,
+};
+#define NTC_ROWS        (sizeof(ntc100k_ohm) / sizeof(ntc100k_ohm[0]))
+
+/* a thermistor's temperature in tenths of a degree C (which as hakios_iceland_skin_ohm); -1000: no reading or off the table */
+int32_t hakios_iceland_skin_deci(unsigned which);
+int32_t
+hakios_iceland_skin_deci(unsigned which)
+{
+	const uint32_t r = hakios_iceland_skin_ohm(which);
+
+	if (r == 0 || r == 0xffffffffu || r > ntc100k_ohm[0] || r < ntc100k_ohm[NTC_ROWS - 1]) {
+		return -1000;
+	}
+	for (uint32_t i = 0; i + 1 < NTC_ROWS; i++) {
+		const uint32_t hi = ntc100k_ohm[i], lo = ntc100k_ohm[i + 1];
+
+		if (r <= hi && r >= lo) {
+			return (-40 + (int32_t)i) * 10 + (int32_t)(((uint64_t)(hi - r) * 10 + (hi - lo) / 2) / (hi - lo));
+		}
+	}
+	return -1000;
+}
+
+/* the threads start once, whichever of the two boot args is on (redwood_input_init calls this once) */
+static volatile uint32_t started;
+
+void
+hakios_iceland_buttons_init(void)
+{
+	uint32_t steps = 0, skin = 0, expected = 0;
+	bool buttons, probe;
+	thread_t thread;
+
+	buttons = PE_parse_boot_argn("icebuttons", &steps, sizeof(steps)) && steps != 0;
+	probe = PE_parse_boot_argn("iceskin", &skin, sizeof(skin)) && skin != 0;
+	if (!buttons && !probe) {
+		return;
+	}
+	if (!__atomic_compare_exchange_n(&started, &expected, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	if (buttons) {
+		if (steps > 5) {
+			steps = 5;
+		}
+		PE_parse_boot_argn("icebuttons_debounce", &debounce_looks, sizeof(debounce_looks));
+		debounce_looks = debounce_looks < 2 ? 2 : debounce_looks > 8 ? 8 : debounce_looks;
+		if (kernel_thread_start(icebuttons_thread, (void *)(uintptr_t)steps, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	if (probe && kernel_thread_start(iceskin_thread, (void *)(uintptr_t)skin, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_camera.c b/bsd/dev/hakios_iceland_camera.c
new file mode 100644
index 0000000000000000000000000000000000000000..518c8ca7818bd220de86e6a0d94390afa6a3393c
--- /dev/null
+++ b/bsd/dev/hakios_iceland_camera.c
@@ -0,0 +1,1017 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850 "kaanapali") cameras, first step: are the two sensors there. Only with boot-arg
+ * icecam=N; without it nothing here touches the hardware. No frame is taken and no sensor register is written.
+ *
+ * Every value is the Pad's own (linux a2e1ea44d3c3, read by object; facts only):
+ *   kaanapali-oneplus-iceland.dts:1332-1431  &i2c9 (400 kHz): camera@10 "smartsens,sc820cs" (front, chip id 0xd154),
+ *                                  camera@36 "smartsens,sc1320cs" (rear, chip id 0xc658); both: clocks RPMH_DIV_CLK1,
+ *                                  dovdd L2F 1.8 V, dvdd L1F 1.2 V, avdd L14B 2.8 V; reset-gpios pmh0110_g_e0 gpio13
+ *                                  (front) / gpio14 (rear), active low; the MCLK pads pmk8850 gpio1 (front) / gpio2
+ *                                  (rear), function func2, power-source 0, output-enable (:1911-1926); the reset pads
+ *                                  function normal, power-source 0, drive strength MED, output-low, input-disable
+ *                                  (:1871-1893)
+ *   kaanapali-oneplus-iceland.dts:785-799    ls1 / ls2 of the PMH0101 (RPMh "LS1B_E0" / "LS2B_E0", enable only): the
+ *                                  level shifters that carry the camera I2C lines; always on in Linux and in stock
+ *   kaanapali-oneplus-iceland.dts:909-933    L1F 1.2 V, L2F 1.8 V (always on in Linux: the bus pull-ups); :733-742
+ *                                  L14B 2.8 V; initial mode AUTO (rpmh-regulator pmic530 LDO: mode value 5)
+ *   kaanapali.dtsi:911-935, 5636-5642        i2c9 = QUP2 SE1 (0x884000): SDA gpio4, SCL gpio5, function qup2_se1,
+ *                                  bias-pull-up (the board file: 8 mA); TLMM 0xf100000, a pad every 0x1000
+ *   pinctrl-kaanapali.c:13-41, 1505-1506     pad word: pull 1:0, function 5:2, drive 8:6, OE 9, egpio present 11 /
+ *                                  enable 12 (gpio4 / gpio5 are egpio pads: Linux sets the enable with any function)
+ *   clk-rpmh.c:408, 920            RPMH_DIV_CLK1 = the RPMh resource "C11A_E0", enable at +4 = 1 (19.2 MHz)
+ *   pmk8850.dtsi:23-55, pmh0110-kaanapali.dtsi:166-186, pmh0101.dtsi   spmi_bus0: PMK8850 SID 0 gpio@b800, PMH0110
+ *                                  "G" SID 6 gpio@8800, PMH0110 "F" SID 5, PMH0101 SID 1
+ *   pinctrl-spmi-gpio.c:32-58, 129-132       a GPIO's registers: TYPE 0x04, SUBTYPE 0x05 (0x10..0x15: the LV / MV
+ *                                  layout), MODE_CTL 0x40 (0 in, 1 out, 2 in + out), DIG_VIN_CTL 0x41, DIG_PULL_CTL
+ *                                  0x42, DIG_OUT_SOURCE_CTL 0x44 (bit 7 = high, 3:0 function: 0 normal, 3 func2),
+ *                                  DIG_OUT_CTL 0x45, EN_CTL 0x46 (bit 7)
+ *   drivers/media/i2c/sc1320cs.c:32, 42, 165-210   chip id = register 0x3107, two bytes, up to 3 tries 20 ms apart;
+ *                                  on: reset asserted, vio, vdig, vana 1 ms apart, reset released, 5 ms, MCLK, 6 ms;
+ *                                  off: MCLK, 4 ms, reset, vana, vdig, vio 1 ms apart
+ * An LDO's SPMI registers (STATUS1 0x08 bit 7 ready, VSET 0x40 / 0x41 in mV, MODE 0x45, EN_CTL 0x46 bit 7; LDO n at
+ * peripheral 0xc0 + n, else 0x40 + n - 1) are UniXNU-piano's (CameraHw.h:190-214, another PMIC family): level 1 shows
+ * whether they read sensibly here (L1D, the CSIPHY's 1.2 V, is read as a rail that must be on).
+ *
+ * L14B's input is BOB1 (the board file :574, not always-on; Linux turns it on with L14B). It is never voted here (a
+ * vote of ours would replace whatever the boot chain left on the same DRV for a rail other parts hang on): if L14B does
+ * not come ready, the run stops there and says so.
+ *
+ * The bus is driven by hand on the two pads as GPIOs (open drain, ~100 kHz), as hakios_iceland_backlight.c does: the
+ * QUP engine and its clocks are not touched. The camera subsystem (CAMCC, CSIPHY, CSID, TFE) is not touched.
+ *
+ *   icecam=1        read only: the arbiter's channels of the four PMIC pads and the rails, their registers, the two
+ *                   TLMM pads, the seven RPMh resources' cmd-db addresses, GCC's camera branches. No store but the
+ *                   SPMI observer's read command (as icebuttons)
+ *   icecam=2        ... then each sensor in turn (icecam_sensor: 1 rear, 2 front, 3 both = default, front first):
+ *                   powered as above, its chip id read, powered down again, everything put back as found
+ *   icecam=3 / 4    ... then, in place of level 2's two chip ids, the front camera's RAW stream into kernel memory
+ *                   (3: a few frames, one measured; 4: a stream of half-size pictures): hakios_iceland_camera_stream.h
+ *   icecam=5        nothing at boot but the IOKit service "IcelandCamera" (iokit/Kernel/IcelandCamera.cpp): the front
+ *                   camera's stream runs while a user client holds it started (hakios_iceland_camera_svc.h); in QEMU
+ *                   the service gives a pattern
+ *   icecam_delay=S  seconds before the thread starts working (default 45; levels 1 to 4)
+ *   icecam_blind=1  level 2 goes on when a rail's SPMI registers cannot be read (the votes are then not checked)
+ *   icecam_ls_off=1 the level shifters' votes are withdrawn at the end (default: left on, as Linux and stock have them)
+ *   icecam_vset_lax=1 a rail whose set point does not follow the vote before its enable is enabled anyway and turned
+ *                   off at the first read that is not the DT's voltage (default: not enabled, the run stops)
+ * Lines go to the kernel log, prefixed "icecam:".
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/param.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+#ifndef ICECAM_HOST_MODEL
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+extern uint64_t kvtophys(vm_offset_t va);
+extern uint32_t psci_smp_hvc;           /* osfmk/arm64/psci_smp.c: 1 = QEMU's virt, not the Pad */
+#endif
+
+#define say(...) printf("icecam: " __VA_ARGS__)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern int hakios_iceland_rpmh_vote(const char *name, int32_t mode, uint32_t uv, bool enable);
+extern int hakios_iceland_rpmh_vote_vme(const char *name, uint32_t mv, int32_t mode, int enable);
+extern uint32_t hakios_iceland_rpmh_addr(const char *name);
+extern int hakios_iceland_rpmh_volt(const char *name, uint32_t mv);
+
+void hakios_iceland_camera_init(void);
+
+#ifndef ICECAM_HOST_MODEL              /* the host test (runs/w3-camera/host) supplies rd / wr over a model of the hardware */
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+#endif
+
+static bool icecam_last;                /* loader_return(): nothing may be waited on, so the delays spin */
+
+static void
+wait_us(uint32_t us)
+{
+	if (icecam_last) {
+		uint64_t ticks;
+
+		nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &ticks);
+		ticks += mach_absolute_time();
+		while (mach_absolute_time() < ticks) {
+		}
+		return;
+	}
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+/* ---- the PMIC arbiter (v8), bus 0 --------------------------------------------------------------------------------- */
+
+#define ARB_CORE_PHYS           0x0c400000UL
+#define ARB_CHNL_MAP_PHYS       0x0c403000UL
+#define ARB_BUS0_OWNER_PHYS     0x0c42a000UL
+#define ARB_OBSERVER_PHYS       0x0c4c0000UL    /* ee 0's observer channels, 0x20 each */
+#define ARB_CHNLS_PHYS          0x0c900000UL    /* the write channels, 0x200 each */
+#define ARB_MAX_APIDS           8192
+
+static vm_offset_t arb_core, arb_map, arb_owner, arb_obs;
+static uint32_t bus0_apids, stores;
+
+struct periph {
+	const char *name;
+	uint16_t ppid;                          /* sid << 8 | peripheral */
+	uint16_t apid;
+	uint8_t owner;
+	bool found;
+	vm_offset_t chnl;                       /* its write channel, mapped at the first write */
+};
+
+/* a command's status word, polled (no sleep: the bus lock is held) for at most 1 ms, as PMIC_ARB_TIMEOUT_US */
+static uint32_t
+arb_done(vm_offset_t status_reg)
+{
+	uint64_t limit, start = mach_absolute_time();
+	uint32_t status;
+
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &limit);
+	do {
+		status = rd(status_reg);
+	} while (!(status & 1) && mach_absolute_time() - start < limit);
+	return status;
+}
+
+static bool
+sp_read(const struct periph *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t ch = arb_obs + 0x20UL * p->apid;
+	uint32_t status = 0, data;
+
+	if (!p->found || count == 0 || count > 4) {
+		return false;
+	}
+	redwood_spmi_lock();
+	wr(ch + 0x00, 1u << 27 | (uint32_t)reg << 4 | (count - 1));     /* EXT_READL */
+	status = arb_done(ch + 0x08);
+	data = rd(ch + 0x18);
+	redwood_spmi_unlock();
+	if (status != 1) {
+		say("%s: read of %#x: status %#x (%s)\n", p->name, reg, status, !(status & 1) ? "no answer" :
+		    (status & 4) ? "denied" : (status & 2) ? "failed" : "dropped");
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		bytes[i] = (uint8_t)(data >> (8 * i));
+	}
+	return true;
+}
+
+/* one byte, only to a peripheral the apps own (Linux refuses the others too); read back through the observer */
+static bool
+sp_write(struct periph *p, uint8_t reg, uint8_t val)
+{
+	uint32_t status = 0;
+	uint8_t back = 0;
+	bool read;
+
+	if (!p->found || p->owner != 0) {
+		say("%s: %#x <- %02x REFUSED: not the apps' peripheral\n", p->name, reg, val);
+		return false;
+	}
+	if (p->chnl == 0) {
+		vm_offset_t phys = ARB_CHNLS_PHYS + 0x200UL * p->apid, page = phys & ~(vm_offset_t)PAGE_MASK;
+		vm_offset_t v = ml_io_map(page, PAGE_SIZE);
+
+		if (v == 0) {
+			say("%s: its write channel is not mapped: no write\n", p->name);
+			return false;
+		}
+		p->chnl = v + (phys - page);
+	}
+	redwood_spmi_lock();
+	wr(p->chnl + 0x10, val);
+	wr(p->chnl + 0x00, (uint32_t)reg << 4);                         /* EXT_WRITEL, one byte */
+	status = arb_done(p->chnl + 0x08);
+	redwood_spmi_unlock();
+	stores++;
+	read = sp_read(p, reg, &back, 1);
+	say("%s: %#x <- %02x: status %#x, read back %02x%s\n", p->name, reg, val, status, back,
+	    status == 1 && read && back == val ? "" : " (NOT as written)");
+	return status == 1 && read && back == val;
+}
+
+static void
+find_apid(struct periph *p)
+{
+	for (uint32_t apid = 0; apid < bus0_apids; apid++) {
+		uint32_t map = rd(arb_map + 4UL * apid), owner;
+
+		if (map == 0 || (map & 0x1fff) != p->ppid) {
+			continue;
+		}
+		owner = rd(arb_owner + 4UL * apid) & 7;
+		if (!p->found || owner == 0) {  /* _pmic_arb_read_apid_map: the first, unless a later one is the apps' */
+			p->found = true;
+			p->apid = (uint16_t)apid;
+			p->owner = (uint8_t)owner;
+		}
+	}
+}
+
+/* ---- the hardware ------------------------------------------------------------------------------------------------- */
+
+#define GPIO_TYPE               0x04
+#define GPIO_MODE_CTL           0x40
+#define GPIO_VIN_CTL            0x41
+#define GPIO_OUT_SOURCE_CTL     0x44
+#define GPIO_OUT_CTL            0x45
+#define GPIO_EN_CTL             0x46
+#define GPIO_FUNC2              3
+#define GPIO_STRENGTH_MED       2               /* dt-bindings/pinctrl/qcom,pmic-gpio.h:16 */
+
+struct pad {
+	struct periph p;
+	uint8_t is[2], mode, vin, pull, source, out, en;        /* as found */
+	bool read, mode_set, source_set, en_set, out_set;       /* what this driver changed */
+};
+
+struct rail {
+	const char *name, *res;                                 /* the RPMh resource */
+	uint32_t mv;
+	struct periph p, alt;                                   /* 0xc0 + n, 0x40 + n - 1 */
+	struct periph *at;
+	uint8_t status1, mode, en;
+	uint32_t found_mv, vset_was;                            /* the last read; the set point before our vote */
+	bool read, found_on, voted, volt_back;                  /* volt_back: our voltage request goes at the end */
+};
+
+static struct pad mclk_front = { .p = { .name = "PMK8850 gpio1 (front MCLK)", .ppid = 0x0b8 } };
+static struct pad mclk_rear = { .p = { .name = "PMK8850 gpio2 (rear MCLK)", .ppid = 0x0b9 } };
+static struct pad reset_front = { .p = { .name = "PMH0110-G gpio13 (front reset)", .ppid = 0x694 } };
+static struct pad reset_rear = { .p = { .name = "PMH0110-G gpio14 (rear reset)", .ppid = 0x695 } };
+
+static struct rail vio = { .name = "L2F (vio 1.8 V)", .res = "L2F_E0", .mv = 1800,
+	                   .p = { .name = "L2F", .ppid = 0x5c2 }, .alt = { .name = "L2F (alt)", .ppid = 0x541 } };
+static struct rail vdig = { .name = "L1F (vdig 1.2 V)", .res = "L1F_E0", .mv = 1200,
+	                    .p = { .name = "L1F", .ppid = 0x5c1 }, .alt = { .name = "L1F (alt)", .ppid = 0x540 } };
+static struct rail vana = { .name = "L14B (vana 2.8 V)", .res = "L14B_E0", .mv = 2800,
+	                    .p = { .name = "L14B", .ppid = 0x1ce }, .alt = { .name = "L14B (alt)", .ppid = 0x14d } };
+/* only read: a rail that is on (the CSIPHY's 1.2 V), to show that the LDO registers read sensibly */
+static struct rail ref = { .name = "L1D (reference, 1.2 V)", .res = "L1D_E0", .mv = 1200,
+	                   .p = { .name = "L1D", .ppid = 0x3c1 }, .alt = { .name = "L1D (alt)", .ppid = 0x340 } };
+
+static const struct sensor {
+	const char *name;
+	uint8_t addr;
+	uint16_t id;
+	struct pad *reset, *mclk;
+} front = { "front SC820CS", 0x10, 0xd154, &reset_front, &mclk_front },
+    rear = { "rear SC1320CS", 0x36, 0xc658, &reset_rear, &mclk_rear };
+
+#define LS1                     "LS1B_E0"
+#define LS2                     "LS2B_E0"
+#define MCLK_RES                "C11A_E0"
+#define LDO_MODE_AUTO           5               /* PMIC530_LDO_MODE_OPM: the DT's initial mode */
+#define REG_CHIP_ID             0x3107
+
+static bool blind, vset_lax, ls_voted, mclk_voted;
+static bool ready_known;                /* the reference rail reads on and ready: STATUS1 bit 7 means what we think */
+
+static bool
+pad_read(struct pad *g)
+{
+	struct periph *p = &g->p;
+
+	g->read = sp_read(p, GPIO_TYPE, g->is, 2) && sp_read(p, GPIO_MODE_CTL, &g->mode, 1) &&
+	    sp_read(p, GPIO_VIN_CTL, &g->vin, 1) && sp_read(p, 0x42, &g->pull, 1) &&
+	    sp_read(p, GPIO_OUT_SOURCE_CTL, &g->source, 1) && sp_read(p, GPIO_OUT_CTL, &g->out, 1) &&
+	    sp_read(p, GPIO_EN_CTL, &g->en, 1);
+	return g->read;
+}
+
+static void
+pad_report(struct pad *g, const char *when)
+{
+	uint8_t st = 0xff;
+
+	if (!g->p.found) {
+		say("%s: no channel on bus 0 (ppid %#x)\n", g->p.name, g->p.ppid);
+		return;
+	}
+	if (!pad_read(g)) {
+		say("%s: apid %u (ee %u): not readable\n", g->p.name, g->p.apid, g->p.owner);
+		return;
+	}
+	(void)sp_read(&g->p, 0x08, &st, 1);
+	say("%s %s: apid %u ee %u, type %02x/%02x, mode %02x, vin %02x, pull %02x, source %02x, out %02x, en %02x, status %02x\n",
+	    g->p.name, when, g->p.apid, g->p.owner, g->is[0], g->is[1], g->mode, g->vin, g->pull, g->source, g->out, g->en,
+	    st);
+}
+
+/* what level 2 needs of a pad before it writes it: the apps', the LV / MV layout, the DT's power source, a CMOS output */
+static bool
+pad_usable(const struct pad *g)
+{
+	return g->read && g->p.owner == 0 && g->is[0] == 0x10 && g->is[1] >= 0x10 && g->is[1] <= 0x15 && (g->vin & 7) == 0 &&
+	       (g->out & 0x30) == 0 && (g->mode & 3) != 3;
+}
+
+static bool
+pad_back(struct pad *g)
+{
+	bool ok = true;
+
+	if (g->source_set) {
+		ok &= sp_write(&g->p, GPIO_OUT_SOURCE_CTL, g->source);
+	}
+	if (g->mode_set) {
+		ok &= sp_write(&g->p, GPIO_MODE_CTL, g->mode);
+	}
+	if (g->en_set) {
+		ok &= sp_write(&g->p, GPIO_EN_CTL, g->en);
+	}
+	if (g->out_set) {
+		ok &= sp_write(&g->p, GPIO_OUT_CTL, g->out);
+	}
+	if (ok) {
+		g->source_set = g->mode_set = g->en_set = g->out_set = false;
+	}
+	return ok;
+}
+
+/*
+ * a reset pad as a digital output at `high` (active low: low = the sensor held in reset); first its drive strength as
+ * the DT's state asks (qcom,drive-strength = PMIC_GPIO_STRENGTH_MED = 2 in DIG_OUT_CTL 1:0, pinctrl-spmi-gpio.c:592;
+ * the output type 5:4 kept: pad_usable() wants it CMOS): a pad found at strength 0 ("no drive") would not drive at all
+ */
+static bool
+reset_drive(struct pad *g, bool high)
+{
+	bool ok = true;
+
+	if ((g->out & 3) != GPIO_STRENGTH_MED && !g->out_set) {
+		g->out_set = true;
+		ok = sp_write(&g->p, GPIO_OUT_CTL, (uint8_t)((g->out & ~3u) | GPIO_STRENGTH_MED));
+	}
+	if (!ok) {
+		return false;
+	}
+	g->source_set = true;
+	ok = sp_write(&g->p, GPIO_OUT_SOURCE_CTL, high ? 0x80 : 0x00);
+	if (ok && (g->mode & 3) != 1 && !g->mode_set) {
+		g->mode_set = true;
+		ok = sp_write(&g->p, GPIO_MODE_CTL, 1);
+	}
+	if (ok && !(g->en & 0x80) && !g->en_set) {
+		g->en_set = true;
+		ok = sp_write(&g->p, GPIO_EN_CTL, 0x80);
+	}
+	return ok;
+}
+
+static void
+rail_read(struct rail *r)
+{
+	uint8_t type[2] = { 0, 0 }, v[2] = { 0, 0 };
+
+	r->read = false;
+	r->at = r->p.found ? &r->p : r->alt.found ? &r->alt : NULL;
+	if (r->at == NULL || !sp_read(r->at, 0x04, type, 2) || !sp_read(r->at, 0x08, &r->status1, 1) ||
+	    !sp_read(r->at, 0x40, v, 2) || !sp_read(r->at, 0x45, &r->mode, 1) || !sp_read(r->at, 0x46, &r->en, 1)) {
+		return;
+	}
+	r->found_mv = v[0] | (uint32_t)v[1] << 8;
+	r->read = true;
+}
+
+static void
+rail_report(struct rail *r, const char *when)
+{
+	uint8_t type[2] = { 0, 0 };
+
+	rail_read(r);
+	if (!r->read) {
+		say("%s %s: not readable (peripheral %#x %s, %#x %s); cmd-db %s = %#x\n", r->name, when, r->p.ppid,
+		    r->p.found ? "found" : "absent", r->alt.ppid, r->alt.found ? "found" : "absent", r->res,
+		    hakios_iceland_rpmh_addr(r->res));
+		return;
+	}
+	(void)sp_read(r->at, 0x04, type, 2);
+	say("%s %s: ppid %#x apid %u ee %u, type %02x/%02x, status1 %02x, vset %u mV, mode %02x, en %02x: %s; cmd-db %s = %#x\n",
+	    r->name, when, r->at->ppid, r->at->apid, r->at->owner, type[0], type[1], r->status1, r->found_mv, r->mode, r->en,
+	    (r->en & 0x80) ? "ON" : "off", r->res, hakios_iceland_rpmh_addr(r->res));
+}
+
+static bool
+vset_is_dt(const struct rail *r)
+{
+	return r->read && r->found_mv + 50 >= r->mv && r->found_mv <= r->mv + 50;
+}
+
+/*
+ * voltage and mode (Linux's order), the set point read back, then the enable; a rail found on at its voltage is used and
+ * never voted. A rail is never enabled at a set point other than the DT's (min = max): if the PMIC's set point does not
+ * follow the vote (another master's higher request, or VRM writing it only at the enable) the rail stays off and the run
+ * stops, unless icecam_vset_lax=1, which enables and turns it off again at the first read that is not the DT's value
+ * (the sensors are held in reset meanwhile). A set point found other than the DT's (run A: L14B 3200 mV) has our voltage
+ * request taken back at the end (rail_off): we never vote a value outside the DT's.
+ */
+static bool
+rail_on(struct rail *r)
+{
+	rail_read(r);
+	r->found_on = r->read && (r->en & 0x80);
+	if (r->found_on) {
+		if (r->found_mv + 50 < r->mv || r->found_mv > r->mv + 50) {
+			say("%s: found on at %u mV, not %u: REFUSED\n", r->name, r->found_mv, r->mv);
+			return false;
+		}
+		say("%s: found on at %u mV: used as it is, no vote\n", r->name, r->found_mv);
+		return true;
+	}
+	if (!r->read && !blind) {
+		say("%s: not readable and no icecam_blind=1: REFUSED\n", r->name);
+		return false;
+	}
+	r->vset_was = r->read ? r->found_mv : 0;
+	r->volt_back = !vset_is_dt(r);
+	r->voted = true;
+	stores += 2;
+	if (hakios_iceland_rpmh_vote_vme(r->res, r->mv, LDO_MODE_AUTO, -1) != 0) {
+		say("%s: the voltage / mode vote was not done\n", r->name);
+		return false;
+	}
+	for (int t = 0; t < 10 && r->read; t++) {
+		rail_read(r);
+		if (vset_is_dt(r)) {
+			break;
+		}
+		wait_us(500);
+	}
+	if (r->read && !vset_is_dt(r)) {
+		if (!vset_lax) {
+			say("%s: set point %u mV after the vote for %u mV (found %u): NOT enabled, stop (icecam_vset_lax=1 would "
+			    "enable it and check after)\n", r->name, r->found_mv, r->mv, r->vset_was);
+			return false;
+		}
+		say("%s: set point %u mV after the vote for %u mV: enabled and checked at once (icecam_vset_lax=1)\n", r->name,
+		    r->found_mv, r->mv);
+	}
+	stores++;
+	if (hakios_iceland_rpmh_vote(r->res, -1, 0, true) != 0) {
+		say("%s: the enable vote was not done\n", r->name);
+		return false;
+	}
+	for (int t = 0; t < 10; t++) {
+		wait_us(500);
+		rail_read(r);
+		if (r->read && (r->en & 0x80) && ((r->status1 & 0x80) || !vset_is_dt(r))) {
+			break;
+		}
+	}
+	if (!r->read) {
+		say("%s: voted (%u mV), not readable (blind)\n", r->name, r->mv);
+		return true;
+	}
+	say("%s: voted: en %02x, status1 %02x, vset %u mV (found %u)\n", r->name, r->en, r->status1, r->found_mv,
+	    r->vset_was);
+	if (!vset_is_dt(r)) {
+		say("%s: on at %u mV, not the DT's %u: stop, turned off at once\n", r->name, r->found_mv, r->mv);
+		return false;
+	}
+	if (ready_known && !(r->status1 & 0x80)) {
+		say("%s: not ready (is its parent supply off? L14B hangs on BOB1, which this driver never votes)\n", r->name);
+		return false;
+	}
+	return (r->en & 0x80) != 0;
+}
+
+static void
+rail_off(struct rail *r)
+{
+	bool ok;
+
+	if (!r->voted) {
+		return;
+	}
+	stores++;
+	ok = hakios_iceland_rpmh_vote(r->res, -1, 0, false) == 0;
+	if (ok && r->volt_back) {
+		/* the set point was found other than the DT's: our voltage request taken back (0 mV = none from this DRV) */
+		stores++;
+		if (hakios_iceland_rpmh_volt(r->res, 0) == 0) {
+			r->volt_back = false;
+		}
+	}
+	if (ok && !r->volt_back) {
+		r->voted = false;
+	}
+	wait_us(1000);
+	rail_read(r);
+	say("%s: enable withdrawn: en %02x, status1 %02x, set point now %u mV (found %u)%s\n", r->name, r->en, r->status1,
+	    r->found_mv, r->vset_was, r->read ? "" : " (not readable)");
+}
+
+/* ---- the bus: gpio4 (SDA) / gpio5 (SCL) by hand ------------------------------------------------------------------ */
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x10000UL               /* gpio0..15 */
+#define PIN_SDA                 4
+#define PIN_SCL                 5
+#define PIN_CTL(n)              (tlmm + 0x1000UL * (n))
+#define PIN_IO(n)               (tlmm + 0x1000UL * (n) + 4)
+#define CTL_OE                  (1u << 9)
+#define CTL_EGPIO_PRESENT       (1u << 11)
+#define CTL_EGPIO_ENABLE        (1u << 12)
+#define PULL_DOWN               1
+#define PULL_UP                 3
+
+static vm_offset_t tlmm;
+static uint32_t found_ctl[2], found_io[2];
+static bool pins_set;
+static uint64_t quarter_ticks;
+
+static inline void
+quarter(void)
+{
+	uint64_t until = mach_absolute_time() + quarter_ticks;
+
+	while (mach_absolute_time() < until) {
+	}
+}
+
+/* open drain: low = the output enabled at 0, high = released */
+static inline void
+line(unsigned pin, bool high)
+{
+	uint32_t v = rd(PIN_CTL(pin));
+
+	wr(PIN_CTL(pin), high ? v & ~CTL_OE : v | CTL_OE);
+	(void)rd(PIN_CTL(pin));
+}
+
+static inline bool
+level(unsigned pin)
+{
+	return rd(PIN_IO(pin)) & 1;
+}
+
+static bool
+scl_high(void)
+{
+	uint64_t limit, start = mach_absolute_time();
+
+	line(PIN_SCL, true);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &limit);
+	while (!level(PIN_SCL)) {
+		if (mach_absolute_time() - start > limit) {
+			return false;
+		}
+	}
+	quarter();
+	return true;
+}
+
+/* both pads: function gpio, released, the output value 0, 8 mA (the board file's), the given pull */
+static void
+pins_setup(unsigned pull)
+{
+	static const unsigned pins[2] = { PIN_SDA, PIN_SCL };
+
+	for (unsigned k = 0; k < 2; k++) {
+		uint32_t v;
+
+		if (!pins_set) {
+			found_ctl[k] = rd(PIN_CTL(pins[k]));
+			found_io[k] = rd(PIN_IO(pins[k]));
+		}
+		wr(PIN_IO(pins[k]), 0);
+		v = (found_ctl[k] & ~0x3ffu) | pull | (8 / 2 - 1) << 6;
+		if (v & CTL_EGPIO_PRESENT) {
+			v |= CTL_EGPIO_ENABLE;
+		}
+		wr(PIN_CTL(pins[k]), v);
+		stores += 2;
+	}
+	pins_set = true;
+}
+
+static void
+pins_back(void)
+{
+	static const unsigned pins[2] = { PIN_SDA, PIN_SCL };
+
+	if (!pins_set) {
+		return;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		wr(PIN_CTL(pins[k]), found_ctl[k]);
+		wr(PIN_IO(pins[k]), found_io[k] & 2);
+		stores += 2;
+	}
+	pins_set = false;
+	say("gpio4 / gpio5 back as found: ctl %#x %#x (now %#x %#x)\n", found_ctl[0], found_ctl[1], rd(PIN_CTL(PIN_SDA)),
+	    rd(PIN_CTL(PIN_SCL)));
+}
+
+/* with the pads' own pull-downs: a line that reads high is pulled up from the far side (the level shifters are on) */
+static void
+bus_look(const char *when)
+{
+	bool sda, scl;
+
+	pins_setup(PULL_DOWN);
+	wait_us(2000);
+	sda = level(PIN_SDA);
+	scl = level(PIN_SCL);
+	say("bus %s, the pads pulling down: SDA %u SCL %u (%s)\n", when, sda, scl,
+	    sda && scl ? "pulled up from the camera side" : "not pulled up: shifters or vio off");
+	pins_setup(PULL_UP);
+	wait_us(1000);
+}
+
+static void
+i2c_start(void)
+{
+	line(PIN_SDA, true);
+	scl_high();
+	line(PIN_SDA, false);
+	quarter();
+	line(PIN_SCL, false);
+	quarter();
+}
+
+static void
+i2c_stop(void)
+{
+	line(PIN_SDA, false);
+	quarter();
+	scl_high();
+	line(PIN_SDA, true);
+	quarter();
+}
+
+static bool
+i2c_out(uint8_t byte)
+{
+	bool ack;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		line(PIN_SDA, (byte >> bit) & 1);
+		quarter();
+		if (!scl_high()) {
+			return false;
+		}
+		line(PIN_SCL, false);
+		quarter();
+	}
+	line(PIN_SDA, true);
+	quarter();
+	if (!scl_high()) {
+		return false;
+	}
+	ack = !level(PIN_SDA);
+	line(PIN_SCL, false);
+	quarter();
+	return ack;
+}
+
+static uint8_t
+i2c_in(bool ack)
+{
+	uint8_t byte = 0;
+
+	line(PIN_SDA, true);
+	for (int bit = 7; bit >= 0; bit--) {
+		quarter();
+		scl_high();
+		byte = (uint8_t)(byte << 1 | level(PIN_SDA));
+		line(PIN_SCL, false);
+		quarter();
+	}
+	line(PIN_SDA, !ack);
+	quarter();
+	scl_high();
+	line(PIN_SCL, false);
+	quarter();
+	line(PIN_SDA, true);
+	return byte;
+}
+
+/* 0 = read; 1 = the address was not acknowledged, 2 = the register's, 3 = the read address's, 4 = a line is held low */
+static int
+read16(uint8_t addr, uint16_t reg, uint16_t *val)
+{
+	int step = 0;
+
+	if (!level(PIN_SDA) || !level(PIN_SCL)) {
+		return 4;
+	}
+	i2c_start();
+	if (!i2c_out((uint8_t)(addr << 1))) {
+		step = 1;
+	} else if (!i2c_out((uint8_t)(reg >> 8)) || !i2c_out((uint8_t)reg)) {
+		step = 2;
+	} else {
+		i2c_start();
+		if (!i2c_out((uint8_t)(addr << 1 | 1))) {
+			step = 3;
+		} else {
+			*val = (uint16_t)(i2c_in(true) << 8);
+			*val |= i2c_in(false);
+		}
+	}
+	i2c_stop();
+	return step;
+}
+
+/* ---- level 2: one sensor on, its chip id, off --------------------------------------------------------------------- */
+
+static bool
+sensor_run(const struct sensor *s)
+{
+	static const char *const why[] = { "", "its address was not acknowledged", "the register address was not acknowledged",
+		                           "the read address was not acknowledged", "SDA or SCL is held low" };
+	struct pad *m = s->mclk;
+	uint16_t id = 0;
+	int r = 4;
+	bool ok, good = false;
+
+	say("%s: power up\n", s->name);
+	/* both sensors hang on the same rails: both held in reset before the rails come up (Linux's default pad state) */
+	ok = reset_drive(&reset_front, false) && reset_drive(&reset_rear, false);
+	if (ok) {
+		ok = rail_on(&vio);
+		wait_us(1000);
+	}
+	if (ok) {
+		ok = rail_on(&vdig);
+		wait_us(1000);
+	}
+	if (ok) {
+		ok = rail_on(&vana);
+		wait_us(1000);
+	}
+	if (ok) {
+		bus_look("with the rails on");
+		ok = reset_drive(s->reset, true);
+		wait_us(5000);
+	}
+	if (ok) {
+		/* the DT's pad state (func2, output-enable), then the clock: enable only, 19.2 MHz as it comes */
+		m->source_set = true;
+		ok = sp_write(&m->p, GPIO_OUT_SOURCE_CTL, (m->source & 0x80) | GPIO_FUNC2);
+		if (ok && (m->mode & 3) == 0) {
+			m->mode_set = true;
+			ok = sp_write(&m->p, GPIO_MODE_CTL, 2);
+		}
+		if (ok && !(m->en & 0x80)) {
+			m->en_set = true;
+			ok = sp_write(&m->p, GPIO_EN_CTL, 0x80);
+		}
+	}
+	if (ok) {
+		mclk_voted = true;
+		stores++;
+		ok = hakios_iceland_rpmh_vote(MCLK_RES, -1, 0, true) == 0;
+		wait_us(6000);
+	}
+	for (int t = 0; ok && t < 3; t++) {
+		r = read16(s->addr, REG_CHIP_ID, &id);
+		if (r == 0) {
+			break;
+		}
+		say("%s: chip id try %d: %s\n", s->name, t + 1, why[r]);
+		wait_us(20000);
+	}
+	if (ok && r == 0) {
+		good = id == s->id;
+		say("%s: chip id 0x%04x at 0x%02x%s\n", s->name, id, s->addr, good ? ": OK" : ": NOT the expected one");
+	} else {
+		say("%s: no chip id (%s)\n", s->name, ok ? "the sensor does not answer" : "a power-up step failed");
+	}
+
+	say("%s: power down\n", s->name);
+	if (mclk_voted) {
+		stores++;
+		if (hakios_iceland_rpmh_vote(MCLK_RES, -1, 0, false) == 0) {
+			mclk_voted = false;
+		}
+		wait_us(4000);
+	}
+	ok = reset_drive(s->reset, false);
+	ok &= pad_back(m);
+	wait_us(1000);
+	rail_off(&vana);
+	wait_us(1000);
+	rail_off(&vdig);
+	wait_us(1000);
+	rail_off(&vio);
+	ok &= pad_back(&reset_front);
+	ok &= pad_back(&reset_rear);
+	say("%s: power down %s\n", s->name, ok && !mclk_voted && !vio.voted && !vdig.voted && !vana.voted ? "complete" :
+	    "NOT complete");
+	return good;
+}
+
+#ifndef ICECAM_HOST_MODEL
+#include "hakios_iceland_camera_stream.h"       /* levels 3 and 4 */
+#endif
+
+static void
+survey(const char *when)
+{
+	pad_report(&mclk_front, when);
+	pad_report(&mclk_rear, when);
+	pad_report(&reset_front, when);
+	pad_report(&reset_rear, when);
+	rail_report(&vio, when);
+	rail_report(&vdig, when);
+	rail_report(&vana, when);
+	rail_report(&ref, when);
+	say("gpio4 (SDA) ctl %#x io %#x, gpio5 (SCL) ctl %#x io %#x %s\n", rd(PIN_CTL(PIN_SDA)), rd(PIN_IO(PIN_SDA)),
+	    rd(PIN_CTL(PIN_SCL)), rd(PIN_IO(PIN_SCL)), when);
+}
+
+/* the reads every level starts with, and level 2's verdict: true = the pads, the rails and the resources can be used */
+static bool
+icecam_survey(uint32_t level_arg)
+{
+	uint32_t version;
+	struct periph *all[] = { &mclk_front.p, &mclk_rear.p, &reset_front.p, &reset_rear.p, &vio.p, &vio.alt, &vdig.p,
+		                 &vdig.alt, &vana.p, &vana.alt, &ref.p, &ref.alt };
+	vm_offset_t gcc;
+	bool usable;
+
+	say("level %u: the survey (reads only)\n", level_arg);
+	arb_core = ml_io_map(ARB_CORE_PHYS, 0x3000);
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	if (arb_core == 0 || tlmm == 0) {
+		say("the arbiter or the TLMM is not mapped: nothing done\n");
+		return false;
+	}
+	version = rd(arb_core);
+	bus0_apids = rd(arb_core + 4) & 0x1fff;
+	if (version < 0x80000000u || version >= 0x90000000u || bus0_apids == 0 || bus0_apids > ARB_MAX_APIDS) {
+		say("arbiter version %#x, bus 0 with %u apids: not the one expected, nothing done\n", version, bus0_apids);
+		return false;
+	}
+	arb_map = ml_io_map(ARB_CHNL_MAP_PHYS, 0x8000);
+	arb_owner = ml_io_map(ARB_BUS0_OWNER_PHYS, 0x8000);
+	arb_obs = ml_io_map(ARB_OBSERVER_PHYS, 0x40000);
+	if (arb_map == 0 || arb_owner == 0 || arb_obs == 0) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(all) / sizeof(all[0]); i++) {
+		find_apid(all[i]);
+	}
+	survey("as found");
+	say("cmd-db: %s %#x, %s %#x, %s %#x\n", LS1, hakios_iceland_rpmh_addr(LS1), LS2, hakios_iceland_rpmh_addr(LS2),
+	    MCLK_RES, hakios_iceland_rpmh_addr(MCLK_RES));
+	/* gcc-kaanapali.c:1345, 1360, 3461: camera AHB 0x26004, HF AXI 0x26014, SF AXI 0x26028 (GCC at 0x100000) */
+	gcc = ml_io_map(0x00124000UL, 0x4000);
+	if (gcc != 0) {
+		say("gcc camera ahb %#x, hf axi %#x, sf axi %#x (read only)\n", rd(gcc + 0x2004), rd(gcc + 0x2014),
+		    rd(gcc + 0x2028));
+	}
+	usable = pad_usable(&mclk_front) && pad_usable(&mclk_rear) && pad_usable(&reset_front) && pad_usable(&reset_rear) &&
+	    hakios_iceland_rpmh_addr(LS1) != 0 && hakios_iceland_rpmh_addr(LS2) != 0 && hakios_iceland_rpmh_addr(MCLK_RES) != 0 &&
+	    hakios_iceland_rpmh_addr(vio.res) != 0 && hakios_iceland_rpmh_addr(vdig.res) != 0 &&
+	    hakios_iceland_rpmh_addr(vana.res) != 0 && (blind || (vio.read && vdig.read && vana.read));
+	ready_known = ref.read && (ref.en & 0x80) && (ref.status1 & 0x80);
+	say("the reference rail reads %s: a voted rail %s\n", ready_known ? "on and ready" : "not as expected",
+	    ready_known ? "must read ready too" : "is checked by its enable and voltage only");
+	say("level 2's verdict: %s; %u stores so far\n", usable ? "can run" :
+	    "REFUSED (a pad is not the apps' LV/MV CMOS pad at power source 0, a resource is not in cmd-db, or a rail is unread)",
+	    stores);
+	return usable;
+}
+
+static void
+icecam_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t level_arg = (uint32_t)(uintptr_t)parameter, wait_s = 45, which = 3, flag = 0;
+	bool front_ok = false, rear_ok = false, stream_ok = false;
+
+	PE_parse_boot_argn("icecam_delay", &wait_s, sizeof(wait_s));
+	PE_parse_boot_argn("icecam_sensor", &which, sizeof(which));
+	blind = PE_parse_boot_argn("icecam_blind", &flag, sizeof(flag)) && flag != 0;
+	flag = 0;
+	vset_lax = PE_parse_boot_argn("icecam_vset_lax", &flag, sizeof(flag)) && flag != 0;
+	flag = 0;
+	delay_for_interval(wait_s > 600 ? 600 : wait_s, NSEC_PER_SEC);
+
+#ifndef ICECAM_HOST_MODEL
+	if (psci_smp_hvc != 0) {
+		/* QEMU's virt machine has none of this hardware, and a read of an address nothing answers aborts there */
+		say("level %u: not the Pad (QEMU's virt machine): no camera hardware, nothing read or written\n", level_arg);
+		return;
+	}
+#endif
+	if (!icecam_survey(level_arg) || level_arg < 2) {
+		return;
+	}
+
+	nanoseconds_to_absolutetime(2500, &quarter_ticks);      /* a quarter of a 100 kHz period */
+	bus_look("as found");
+	ls_voted = true;
+	stores += 2;
+	if (hakios_iceland_rpmh_vote(LS1, -1, 0, true) != 0 || hakios_iceland_rpmh_vote(LS2, -1, 0, true) != 0) {
+		say("the level shifters' votes were not done: stop\n");
+#ifndef ICECAM_HOST_MODEL
+	} else if (level_arg >= 3) {
+		stream_ok = cam_run((which & 2) ? &front : &rear, level_arg);
+#endif
+	} else {
+		if (which & 2) {
+			front_ok = sensor_run(&front);
+		}
+		if (which & 1) {
+			delay_for_interval(50, NSEC_PER_MSEC);
+			rear_ok = sensor_run(&rear);
+		}
+	}
+	bus_look("at the end");
+	pins_back();
+	if (PE_parse_boot_argn("icecam_ls_off", &flag, sizeof(flag)) && flag != 0) {
+		stores += 2;
+		(void)hakios_iceland_rpmh_vote(LS2, -1, 0, false);
+		(void)hakios_iceland_rpmh_vote(LS1, -1, 0, false);
+		say("the level shifters' votes withdrawn\n");
+	} else {
+		say("the level shifters' votes left on (as Linux and stock keep them)\n");
+	}
+	survey("at the end");
+	if (level_arg >= 3) {
+		say("result: level %u: %s; %u pad / rail / pin stores in all; shifters voted %u\n", level_arg,
+		    stream_ok ? "FRAME CAPTURED" : "no frame", stores, ls_voted);
+		return;
+	}
+	say("result: front %s, rear %s; %u stores in all; shifters voted %u\n",
+	    (which & 2) ? front_ok ? "FOUND" : "not found" : "not asked",
+	    (which & 1) ? rear_ok ? "FOUND" : "not found" : "not asked", stores, ls_voted);
+}
+
+#ifndef ICECAM_HOST_MODEL
+#include "hakios_iceland_camera_svc.h"          /* level 5 */
+
+/*
+ * From loader_return() (the A3 re-entry, a panic's end), on the one processor left, the others stopped where they were:
+ * a camera that is up (a service user still holds the stream, or a level 3 / 4 run was cut) is taken down by cam_down()
+ * with a panic's rules: delays spin, no lock is taken. So the RPMh votes are not touched (the sensor's rails and clock,
+ * the CSIPHY's rail, BCM MM1 stay as voted; the reset that follows the loader clears them) and the sensor is only put
+ * into reset. The write master, the CSID, the PHY, the SMMU window, the clocks and the power switches go as in any
+ * other down: nothing stores into memory that is about to be reused.
+ */
+void hakios_iceland_camera_quiesce(void);
+
+void
+hakios_iceland_camera_quiesce(void)
+{
+	if (cam.did == 0 || icecam_last) {
+		return;
+	}
+	icecam_last = true;
+	cam.quiet = true;
+	say("quiesce: the camera is up (%#x): down, the RPMh votes left\n", cam.did);
+	cam_down(&front);
+}
+#else
+void hakios_iceland_camera_quiesce(void);
+
+void
+hakios_iceland_camera_quiesce(void)
+{
+}
+#endif
+
+void
+hakios_iceland_camera_init(void)
+{
+	uint32_t level_arg = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icecam", &level_arg, sizeof(level_arg)) || level_arg == 0) {
+		return;
+	}
+#ifndef ICECAM_HOST_MODEL
+	if (level_arg >= 5) {
+		svc_init();             /* nothing is read or written before a user starts the stream */
+		return;
+	}
+	if (level_arg >= 3) {
+		cam_reserve();
+	}
+#endif
+	if (kernel_thread_start(icecam_thread, (void *)(uintptr_t)level_arg, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
