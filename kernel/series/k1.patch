+                                          '_ZN25IOMobileFramebufferLegacy27do_power_state_change_gatedEv')}
+OVERLAY_BINDINGS = {'_native_legacy_powerstate_notify': (322, '_ZN19IOMobileFramebuffer17powerstate_notifyEbb')}
+
