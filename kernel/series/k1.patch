+/*
+ * ---- Audio level C1 (boot-arg iceaudio=1, with icedsp >= 10): the speakers' back end alone, running silence --------
+ * As Linux for PRIMARY_TDM_RX_0 (q6apm-lpass-dais dai 18 + sc8280xp_tdm_hw_params + q6prm), every value from the Pad's
+ * DT and topology (audio/topology/OnePlus-Pad4.m4, subgraph-device-tdm-playback.m4, module_tdm.m4):
+ *   1. pins i2s0_default (TLMM gpio122 i2s0_sck 2 mA, gpio123 i2s0_data0 6 mA, gpio124 i2s0_data1 6 mA, gpio125
+ *      i2s0_ws 2 mA; function 1 each (pinctrl-kaanapali.c PINGROUP), bias disabled; none in gpio-reserved-ranges);
+ *   2. the bit clock: q6prm_request_lpass_clock(Q6PRM_LPASS_CLK_ID_PRI_TDM_IBIT 0x200, COUPLE_NO 1, root 0,
+ *      snd_soc_tdm_params_to_bclk = 48000 x 32 x 8 = 12288000);
+ *   3. APM_CMD_GRAPH_OPEN of the back end's graph as audioreach_alloc_graph_pkt: sub-graph 0x4006 (perf mode low
+ *      latency, direction TX, scenario playback), container 0x4006 (capability GC, graph position stream, stack 8192,
+ *      domain ADSP), modules MFC 0x07001015 iid 0x6062 (1 in / 1 out), DATA_LOGGING 0x0700101A iid 0x6060 (1/1),
+ *      TDM_SINK 0x0700100E iid 0x6061 (1/0); connections MFC:1 -> LOG:2, LOG:1 -> TDM:2;
+ *   4. media formats as audioreach_set_media_format, in the container's order: MFC output 48 kHz / 32 bit / 8 ch
+ *      (FL FR FC LFE LS RS LB RB); LOG: module enable, then log code 0x19ab, tap point 1, mode 0; TDM:
+ *      PARAM_ID_TDM_INTF_CFG {LPAIF 0, PRIMARY 0, sync internal, data out, slot mask 0xff, 8 slots, 32 bit, long
+ *      sync, no inversion, delay 1} + HW_EP_MF {48000, 32, 8, fixed point} + frame size factor 1;
+ *   5. GRAPH_PREPARE, GRAPH_START; held iceaudio_hold (3) s while the clock and frame-sync pads are sampled;
+ *   6. GRAPH_STOP, GRAPH_CLOSE, the clock released, the pins given back as found.
+ * Nothing feeds the MFC: the TDM sink sends zeros. The amplifiers are not touched (level B left them powered down,
+ * muted). Checked against the m4-expanded topology (device24: SG 0x4006 perf 0x2 dir 0x1 sid 0x1; container 0x4006
+ * capability 0x0B001001 stack 8192 pos 0x1 domain 0x2; MFC 24674, LOG 0x6060 code 0x19ab tap 1, TDM 24673).
+ */
+/*
+ * w4-audio round 6 (16 Nov): the back end's channel map. Tablet run w4-audio-r5c-stock-1 read the top pair's status
+ * 0x11 as 0xe89 / 0xea1 / 0x4ec1 while it played (amplifier engaged, then follower and boost mode) and the other four
+ * as 0x899 with 0x12 = 0x4709 throughout (clocks and PLL up, low power and low noise mode, amplifier NOT engaged): their
+ * slots carried zeros. The map above (FL FR FC LFE LS RS LB RB) is audioreach_set_default_channel_mapping(8), which
+ * Linux's q6apm-lpass-dais hw_params sets first -- but the board's prepare then replaces it (sc8280xp.c
+ * oneplus_iceland_tdm_channels_mapping, snd_soc_dai_set_channel_map: FL FR FL FR FL FR FL FR, "stereo spread as left =
+ * slots 0/2/4 (top, bottom, middle left) and right = slots 1/3/5 (stock tfa98xx container)"), before the media format
+ * goes to the MFC. With the default map the MFC puts a stereo stream on slots 0 and 1 only: the amplifiers' TDM
+ * registers (0x21) give TopLeft / TopRight slots 0 / 1, the bottom pair 2 / 3, the middle pair 4 / 5. Now Linux's map:
+ * all six play, each at the level the top pair had (the same samples; no register changes). icesnd_six=0: the old map.
+ */
+static uint32_t au_six = 1;
+#define AU_SG                   0x4006u
+#define AU_CONT                 0x4006u
+#define AU_IID_LOG              0x6060u
+#define AU_IID_TDM              0x6061u
+#define AU_IID_MFC              0x6062u
+#define AU_MOD_MFC              0x07001015u
+#define AU_MOD_LOG              0x0700101Au
+#define AU_MOD_TDM              0x0700100Eu
+#define APM_IID                 1u
+#define APM_CMD_GRAPH_OPEN_     0x01001000u
+#define APM_CMD_GRAPH_PREPARE_  0x01001001u
+#define APM_CMD_GRAPH_START_    0x01001002u
+#define APM_CMD_GRAPH_STOP_     0x01001003u
+#define APM_CMD_GRAPH_CLOSE_    0x01001004u
+#define APM_CMD_SET_CFG_        0x01001006u
+#define PRM_REQUEST_HW_RSC      0x0100100Fu
+#define PRM_RSP_REQUEST_HW_RSC  0x02001002u
+#define PRM_RELEASE_HW_RSC      0x01001010u
+#define PRM_RSP_RELEASE_HW_RSC  0x02001003u
+#define PARAM_ID_RSC_AUDIO_HW_CLK 0x0800102Cu
+#define CLK_PRI_TDM_IBIT        0x200u
+#define TDM_BCLK_HZ             12288000u
+#define AU_PERF_LOW_LATENCY     2u
+#define AU_CONT_TYPE_GC         0x0B001001u
+static const unsigned au_pins_n[4] = { 122, 123, 124, 125 };
+static const unsigned au_pin_ma[4] = { 2, 6, 6, 2 };
+
+/* one APM / PRM command and its answer (opcode `rsp`, or GPR_BASIC_RSP_RESULT for `opcode`): the status, or -1 */
+static int32_t
+gpr_call2(struct gchan *ch, uint32_t src, uint32_t port, uint32_t opcode, const void *p, uint32_t len, uint32_t rsp,
+    const char *what)
+{
+	uint32_t seq = gpr_rx_seq;
+	uint64_t t0 = now_us();
+
+	if (!gpr_send(ch, src, port, opcode, p, len)) {
+		say("audio: %s: not sent\n", what);
+		return -1;
+	}
+	while (now_us() - t0 < 2000000ull && !g_broken) {
+		g_pump();
+		if (gpr_rx_seq != seq) {
+			seq = gpr_rx_seq;
+			if (gpr_rx_opcode == rsp || (gpr_rx_opcode == GPR_BASIC_RSP_RESULT && gpr_rx_w0 == opcode)) {
+				int32_t status = (int32_t)gpr_rx_w1;
+
+				say("audio: %s: %s (status %#x)\n", what, status == 0 ? "OK" : "REFUSED", status);
+				return status;
+			}
+		}
+		sleep_ms(1);
+	}
+	say("audio: %s: NO ANSWER in 2 s\n", what);
+	return -1;
+}
+
+static int32_t
+gpr_call(struct gchan *ch, uint32_t port, uint32_t opcode, const void *p, uint32_t len, uint32_t rsp, const char *what)
+{
+	return gpr_call2(ch, port, port, opcode, p, len, rsp, what);
+}
