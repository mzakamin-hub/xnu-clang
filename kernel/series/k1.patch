+
+		for (i = 0; i < sizeof(temps) / sizeof(temps[0]); i++) {
+			bool on = icechg_enable_want(stopped, false, true, temps[i], 3900, 5000);
+
+			stopped = !on;
+			pass = pass && on == want[i];
+			strncat(seen, on ? "1" : "0", sizeof(seen) - strlen(seen) - 1);
+		}
+		verdict("enable walk 30 44 45 45.5 44.9 43.5 43.1 43 42 C: 111000011", pass, seen);
+	}
+}
+
+int
+main(void)
+{
+	unsigned i;
+
+	for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+		check_case(&cases[i]);
+
+	check_kinds();
+	check_steps();
+	check_holds();
+	check_outcomes();
+	check_name("icechg_adapter_name(9) is BrickID", 9, "BrickID");
+	check_name("icechg_adapter_name(6) is PD", 6, "PD");
+	check_name("icechg_adapter_name(1) is SDP", 1, "SDP");
+	check_walk();
+	check_guard();
+	check_enable();
+
+	printf("%u cases, %u failed\n", total, failed);
+	return failed != 0 ? 1 : 0;
+}
diff --git a/tools/tests/iceufs_nat/nat_test.c b/tools/tests/iceufs_nat/nat_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..1748c9bf05e5bc3361f470567e9b636b3db7b5b0
--- /dev/null
+++ b/tools/tests/iceufs_nat/nat_test.c
@@ -0,0 +1,284 @@
+/*
+ * Host test of the native UFS path's pure logic (bsd/dev/hakios_iceland_ufs_nat.h): tag allocation, range cutting, the
+ * PRDT builder and the recovery state machine, plus a fault-injection run of the per-command loop the driver's nat_rw
+ * makes. Build and run: tools/tests/iceufs_nat/run.sh (cc -O1 -Wall -Werror). Exit 0 = PASS.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../../bsd/dev/hakios_iceland_ufs_nat.h"
+
+static unsigned fails, checks;
+#define CHECK(c) do { checks++; if (!(c)) { fails++; printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static uint64_t rng = 0x9e3779b97f4a7c15ULL;
+static uint64_t
+rnd(void)
+{
+	rng ^= rng << 13;
+	rng ^= rng >> 7;
+	rng ^= rng << 17;
+	return rng;
+}
+
+static void
+test_allowed(void)
+{
+	CHECK(nat_allowed(0) == 0);
+	CHECK(nat_allowed(1) == 0x2);
+	CHECK(nat_allowed(8) == 0x1fe);
+	CHECK(nat_allowed(30) == 0x7ffffffe);
+	CHECK(nat_allowed(31) == 0xfffffffe);
+	CHECK(nat_allowed(32) == 0xfffffffe);
+	for (uint32_t qd = 0; qd <= 40; qd++) {
+		CHECK((nat_allowed(qd) & 1) == 0);     /* tag 0 is never the queue's */
+	}
+}
+
+static void
+test_take(void)
+{
+	uint32_t busy = 0, tags[NAT_SLOTS], n;
+
+	n = nat_take(&busy, 8, 3, tags);
+	CHECK(n == 3 && tags[0] == 1 && tags[1] == 2 && tags[2] == 3 && busy == 0xe);
+	n = nat_take(&busy, 8, 100, tags);
+	CHECK(n == 5 && tags[0] == 4 && tags[4] == 8 && busy == 0x1fe);
+	CHECK(nat_take(&busy, 8, 1, tags) == 0);        /* full: the caller sleeps */
+	nat_give(&busy, 1u << 5);
+	n = nat_take(&busy, 8, 4, tags);
+	CHECK(n == 1 && tags[0] == 5);
+	busy = 1;                                       /* tag 0 busy (run()'s): no effect on the queue */
+	n = nat_take(&busy, 31, 31, tags);
+	CHECK(n == 31 && tags[0] == 1 && tags[30] == 31 && busy == 0xffffffff);
+	busy = 0;
+	CHECK(nat_take(&busy, 4, 0, tags) == 0 && busy == 0);
+	/* a narrower depth (the bench's QD1) takes only tag 1 */
+	busy = 0;
+	CHECK(nat_take(&busy, 1, 8, tags) == 1 && tags[0] == 1);
+	CHECK(nat_take(&busy, 1, 8, tags) == 0);
+
+	/* random take / give by many "threads": no tag is ever held twice, never 0, never above qd */
+	for (uint32_t qd = 1; qd <= 31; qd++) {
+		uint32_t held[64] = { 0 }, owner_mask = 0;
+
+		busy = 0;
+		for (int step = 0; step < 20000; step++) {
+			uint32_t who = (uint32_t)(rnd() % 64);
+
+			if (held[who] == 0) {
+				uint32_t want = 1 + (uint32_t)(rnd() % 8), m = 0;
+
+				n = nat_take(&busy, qd, want, tags);
+				for (uint32_t i = 0; i < n; i++) {
+					CHECK(tags[i] >= 1 && tags[i] <= qd);
+					CHECK(!(owner_mask & (1u << tags[i])));
+					m |= 1u << tags[i];
+				}
+				CHECK(n <= want);
+				held[who] = m;
+				owner_mask |= m;
+			} else {
+				nat_give(&busy, held[who]);
+				owner_mask &= ~held[who];
+				held[who] = 0;
+			}
+			CHECK(busy == owner_mask);
+		}
+	}
+}
+
+static void
+test_chunks(void)
+{
+	for (int k = 0; k < 20000; k++) {
+		uint64_t blocks = 1 + rnd() % 40000, left = blocks, sum = 0, cmds = 0;
+		uint32_t cap = (k & 1) ? 256 : 128;
+
+		while (left > 0) {
+			uint32_t c = nat_chunk(left, cap);
+
+			CHECK(c >= 1 && c <= cap);
+			sum += c;
+			left -= c;
+			cmds++;
+		}
+		CHECK(sum == blocks);
+		CHECK(cmds == nat_chunks(blocks, cap));
+	}
+	CHECK(nat_chunks(0, 256) == 0 && nat_chunks(256, 256) == 1 && nat_chunks(257, 256) == 2 && nat_chunks(5, 0) == 0);
+}
+
+/* a buffer of `len` bytes from page `pages[i]` (16 KB pages) laid into a PRDT; the entries must cover it exactly */
+static bool
+prdt_of(const uint64_t *pages, uint32_t len, uint32_t *table, uint32_t *n)
+{
+	*n = 0;
+	for (uint32_t off = 0; off < len;) {
+		uint32_t chunk = 16384 - (off & 16383);
+
+		if (chunk > len - off) {
+			chunk = len - off;
+		}
+		if (!nat_prdt_add(table, n, pages[off / 16384] + (off & 16383), chunk)) {
+			return false;
+		}
+		off += chunk;
+	}
+	return true;
+}
+
+static void
+test_prdt(void)
+{
+	uint32_t table[4 * NAT_PRDT_MOST], n;
+	uint64_t pages[256];
+
+	/* 1 MB, contiguous: four 256 KB entries */
+	for (int i = 0; i < 64; i++) {
+		pages[i] = 0x880000000ULL + (uint64_t)i * 16384;
+	}
+	CHECK(prdt_of(pages, 1 << 20, table, &n) && n == 4);
+	for (uint32_t e = 0; e < n; e++) {
+		CHECK(table[4 * e + 3] + 1 == NAT_SEG && table[4 * e + 2] == 0);
+		CHECK(((uint64_t)table[4 * e + 1] << 32 | table[4 * e]) == 0x880000000ULL + (uint64_t)e * NAT_SEG);
+	}
+	/* 1 MB, every page apart: 64 entries of 16 KB */
+	for (int i = 0; i < 64; i++) {
+		pages[i] = 0x100000000ULL + (uint64_t)i * 3 * 16384;
+	}
+	CHECK(prdt_of(pages, 1 << 20, table, &n) && n == 64);
+	/* the byte counts add up for random layouts, and no entry passes 256 KB */
+	for (int k = 0; k < 5000; k++) {
+		uint32_t len = (uint32_t)(1 + rnd() % 256) * 4096, total = 0;
+		uint64_t at = 0x40000000ULL;
+
+		for (int i = 0; i < 64; i++) {
+			at += (rnd() % 3 == 0) ? 16384 * (1 + rnd() % 4) : 16384;
+			pages[i] = at;
+		}
+		if (prdt_of(pages, len, table, &n)) {
+			for (uint32_t e = 0; e < n; e++) {
+				CHECK(table[4 * e + 3] + 1 <= NAT_SEG);
+				total += table[4 * e + 3] + 1;
+			}
+			CHECK(total == len);
+		}
+	}
+	/* 129 pieces: refused (the caller falls back or fails; never a 129th entry) */
+	n = 0;
+	for (uint32_t i = 0; i < NAT_PRDT_MOST; i++) {
+		CHECK(nat_prdt_add(table, &n, 0x10000000ULL + (uint64_t)i * 0x10000, 4096));
+	}
+	CHECK(!nat_prdt_add(table, &n, 0x90000000ULL, 4096) && n == NAT_PRDT_MOST);
+	/* a page without a physical address: refused */
+	n = 0;
+	CHECK(!nat_prdt_add(table, &n, 0, 4096) && n == 0);
+}
+
+static void
+test_judge(void)
+{
+	/* done and clean */
+	CHECK(nat_judge(true, false, 0, 0, 0, 0, false, 1) == NAT_OK);
+	CHECK(nat_judge(true, false, 0, 0, 0, 0, true, 1) == NAT_OK);
+	/* stuck: never cleared */
+	CHECK(nat_judge(false, false, 0, 0, 0, 0, false, 1) == NAT_DEAD);
+	CHECK(nat_judge(false, false, 0, 0, 0, 0, true, 3) == NAT_DEAD);
+	/* a cleared timeout: a read again (twice), a write never */
+	CHECK(nat_judge(false, true, 0, 0, 0, 0, false, 1) == NAT_RETRY);
+	CHECK(nat_judge(false, true, 0, 0, 0, 0, false, 2) == NAT_RETRY);
+	CHECK(nat_judge(false, true, 0, 0, 0, 0, false, 3) == NAT_FAIL);
+	CHECK(nat_judge(false, true, 0, 0, 0, 0, true, 1) == NAT_FAIL);
+	/* the controller's error (OCS) */
+	CHECK(nat_judge(true, false, 0x7, 0, 0, 0, false, 1) == NAT_RETRY);
+	CHECK(nat_judge(true, false, 0x7, 0, 0, 0, true, 1) == NAT_FAIL);
+	/* CHECK CONDITION: transient keys only */
+	for (uint8_t key = 0; key < 16; key++) {
+		bool t = key == 2 || key == 3 || key == 4 || key == 6 || key == 0xb;
+
+		CHECK(nat_judge(true, false, 0, 0, 0x02, key, false, 1) == (t ? NAT_RETRY : NAT_FAIL));
+		CHECK(nat_judge(true, false, 0, 0, 0x02, (uint8_t)(0xf0 | key), false, 1) == (t ? NAT_RETRY : NAT_FAIL));
+		CHECK(nat_judge(true, false, 0, 0, 0x02, key, true, 1) == NAT_FAIL);
+	}
+	/* one block past the end: ILLEGAL REQUEST (5) is final (155ub bench_s7 a) */
+	CHECK(nat_judge(true, false, 0, 0, 0x02, 0x5, false, 1) == NAT_FAIL);
+	/* a response code other than success counts as the device's error */
+	CHECK(nat_judge(true, false, 0, 1, 0, 0x6, false, 1) == NAT_RETRY);
+	CHECK(nat_judge(true, false, 0, 1, 0, 0x0, false, 1) == NAT_FAIL);
+}
+
+/*
+ * The per-command loop of nat_rw with a fake controller: each ring of a command ends done-clean, done-with-error (a
+ * random sense key or OCS), timed-out-and-cleared or stuck, at random. Checked: a read is rung at most NAT_TRIES times,
+ * a write once; a stuck command stops the run (dead) and keeps its tag; success only when every command ended OK.
+ */
+static void
+test_loop(void)
+{
+	unsigned runs_ok = 0, runs_dead = 0, runs_fail = 0;
+
+	for (int r = 0; r < 20000; r++) {
+		bool write = (r & 1) != 0, dead = false;
+		uint32_t n = 1 + (uint32_t)(rnd() % 8), tries[8] = { 0 }, pending = (1u << n) - 1, kept = 0;
+		int error = 0;
+
+		while (pending != 0 && error == 0) {
+			for (uint32_t i = 0; i < n; i++) {
+				uint64_t f = rnd() % 100;
+				bool done = true, cleared = false;
+				uint8_t ocs = 0, status = 0, key = 0;
+				enum nat_end end;
+
+				if (!(pending & (1u << i))) {
+					continue;
+				}
+				tries[i]++;
+				if (f < 4) {
+					done = false;
+					cleared = f != 0;               /* 1 in 100 stuck, 3 in 100 cleared */
+				} else if (f < 8) {
+					ocs = 0x7;
+				} else if (f < 14) {
+					status = 0x02;
+					key = (uint8_t)(rnd() % 16);
+				}
+				end = nat_judge(done, cleared, ocs, 0, status, key, write, tries[i]);
+				CHECK(tries[i] <= (write ? 1u : NAT_TRIES));
+				if (end == NAT_DEAD) {
+					dead = true;
+					kept |= 1u << i;
+					pending &= ~(1u << i);
+					error = 1;
+				} else if (end == NAT_OK) {
+					pending &= ~(1u << i);
+				} else if (end == NAT_FAIL) {
+					pending &= ~(1u << i);
+					error = 1;
+				}
+			}
+		}
+		CHECK(error != 0 || pending == 0);
+		CHECK(!dead || kept != 0);
+		runs_ok += error == 0;
+		runs_dead += dead;
+		runs_fail += error != 0 && !dead;
+	}
+	printf("loop: 20000 runs: %u ok, %u failed, %u stuck\n", runs_ok, runs_fail, runs_dead);
+	CHECK(runs_ok > 0 && runs_fail > 0 && runs_dead > 0);
+}
+
+int
+main(void)
+{
+	test_allowed();
+	test_take();
+	test_chunks();
+	test_prdt();
+	test_judge();
+	test_loop();
+	printf("nat_test: %u checks, %u failed: %s\n", checks, fails, fails ? "FAIL" : "PASS");
+	return fails != 0;
+}
diff --git a/tools/tests/iceufs_nat/run.sh b/tools/tests/iceufs_nat/run.sh
new file mode 100755
index 0000000000000000000000000000000000000000..052d31e221afff30f69b0e927ba8aa18bcf2a633
--- /dev/null
+++ b/tools/tests/iceufs_nat/run.sh
@@ -0,0 +1,13 @@
+#!/bin/bash
+# The native UFS path's host tests (lane B): nat_test (hakios_iceland_ufs_nat.h) and wl_test (the driver's own whitelist
+# and command builders, cut out of bsd/dev/hakios_iceland_ufs.c). run.sh [OUTDIR] -- exit 0 = both PASS.
+set -u
+T=$(cd "$(dirname "$0")" && pwd)
+X=$(cd "$T/../../.." && pwd)
+O=${1:-${TMPDIR:-/tmp}/iceufs_nat_test}
+mkdir -p "$O"
+st=0
+cc -O1 -Wall -Werror -o "$O/nat_test" "$T/nat_test.c" && "$O/nat_test" || st=1
+python3 -I "$T/wl_test.py" "$X/bsd/dev/hakios_iceland_ufs.c" "$X/bsd/dev/hakios_iceland_ufs_nat.h" "$O" || st=1
+echo "iceufs_nat host tests: $([ $st = 0 ] && echo PASS || echo FAIL)"
+exit $st
diff --git a/tools/tests/iceufs_nat/wl_test.py b/tools/tests/iceufs_nat/wl_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..0ae06aa1f4e69d33f8cff6fd74dfde843e8a6bc4
--- /dev/null
+++ b/tools/tests/iceufs_nat/wl_test.py
@@ -0,0 +1,271 @@
+#!/usr/bin/env python3
+"""The whitelist the native path relies on, tested on the host from the driver's OWN text.
+
+The functions that judge a command (ufs_permitted and what it calls) and the ones that build the native path's commands
+(win_cmd, make, nat_read16) are cut out of bsd/dev/hakios_iceland_ufs.c by name, unchanged, and compiled with a test
+that compares ufs_permitted against an independent statement of the S8-5 rule over boundary and random cases, with the
+descriptor dword 0 the native path writes (interrupt bit on and off, every task tag), and over the native path's write
+plan (512 KB WRITE(10) FUA commands). Also checked in the text: every native command goes through nat_prepare, and
+nat_prepare calls ufs_permitted before anything is rung.
+
+  wl_test.py DRIVER.c NAT.h OUTDIR   (exit 0 = PASS)
+"""
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+drv_path, nat_h, out = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3])
+src = drv_path.read_text()
+lines = src.split('\n')
+
+
+def func(name):
+    """The definition of `name`: its return-type line(s) to the closing brace at column 0."""
+    for i, line in enumerate(lines):
+        if re.match(r'^%s\(' % re.escape(name), line):
+            start = i - 1
+            while start > 0 and lines[start - 1].startswith('static'):
+                start -= 1
+            end = i
+            while lines[end] != '}':
+                end += 1
+            return '\n'.join(lines[start:end + 1])
+    sys.exit('wl_test: no function %s' % name)
+
+
+def block(first, last):
+    i = lines.index(first)
+    j = i
+    while lines[j] != last:
+        j += 1
+    return '\n'.join(lines[i:j + 1])
+
+
+def define(name):
+    for line in lines:
+        if re.match(r'^#define\s+%s\s' % name, line):
+            return line
+    sys.exit('wl_test: no #define %s' % name)
+
+
+def decl(text):
+    if text not in lines:
+        sys.exit('wl_test: no line %r' % text)
+    return text
+
+
+# the text checks: the native path's only command-building / ringing paths
+checks = []
+prep = func('nat_prepare')
+p_ok = re.search(r'\n\tif \(!ufs_permitted\(check, d\[0\]\)\) \{\n[\s\S]*?\n\t\treturn nat_refused;\n\t\}\n\treturn NULL;\n\}$',
+                 prep)
+checks.append(('nat_prepare judges the command with ufs_permitted: refused -> nat_refused, its only NULL after it',
+               p_ok is not None and prep.count('return NULL;') == 1))
+checks.append(('nat_prepare does not ring', 'REG_UTRLDBR' not in prep))
+rw = func('nat_rw_fua')         # kit1: nat_rw's body (nat_rw is its FUA wrapper)
+checks.append(('nat_rw_fua rings only after nat_prepare said NULL',
+               rw.find('nat_prepare(') > 0 and rw.find('nat_prepare(') < rw.find('nat_ring_wait(')))
+checks.append(('nat_rw is only nat_rw_fua with FUA',
+               re.fullmatch(r'[\s\S]*\{\n\treturn nat_rw_fua\(lba, blocks, p, write, cap, true\);\n\}', func('nat_rw')) is not None))
+run0 = func('nat_run0')
+checks.append(('nat_run0 rings only after nat_prepare said NULL',
+               run0.find('nat_prepare(') > 0 and run0.find('nat_prepare(') < run0.find('nat_ring_wait(')))
+rings = [m.start() for m in re.finditer(r'wr\(hc \+ REG_UTRLDBR', src)]
+ring_funcs = []
+for pos in rings:
+    head = src.rfind('\n}\n', 0, pos)
+    name = re.search(r'\n([a-z_0-9]+)\(', src[head:pos]).group(1)
+    ring_funcs.append(name)
+checks.append(('the doorbell is written only by run() (slot 0) and nat_ring_wait: %s' % ring_funcs,
+               sorted(set(ring_funcs)) == ['nat_ring_wait', 'run']))
+checks.append(('win_write checks win_armed and win_inside before the native path',
+               re.search(r'if \(!win_armed \|\| in == NULL \|\| !win_inside\(lba, blocks\)\)[\s\S]*?if \(nat_on\)',
+                         func('win_write_fua')) is not None))
+# kit1: both public window writes are win_write_fua (FUA; the cached one without FUA unless data-fua=1)
+checks.append(('hakios_iceland_ufs_win_write is win_write_fua with FUA',
+               'return win_write_fua(lba, blocks, src, true);' in func('hakios_iceland_ufs_win_write')))
+checks.append(('hakios_iceland_ufs_win_write_cached is win_write_fua, FUA only with data-fua',
+               re.search(r'PE_parse_boot_argn\("data-fua"[\s\S]*return win_write_fua\(lba, blocks, src, fua != 0\);',
+                         func('hakios_iceland_ufs_win_write_cached')) is not None))
+checks.append(('nat_start returns at once without iceufs_native=1|2',
+               re.search(r'\{\n\tuint32_t want = 0,[^\n]*\n(\t[^\n]*\n)*?\n\tif \(!PE_parse_boot_argn\("iceufs_native", &want, '
+                         r'sizeof\(want\)\) \|\| want == 0 \|\| want > 2\) \{\n\t\treturn;', func('nat_start')) is not None))
+
+parts = [
+    '#include <stdbool.h>', '#include <stdint.h>', '#include <stdio.h>', '#include <stdlib.h>', '#include <string.h>',
+    '#define bzero(p, n) memset((p), 0, (n))',
+    '#define __unused __attribute__((unused))',
+]
+for d in ('BLOCK', 'BUF_SIZE', 'BUF_BLOCKS', 'W_DATA', 'W_LOG', 'W_END', 'WLUN_UFS_DEVICE', 'VAR_EXT_AT', 'VAR_MAX_EXT',
+          'U_FIRST', 'W_TEST'):
+    parts.append(define(d))
+parts.append(block('struct cmd {', '};'))
+parts.append(block('struct var_ext {', '} var;'))
+parts.append(decl('static volatile bool win_armed;         /* iceufs_write=1 and every check passed: WRITE may pass, '
+                  'inside one window */'))
+parts.append('static volatile bool closing, dead;')
+parts.append('static bool waking;')
+for f in ('put_be32', 'be32', 'be64', 'var_inside', 'var_write_permitted', 'win_inside', 'win_permitted', 'make',
+          'ufs_permitted', 'win_cmd', 'nat_read16'):
+    parts.append(func(f))
+parts.append('#include "%s"' % nat_h.resolve())
+parts.append(r'''
+static unsigned fails, checks;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; if (fails < 20) { printf("FAIL: " __VA_ARGS__); printf("\n"); } } } while (0)
+static uint64_t rng = 0x5eed154ULL;
+static uint64_t rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return rng; }
+
+/* the S8-5 rule, said independently: a write may pass only armed, not closing, LUN 0, WRITE(10)/(16), 1..128 blocks,
+ * wholly inside the data window or wholly inside the log window */
+static bool
+oracle_write(uint8_t op, uint8_t lun, uint64_t lba, uint32_t n)
+{
+	bool in = (lba >= W_DATA && lba + n <= W_LOG) || (lba >= W_LOG && lba + n <= W_END);
+	return win_armed && !closing && lun == 0 && (op == 0x2a || op == 0x8a) && n >= 1 && n <= 128 && in;
+}
+
+/* the command as nat_prepare leaves it: task tag t, dword 0 with or without the interrupt bit */
+static bool
+judged(const struct cmd *c, uint32_t t, bool irq)
+{
+	uint8_t u[32];
+	uint32_t dw0 = 1u << 28 | (c->read ? 2u << 25 : c->write ? 1u << 25 : 0) | (irq ? 1u << 24 : 0);
+
+	memcpy(u, c->upiu, 32);
+	u[3] = (uint8_t)t;
+	return ufs_permitted(u, dw0);
+}
+
+int
+main(void)
+{
+	static const uint8_t ops[] = { 0x2a, 0x8a, 0x42, 0x93, 0x04, 0x28, 0x88, 0x2e, 0x8e, 0x41 };
+	static const uint32_t ns[] = { 0, 1, 2, 3, 127, 128, 129, 255, 256 };
+	uint64_t edges[] = { 0, 1, U_FIRST, U_FIRST + 1, W_DATA, W_LOG, W_END, W_TEST, 0xffffffffULL };
+	struct cmd c;
+	unsigned passed_writes = 0;
+
+	for (int armed = 0; armed < 2; armed++) {
+		for (int cl = 0; cl < 2; cl++) {
+			win_armed = armed;
+			closing = cl;
+			for (unsigned o = 0; o < sizeof(ops); o++) {
+				for (unsigned e = 0; e < sizeof(edges) / sizeof(edges[0]); e++) {
+					for (int64_t d = -260; d <= 260; d++) {
+						uint64_t lba = edges[e] + (uint64_t)d;
+
+						if ((int64_t)edges[e] + d < 0 || lba > 0xffffffffULL) {
+							continue;
+						}
+						for (unsigned k = 0; k < sizeof(ns) / sizeof(ns[0]); k++) {
+							for (uint8_t lun = 0; lun < 2; lun++) {
+								bool want = oracle_write(ops[o], lun, lba, ns[k]), got;
+
+								win_cmd(&c, ops[o], lba, ns[k], lun);
+								got = judged(&c, (uint32_t)(lba % 32), (lba & 1) != 0);
+								CHECK(got == want, "op %#x lun %u lba %llu n %u armed %d closing %d: got %d want %d",
+								    ops[o], lun, (unsigned long long)lba, ns[k], armed, cl, got, want);
+								passed_writes += got;
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	/* reads (READ(16) as nat_read16 builds them): always, any tag, any interrupt bit; never with the W flag */
+	win_armed = false;
+	closing = false;
+	for (int k = 0; k < 200000; k++) {
+		uint64_t lba = rnd() % 61853696ULL;
+		uint32_t n = 1 + (uint32_t)(rnd() % 256);
+
+		nat_read16(&c, lba, n);
+		CHECK(judged(&c, (uint32_t)(k % 32), k & 1), "read %llu+%u refused", (unsigned long long)lba, n);
+		c.upiu[1] |= 0x20;
+		CHECK(!judged(&c, 1, false), "read with the W flag passed");
+	}
+	/* the native write plan: an in-window range in 128-block WRITE(10)s passes (armed), every chunk; a range across a
+	 * window's edge is refused by the pre-check AND has a chunk the whitelist refuses */
+	for (int k = 0; k < 20000; k++) {
+		bool log = k & 1;
+		uint64_t lo = log ? W_LOG : W_DATA, hi = log ? W_END : W_LOG;
+		uint64_t n = 1 + rnd() % 20000, lba = lo + rnd() % (hi - lo - n), left = n, at = lba;
+		bool all = true;
+
+		win_armed = true;
+		closing = false;
+		CHECK(win_inside(lba, n), "range not inside");
+		while (left > 0) {
+			uint32_t b = nat_chunk(left, BUF_BLOCKS);
+
+			win_cmd(&c, 0x2a, at, b, 0);
+			all &= judged(&c, 1 + (uint32_t)(k % 31), true);
+			at += b;
+			left -= b;
+		}
+		CHECK(all, "in-window range %llu+%llu: a chunk refused", (unsigned long long)lba, (unsigned long long)n);
+		/* the same range moved across an edge */
+		{
+			uint64_t edge = (k & 2) ? lo : hi, x = edge - 1 - rnd() % (n < 2 ? 1 : n - 1);
+			bool refused_one = false;
+
+			if (x + n <= edge) {
+				x = edge - 1;
+			}
+			CHECK(!win_inside(x, n) || x + n <= edge || x >= edge, "crossing range inside?");
+			left = n;
+			at = x;
+			while (left > 0) {
+				uint32_t b = nat_chunk(left, BUF_BLOCKS);
+
+				win_cmd(&c, 0x2a, at, b, 0);
+				refused_one |= !judged(&c, 1, true);
+				at += b;
+				left -= b;
+			}
+			/* (across W_LOG, from the data window into the log window, each chunk may lie in one window: the
+			 * pre-check win_inside refuses the range, as it does on U-Boot's slot) */
+			if (!win_inside(x, n) && (x < W_DATA || x + n > W_END)) {
+				CHECK(refused_one, "range %llu+%llu leaves the windows: no chunk refused", (unsigned long long)x,
+				    (unsigned long long)n);
+			}
+		}
+		/* unarmed or closing: every chunk refused */
+		win_armed = false;
+		win_cmd(&c, 0x2a, lba, nat_chunk(n, BUF_BLOCKS), 0);
+		CHECK(!judged(&c, 1, false), "unarmed write passed");
+		win_armed = true;
+		closing = true;
+		CHECK(!judged(&c, 1, false), "write while closing passed");
+		closing = false;
+	}
+	/* SYNCHRONIZE CACHE(10): only armed, no data */
+	{
+		static const uint8_t sync10[10] = { 0x35 };
+
+		make(&c, sync10, 10, 0);
+		win_armed = false;
+		CHECK(!judged(&c, 0, false), "sync unarmed passed");
+		win_armed = true;
+		CHECK(judged(&c, 0, false), "sync armed refused");
+	}
+	printf("wl_test: %u checks (%u permitted writes), %u failed: %s\n", checks, passed_writes, fails,
+	    fails ? "FAIL" : "PASS");
+	return fails != 0;
+}
+''')
+out.mkdir(parents=True, exist_ok=True)
+(out / 'wl_test_gen.c').write_text('\n'.join(parts) + '\n')
+bad = [what for what, ok in checks if not ok]
+for what, ok in checks:
+    print('%s text: %s' % ('ok  ' if ok else 'FAIL', what))
+r = subprocess.run(['cc', '-O1', '-Wall', '-Wno-unused-function', '-Werror', '-o', str(out / 'wl_test'),
+                    str(out / 'wl_test_gen.c')], capture_output=True, text=True)
+if r.returncode != 0:
+    print(r.stdout + r.stderr)
+    sys.exit('wl_test: compile failed')
+r = subprocess.run([str(out / 'wl_test')], capture_output=True, text=True)
+print(r.stdout, end='')
+sys.exit(1 if bad or r.returncode != 0 else 0)
