+/* (lock held) the cached prefix slot of a vnode, or -1 */
+static int32_t
+ice_wl_cached(struct ice_wl_state *w, vnode_t vp, uint32_t vid)
+{
+	for (int i = 0; i < ICE_WL_VCACHE; i++) {
+		if (w->vcache[i].vp == vp && w->vcache[i].vid == vid) {
+			return w->vcache[i].path;
+		}
+	}
+	return -1;
