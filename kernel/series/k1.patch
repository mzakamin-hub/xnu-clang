+/* P1: the C twin of PAC_STD_DERIVE_KEY in pac_std_asm.h, so the derived A/B keys can be cached in the
+ * thread and the EL1->EL0 path only loads them instead of re-deriving on every return. */
+static void
+pac_std_derive_key(uint64_t secret_lo, uint64_t secret_hi, uint64_t pid,
+                   uint64_t *out_lo, uint64_t *out_hi)
+{
+	uint64_t lo = secret_lo ^ pid;
+	uint64_t hi = secret_hi ^ pid;
+	uint64_t t3 = lo ^ (lo >> 30);
+	t3 *= 0xbf58476d1ce4e5b9ull;
+	t3 ^= t3 >> 27;
+	t3 *= 0x94d049bb133111ebull;
+	*out_lo = t3 ^ (t3 >> 31);
+	uint64_t t4 = hi ^ (hi >> 30);
+	t4 *= 0xbf58476d1ce4e5b9ull;
+	t4 ^= t4 >> 27;
+	t4 *= 0x94d049bb133111ebull;
+	*out_hi = t4 ^ (t4 >> 31);
