+/* ---- g6b: the NativeAdreno ABI v2 user client ------------------------------------------------------------------------ */
+
+/*
+ * The wire of NativeAdreno ABI v2 as Turnip's darwin backend and the NativeAdrenoMetal plugin speak it (the CI-built ones:
+ * UniXNU 9248bdac, Adreno740 a8fa18f NativeAdrenoABI.h:13-35 methods, :36-164 the records, :165-181 the sizes; open type
+ * 0x4147 and the 'NTNL' tunnel: NativeAdrenoPublish.cpp:68, 1039-1095; piano 613a209 docs/drivers/gpu-userspace.md:164-192).
+ * Facts of the wire, re-typed: the records and their sizes, exact both ways (NativeAdrenoUserClient.cpp:541-565).
+ */
+enum : uint32_t {
+	kAGXOpenType = 0x4147,          /* NativeAdrenoPluginOpenType */
+	kAGXTunnelMagic = 0x4e544e4c,   /* 'NTNL': {magic, method, payload} on any admitted selector */
+	kAGXTunnelProbe = 0xffffffff,   /* the selector probe: answers success, nothing else */
+	kAGXAbiVersion = 2,
+	kAGXMethods = 18,               /* Query 1 .. Note 18 */
+	kAGXMaxBuffers = 128,           /* NativeAdrenoAbiMaxBuffers */
+	kAGXParamsHostImport = 1,       /* Query flag: BoImport pins the caller's pages */
+	kAGXDeviceClientIova = 1,       /* GetDeviceInfo flag: the client chooses BO addresses */
+	kAGXQueues = 32,                /* queue ids 0..31 (0 open from the start); all ride the one ring */
+};
+enum : uint32_t {
+	mQuery = 1, mBoAlloc, mBoMap, mBoFree, mSubmit, mWaitFence, mGetTimestamp, mGetStatus, mSetMetadata, mGetMetadata,
+	mCreateQueue, mCloseQueue, mBoCpuMap, mBoCpuUnmap, mGetDeviceInfo, mBoImport, mSetPriority, mNote
+};
+struct AGXAbiParams {           /* NativeAdrenoAbiParams */
+	uint32_t abi_version, input_bits, output_bits, flags;
+	uint64_t max_bo_bytes;
+};
+struct AGXAbiBoAlloc {
+	uint64_t bytes;
+	uint32_t align_log2, contiguous;
+};
+struct AGXAbiHandle {           /* BoAllocReply (also BoImport's), BoFree, BoCpuMap */
+	uint64_t handle;
+};
+struct AGXAbiBoImport {
+	uint64_t address, bytes;
+};
+struct AGXAbiBoMap {
+	uint64_t handle, iova;
+	uint32_t permissions, writeback, shareability, reserved;
+};
+struct AGXAbiU64 {              /* BoMapReply, SubmitReply, Timestamp, Queue / QueueReply */
+	uint64_t value;
+};
+struct AGXAbiSubmitBuffer {
+	uint64_t handle, iova, bytes;
+};
+struct AGXAbiSubmit {
+	uint32_t buffer_count, reserved;
+	uint64_t queue, wait_fence, wait_timeout_ns;
+	AGXAbiSubmitBuffer buffers[kAGXMaxBuffers];
+};
+struct AGXAbiWaitFence {
+	uint64_t fence, timeout_ns;
+};
+struct AGXAbiMetadata {
+	uint64_t handle;
+	uint32_t bytes, reserved;
+	char text[64];
+};
+struct AGXAbiCpuMapReply {
+	uint32_t token, reserved;
+	uint64_t bytes;
+};
+struct AGXAbiCpuUnmap {
+	uint64_t handle;
+	uint32_t token, reserved;
+};
+struct AGXAbiPriority {
+	uint32_t foreground, background;
+};
+struct AGXAbiNote {
+	uint32_t kind, count, words[30];
+};
+struct AGXAbiDeviceInfo {
+	uint32_t chip_id, gmem_bytes;
+	uint64_t gmem_base, uche_trap_base, va_start, va_size;
+	uint32_t highest_bank_bit, ubwc_swizzle, macrotile_mode, ubwc_version, flags, reserved;
+};
+static_assert(sizeof(AGXAbiParams) == 24 && sizeof(AGXAbiBoAlloc) == 16 && sizeof(AGXAbiBoMap) == 32, "ABI v2 records");
+static_assert(sizeof(AGXAbiSubmit) == 32 + 24 * kAGXMaxBuffers && sizeof(AGXAbiMetadata) == 80, "ABI v2 records");
+static_assert(sizeof(AGXAbiCpuMapReply) == 16 && sizeof(AGXAbiCpuUnmap) == 16 && sizeof(AGXAbiNote) == 128, "ABI v2 records");
+static_assert(sizeof(AGXAbiDeviceInfo) == 64 && sizeof(AGXAbiWaitFence) == 16 && sizeof(AGXAbiBoImport) == 16, "ABI v2 records");
+/* in / out bytes of methods 1..18 (Query, BoAlloc, BoMap, BoFree, Submit, WaitFence, GetTimestamp, GetStatus, SetMetadata,
+ * GetMetadata, CreateQueue, CloseQueue, BoCpuMap, BoCpuUnmap, GetDeviceInfo, BoImport, SetPriority, Note) */
+static const uint16_t agx_in[kAGXMethods + 1] = { 0, 0, 16, 32, 8, 32 + 24 * 128, 16, 0, 0, 80, 80, 8, 8, 8, 16, 0, 16, 8, 128 };
+static const uint16_t agx_out[kAGXMethods + 1] = { 0, 24, 8, 8, 0, 8, 0, 8, 16, 0, 80, 8, 0, 16, 0, 64, 8, 0, 0 };
+
+/*
+ * The GPU half: the A840's, in hakios_iceland_gpu.c (spaces, maps, the ring, fences: the stage-6 API the tablet probe proved,
+ * runs/g6-probe-2/20261114-110401), never duplicated here. A space per connection (its own tables and ASID), the window
+ * [4 GB, 8 GB) in each; Turnip's submission form (RedwoodGPU's `full`). iceagx_selftest=3 swaps in a software stand-in for
+ * the self-test's own connections (QEMU: no GPU), below.
+ */
+struct AGXGpu {
+	const char * name;
+	bool (*up)(void);
+	int (*space_create)(uint32_t * space);
+	void (*space_destroy)(uint32_t space);
+	int (*map)(uint32_t space, uint64_t va, const uint64_t * pa, uint32_t pages, bool read_only);
+	int (*unmap)(uint32_t space, uint64_t va, uint64_t size);
+	int (*submit)(uint32_t space, const uint64_t * ib, const uint32_t * dwords, uint32_t n, uint32_t * fence);
+	bool (*done)(uint32_t fence);
+	int (*wait)(uint32_t fence, uint32_t ms);
+	uint64_t (*ticks)(void);
+	void (*facts)(uint32_t * chip, uint64_t * gmem_base, uint64_t * trap, uint64_t * va_start, uint64_t * va_size);
+};
