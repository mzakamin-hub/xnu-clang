+
+namespace {
+// OSMetaClass keeps its superclass after the vtable pointer and the reserved expansion pointer (libkern/c++/OSMetaClass.h:
+// reserved, superClassLink, className). Checked against the superclass the class was defined with before it is changed,
+// and the new parent must itself derive from that class, so every cast the C++ class allows stays true.
+bool
+reparent(const OSMetaClass *meta, const OSMetaClass *defined, const char *family)
+{
+	const OSSymbol *name = OSSymbol::withCString(family);
+	const OSMetaClass *parent = name ? OSMetaClass::getMetaClassWithName(name) : nullptr;
+	OSSafeReleaseNULL(name);
+	const OSMetaClass **link = reinterpret_cast<const OSMetaClass **>(const_cast<OSMetaClass *>(meta)) + 2;
+	bool conforms = false;
+	for (const OSMetaClass *c = parent; c && !conforms; c = c->getSuperClass()) {
+		conforms = c == defined;
+	}
+	if (!parent || *link != defined || !conforms) {
+		return false;
+	}
+	*link = parent;
+	return true;
+}
+
+IcelandAudioDevice *gDevices[2];        // the speaker, the microphone (never released once published)
+
+// icesnddev_selftest=1 (QEMU's check of both engines with no audio server: it comes minutes later there): each published
+// device's engine started as StartIO does and stopped after 2 s. The speaker's ring is given 150 ms of a 500 Hz tone at a
+// quarter of full scale behind the engine's first two periods, as the server would write it: it goes to the sink (QEMU:
+// the virtio sound device's file). The microphone's engine takes its periods from the capture source (icemicdev_test=1:
+// the test square). One line says what the counters did. Never on by default; no hardware is touched by it.
+void
+selfTest()
+{
+	static const int16_t quarter[8] = { 0, 5793, 8192, 5793, 0, -5793, -8192, -5793 };     // 8192 sin(2 pi k / 8)
+	const uint64_t periods = iceland_audio_dev_periods, sound = iceland_audio_dev_sound, late = iceland_audio_dev_late;
+	const uint64_t inPeriods = iceland_audio_dev_in_periods, captured = iceland_audio_dev_captured;
+	IOReturn out = kIOReturnNotAttached, in = kIOReturnNotAttached;
+
+	if (gDevices[0]) {
+		out = gDevices[0]->startIO();
+		if (out == kIOReturnSuccess) {
+			int16_t *ring = static_cast<int16_t *>(gDevices[0]->ring->getBytesNoCopy());
+			for (uint32_t f = 2 * kPeriodFrames; f < kRingFrames; f++) {    // 96 frames a cycle: 500 Hz, whole cycles
+				ring[2 * f] = ring[2 * f + 1] = quarter[f / 12 % 8];
+			}
+		}
+	}
+	if (gDevices[1]) {
+		in = gDevices[1]->startIO();
+	}
+	IOSleep(2000);
+	if (gDevices[0] && out == kIOReturnSuccess) {
+		gDevices[0]->stopIO();
+	}
+	if (gDevices[1] && in == kIOReturnSuccess) {
+		gDevices[1]->stopIO();
+	}
+	IOLog("icesnddev: self-test: speaker engine %#x, 2 s: %llu periods (%llu with sound, %llu late); mic engine %#x: %llu "
+	    "periods, %llu frames from the source\n", out, iceland_audio_dev_periods - periods, iceland_audio_dev_sound - sound,
+	    iceland_audio_dev_late - late, in, iceland_audio_dev_in_periods - inPeriods, iceland_audio_dev_captured - captured);
+}
+
+// One device on a built-in nub of IOResources: the speaker ("iceland-audio-out") or the microphone ("iceland-audio-in").
+int
+publishDevice(IOService *resources, bool input)
+{
+	IOService *nub = OSTypeAlloc(IOService);
+	if (!nub || !nub->init()) {
+		OSSafeReleaseNULL(nub);
+		return -3;
+	}
+	nub->setName(input ? "iceland-audio-in" : "iceland-audio-out");
+	nub->setProperty("built-in", kOSBooleanTrue);
+	if (!nub->attach(resources)) {
+		nub->release();
+		return -3;
+	}
+	nub->registerService();
+	IcelandAudioDevice *device = OSTypeAlloc(IcelandAudioDevice);
+	const bool ok = device && device->initDevice(input) && device->attach(nub) && device->start(nub);
+	if (!ok) {
+		if (device) {
+			if (device->getProvider()) {
+				device->detach(nub);
+			}
+			device->release();
+		}
+		return -4;
+	}
+	gDevices[input ? 1 : 0] = device;
+	return 4;
+}
+
+// Links the two classes under the family's and publishes the speaker device, and with icesnddev=2 the microphone device.
+int
+attach(bool mic, bool *micPublished)
+{
+	IOService *resources = IOService::getResourceService();
+	if (!resources) {
+		return -1;
+	}
+	iceland_audio_dev_stage = 1;
+	// Normally loaded already, for IOAVFamily; a no-op then.
+	const OSReturn family = OSKextLoadKextWithIdentifier("com.apple.iokit.IOAudio2Family");
+	IOLog("icesnddev: IOAudio2Family load %#x\n", family);
+	iceland_audio_dev_stage = 2;
+	if (!reparent(IcelandAudioDevice::metaClass, IOService::metaClass, "IOAudio2Device") ||
+	    !reparent(IcelandAudioUserClient::metaClass, IOUserClient::metaClass, "IOAudio2DeviceUserClient")) {
+		return -2;
+	}
+	iceland_audio_dev_stage = 3;
+	const int speaker = publishDevice(resources, false);
+	if (speaker == 4 && mic) {
+		*micPublished = publishDevice(resources, true) == 4;
+	}
+	return speaker;
+}
+
+// The worker: the device once launchd runs, then a line whenever the audio server's use of it changed (at most one in 5 s),
+// and one a minute while the engine runs.
+void
+worker(void *parameter, wait_result_t)
+{
+	const bool mic = uintptr_t(parameter) == 2;
+	bool micPublished = false;
+	uint32_t beepAt = 0, beeps = 0;
+
+	PE_parse_boot_argn("icesnddev_beep", &beepAt, sizeof(beepAt));
+	native_wait_for_launchd("icesnddev");
+	const int stage = attach(mic, &micPublished);
+	iceland_audio_dev_stage = stage;
+	if (stage != 4) {
+		IOLog("icesnddev: none (stage %d: %s)\n", stage, stage == -2 ? "IOAudio2Family's classes were not found" :
+		    stage == -1 ? "no IOResources" : "the device could not be made");
+		return;
+	}
+	IOLog("icesnddev: \"Speaker\" published as an IOAudio2Device, 48 kHz, 2 x 16 bit, transport redwood-audio (its sink "
+	    "plays it: the DSP's sound service with icesnd=1, QEMU's virtio sound; none: silence)\n");
+	IOLog("icesnddev: the sound service's cap by this line: %u of 32767 (3277 = -20.0 dBFS, what a line without icesnd_cap "
+	    "gets; more needs icesnd_loud=1)\n", iceland_snd_cap());
+	if (mic) {
+		IOLog("icesnddev: \"Mic\" %s, 48 kHz, 1 x 16 bit, from redwood-audio's capture source (the DSP's capture service "
+		    "with icemic_svc=1; none: silence)\n", micPublished ? "published as an IOAudio2Device" : "NOT published");
+	}
+	uint32_t test = 0;
+	if (PE_parse_boot_argn("icesnddev_selftest", &test, sizeof(test)) && test == 1) {
+		selfTest();
+	}
+	uint32_t clients = 0, running = 0, quiet = 0;
+	uint64_t selectors = 0, maps = 0;
+	for (;;) {
+		// w4-audio (16 Nov): six presses, the letter q and Command-J in turn. Run w4-audio-d2-2l-r3 had the audio server on
+		// the device (clients 2) and 0 starts: nothing played. The login kit has no auto-login, so the Finder is not in
+		// front there; Command-J is a key equivalent no window claims, which an AppKit application answers with its alert
+		// sound (a GUESS for the login window: the line after each press says whether the engine ran).
+		IOSleep(beepAt != 0 && beeps < 6 ? 1000 : 5000);
+		if (beepAt != 0 && beeps < 6) {
+			uint64_t ns = 0;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			if (ns / 1000000000ULL >= beepAt + 3ULL * beeps) {
+				const bool command = (beeps & 1) != 0;
+				beeps++;
+				if (iceland_audio_dev_clients != 0) {
+					iceland_hid_line(command ? "K 8 0d" : "K 0 14");   // Command-J / the letter q down ...
+					IOSleep(60);
+					iceland_hid_line("K 0");                        // ... and up
+					IOLog("icesnddev: beep %u of 6 at %llu s: %s typed (the alert sound of whatever is in front, if it has "
+					    "no use for the key); speaker engine %s, %llu periods with sound so far\n", beeps,
+					    ns / 1000000000ULL, command ? "Command-J" : "the letter q",
+					    iceland_audio_dev_running ? "running" : "stopped", iceland_audio_dev_sound);
+				} else {
+					IOLog("icesnddev: beep %u of 6 at %llu s: not typed, the audio server does not hold the speaker\n",
+					    beeps, ns / 1000000000ULL);
+				}
+			}
+		}
+		const uint32_t runningNow = iceland_audio_dev_running | iceland_audio_dev_in_running << 1;
+		if (clients == iceland_audio_dev_clients && running == runningNow &&
+		    selectors == iceland_audio_dev_selectors && maps == iceland_audio_dev_maps && (!running || ++quiet < 12)) {
+			continue;
+		}
+		quiet = 0;
+		clients = iceland_audio_dev_clients;
+		running = runningNow;
+		selectors = iceland_audio_dev_selectors;
+		maps = iceland_audio_dev_maps;
+		IOLog("icesnddev: clients %u, maps %llu, selectors %llu (%llu unknown), %llu starts; speaker %s, periods %llu (%llu "
+		    "with sound, %llu late); mic %s, periods %llu (%llu frames from the source)\n", clients, maps, selectors,
+		    iceland_audio_dev_bad_selectors, iceland_audio_dev_starts, running & 1 ? "running" : "stopped",
+		    iceland_audio_dev_periods, iceland_audio_dev_sound, iceland_audio_dev_late, running & 2 ? "running" :
+		    "stopped", iceland_audio_dev_in_periods, iceland_audio_dev_captured);
+	}
+}
+}  // namespace
+
+void
+native_iceland_audio_probe(void)
+{
+	uint32_t enabled = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icesnddev", &enabled, sizeof(enabled)) || (enabled != 1 && enabled != 2)) {
+		return;
+	}
+	if (kernel_thread_start(worker, reinterpret_cast<void *>(uintptr_t(enabled)), &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		IOLog("icesnddev: no thread\n");
+	}
+}
