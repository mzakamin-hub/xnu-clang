+/* clk_lucid_evo_pll_configure + alpha_pll_lucid_evo_enable, as hakios_iceland_gpu.c's pll0_on for the same PLL type */
+static bool
+cam_pll_on(unsigned which, const char *name, uint32_t base, uint32_t l, uint32_t alpha, uint32_t user)
+{
+	static const uint32_t regs[7] = { P_MODE, P_OPMODE, P_L, P_ALPHA, P_USER, P_USER_U, P_CONFIG };
+	vm_offset_t p = cam.cc + base;
+
+	for (unsigned i = 0; i < 7; i++) {
+		cam.f_pll[which][i] = rd(p + regs[i]);
+	}
+	say("%s as found: mode %#x opmode %#x L %#x alpha %#x user %#x / %#x config %#x\n", name, cam.f_pll[which][0],
+	    cam.f_pll[which][1], cam.f_pll[which][2], cam.f_pll[which][3], cam.f_pll[which][4], cam.f_pll[which][5],
+	    cam.f_pll[which][6]);
+	if (rd(p + P_USER) & P_VOTE_RUN) {
+		say("%s is in FSM vote mode: not ours to drive\n", name);
+		return false;
+	}
+	if ((rd(p + P_OPMODE) & 1) && (rd(p + P_MODE) & P_OUTCTRL)) {
+		if ((rd(p + P_L) & 0xffff) != l) {
+			say("%s runs at L %#x, not %#x: REFUSED\n", name, rd(p + P_L), l);
+			return false;
+		}
+		say("%s runs already: used as it is\n", name);
+		return true;
+	}
+	cam.pll_ours[which] = true;
+	cwl(name, cam.cc, base + P_L, l | 0x48u << 16);
+	cwl(name, cam.cc, base + P_ALPHA, alpha);
+	cwl(name, cam.cc, base + P_CONFIG, 0x25c400e7);
+	cwl(name, cam.cc, base + P_CONFIG + 4, 0x0a8062e0);
+	cwl(name, cam.cc, base + P_CONFIG + 8, 0xf51dea20);
+	cwl(name, cam.cc, base + P_USER, user);
+	cwl(name, cam.cc, base + P_USER_U, 2);
+	cwl(name, cam.cc, base + P_MODE, rd(p + P_MODE) & ~P_OUTCTRL);
+	cwl(name, cam.cc, base + P_OPMODE, 0);
+	cwl(name, cam.cc, base + P_MODE, rd(p + P_MODE) | P_RESET_N);
+	cwl(name, cam.cc, base + P_OPMODE, 1);
+	if (!cam_wait(p + P_MODE, P_LOCK, P_LOCK, 1500)) {
+		say("%s does not lock (mode %#x)\n", name, rd(p + P_MODE));
+		return false;
+	}
+	cwl(name, cam.cc, base + P_USER, rd(p + P_USER) | 7);
+	cwl(name, cam.cc, base + P_MODE, rd(p + P_MODE) | P_OUTCTRL);
+	say("%s locked: mode %#x L %#x alpha %#x user %#x\n", name, rd(p + P_MODE), rd(p + P_L), rd(p + P_ALPHA),
+	    rd(p + P_USER));
+	return true;
+}
+
+/* outputs off, standby; the configuration stays, as Linux's probe leaves it */
+static void
+cam_pll_off(unsigned which, const char *name, uint32_t base)
+{
+	vm_offset_t p = cam.cc + base;
+
+	if (!cam.pll_ours[which]) {
+		return;
+	}
+	cwl(name, cam.cc, base + P_MODE, rd(p + P_MODE) & ~P_OUTCTRL);
+	cwl(name, cam.cc, base + P_USER, rd(p + P_USER) & ~7u);
+	cwl(name, cam.cc, base + P_OPMODE, 0);
+	cam.pll_ours[which] = false;
+}
+
+/* clk_rcg2_shared: the root forced on, the new source and divider, the update, the force taken off */
+static bool
+cam_rcg_set(const char *name, uint32_t cmd, uint32_t cfg)
+{
+	vm_offset_t c = cam.cc + cmd;
+	bool ok;
+
+	wr(c, rd(c) | 2);
+	cam.writes++;
+	if (!cam_wait(c, 1u << 31, 0, 500)) {
+		say("%s: the root does not turn on (cmd %#x)\n", name, rd(c));
+		wr(c, rd(c) & ~2u);
+		return false;
+	}
+	wr(c + 4, cfg);
+	wr(c, rd(c) | 1);
+	cam.writes += 2;
+	ok = cam_wait(c, 1, 0, 500);
+	wr(c, rd(c) & ~2u);
+	cam.writes++;
+	say("rcg %s: cfg %#x %s (cmd %#x cfg %#x)\n", name, cfg, ok ? "set" : "NOT TAKEN", rd(c), rd(c + 4));
+	return ok;
+}
+
+static bool
+cam_branches(bool on)
+{
+	bool ok = true;
+
+	if (on) {
+		for (unsigned i = 0; i < CAM_BRANCHES && ok; i++) {
+			vm_offset_t b = cam.cc + cam_branch[i].off;
+
+			cam.f_branch[i] = rd(b);
+			wr(b, cam.f_branch[i] | 1);
+			cam.writes++;
+			if (!cam_wait(b, 1u << 31, 0, 500)) {
+				say("branch %s: CLK_OFF stays (%#x)%s\n", cam_branch[i].name, rd(b),
+				    cam_branch[i].wait ? ": stop" : ": not waited on, as Linux");
+				ok = !cam_branch[i].wait;
+			}
+		}
+		say("branches: %s\n", ok ? "all on" : "NOT all on");
+		return ok;
+	}
+	for (int i = (int)CAM_BRANCHES - 1; i >= 0; i--) {
+		vm_offset_t b = cam.cc + cam_branch[i].off;
+
+		wr(b, (rd(b) & ~1u) | (cam.f_branch[i] & 1));
+		cam.writes++;
+	}
+	say("branches: back as found\n");
+	return true;
+}
+
+/* ---- the SMMU window (hakios_iceland_pcie.c's smmu_on / smmu_off, for stream 0x1c00) -------------------------------- */
+
+#define CBAR_OURS               (1u << 16 | 3u << 8 | 0xfu << 12)
+
+static void
+cam_clean(vm_offset_t va, vm_size_t size)
+{
+	for (vm_offset_t l = va & ~63ul; l < va + size; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+cam_smmu_on(void)
+{
+	uint32_t id0, id1, nsmr, ncb, page, numpage, cbar, sctlr;
+	uint64_t l3_pa[6], tpa;
+	const uint32_t total = cam.nbufs * CAM_BUF_BYTES, n3 = (total + 0x1fffff) >> 21;
+
+	/* the mappings and the tables' memory are made once and kept: the service comes through here at every start */
+	if (cam.gr0 == 0) {
+		cam.gr0 = ml_io_map(SMMU_PHYS, 0x1000);
+	}
+	if (cam.gr0 == 0) {
+		return false;
+	}
+	id0 = rd(cam.gr0 + 0x20);
+	id1 = rd(cam.gr0 + 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	numpage = 1u << (((id1 >> 28) & 7) + 1);
+	if (cam.smr >= nsmr || cam.bank >= ncb || id0 == 0xffffffffu) {
+		say("smmu REFUSED: %u SMRs, %u banks (ID0 %#x)\n", nsmr, ncb, id0);
+		return false;
+	}
+	if (cam.gr1 == 0) {
+		cam.gr1 = ml_io_map(SMMU_PHYS + page, 0x1000);
+		cam.cb = ml_io_map(SMMU_PHYS + (vm_offset_t)(numpage + cam.bank) * page, 0x1000);
+	}
+	if (cam.gr1 == 0 || cam.cb == 0) {
+		return false;
+	}
+	cam.f_smr = rd(cam.gr0 + 0x800 + 4 * cam.smr);
+	cam.f_s2cr = rd(cam.gr0 + 0xc00 + 4 * cam.smr);
+	cbar = rd(cam.gr1 + 4 * cam.bank);
+	sctlr = rd(cam.cb);
+	say("smmu as found: sCR0 %#x; SMR%u %#x S2CR %#x; bank %u CBAR %#x SCTLR %#x (%u SMRs, %u banks)\n", rd(cam.gr0),
+	    cam.smr, cam.f_smr, cam.f_s2cr, cam.bank, cbar, sctlr, nsmr, ncb);
+	if ((cam.f_smr >> 31) || (sctlr & 1) || (cbar != 0 && cbar != CBAR_OURS)) {
+		say("smmu REFUSED: SMR %u or bank %u is not free\n", cam.smr, cam.bank);
+		return false;
+	}
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = rd(cam.gr0 + 0x800 + 4 * i), s2cr = rd(cam.gr0 + 0xc00 + 4 * i);
+
+		if (!(smr >> 31)) {
+			continue;
+		}
+		if (((CAM_SID ^ smr) & ~(smr >> 16) & 0x7fff) == 0 || (((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == cam.bank)) {
+			say("smmu REFUSED: SMR %u (%#x, S2CR %#x) has the camera's stream or bank %u\n", i, smr, s2cr, cam.bank);
+			return false;
+		}
+	}
+	/* level 1, level 2 and n3 level-3 tables, 4 KB each, whatever the kernel's page size */
+	if (n3 > 6 || (cam.tables == 0 && kmem_alloc(kernel_map, &cam.tables, 8 * 0x1000, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)) {
+		say("smmu REFUSED: no memory for the tables\n");
+		cam.tables = 0;
+		return false;
+	}
+	bzero((void *)cam.tables, 8 * 0x1000);
+	/* the level-3 tables are filled as one array through their mapping; each is named by its own physical address */
+	for (uint32_t k = 0; k < n3; k++) {
+		l3_pa[k] = kvtophys(cam.tables + (2 + k) * 0x1000);
+	}
+	cam_tables((uint64_t *)cam.tables, (uint64_t *)(cam.tables + 0x1000), (uint64_t *)(cam.tables + 0x2000),
+	    kvtophys(cam.tables + 0x1000), l3_pa, n3, cam.buf_pa, total);
+	cam_clean(cam.tables, 8 * 0x1000);
+	tpa = kvtophys(cam.tables);
+	say("smmu: window %#x + %#x -> %#llx, tables %#llx, SMR %u -> bank %u, ASID %u\n", CAM_IOVA, total, cam.buf_pa, tpa,
+	    cam.smr, cam.bank, cam.asid);
+	cam.did |= D_SMMU;
+	cwl("CBA2R", cam.gr1, 0x800 + 4 * cam.bank, 1);
+	cwl("CBAR", cam.gr1, 4 * cam.bank, CBAR_OURS);
+	cwl("TCR2", cam.cb, 0x10, 2u | 7u << 15);
+	cwl("TTBR0lo", cam.cb, 0x20, (uint32_t)tpa);
+	cwl("TTBR0hi", cam.cb, 0x24, (uint32_t)(tpa >> 32) | cam.asid << 16);
+	cwl("TCR", cam.cb, 0x30, 1u << 23 | 3u << 12 | 1u << 10 | 1u << 8 | 32u);
+	cwl("MAIR0", cam.cb, 0x38, 0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24);
+	cwl("MAIR1", cam.cb, 0x3c, 0);
+	cwl("TLBIASID", cam.cb, 0x610, cam.asid);
+	cwl("TLBSYNC", cam.cb, 0x7f0, 0);
+	(void)cam_wait(cam.cb + 0x7f4, 1, 0, 10000);
+	cwl("FSR", cam.cb, 0x58, rd(cam.cb + 0x58));
+	/* M, TRE, AFE, CFRE, S1_ASIDPNE: hakios_iceland_pcie.c's word (no fault interrupt: nothing handles it) */
+	cwl("SCTLR", cam.cb, 0x0, 1u << 5 | 1u << 2 | 1u << 1 | 1u << 0 | 1u << 12);
+	cwl("S2CR", cam.gr0, 0xc00 + 4 * cam.smr, cam.bank);
+	cwl("SMR", cam.gr0, 0x800 + 4 * cam.smr, 1u << 31 | CAM_SID);
+	return true;
+}
+
+static bool
+cam_smmu_fault(const char *when)
+{
+	uint32_t fsr;
+
+	if (cam.cb == 0 || !(cam.did & D_SMMU)) {
+		return false;
+	}
+	fsr = rd(cam.cb + 0x58);
+	if ((fsr & ~0x600u) == 0) {             /* bits 10:9 are the format, not a fault */
+		return false;
+	}
+	say("smmu FAULT (%s): FSR %#x FAR %#x_%08x FSYNR0 %#x\n", when, fsr, rd(cam.cb + 0x64), rd(cam.cb + 0x60),
+	    rd(cam.cb + 0x68));
+	return true;
+}
+
+/* the stream invalid first (as found), the bank off; CBAR / CBA2R stay (the hypervisor refuses a stage-2 type back) */
+static void
+cam_smmu_off(void)
+{
+	cwl("SMR", cam.gr0, 0x800 + 4 * cam.smr, cam.f_smr);
+	cwl("S2CR", cam.gr0, 0xc00 + 4 * cam.smr, cam.f_s2cr);
+	cwl("SCTLR", cam.cb, 0x0, 0);
+	cwl("TLBIASID", cam.cb, 0x610, cam.asid);
+	cwl("TLBSYNC", cam.cb, 0x7f0, 0);
+	(void)cam_wait(cam.cb + 0x7f4, 1, 0, 10000);
+	cwl("FSR", cam.cb, 0x58, rd(cam.cb + 0x58));
+	cwl("TTBR0lo", cam.cb, 0x20, 0);
+	cwl("TTBR0hi", cam.cb, 0x24, 0);
+	cwl("TCR", cam.cb, 0x30, 0);
+	cwl("TCR2", cam.cb, 0x10, 0);
+	cwl("MAIR0", cam.cb, 0x38, 0);
+}
+
+/* ---- the sensor on the bus ------------------------------------------------------------------------------------------ */
+
+static bool
+cam_write8(uint8_t addr, uint16_t reg, uint8_t val)
+{
+	bool ok;
+
+	if (!level(PIN_SDA) || !level(PIN_SCL)) {
+		return false;
+	}
+	i2c_start();
+	ok = i2c_out((uint8_t)(addr << 1)) && i2c_out((uint8_t)(reg >> 8)) && i2c_out((uint8_t)reg) && i2c_out(val);
+	i2c_stop();
+	return ok;
+}
+
+static bool
+cam_read8(uint8_t addr, uint16_t reg, uint8_t *val)
+{
+	uint16_t v = 0;
+
+	/* two bytes from `reg`: the first is the register's */
+	if (read16(addr, reg, &v) != 0) {
+		return false;
+	}
+	*val = (uint8_t)(v >> 8);
+	return true;
+}
+
+/* sensor_run()'s power-up, for a sensor that stays on */
+static bool
+cam_sensor_up(const struct sensor *s)
+{
+	struct pad *m = s->mclk;
+	uint16_t id = 0;
+	int r = 4;
+	bool ok;
+
+	say("%s: power up\n", s->name);
+	cam.did |= D_SENSOR;
+	ok = reset_drive(&reset_front, false) && reset_drive(&reset_rear, false);
+	if (ok) {
+		ok = rail_on(&vio);
+		wait_us(1000);
+	}
+	if (ok) {
+		ok = rail_on(&vdig);
+		wait_us(1000);
+	}
+	if (ok) {
+		ok = rail_on(&vana);
+		wait_us(1000);
+	}
+	if (ok) {
+		bus_look("with the rails on");
+		ok = reset_drive(s->reset, true);
+		wait_us(5000);
+	}
+	if (ok) {
+		m->source_set = true;
+		ok = sp_write(&m->p, GPIO_OUT_SOURCE_CTL, (m->source & 0x80) | GPIO_FUNC2);
+		if (ok && (m->mode & 3) == 0) {
+			m->mode_set = true;
+			ok = sp_write(&m->p, GPIO_MODE_CTL, 2);
+		}
+		if (ok && !(m->en & 0x80)) {
+			m->en_set = true;
+			ok = sp_write(&m->p, GPIO_EN_CTL, 0x80);
+		}
+	}
+	if (ok) {
+		mclk_voted = true;
+		stores++;
+		ok = hakios_iceland_rpmh_vote(MCLK_RES, -1, 0, true) == 0;
+		wait_us(6000);
+	}
+	for (int t = 0; ok && t < 3; t++) {
+		r = read16(s->addr, REG_CHIP_ID, &id);
+		if (r == 0) {
+			break;
+		}
+		wait_us(20000);
+	}
+	if (!ok || r != 0 || id != s->id) {
+		say("%s: %s (chip id %#x, bus result %d)\n", s->name, ok ? "does not answer as expected" : "a power-up step failed",
+		    id, r);
+		return false;
+	}
+	say("%s: chip id 0x%04x at 0x%02x: OK\n", s->name, id, s->addr);
+	return true;
+}
+
+static bool
+cam_sensor_down(const struct sensor *s)
+{
+	struct pad *m = s->mclk;
+	bool ok;
+
+	say("%s: power down\n", s->name);
+	if (mclk_voted) {
+		stores++;
+		if (hakios_iceland_rpmh_vote(MCLK_RES, -1, 0, false) == 0) {
+			mclk_voted = false;
+		}
+		wait_us(4000);
+	}
+	ok = reset_drive(s->reset, false);
+	ok &= pad_back(m);
+	wait_us(1000);
+	rail_off(&vana);
+	wait_us(1000);
+	rail_off(&vdig);
+	wait_us(1000);
+	rail_off(&vio);
+	ok &= pad_back(&reset_front);
+	ok &= pad_back(&reset_rear);
+	ok = ok && !mclk_voted && !vio.voted && !vdig.voted && !vana.voted;
+	say("%s: power down %s\n", s->name, ok ? "complete" : "NOT complete");
+	return ok;
+}
+
+static bool
+cam_gain_write(const struct sensor *s, uint32_t gain)
+{
+	uint8_t ladder, fine;
+
+	cam_gain_regs(gain, &ladder, &fine);
+	return cam_write8(s->addr, 0x3e08, ladder) && cam_write8(s->addr, 0x3e07, fine);
+}
+
+/* the mode's list and the controls, as sc_enable_streams; the stream-on is cam_stream_on() */
+static bool
+cam_sensor_setup(const struct sensor *s)
+{
+	uint32_t e = cam.exp << 5, bad = 0;
+	uint8_t back[3] = { 0, 0, 0 };
+
+	if (!cam_write8(s->addr, 0x0103, 0x01)) {
+		say("%s: the soft reset was not acknowledged\n", s->name);
+		return false;
+	}
+	wait_us(250);
+	for (uint32_t i = 0; i < iceland_cam_front_tbl_n; i++) {
+		if (!cam_write8(s->addr, iceland_cam_front_tbl[i].reg, iceland_cam_front_tbl[i].val)) {
+			bad++;
+		}
+	}
+	bad += !cam_write8(s->addr, 0x3e00, (uint8_t)(e >> 16));
+	bad += !cam_write8(s->addr, 0x3e01, (uint8_t)(e >> 8));
+	bad += !cam_write8(s->addr, 0x3e02, (uint8_t)e);
+	bad += !cam_write8(s->addr, 0x320e, (uint8_t)(CAM_VTS >> 8));
+	bad += !cam_write8(s->addr, 0x320f, (uint8_t)CAM_VTS);
+	bad += !cam_gain_write(s, cam.gain);
+	(void)cam_read8(s->addr, 0x3e01, &back[0]);
+	(void)cam_read8(s->addr, 0x320e, &back[1]);
+	(void)cam_read8(s->addr, 0x3e08, &back[2]);
+	say("%s: %u list writes + 7 controls, %u not acknowledged; exposure %u lines, gain %u/128; read back 0x3e01 %02x "
+	    "(%02x) 0x320e %02x (%02x) 0x3e08 %02x\n", s->name, iceland_cam_front_tbl_n, bad, cam.exp, cam.gain, back[0],
+	    (uint8_t)(e >> 8), back[1], (uint8_t)(CAM_VTS >> 8), back[2]);
+	/* a write that was not acknowledged is said, not fatal: the frames tell what the sensor took */
+	return true;
+}
+
+/* at boot, while memory is not yet fragmented: the three frame buffers as one physical range (kept for the boot) */
+static void
+cam_reserve(void)
+{
+	if (psci_smp_hvc != 0 || cam.buf != 0) {
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &cam.buf, CAM_BUFS * CAM_BUF_BYTES, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		cam.buf = 0;
+	}
+	say("%u MB of frame buffers %s at boot\n", CAM_BUFS * CAM_BUF_BYTES >> 20, cam.buf ? "reserved" : "NOT reserved");
+}
+
+/* ---- the CSIPHY, the CSID, the write master --------------------------------------------------------------------------- */
+
+static bool
+cam_phy_on(void)
+{
+	uint32_t settle = cam_settle(CAM_LINK_HZ, CAM_TIMER_HZ), version, before = cam.writes;
+
+	if (settle == 0) {
+		return false;
+	}
+	cam.did |= D_PHY;
+	cw(cam.phy, PHY_CTRL(0), 1);                    /* reset */
+	delay_for_interval(6, NSEC_PER_MSEC);
+	cw(cam.phy, PHY_CTRL(0), 0);
+	cw(cam.phy, PHY_CTRL(6), 2);                    /* show the revision in STATUS12..15 */
+	version = rd(cam.phy + PHY_STATUS(12)) | rd(cam.phy + PHY_STATUS(13)) << 8 | rd(cam.phy + PHY_STATUS(14)) << 16 |
+	    rd(cam.phy + PHY_STATUS(15)) << 24;
+	cw(cam.phy, PHY_CTRL(5), 1u << 7 | 0x55);       /* the clock lane and data lanes 0..3 (bits 0 2 4 6) */
+	cw(cam.phy, PHY_CTRL(6), 1);
+	cw(cam.phy, PHY_CTRL(7), 2);
+	cw(cam.phy, PHY_CTRL(0), 0);
+	cw(cam.phy, PHY_CTRL(7), 0x7a);                 /* the list's first two entries */
+	cw(cam.phy, PHY_CTRL(6), 1);
+	for (unsigned l = 0; l < 5; l++) {
+		bool clock = phy_lane_base[l] == 0xe00;
+		unsigned n = clock ? sizeof(phy_clock_lane) / sizeof(phy_clock_lane[0]) :
+		    sizeof(phy_data_lane) / sizeof(phy_data_lane[0]);
+
+		for (unsigned i = 0; i < n; i++) {
+			uint16_t reg = clock ? phy_clock_lane[i].reg : phy_data_lane[i].reg;
+			uint8_t val = clock ? phy_clock_lane[i].val : phy_data_lane[i].val;
+			uint8_t us = clock ? phy_clock_lane[i].wait_us : phy_data_lane[i].wait_us;
+
+			cw(cam.phy, phy_lane_base[l] + reg, reg == 0x08 ? settle : val);
+			if (us) {
+				wait_us(us);
+			}
+		}
+	}
+	for (unsigned n = 11; n <= 21; n++) {
+		cw(cam.phy, PHY_CTRL(n), 0);            /* its interrupts masked */
+	}
+	say("csiphy5: version %#x, settle count %u, %u stores; CTRL5 %#x CTRL6 %#x CTRL7 %#x, lane 0 +0 %#x +8 %#x%s\n", version,
+	    settle, cam.writes - before, rd(cam.phy + PHY_CTRL(5)), rd(cam.phy + PHY_CTRL(6)), rd(cam.phy + PHY_CTRL(7)),
+	    rd(cam.phy), rd(cam.phy + 8), rd(cam.phy + PHY_CTRL(5)) == 0xd5 && rd(cam.phy + 8) == settle ? "" :
+	    " (NOT as written: the stream goes on, the frames tell)");
+	return true;
+}
+
+static void
+cam_phy_off(void)
+{
+	cw(cam.phy, PHY_CTRL(5), 0);
+	cw(cam.phy, PHY_CTRL(6), 0);
+}
+
+static bool
+cam_csid_reset(void)
+{
+	bool done = false;
+
+	cam.did |= D_CSID;
+	cw(cam.csid, CSID_TOP_CLEAR, 0x9);              /* reset done, buffer done */
+	cw(cam.csid, CSID_TOP_MASK, 0x9);
+	cw(cam.csid, CSID_BUF_CLEAR, BUF_DONE_RDI0);
+	cw(cam.csid, CSID_BUF_MASK, BUF_DONE_RDI0);
+	cw(cam.csid, CSID_IRQ_CMD, 1);
+	cw(cam.csid, CSID_RST_CFG, 0x11);
+	cw(cam.csid, CSID_RST_CMD, 0x5);
+	for (unsigned t = 0; t < 500 && !done; t++) {
+		done = rd(cam.csid + CSID_TOP_STATUS) & 1;
+		if (!done) {
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+	}
+	cw(cam.csid, CSID_TOP_CLEAR, 0x1);
+	cw(cam.csid, CSID_IRQ_CMD, 1);
+	say("csid0: reset %s (top status %#x)\n", done ? "done" : "NOT seen done within 500 ms (the stream goes on, the frames tell)",
+	    rd(cam.csid + CSID_TOP_STATUS));
+	return true;
+}
+
+static inline void
+cam_addr(uint32_t buffer)
+{
+	cw(cam.vfe, VFE_WM + 0x04, (CAM_IOVA + buffer * CAM_BUF_BYTES) >> 8);
+}
+
+/* vfe_wm_start, then the first two addresses (vfe_enable_output_v2) */
+static void
+cam_wm_on(void)
+{
+	cam.did |= D_WM;
+	cw(cam.vfe, VFE_CGC, 0x7ffffff);
+	cw(cam.vfe, VFE_TEST_BUS, 0);
+	cw(cam.vfe, VFE_WM + 0x08, CAM_BPL16 * CAM_H >> 8);     /* FRAME_INCR */
+	cw(cam.vfe, VFE_WM + 0x0c, 0xffff);                     /* IMAGE_CFG_0 */
+	cw(cam.vfe, VFE_WM + 0x14, 0xffff);                     /* IMAGE_CFG_2 */
+	cw(cam.vfe, VFE_WM + 0x18, 0);                          /* PACKER_CFG */
+	cw(cam.vfe, VFE_WM + 0x38, 0);                          /* FRAMEDROP_PERIOD / PATTERN */
+	cw(cam.vfe, VFE_WM + 0x3c, 1);
+	cw(cam.vfe, VFE_WM + 0x30, 0);                          /* IRQ_SUBSAMPLE_PERIOD / PATTERN */
+	cw(cam.vfe, VFE_WM + 0x34, 1);
+	cw(cam.vfe, VFE_WM + 0x60, 1);                          /* MMU_PREFETCH_CFG / MAX_OFFSET */
+	cw(cam.vfe, VFE_WM + 0x64, 0xffffffff);
+	cw(cam.vfe, VFE_WM + 0x00, 1u | 1u << 16);              /* enable, frame mode */
+	cam_addr(0);
+	cam_addr(1);
+	cam.queued = 2;
+	say("tfe0 write master 23: cfg %#x addr %#x frame incr %#x\n", rd(cam.vfe + VFE_WM), rd(cam.vfe + VFE_WM + 4),
+	    rd(cam.vfe + VFE_WM + 8));
+}
+
+/* csid_configure_stream for RDI0: csiphy5, 4 lanes in order, RAW10, payload only, virtual channel 0 */
+static void
+cam_csid_on(void)
+{
+	cw(cam.csid, CSID_RX_CFG0, 3u | 0x3210u << 4 | (5u + 1) << 20);
+	cw(cam.csid, CSID_RX_CFG1, 1);
+	cw(cam.csid, CSID_RDI_CFG0, 1u << 6 | 1u << 8 | 1u << 5 | 0xfu << 12 | 0x2bu << 16);
+	cw(cam.csid, CSID_RDI_CFG1, 1u << 15);
+	cw(cam.csid, CSID_RDI_PIX_STORE, 4u << 1 | 1);
+	cw(cam.csid, CSID_RDI_CTRL, 0);
+	cw(cam.csid, CSID_RDI_CFG0, rd(cam.csid + CSID_RDI_CFG0) | 1u << 31);
+	/* polled, no interrupt line attached: the receiver's and RDI0's status words are let through to be read */
+	cw(cam.csid, CSID_RX_CLEAR, 0xffffffff);
+	cw(cam.csid, CSID_RX_MASK, 0xffffffff);
+	cw(cam.csid, CSID_RDI_CLEAR, 0xffffffff);
+	cw(cam.csid, CSID_RDI_MASK, 0xffffffff);
+	cw(cam.csid, CSID_BUF_CLEAR, BUF_DONE_RDI0);
+	cw(cam.csid, CSID_BUF_MASK, BUF_DONE_RDI0);
+	cw(cam.csid, CSID_TOP_MASK, 0xd);
+	cw(cam.csid, CSID_IRQ_CMD, 1);
+	for (unsigned k = 0; k < 2; k++) {
+		cw(cam.csid, CSID_AUP_CMD, RDI0_BIT);
+		cw(cam.csid, CSID_RUP_AUP_CMD, 1);
+	}
+	cw(cam.csid, CSID_RUP_CMD, RDI0_BIT);
+	cw(cam.csid, CSID_RUP_AUP_CMD, 1);
+	cw(cam.csid, CSID_RDI_CTRL, 1);
+	say("csid0: rx cfg0 %#x, rdi0 cfg0 %#x cfg1 %#x ctrl %#x\n", rd(cam.csid + CSID_RX_CFG0), rd(cam.csid + CSID_RDI_CFG0),
+	    rd(cam.csid + CSID_RDI_CFG1), rd(cam.csid + CSID_RDI_CTRL));
+}
+
+/* the write master first (nothing more reaches memory), then RDI0 */
+static void
+cam_csid_off(void)
+{
+	if (cam.did & D_WM) {
+		cw(cam.vfe, VFE_WM + 0x00, 0);
+	}
+	cw(cam.csid, CSID_RDI_CTRL, 0);
+	cw(cam.csid, CSID_RDI_CFG0, rd(cam.csid + CSID_RDI_CFG0) & ~(1u << 31));
+	cw(cam.csid, CSID_RUP_CMD, RDI0_BIT);
+	cw(cam.csid, CSID_RUP_AUP_CMD, 1);
+	cw(cam.csid, CSID_RX_MASK, 0);
+	cw(cam.csid, CSID_RDI_MASK, 0);
+	cw(cam.csid, CSID_BUF_MASK, 0);
+	cw(cam.csid, CSID_TOP_MASK, 0);
+	say("stopped: write master cfg %#x, rdi0 cfg0 %#x\n", (cam.did & D_WM) ? rd(cam.vfe + VFE_WM) : 0,
+	    rd(cam.csid + CSID_RDI_CFG0));
+}
+
+/* ---- the buffers ---------------------------------------------------------------------------------------------------- */
+
+static inline uint8_t *
+cam_buffer(uint32_t b)
+{
+	return (uint8_t *)(cam.buf + (vm_offset_t)b * CAM_BUF_BYTES);
+}
+
+/* what the hardware stored is not what the caches hold: the lines dropped before a read (nothing of ours is dirty there) */
+static void
+cam_fresh(const uint8_t *p, uint32_t n)
+{
+	cam_clean((vm_offset_t)p, n);
+}
+
+/* a buffer's first and last 64 bytes of a frame are the fill again: a whole new frame replaces both */
+static void
+cam_mark(uint32_t b)
+{
+	uint8_t *p = cam_buffer(b);
+
+	memset(p, CAM_FILL, 64);
+	memset(p + cam.stride * CAM_H - 64, CAM_FILL, 64);
+	cam_clean((vm_offset_t)p, 64);
+	cam_clean((vm_offset_t)p + cam.stride * CAM_H - 64, 64);
+}
+
+static bool
+cam_whole(uint32_t b)
+{
+	const uint8_t *p = cam_buffer(b);
+
+	cam_fresh(p, 64);
+	cam_fresh(p + cam.stride * CAM_H - 64, 64);
+	return !cam_all_fill(p, 64) && !cam_all_fill(p + cam.stride * CAM_H - 64, 64);
+}
+
+/* ---- the stream ------------------------------------------------------------------------------------------------------ */
+
+static uint64_t
+cam_ms(uint64_t since)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - since, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* one look at the CSID's status words (each cleared when seen); true = RDI0's buffer done */
+static bool
+cam_poll(void)
+{
+	uint32_t top = rd(cam.csid + CSID_TOP_STATUS), buf = rd(cam.csid + CSID_BUF_STATUS);
+	uint32_t rdi = rd(cam.csid + CSID_RDI_STATUS), rx = rd(cam.csid + CSID_RX_STATUS);
+
+	if ((top | buf | rdi | rx) == 0) {
+		return false;
+	}
+	if (top) {
+		cw(cam.csid, CSID_TOP_CLEAR, top);
+	}
+	if (buf) {
+		cw(cam.csid, CSID_BUF_CLEAR, buf);
+	}
+	if (rdi) {
+		cw(cam.csid, CSID_RDI_CLEAR, rdi);
+	}
+	if (rx) {
+		cw(cam.csid, CSID_RX_CLEAR, rx);
+	}
+	cw(cam.csid, CSID_IRQ_CMD, 1);
+	cam.sof += (rdi & RDI_SOF) != 0;
+	cam.eof += (rdi & RDI_EOF) != 0;
+	cam.rup += (rdi & RDI_RUP_DONE) != 0;
+	if (cam.rx_bits == 0 && rx != 0 && cam.t_on != 0) {
+		say("stream: the first receiver word %#x, %llu ms after stream-on\n", rx, cam_ms(cam.t_on));
+	}
+	cam.rx_bits |= rx;
+	cam.rdi_bits |= rdi;
+	return (buf & BUF_DONE_RDI0) != 0;
+}
+
+/* the next address at every buffer-done, as vfe_buf_done: the buffers go round, the one two frames back is free to read */
+static void
+cam_next(void)
+{
+	cam_addr(cam.queued % CAM_BUFS);
+	cam.queued++;
+	cw(cam.csid, CSID_AUP_CMD, RDI0_BIT);
+	cw(cam.csid, CSID_RUP_AUP_CMD, 1);
+}
+
+static void
+cam_report(const char *what, uint32_t b)
+{
+	const uint8_t *p = cam_buffer(b);
+	uint32_t extent, white = 0;
+	char cells[THUMB_W + 1];
+
+	cam_fresh(p, CAM_BUF_BYTES);
+	extent = cam_extent(p, CAM_BUF_BYTES);
+	say("%s: buffer %u: %u bytes written (packed %u, padded %u): stride %u%s; guard %s; first bytes %02x %02x %02x %02x %02x "
+	    "%02x %02x %02x %02x %02x\n", what, b, extent, CAM_BPL * CAM_H, CAM_BPL16 * CAM_H, cam.stride,
+	    extent == CAM_BPL * CAM_H || extent == CAM_BPL16 * CAM_H - (CAM_BPL16 - CAM_BPL) || extent == CAM_BPL16 * CAM_H ?
+	    "" : " (NOT a whole frame's extent)", extent <= CAM_BPL16 * CAM_H ? "intact" : "WRITTEN INTO", p[0], p[1], p[2],
+	    p[3], p[4], p[5], p[6], p[7], p[8], p[9]);
+	cam_measure(p, cam.stride, 2, &cam_st);
+	for (unsigned k = 0; k < 4; k++) {
+		static const char *const pos[4] = { "B  (0,0)", "Gb (0,1)", "Gr (1,0)", "R  (1,1)" };
+		uint32_t mean10 = cam_st.n[k] ? (uint32_t)(cam_st.sum[k] * 10 / cam_st.n[k]) : 0;
+
+		say("stats %s: min %u mean %u.%u max %u; histogram %u %u %u %u %u %u %u %u\n", pos[k], cam_st.min[k], mean10 / 10,
+		    mean10 % 10, cam_st.max[k], cam_st.hist[k][0], cam_st.hist[k][1], cam_st.hist[k][2], cam_st.hist[k][3],
+		    cam_st.hist[k][4], cam_st.hist[k][5], cam_st.hist[k][6], cam_st.hist[k][7]);
+	}
+	/* the thumbnail's white: the top of the highest bin that holds a hundredth of the green pixels */
+	for (int bin = 7; bin >= 0 && white == 0; bin--) {
+		if ((uint64_t)(cam_st.hist[1][bin] + cam_st.hist[2][bin]) * 100 >= cam_st.n[1] + cam_st.n[2]) {
+			white = ((uint32_t)bin + 1) * 128;
+		}
+	}
+	white = white > CAM_BLACK ? white - CAM_BLACK : 0;
+	for (uint32_t ty = 0; ty < THUMB_H; ty++) {
+		cam_thumb_row(p, cam.stride, ty, white, cells);
+		say("thumb |%s|\n", cells);
+	}
+}
+
+/* level 3: `want` frames, then the newest whole buffer measured; level 4: `secs` seconds of pictures */
+static bool
+cam_capture(const struct sensor *s, uint32_t level_arg, uint32_t want, uint32_t secs)
+{
+	uint64_t t_last = 0, t_sec, t0;
+	uint32_t n_sec = 0, torn = 0, pictures = 0, means[3] = { 0, 0, 0 }, green = 0, last_whole = CAM_BUFS;
+	uint32_t limit_ms = level_arg >= 4 ? secs * 1000 : 3000;
+	bool first = false, stride_known = false;
+
+	/* stale words from before the stream are not frames: read, logged and cleared */
+	say("stream: before stream-on: top %#x buf %#x rdi0 %#x rx %#x\n", rd(cam.csid + CSID_TOP_STATUS),
+	    rd(cam.csid + CSID_BUF_STATUS), rd(cam.csid + CSID_RDI_STATUS), rd(cam.csid + CSID_RX_STATUS));
+	(void)cam_poll();
+	cam.sof = cam.eof = cam.rup = cam.rx_bits = cam.rdi_bits = 0;
+	cam.did |= D_STREAM;
+	if (!cam_write8(s->addr, 0x0100, 0x01)) {
+		say("%s: the stream-on was not acknowledged\n", s->name);
+		return false;
+	}
+	cam.t_on = t0 = t_sec = mach_absolute_time();
+	say("%s: stream on\n", s->name);
+	while (cam_ms(t0) < limit_ms && (level_arg >= 4 || cam.frames < want)) {
+		if (!cam_poll()) {
+			if (!first && cam_ms(t0) >= 1500) {
+				say("stream: no frame within 1.5 s of stream-on\n");
+				break;
+			}
+			wait_us(250);
+			continue;
+		}
+		if (cam_ms(t0) < 1 || (t_last != 0 && cam_ms(t_last) < 1)) {
+			cam.stale++;                    /* a sensor frame takes 33 ms */
+			continue;
+		}
+		cam_next();
+		if (!first) {
+			first = true;
+			cam.t_first = mach_absolute_time();
+			say("stream: the first buffer done %llu ms after stream-on (sof %u eof %u rup %u)\n", cam_ms(t0), cam.sof,
+			    cam.eof, cam.rup);
+		}
+		t_last = mach_absolute_time();
+		cam.frames++;
+		n_sec++;
+		/* the buffer of this frame: queued three addresses ago (two queued ahead at every moment) */
+		last_whole = (cam.queued - 3) % CAM_BUFS;
+		if (level_arg >= 4) {
+			if (cam_whole(last_whole)) {
+				if (!stride_known) {
+					/* the first whole frame says whether the lines are padded to 16 bytes (the rest is still the fill) */
+					cam_fresh(cam_buffer(last_whole), CAM_BUF_BYTES);
+					if (cam_extent(cam_buffer(last_whole), CAM_BUF_BYTES) > CAM_BPL * CAM_H) {
+						cam.stride = CAM_BPL16;
+					}
+					stride_known = true;
+					say("stream: the lines are %u bytes apart\n", cam.stride);
+				}
+				cam_fresh(cam_buffer(last_whole), cam.stride * CAM_H);
+				green = cam_debayer(cam_buffer(last_whole), cam.stride, (uint8_t *)cam.out, means);
+				pictures++;
+				cam_mark(last_whole);
+			} else {
+				torn++;
+			}
+			if (cam.frames % 6 == 0 && pictures != 0) {
+				uint32_t g = cam_ae(cam.gain, green);
+
+				if (g != cam.gain && cam_gain_write(s, g)) {
+					cam.gain = g;
+				}
+			}
+			if (cam_ms(t_sec) >= 1000) {
+				say("stream: %u frames in %llu ms; %u pictures, %u not whole; R %u G %u B %u (of 255), green %u, gain "
+				    "%u/128; sof %u eof %u\n", n_sec, cam_ms(t_sec), pictures, torn, means[0], means[1], means[2], green,
+				    cam.gain, cam.sof, cam.eof);
+				n_sec = 0;
+				t_sec = mach_absolute_time();
+			}
+		}
+	}
+	say("stream: %u frames, %u stale, in %llu ms; sof %u eof %u rup %u; receiver bits %#x, rdi0 bits %#x; phy status "
+	    "%#x %#x %#x %#x\n", cam.frames, cam.stale, cam_ms(t0), cam.sof, cam.eof, cam.rup, cam.rx_bits, cam.rdi_bits,
+	    rd(cam.phy + PHY_STATUS(0)), rd(cam.phy + PHY_STATUS(1)), rd(cam.phy + PHY_STATUS(2)), rd(cam.phy + PHY_STATUS(3)));
+	(void)cam_smmu_fault("after the stream");
+	/* stop: the write master and RDI0, the PHY's lanes, the sensor's stream; then what arrived late */
+	cam_csid_off();
+	cam_phy_off();
+	(void)cam_write8(s->addr, 0x0100, 0x00);
+	cam.did &= ~(D_STREAM | D_WM | D_CSID | D_PHY);
+	delay_for_interval(100, NSEC_PER_MSEC);
+	say("stream: after the stop: top %#x buf %#x; write master cfg %#x\n", rd(cam.csid + CSID_TOP_STATUS),
+	    rd(cam.csid + CSID_BUF_STATUS), rd(cam.vfe + VFE_WM));
+	if (cam.frames == 0) {
+		for (uint32_t b = 0; b < CAM_BUFS; b++) {
+			cam_fresh(cam_buffer(b), CAM_BUF_BYTES);
+			say("no frame: buffer %u holds %u bytes that are not the fill\n", b, cam_extent(cam_buffer(b), CAM_BUF_BYTES));
+		}
+		return false;
+	}
+	/* the newest buffer that holds a whole frame: the last one done, else the ones before it */
+	for (uint32_t k = 0; k < CAM_BUFS; k++) {
+		uint32_t b = (last_whole + CAM_BUFS - k) % CAM_BUFS;
+
+		if (cam_whole(b)) {
+			uint32_t extent;
+
+			cam_fresh(cam_buffer(b), CAM_BUF_BYTES);
+			extent = cam_extent(cam_buffer(b), CAM_BUF_BYTES);
+			if (extent > CAM_BPL * CAM_H) {
+				cam.stride = CAM_BPL16;         /* the lines are padded to 16 bytes */
+			}
+			cam_report(level_arg >= 4 ? "last frame" : "frame", b);
+			return true;
+		}
+	}
+	if (level_arg >= 4 && pictures != 0) {
+		/* every whole frame was made into a picture and its buffer marked again: nothing raw is left to measure */
+		say("pictures: %u of %u frames (%u not whole); the last one's means R %u G %u B %u, gain %u/128\n", pictures,
+		    cam.frames, torn, means[0], means[1], means[2], cam.gain);
+		return true;
+	}
+	say("no buffer holds a whole frame (%u buffer-done events)\n", cam.frames);
+	return false;
+}
+
+/* ---- the whole run --------------------------------------------------------------------------------------------------- */
+
+static void
+cam_down(const struct sensor *s)
+{
+	say("down: what is up %#x\n", cam.did);
+	if (cam.did & D_CSID) {
+		cam_csid_off();
+	}
+	if (cam.did & D_PHY) {
+		cam_phy_off();
+	}
+	if (cam.did & D_STREAM) {
+		(void)cam_write8(s->addr, 0x0100, 0x00);
+	}
+	/* the window first, while the camera NoC's clocks and MM1 still run */
+	if (cam.did & D_SMMU) {
+		(void)cam_smmu_fault("at the end");
+		cam_smmu_off();
+	}
+	if (cam.did & D_SENSOR) {
+		if (icecam_last) {
+			say("down: the sensor into reset only: %s\n", reset_drive(s->reset, false) ? "done" : "NOT done");
+		} else {
+			(void)cam_sensor_down(s);
+		}
+	}
+	if (cam.did & D_BRANCH) {
+		(void)cam_branches(false);
+	}
+	if (cam.did & D_TFE) {
+		gdsc_off("TFE_0_GDSCR", CC_TFE0_GDSCR, cam.f_tfe);
+	}
+	if (cam.did & D_RCG) {
+		/* the sources back to what they were, before their PLLs stop */
+		for (unsigned i = 0; i < CAM_RCGS; i++) {
+			if (cam.f_rcg[i][1] != rd(cam.cc + cam_rcg[i].cmd + 4)) {
+				(void)cam_rcg_set(cam_rcg[i].name, cam_rcg[i].cmd, cam.f_rcg[i][1]);
+			}
+		}
+	}
+	if (cam.did & D_PLL3) {
+		cam_pll_off(1, "PLL3", CC_PLL3);
+	}
+	if (cam.did & D_PLL0) {
+		cam_pll_off(0, "PLL0", CC_PLL0);
+	}
+	if (cam.did & D_TITAN) {
+		gdsc_off("TITAN_TOP_GDSCR", CC_TITAN_GDSCR, cam.f_titan);
+	}
+	if (cam.did & D_CBCR) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (rd(cam.cc + cam_cbcr[i]) != cam.f_cbcr[i]) {
+				cwl("CBCR (as found)", cam.cc, cam_cbcr[i], cam.f_cbcr[i]);
+			}
+		}
+	}
+	if (cam.did & D_AXI) {
+		cwl("GCC_CAMERA_HF_AXI (as found)", cam.gcc, 0x2014, cam.f_axi);
+	}
+	if ((cam.did & D_BCM) && !icecam_last) {
+		(void)hakios_iceland_rpmh_bcm("MM1", false);
+	}
+	if ((cam.did & D_PHY09) && !icecam_last) {
+		rail_off(&phy09);
+	}
+	/* MMCX / MXC: the votes stay (a release could take the boot display's level with it) */
+	say("down: done; %u camera-subsystem stores in all; MMCX / MXC votes left\n", cam.writes);
+	cam.did = 0;
+}
+
+static bool
+cam_up(const struct sensor *s, uint32_t level_arg)
+{
+	uint32_t mmcx = 320, mxc = 320, v;
+
+	PE_parse_boot_argn("icecam_mmcx", &mmcx, sizeof(mmcx));
+	PE_parse_boot_argn("icecam_mxc", &mxc, sizeof(mxc));
+
+	cam_step(301, "the rails MMCX and MXC, the CSIPHY's 0.88 V and 1.2 V, BCM MM1");
+	rail_report(&ref, "for the CSIPHY");
+	find_apid(&phy09.p);
+	find_apid(&phy09.alt);
+	rail_report(&phy09, "as found");
+	if (!(ref.read && (ref.en & 0x80))) {
+		say("L1D (the CSIPHY's 1.2 V) is not on: stop\n");
+		return false;
+	}
+	cam.did |= D_ARC;
+	if (hakios_iceland_rpmh_arc("mmcx.lvl", mmcx) < 0 || hakios_iceland_rpmh_arc("mxc.lvl", mxc) < 0) {
+		say("MMCX / MXC not voted: stop\n");
+		return false;
+	}
+	if (!phy09.read) {
+		/*
+		 * also PCIe0's PHY supply (the board file :1710; hakios_iceland_pcie.c keeps its vote): without a read its state is
+		 * not known, so it is voted on at the DT's 880 mV and left on (a withdrawal could take the Wi-Fi's with it)
+		 */
+		stores += 3;
+		say("L3I is not readable here: voted on at 880 mV and left on: %s\n",
+		    hakios_iceland_rpmh_vote_vme(phy09.res, 880, LDO_MODE_AUTO, 1) == 0 ? "done" : "NOT DONE");
+	} else {
+		cam.did |= D_PHY09;
+		if (!rail_on(&phy09)) {
+			return false;
+		}
+	}
+	cam.did |= D_BCM;
+	if (hakios_iceland_rpmh_bcm("MM1", true) != 0) {
+		say("BCM MM1 not voted: stop\n");
+		return false;
+	}
+	if (cam_stop_at(301)) {
+		return false;
+	}
+
+	cam_step(302, "GCC: the camera AHB clock (read), the HF AXI branch on");
+	v = rd(cam.gcc + 0x2004);
+	if (v >> 31) {
+		say("GCC camera AHB is off (%#x): the clock controller cannot be read: stop\n", v);
+		return false;
+	}
+	cam.f_axi = rd(cam.gcc + 0x2014);
+	cam.did |= D_AXI;
+	cwl("GCC_CAMERA_HF_AXI", cam.gcc, 0x2014, cam.f_axi | 1);
+	if (cam_stop_at(302)) {
+		return false;
+	}
+
+	cam_step(303, "CAMCC: the first read, Linux's always-on branches");
+	if (cam.cc == 0) {
+		cam.cc = ml_io_map(CAMCC_PHYS, 0x30000);
+	}
+	if (cam.cc == 0) {
+		return false;
+	}
+	say("camcc as found: PLL0 mode %#x L %#x, PLL3 mode %#x, TITAN_TOP %#x, TFE_0 %#x, cphy_rx cfg %#x, csid cfg %#x\n",
+	    rd(cam.cc + CC_PLL0), rd(cam.cc + CC_PLL0 + P_L), rd(cam.cc + CC_PLL3), rd(cam.cc + CC_TITAN_GDSCR),
+	    rd(cam.cc + CC_TFE0_GDSCR), rd(cam.cc + 0x21068), rd(cam.cc + 0x212a8));
+	if (rd(cam.cc + CC_TITAN_GDSCR) == 0xffffffffu || (rd(cam.cc + CC_TITAN_GDSCR) & GDSC_ON)) {
+		say("TITAN_TOP is on already or unreadable: someone else's camera subsystem: REFUSED\n");
+		return false;
+	}
+	cam.did |= D_CBCR;
+	for (unsigned i = 0; i < 4; i++) {
+		cam.f_cbcr[i] = rd(cam.cc + cam_cbcr[i]);
+		if (!(cam.f_cbcr[i] & 1)) {
+			cwl("CBCR always-on", cam.cc, cam_cbcr[i], cam.f_cbcr[i] | 1);
+		}
+	}
+	if (cam_stop_at(303)) {
+		return false;
+	}
+
+	cam_step(304, "TITAN_TOP's power switch");
+	cam.did |= D_TITAN;
+	if (!gdsc_on("TITAN_TOP_GDSCR", CC_TITAN_GDSCR, &cam.f_titan) || cam_stop_at(304)) {
+		return false;
+	}
+
+	cam_step(305, "PLL0 (1200 MHz) and PLL3 (720.56 MHz)");
+	cam.did |= D_PLL0;
+	if (!cam_pll_on(0, "PLL0", CC_PLL0, 0x3e, 0x8000, 0x8408)) {
+		return false;
+	}
+	cam.did |= D_PLL3;
+	if (!cam_pll_on(1, "PLL3", CC_PLL3, 0x25, 0x8777, 0x408) || cam_stop_at(305)) {
+		return false;
+	}
+
+	cam_step(306, "the five clock sources");
+	for (unsigned i = 0; i < CAM_RCGS; i++) {
+		cam.f_rcg[i][0] = rd(cam.cc + cam_rcg[i].cmd);
+		cam.f_rcg[i][1] = rd(cam.cc + cam_rcg[i].cmd + 4);
+	}
+	cam.did |= D_RCG;
+	for (unsigned i = 0; i < CAM_RCGS; i++) {
+		if (!cam_rcg_set(cam_rcg[i].name, cam_rcg[i].cmd, cam_rcg[i].cfg)) {
+			return false;
+		}
+	}
+	if (cam_stop_at(306)) {
+		return false;
+	}
+
+	cam_step(307, "TFE 0's power switch");
+	cam.did |= D_TFE;
+	if (!gdsc_on("TFE_0_GDSCR", CC_TFE0_GDSCR, &cam.f_tfe) || cam_stop_at(307)) {
+		return false;
+	}
+
+	cam_step(308, "fifteen branches");
+	cam.did |= D_BRANCH;
+	if (!cam_branches(true) || cam_stop_at(308)) {
+		return false;
+	}
+
+	cam_step(309, "the blocks' versions (reads)");
+	if (cam.csid == 0) {
+		cam.csid = ml_io_map(CSID_PHYS, 0x6000);
+		cam.vfe = ml_io_map(VFE_PHYS, 0x4000);
+		cam.phy = ml_io_map(PHY_PHYS, 0x2000);
+	}
+	if (cam.csid == 0 || cam.vfe == 0 || cam.phy == 0) {
+		return false;
+	}
+	say("versions: csid0 %#x, tfe0 %#x\n", rd(cam.csid), rd(cam.vfe));
+	if (cam_stop_at(309)) {
+		return false;
+	}
+
+	cam_step(310, "the frame buffers and the SMMU window");
+	if (cam.buf == 0 && kmem_alloc_contig(kernel_map, &cam.buf, cam.nbufs * CAM_BUF_BYTES, PAGE_MASK, 0, 0,
+	    KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("no contiguous %u MB for the buffers: stop\n", cam.nbufs * CAM_BUF_BYTES >> 20);
+		cam.buf = 0;
+		return false;
+	}
+	cam.buf_pa = kvtophys(cam.buf);
+	/* every 4 KB step of the range is checked: the service's buffers are IOKit's, not kmem_alloc_contig's */
+	for (uint32_t o = 0; o < cam.nbufs * CAM_BUF_BYTES; o += 0x1000) {
+		if (kvtophys(cam.buf + o) != cam.buf_pa + o || (cam.buf_pa & 0xfff) != 0) {
+			say("the buffers are not one physical range (at +%#x): stop\n", o);
+			return false;
+		}
+	}
+	memset((void *)cam.buf, CAM_FILL, cam.nbufs * CAM_BUF_BYTES);
+	cam_clean(cam.buf, cam.nbufs * CAM_BUF_BYTES);
+	if (level_arg == 4 && cam.out == 0 && kmem_alloc(kernel_map, &cam.out, round_page(OUT_W * OUT_H * 4),
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("no memory for the picture: stop\n");
+		cam.out = 0;
+		return false;
+	}
+	if (!cam_smmu_on() || cam_stop_at(310)) {
+		return false;
+	}
+
+	cam_step(311, "the CSID's reset");
+	if (!cam_csid_reset() || cam_stop_at(311)) {
+		return false;
+	}
+	cam_step(312, "TFE 0's write master 23 (RDI0) and its first two addresses");
+	cam_wm_on();
+	if (cam_stop_at(312)) {
+		return false;
+	}
+	cam_step(313, "the CSID: receiver and RDI0");
+	cam_csid_on();
+	if (cam_stop_at(313)) {
+		return false;
+	}
+	cam_step(314, "CSIPHY 5");
+	if (!cam_phy_on() || cam_stop_at(314)) {
+		return false;
+	}
+	cam_step(315, "the sensor: power, chip id");
+	if (!cam_sensor_up(s) || cam_stop_at(315)) {
+		return false;
+	}
+	cam_step(316, "the sensor: its mode's list and controls");
+	if (!cam_sensor_setup(s) || cam_stop_at(316)) {
+		return false;
+	}
+	return true;
+}
+
+/* a run's (or a service session's) start values: the defaults, then the boot-args */
+static void
+cam_defaults(uint32_t nbufs)
+{
+	cam.did = cam.stop = cam.writes = 0;
+	cam.pll_ours[0] = cam.pll_ours[1] = false;
+	cam.nbufs = nbufs;
+	cam.smr = 14;
+	cam.bank = 10;
+	cam.gain = 512;
+	cam.exp = CAM_VTS - 5;
+	cam.stride = CAM_BPL;
+	cam.frames = cam.stale = 0;
+	PE_parse_boot_argn("icecam_stop", &cam.stop, sizeof(cam.stop));
+	PE_parse_boot_argn("icecam_smr", &cam.smr, sizeof(cam.smr));
+	PE_parse_boot_argn("icecam_cb", &cam.bank, sizeof(cam.bank));
+	PE_parse_boot_argn("icecam_gain", &cam.gain, sizeof(cam.gain));
+	PE_parse_boot_argn("icecam_exp", &cam.exp, sizeof(cam.exp));
+	cam.asid = cam.bank + 1;
+	cam.gain = MIN(MAX(cam.gain, 128u), 8192u);
+	cam.exp = MIN(MAX(cam.exp, 1u), CAM_VTS - 5);
+}
+
+/* true = a whole frame was measured */
+static bool
+cam_run(const struct sensor *s, uint32_t level_arg)
+{
+	uint32_t frames = 4, secs = 20;
+	bool got = false;
+
+	cam_defaults(CAM_BUFS);
+	PE_parse_boot_argn("icecam_frames", &frames, sizeof(frames));
+	PE_parse_boot_argn("icecam_secs", &secs, sizeof(secs));
+	frames = MIN(MAX(frames, 1u), 300u);
+	secs = MIN(MAX(secs, 1u), 120u);
+
+	say("level %u: %s, %ux%u RAW10, %s\n", level_arg, s->name, CAM_W, CAM_H, level_arg >= 4 ? "a stream of pictures" :
+	    "frames into memory");
+	if (s != &front) {
+		say("only the front camera's stream is in this build: nothing done\n");
+		return false;
+	}
+	if (iceland_cam_front_tbl_n == 0) {
+		say("this build holds no register list for the sensor (the private object is not linked): nothing done\n");
+		return false;
+	}
+	if (cam.gcc == 0 && (cam.gcc = ml_io_map(0x00124000UL, 0x4000)) == 0) {
+		return false;
+	}
+	cam_curve_init();
+	if (cam_up(s, level_arg)) {
+		got = cam_capture(s, level_arg, frames, secs);
+	}
+	say("level %u (before the power-down): %s; %u frames; what was up %#x\n", level_arg, got ? "FRAME CAPTURED" :
+	    "no frame", cam.frames, cam.did);
+	cam_down(s);
+	return got;
+}
+
+#endif /* ICECAM_PURE_ONLY */
diff --git a/bsd/dev/hakios_iceland_camera_svc.h b/bsd/dev/hakios_iceland_camera_svc.h
new file mode 100644
index 0000000000000000000000000000000000000000..56df00501778590ed2aaf8089f3dbfc8a2138174
--- /dev/null
+++ b/bsd/dev/hakios_iceland_camera_svc.h
@@ -0,0 +1,469 @@
+/*
+ * hakios_iceland_camera_svc.h - icecam=5: the front camera's stream as a service, for a camera extension in userspace.
+ * Part of hakios_iceland_camera.c (included there, after the stream's own file); nothing here runs below icecam=5.
+ *
+ * iokit/Kernel/IcelandCamera.cpp is the IOKit side: the IOService "IcelandCamera", its user client, and the frame
+ * buffers (one IOBufferMemoryDescriptor: kernel-object memory, which levels 3 and 4 use, cannot be mapped into a task).
+ * This file is the stream behind it:
+ *   start   the first user brings the camera up (the survey once, then level 3's steps 301..316 and the stream-on);
+ *           further users share it
+ *   stop    the last user takes it down again, everything put back as levels 3 and 4 do
+ *   ring    SVC_BUFS (4) buffers written in turn by TFE 0's write master. A finished frame is announced by its sequence
+ *           number and buffer index; its buffer goes back to the write master three frames later (its first and last 64
+ *           bytes are marked then), so a reader that finds the sequence less than two ahead after its copy has a whole
+ *           frame
+ *   wait    sleeps until the sequence moves (the frame-ready notification), a timeout, or the stream's end
+ * One kernel thread does all hardware work; the calls only set the state and sleep on it. The CSID is polled (no
+ * interrupt line is attached), every 0.5 ms.
+ *
+ * Stage 2 on the tablet (runs/w4-camera-2/20261115-235711) counted 49 buffer-done events against 599 frame starts: the
+ * events stopped 1.6 s into the stream. The cause is not known. A guess, not a finding: two events seen as one leave the
+ * write master one address short each time, and with none left it reports no buffer done. Here a stream that shows no
+ * buffer done for 150 ms is given two addresses again, and the count of such restarts is in every report.
+ *
+ * QEMU's virt machine has no camera: there the service is published all the same and the thread writes a moving
+ * colour-bar frame (RAW10, the sensor's geometry) into the ring 30 times a second, so the user client, the mapping and
+ * the wait can be tested without the tablet.
+ *
+ * A stream that a user still holds at loader_return() (a panic's end, the A3 re-entry) is taken down there by
+ * hakios_iceland_camera_quiesce() (hakios_iceland_camera.c), without this file's thread and without the RPMh votes.
+ *
+ * Lines: "icecam: svc: ...". A session's first bring-up is logged store by store as levels 3 and 4 are; later sessions
+ * only count their stores.
+ */
+#include <kern/locks.h>
+#include <sys/proc.h>
+
+#define SVC_BUFS                4u
+enum { SVC_IDLE, SVC_STARTING, SVC_STREAMING, SVC_FAILED, SVC_STOPPING };
+
+extern int iceland_camera_publish(vm_size_t bytes, vm_offset_t *va);    /* 0 published, 1 not yet, < 0 failed */
+int hakios_iceland_camera_start(void);
+void hakios_iceland_camera_stop(void);
+int hakios_iceland_camera_wait(uint32_t last_seq, uint32_t timeout_ms, uint64_t out[8]);
+void hakios_iceland_camera_info(uint64_t out[8]);
+void hakios_iceland_camera_note(int pid, uint64_t kind, uint64_t a, uint64_t b);
+
+static LCK_GRP_DECLARE(svc_grp, "icecam");
+static LCK_MTX_DECLARE(svc_lock, &svc_grp);
+
+static struct {
+	uint32_t users, state, seq, index, sessions, restarts, torn;
+	uint64_t stamp;
+	bool model, surveyed, published, fresh[SVC_BUFS];       /* fresh: announced, and not given back to the write master yet */
+} svc;
+
+/* with svc_lock held; false = the time ran out */
+static bool
+svc_sleep(void *chan, uint32_t ms)
+{
+	struct timespec ts = { .tv_sec = ms / 1000, .tv_nsec = (long)(ms % 1000) * NSEC_PER_MSEC };
+
+	return msleep(chan, &svc_lock, PZERO, "icecam", &ts) == 0;
+}
+
+static void
+svc_announce(uint32_t b)
+{
+	svc.fresh[b] = true;
+	lck_mtx_lock(&svc_lock);
+	svc.index = b;
+	svc.seq++;
+	svc.stamp = mach_absolute_time();
+	lck_mtx_unlock(&svc_lock);
+	wakeup(&svc.seq);
+}
+
+/* the next buffer in turn to the write master, marked first; never one of the two newest frames' */
+static void
+svc_queue(uint32_t newest, uint32_t before)
+{
+	uint32_t b = cam.queued % SVC_BUFS;
+
+	for (unsigned k = 0; k < 2 && (b == newest || b == before); k++) {
+		cam.queued++;
+		b = cam.queued % SVC_BUFS;
+	}
+	svc.fresh[b] = false;
+	cam_mark(b);
+	cam_addr(b);
+	cam.queued++;
+	cw(cam.csid, CSID_AUP_CMD, RDI0_BIT);
+	cw(cam.csid, CSID_RUP_AUP_CMD, 1);
+}
+
+/* the green pixels' mean of a frame's top 8 bits, black level off: what cam_debayer() returns, from 1 line pair in 16 */
+static uint32_t
+svc_green(const uint8_t *frame, uint32_t stride)
+{
+	uint32_t sum = 0, n = 0;
+
+	for (uint32_t y = 0; y + 1 < CAM_H; y += 32) {
+		const uint8_t *r0 = frame + (uint64_t)y * stride, *r1 = r0 + stride;
+
+		for (uint32_t g = 0; g < CAM_W / 4; g += 4) {
+			sum += (uint32_t)r0[g * 5 + 1] + r1[g * 5];
+			n += 2;
+		}
+	}
+	sum = n ? sum / n : 0;
+	return sum > (CAM_BLACK >> 2) ? sum - (CAM_BLACK >> 2) : 0;
+}
+
+static void
+svc_hw_down(void)
+{
+	cam_down(&front);
+	bus_look("at the end");
+	pins_back();
+}
+
+static bool
+svc_hw_up(void)
+{
+	uint32_t flag = 0;
+	bool ok;
+
+	cam.quiet = svc.sessions != 0;
+	if (!svc.surveyed) {
+		blind = PE_parse_boot_argn("icecam_blind", &flag, sizeof(flag)) && flag != 0;
+		flag = 0;
+		vset_lax = PE_parse_boot_argn("icecam_vset_lax", &flag, sizeof(flag)) && flag != 0;
+		if (!icecam_survey(5)) {
+			return false;
+		}
+		nanoseconds_to_absolutetime(2500, &quarter_ticks);
+		svc.surveyed = true;
+	}
+	if (iceland_cam_front_tbl_n == 0) {
+		say("svc: this build holds no register list for the sensor (the private object is not linked): no stream\n");
+		return false;
+	}
+	if (cam.gcc == 0 && (cam.gcc = ml_io_map(0x00124000UL, 0x4000)) == 0) {
+		return false;
+	}
+	bus_look("as found");
+	ls_voted = true;
+	stores += 2;
+	ok = hakios_iceland_rpmh_vote(LS1, -1, 0, true) == 0 && hakios_iceland_rpmh_vote(LS2, -1, 0, true) == 0;
+	if (!ok) {
+		say("svc: the level shifters' votes were not done\n");
+	}
+	ok = ok && cam_up(&front, 5);
+	if (ok) {
+		(void)cam_poll();               /* stale words from before the stream */
+		cam.sof = cam.eof = cam.rup = cam.rx_bits = cam.rdi_bits = 0;
+		cam.did |= D_STREAM;
+		ok = cam_write8(front.addr, 0x0100, 0x01);
+		cam.t_on = mach_absolute_time();
+		if (!ok) {
+			say("svc: the stream-on was not acknowledged\n");
+		}
+	}
+	if (!ok) {
+		svc_hw_down();
+	}
+	return ok;
+}
+
+static void
+svc_hw_run(void)
+{
+	uint64_t t_last = cam.t_on;
+	uint32_t newest = SVC_BUFS, before = SVC_BUFS, expect = 0;
+	bool stride_known = false, said = false;
+
+	while (svc.state == SVC_STREAMING) {
+		uint32_t done = SVC_BUFS;
+
+		if (!cam_poll()) {
+			if (cam.frames != 0 && cam_ms(t_last) >= 150) {
+				svc.restarts++;
+				if (!said) {
+					said = true;
+					say("svc: no buffer done for %llu ms after %u frames (sof %u eof %u): two addresses queued again\n",
+					    cam_ms(t_last), cam.frames, cam.sof, cam.eof);
+				}
+				svc_queue(newest, before);
+				svc_queue(newest, before);
+				t_last = mach_absolute_time();
+			} else if (cam.frames == 0 && !said && cam_ms(cam.t_on) >= 1500) {
+				said = true;
+				say("svc: no frame within 1.5 s of stream-on (sof %u eof %u, receiver bits %#x)\n", cam.sof, cam.eof,
+				    cam.rx_bits);
+			}
+			wait_us(500);
+			continue;
+		}
+		if (cam_ms(cam.t_on) < 1 || (cam.frames != 0 && cam_ms(t_last) < 1)) {
+			cam.stale++;                    /* a sensor frame takes 33 ms */
+			continue;
+		}
+		t_last = mach_absolute_time();
+		cam.frames++;
+		/* the frame's buffer: the next in turn, or (after a slip) any other that was queued and is whole now */
+		for (uint32_t k = 0; k < SVC_BUFS && done == SVC_BUFS; k++) {
+			uint32_t b = (expect + k) % SVC_BUFS;
+
+			if (!svc.fresh[b] && cam_whole(b)) {
+				done = b;
+			}
+		}
+		svc_queue(done, newest);
+		if (done == SVC_BUFS) {
+			svc.torn++;
+			continue;
+		}
+		if (!stride_known) {
+			/* the first whole frame says whether the lines are padded to 16 bytes (the rest is still the fill) */
+			cam_fresh(cam_buffer(done), CAM_BUF_BYTES);
+			if (cam_extent(cam_buffer(done), CAM_BUF_BYTES) > CAM_BPL * CAM_H) {
+				cam.stride = CAM_BPL16;
+			}
+			stride_known = true;
+			say("svc: the first frame %llu ms after stream-on, in buffer %u; the lines are %u bytes apart\n",
+			    cam_ms(cam.t_on), done, cam.stride);
+		}
+		cam_fresh(cam_buffer(done), cam.stride * CAM_H);
+		before = newest;
+		newest = done;
+		expect = (done + 1) % SVC_BUFS;
+		svc_announce(done);
+		if (svc.seq % 6 == 0) {
+			uint32_t g = cam_ae(cam.gain, svc_green(cam_buffer(done), cam.stride));
+
+			if (g != cam.gain && cam_gain_write(&front, g)) {
+				cam.gain = g;
+			}
+		}
+	}
+	say("svc: stream: %u frames announced of %u buffer-done events, %u not whole, %u stale, %u restarts, in %llu ms; sof "
+	    "%u eof %u; receiver bits %#x, rdi0 bits %#x; gain %u/128\n", svc.seq, cam.frames, svc.torn, cam.stale, svc.restarts,
+	    cam_ms(cam.t_on), cam.sof, cam.eof, cam.rx_bits, cam.rdi_bits, cam.gain);
+	(void)cam_smmu_fault("after the stream");
+}
+
+/* QEMU: eight colour bars that move, as the sensor would send them (BGGR, MIPI-packed, the lines 2048 bytes apart) */
+static void
+svc_model_run(void)
+{
+	static const uint8_t bars[8][3] = { { 235, 235, 235 }, { 41, 235, 235 }, { 235, 235, 41 }, { 41, 235, 41 },
+					    { 235, 41, 235 }, { 41, 41, 235 }, { 235, 41, 41 }, { 16, 16, 16 } };  /* B G R */
+
+	cam.stride = CAM_BPL16;
+	while (svc.state == SVC_STREAMING) {
+		uint32_t b = cam.frames % SVC_BUFS;
+		uint8_t *p = cam_buffer(b);
+
+		svc.fresh[b] = false;
+		for (uint32_t g = 0; g < CAM_W / 4; g++) {
+			const uint8_t *c = bars[((g + cam.frames * 2) % (CAM_W / 4)) * 8 / (CAM_W / 4)];
+			uint8_t *e = p + g * 5, *o = e + cam.stride;
+
+			e[0] = e[2] = c[0];
+			e[1] = e[3] = o[0] = o[2] = c[1];
+			o[1] = o[3] = c[2];
+			e[4] = o[4] = 0;
+		}
+		for (uint32_t y = 2; y < CAM_H; y++) {
+			memcpy(p + (uint64_t)y * cam.stride, p + (y & 1) * cam.stride, CAM_BPL);
+		}
+		cam.frames++;
+		svc_announce(b);
+		delay_for_interval(33, NSEC_PER_MSEC);
+	}
+	say("svc: pattern stream: %u frames announced\n", svc.seq);
+}
+
+static void
+svc_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	int r = 1;
+
+	/* the platform expert may not be there yet when the BSD side starts */
+	for (unsigned t = 0; t < 300 && r == 1; t++) {
+		r = iceland_camera_publish(SVC_BUFS * CAM_BUF_BYTES, &cam.buf);
+		if (r == 1) {
+			delay_for_interval(200, NSEC_PER_MSEC);
+		}
+	}
+	if (r != 0 || cam.buf == 0) {
+		say("svc: IcelandCamera NOT published (%d)\n", r);
+		return;
+	}
+	say("svc: IcelandCamera published: %u buffers of %u MB at %#llx%s\n", SVC_BUFS, CAM_BUF_BYTES >> 20,
+	    (uint64_t)kvtophys(cam.buf), svc.model ? "; not the Pad (QEMU): a pattern, no camera hardware" : "");
+	lck_mtx_lock(&svc_lock);
+	svc.published = true;
+	for (;;) {
+		bool ok;
+
+		while (svc.state != SVC_STARTING) {
+			(void)msleep(&svc.users, &svc_lock, PZERO, "icecam", NULL);
+		}
+		svc.seq = svc.restarts = svc.torn = 0;
+		lck_mtx_unlock(&svc_lock);
+		bzero(svc.fresh, sizeof(svc.fresh));
+		cam_defaults(SVC_BUFS);
+		say("svc: session %u: start (%s)\n", svc.sessions + 1, svc.model ? "pattern" : "front SC820CS, 1632x1224 RAW10");
+		ok = svc.model || svc_hw_up();
+		lck_mtx_lock(&svc_lock);
+		/* a user that gave up while the camera came up leaves a stream nobody wants: it goes down at once */
+		svc.state = !ok ? SVC_FAILED : svc.users != 0 ? SVC_STREAMING : SVC_STOPPING;
+		wakeup(&svc.state);
+		if (!ok) {
+			say("svc: session %u: NOT started\n", svc.sessions + 1);
+			continue;
+		}
+		svc.sessions++;
+		lck_mtx_unlock(&svc_lock);
+		say("svc: session %u: streaming\n", svc.sessions);
+		if (svc.model) {
+			svc_model_run();
+		} else {
+			svc_hw_run();
+			svc_hw_down();
+		}
+		say("svc: session %u: down\n", svc.sessions);
+		lck_mtx_lock(&svc_lock);
+		svc.state = SVC_IDLE;
+		wakeup(&svc.state);
+		wakeup(&svc.seq);
+	}
+}
+
+/* 0 = streaming; EIO: the camera did not come up; ETIMEDOUT; ENXIO: no service */
+int
+hakios_iceland_camera_start(void)
+{
+	bool asked = false;
+	int error = 0;
+
+	lck_mtx_lock(&svc_lock);
+	if (!svc.published) {
+		lck_mtx_unlock(&svc_lock);
+		return ENXIO;
+	}
+	svc.users++;
+	while (svc.state != SVC_STREAMING) {
+		if (svc.state == SVC_IDLE || (svc.state == SVC_FAILED && !asked)) {
+			asked = true;
+			svc.state = SVC_STARTING;
+			wakeup(&svc.users);
+		} else if (svc.state == SVC_FAILED) {
+			error = EIO;
+		}
+		if (error == 0 && !svc_sleep(&svc.state, 15000)) {
+			error = ETIMEDOUT;
+		}
+		if (error != 0) {
+			svc.users--;
+			break;
+		}
+	}
+	lck_mtx_unlock(&svc_lock);
+	return error;
+}
+
+/* one user less; the last one's call returns when the camera is down (or after 5 s) */
+void
+hakios_iceland_camera_stop(void)
+{
+	lck_mtx_lock(&svc_lock);
+	if (svc.users != 0 && --svc.users == 0 && svc.state == SVC_STREAMING) {
+		svc.state = SVC_STOPPING;
+		wakeup(&svc.seq);
+		while (svc.state == SVC_STOPPING && svc_sleep(&svc.state, 5000)) {
+		}
+	}
+	lck_mtx_unlock(&svc_lock);
+}
+
+/* 0 = a frame newer than last_seq is in out; 1 = none within the time; 2 = no stream */
+int
+hakios_iceland_camera_wait(uint32_t last_seq, uint32_t timeout_ms, uint64_t out[8])
+{
+	int r = 0;
+
+	lck_mtx_lock(&svc_lock);
+	while (r == 0 && (svc.state != SVC_STREAMING || svc.seq == last_seq || svc.seq == 0)) {
+		if (svc.state != SVC_STREAMING) {
+			r = 2;
+		} else if (!svc_sleep(&svc.seq, timeout_ms)) {
+			r = 1;
+		}
+	}
+	if (r == 0) {
+		out[0] = svc.seq;
+		out[1] = svc.index;
+		out[2] = CAM_W;
+		out[3] = CAM_H;
+		out[4] = cam.stride;
+		out[5] = cam.gain;
+		out[6] = cam.exp;
+		out[7] = svc.stamp;
+	}
+	lck_mtx_unlock(&svc_lock);
+	return r;
+}
+
+/* state, width, height, the lines' distance, a buffer's bytes, the buffers, the newest sequence, the users */
+void
+hakios_iceland_camera_info(uint64_t out[8])
+{
+	lck_mtx_lock(&svc_lock);
+	out[0] = svc.state;
+	out[1] = CAM_W;
+	out[2] = CAM_H;
+	out[3] = cam.stride > CAM_BPL ? cam.stride : CAM_BPL16;
+	out[4] = CAM_BUF_BYTES;
+	out[5] = SVC_BUFS;
+	out[6] = svc.state == SVC_STREAMING ? svc.seq : 0;
+	out[7] = svc.users;
+	lck_mtx_unlock(&svc_lock);
+}
+
+/* a line of the userland's in the kernel log (at most 20 a second); kind SVC_NOTE_OPEN is the user client's own */
+#define SVC_NOTE_OPEN           ~0ull
+#define SVC_NOTE_GIVES          ~1ull           /* a: 0 the stop call, 1 the close, 2 a termination, 3 the release */
+void
+hakios_iceland_camera_note(int pid, uint64_t kind, uint64_t a, uint64_t b)
+{
+	static const char *const what[] = { "cmio start, pattern", "cmio client pid", "cmio stream start, pattern",
+		                            "cmio frames served, kernel seq", "cmio stream stop: served, torn",
+		                            "cmio failure", "host activation: step, code", "probe: devices, ours listed",
+		                            "probe frames, status", "probe session: frames, torn", "probe session end: why, attempts" };
+	static uint64_t second;
+	static uint32_t count;
+	uint64_t now;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+	now /= NSEC_PER_SEC;
+	if (now != second) {
+		second = now;
+		count = 0;
+	}
+	if (count++ >= 20) {
+		return;
+	}
+	if (kind == SVC_NOTE_OPEN) {
+		say("svc: client pid %d opened\n", pid);
+	} else if (kind == SVC_NOTE_GIVES) {
+		static const char *const how[] = { "its stop call", "its close", "a termination", "its release" };
+
+		say("svc: client pid %d gives the stream back: %s\n", pid, how[a & 3]);
+	} else {
+		say("svc: note pid %d: %s: %llu %llu\n", pid, kind < sizeof(what) / sizeof(what[0]) ? what[kind] : "?", a, b);
+	}
+}
+
+static void
+svc_init(void)
+{
+	thread_t thread;
+
+	svc.model = psci_smp_hvc != 0;
+	if (kernel_thread_start(svc_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_charger_plan.h b/bsd/dev/hakios_iceland_charger_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..80724120f489df3a5947655d2f1133a0c229c5f8
--- /dev/null
+++ b/bsd/dev/hakios_iceland_charger_plan.h
@@ -0,0 +1,251 @@
+/*
+ * What icebatt=5 and 6 may ask of the Pad 4's charger firmware: the decision alone, with no kernel in it, so that
+ * tools/tests/hakios_iceland/charger_plan_test.c runs it on the host. hakios_iceland_battery.c reads the values
+ * and makes the writes.
+ *
+ * The rule (16 Nov, after stage A on the tablet): the firmware's own limits stand. Nothing it has set is ever
+ * lowered: not the input current, not the charge current, not the voltage. A limit is raised only for a source
+ * whose capability the firmware itself names (Type-C current or a PD contract), only up to that, and only where the
+ * firmware's value is below it. Everything else is "no write", with the reason in one line.
+ * The only writes that lower anything take back this driver's OWN raise, to the value the firmware had.
+ *
+ * Why: stage A (icebatt=4, a computer's USB-A port, runs/w4-battery-A-login-1): the firmware alone had the input at
+ * 2000 mA of a source maximum of 2000 mA, the charge limit at 2500 mA, VBUS at 4536 .. 4683 mV; adapter type 9. The
+ * first icebatt=5 took 9 for "unknown" and would have stepped the input DOWN to 500 mA.
+ *
+ * The adapter type (USB property 7), as the owner's Linux driver reads this firmware (qcom_battmgr.c
+ * qcom_battmgr_oplus_usb_type(), a2e1ea44) and as stock groups it (build/wf/charging/REPORT.md):
+ *   0 unknown   1 SDP (a computer's port)   2 DCP   3 CDP   4 ACA   5 Type-C current   6 PD   7 PD DRP   8 PD PPS
+ *   9 OPLUS's Apple-brick id (NOT Linux's number: there BrickID is 11 and 9 is PD SPR AVS)
+ *   10 .. 13 VOOC .. SVOOC (Linux: charged as DCP)   17 a PD source that is also a USB host   0x80 .. 0x82 HVDCP
+ * Only 5 and 6 .. 8 name a capability this driver trusts. USB property 6 ("type"; 1 in stage A) is read by nobody
+ * (Linux serves its usb_type from property 7): logged, never decided on.
+ *
+ * The numbers are stock's and the owner's Linux driver's for this tablet:
+ *   the input current goes up in the steps 500 900 1200 1350 1500 1750 2000 mA and no further: 2000 mA is the top
+ *   for PD at 5 V and for every plain charger (the pump charging above it is not driven here);
+ *   PD: 9 V only, never 12 V (stock has no 12 V for this tablet; its VBUS limit is 11 V), only with the battery
+ *   under 4500 mV; 9 V counts as held at 7500 mV or more; at 5 V a step holds at 4500 mV (4550 mV with the battery
+ *   above 4100 mV).
+ * Stock and Linux LOWER the input before the 9 V request (500 mA; the lower of the two currents); that is not done
+ * here. So 9 V is asked only with the firmware's input at 2000 mA or less (18 W at 9 V, under Linux's 20 W), and if
+ * the source then names less current than the limit in force, or VBUS sags, the request is taken back (5 V).
+ */
+#ifndef HAKIOS_ICELAND_CHARGER_PLAN_H
+#define HAKIOS_ICELAND_CHARGER_PLAN_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define ICECHG_TOP_MA           2000u   /* the ladder's top; PD at 5 V and 9 V */
+#define ICECHG_9V_MV            9000u
+#define ICECHG_5V_MV            5000u
+#define ICECHG_HIGH_MV          7000u   /* VBUS above this: a 9 V contract */
+#define ICECHG_9V_HOLD_MV       7500u
+#define ICECHG_9V_BATT_MV       4500u   /* 9 V only under this */
+
+enum icechg_kind { ICECHG_NONE, ICECHG_TYPE_C, ICECHG_PD };
+
+/* what the firmware has in force now, every value read from it */
+struct icechg_state {
+	bool have;              /* each of the reads below was answered */
+	uint32_t adapter;       /* USB property 7 */
+	uint32_t vbus_mv;       /* USB property 1 */
+	uint32_t source_ma;     /* USB property 4: the firmware's own word on the source's maximum */
+	uint32_t icl_ma;        /* USB property 5: the input current limit */
+	uint32_t batt_mv;       /* the gauge */
+	bool hold;              /* this driver's guard holds (temperature, or charging stopped): no raise */
+	bool tried_9v;          /* 9 V is in force by this driver, or was asked in this attach and did not hold */
+};
+
+struct icechg_plan {
+	bool ask_9v;            /* OPLUS set 71 = 9000; the plan is made again once its outcome is read */
+	uint32_t icl_ma;        /* 0: no write; else the input limit goes up, step by step, to at most this */
+	const char *why;        /* one line: why this, or why nothing */
+};
+
+enum icechg_9v { ICECHG_9V_HELD, ICECHG_9V_STAYED_5V, ICECHG_9V_TAKE_BACK };
+
+static inline enum icechg_kind
+icechg_kind_of(uint32_t adapter)
+{
+	return adapter == 5 ? ICECHG_TYPE_C : adapter >= 6 && adapter <= 8 ? ICECHG_PD : ICECHG_NONE;
+}
+
+static inline const char *
+icechg_adapter_name(uint32_t adapter)
+{
+	static const char *const names[] = { "unknown", "SDP", "DCP", "CDP", "ACA", "Type-C", "PD", "PD DRP", "PD PPS",
+		                             "BrickID", "VOOC class", "VOOC class", "VOOC class", "SVOOC" };
+
+	return adapter < sizeof(names) / sizeof(names[0]) ? names[adapter] : adapter == 17 ? "PD host" : "not known here";
+}
+
+/* the next step of stock's ladder above `from_ma` and not above `cap_ma`; 0: none */
+static inline uint32_t
+icechg_next_step(uint32_t from_ma, uint32_t cap_ma)
+{
+	static const uint32_t steps[] = { 500, 900, 1200, 1350, 1500, 1750, ICECHG_TOP_MA };
+
+	for (unsigned i = 0; i < sizeof(steps) / sizeof(steps[0]); i++) {
+		if (steps[i] > from_ma) {
+			return steps[i] <= cap_ma ? steps[i] : 0;
+		}
+	}
+	return 0;
+}
+
+/* VBUS at or above this after a step: the step holds */
+static inline uint32_t
+icechg_hold_mv(uint32_t vbus_mv, uint32_t batt_mv)
+{
+	return vbus_mv > ICECHG_HIGH_MV ? ICECHG_9V_HOLD_MV : batt_mv > 4100 ? 4550 : 4500;
+}
+
+static inline void
+icechg_plan(const struct icechg_state *s, struct icechg_plan *p)
+{
+	enum icechg_kind kind = icechg_kind_of(s->adapter);
+	uint32_t cap, step, top = 0;
+	bool high = s->vbus_mv > ICECHG_HIGH_MV;
+
+	p->ask_9v = false;
+	p->icl_ma = 0;
+	if (!s->have) {
+		p->why = "a value of the firmware's was not answered";
+		return;
+	}
+	if (kind == ICECHG_NONE) {
+		p->why = s->adapter == 1 || s->adapter == 3 || s->adapter == 17 ? "a computer's port: the firmware's limits stand" :
+		    s->adapter == 9 ? "BrickID (the firmware's word for this port or brick) names no capability: the firmware's limits stand" :
+		    "not a Type-C or PD source: the firmware's limits stand";
+		return;
+	}
+	if (s->hold) {
+		p->why = "the guard holds (temperature, or charging stopped): no raise";
+		return;
+	}
+	if (s->icl_ma == 0) {
+		p->why = "the firmware has the input suspended (limit 0): left alone";
+		return;
+	}
+	if (s->source_ma == 0) {
+		p->why = "the firmware names no source maximum";
+		return;
+	}
+	if (kind == ICECHG_PD && !high && !s->tried_9v && s->batt_mv != 0 && s->batt_mv < ICECHG_9V_BATT_MV &&
+	    s->icl_ma <= ICECHG_TOP_MA) {
+		p->ask_9v = true;
+		p->why = "PD at 5 V, the battery under 4500 mV: 9 V asked, the input limit as the firmware has it";
+		return;
+	}
+	/* the input current: up to what the source gives, at most the ladder's top, in the ladder's steps */
+	cap = s->source_ma < ICECHG_TOP_MA ? s->source_ma : ICECHG_TOP_MA;
+	for (step = icechg_next_step(s->icl_ma, cap); step != 0; step = icechg_next_step(step, cap)) {
+		top = step;
+	}
+	if (top != 0) {
+		p->icl_ma = top;
+		p->why = "the input limit is below what the source gives: raised in stock's steps";
+		return;
+	}
+	p->why = kind == ICECHG_PD && !high && !s->tried_9v ?
+	    (s->icl_ma > ICECHG_TOP_MA ? "PD at 5 V with the input above 2000 mA: 9 V would need it lowered, so 5 V stays" :
+	    "PD at 5 V with the battery at 4500 mV or more (or not read): 5 V stays") :
+	    "the input limit is already at the source's maximum or the ladder's top";
+}
+
+/* 2 s after a 9 V request: what came of it */
+static inline enum icechg_9v
+icechg_9v_outcome(uint32_t vbus_mv, bool collapse, uint32_t source_ma, uint32_t icl_ma)
+{
+	if (vbus_mv <= ICECHG_HIGH_MV) {
+		return ICECHG_9V_STAYED_5V;
+	}
+	if (vbus_mv < ICECHG_9V_HOLD_MV || collapse || source_ma < icl_ma) {
+		return ICECHG_9V_TAKE_BACK;
+	}
+	return ICECHG_9V_HELD;
+}
+
+/*
+ * This driver's own guard (battery safety; it outranks the rule above). `t` is the battery's temperature in 0.1 C.
+ * A reading counts as "over" with the battery above 4508 mV or VBUS above 11 V; two in a row stop charging.
+ * Charging off: below -10 C, from 53 C, or two "over" readings in a row. On again only inside -8 .. 51 C with the
+ * battery under 4400 mV and VBUS at 11 V or less: each bound has its gap, so the guard does not flap.
+ * No raise ("low"): outside 12 .. 45 C; raising again only inside 14 .. 43 C.
+ */
+static inline bool
+icechg_guard_over(uint32_t batt_mv, uint32_t vbus_mv)
+{
+	return batt_mv > 4508 || vbus_mv > 11000;
+}
+
+static inline bool
+icechg_guard_stop(bool stopped, int32_t t, uint32_t batt_mv, uint32_t vbus_mv, uint32_t over)
+{
+	return stopped ? !(t >= -80 && t < 510 && batt_mv < 4400 && vbus_mv <= 11000) : (t < -100 || t >= 530 || over >= 2);
+}
+
+static inline bool
+icechg_guard_low(bool low, int32_t t)
+{
+	return low ? !(t >= 140 && t < 430) : (t < 120 || t >= 450);
+}
+
+/*
+ * icebatt=6 (w6-charge, 17 Nov): the charge enable (OPLUS set 70) and the charge current by type, under the owner's
+ * stage B yes of 16 Nov ("charge enable, limits by type, PD 9 V max, guard 12-45 C / 4508 mV / 11 V").
+ *
+ * Why: under macOS nobody turned charging on. Stock's hardware init sets 70 = 1 at every boot
+ * (oplus_chg_8350_hardware_init(), build/wf/chgsafe/REPORT.md) and the owner's Linux sets it at every attach
+ * (qcom_battmgr.c a2e1ea44 qcom_battmgr_iceland_setup_charger()). Every icebatt=4 run on the tablet showed the input
+ * following the load with the battery flat at -3 .. -8 mA and charge type 1 (none), with headroom left at the port.
+ *
+ * The guard is stricter than the firmware's own temperature regions. Charging is allowed only inside 12 .. 45 C,
+ * with the battery at 4508 mV or less and VBUS at 11 V or less, and only on a gauge reading of this poll (a value
+ * not answered counts as out of range). One reading out of range turns charging off. It goes on again only inside
+ * 14 .. 43 C and, when the battery's voltage was the reason, under 4400 mV.
+ */
+#define ICECHG_EN_T_LOW         120     /* 0.1 C */
+#define ICECHG_EN_T_HIGH        450
+#define ICECHG_EN_T_LOW_AGAIN   140
+#define ICECHG_EN_T_HIGH_AGAIN  430
+#define ICECHG_EN_BATT_MV       4508u
+#define ICECHG_EN_BATT_AGAIN_MV 4400u
+#define ICECHG_EN_VBUS_MV       11000u
+
+static inline bool
+icechg_enable_want(bool stopped, bool by_mv, bool fresh, int32_t t, uint32_t batt_mv, uint32_t vbus_mv)
+{
+	if (!fresh || batt_mv == 0 || batt_mv > ICECHG_EN_BATT_MV || vbus_mv > ICECHG_EN_VBUS_MV ||
+	    t < ICECHG_EN_T_LOW || t > ICECHG_EN_T_HIGH) {
+		return false;
+	}
+	if (!stopped) {
+		return true;
+	}
+	return t >= ICECHG_EN_T_LOW_AGAIN && t <= ICECHG_EN_T_HIGH_AGAIN && (!by_mv || batt_mv < ICECHG_EN_BATT_AGAIN_MV);
+}
+
+/*
+ * The charge current by type uses stock's fccmax-ma rows for this tablet (build/wf/charging/REPORT.md section 2; the
+ * owner's Linux qcom_battmgr_iceland_type_limits()): SDP 600, CDP 1600, PD 3300, and 2200 mA for everything else
+ * (unknown, DCP, ACA, Type-C current, BrickID, the VOOC class, a PD host, HVDCP). The firmware's value is only ever
+ * LOWERED to the row; 0 means no write.
+ */
+static inline uint32_t
+icechg_fcc_row_ma(uint32_t adapter)
+{
+	return adapter == 1 ? 600u : adapter == 3 ? 1600u : adapter >= 6 && adapter <= 8 ? 3300u : 2200u;
+}
+
+static inline uint32_t
+icechg_fcc_lower_ma(uint32_t adapter, uint32_t fw_fcc_ma)
+{
+	uint32_t row = icechg_fcc_row_ma(adapter);
+
+	return fw_fcc_ma != 0 && fw_fcc_ma > row ? row : 0;
+}
+
+#endif /* HAKIOS_ICELAND_CHARGER_PLAN_H */
diff --git a/bsd/dev/hakios_iceland_cpu.c b/bsd/dev/hakios_iceland_cpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..18456285a24ff9c9cd440a185dd4654c87c8ad6e
--- /dev/null
+++ b/bsd/dev/hakios_iceland_cpu.c
@@ -0,0 +1,1947 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") CPU clocks, over SCMI (Arm's System Control and Management
+ * Interface, performance protocol 0x13), as Linux sets them on this tablet (scmi cpufreq). Every value is the Pad's own,
+ * from its mainline device tree (kaanapali.dtsi):
+ *   scmi { mboxes = <&pdp0_mbox 0>, <&pdp0_mbox 1>; shmem = <&pdp_tx>, <&pdp_rx>; scmi_perf: protocol@13 }
+ *   pdp0_mbox: mailbox@17610000 (qcom,kaanapali-cpucp-mbox), reg = <0x17610000 0x8000>, <0x19980000 0x8000>: Linux's
+ *     qcom-cpucp-mbox.c maps reg[0] as rx_base and reg[1] as tx_base, so the TX registers are at 0x19980000 and channel
+ *     0's doorbell is tx + 0x100 + 0x4 (APSS_CPUCP_TX_MBOX_CMD(0) + APSS_CPUCP_MBOX_CMD_OFF, one 32-bit write) - the
+ *     register the songyuan port (SM8850) rings too. The RX block (0x17610000) is never touched here.
+ *   pdp_tx: sram@81f08000 + 0x100, 0x80 bytes (arm,scmi-shmem): the request area of the "tx" channel
+ *   cpu0-5 = power domain <&scmi_perf 0>, cpu6-7 (the prime pair, MPIDR 0x10000/0x10100) = <&scmi_perf 1>
+ * The method (polled shared-memory transport, a kernel thread, measuring the clock with a chain of dependent adds)
+ * follows the HakiOS dada port's hakios_dada_cpu.c; none of its addresses or tables are used.
+ *
+ *   icecpu=1  a look: the protocol, its domains, their levels and limits, the level now, and each running CPU's clock
+ *   icecpu=2  ... and every domain set to its sustained level (the highest that is not a boost level), measured again
+ *   icecpu=3  ... and the prime domain stepped through levels 4, 9, 14, 20, 26 (LEVEL_GET and the clock after each)
+ *   icecpu=4  ... (after icecpu=2's SCMI sets) cluster 0 to level 20 and the prime pair to 26 through the LEVEL_SET fast
+ *             channels the firmware describes (pdp0 / pdp1 TX channel 3 + doorbell), used only if they are the known ones
+ *   icecpu=5  the governor: each domain follows its busiest CPU through the fast channels, capped at the sustained
+ *             level and by the CPU temperatures (tsens1 0-11 = cpu0-5, tsens3 0-3 = cpu6-7: the Pad's thermal zones)
+ *   icecpuload=1  (test) 5 s of spinning on the first prime CPU, then 5 s on cpu0, so the governor's log shows it
+ *   icecpu_trips=1  (with the governor) the default 100 ms check unchanged, and four 20 ms checks between each one: one
+ *             more level down while the temperature is still rising above 90 C, two levels from 105 C, the cap at most 14
+ *             levels under the sustained level from 112 C, the lowest level from 114 C; on the cores and on the cluster's
+ *             cache and QMX sensors (bsd/dev/hakios_iceland_tsens.c reads them)
+ *   icecpu_rise=N  (with the governor; default 2, 0 = off, at most 8) above 80 C a domain goes up at most N levels a
+ *             20 ms tick, whatever the load, the ui floor or icecpu_boost asked for: it only ever lowers a vote
+ *   ice_shutdown=1  (with the governor) power off (PSCI SYSTEM_OFF) at 120 C die on five ticks in a row (100 ms) or at
+ *             70 C battery on two readings in a row; ice_shutdown_test=D (tenths, 400..1200) moves the die trip down
+ *   icethermal=N  (1 or 2) the bundle: 1 = icecpu_trips, icegpu_thermal, icegpu_caps, ice_floor_yield, thermal-level;
+ *             2 = those and icecpu_tstat, icecpu_ceil, icecpu_gears. A boot-arg of its own still wins (name=0: off)
+ *   icecpu_tstat=1  (icethermal=2) the die's 20 ms peaks: every 2 s the window's peak and the ms at or above 90 / 95 C,
+ *             the run's peak and totals, and a line per tick at or above 90 C with the four ticks before it (at most 300)
+ *   icecpu_ceil=1  (icethermal=2) a ceiling between icecpu_soft=D (tenths, default 750) and 90 C, on the temperature
+ *             100 ms ahead (the rise of the last 5 ticks): down at once, up one level every 100 ms, never under 1996.8 MHz
+ *   icecpu_gears=1  (icethermal=2) stock's 20 shell gears (27-63 C) from the battery + icecpu_shell_bias=D (tenths,
+ *             default 20); caps from gear 3; icecpu_shell_test=D (tenths, 200..700) replaces the shell reading for a test
+ *   icecpu_shell=1  (with icecpu_gears; not in the bundle; needs iceskin=2) the gears' shell from stock's front model on
+ *             the PMIC thermistors (0.38 skin - 0.08 wlan + 0.72 board - 1.4 C), the battery fallback without them
+ *   icecpu_bootcap=S  (not in the bundle) until S s of uptime a domain at or above icecpu_bootcap_deci=D (default 880)
+ *             loses a level of its own ceiling every 20 ms tick, down to 1996.8 MHz, and it never comes back before S
+ * Without the boot-arg the governor (5) runs on the Pad (the loader's device tree says /arm-io device_type "iceland");
+ * icecpu=0 switches it off.
+ */
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <IOKit/IOPlatformExpert.h>   /* w4-perf: ice_shutdown=1's PE_halt_restart(kPEHaltCPU) */
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/proc_private.h>
+#include <kern/recount.h>
+#include <kern/policy_internal.h>     /* 26ap1: proc_set_task_ruse_cpu */
+#include "hakios_iceland_tsens.h"     /* w4-perf: icecpu_trips=1's cache / QMX sensors, the thermal level's SoC groups */
+
+#define say(...) printf("icecpu: " __VA_ARGS__)
+
+/*
+ * 20r, boot-arg icecpu_top=N (seconds, 2..60): every N s the six processes that used the most CPU time in that span
+ * (recount_task_times: user + system of every thread, the kernel_task included), with their share of one CPU and the
+ * domains' levels then -- 20q: cluster 0 at its thermal cap (3.2-3.4 GHz, 86-94 C) and 40-99% busy even between frames,
+ * the GPU 0-2% busy: what keeps the CPUs busy. Lines "icecpu: top ...".
+ */
+#define TOP_MAX 640u
+static struct top_seen {
+	int pid;
+	uint64_t total;
+	uint8_t over;                   /* 26ap1: windows in a row above icecpu_tame_pct */
+	uint8_t held;                   /* 26ap1: held to icecpu_tame_hold % */
+} top_prev[TOP_MAX], top_now[TOP_MAX];
+
+/*
+ * 26ap1, boot-arg icecpu_tame=1 (needs icecpu_top=N): a process above icecpu_tame_pct % of one CPU (default 35) for
+ * icecpu_tame_windows top windows in a row (default 4: ~20 s with icecpu_top=5) is held to icecpu_tame_hold % (default
+ * 10) of one CPU per second for the rest of the run: proc_set_task_ruse_cpu(THROTTLE), the kernel's own CPU-limit
+ * ledger, as a launchd job's CPU monitor. Never: the exempt names below (the window server, SpringBoard and its icon /
+ * poster helpers, launchd and the daemons the system cannot wait on) and icecpu_tame_exempt=a,b,... Lines
+ * "icecpu: tame: ...". After aTechGeekDev/ios-apollo c0b4400 xnu/patches/0160-apollo-cpu-budget-touch-boost.patch
+ * (sweet_cpu_tame: 35 % x 4 windows -> 10 %, their exempt list; MIT; written here).
+ */
+static uint32_t tame_on, tame_pct = 35, tame_windows = 4, tame_hold = 10, tame_held;
+static char tame_extra[160];
+static uint64_t top_span_abs;
+static const char *const tame_exempt[] = {
+	"kernel_task", "launchd", "launchd.ios", "backboardd", "SpringBoard", "SBRendererService", "iconservicesagent",
+	"PosterBoard", "mediaserverd", "audiomxd", "bluetoothd", "BlueTool", "wifid", "configd", "logd", "watchdogd",
+	"runningboardd", "UserEventAgent", "securityd", "keybagd", "init",
+};
+
+static bool
+tame_is_exempt(const char *name)
+{
+	size_t n = strlen(name);
+
+	for (size_t i = 0; i < sizeof(tame_exempt) / sizeof(tame_exempt[0]); i++) {
+		if (strcmp(name, tame_exempt[i]) == 0) {
+			return true;
+		}
+	}
+	for (const char *p = tame_extra; n != 0 && *p != 0;) {
+		size_t len = 0;
+
+		while (p[len] != 0 && p[len] != ',') {
+			len++;
+		}
+
+		if (len == n && strncmp(p, name, n) == 0) {
+			return true;
+		}
+		p += len;
+		p += *p == ',';
+	}
+	return false;
+}
+static uint32_t top_prev_n, top_now_n;
+static struct top_best {
+	int pid;
+	uint64_t delta;
+	char name[20];
+} top_best[6];
+
+static int
+top_visit(proc_t p, __unused void *arg)
+{
+	task_t task = proc_task(p);
+	struct recount_times_mach t;
+	uint64_t total, before = 0;
+	int pid = proc_pid(p);
+
+	if (task == TASK_NULL || top_now_n >= TOP_MAX) {
+		return PROC_RETURNED;
+	}
+	t = recount_task_times(task);
+	total = t.rtm_user + t.rtm_system;
+	top_now[top_now_n].pid = pid;
+	top_now[top_now_n].total = total;
+	top_now[top_now_n].over = 0;
+	top_now[top_now_n].held = 0;
+	top_now_n++;
+	for (uint32_t i = 0; i < top_prev_n; i++) {
+		if (top_prev[i].pid == pid) {
+			before = top_prev[i].total;
+			break;
+		}
+	}
+	if (before == 0 || total < before) {
+		return PROC_RETURNED;           /* (new since the last look: counted from the next one) */
+	}
+	uint64_t d = total - before;
+	if (tame_on && top_span_abs != 0) {     /* 26ap1 */
+		struct top_seen *now = &top_now[top_now_n - 1];
+		uint8_t over = 0, held = 0;
+
+		for (uint32_t i = 0; i < top_prev_n; i++) {
+			if (top_prev[i].pid == pid) {
+				over = top_prev[i].over;
+				held = top_prev[i].held;
+				break;
+			}
+		}
+		over = d * 100 > top_span_abs * tame_pct ? (uint8_t)(over < 250 ? over + 1 : 250) : 0;
+		if (!held && over >= tame_windows) {
+			const char *name = proc_best_name(p);
+
+			if (tame_is_exempt(name)) {
+				if (over == tame_windows) {
+					say("tame: %s[%d] above %u %% for %u windows: exempt, not held\n", name, pid, tame_pct, over);
+				}
+			} else {
+				int error = proc_set_task_ruse_cpu(task, TASK_POLICY_RESOURCE_ATTRIBUTE_THROTTLE, (uint8_t)tame_hold,
+				    NSEC_PER_SEC, 0, 1);
+
+				held = 1;
+				tame_held++;
+				say("tame: %s[%d] above %u %% of a CPU for %u windows (last %llu %%): held to %u %%: %s (error %d), "
+				    "%u held so far\n", name, pid, tame_pct, over, d * 100 / top_span_abs, tame_hold,
+				    error == 0 ? "done" : "REFUSED", error, tame_held);
+			}
+		}
+		now->over = over;
+		now->held = held;
+	}
+	for (int k = 0; k < 6; k++) {
+		if (d > top_best[k].delta) {
+			for (int j = 5; j > k; j--) {
+				top_best[j] = top_best[j - 1];
+			}
+			top_best[k].pid = pid;
+			top_best[k].delta = d;
+			strlcpy(top_best[k].name, proc_best_name(p), sizeof(top_best[k].name));
+			break;
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+top_report(uint64_t span_abs)
+{
+	uint64_t span_ns = 0;
+	char line[400];
+	size_t at = 0;
+
+	bzero(top_best, sizeof(top_best));
+	top_now_n = 0;
+	top_span_abs = span_abs;        /* 26ap1: the window's length for top_visit's shares */
+	proc_iterate(PROC_ALLPROCLIST, top_visit, NULL, NULL, NULL);
+	absolutetime_to_nanoseconds(span_abs, &span_ns);
+	for (int k = 0; k < 6 && top_best[k].delta != 0 && span_ns != 0; k++) {
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(top_best[k].delta, &ns);
+		at += (size_t)snprintf(line + at, sizeof(line) - at, " %s[%d] %llu.%llu%%;", top_best[k].name, top_best[k].pid,
+		    ns * 100 / span_ns, (ns * 1000 / span_ns) % 10);
+		if (at >= sizeof(line)) {
+			break;
+		}
+	}
+	if (top_prev_n != 0) {
+		say("top over %llu ms (share of one CPU):%s\n", span_ns / 1000000, at ? line : " none");
+	}
+	memcpy(top_prev, top_now, sizeof(top_now[0]) * top_now_n);
+	top_prev_n = top_now_n;
+}
+
+/*
+ * w3-power, with icecpu_top=N: what the process list above cannot see. A process that starts and ends inside one window
+ * (a launchd job that fails and is started again, xpcproxy for every start) is in neither snapshot, so its CPU time
+ * shows only as busy cores. bsd/kern/kern_exec.c counts every image activation here and bsd/kern/kern_exit.c every exit
+ * with the CPU time (user + system, its whole life) of the task that ends; the line "top: cpus busy" gives both per
+ * window beside each CPU's busy share. Without icecpu_top nothing is counted.
+ */
+extern uint64_t hakios_cpu_idle_mach(int cpu);  /* osfmk/arm64/hakios_cpu_idle.c (also declared below, for the governor) */
+extern unsigned int ml_get_cpu_count(void);
+static uint32_t top_on;
+static uint32_t top_execs, top_exits, top_execs_seen, top_exits_seen;
+static uint64_t top_exit_abs, top_exit_abs_seen;
+
+void hakios_iceland_top_exec(void);
+void
+hakios_iceland_top_exec(void)
+{
+	if (top_on) {
+		__atomic_fetch_add(&top_execs, 1, __ATOMIC_RELAXED);
+	}
+}
+
+void hakios_iceland_top_exit(task_t task);
+void
+hakios_iceland_top_exit(task_t task)
+{
+	if (top_on && task != TASK_NULL) {
+		const struct recount_times_mach t = recount_task_times(task);
+
+		__atomic_fetch_add(&top_exits, 1, __ATOMIC_RELAXED);
+		__atomic_fetch_add(&top_exit_abs, t.rtm_user + t.rtm_system, __ATOMIC_RELAXED);
+	}
+}
+
+/* each CPU's busy share over WIN (IDLE[c] = its idle time in WIN, zeroed here), their sum, and the execs and exits */
+static void
+top_cpus(uint64_t win, uint64_t idle[8], int cpus, const char *levels)
+{
+	char cl[160];
+	size_t ca = 0;
+	uint64_t all = 0, win_ns = 0, exit_ns = 0;
+	const uint32_t execs = __atomic_load_n(&top_execs, __ATOMIC_RELAXED), exits = __atomic_load_n(&top_exits, __ATOMIC_RELAXED);
+	const uint64_t exit_abs = __atomic_load_n(&top_exit_abs, __ATOMIC_RELAXED);
+
+	cl[0] = 0;
+	for (int c = 0; c < cpus && c < 8; c++) {
+		const uint64_t b = win > idle[c] ? (win - idle[c]) * 1000 / win : 0;
+
+		all += b;
+		if (ca < sizeof(cl)) {
+			ca += (size_t)snprintf(cl + ca, sizeof(cl) - ca, " %llu.%llu", b / 10, b % 10);
+		}
+	}
+	for (int c = 0; c < 8; c++) {
+		idle[c] = 0;
+	}
+	absolutetime_to_nanoseconds(win, &win_ns);
+	absolutetime_to_nanoseconds(exit_abs - top_exit_abs_seen, &exit_ns);
+	const uint64_t exit_pm = win_ns ? exit_ns * 1000 / win_ns : 0;      /* per mille of one CPU */
+
+	say("top: cpus busy %% over the window:%s; sum %llu.%02llu CPUs; %u execs, %u exits (their lifetime CPU %llu.%llu %% of "
+	    "one CPU over the window)%s\n", cl, all / 1000, all % 1000 / 10, execs - top_execs_seen, exits - top_exits_seen,
+	    exit_pm / 10, exit_pm % 10, levels);
+	top_execs_seen = execs;
+	top_exits_seen = exits;
+	top_exit_abs_seen = exit_abs;
+}
+
+/* w4-perf: the levels the governor is at and whether it runs, for the top line, which is a thread of its own now */
+#define DOMAINS_MAX             2u              /* scmi_perf 0 (cpu0-5), 1 (cpu6-7) */
+static volatile uint32_t gov_level[DOMAINS_MAX];
+static volatile bool gov_running;
+
+/*
+ * w3-power: icecpu_top=N: the same two lines every N s from a thread of their own, so the idle desktop's load can be read
+ * where the governor does not run (icecpu=0, or no SCMI: QEMU). w4-perf: this thread is where they are made with the
+ * governor too (icecpu=5), not in the governor's 20 ms loop any more: top_report's proc_iterate() took about 240 ms
+ * (median of 109 reports in runs/merge6-login-1/20261116-000916, up to 3.2 s under load) and the governor's loop -- the
+ * temperature check included -- stood still for that long: the largest gap between two 2 s governor lines there is
+ * 279.391 -> 284.460 s, and the line after it is the run's 101.1 C.
+ */
+static void
+top_thread(void *arg, wait_result_t w __unused)
+{
+	const uint32_t every = (uint32_t)(uintptr_t)arg;
+	const int cpus = (int)ml_get_cpu_count();
+	uint64_t last[8] = { 0 }, idle[8] = { 0 }, at;
+
+	for (int c = 0; c < cpus && c < 8; c++) {
+		last[c] = hakios_cpu_idle_mach(c);
+	}
+	at = mach_absolute_time();
+	say("top: every %u s %s: the busiest processes, each CPU's busy share, execs and exits\n", every,
+	    gov_running ? "with the governor, in a thread of its own" : "without the governor");
+	for (;;) {
+		char lv[48];
+
+		delay_for_interval(every * 1000, NSEC_PER_MSEC);
+		const uint64_t now = mach_absolute_time();
+
+		for (int c = 0; c < cpus && c < 8; c++) {
+			const uint64_t i = hakios_cpu_idle_mach(c);
+
+			idle[c] = i - last[c];
+			last[c] = i;
+		}
+		top_report(now - at);
+		lv[0] = 0;
+		if (gov_running) {
+			snprintf(lv, sizeof(lv), "; d0 level %u d1 level %u", gov_level[0], gov_level[1]);
+		}
+		top_cpus(now - at, idle, cpus, lv);
+		at = now;
+	}
+}
+extern volatile uint64_t hakios_ui_swap_at;    /* 20q: the last SwapEnd (iokit/Kernel/MiniIOMobileFramebuffer.cpp) */
+extern volatile uint64_t hakios_ui_touch_at;   /* 20u: a finger last down (bsd/dev/hakios_iceland_touch.c) */
+
+/*
+ * 20y, boot-arg icecpu_ddr=1|2: the processors' own vote for DDR (BCM MC0) and the LLCC (SH0). Nothing in this kernel
+ * votes for the CPUs' path to memory (Linux: chm_apps through interconnect, and CPUCP's memlat behind the ddr devfreq
+ * "remote"); only the GPU's GMU votes, by its level (5.3 GB/s at 282-382 MHz), and the boot chain's APPS vote for the
+ * display. So DDR may sit near its floor (547 MHz of 5333) while the CPUs stall on memory: busy, slow, GPU idle -- 20q.
+ * The vote is BCM_TCS_CMD (commit, valid, AB = IB) in the BCM's units, computed as the GPU's bus table does from
+ * cmd-db's data for SH0 / MC0 (unit 5300000, width 64 / 16, logged by icegpu "bus:"): kB/s x width / 4 x 1000 / unit,
+ * the same value for both (as the GPU table has it). Sent from the APPS RSC (hakios_iceland_rpmh_bcm_cmd, which
+ * replaces this DRV's earlier MC0 / SH0 vote, the boot chain's included): nothing before the first SwapEnd, then high
+ * while the screen is drawn or touched (a SwapEnd / touch in the last 200 ms), low otherwise, never released; the low
+ * level stays above Linux's idle CPU peak (chm_apps 4512000 kB/s) and the panel's own read (3392x2400x4 at 120 Hz =
+ * 3.9 GB/s). Mode 1: 16500000 / 8171875 kB/s (the GPU's 1000 MHz / 646 MHz entries); mode 2: 20832031 / 8171875.
+ * Lines "icecpu: ddr: ..." for every change (up to 200).
+ */
+extern int hakios_iceland_rpmh_bcm_cmd(const char *name, uint32_t cmd);
+static const struct {
+	uint32_t hi_kbps, lo_kbps;
+} ddr_steps[3] = { { 0, 0 }, { 16500000, 8171875 }, { 20832031, 8171875 } };
+static int ddr_state = -1;                      /* -1 nothing sent, 0 low, 1 high */
+static uint32_t ddr_changes, ddr_failed;
+
+static uint32_t
+ddr_cmd(uint32_t kbps)
+{
+	/* MC0: width 16 / bus width 4, SH0: 64 / 16 -- the same factor, the same value (as the GPU's table) */
+	uint64_t v = (uint64_t)kbps * 16 / 4 * 1000 / 5300000;
+	uint32_t vote = (uint32_t)(v < 1 ? 1 : v > 0x3fff ? 0x3fff : v);
+
+	return 1u << 30 | 1u << 29 | vote << 14 | vote;
+}
+
+static void
+ddr_tick(bool ui, uint32_t mode)
+{
+	int want = ui ? 1 : 0;
+	uint32_t m = mode > 2 ? 2 : mode, kbps, cmd;
+	int r0, r1;
+
+	if (ddr_state == -1 && hakios_ui_swap_at == 0) {
+		return;                         /* not before the first SwapEnd: the boot chain's vote stands until then */
+	}
+	if (want == ddr_state) {
+		return;
+	}
+	kbps = want ? ddr_steps[m].hi_kbps : ddr_steps[m].lo_kbps;
+	cmd = ddr_cmd(kbps);
+	r0 = hakios_iceland_rpmh_bcm_cmd("SH0", cmd);
+	r1 = hakios_iceland_rpmh_bcm_cmd("MC0", cmd);
+	ddr_changes++;
+	ddr_failed += r0 != 0 || r1 != 0;
+	if (ddr_changes <= 200) {
+		say("ddr: %s: SH0 / MC0 %#x (%u kB/s): %d / %d (%u changes)\n", want ? "drawing: high" : "idle: low", cmd, kbps,
+		    r0, r1, ddr_changes);
+	}
+	ddr_state = want;                       /* (a failure is not retried every 20 ms: the line says it failed) */
+}
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern boolean_t pmap_valid_page(ppnum_t pn);
+extern processor_t thread_bind(processor_t processor);
+extern processor_t cpu_to_processor(int cpu);
+extern unsigned int ml_get_cpu_count(void);
+extern wait_result_t thread_block(thread_continue_t continuation);
+
+#define PDP0_MBOX_TX_PHYS       0x19980000UL    /* pdp0_mbox reg[1] = tx_base (Linux: rx_base is reg[0], 0x17610000) */
+#define PDP0_DOORBELL_CH0       (0x100 + 0x4)   /* APSS_CPUCP_TX_MBOX_CMD(0) + APSS_CPUCP_MBOX_CMD_OFF */
+#define PDP_SRAM_PHYS           0x81f08000UL    /* sram@81f08000 (0x200 bytes) */
+#define PDP_TX_OFF              0x100u          /* pdp_tx: scp-sram-section@100, 0x80 bytes */
+#define PDP_TX_SIZE             0x80u
+#define SCMI_PERF               0x13u
+#define LEVELS_MAX              40u
+
+static vm_offset_t mbox, sram, shmem;
+static uint32_t token;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+/*
+ * One SCMI command, polled. Shared memory (arm,scmi-shmem): channel status +4 (bit 0 free, bit 1 error), flags +0x10,
+ * length +0x14, message header +0x18, payload +0x1c. Only icecpu's thread ever calls this: commands never overlap.
+ * Returns 0, -1 (the channel never came free), -2 (no answer), -3 (channel error).
+ */
+static int
+scmi(uint32_t proto, uint32_t msg, const uint32_t *in, uint32_t nin, uint32_t *out, uint32_t maxout, uint32_t *nout)
+{
+	uint64_t deadline;
+	uint32_t t, len, words;
+
+	*nout = 0;
+	if (4 + nin * 4 > PDP_TX_SIZE - 0x18) {
+		return -3;
+	}
+	clock_interval_to_deadline(30, NSEC_PER_MSEC, &deadline);
+	while (!(rd(shmem + 4) & 1)) {
+		if (mach_absolute_time() > deadline) {
+			return -1;
+		}
+	}
+	t = (++token) & 0x3ff;
+	wr(shmem + 4, 0);
+	wr(shmem + 0x10, 0);
+	wr(shmem + 0x14, 4 + nin * 4);
+	wr(shmem + 0x18, (msg & 0xff) | (proto & 0xff) << 10 | t << 18);
+	for (uint32_t i = 0; i < nin; i++) {
+		wr(shmem + 0x1c + i * 4, in[i]);
+	}
+	__builtin_arm_dsb(0xf);
+	/* the doorbell: Linux writes the register's upper word (+4); the dada port's transport for the same mailbox type
+	 * wrote both words, upper first. Both here. */
+	wr(mbox + PDP0_DOORBELL_CH0, t | 1);
+	clock_interval_to_deadline(50, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		uint32_t st = rd(shmem + 4);
+
+		if ((st & 3) && ((rd(shmem + 0x18) >> 18) & 0x3ff) == t) {
+			if (st & 2) {
+				return -3;
+			}
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			return -2;
+		}
+	}
+	len = rd(shmem + 0x14);
+	words = len >= 4 ? (len - 4) / 4 : 0;
+	words = MIN(words, (PDP_TX_SIZE - 0x1c) / 4);
+	for (uint32_t i = 0; i < words && i < maxout; i++) {
+		out[i] = rd(shmem + 0x1c + i * 4);
+	}
+	*nout = MIN(words, maxout);
+	return 0;
+}
+
+static uint32_t
+clock_here_mhz(void)
+{
+	uint64_t span, start, now, x = 1, rounds = 0, ns;
+
+	nanoseconds_to_absolutetime(10 * NSEC_PER_MSEC, &span);
+	start = mach_absolute_time();
+	do {
+		for (int i = 0; i < 1000; i++) {
+			__asm__ volatile ("add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                                          "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                                          "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                                          "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n" : "+r"(x));
+		}
+		rounds += 1000;
+		now = mach_absolute_time();
+	} while (now - start < span);
+	absolutetime_to_nanoseconds(now - start, &ns);
+	return ns ? (uint32_t)(rounds * 16 * 1000 / ns) : 0;
+}
+
+/* the clock of every running CPU (only those: a bind to a CPU that is not running would wait for ever) */
+static void
+clocks(const char *when)
+{
+	char line[200];
+	int at = 0;
+
+	for (unsigned c = 0; c < (unsigned)ml_get_cpu_count() && c < 8; c++) {
+		processor_t p = cpu_to_processor((int)c);
+		uint32_t mhz = 0;
+
+		if (p != PROCESSOR_NULL) {
+			thread_bind(p);
+			thread_block(THREAD_CONTINUE_NULL);
+			mhz = clock_here_mhz();
+			thread_bind(PROCESSOR_NULL);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " cpu%u %u", c, mhz);
+	}
+	line[at] = 0;
+	say("%s: MHz (dependent adds, about the clock):%s\n", when, line);
+}
+
+/* the LEVEL_SET fast channels the firmware describes (icecpu=4 uses them only when they are the known ones) */
+static uint32_t fc_chan[DOMAINS_MAX], fc_db[DOMAINS_MAX], fc_db_set[DOMAINS_MAX];
+static const uint32_t fc_known_chan[DOMAINS_MAX] = { 0x19980118, 0x1a980118 };  /* pdp0 / pdp1 TX, channel 3 cmd word */
+static const uint32_t fc_known_db[DOMAINS_MAX] = { 0x1998011c, 0x1a98011c };    /* ... its doorbell (+4), 32-bit */
+
+static struct {
+	uint32_t levels, sustained_khz, top_sustained;
+	uint32_t level[LEVELS_MAX];     /* what LEVEL_SET / LEVEL_GET use: the level index in level indexing mode */
+	uint32_t khz[LEVELS_MAX];       /* its indicative frequency (protocol >= 4), else the level value itself */
+} dom[DOMAINS_MAX];
+
+/* ---- the governor (icecpu=5) ---------------------------------------------------------------------------------- */
+
+extern uint64_t hakios_cpu_idle_mach(int cpu);  /* osfmk/arm64/hakios_cpu_idle.c: the scheduler's idle time of a CPU */
+extern int hakios_cpu_cluster(int cpu);         /* ... its MPIDR Aff2: 0 = cpu0-5 (domain 0), 1 = the prime pair (1) */
+
+/* The CPU temperature sensors, from the Pad's DT (thermal zones cpu-0-N-0/1 on tsens1, cpu-1-N-0/1 on tsens3; reg[0] =
+ * TM per Linux's tsens.c): sensor n's last reading at TM + 0xa0 + 4n, bits 0-11 signed tenths of a degree, bit 21 valid. */
+static const struct {
+	uint32_t tm, first, count, domain;
+} ice_tsens[] = {
+	{ 0x0c22a000u, 0, 12, 0 },              /* tsens1: cpu-0-0-0 .. cpu-0-5-1 */
+	{ 0x0c22c000u, 0, 4, 1 },               /* tsens3: cpu-1-0-0 .. cpu-1-1-1 */
+};
+/*
+ * G3: the thermal ceiling, after lenzhang's PianoThermal (package/PianoThermal/{Cluster.h,Governor.h,PianoThermal.cpp},
+ * github.com/lenzhang/UniXNU-xiaomipad8pro, 4185c0f): 90 C to limit, releasing under 85 C, and the climb back one
+ * level a second (theirs: riseMs 1000), not one a 100 ms check. TOO_HOT stays at 110 C (the DT's hot trip is 120 C).
+ * Boot-args, as the rest of this file's: icecpu_hot=D, icecpu_cool=D and icecpu_toohot=D in tenths of a degree
+ * (defaults 900, 850, 1100); refused unless cool < hot < toohot and each within 100..2000.
+ */
+#define HOT_DECI        900                     /* above: the cap goes down 2 levels a check */
+#define TOO_HOT_DECI    1100                    /* above: straight to the lowest level (the DT's hot trip is 120 C) */
+#define COOL_DECI       850                     /* below: the cap comes back 1 level a second */
+
+static vm_offset_t tsens_tm[2], fc_page[DOMAINS_MAX];
+
+/*
+ * w3-power, for iokit/Kernel/HakiosIcelandThermalLevel.cpp (thermal-level=1): each domain's hottest CPU sensor at the governor's
+ * last 100 ms check, in tenths of a degree; -1000 before the first check, for a domain without a reading, and without the governor.
+ */
+static volatile int32_t temp_now_deci[DOMAINS_MAX] = { -1000, -1000 };
+
+int32_t hakios_iceland_cpu_temp_deci(unsigned domain);
+int32_t
+hakios_iceland_cpu_temp_deci(unsigned domain)
+{
+	return domain < DOMAINS_MAX ? temp_now_deci[domain] : -1000;
+}
+extern int hakios_iceland_thermal_level_publish(void);
+
+/*
+ * w4-perf: the pressure level, on the target's trip table (scratchpad TARGET.md): moderate at 90 C die (released under
+ * 85) or 41 C shell (39), heavy at 105 C (100) or 45 C (43), trapping at 112 C or 51 C (49). A level is left only when
+ * the reading is under its falling threshold, as iokit/Kernel/HakiosIcelandThermalLevel.cpp's crossed / hysteresis loop
+ * does. The die input is the hottest of the two CPU domains' last readings and the rest of the SoC's sensors
+ * (hakios_iceland_tsens_soc_deci), tenths of a degree C, -1000 none; the shell input is the battery gauge's temperature
+ * for now (whole degrees C, -273 when there is no reading, and only while the battery driver runs: icebatt=4 or more),
+ * not the skin thermistor. Always computed, cheap, and nothing acts on it by itself: ice_floor_yield=1 does.
+ */
+extern int redwood_battery_temperature(void);    /* bsd/dev/redwood_battery.c: the battery's temperature in C, -273: none */
+extern int32_t hakios_iceland_skin_deci(unsigned which); /* bsd/dev/hakios_iceland_buttons.c: 0 skin, 1 board, 3 wlan; -1000 */
+static volatile uint32_t ice_die_level, ice_shell_level;
+static const int32_t ice_die_trip[3] = { 900, 1050, 1120 }, ice_die_hyst[3] = { 50, 50, 50 };
+static const int32_t ice_shell_trip[3] = { 410, 450, 510 }, ice_shell_hyst[3] = { 20, 20, 20 };
+
+/* the level a reading is at, given the level before it: a trip already crossed is left under its falling threshold */
+static uint32_t
+pressure_step(int32_t deci, uint32_t level, const int32_t *trip, const int32_t *hyst)
+{
+	uint32_t crossed = 0;
+
+	if (deci > -1000) {
+		for (uint32_t t = 0; t < 3; t++) {
+			const int32_t at = level > t ? trip[t] - hyst[t] : trip[t];
+
+			if (deci < at) {
+				break;
+			}
+			crossed = t + 1;
+		}
+	}
+	return crossed;
+}
+
+uint32_t hakios_iceland_pressure(void);
+uint32_t
+hakios_iceland_pressure(void)
+{
+	return ice_die_level > ice_shell_level ? ice_die_level : ice_shell_level;
+}
+
+uint32_t hakios_iceland_shell_level(void);
+uint32_t
+hakios_iceland_shell_level(void)
+{
+	return ice_shell_level;
+}
+
+static int32_t
+domain_temp(uint32_t d)
+{
+	int32_t hottest = -1000;
+
+	for (uint32_t t = 0; t < 2; t++) {
+		if (ice_tsens[t].domain != d || !tsens_tm[t]) {
+			continue;
+		}
+		for (uint32_t i = 0; i < ice_tsens[t].count; i++) {
+			uint32_t v = rd(tsens_tm[t] + 0xa0 + 4 * (ice_tsens[t].first + i));
+			int32_t deci = (int32_t)((v & 0xfff) << 20) >> 20;
+
+			if ((v & (1u << 21)) && deci > hottest) {
+				hottest = deci;
+			}
+		}
+	}
+	return hottest;
+}
+
+/*
+ * w4-perf, boot-arg icecpu_trips=1: a domain's temperature with the CPU sub-system's other zones, the cluster's cache and
+ * its QMX (the Pad's thermal-zones: cpullc-0-0/1 and qmx-0-0..2 on tsens0 for cpu0-5, cpullc-1-0/1 and qmx-1-0..4 on
+ * tsens2 for the prime pair). The governor used to look at the cores alone, so the cache ran hot unseen; -1000 (no
+ * mapping, no valid reading) loses the maximum by itself. bsd/dev/hakios_iceland_tsens.c reads them.
+ */
+static int32_t
+domain_temp_max(uint32_t d)
+{
+	int32_t hottest = domain_temp(d);
+	uint32_t groups[2];
+
+	if (d == 0) {
+		groups[0] = ICETSENS_LLC0;
+		groups[1] = ICETSENS_QMX0;
+	} else if (d == 1) {
+		groups[0] = ICETSENS_LLC1;
+		groups[1] = ICETSENS_QMX1;
+	} else {
+		return hottest;                 /* (the Pad has two domains; nothing else has a cache or QMX of its own) */
+	}
+	for (uint32_t i = 0; i < 2; i++) {
+		const int32_t t = hakios_iceland_tsens_group_deci(groups[i]);
+
+		if (t > hottest) {
+			hottest = t;
+		}
+	}
+	return hottest;
+}
+
+static void
+fc_set(uint32_t d, uint32_t l)
+{
+	wr(fc_page[d] + (fc_chan[d] & 0xfff), dom[d].level[l]);
+	__builtin_arm_dsb(0xf);
+	wr(fc_page[d] + (fc_db[d] & 0xfff), fc_db_set[d]);
+}
+
+/*
+ * w4-perf, boot-arg ice_shutdown=1 (default off, with the governor): Linux powers the tablet off at its critical trips
+ * (125 C die, 70 C skin); this kernel had no such trip. 120 C is Linux's hot trip, taken as ours; five ticks in a row
+ * (100 ms) because single-tick spikes are real on this die (runs/w4-perf-2b-trips-yield/20261116-093226: the 99.6 C
+ * spike lasted under 170 ms). It adds a limit and removes none. Without the governor (no SCMI answer) there is no trip.
+ *
+ * The way off is the kernel's own: PE_halt_restart(kPEHaltCPU), as iokit/Kernel/IOPlatformExpert.cpp's halt path calls
+ * it -- osfmk/arm64/psci_halt.c registered psci_halt_restart, which sends PSCI SYSTEM_OFF (0x84000008) over the conduit
+ * the device tree names ("smc" on the tablet). It does not return; when no handler is set the levels stay at the lowest
+ * and the caller keeps both caps at 0 for the rest of the run.
+ */
+static void
+shutdown_off(uint32_t domains, bool battery, int32_t deci, int battery_c)
+{
+	for (uint32_t d = 0; d < domains; d++) {
+		fc_set(d, 0);                           /* the lowest level first: the caps are moot below it */
+		gov_level[d] = 0;
+	}
+	if (battery) {
+		say("shutdown: battery %d C on two readings in a row: powering off\n", battery_c);
+	} else {
+		const int32_t a = deci < 0 ? -deci : deci;
+
+		say("shutdown: die %d.%d C on 5 ticks in a row: powering off\n", deci / 10, a % 10);
+	}
+	say("shutdown: levels set to the lowest; PSCI power off in 300 ms\n");
+	delay_for_interval(300, NSEC_PER_MSEC);
+	if (PE_halt_restart == NULL) {
+		say("shutdown: no power-off hook: levels stay at the lowest\n");
+		return;
+	}
+	(void)(*PE_halt_restart)(kPEHaltCPU);
+}                                               /* (SYSTEM_OFF: only a refusal comes back) */
+
+static volatile int load_cpu = -1;              /* icecpuload: the CPU the test load spins on, -1 none */
+
+static void
+load_thread(void *arg __unused, wait_result_t w __unused)
+{
+	int cpus = (int)ml_get_cpu_count(), prime = -1;
+
+	for (int c = 0; c < cpus; c++) {
+		if (hakios_cpu_cluster(c) == 1 && prime < 0) {
+			prime = c;
+		}
+	}
+	delay_for_interval(5000, NSEC_PER_MSEC);
+	for (int phase = 0; phase < 2; phase++) {
+		int c = phase == 0 ? prime : 0;
+		uint64_t end;
+
+		if (c < 0) {
+			continue;
+		}
+		thread_bind(cpu_to_processor(c));
+		thread_block(THREAD_CONTINUE_NULL);
+		load_cpu = c;
+		say("test load: spinning on cpu%d for 5 s\n", c);
+		clock_interval_to_deadline(5000, NSEC_PER_MSEC, &end);
+		while (mach_absolute_time() < end) {
+			__asm__ volatile ("" ::: "memory");
+		}
+		load_cpu = -1;
+		thread_bind(PROCESSOR_NULL);
+		thread_block(THREAD_CONTINUE_NULL);
+		say("test load: cpu%d idle again\n", c);
+		delay_for_interval(3000, NSEC_PER_MSEC);
+	}
+}
+
+/*
+ * w3-power: the default headroom, 167 % (was 125). The target clock is khz x busy x head / 100 of the busiest core's 20 ms
+ * window, so a domain settles where busy = 100 / head: 80 % with 125, 60 % with 167. At level 0 (384 MHz) the step up came
+ * only above 80 % busy, so the idle desktop's work (50-65 % of a core at 384 MHz in w2-teardown-3 and w2-stack-2, already at
+ * 39-58 s before the desktop) ran stretched about 9x at the lowest clock; with 167 it steps up above 60 %. The thermal caps,
+ * the four-window rule for going down and icecpu_head=P (100..400) are unchanged.
+ *
+ * merge6: back to 125 for now. 167 was never measured on the tablet, and icecpu_floor0=20 (built in on macOS,
+ * pexpert/arm/pe_builtin_args.c) already lifts domain 0 while the window server draws. icecpu_head=167 asks for it.
+ */
+#define HEAD_DEFAULT    125
+
+/*
+ * w5-thermal, boot-arg icecpu_gears=1 (and icethermal=2): stock OxygenOS's 20 shell-temperature gears (horae
+ * thermal_status_model + Battery.apk's globalPolicy), entered at 27 C and left 2 C lower, with a cap a cluster from gear 3.
+ * Until the Pad's skin thermistors are read the shell input is stock's own fallback: the battery's temperature + 2.0 C
+ * (stock's bat_bias, icecpu_shell_bias=D in tenths). kHz / 100 in a plain static uint16_t table (0 = no cap for the gear),
+ * the thresholds in plain statics too: __TEXT has little room and these are data.
+ */
+#define GEARS           20
+static uint8_t gear_enter[GEARS] = { 27, 29, 31, 33, 35, 37, 39, 40, 41, 43, 45, 47, 49, 51, 53, 55, 57, 59, 61, 63 };
+static uint8_t gear_leave[GEARS] = { 25, 27, 29, 31, 33, 35, 37, 39, 40, 41, 43, 45, 47, 49, 51, 53, 55, 57, 59, 61 };
+static uint16_t gear_khz[DOMAINS_MAX][GEARS] = {
+	/* cluster 0: 2361.6, 2361.6, 2227.2, 1996.8, 1996.8, 1785.6, 1555.2, 1324.8, 1324.8, 1113.6, then 998.4 MHz */
+	{ 0, 0, 0, 23616, 23616, 22272, 19968, 19968, 17856, 15552, 13248, 13248, 11136, 9984, 9984, 9984, 9984, 9984,
+	    9984, 9984 },
+	/* the prime pair: 1862.4, then 1632.0, 1497.6, 1267.2, 1382.4, 1017.6, then 883.2 MHz */
+	{ 0, 0, 0, 18624, 16320, 16320, 16320, 16320, 14976, 12672, 13824, 10176, 10176, 8832, 8832, 8832, 8832, 8832,
+	    8832, 8832 },
+};
+
+/* the gear a shell reading (tenths of a degree C) puts the tablet in: up at enter[gear + 1], down under leave[gear] */
+static int
+gears_step(int gear, int32_t shell_deci)
+{
+	while (gear < (int)GEARS - 1 && shell_deci >= (int32_t)gear_enter[gear + 1] * 10) {
+		gear++;
+	}
+	while (gear >= 0 && shell_deci < (int32_t)gear_leave[gear] * 10) {
+		gear--;
+	}
+	return gear;
+}
+
+/* the highest level of d at or under the gear's cap (level 0 when even that is over it); top when the gear has no cap */
+static uint32_t
+gears_level(uint32_t d, int gear, uint32_t top)
+{
+	uint32_t level = 0;
+
+	if (gear < 3 || d >= DOMAINS_MAX || gear_khz[d][gear] == 0) {
+		return top;
+	}
+	for (uint32_t l = 0; l <= top && l < LEVELS_MAX; l++) {
+		if (dom[d].khz[l] <= (uint32_t)gear_khz[d][gear] * 100u) {
+			level = l;
+		}
+	}
+	return level;
+}
+
+/* a temperature in tenths of a degree C as "99.6" (the sign once, the fraction absolute, as the rest of the file does it) */
+static const char *
+deci_str(char *buf, size_t size, int32_t deci)
+{
+	const int32_t a = deci < 0 ? -deci : deci;
+
+	if (deci <= -1000) {
+		return "-";                     /* no reading */
+	}
+	snprintf(buf, size, "%s%d.%d", deci < 0 ? "-" : "", a / 10, a % 10);
+	return buf;
+}
+
+/* w5-thermal, icecpu_tstat=1: the four ticks kept before a hot one (the "pre:" lines), and this tick's own figures */
+#define TRACE_PRE       4
+#define CEIL_TICKS      5               /* icecpu_ceil=1's look-ahead: the temperature 5 ticks (100 ms) ago */
+
+/*
+ * w5-thermal, icecpu_tstat=1: one line of the hot trace ("hot", or "pre" for the ticks before the episode): the die's
+ * hottest sensor and its group, the domains' temperatures, their levels after the tick, the effective ceilings (B4) and
+ * the busiest cores of each cluster in percent.
+ */
+static void
+tstat_hot_line(const char *tag, int32_t hot, unsigned group, const int32_t *t, const uint32_t *lv, const uint32_t *lim,
+    const uint64_t *busy, uint32_t domains)
+{
+	char a[16], b[16], line[200];
+	int at;
+
+	at = snprintf(line, sizeof(line), "%s: %s %s", tag, deci_str(a, sizeof(a), hot), hakios_iceland_tsens_group_name(group));
+	for (uint32_t d = 0; d < domains && at > 0 && (size_t)at < sizeof(line); d++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " d%u %s", d, deci_str(b, sizeof(b), t[d]));
+	}
+	if (at > 0 && (size_t)at < sizeof(line)) {
+		snprintf(line + at, sizeof(line) - (size_t)at, " lv %u/%u lim %u/%u busy %llu/%llu", lv[0],
+		    domains > 1 ? lv[1] : 0, lim[0], domains > 1 ? lim[1] : 0, busy[0] / 10, busy[1] / 10);
+	}
+	say("%s\n", line);
+}
+
+static void
+governor(uint32_t domains)
+{
+	int cpus = (int)ml_get_cpu_count();
+	uint64_t last_idle[8] = { 0 }, last_t, window;
+	uint32_t cur[DOMAINS_MAX], cap[DOMAINS_MAX], quiet[DOMAINS_MAX] = { 0 }, tick = 0;
+	uint32_t load = 0, head = HEAD_DEFAULT, uifloor[DOMAINS_MAX] = { 0 }, ui_floors = 0, touch_floor = 0, touch_floors = 0;
+	uint32_t ddr_mode = 0;
+	uint64_t ui_window = 0;
+	uint32_t top_every = 0;
+	uint32_t hot_deci = HOT_DECI, cool_deci = COOL_DECI, too_hot_deci = TOO_HOT_DECI;
+	uint32_t trips = 0;
+	uint32_t yield = 0, yield_floor[DOMAINS_MAX] = { 0 }, pressure_seen = 0, pressure_lines = 0;
+	uint32_t rise = 2, rise_limited = 0;
+	uint32_t shutdown = 0, shutdown_test = 0, shutdown_deci = 1200, die_hot_ticks = 0, battery_hot = 0, shutdown_why = 0;
+	bool shutdown_done = false, shutdown_latched = false;
+	int battery_c = -273;
+	int32_t trip_prev[DOMAINS_MAX] = { -1000, -1000 };      /* w4-perf: each domain's last 20 ms reading (icecpu_trips) */
+	uint64_t last_rise[DOMAINS_MAX] = { 0 }, rise_interval = 0;
+	uint64_t own_ticks = 0, own_windows = 0;
+	uint64_t boost_until = 0;
+	uint32_t boost_s = 0;
+	/* w5-thermal: icecpu_tstat=1 (B1), icecpu_ceil=1 (B2) and icecpu_gears=1 (B3), icethermal=2's three */
+	uint32_t tstat = 0, ceil_on = 0, soft_deci = 750, gears = 0, shell_bias = 20, shell_test = 0;
+	uint32_t shell_front = 0, shell_lines = 0;      /* w5-shell: icecpu_shell=1, stock's front model on the thermistors */
+	bool shell_front_live = false;
+	/* w5-thermal: icecpu_bootcap=S, the sticky boot ceiling (piano's boot-boost back-off) */
+	uint32_t bootcap_s = 0, bootcap_deci = 880, sticky[DOMAINS_MAX] = { 0 }, sticky_floor[DOMAINS_MAX] = { 0 };
+	uint32_t sticky_steps = 0;
+	uint64_t bootcap_until = 0;
+	uint32_t ceil_floor[DOMAINS_MAX] = { 0 }, pceil[DOMAINS_MAX] = { 0 }, limits[DOMAINS_MAX] = { 0 };
+	int32_t ceil_hist[DOMAINS_MAX][CEIL_TICKS], ceil_hist_n = 0;
+	uint32_t ceil_hist_at = 0;
+	uint64_t ceil_interval = 0, ceil_up[DOMAINS_MAX] = { 0 };
+	int gear = -1;
+	int32_t gear_shell_deci = -1000;
+	uint32_t gear_level[DOMAINS_MAX] = { 0 }, gear_lines = 0;
+	int32_t tstat_peak = -1000, tstat_run_peak = -1000;
+	unsigned tstat_peak_group = 0, tstat_run_peak_group = 0;
+	uint32_t tstat_win90 = 0, tstat_win95 = 0, tstat_run90 = 0, tstat_run95 = 0, tstat_lines = 0;
+	uint64_t tstat_run_peak_ms = 0;
+	bool tstat_was_hot = false;
+	uint32_t tstat_ring_at = TRACE_PRE, tstat_ring_n = 0;
+	struct {
+		int32_t hot, t[DOMAINS_MAX];
+		uint32_t group, lv[DOMAINS_MAX], lim[DOMAINS_MAX];
+		uint64_t busy[DOMAINS_MAX];
+	} tstat_ring[TRACE_PRE + 1];
+
+	for (uint32_t d = 0; d < domains; d++) {
+		if (fc_chan[d] != fc_known_chan[d] || fc_db[d] != fc_known_db[d] || fc_db_set[d] != 0xf || !dom[d].levels) {
+			say("governor: domain %u has no known fast channel: no governor\n", d);
+			return;
+		}
+		fc_page[d] = ml_io_map(fc_chan[d] & ~0xfffu, 0x1000);
+		cap[d] = dom[d].top_sustained;
+		pceil[d] = dom[d].top_sustained;        /* w5-thermal: icecpu_ceil=1's ceiling starts at the top */
+		cur[d] = 0;
+		gov_level[d] = 0;               /* w4-perf: for the top line */
+		fc_set(d, 0);                   /* start at the bottom: the governor raises what is needed */
+	}
+	for (uint32_t t = 0; t < 2; t++) {
+		tsens_tm[t] = ml_io_map(ice_tsens[t].tm, 0x1000);
+	}
+	/*
+	 * 20q (the owner's stutter video: ~20-25 frames a second, the GPU 8% busy at its lowest clock): the target
+	 * khz x busy x 1.25 settles where a domain is ~80% busy, so a frame's CPU work (CoreAnimation's commit and render
+	 * in backboardd, SpringBoard's layout) ran at 384-1440 MHz and took most of the 20 ms window: the frame rate the
+	 * clock allows, not the display's. Boot-args: icecpu_head=P (the target's headroom in percent, default 125) and,
+	 * while the screen is being drawn (a SwapEnd in the last 200 ms, MiniIOMobileFramebuffer.cpp), floors
+	 * icecpu_floor0=L / icecpu_floor1=L (levels of domain 0 / 1; the thermal caps still win). Line "icecpu: ui floor".
+	 */
+	(void)PE_parse_boot_argn("icecpu_top", &top_every, sizeof(top_every));
+	if (top_every != 0 && (top_every < 2 || top_every > 60)) {
+		top_every = 5;
+	}
+	top_on = top_every != 0;                        /* w3-power: execs and exits counted from here */
+	(void)PE_parse_boot_argn("icecpu_tame", &tame_on, sizeof(tame_on));      /* 26ap1 */
+	if (tame_on) {
+		(void)PE_parse_boot_argn("icecpu_tame_pct", &tame_pct, sizeof(tame_pct));
+		(void)PE_parse_boot_argn("icecpu_tame_windows", &tame_windows, sizeof(tame_windows));
+		(void)PE_parse_boot_argn("icecpu_tame_hold", &tame_hold, sizeof(tame_hold));
