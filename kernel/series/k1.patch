+	    native_gpu_addon_files, native_gpu_addon_written, native_gpu_addon_same, native_gpu_addon_failed, native_gpu_addon_error,
+	    native_gpu_addon_stage, native_gpu_addon_status, native_gpu_bundle_protected, native_gpu_bundle_protect_error);
+	/*
+	 * gpu-addon-daemons=1 (S11 gpuu-1): the owner launchd jobs of the addon (daemons/<label>.plist -> /private/var/ngpu/daemons)
+	 * shown read-only at the Data volume's /private/var/db/ManagedConfigurationFiles/BackgroundTaskServices/LaunchDaemons, a
+	 * directory launchd's system bootstrap reads at boot next to /System/Library/LaunchDaemons (it named it, ENOENT, in every
+	 * macOS run) and which no other job uses here. The directory is made first; it is empty, so the view lists exactly the
+	 * owner's jobs. Not over /System/Library/LaunchDaemons as on iPadOS (UniXNU zzy-native-gpu-addon-mount.patch): there
+	 * launchd's listing of the union showed the upper layer only, so no sealed job was loaded ("No task-access server
+	 * configured", no WindowServer: QEMU run gpuu 20261114-160525). Without any view the job in Data's /Library/LaunchDaemons is
+	 * left to backgroundtaskmanagementd, which ran only after the login window (S11 g4 run 121; gpuu 20261114-161601). Stage 4:
+	 * the directory is visible through the view; 5: the owner's job too. Off by default; never fatal.
+	 */
+	uint32_t daemons = 0;
+	if (PE_parse_boot_argn("gpu-addon-daemons", &daemons, sizeof(daemons)) && daemons == 1) {
+		static const char daemons_source[] = "/private/var/ngpu/daemons",
+		    daemons_point[] = "/private/var/db/ManagedConfigurationFiles/BackgroundTaskServices/LaunchDaemons";
+		int error = native_gpu_addon_parents(p, scratch,
+		    "/private/var/db/ManagedConfigurationFiles/BackgroundTaskServices/LaunchDaemons/.");
+		if (error) {
+			native_gpu_addon2_stage = 0;
+			native_gpu_addon2_status = error;
+		} else {
+			native_gpu_addon_mount(p, scratch, 0x600, daemons_source, sizeof(daemons_source), daemons_point,
+			    sizeof(daemons_point), daemons_point,
+			    "/private/var/db/ManagedConfigurationFiles/BackgroundTaskServices/LaunchDaemons/org.blu-sharky.adrenoprobed.plist",
+			    &native_gpu_addon2_stage, &native_gpu_addon2_status);
+		}
+		printf("owner Data: daemons view %s at %s: stage %d, status %d\n", daemons_source, daemons_point,
+		    native_gpu_addon2_stage, native_gpu_addon2_status);
+	}
+}
