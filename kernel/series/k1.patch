+		/* w4-audio round 7: the recorder's own lines still reach the log (nothing else does while the argument is off) */
+		if (fd != 1 && fd != 2) {
+			return;
+		}
+		if (strncmp(p->p_comm, "iceland-audio-r", 15) != 0 && strncmp(p->p_comm, "iceland-bt-scan", 15) != 0 &&
+		    strncmp(p->p_comm, "iceland-camera-", 15) != 0 && strncmp(p->p_comm, "IcelandCamera", 13) != 0 &&
+		    !(strcmp(p->p_comm, "bluetoothd") == 0 && stderr_log_btd())) {
+			return;
+		}
+	}
+	pid = proc_getpid(p);
+	/* level 2 is generous for pid 1 (all of its fds); level 1 is fd 1/2 of everyone */
+	pid1_wide = (stderr_log >= 2 && pid == 1);
+	if (fd != 1 && fd != 2 && !pid1_wide) {
+		return;
+	}
+
+	clock_get_uptime(&ns);
+	if (pid1_wide) {
+		second = &stderr_log_pid1_second;
+		count = &stderr_log_pid1_count;
+		dropped = &stderr_log_pid1_dropped;
+		limit = (ns / NSEC_PER_SEC >= STDERR_LOG_PID1_UNLIMITED_AFTER_SEC) ?
+		    ~0U : STDERR_LOG_PID1_LINES_PER_SECOND;
+	} else {
+		second = &stderr_log_second;
+		count = &stderr_log_count;
+		dropped = &stderr_log_dropped;
+		limit = STDERR_LOG_LINES_PER_SECOND;
+	}
+	if (ns - *second >= NSEC_PER_SEC) {
+		if (*dropped != 0) {
+			if (pid1_wide) {
+				printf("stderr-log: %u pid-1 lines dropped in the last second\n", *dropped);
+			} else {
+				printf("stderr-log: %u lines dropped in the last second\n", *dropped);
+			}
+			*dropped = 0;
+		}
+		*second = ns;
+		*count = 0;
+	}
+	if (*count >= limit) {
+		(*dropped)++;
+		return;
+	}
+
+	char line[STDERR_LOG_LINE_BYTES];
+	size_t bytes = nbyte < sizeof(line) ? (size_t)nbyte : sizeof(line);
+	if (copyin(buf, line, bytes) != 0) {
+		return;         /* a bad user buffer is the syscall's business, not ours */
+	}
+	(*count)++;
+	if (fd == 1 || fd == 2) {
+		printf("stderr[%d %s fd%d]: %.*s\n", pid, p->p_comm, fd, (int)bytes, line);
+	} else {
+		char desc[STDERR_LOG_PATH_BYTES];
+		stderr_log_fd_desc(p, fd, desc, sizeof(desc));
+		printf("pid1w[fd%d %s]: %.*s\n", fd, desc, (int)bytes, line);
+	}
+}
+#else
+#define stderr_log_write(p, fd, buf, nbyte) do { } while (0)
+#endif /* XNU_TARGET_OS_OSX */
