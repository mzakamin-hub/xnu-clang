+#endif /* XNU_TARGET_OS_OSX */
diff --git a/iokit/Native/IcelandHid/IcelandHidReports.h b/iokit/Native/IcelandHid/IcelandHidReports.h
new file mode 100755
index 0000000000000000000000000000000000000000..c1a201336791008081a0922b39168bd5dcc8964a
--- /dev/null
+++ b/iokit/Native/IcelandHid/IcelandHidReports.h
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland input step 1-2: the one HID device NativeIcelandHid publishes, and its two input reports.
+//   report 1  a keyboard: modifier bits, a reserved byte, six key usages (page 7, 0..0xff); the Num/Caps/Scroll/Compose/Kana LEDs
+//             as output report 1 (taken and counted, nothing is lit)
+//   report 2  consumer keys: four 16-bit usages (page 0x0C, 0..0x3ff). Slot 0 is the PC's ("C <usage>"); slots 1..3 are the
+//             tablet's own keys (volume up, volume down, power)
+// The descriptor is written from the HID 1.11 specification and the HID Usage Tables (pages 0x01, 0x07, 0x08, 0x0C), in the
+// shape of UniXNU-piano 1c11b0d package/PianoKeyboard/HidDescriptors.h's kKeyboardDescriptor (the keyboard collection with
+// its LED output and the consumer collection as an array of usages, which piano's 27.3 login was typed through); here the
+// consumer array has four slots instead of one and the report IDs are 1 and 2.
+#pragma once
+#include <stdint.h>
+#include <pexpert/pexpert.h>
+
+namespace icelandhid {
+
+// 1209:0001 is pid.codes' pair "for private testing", the one the USB console this keyboard is typed through enumerates with
+// (bsd/dev/hakios_iceland_usbcon.c). The pointer device keeps that vendor.
+constexpr uint32_t kVendorId = 0x1209, kProductId = 0x0001;
+
+// The keyboard's vendor (w3-keys). macOS keys a keyboard's layout type by PRODUCT-VENDOR-COUNTRY in
+// /Library/Preferences/com.apple.keyboardtype.plist, and opens Keyboard Setup Assistant for a pair it does not know (the
+// first login run that drew its UI, 15 Nov: "Your iceland device cannot be identified"). The login seed knows "1-1575-0"
+// = 40, QEMU's usb-kbd 0627:0001 (runs/login-seed/RECORD.txt:35, s2-build.sh:17), and not 1-4617-0, so the keyboard answers
+// as vendor 0x0627 (1575) with product 1: no seed change. icehid_vendor=N gives another vendor (4617 = the old 0x1209).
+constexpr uint32_t kSeededKeyboardVendorId = 0x0627;
+
+inline uint32_t
+keyboardVendorId()
+{
+	uint32_t vendor = kSeededKeyboardVendorId;
+	if (PE_parse_boot_argn("icehid_vendor", &vendor, sizeof(vendor)) && (vendor == 0 || vendor > 0xffff)) {
+		vendor = kSeededKeyboardVendorId;
+	}
+	return vendor;
+}
+constexpr uint8_t kReportKeyboard = 1, kReportConsumer = 2;
+constexpr unsigned kKeyboardReportBytes = 9, kConsumerSlots = 4, kConsumerReportBytes = 1 + 2 * kConsumerSlots;
+
+constexpr uint8_t kDescriptor[] = {
+	0x05, 0x01,         // Usage Page (Generic Desktop)
+	0x09, 0x06,         // Usage (Keyboard)
+	0xa1, 0x01,         // Collection (Application)
+	0x85, 0x01,         //   Report ID (1)
+	0x05, 0x07,         //   Usage Page (Keyboard/Keypad)
+	0x19, 0xe0,         //   Usage Minimum (Left Control)
+	0x29, 0xe7,         //   Usage Maximum (Right GUI)
+	0x15, 0x00,         //   Logical Minimum (0)
+	0x25, 0x01,         //   Logical Maximum (1)
+	0x75, 0x01,         //   Report Size (1)
+	0x95, 0x08,         //   Report Count (8)
+	0x81, 0x02,         //   Input (Data, Variable, Absolute): the modifiers
+	0x75, 0x08,         //   Report Size (8)
+	0x95, 0x01,         //   Report Count (1)
+	0x81, 0x01,         //   Input (Constant): reserved
+	0x05, 0x08,         //   Usage Page (LEDs)
+	0x19, 0x01,         //   Usage Minimum (Num Lock)
+	0x29, 0x05,         //   Usage Maximum (Kana)
+	0x75, 0x01,         //   Report Size (1)
+	0x95, 0x05,         //   Report Count (5)
+	0x91, 0x02,         //   Output (Data, Variable, Absolute)
+	0x75, 0x03,         //   Report Size (3)
+	0x95, 0x01,         //   Report Count (1)
+	0x91, 0x01,         //   Output (Constant): padding
+	0x05, 0x07,         //   Usage Page (Keyboard/Keypad)
+	0x19, 0x00,         //   Usage Minimum (0)
+	0x2a, 0xff, 0x00,   //   Usage Maximum (255)
+	0x15, 0x00,         //   Logical Minimum (0)
+	0x26, 0xff, 0x00,   //   Logical Maximum (255)
+	0x75, 0x08,         //   Report Size (8)
+	0x95, 0x06,         //   Report Count (6)
+	0x81, 0x00,         //   Input (Data, Array): the keys
+	0xc0,               // End Collection
+	0x05, 0x0c,         // Usage Page (Consumer)
+	0x09, 0x01,         // Usage (Consumer Control)
+	0xa1, 0x01,         // Collection (Application)
+	0x85, 0x02,         //   Report ID (2)
+	0x19, 0x00,         //   Usage Minimum (0)
+	0x2a, 0xff, 0x03,   //   Usage Maximum (0x3ff)
+	0x15, 0x00,         //   Logical Minimum (0)
+	0x26, 0xff, 0x03,   //   Logical Maximum (0x3ff)
+	0x75, 0x10,         //   Report Size (16)
+	0x95, 0x04,         //   Report Count (4)
+	0x81, 0x00,         //   Input (Data, Array)
+	0xc0,               // End Collection
+};
+
+// Input step 3: a second device, the touch screen as an absolute pointer (icehid_ptr=1, or icetouch=3). macOS has no touch
+// screen interface; this is the shape UniXNU-piano's PianoTouch gives its panel (package/PianoTouch/TouchHid.h at dcfbe72,
+// BSD-2-Clause-Patent: kTouchDescriptorDefault = makeTouchDescriptor(45, false), the bytes below are that descriptor's), which
+// IOHIDEventDriver turns into pointer positions over the display and clicks. No report ID; 7 bytes: the buttons (bit 0 left,
+// 1 right, 2 middle), X and Y as little-endian 16 bits in 0..32767 over the whole display, the wheel and AC Pan as signed
+// bytes (kept in the descriptor as piano has them; always 0 here).
+constexpr uint32_t kPointerProductId = 0x0002;
+constexpr unsigned kPointerReportBytes = 7;
+constexpr uint32_t kPointerMax = 0x7fff;
+
+constexpr uint8_t kPointerDescriptor[] = {
+	0x05, 0x01,         // Usage Page (Generic Desktop)
+	0x09, 0x02,         // Usage (Mouse)
+	0xa1, 0x01,         // Collection (Application)
+	0x09, 0x01,         //   Usage (Pointer)
+	0xa1, 0x00,         //   Collection (Physical)
+	0x05, 0x09,         //     Usage Page (Button)
+	0x19, 0x01,         //     Usage Minimum (1)
+	0x29, 0x03,         //     Usage Maximum (3)
+	0x15, 0x00,         //     Logical Minimum (0)
+	0x25, 0x01,         //     Logical Maximum (1)
+	0x75, 0x01,         //     Report Size (1)
+	0x95, 0x03,         //     Report Count (3)
+	0x81, 0x02,         //     Input (Data, Variable, Absolute): the buttons
+	0x75, 0x05,         //     Report Size (5)
+	0x95, 0x01,         //     Report Count (1)
+	0x81, 0x01,         //     Input (Constant): padding
+	0x05, 0x01,         //     Usage Page (Generic Desktop)
+	0x09, 0x30,         //     Usage (X)
+	0x09, 0x31,         //     Usage (Y)
+	0x15, 0x00,         //     Logical Minimum (0)
+	0x26, 0xff, 0x7f,   //     Logical Maximum (32767)
+	0x35, 0x00,         //     Physical Minimum (0)
+	0x46, 0xff, 0x7f,   //     Physical Maximum (32767): = logical, positions have no resolution
+	0x75, 0x10,         //     Report Size (16)
+	0x95, 0x02,         //     Report Count (2)
+	0x81, 0x02,         //     Input (Data, Variable, Absolute)
+	0x09, 0x38,         //     Usage (Wheel)
+	0x15, 0x81,         //     Logical Minimum (-127)
+	0x25, 0x7f,         //     Logical Maximum (127)
+	0x36, 0xfa, 0xf4,   //     Physical Minimum (-2822)
+	0x46, 0x06, 0x0b,   //     Physical Maximum (2822): 45 counts an inch
+	0x65, 0x13,         //     Unit (inch)
+	0x55, 0x0d,         //     Unit Exponent (-3)
+	0x75, 0x08,         //     Report Size (8)
+	0x95, 0x01,         //     Report Count (1)
+	0x81, 0x06,         //     Input (Data, Variable, Relative)
+	0x05, 0x0c,         //     Usage Page (Consumer)
+	0x0a, 0x38, 0x02,   //     Usage (AC Pan), the wheel's extents
+	0x75, 0x08,         //     Report Size (8)
+	0x95, 0x01,         //     Report Count (1)
+	0x81, 0x06,         //     Input (Data, Variable, Relative)
+	0xc0,               //   End Collection
+	0xc0,               // End Collection
+};
+
+// Input step 4 (w4-touch, icetouch_dig=1): the touch screen as what it is, a HID digitizer, in place of the pointer device
+// (never both: the owner's rule). macOS 27.3 has a touch screen interface (WindowServer's WSHIDDisplayEventListener takes a
+// digitizer service whose "displayUUID" names a display), and IOHIDEventDriver makes digitizer events of a Touch Screen
+// collection. The shape is UniXNU ShengHidInput 1140614 NativeHidInput.cpp:51-64's report 3 (BSD-2-Clause-Patent), which
+// sheng's macOS 27.3 runs on; written here from the HID Usage Tables (page 0x0D: Touch Screen 0x04, Finger 0x22, Tip Switch
+// 0x42, Touch Valid 0x47, Contact Identifier 0x51, Contact Count 0x54), without a report ID (the device has this one report).
+// 61 bytes: ten fingers of 6 bytes (bit 0 Tip Switch, bit 1 Touch Valid, 6 bits padding; the contact identifier; X and Y
+// as little-endian 16 bits in 0..32767 over the whole display), then the contact count. Touch Valid is the finger's
+// confidence: IOHIDEventDriver makes a hand (a palm) of a finger without it (sheng's note), so a finger sends 1 down and
+// lifting. A contact's identifier is its slot + 1, so the unused entries' 0 names no finger.
+constexpr uint32_t kTouchProductId = 0x0003;
+constexpr unsigned kTouchFingers = 10, kTouchFingerBytes = 6, kTouchReportBytes = kTouchFingers * kTouchFingerBytes + 1;
+constexpr uint32_t kTouchMax = 0x7fff;
+
+#define ICELAND_TOUCH_FINGER \
+	0x09, 0x22,         /*   Usage (Finger) */ \
+	0xa1, 0x02,         /*   Collection (Logical) */ \
+	0x09, 0x42,         /*     Usage (Tip Switch) */ \
+	0x15, 0x00,         /*     Logical Minimum (0) */ \
+	0x25, 0x01,         /*     Logical Maximum (1) */ \
+	0x75, 0x01,         /*     Report Size (1) */ \
+	0x95, 0x01,         /*     Report Count (1) */ \
+	0x81, 0x02,         /*     Input (Data, Variable, Absolute) */ \
+	0x09, 0x47,         /*     Usage (Touch Valid) */ \
+	0x81, 0x02,         /*     Input (Data, Variable, Absolute) */ \
+	0x75, 0x06,         /*     Report Size (6) */ \
+	0x95, 0x01,         /*     Report Count (1) */ \
+	0x81, 0x03,         /*     Input (Constant): padding */ \
+	0x09, 0x51,         /*     Usage (Contact Identifier) */ \
+	0x75, 0x08,         /*     Report Size (8) */ \
+	0x95, 0x01,         /*     Report Count (1) */ \
+	0x26, 0xff, 0x00,   /*     Logical Maximum (255) */ \
+	0x81, 0x02,         /*     Input (Data, Variable, Absolute) */ \
+	0x05, 0x01,         /*     Usage Page (Generic Desktop) */ \
+	0x09, 0x30,         /*     Usage (X) */ \
+	0x26, 0xff, 0x7f,   /*     Logical Maximum (32767) */ \
+	0x75, 0x10,         /*     Report Size (16) */ \
+	0x95, 0x01,         /*     Report Count (1) */ \
+	0x81, 0x02,         /*     Input (Data, Variable, Absolute) */ \
+	0x09, 0x31,         /*     Usage (Y) */ \
+	0x81, 0x02,         /*     Input (Data, Variable, Absolute) */ \
+	0x05, 0x0d,         /*     Usage Page (Digitizer) */ \
+	0xc0,               /*   End Collection */
+
+constexpr uint8_t kTouchDescriptor[] = {
+	0x05, 0x0d,         // Usage Page (Digitizer)
+	0x09, 0x04,         // Usage (Touch Screen)
+	0xa1, 0x01,         // Collection (Application)
+	ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER
+	ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER ICELAND_TOUCH_FINGER
+	0x09, 0x54,         //   Usage (Contact Count)
+	0x75, 0x08,         //   Report Size (8)
+	0x95, 0x01,         //   Report Count (1)
+	0x15, 0x00,         //   Logical Minimum (0)
+	0x26, 0xff, 0x00,   //   Logical Maximum (255)
+	0x81, 0x02,         //   Input (Data, Variable, Absolute)
+	0xc0,               // End Collection
+};
+#undef ICELAND_TOUCH_FINGER
+
+// w4-sensors (icehid_sns=1): a fourth device, the motion sensor. macOS has no sensor of its own here (the Pad's are behind
+// the audio DSP's hub, bsd/dev/hakios_iceland_sensors.c), so this is the Sensor page's own shape of two of the hub's
+// readings: the accelerometer's three axes and which edge of the Pad is up, as the three tilt angles. Written here from the
+// HID Usage Tables (page 0x20: Motion: Accelerometer 3D 0x73 as the collection's usage, Data: Motion: Acceleration Axis X/Y/Z 0x0453 to
+// 0x0455, Data: Orientation: Tilt X/Y/Z 0x047F to 0x0481), with unit exponent -3 on the axes (a raw count is a milli-g) and
+// 0 on the tilts (a raw count is a degree). No report ID; 12 bytes, little endian: ax, ay, az (milli-g, 1 g = 1000), then
+// tiltX, tiltY, tiltZ (degrees).
+constexpr uint32_t kSensorProductId = 0x0004;
+constexpr unsigned kSensorReportBytes = 12;
+
+// The input report above, as the report thread fills it: the same 12 bytes in the machine's order (little endian).
+struct SensorReport {
+	int16_t ax, ay, az;                // milli-g
+	int16_t tiltX, tiltY, tiltZ;       // degrees
+};
+static_assert(sizeof(SensorReport) == kSensorReportBytes, "the descriptor's 12 bytes");
+
+constexpr uint8_t kSensorDescriptor[] = {
+	0x05, 0x20,         // Usage Page (Sensor)
+	0x0a, 0x73, 0x00,   // Usage (0x73: Motion: Accelerometer 3D; not 0x8A, a MacBook's lid angle sensor)
+	0xa1, 0x01,         // Collection (Application)
+	0x0a, 0x53, 0x04,   //   Usage (0x0453: Data: Motion: Acceleration Axis X)
+	0x0a, 0x54, 0x04,   //   Usage (0x0454: Data: Motion: Acceleration Axis Y)
+	0x0a, 0x55, 0x04,   //   Usage (0x0455: Data: Motion: Acceleration Axis Z)
+	0x16, 0x00, 0x80,   //   Logical Minimum (-32768)
+	0x26, 0xff, 0x7f,   //   Logical Maximum (32767)
+	0x75, 0x10,         //   Report Size (16)
+	0x95, 0x03,         //   Report Count (3)
+	0x55, 0x0d,         //   Unit Exponent (-3): a raw count is a milli-g
+	0x81, 0x02,         //   Input (Data, Variable, Absolute): the three axes
+	0x0a, 0x7f, 0x04,   //   Usage (0x047F: Data: Orientation: Tilt X)
+	0x0a, 0x80, 0x04,   //   Usage (0x0480: Data: Orientation: Tilt Y)
+	0x0a, 0x81, 0x04,   //   Usage (0x0481: Data: Orientation: Tilt Z)
+	0x55, 0x00,         //   Unit Exponent (0): a raw count is a degree
+	0x95, 0x03,         //   Report Count (3)
+	0x81, 0x02,         //   Input (Data, Variable, Absolute): the three tilts
+	0xc0,               // End Collection
+};
+
+}  // namespace icelandhid
diff --git a/iokit/Native/IcelandHid/NativeIcelandHid.cpp b/iokit/Native/IcelandHid/NativeIcelandHid.cpp
