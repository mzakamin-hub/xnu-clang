+
+/*
+ * gains1 (P6, 21 Nov): the memory telemetry's GPU-client row (osfmk/arm64/hakios_memtel.c, icemem=): every live
+ * connection's buffers -- owned (kernel-allocated, wired) and imported (the client's pages, wired by prepare()) --
+ * summed per process, the six largest said, with the totals. Every AGX byte is wired (piano gpu-userspace.md:956:
+ * ~2.3 of 5.8 GiB wired at its first desktop was GPU), so this is the prime suspect row for the login burst's spike.
+ * agx_clients_lock, then each connection's lock_ TRIED (the order stop() uses); a connection busy in its own lock is
+ * counted as busy, not waited for. No state of its own.
+ */
+void
+AGXDeviceUserClient::memRow(uint64_t t)
+{
+	enum { kTop = 6 };
+	struct {
+		char name[20];
+		int pid;
+		uint64_t own, imp;
+		uint32_t bos;
+	} top[kTop];
+	uint64_t own_all = 0, imp_all = 0;
+	uint32_t clients = 0, busy = 0;
+	char line[512];
+	int at = 0;
+
+	bzero(top, sizeof(top));
+	if (agx_clients_lock == NULL) {
+		return;
+	}
+	IOLockLock(agx_clients_lock);
+	for (AGXDeviceUserClient * c = agx_clients; c != NULL; c = c->link_) {
+		uint64_t own = 0, imp = 0;
+		uint32_t bos = 0;
+
+		clients++;
+		if (!IOLockTryLock(c->lock_)) {
+			busy++;
+			continue;
+		}
+		for (uint32_t i = 0; i < c->cap_; i++) {
+			if (c->bos_[i].handle == 0 || c->bos_[i].memory == NULL) {
+				continue;
+			}
+			bos++;
+			if (c->bos_[i].imported) {
+				imp += c->bos_[i].bytes;
+			} else {
+				own += c->bos_[i].bytes;
+			}
+		}
+		IOLockUnlock(c->lock_);
+		own_all += own;
+		imp_all += imp;
+		for (int k = 0; k < kTop; k++) {
+			if (own + imp > top[k].own + top[k].imp) {
+				memmove(&top[k + 1], &top[k], (kTop - 1 - k) * sizeof(top[0]));
+				strlcpy(top[k].name, c->name_, sizeof(top[k].name));
+				top[k].pid = c->pid_;
+				top[k].own = own;
+				top[k].imp = imp;
+				top[k].bos = bos;
+				break;
+			}
+		}
+	}
+	IOLockUnlock(agx_clients_lock);
+	if (clients == 0) {
+		return;
+	}
+	for (int k = 0; k < kTop && top[k].own + top[k].imp != 0 && at < (int)sizeof(line) - 80; k++) {
+		at += snprintf(line + at, sizeof(line) - at, "%s%s(%d) %llu+%llu/%u", k ? ", " : "", top[k].name, top[k].pid,
+		    top[k].own >> 20, top[k].imp >> 20, top[k].bos);
+	}
+	if (at == 0) {
+		strlcpy(line, "none holds buffers", sizeof(line));
+	}
+	IOLog("icemem: t=%llu gpu clients %u (%u busy), own %llu MB + imported %llu MB; by process MB own+imported/bos: %s\n", t,
+	    clients, busy, own_all >> 20, imp_all >> 20, line);
+}
+
+extern "C" void agx_mem_row(uint64_t t);
+extern "C" void
+agx_mem_row(uint64_t t)
+{
+	AGXDeviceUserClient::memRow(t);
+}
+
+/*
+ * render1 (21 Nov), icerender=<s> (osfmk/arm64/hakios_memtel.c calls this every s seconds): one row per GPU client that
+ * submitted or waited since the last row -- submissions and IBs, the time the submissions spent walking page attributes
+ * (total, longest one, pages a submission), the fence waits (count, mean, the share that came by the 10 ms re-check),
+ * the buffers (owned with a CPU view / owned / imported, MB) and the largest one with its metadata text -- and one
+ * summary row. The question: where a frame's time goes in the kernel for WindowServer and the clients that draw.
+ * agx_clients_lock, then each lock_ TRIED, as memRow. No state outside the connections.
+ */
+void
+AGXDeviceUserClient::renderRows(void)
+{
+	uint32_t clients = 0, quiet = 0, busy = 0;
+
+	if (agx_clients_lock == NULL) {
+		return;
+	}
+	IOLockLock(agx_clients_lock);
+	for (AGXDeviceUserClient * c = agx_clients; c != NULL; c = c->link_) {
+		uint64_t own = 0, imp = 0, viewed = 0, big = 0, look_us = 0, max_us = 0, wait_us = 0;
+		uint32_t bos = 0, views = 0, subs, waits, longw, ibs;
+		char meta[24] = "";
+
+		clients++;
+		if (!IOLockTryLock(c->lock_)) {
+			busy++;
+			continue;
+		}
+		subs = c->submits_ - c->rSubs_;
+		ibs = (uint32_t)c->ibs_ - c->rIbs_;
+		waits = c->waits_ - c->rWaits_;
+		longw = c->waitsLong_ - c->rWaitsLong_;
+		absolutetime_to_nanoseconds(c->look_ - c->rLook_, &look_us);
+		absolutetime_to_nanoseconds(c->lookMax_, &max_us);
+		absolutetime_to_nanoseconds(c->waitAbs_ - c->rWaitAbs_, &wait_us);
+		look_us /= 1000;
+		max_us /= 1000;
+		wait_us /= 1000;
+		const uint64_t pages = c->pagesWin_;
+		c->rSubs_ = c->submits_;
+		c->rIbs_ = (uint32_t)c->ibs_;
+		c->rWaits_ = c->waits_;
+		c->rWaitsLong_ = c->waitsLong_;
+		c->rLook_ = c->look_;
+		c->rWaitAbs_ = c->waitAbs_;
+		c->lookMax_ = 0;
+		c->pagesWin_ = 0;
+		for (uint32_t i = 0; i < c->cap_; i++) {
+			const AGXBo * b = &c->bos_[i];
+
+			if (b->handle == 0 || b->memory == NULL) {
+				continue;
+			}
+			bos++;
+			if (b->imported) {
+				imp += b->bytes;
+			} else {
+				own += b->bytes;
+				if (b->view != NULL) {
+					views++;
+					viewed += b->bytes;
+				}
+			}
+			if (b->bytes > big) {
+				big = b->bytes;
+				snprintf(meta, sizeof(meta), "%.*s", (int)(b->meta_bytes < sizeof(meta) - 1 ? b->meta_bytes :
+				    sizeof(meta) - 1), b->meta);
+				for (char * m = meta; *m != 0; m++) {
+					*m = (*m < 0x20 || *m > 0x7e) ? '.' : *m;
+				}
+			}
+		}
+		const uint32_t missed = c->missed_, audits = c->audits_;
+		const uint32_t mode = c->wcscan_;
+		IOLockUnlock(c->lock_);
+		/* (name_ and pid_ are set once at birth; the connection stays linked while agx_clients_lock is held) */
+		if (subs != 0 || waits != 0) {
+			IOLog("icerender: agx %s(%d): %u subs %u IBs; walk %llu us (max %llu, %llu pages a sub%s, audits %u missed %u); "
+			    "waits %u (%llu us mean, %u >= 9 ms)\n", c->name_, c->pid_, subs, ibs, look_us, max_us,
+			    subs ? pages / subs : 0, mode == 1 ? ", viewed only" : mode == 2 ? ", per-BO state" : "", audits, missed,
+			    waits, waits ? wait_us / waits : 0, longw);
+		} else {
+			quiet++;
+		}
+		/* the buffers of a client that drew, and of a quiet one that holds 32 MB or more (the RAM question) */
+		if (subs != 0 || waits != 0 || own + imp >= (32ull << 20)) {
+			IOLog("icerender: agx %s(%d): bos %u: viewed %u = %llu MB of own %llu MB, imported %llu MB; largest %llu KB "
+			    "'%s'\n", c->name_, c->pid_, bos, views, viewed >> 20, own >> 20, imp >> 20, big >> 10, meta);
+		}
+	}
+	IOLockUnlock(agx_clients_lock);
+	if (clients != 0) {
+		IOLog("icerender: agx clients %u: %u quiet, %u busy (not read)\n", clients, quiet, busy);
+	}
+}
+
+extern "C" void agx_render_rows(void);
+extern "C" void
+agx_render_rows(void)
+{
+	AGXDeviceUserClient::renderRows();
+}
+
+AGXDeviceUserClient *
+AGXDeviceUserClient::make(task_t task, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	AGXDeviceUserClient * uc = new AGXDeviceUserClient;
+
+	if (uc != NULL && !uc->initWithTask(task, securityID, type, properties)) {
+		OSSafeReleaseNULL(uc);
+	}
+	return uc;
+}
+
+/*
+ * The connection's GPU: the A840's when its API serves, the stand-in for the self-test's own kernel connections under
+ * iceagx_selftest=3, else none (the skeleton). A GPU space each (the kit has 32 on macOS, ASID 2..33); none free: refused busy, as
+ * Adreno740's mount (NativeAdrenoPublish.cpp:464-531, 1224) and piano's slots (gpu-userspace.md:226).
+ */
+IOReturn
+AGXDeviceUserClient::mount(void)
+{
+	IOReturn r = kIOReturnSuccess;
+
+	if (agx_clients_lock_get() == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(agx_clients_lock);
+	if (agx_a840.up()) {
+		gpu_ = &agx_a840;
+	} else if (agx_soft_on && task_ == kernel_task) {
+		gpu_ = &agx_softgpu;
+	}
+	if (gpu_ != NULL) {
+		if (agx_stopping) {
+			r = kIOReturnNotReady;
+		} else if (gpu_->space_create(&space_) != 0) {
+			r = kIOReturnBusy;
+		} else {
+			bos_ = IONewZero(AGXBo, 64);
+			cap_ = bos_ != NULL ? 64 : 0;
+			if (bos_ == NULL) {
+				gpu_->space_destroy(space_);
+				r = kIOReturnNoMemory;
+			}
+		}
+		if (r == kIOReturnSuccess) {
+			next_ = 1;
+			queues_ = 1;
+			live_ = true;
+			link_ = agx_clients;
+			agx_clients = this;
+		}
+	}
+	IOLockUnlock(agx_clients_lock);
+	return r;
+}
+
+uint64_t
+AGXDeviceUserClient::maxBytes(void)
+{
+	uint32_t chip;
+	uint64_t base, trap, start, size;
+
+	gpu_->facts(&chip, &base, &trap, &start, &size);
+	/* the window, as UniXNU (NativeAdrenoUserClient.h:53-54), at most 4 GiB less a page (piano gpu-userspace.md:760) */
+	return size < 0xfffff000ull ? size : 0xfffff000ull;
+}
+
+AGXBo *
+AGXDeviceUserClient::find(uint64_t handle)
+{
+	for (uint32_t i = 0; handle != 0 && i < cap_; i++) {
+		if (bos_[i].handle == handle) {
+			return &bos_[i];
+		}
+	}
+	return NULL;
+}
+
+/* a free slot, the table grown when full (lock_ held) */
+AGXBo *
+AGXDeviceUserClient::slot(void)
+{
+	for (uint32_t i = 0; i < cap_; i++) {
+		if (bos_[i].handle == 0) {
+			return &bos_[i];
+		}
+	}
+	if (cap_ >= 0x100000) {
+		return NULL;
+	}
+	AGXBo * made = IONewZero(AGXBo, 2 * cap_);
+	if (made == NULL) {
+		return NULL;
+	}
+	memcpy(made, bos_, cap_ * sizeof(AGXBo));
+	IODelete(bos_, AGXBo, cap_);
+	bos_ = made;
+	cap_ *= 2;
+	return &bos_[cap_ / 2];
+}
+
+/* this connection's views of one buffer taken down (Adreno740 NativeAdrenoPublish.cpp:532-555; never with lock_ held) */
+void
+AGXDeviceUserClient::dropViews(IOMemoryDescriptor * memory)
+{
+	IOMemoryMap * map;
+
+	while ((map = removeMappingForDescriptor(memory)) != NULL) {
+		map->release();
+	}
+}
+
+/*
+ * A buffer's memory given back (never with lock_ held; the GPU no longer maps it): its CPU view's mappings in this
+ * connection taken down first. If a mapping of the view is still alive elsewhere (a reference the view holds for each
+ * IOMemoryMap), the pages are kept for good rather than freed under a PTE (Adreno740 NativeAdrenoPublish.cpp:388-395).
+ * An owned buffer's pages then get the default attribute back while still wired (c0e3199 NativeAdrenoMemory.cpp:244-249),
+ * their lines are cleaned and invalidated through the now cacheable kernel mapping, and only then are they unwired and
+ * released (:258-268).
+ */
+bool
+AGXDeviceUserClient::releaseBo(IOMemoryDescriptor * memory, IOMemoryDescriptor * view, uint64_t bytes, bool owned)
+{
+	if (view != NULL) {
+		dropViews(view);
+		if (view != memory && view->getRetainCount() > 1) {
+			IOLog("agx: %s: a CPU view of %llu bytes is still mapped: its pages are kept\n", name_, bytes);
+			return false;
+		}
+		view->release();
+	}
+	if (owned && agx_wc_explicit()) {
+		IOBufferMemoryDescriptor * b = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+
+		(void)agx_bo_attr(memory, round_page_64(bytes), VM_WIMG_USE_DEFAULT, false);
+		if (b != NULL && b->getBytesNoCopy() != NULL) {
+			agx_push(b->getBytesNoCopy(), (size_t)round_page_64(bytes));   /* (no line of it outlives it) */
+		}
+	}
+	memory->complete();
+	memory->release();
+	return true;
+}
+
+/*
+ * Every buffer out of the GPU's space and the space given back (lock_ held): after this connection's last fence, waited up
+ * to 2 s when `wait`. A fence that never comes (a hang) leaves the buffers mapped and wired and the space kept: nothing the
+ * GPU may still touch goes back to the VM (Adreno740 clientClose, NativeAdrenoPublish.cpp:577-583).
+ */
+void
+AGXDeviceUserClient::unmapAll(bool wait)
+{
+	bool idle;
+
+	if (stopped_ || gpu_ == NULL) {
+		return;
+	}
+	if (made_ != 0 || submits_ != 0) {
+		uint64_t ns = 0;
+
+		/* what the process did with the GPU, once, where the connection gives it back (a close, or the GPU's way down) */
+		absolutetime_to_nanoseconds(look_, &ns);
+		IOLog("agx: %s: used space %u: %u buffers made (%u imported), %u submissions (%llu IBs; %llu us looking at page "
+		    "attributes), last fence %u\n", name_, space_, made_, imports_, submits_, ibs_, ns / 1000, last_);
+	}
+	if (wait && last_ != 0 && !gpu_->done(last_)) {
+		(void)gpu_->wait(last_, 2000);
+	}
+	idle = last_ == 0 || gpu_->done(last_);
+	for (uint32_t i = 0; idle && i < cap_; i++) {
+		if (bos_[i].handle != 0 && bos_[i].iova != 0) {
+			(void)gpu_->unmap(space_, bos_[i].iova, bos_[i].bytes);
+			bos_[i].iova = 0;
+		}
+	}
+	if (idle) {
+		gpu_->space_destroy(space_);
+	} else {
+		IOLog("agx: %s: fence %u never came: its buffers and GPU space are kept\n", name_, last_);
+		for (uint32_t i = 0; i < cap_; i++) {
+			bos_[i].memory = NULL;  /* (leaked on purpose: wired, still in the GPU's tables) */
+			bos_[i].view = NULL;
+			bos_[i].handle = 0;
+		}
+		count_ = 0;
+	}
+	stopped_ = true;
+}
+
+/* the GPU's way down (agx_clients_lock held): this connection gives the GPU back now; its calls answer not ready from here */
+void
+AGXDeviceUserClient::stop(void)
+{
+	IOLockLock(lock_);
+	if (live_ && !closed_) {
+		unmapAll(true);
+	}
+	IOLockUnlock(lock_);
+}
+
+/* the connection's end, once (close, or free without one): its GPU state given back, its buffers released, unlisted */
+bool
+AGXDeviceUserClient::shut(void)
+{
+	AGXBo * gone = NULL;
+	uint32_t n = 0, cap = 0;
+
+	IOLockLock(lock_);
+	if (closed_) {
+		IOLockUnlock(lock_);
+		return false;
+	}
+	closed_ = true;
+	if (live_) {
+		unmapAll(true);
+		cap = cap_;
+		gone = cap != 0 ? IONewZero(AGXBo, cap) : NULL;
+		for (uint32_t i = 0; i < cap_; i++) {
+			if (bos_[i].handle != 0 && bos_[i].memory != NULL && gone != NULL) {
+				gone[n++] = bos_[i];
+			}
+			if (gone != NULL) {
+				bzero(&bos_[i], sizeof(bos_[i]));
+			}
+		}
+		count_ = 0;
+	}
+	IOLockUnlock(lock_);
+	for (uint32_t i = 0; i < n; i++) {
+		(void)releaseBo(gone[i].memory, gone[i].view, gone[i].bytes, !gone[i].imported);
+	}
+	if (gone != NULL) {
+		IODelete(gone, AGXBo, cap);
+	}
+	if (live_) {
+		IOLockLock(agx_clients_lock);
+		for (AGXDeviceUserClient ** at = &agx_clients; *at != NULL; at = &(*at)->link_) {
+			if (*at == this) {
+				*at = link_;
+				break;
+			}
+		}
+		IOLockUnlock(agx_clients_lock);
+	}
+	return true;
+}
+
+IOReturn
+AGXDeviceUserClient::clientClose(void)
+{
+	if (lock_ == NULL || !shut()) {
+		return kIOReturnNotOpen;        /* (a second close: refused, nothing done) */
+	}
+	if (getProvider() != NULL) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+AGXDeviceUserClient::free(void)
+{
+	if (lock_ != NULL) {
+		(void)shut();                   /* (released without a close: given back here) */
+	}
+	if (bos_ != NULL) {
+		/* (closed: every slot is empty; never opened past mount: nothing was made) */
+		IODelete(bos_, AGXBo, cap_);
+		bos_ = NULL;
+	}
+	if (lock_ != NULL) {
+		IOLockFree(lock_);
+		lock_ = NULL;
+	}
+	IOUserClient::free();
+}
+
+/* a CPU-map token's buffer for IOConnectMapMemory64 (and its unmap): only while a BoCpuMap lease is held */
+IOReturn
+AGXDeviceUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	IOReturn r = kIOReturnNotFound;
+
+	if (memory == NULL || options == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*memory = NULL;
+	if (!live_) {
+		return kIOReturnUnsupported;
+	}
+	IOLockLock(lock_);
+	if (closed_) {
+		r = kIOReturnNotReady;
+	} else if (type != 0 && type <= cap_ && bos_[type - 1].handle != 0 && !bos_[type - 1].imported &&
+	    bos_[type - 1].leases != 0 && bos_[type - 1].view != NULL) {
+		/* the CPU view (made at BoCpuMap), one descriptor per token so that an unmap finds its mapping (kIOMapReference) */
+		agx_bo_view_event(&bos_[type - 1]);     /* render1: a mapping of the view is coming */
+		bos_[type - 1].view->retain();
+		*memory = bos_[type - 1].view;
+		*options = 0;                   /* the view's own mode, write-combined (any other is made so: AGXBoView) */
+		r = kIOReturnSuccess;
+	}
+	IOLockUnlock(lock_);
+	return r;
+}
+
+IOReturn
+AGXDeviceUserClient::run(uint32_t method, const void * in, uint32_t inSize, void * out, uint32_t * outSize)
+{
+	if (closed_) {
+		return kIOReturnNotReady;
+	}
+	if (live_) {
+		IOReturn r;
+
+		/* exact records both ways; an unknown method is unsupported (NativeAdrenoUserClient.cpp:562-565) */
+		if (method < 1 || method > kAGXMethods) {
+			return kIOReturnUnsupported;
+		}
+		if (inSize != agx_in[method] || *outSize != agx_out[method] || (agx_in[method] != 0 && in == NULL) ||
+		    (agx_out[method] != 0 && out == NULL)) {
+			return kIOReturnBadArgument;
+		}
+		r = live(method, in, out);
+		if (r == kIOReturnSuccess) {
+			*outSize = agx_out[method];
+		}
+		return r;
+	}
+	/* no GPU: g6b-0's skeleton, unchanged */
+	if (method < 1 || method > kAGXMethods || inSize != agx_in[method] || *outSize < agx_out[method] ||
+	    (agx_in[method] != 0 && in == NULL) || (agx_out[method] != 0 && out == NULL)) {
+		return kIOReturnBadArgument;
+	}
+	if (method == mQuery) {
+		AGXAbiParams p = { .abi_version = kAGXAbiVersion, .input_bits = 48, .output_bits = 36, .flags = 0,
+			           .max_bo_bytes = 256ULL << 20 };
+
+		memcpy(out, &p, sizeof(p));
+		*outSize = sizeof(p);
+		IOLog("agx: %s: Query: ABI v2 (skeleton)\n", name_);
+		return kIOReturnSuccess;
+	}
+	if (!(refused_ & (1u << method))) {
+		refused_ |= 1u << method;
+		IOLog("agx: %s: method %u refused (skeleton)\n", name_, method);
+	}
+	return kIOReturnUnsupported;
+}
+
+/*
+ * The methods over the GPU half (in and out are exact records, checked). Answers as Adreno740's NativeAdrenoUserClient
+ * (a8fa18f .cpp:203-784) and as Turnip's darwin backend reads them (UniXNU 9248bdac patches/mesa/turnip-darwin-kmd.patch).
+ */
+IOReturn
+AGXDeviceUserClient::live(uint32_t method, const void * in, void * out)
+{
+	IOReturn r = kIOReturnSuccess;
+	AGXBo * bo;
+
+	switch (method) {
+	case mQuery: {
+		/* the space's input range is the SMMU bank's 39 bits, its output 36 (hakios_iceland_gpu.c TCR_39 / TCR2_36) */
+		AGXAbiParams p = { kAGXAbiVersion, 39, 36, kAGXParamsHostImport, maxBytes() };
+
+		memcpy(out, &p, sizeof(p));
+		return kIOReturnSuccess;
+	}
+	case mGetDeviceInfo: {
+		AGXAbiDeviceInfo d;
+
+		bzero(&d, sizeof(d));
+		gpu_->facts(&d.chip_id, &d.gmem_base, &d.uche_trap_base, &d.va_start, &d.va_size);
+		/* Linux a2e1ea44d3c3: GMEM 18 MiB (a8xx_catalog.c:1062-1069); kaanapali's UBWC 6.0, highest bank bit 16
+		 * (drivers/soc/qcom/ubwc_config.c:81-83, 123); swizzle levels 2+3 and the 8-channel macrotile, as Fedora's msm
+		 * reports them (the kit's GET_PARAM answers, hakios_iceland_gpu.c ice_gpu_parameter) */
+		d.gmem_bytes = 18u << 20;
+		d.highest_bank_bit = 16;
+		d.ubwc_swizzle = 6;
+		d.macrotile_mode = 1;
+		d.ubwc_version = 6;
+		d.flags = kAGXDeviceClientIova;
+		if (d.chip_id == 0) {
+			return kIOReturnNotReady;
+		}
+		memcpy(out, &d, sizeof(d));
+		return kIOReturnSuccess;
+	}
+	case mGetStatus:
+		/* no fault or suspend counter in the kit yet (its interrupt mask is the fences' only): "no counters", which Turnip
+		 * accepts (turnip-darwin-kmd.patch :1745; piano gpu-userspace.md:190) */
+		return kIOReturnUnsupported;
+	case mSetMetadata: {
+		const AGXAbiMetadata * m = (const AGXAbiMetadata *)in;
+		char line[65];
+		uint32_t n = m->bytes < 64 ? m->bytes : 64;
+
+		/* the userland GPU test reports its result this way, text first, handle second (AdrenoMetal c1351337
+		 * NativeAdrenoUserTest.h:104-113, Adreno740 NativeAdrenoPublish.cpp:755-764): the first 16 lines go to the log */
+		if (said_ < 16) {
+			said_++;
+			for (uint32_t i = 0; i < n; i++) {
+				line[i] = m->text[i] >= 0x20 && m->text[i] < 0x7f ? m->text[i] : '.';
+			}
+			line[n] = 0;
+			IOLog("agx: %s says \"%s\"\n", name_, line);
+		}
+		break;
+	}
+	case mSetPriority: {
+		const AGXAbiPriority * p = (const AGXAbiPriority *)in;
+
+		/* MTLGPUPriority 0..5, 3 (disabled) refused in the foreground (NativeAdrenoUserClient.cpp:397-400); one ring here */
+		if (p->foreground > 5 || p->background > 5 || p->foreground == 3) {
+			return kIOReturnBadArgument;
+		}
+		break;
+	}
+	case mNote: {
+		const AGXAbiNote * note = (const AGXAbiNote *)in;
+
+		if ((note->kind != 1 && note->kind != 2) || note->count > 30) {
+			return kIOReturnBadArgument;
+		}
+		OSIncrementAtomic((volatile SInt32 *)&notes_);
+		return kIOReturnSuccess;
+	}
+	case mBoAlloc: {
+		const AGXAbiBoAlloc * a = (const AGXAbiBoAlloc *)in;
+		IOBufferMemoryDescriptor * md;
+
+		if (a->bytes == 0 || (a->bytes & 4095) || a->bytes > maxBytes() || a->align_log2 < 12 || a->align_log2 > 24 ||
+		    a->contiguous > 1) {
+			return kIOReturnBadArgument;
+		}
+		if (a->contiguous) {
+			return kIOReturnUnsupported;    /* (one physical span: not offered; Turnip asks contiguous 0, kmd patch :1093) */
+		}
+		/* made before the lock (Adreno740 NativeAdrenoPublish.cpp:840-842): wired kernel memory, default-cacheable, below the
+		 * SMMU's 36-bit output, zeroed, its lines cleaned and invalidated, then write-combined before anything else maps it
+		 * (c0e3199 NativeAdrenoMemory.cpp:127-152, :228-237; the attribute: above AGXBo) */
+		if (!agx_wc_explicit()) {
+			/* iceagx_wc=0: g6b-1's (c114a2b): pageable write-combined memory, zeroed through a passing kernel view */
+			IOMemoryMap * passing = NULL;
+
+			md = IOBufferMemoryDescriptor::inTaskWithOptions(NULL, kIODirectionInOut | kIOMemoryPageable |
+			    kIOMapWriteCombineCache, (vm_size_t)round_page_64(a->bytes), PAGE_SIZE);
+			if (md != NULL && md->prepare() != kIOReturnSuccess) {
+				OSSafeReleaseNULL(md);
+			}
+			if (md != NULL && (passing = md->map(kIOMapAnywhere | kIOMapDefaultCache)) == NULL) {
+				md->complete();
+				OSSafeReleaseNULL(md);
+			}
+			if (md == NULL) {
+				return kIOReturnNoMemory;
+			}
+			bzero((void *)passing->getVirtualAddress(), (size_t)round_page_64(a->bytes));
+			agx_push((const void *)passing->getVirtualAddress(), (size_t)round_page_64(a->bytes));
+			passing->release();
+		} else {
+			md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, kIODirectionInOut | kIOMemoryMapperNone,
+			    (vm_size_t)round_page_64(a->bytes), ((1ull << 36) - 1) & ~(uint64_t)PAGE_MASK);
+			if (md != NULL && md->prepare() != kIOReturnSuccess) {
+				OSSafeReleaseNULL(md);
+			}
+			if (md == NULL || md->getBytesNoCopy() == NULL) {
+				if (md != NULL) {
+					md->complete();
+					md->release();
+				}
+				return kIOReturnNoMemory;
+			}
+			bzero(md->getBytesNoCopy(), (size_t)round_page_64(a->bytes));
+			agx_push(md->getBytesNoCopy(), (size_t)round_page_64(a->bytes));
+			(void)agx_bo_attr(md, round_page_64(a->bytes), VM_WIMG_WCOMB, false);
+		}
+		IOLockLock(lock_);
+		bo = closed_ || stopped_ ? NULL : slot();
+		if (bo != NULL) {
+			bo->handle = next_++;
+			bo->bytes = a->bytes;
+			bo->memory = md;
+			count_++;
+			made_++;
+			((AGXAbiHandle *)out)->handle = bo->handle;
+		}
+		IOLockUnlock(lock_);
+		if (bo == NULL) {
+			(void)releaseBo(md, NULL, a->bytes, true);
+			return closed_ || stopped_ ? kIOReturnNotReady : kIOReturnNoMemory;
+		}
+		return kIOReturnSuccess;
+	}
+	case mBoImport: {
+		const AGXAbiBoImport * i = (const AGXAbiBoImport *)in;
+		mach_vm_address_t start = trunc_page_64(i->address), end = round_page_64(i->address + i->bytes);
+		IOMemoryDescriptor * md;
+		bool read_only = false;
+
+		if (i->address == 0 || ((i->address | i->bytes) & 4095) || i->bytes == 0 || i->bytes > maxBytes() ||
+		    end <= start) {
+			return kIOReturnBadArgument;
+		}
+		/* the owning task's own pages (RedwoodGPU.cpp hostBuffer's way; NativeAdrenoABI.h:56-62); read-only ones read only */
+		md = agx_import_range(start, end - start, kIODirectionInOut, task_);
+		if (md != NULL && md->prepare() != kIOReturnSuccess) {
+			OSSafeReleaseNULL(md);
+			md = agx_import_range(start, end - start, kIODirectionOut, task_);
+			read_only = true;
+			if (md != NULL && md->prepare() != kIOReturnSuccess) {
+				OSSafeReleaseNULL(md);
+			}
+		}
+		if (md == NULL) {
+			return kIOReturnVMError;
+		}
+		IOLockLock(lock_);
+		bo = closed_ || stopped_ ? NULL : slot();
+		if (bo != NULL) {
+			bo->handle = next_++;
+			bo->bytes = i->bytes;
+			bo->from = i->address - start;
+			bo->memory = md;
+			bo->imported = true;
+			bo->read_only = read_only;
+			count_++;
+			made_++;
+			imports_++;
+			((AGXAbiHandle *)out)->handle = bo->handle;
+		}
+		IOLockUnlock(lock_);
+		if (bo == NULL) {
+			md->complete();
+			md->release();
+			return closed_ || stopped_ ? kIOReturnNotReady : kIOReturnNoMemory;
+		}
+		return kIOReturnSuccess;
+	}
+	case mWaitFence: {
+		const AGXAbiWaitFence * w = (const AGXAbiWaitFence *)in;
+		uint32_t f = (uint32_t)w->fence, ms;
+
+		if (w->fence == 0 || w->fence > 0xffffffffull) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(lock_);
+		r = closed_ || stopped_ ? kIOReturnNotReady : last_ == 0 || (int32_t)(f - last_) > 0 ? kIOReturnBadArgument :
+		    kIOReturnSuccess;
+		IOLockUnlock(lock_);
+		if (r != kIOReturnSuccess || gpu_->done(f)) {
+			return r;
+		}
+		/* outside the lock (NativeAdrenoPublish.cpp:770-778); Turnip asks in slices of at most 100 ms (kmd patch :537-543) */
+		ms = w->timeout_ns == 0 ? 0 : w->timeout_ns >= 0xffffffffull * 1000000 ? 0xffffffffu :
+		    (uint32_t)((w->timeout_ns + 999999) / 1000000);
+		{
+			/* render1: how long the client stood here (icerender= rows) */
+			const uint64_t began = mach_absolute_time();
+			const int k = gpu_->wait(f, ms);
+
+			noteWait(mach_absolute_time() - began);
+			if (k == 0) {
+				return kIOReturnSuccess;
+			}
+		}
+		return gpu_->up() ? kIOReturnTimeout : kIOReturnNotReady;
+	}
+	case mGetTimestamp: {
+		uint64_t t = gpu_->up() ? gpu_->ticks() : 0;
+
+		if (t == 0) {
+			return kIOReturnNotReady;
+		}
+		((AGXAbiU64 *)out)->value = t;
+		return kIOReturnSuccess;
+	}
+	default:
+		break;
+	}
+
+	/* the rest: the connection's own objects, under its lock */
+	IOMemoryDescriptor * drop = NULL;
+	IOMemoryDescriptor * freed = NULL, * freedView = NULL;
+	uint64_t freedBytes = 0;
+	bool freedOwned = false;
+
+	IOLockLock(lock_);
+	if (closed_ || (stopped_ && method != mBoFree && method != mBoCpuUnmap)) {
+		IOLockUnlock(lock_);
+		return kIOReturnNotReady;
+	}
+	switch (method) {
+	case mSetMetadata: {
+		const AGXAbiMetadata * m = (const AGXAbiMetadata *)in;
+
+		if (m->reserved != 0 || m->bytes > 64) {
+			r = kIOReturnBadArgument;
+		} else if ((bo = find(m->handle)) == NULL) {
+			r = kIOReturnBadArgument;
+		} else {
+			memcpy(bo->meta, m->text, m->bytes);
+			bo->meta_bytes = m->bytes;
+		}
+		break;
+	}
+	case mGetMetadata: {
+		const AGXAbiMetadata * m = (const AGXAbiMetadata *)in;
+		AGXAbiMetadata reply;
+
+		if (m->reserved != 0 || m->bytes > 64 || (bo = find(m->handle)) == NULL || m->bytes < bo->meta_bytes) {
+			r = kIOReturnBadArgument;
+		} else {
+			bzero(&reply, sizeof(reply));
+			reply.handle = bo->handle;
+			reply.bytes = bo->meta_bytes;
+			memcpy(reply.text, bo->meta, bo->meta_bytes);
+			memcpy(out, &reply, sizeof(reply));
+		}
+		break;
+	}
+	case mSetPriority: {
+		const AGXAbiPriority * p = (const AGXAbiPriority *)in;
+
+		fg_ = (int32_t)p->foreground;
+		bg_ = (int32_t)p->background;
+		break;
+	}
+	case mCreateQueue: {
+		uint32_t q = 1;
+
+		if (((const AGXAbiU64 *)in)->value != 0) {
+			r = kIOReturnBadArgument;
+			break;
+		}
+		while (q < kAGXQueues && (queues_ & (1u << q))) {
+			q++;
+		}
+		if (q == kAGXQueues) {
+			r = kIOReturnNoResources;
+		} else {
+			queues_ |= 1u << q;
+			qfence_[q] = 0;
+			((AGXAbiU64 *)out)->value = q;
+		}
+		break;
+	}
+	case mCloseQueue: {
+		uint64_t q = ((const AGXAbiU64 *)in)->value;
+
+		if (q == 0 || q >= kAGXQueues || !(queues_ & (1u << q))) {
+			r = kIOReturnBadArgument;
+		} else if (qfence_[q] != 0 && !gpu_->done(qfence_[q])) {
+			r = kIOReturnBusy;      /* (a queue is drained by its caller first: NativeAdrenoUserClient.cpp:739-741) */
+		} else {
+			queues_ &= ~(1u << q);
+		}
+		break;
+	}
+	case mBoMap: {
+		const AGXAbiBoMap * m = (const AGXAbiBoMap *)in;
+		uint32_t chip, pages;
+		uint64_t base, trap, start, size, end, * pa;
+		bool ro;
+
+		if (!(m->permissions & 1) || (m->permissions & ~3u) || m->writeback > 1 || (m->shareability != 2 &&
+		    m->shareability != 3) || m->reserved != 0 || (m->iova & 4095)) {
+			r = kIOReturnBadArgument;
+			break;
+		}
+		if ((bo = find(m->handle)) == NULL) {
+			r = kIOReturnBadArgument;
+			break;
+		}
+		if (bo->iova != 0) {
+			r = kIOReturnBusy;
+			break;
+		}
+		gpu_->facts(&chip, &base, &trap, &start, &size);
+		end = m->iova + bo->bytes;
+		if (m->iova < start || end < m->iova || end > start + size) {
+			r = kIOReturnBadArgument;
+			break;
+		}
+		for (uint32_t i = 0; i < cap_ && r == kIOReturnSuccess; i++) {
+			if (bos_[i].handle != 0 && bos_[i].iova != 0 && m->iova < bos_[i].iova + bos_[i].bytes && bos_[i].iova < end) {
+				r = kIOReturnBadArgument;       /* (the client's addresses must not overlap: one PTE each) */
+			}
+		}
+		if (r != kIOReturnSuccess) {
+			break;
+		}
+		pages = (uint32_t)(bo->bytes / 4096);
+		pa = IONewData(uint64_t, pages);
+		if (pa == NULL) {
+			r = kIOReturnNoMemory;
+			break;
+		}
+		for (uint32_t i = 0; i < pages && r == kIOReturnSuccess; i++) {
+			IOByteCount got = 0;
+
+			pa[i] = bo->memory->getPhysicalSegment(bo->from + 4096ull * i, &got, kIOMemoryMapperNone);
+			if (pa[i] == 0 || (pa[i] & 4095) || (pa[i] >> 36) != 0) {
+				r = kIOReturnNoResources;       /* (outside the SMMU's 36-bit output) */
+			}
+		}
+		/* Read-only: what the caller asked, or what an import could only pin for reading. Write-back and shareability are
+		 * checked, not used: every page is the kit's normal non-cacheable PTE (NativeAdrenoUserClient.cpp:329-338). */
+		ro = !(m->permissions & 2) || bo->read_only;
+		if (r == kIOReturnSuccess && gpu_->map(space_, m->iova, pa, pages, ro) != 0) {
+			r = gpu_->up() ? kIOReturnNoResources : kIOReturnNotReady;
+		}
+		IODeleteData(pa, uint64_t, pages);
+		if (r == kIOReturnSuccess) {
+			bo->iova = m->iova;
+			((AGXAbiU64 *)out)->value = m->iova;
+		}
+		break;
+	}
+	case mBoFree: {
+		if ((bo = find(((const AGXAbiHandle *)in)->handle)) == NULL) {
+			r = kIOReturnBadArgument;
+		} else if (bo->leases != 0) {
+			r = kIOReturnBusy;              /* (a CPU view still leased: NativeAdrenoUserClient.cpp:359) */
+		} else if (bo->iova != 0 && bo->fence != 0 && !gpu_->done(bo->fence)) {
+			r = kIOReturnBusy;              /* (later: the GPU may still read it; piano gpu-userspace.md:185) */
+		} else {
+			if (bo->iova != 0 && !stopped_ && gpu_->unmap(space_, bo->iova, bo->bytes) != 0) {
+				r = gpu_->up() ? kIOReturnIOError : kIOReturnNotReady;
+				break;
+			}
+			freed = bo->memory;
+			freedView = bo->view;
+			freedBytes = bo->bytes;
+			freedOwned = !bo->imported;
+			bzero(bo, sizeof(*bo));
+			count_--;
+		}
+		break;
+	}
+	case mBoCpuMap: {
+		if ((bo = find(((const AGXAbiHandle *)in)->handle)) == NULL) {
+			r = kIOReturnBadArgument;
+		} else if (bo->imported) {
+			r = kIOReturnUnsupported;       /* (an import is the caller's own mapping: NativeAdrenoUserClient.cpp:700-701) */
+		} else if (bo->leases == 0xffffffffu) {
+			r = kIOReturnNoResources;
+		} else {
+			if (bo->view == NULL && agx_wc_explicit()) {
+				bo->view = AGXBoView::make(bo->memory, round_page_64(bo->bytes));
+			} else if (bo->view == NULL) {
+				bo->memory->retain();   /* iceagx_wc=0: g6b-1's view, the buffer's own descriptor (a reference of its own) */
+				bo->view = bo->memory;
+			}
+			if (bo->view == NULL) {
+				r = kIOReturnNoMemory;
+			} else {
+				AGXAbiCpuMapReply reply = { (uint32_t)(bo - bos_) + 1, 0, bo->bytes };
+
+				agx_bo_view_event(bo);          /* render1 */
+				bo->leases++;
+				memcpy(out, &reply, sizeof(reply));
+			}
+		}
+		break;
+	}
+	case mBoCpuUnmap: {
+		const AGXAbiCpuUnmap * u = (const AGXAbiCpuUnmap *)in;
+
+		if (u->reserved != 0 || (bo = find(u->handle)) == NULL || u->token != (uint32_t)(bo - bos_) + 1) {
+			r = kIOReturnBadArgument;
+		} else if (bo->leases == 0) {
+			r = kIOReturnBusy;
+		} else if (--bo->leases == 0 && bo->view != NULL) {
+			drop = bo->view;                /* the last lease takes the views down (NativeAdrenoPublish.cpp:966-977) */
+			drop->retain();
+			agx_bo_view_event(bo);          /* render1: the reap that follows resets the pages */
+		}
+		break;
+	}
+	case mSubmit: {
+		const AGXAbiSubmit * s = (const AGXAbiSubmit *)in;
+		uint32_t fence = 0;
+		int k;
+
+		if (s->buffer_count == 0 || s->buffer_count > kAGXMaxBuffers || s->reserved != 0 || s->queue >= kAGXQueues ||
+		    !(queues_ & (1u << s->queue))) {
+			r = kIOReturnBadArgument;
+			break;
+		}
+		if (s->wait_fence != 0) {
+			uint32_t wf = (uint32_t)s->wait_fence;
+
+			if (s->wait_fence > 0xffffffffull || last_ == 0 || (int32_t)(wf - last_) > 0) {
+				r = kIOReturnBadArgument;
+				break;
+			}
+			if (!gpu_->done(wf)) {
+				uint32_t ms = s->wait_timeout_ns == 0 ? 0 : s->wait_timeout_ns >= 0xffffffffull * 1000000 ? 0xffffffffu :
+				    (uint32_t)((s->wait_timeout_ns + 999999) / 1000000);
+
+				IOLockUnlock(lock_);
+				{
+					const uint64_t began = mach_absolute_time();
+
+					k = gpu_->wait(wf, ms);
+					noteWait(mach_absolute_time() - began);         /* render1 */
+				}
+				IOLockLock(lock_);
+				if (closed_ || stopped_) {
+					r = kIOReturnNotReady;
+					break;
+				}
+				if (k != 0) {
+					r = gpu_->up() ? kIOReturnTimeout : kIOReturnNotReady;
+					break;
+				}
+			}
+		}
+		for (uint32_t i = 0; i < s->buffer_count && r == kIOReturnSuccess; i++) {
+			const AGXAbiSubmitBuffer * b = &s->buffers[i];
+
+			bo = find(b->handle);
+			if (bo == NULL || bo->iova == 0 || b->bytes == 0 || (b->bytes & 3) || b->bytes / 4 > 0xfffff ||
+			    b->iova < bo->iova || b->iova + b->bytes < b->iova || b->iova + b->bytes > bo->iova + bo->bytes) {
+				r = kIOReturnBadArgument;
+			} else {
+				ib_[i] = b->iova;
+				dw_[i] = (uint32_t)(b->bytes / 4);
+			}
+		}
+		if (r != kIOReturnSuccess) {
+			break;
+		}
+		{
+			/* every owned buffer in the space write-combined again where a view took the attribute away (c0e3199
+			 * NativeAdrenoSubmit.cpp:127-131 over NativeAdrenoVm.cpp:374-381) */
+			static volatile SInt32 told;
+			uint32_t reset = 0, bos = 0, views = 0, unviewed = 0;
+			unsigned int had = 0;
+			uint64_t began = mach_absolute_time(), pages = 0;
+			/*
+			 * render1, iceagx_wcscan=1 (default 0: every owned buffer, as above): only the buffers with a CPU view are
+			 * walked. Only a view's pager sets a page's attribute (AGXBo's comment; bo->view stays set from the first
+			 * BoCpuMap to the free), and every "write-combined again" line of the gains runs counted the BOs found back
+			 * as all with a CPU view; the walk costs one pmap call a page of EVERY owned buffer each submission (gains2 g3:
+			 * WindowServer 11977507 us over 2619 submissions, ~4.6 ms each, under lock_). Every 64th submission (and the
+			 * first) still walks them all, as an audit: a page found back in a buffer WITHOUT a view is put right and
+			 * counted ("audit" lines, first 8; the icerender rows' "missed"), so the switch shows its own safety.
+			 */
+			/*
+			 * render1, iceagx_wcscan=2: per-buffer state (the r1 tablet run: every WindowServer buffer has a view, so
+			 * mode 1 still walked 71297 pages, ~5.4 ms, a submission). A buffer is walked only while it is not known
+			 * clean (agx_bo_view_event above); a walk that finds nothing counts as quiet once 250 ms have passed since
+			 * the event, and two quiet walks make it clean. The audit walks every owned buffer at every 64th
+			 * submission and at least once a second; pages found back in a buffer held clean (or, in mode 1, without
+			 * a view) are put right, counted as "missed" and said (first 8), and the buffer goes back to being walked.
+			 */
+			const uint64_t now0 = began;
+			uint64_t quiet_abs = 0, second_abs = 0;
+			nanoseconds_to_absolutetime(250000000ull, &quiet_abs);
+			nanoseconds_to_absolutetime(1000000000ull, &second_abs);
+			const bool audit = wcscan_ != 0 && ((submits_ & 63) == 0 || now0 - lastAudit_ >= second_abs);
+			const bool filtered = wcscan_ != 0 && !audit;
+
+			for (uint32_t i = 0; i < cap_ && agx_wc_explicit(); i++) {
+				AGXBo * b = &bos_[i];
+
+				if (b->handle != 0 && b->iova != 0 && !b->imported) {
+					if (filtered && (wcscan_ == 1 ? b->view == NULL : b->wc_clean)) {
+						continue;
+					}
+					const bool held_clean = wcscan_ == 1 ? b->view == NULL : b->wc_clean;
+					uint64_t span = round_page_64(b->bytes);
+					uint32_t n = agx_bo_attr(b->memory, span, VM_WIMG_WCOMB, true, &had);
+
+					pages += span / PAGE_SIZE;
+					reset += n;
+					bos += n != 0;
+					views += n != 0 && b->view != NULL;
+					unviewed += held_clean ? n : 0;
+					if (wcscan_ == 2) {
+						if (n != 0) {
+							agx_bo_view_event(b);
+						} else if (!b->wc_clean && now0 - b->wc_event >= quiet_abs && ++b->wc_quiet >= 2) {
+							b->wc_clean = true;
+						}
+					}
+				}
+			}
+			if (audit) {
+				lastAudit_ = now0;
+			}
+			{
+				const uint64_t took = mach_absolute_time() - began;
+
+				look_ += took;
+				lookMax_ = took > lookMax_ ? took : lookMax_;
+				pagesWin_ += pages;
+			}
+			if (audit) {
+				audits_++;
+				if (unviewed != 0) {
+					missed_ += unviewed;
+					if (missedSaid_++ < 8) {
+						IOLog("agx: %s: iceagx_wcscan=%u audit %u: %u pages of BOs held %s were back at %#x (put right; "
+						    "the filtered walk would not have seen them)\n", name_, wcscan_, audits_, unviewed,
+						    wcscan_ == 1 ? "without a view" : "clean", had);
+					}
+				}
+			}
+			if (reset != 0 && OSIncrementAtomic(&told) < 8) {
+				IOLog("agx: %s: %u pages of %u BOs (%u with a CPU view) were back at attribute %#x: write-combined again\n",
+				    name_, reset, bos, views, had);
+			}
+		}
+		k = gpu_->submit(space_, ib_, dw_, s->buffer_count, &fence);
+		if (k != 0) {
+			/* -2: the ring stays full, Turnip waits for its oldest fence and tries again (kmd patch :1578-1608) */
+			r = k == -2 ? kIOReturnBusy : gpu_->up() ? kIOReturnIOError : kIOReturnNotReady;
+			break;
+		}
+		last_ = fence;
+		submits_++;
+		ibs_ += s->buffer_count;
+		qfence_[s->queue] = fence;
+		for (uint32_t i = 0; i < s->buffer_count; i++) {
+			if ((bo = find(s->buffers[i].handle)) != NULL) {
+				bo->fence = fence;
+			}
+		}
+		((AGXAbiU64 *)out)->value = fence;
+		break;
+	}
+	default:
+		r = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(lock_);
+	if (drop != NULL) {
+		dropViews(drop);
+		drop->release();
+	}
+	if (freed != NULL) {
+		(void)releaseBo(freed, freedView, freedBytes, freedOwned);
+	}
+	return r;
+}
+
+IOReturn
+AGXDeviceUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * arguments, IOExternalMethodDispatch * dispatch,
+    OSObject * target, void * reference)
+{
+#pragma unused(dispatch, target, reference)
+	const uint32_t * header;
+	uint32_t outSize;
+	IOReturn r;
+
+	if (arguments == NULL || arguments->structureInputDescriptor != NULL || arguments->structureOutputDescriptor != NULL) {
+		return kIOReturnBadArgument;    /* (every v2 record is inline: the largest, Submit's, is 3104 bytes) */
+	}
+	outSize = arguments->structureOutputSize;
+	header = (const uint32_t *)arguments->structureInput;
+	if (header != NULL && arguments->structureInputSize >= 8 && header[0] == kAGXTunnelMagic) {
+		if (header[1] == kAGXTunnelProbe) {
+			return kIOReturnSuccess;
+		}
+		r = run(header[1], (const uint8_t *)arguments->structureInput + 8, arguments->structureInputSize - 8,
+		    arguments->structureOutput, &outSize);
+	} else {
+		r = run(selector, arguments->structureInput, arguments->structureInputSize, arguments->structureOutput, &outSize);
+	}
+	if (r == kIOReturnSuccess) {
+		arguments->structureOutputSize = outSize;
+	}
+	return r;
+}
+
+/*
+ * Progress markers (g6b-2): an open of type 0x4147xxxx, xxxx nonzero, is not a connection but one step of a process's
+ * progress, refused as Adreno740 refuses it (a8fa18f NativeAdrenoPublish.cpp:1103-1151), so that a process the sandbox
+ * admits to no selector or mapping, or that crashes, still leaves a trace. Adreno740 keeps them in its board's memory; here
+ * they become kernel log lines:
+ *   xxxx < 0x7000, or 0x7100..0x7ffd    "agx: <process> mark 0x<xxxx>" (1: the process starts)
+ *   0x7fff (0x7ffe), then 0x70cc ...     one text line of characters cc: "agx: <process> text (report): <line>"
+ *   0xc000 + r, then 0x8000..0xbfff      row r, two 7-bit characters a marker: "agx: <process> row <r>: <line>"
+ * A pending line is written out when another starts, at a numeric marker, or at 63 characters. At most 32 lines a second
+ * (those over it counted, and the count written once the second is over); not counted among the 24 opens logged.
+ * Text and report lines are a client's results, so they are always written (and counted in the second's lines): on
+ * ladder-1 the probe daemon's 32 test markers filled the second, its Turnip phase ended inside it, and its "T s.. r.."
+ * line and the count were both lost (no marker came after to write the count).
+ */
+static IOLock * agx_marks_lock;
+static struct {
+	char proc[20];
+	char line[64];
+	uint32_t length;
+	int kind;                       /* 0 none, 1 text, 2 report, 3 row */
+	uint32_t row;
+	uint64_t window;                /* the second (mach_absolute_time) the counts below are for */
+	uint32_t lines, dropped;
+} agx_marks;
+
+static void
+agx_mark_say(bool result, const char * fmt, ...) __printflike(2, 3);
+
+static void
+agx_mark_say(bool result, const char * fmt, ...)
+{
+	uint64_t now = mach_absolute_time(), ns = 0;
+	va_list ap;
+
+	absolutetime_to_nanoseconds(now - agx_marks.window, &ns);
+	if (agx_marks.window == 0 || ns >= 1000000000ull) {
+		if (agx_marks.dropped != 0) {
+			IOLog("agx: %u marker lines not logged (over 32 a second)\n", agx_marks.dropped);
+		}
+		agx_marks.window = now;
+		agx_marks.lines = 0;
+		agx_marks.dropped = 0;
+	}
+	if (agx_marks.lines >= 32 && !result) {
+		agx_marks.dropped++;
+		return;
+	}
+	agx_marks.lines++;
+	va_start(ap, fmt);
+	IOLogv(fmt, ap);
+	va_end(ap);
+}
+
+static void
+agx_mark_flush(void)
+{
+	if (agx_marks.length == 0) {
+		/* (an empty line says nothing) */
+	} else if (agx_marks.kind == 3) {
+		agx_mark_say(false, "agx: %s row %u: %s\n", agx_marks.proc, agx_marks.row, agx_marks.line);
+	} else if (agx_marks.kind != 0) {
+		agx_mark_say(true, "agx: %s text%s: %s\n", agx_marks.proc, agx_marks.kind == 2 ? " (report)" : "", agx_marks.line);
+	}
+	agx_marks.kind = 0;
+	agx_marks.length = 0;
+	agx_marks.line[0] = 0;
+}
+
+static void
+agx_mark_char(char c)
+{
+	agx_marks.line[agx_marks.length++] = c >= 0x20 && c < 0x7f ? c : '.';
+	agx_marks.line[agx_marks.length] = 0;
+	if (agx_marks.length >= sizeof(agx_marks.line) - 1) {
+		int kind = agx_marks.kind;
+
+		agx_mark_flush();
+		agx_marks.kind = kind;          /* (the line goes on in the next) */
+	}
+}
+
+static void
+agx_mark(uint32_t value)
+{
+	char proc[20] = {};
+
+	if (agx_marks_lock == NULL) {
+		IOLock * lock = IOLockAlloc();
+
+		if (!OSCompareAndSwapPtr(NULL, lock, (void * volatile *)&agx_marks_lock)) {
+			IOLockFree(lock);
+		}
+	}
+	if (agx_marks_lock == NULL) {
+		return;
+	}
+	proc_selfname(proc, sizeof(proc));
+	IOLockLock(agx_marks_lock);
+	if (agx_marks.kind != 0 && strncmp(agx_marks.proc, proc, sizeof(proc)) != 0) {
+		agx_mark_flush();               /* (another process's line ends here) */
+	}
+	if (value >= 0xc000) {
+		agx_mark_flush();
+		agx_marks.kind = 3;
+		agx_marks.row = value & 0x3f;
+	} else if (value >= 0x8000) {
+		if (agx_marks.kind == 3) {
+			for (uint32_t c = (value >> 7) & 0x7f, i = 0; i < 2; i++, c = value & 0x7f) {
+				if (c != 0) {
+					agx_mark_char((char)c);
+				}
+			}
+		}
+	} else if (value == 0x7fff || value == 0x7ffe) {
+		agx_mark_flush();
+		agx_marks.kind = value == 0x7fff ? 1 : 2;
+	} else if (value >= 0x7000 && value < 0x7100) {
+		if (agx_marks.kind == 1 || agx_marks.kind == 2) {
+			agx_mark_char((char)(value & 0xff));
+		}
+	} else {
+		agx_mark_flush();
+		agx_mark_say(false, "agx: %s mark %#x%s\n", proc, value, value == 1 ? " (start)" : "");
+	}
+	if (agx_marks.kind != 0) {
+		strlcpy(agx_marks.proc, proc, sizeof(agx_marks.proc));
+	}
+	IOLockUnlock(agx_marks_lock);
+}
+
+/*
+ * w3-agxclients, boot-arg iceagx_clients=NAME[,NAME...] (absent: every process, as before): only the processes named (their
+ * name as proc_selfname gives it, compared whole) get the device user client of type 0x4147; any other process is refused as
+ * when the GPU spaces run out (kIOReturnBusy), so the plugin makes it no Metal device ("no-device ... VkResultCode(-3)") and it
+ * draws on the CPU. The only tablet login whose Dock, menu bar and widgets drew (runs/w3-power-ds/20261115-170130, 8 spaces)
+ * had 11 clients refused that way; with 32 spaces every client got a device and iconservicesagent aborted under Core Image.
+ * macos-uke gives only WindowServer a device unless uke-metal-clients= names more (gpu/plugin/0001-macos-windowserver.patch).
+ * The kernel's own clients (the self-tests) are never refused. Read once, at the first open.
+ */
+static bool
+agx_client_listed(const char * name)
+{
+	static char list[256];
+	static int state = -1;          /* -1: not read yet, 0: no list (everyone), 1: a list */
+
+	if (state < 0) {
+		state = PE_parse_boot_arg_str("iceagx_clients", list, sizeof(list)) && list[0] != '\0' ? 1 : 0;
+	}
+	if (state == 0) {
+		return true;
+	}
+	size_t n = strnlen(name, 64);
+
+	for (const char * at = list; n != 0 && *at != '\0';) {
+		const char * end = at;
+
+		while (*end != '\0' && *end != ',') {
+			end++;
+		}
+		if ((size_t)(end - at) == n && strncmp(at, name, n) == 0) {
+			return true;
+		}
+		at = *end == ',' ? end + 1 : end;
+	}
+	return false;
+}
+
+/* type 0x4147 with iceagx_client=1: the ABI v2 client (its GPU space when the GPU serves); every other open refused, named */
+IOReturn
+AGXAccelerator::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+    IOUserClient ** handler)
+{
+	uint32_t client = 0;
+	AGXDeviceUserClient * uc = NULL;
+	IOUserClient * made = NULL;
+	IOReturn r = kIOReturnUnsupported;
+	char name[20] = {};
+	bool listed = true;
+
+	if (handler != NULL) {
+		*handler = NULL;
+	}
+	PE_parse_boot_argn("iceagx_client", &client, sizeof(client));
+	if (client != 0 && (type >> 16) == kAGXOpenType && (type & 0xffff) != 0) {
+		agx_mark(type & 0xffff);        /* a progress marker, refused (above agx_mark) */
+		return kIOReturnUnsupported;
+	}
+	if (client != 0 && type == kAGXOpenType && handler != NULL && owningTask != kernel_task) {
+		char who[33] = {};
+
+		proc_selfname(who, sizeof(who));
+		listed = agx_client_listed(who);
+		if (!listed) {
+			static volatile SInt32 agx_unlisted;
+			SInt32 n = OSIncrementAtomic(&agx_unlisted);
+
+			/* the first 32, then every 256th with the count */
+			if (n < 32) {
+				IOLog("agx: %s: not on iceagx_clients: no device\n", who);
+			} else if ((n & 255) == 0) {
+				IOLog("agx: %s: not on iceagx_clients: no device (%d refused so far)\n", who, (int)n + 1);
+			}
+			r = kIOReturnBusy;      /* (as no free GPU space: mount's answer) */
+		}
+	}
+	if (client != 0 && type == kAGXOpenType && handler != NULL && listed) {
+		uc = AGXDeviceUserClient::make(owningTask, securityID, type, properties);
+		if (uc != NULL && uc->attach(this)) {
+			if (uc->start(this) && (r = uc->mount()) == kIOReturnSuccess) {
+				made = uc;
+			} else {
+				uc->detach(this);
+			}
+		}
+		if (made == NULL) {
+			OSSafeReleaseNULL(uc);
+		}
+	}
+	if (OSIncrementAtomic(&agx_opens) < 24) {
+		proc_selfname(name, sizeof(name));
+		IOLog("agx: %s opens type %#x: %s%s\n", name, (unsigned)type, made == NULL ? (!listed ? "refused (not on iceagx_clients)" : r == kIOReturnBusy ? "refused (no GPU space)" :
+		    "refused") : uc->isLive() ? "ABI v2 client" : "ABI v2 client (skeleton)",
+		    agx_is_render_server(name, sizeof(name)) ? " [render server]" : "");
+	}
+	if (made == NULL) {
+		return r == kIOReturnSuccess ? kIOReturnUnsupported : r;
+	}
+	*handler = made;
+	return kIOReturnSuccess;
+}
+
+/* who looks for the plug-in: Metal's discovery reads MetalPluginName in every process that asks for a device */
+static void
+agx_note_read(const char * key)
+{
+	char name[20] = {};
+
+	if (key == NULL || strcmp(key, "MetalPluginName") != 0 || OSIncrementAtomic(&agx_reads) >= 24) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	IOLog("agx: %s reads MetalPluginName%s\n", name, agx_is_render_server(name, sizeof(name)) ? " [render server]" : "");
+}
