+
+IOReturn
+IcelandAudioDevice::startIO()
+{
+	IOLockLock(lock);
+	if (!running) {
+		while (stopping) {
+			IOLockSleep(lock, &stopping, THREAD_UNINT);
+		}
+		bzero(ring->getBytesNoCopy(), ring->getLength());
+		EngineStatus *s = status();
+		startTime = mach_absolute_time();
+		s->sampleTime = 0;
+		s->hostTime = startTime;
+		s->seed = ++seed;
+		s->writeEnd = 0;
+		__asm__ volatile ("dmb ish" ::: "memory");
+		running = true;
+		setProperty("is running", kOSBooleanTrue);
+		if (kernel_thread_start(engineMain, this, &engine) == KERN_SUCCESS) {
+			thread_deallocate(engine);
+		} else {
+			running = false;
+		}
+		if (isInput) {
+			iceland_audio_dev_in_running = running ? 1 : 0;
+		} else {
+			iceland_audio_dev_running = running ? 1 : 0;
+		}
+		iceland_audio_dev_starts = iceland_audio_dev_starts + 1;
+		if (isInput) {
+			// w4-audio round 6: a line at once (the worker's comes up to 5 s later): a recorder has the microphone, and
+			// the PC that plays for it starts on this line.
+			micStartPeriods = iceland_audio_dev_in_periods;
+			micStartCaptured = iceland_audio_dev_captured;
+			micStartPadded = iceland_audio_dev_in_padded;
+			micStartSkipped = ice_icemic_skipped;
+			micStartLate = iceland_audio_dev_late;
+			IOLog("icesnddev: MIC IO STARTED (start %llu): the audio server records from \"Mic\"\n",
+			    iceland_audio_dev_starts);
+		}
+	}
+	const bool ok = running;
+	IOLockUnlock(lock);
+	return ok ? kIOReturnSuccess : kIOReturnNoResources;
+}
+
+IOReturn
+IcelandAudioDevice::stopIO()
+{
+	IOLockLock(lock);
+	if (running) {
+		running = false;
+		stopping = true;
+		while (stopping) {
+			IOLockSleep(lock, &stopping, THREAD_UNINT);     // the engine thread clears it as it leaves
+		}
+		setProperty("is running", kOSBooleanFalse);
+		if (isInput) {
+			iceland_audio_dev_in_running = 0;
+			// w4-audio round 7: one line per recording with what became of its periods: the engine's, how much of the
+			// source's was missing (zero-padded), what the source's clamp dropped while this reader was reading, the
+			// periods its engine was late for, and the backlog the source found at the recording's first read.
+			IOLog("icesnddev: MIC IO STOPPED: %llu periods (%llu ms), %llu frames delivered to the engine, %llu zero-padded, "
+			    "%llu skipped by the source, %llu late periods (backlog dropped at start %llu)\n",
+			    iceland_audio_dev_in_periods - micStartPeriods, (iceland_audio_dev_in_periods - micStartPeriods) * 5,
+			    iceland_audio_dev_captured - micStartCaptured, iceland_audio_dev_in_padded - micStartPadded,
+			    ice_icemic_skipped - micStartSkipped, iceland_audio_dev_late - micStartLate, ice_icemic_backlog);
+		} else {
+			iceland_audio_dev_running = 0;
+		}
+	}
+	IOLockUnlock(lock);
+	return kIOReturnSuccess;
+}
+
+void
+IcelandAudioDevice::engineMain(void *self, wait_result_t)
+{
+	static_cast<IcelandAudioDevice *>(self)->run();
+}
+
+// One period per pass, on the device's own clock: period n ends at startTime + n periods. The period the hardware position
+// just passed goes to the transport, then the ring is erased there so a client that stops writing plays silence. The zero
+// time stamp moves at each wrap of the ring.
+void
+IcelandAudioDevice::run()
+{
+	retain();
+	int16_t *buffer = static_cast<int16_t *>(ring->getBytesNoCopy());
+	uint64_t done = 0;
+	for (;;) {
+		IOLockLock(lock);
+		const bool live = running;
+		IOLockUnlock(lock);
+		if (!live) {
+			break;
+		}
+		const uint64_t deadline = startTime + absolute(done + kPeriodFrames);
+		if (mach_absolute_time() > deadline + absolute(kPeriodFrames)) {
+			iceland_audio_dev_late = iceland_audio_dev_late + 1;
+		} else {
+			clock_delay_until(deadline);
+		}
+		int16_t *at = buffer + uint32_t(done % kRingFrames) * channels();
+		if (isInput) {
+			// The microphone: the period the position just passed, from the capture source; what it cannot give is silence.
+			// Round 7: the source is asked again for what is still missing (a 240-frame period against its 5760-frame
+			// priming block), so a period that can be filled is; a call that gives nothing ends it.
+			uint32_t captured = 0;
+
+			while (captured < kPeriodFrames) {
+				const uint32_t given = redwood_audio_capture(at + captured, kPeriodFrames - captured);
+				if (!given) {
+					break;
+				}
+				captured += given;
+			}
+			if (captured < kPeriodFrames) {
+				bzero(at + captured, (kPeriodFrames - captured) * 2);
+				iceland_audio_dev_in_padded = iceland_audio_dev_in_padded + (kPeriodFrames - captured);
+			}
+			iceland_audio_dev_captured = iceland_audio_dev_captured + captured;
+			iceland_audio_dev_in_periods = iceland_audio_dev_in_periods + 1;
+		} else {
+			bool sound = false;
+			for (uint32_t i = 0; i < kPeriodFrames * kChannels && !sound; i++) {
+				sound = at[i] > int16_t(kSilence) || at[i] < -int16_t(kSilence);
+			}
+			redwood_audio_play(at, kPeriodFrames);
+			bzero(at, kPeriodFrames * 2 * kChannels);
+			if (sound) {
+				iceland_audio_dev_sound = iceland_audio_dev_sound + 1;
+			}
+			iceland_audio_dev_periods = iceland_audio_dev_periods + 1;
+		}
+		done += kPeriodFrames;
+		if (done % kRingFrames == 0) {
+			EngineStatus *s = status();
+			s->hostTime = startTime + absolute(done);
+			__asm__ volatile ("dmb ish" ::: "memory");
+			s->sampleTime = done;
+			__asm__ volatile ("dmb ish" ::: "memory");
+		}
+	}
+	IOLockLock(lock);
+	stopping = false;
+	IOLockWakeup(lock, &stopping, false);
+	IOLockUnlock(lock);
+	release();
+}
