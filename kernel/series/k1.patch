+static const char *
+type_name(int32_t type)
+{
+	if (type > 0 && type < (int32_t)(sizeof(type_names) / sizeof(type_names[0])) && type_names[type] != NULL) {
+		return type_names[type];
+	}
+	return "?";
+}
