+	$(_v){ git -C $(SRCROOT) rev-parse HEAD 2>/dev/null || echo no-git; \
+	    git -C $(SRCROOT) diff HEAD -- . ':(exclude)BUILD' 2>/dev/null | cksum | cut -d' ' -f1; } > $@.new
+	$(_v)if cmp -s $@.new $@; then rm -f $@.new; else mv -f $@.new $@; fi
+
+$(OBJPATH)/version.c: $(SRCROOT)/config/version.c.template $(NEWVERS) $(XNU_VERSION) $(VERSION_STAMP)
 	$(_v)$(CP) $< $@
 	$(_v)$(NEWVERS) $@ > /dev/null;
 
