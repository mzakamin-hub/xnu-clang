+	{ "GMU_RCGR_CMD", 1, GMU_RCGR }, { "GMU_RCGR_CFG", 1, GMU_RCGR + 4 }, { "HUB_RCGR_CMD", 1, HUB_RCGR },
+	{ "HUB_RCGR_CFG", 1, HUB_RCGR + 4 }, S_CC(HUB_DIV),
+	S_CC(CBCR_AHB), S_CC(CBCR_CX_GMU), S_CC(CBCR_CXO), S_CC(CBCR_HUB_CX_INT), S_CC(CBCR_MEMNOC_GFX), S_CC(CBCR_GX_GMU),
+	S_CC(CBCR_SMMU_VOTE), S_CC(CBCR_HUB_AON), S_CC(CBCR_RSCC_HUB_AON), S_CC(CBCR_RSCC_XO_AON), S_CC(CBCR_CXO_AON),
+	S_CC(CX_GDSCR), S_CC(CX_GDS_HW_CTRL),
+	S_G(G8_GMU_CM3_SYSRESET), S_G(G8_GMU_CM3_FW_INIT_RESULT), S_G(G8_GMU_CORE_FW_VERSION), S_G(G8_GMU_HFI_CTRL_STATUS),
+	S_G(G8_GMU_GMU2HOST_INTR_INFO), S_G(G8_GMU_AO_HOST_INTERRUPT_STATUS), S_G(G8_GMU_PWR_CLK_STATUS),
+	S_G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE), S_G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS), S_G(G8_GMU_GENERAL_8),
+	S_G(G8_GMU_GENERAL_9), S_G(G8_GMU_GENERAL_10), S_G(G8_GMU_HFI_QTBL_ADDR), S_G(G8_GMU_CM3_BOOT_CONFIG),
+	S_R(G8_GPU_RSCC_RSC_STATUS0_DRV0), S_R(G8_RSCC_SEQ_BUSY_DRV0),
+	S_X(G8_CX_MISC_CX_MISC_SW_FUSE_VALUE), S_X(G8_CX_MISC_CX_MISC_SLICE_ENABLE_FINAL), S_X(G8_CX_MISC_CX_MISC_TCM_RET_CNTL),
+	S_X(G8_CX_MISC_CX_MISC_GFX_PWR_CLK_STATUS),
+	{ "GX_GDSCR", 2, (uint32_t)(GX_GDSCR_OFF / 4) }, { "GX_GDSCR_CFG", 2, (uint32_t)((GX_GDSCR_OFF + 4) / 4) },
+};
+#define SURVEY_REGS             (sizeof(survey_regs) / sizeof(survey_regs[0]))
+
+#define SMMU_SMRS_MAX           128
+#define SMMU_CBS_MAX            128
+struct snapshot {
+	bool valid[SURVEY_REGS];
+	uint32_t value[SURVEY_REGS];
+	bool cx, gmu, smmu;
+	uint32_t scr0, idr0, idr1, idr2, gfsr, nsmr, ncb;
+	uint32_t smr[SMMU_SMRS_MAX], s2cr[SMMU_SMRS_MAX], cb_sctlr[SMMU_CBS_MAX], cbar[SMMU_CBS_MAX];
+};
+static struct snapshot found, after;
+static uint32_t smmu_pgsize = 0x1000, smmu_numpage = 32;
+
+static vm_offset_t
+sreg_va(const struct sreg *r)
+{
+	switch (r->where) {
+	case 0: return gcc + r->off;
+	case 1: return GPUCC(r->off);
+	case 2: return gpu + 4UL * r->off;
+	case 3: return gpu + RSCC_OFF + 4UL * r->off;
+	default: return gpu + CX_MISC_OFF + 4UL * r->off;
+	}
+}
+
+static uint64_t
+sreg_pa(const struct sreg *r)
+{
+	return r->where == 0 ? GCC_PHYS + r->off : GPU_PHYS + (sreg_va(r) - gpu);
+}
+
+static void
+smmu_geometry(uint32_t idr1)
+{
+	smmu_pgsize = (idr1 & (1u << 31)) ? 0x10000 : 0x1000;
+	smmu_numpage = 1u << ((idr1 >> 28 & 7) + 1);
+}
+
+#define SMMU_sCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_IDR2               0x028
+#define SMMU_sGFSR              0x048
+#define SMMU_TLBIALLNSNH        0x068
+#define SMMU_TLBIALLH           0x06c
+#define SMMU_sTLBGSYNC          0x070
+#define SMMU_sTLBGSTATUS        0x074
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define SMMU_CBAR(n)            (smmu_pgsize + 4 * (n))
+#define SMMU_CBA2R(n)           (smmu_pgsize + 0x800 + 4 * (n))
+#define SMMU_CB(n)              ((smmu_numpage + (n)) * smmu_pgsize)
+#define CB_SCTLR                0x00
+#define CB_ACTLR                0x04
+#define ACTLR_ADRENO_GMU        0x303u          /* arm-smmu-qcom.c "qcom,adreno-gmu": PREFETCH_DEEP | CPRE | CMTLB */
+#define CB_TCR2                 0x10
+#define CB_TTBR0                0x20
+#define CB_TTBR1                0x28
+#define CB_TCR                  0x30
+#define CB_MAIR0                0x38
+#define CB_MAIR1                0x3c
+#define CB_FSR                  0x58
+#define CB_FAR                  0x60
+#define CB_FSYNR0               0x68
+#define CB_TLBIASID             0x610
+#define CB_TLBSYNC              0x7f0
+#define CB_TLBSTATUS            0x7f4
+#define sCR0_CLIENTPD           (1u << 0)
+#define SMR_VALID               (1u << 31)
+#define S2CR_FAULT              (2u << 16)
+
+static void
+survey(struct snapshot *s, bool quiet)
+{
+	char line[200];
+	int n = 0;
+
+	bzero(s, sizeof(*s));
+	s->cx = cx_on();
+	s->gmu = gmu_readable();
+	s->smmu = smmu_readable();
+	line[0] = 0;
+	for (unsigned i = 0; i < SURVEY_REGS; i++) {
+		const struct sreg *r = &survey_regs[i];
+
+		if (r->where >= 2 && !s->gmu) {
+			continue;
+		}
+		s->value[i] = rd(sreg_va(r));
+		s->valid[i] = true;
+		if (!quiet) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %s=%#x", r->name, s->value[i]);
+			if (n > 120 || i == SURVEY_REGS - 1) {
+				say(" %s\n", line);
+				n = 0;
+				line[0] = 0;
+			}
+		}
+	}
+	if (!quiet && n > 0) {
+		say(" %s\n", line);
+	}
+	if (!s->smmu) {
+		return;
+	}
+	s->scr0 = rd(smmu + SMMU_sCR0);
+	s->idr0 = rd(smmu + SMMU_IDR0);
+	s->idr1 = rd(smmu + SMMU_IDR1);
+	s->idr2 = rd(smmu + SMMU_IDR2);
+	s->gfsr = rd(smmu + SMMU_sGFSR);
+	smmu_geometry(s->idr1);
+	s->nsmr = s->idr0 & 0xff;
+	s->ncb = s->idr1 & 0xff;
+	if (s->nsmr > SMMU_SMRS_MAX || s->ncb > SMMU_CBS_MAX || smmu_numpage * smmu_pgsize * 2 > SMMU_SIZE) {
+		say("SMMU: ID registers out of what this knows (idr0 %#x idr1 %#x): not read further\n", s->idr0, s->idr1);
+		s->smmu = false;
+		return;
+	}
+	for (uint32_t i = 0; i < s->nsmr; i++) {
+		s->smr[i] = rd(smmu + SMMU_SMR(i));
+		s->s2cr[i] = rd(smmu + SMMU_S2CR(i));
+	}
+	for (uint32_t i = 0; i < s->ncb; i++) {
+		s->cb_sctlr[i] = rd(smmu + SMMU_CB(i) + CB_SCTLR);
+		s->cbar[i] = rd(smmu + SMMU_CBAR(i));
+	}
+	if (quiet) {
+		return;
+	}
+	say("SMMU: sCR0 %#x (%s) idr0 %#x idr1 %#x idr2 %#x sGFSR %#x: %u stream groups, %u context banks, %u-byte pages, "
+	    "%u pages before the banks\n", s->scr0, (s->scr0 & sCR0_CLIENTPD) ? "CLIENTPD: bypass" : "translating", s->idr0,
+	    s->idr1, s->idr2, s->gfsr, s->nsmr, s->ncb, smmu_pgsize, smmu_numpage);
+	for (uint32_t i = 0; i < s->nsmr; i++) {
+		if (s->smr[i] & SMR_VALID) {
+			say("SMMU: SMR %u = %#x (stream %#x mask %#x) -> S2CR %#x\n", i, s->smr[i], s->smr[i] & 0xffff,
+			    s->smr[i] >> 16 & 0x7fff, s->s2cr[i]);
+		}
+	}
+	for (uint32_t i = 0; i < s->ncb; i++) {
+		if (s->cb_sctlr[i] & 1) {
+			say("SMMU: context bank %u enabled: sctlr %#x cbar %#x ttbr0 %#x%08x\n", i, s->cb_sctlr[i], s->cbar[i],
+			    rd(smmu + SMMU_CB(i) + CB_TTBR0 + 4), rd(smmu + SMMU_CB(i) + CB_TTBR0));
+		}
+	}
+}
+
+static uint32_t
+survey_compare(const struct snapshot *a, const struct snapshot *b)
+{
+	uint32_t differ = 0;
+
+	for (unsigned i = 0; i < SURVEY_REGS; i++) {
+		if (a->valid[i] && b->valid[i] && a->value[i] != b->value[i]) {
+			differ++;
+			say("differs: %s @%#llx: found %#x, now %#x\n", survey_regs[i].name, sreg_pa(&survey_regs[i]), a->value[i],
+			    b->value[i]);
+		} else if (a->valid[i] != b->valid[i]) {
+			differ++;
+			say("differs: %s readable %s before, %s now\n", survey_regs[i].name, a->valid[i] ? "was" : "was not",
+			    b->valid[i] ? "is" : "is not");
+		}
+	}
+	if (a->smmu && b->smmu) {
+		if (a->scr0 != b->scr0) {
+			differ++;
+			say("differs: SMMU sCR0 found %#x, now %#x\n", a->scr0, b->scr0);
+		}
+		for (uint32_t i = 0; i < a->nsmr && i < b->nsmr; i++) {
+			if (a->smr[i] != b->smr[i] || a->s2cr[i] != b->s2cr[i]) {
+				differ++;
+				say("differs: SMMU SMR/S2CR %u found %#x/%#x, now %#x/%#x\n", i, a->smr[i], a->s2cr[i], b->smr[i],
+				    b->s2cr[i]);
+			}
+		}
+		for (uint32_t i = 0; i < a->ncb && i < b->ncb; i++) {
+			if (a->cb_sctlr[i] != b->cb_sctlr[i]) {
+				differ++;
+				say("differs: SMMU CB %u sctlr found %#x, now %#x\n", i, a->cb_sctlr[i], b->cb_sctlr[i]);
+			}
+		}
+	}
+	return differ;
+}
+
+/* ---- RPMh: cmd-db (read only) ------------------------------------------------------------------------------------ */
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+/*
+ * cmd-db is mapped as device memory: one byte at a time, never memcpy (its wide, unaligned loads fault there: run ipad8,
+ * "Unaligned kernel data abort" in cmd_db_find)
+ */
+static void
+cmd_db_copy(void *to, const uint8_t *from, size_t n)
+{
+	uint8_t *t = to;
+
+	for (size_t i = 0; i < n; i++) {
+		t[i] = ((const volatile uint8_t *)from)[i];
+	}
+}
+
+/* cmd_db_read_addr + cmd_db_read_aux_data: the address (0 if absent), its aux data and length */
+static uint32_t
+cmd_db_find(const char *name, const uint8_t **aux, unsigned *aux_len)
+{
+	char id[8] = { 0 };
+	const uint8_t *data = cmd_db + 8 + 8 * sizeof(struct cmd_db_slave) + 8;
+
+	*aux = NULL;
+	*aux_len = 0;
+	if (!(cmd_db[4] == 0xdb && cmd_db[5] == 0x30 && cmd_db[6] == 0x03 && cmd_db[7] == 0x0c)) {
+		return 0;
+	}
+	memcpy(id, name, strlen(name) < sizeof(id) ? strlen(name) : sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		struct cmd_db_slave slave;
+
+		cmd_db_copy(&slave, cmd_db + 8 + s * sizeof(slave), sizeof(slave));
+		if (slave.id == 0 || slave.count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave.count; i++) {
+			struct cmd_db_entry e;
+
+			cmd_db_copy(&e, data + slave.header_offset + i * sizeof(e), sizeof(e));
+			if (memcmp(e.id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if ((uint32_t)slave.data_offset + e.offset + e.length <= CMD_DB_SIZE) {
+				*aux = data + slave.data_offset + e.offset;
+				*aux_len = e.length;
+			}
+			return e.address;
+		}
+	}
+	return 0;
+}
+
+/* a6xx_gmu_rpmh_read_arc: a rail's levels, trailing zero padding left out */
+struct arc {
+	const char *name;
+	uint32_t address;
+	uint16_t level[32];          /* (16 cut gfx.lvl short: run ipad9 saw 0..384, Linux reads them all) */
+	unsigned count;
+};
+
+static bool
+arc_read(struct arc *a, bool quiet)
+{
+	const uint8_t *aux;
+	unsigned len;
+	char line[240];
+	int n = 0;
+
+	a->count = 0;
+	a->address = cmd_db_find(a->name, &aux, &len);
+	for (unsigned i = 0; a->address != 0 && aux != NULL && i < len / 2 && i < 32; i++) {
+		a->level[i] = (uint16_t)(aux[2 * i] | aux[2 * i + 1] << 8);
+		a->count = i + 1;
+	}
+	while (a->count > 0 && a->level[a->count - 1] == 0) {
+		a->count--;
+	}
+	line[0] = 0;
+	for (unsigned i = 0; i < a->count && n < (int)sizeof(line) - 8; i++) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %u", a->level[i]);
+	}
+	if (!quiet) {
+		say("cmd-db %s at %#x: %u levels:%s\n", a->name, a->address, a->count, a->address ? line : " (not in cmd-db)");
+	}
+	return a->address != 0 && a->count != 0;
+}
+
+/* a6xx_gmu_rpmh_arc_index: the first level at least `level`; clamp to the top, or -1 */
+static int
+arc_index(const struct arc *a, uint32_t level, bool clamp)
+{
+	for (unsigned j = 0; j < a->count; j++) {
+		if (a->level[j] >= level) {
+			return (int)j;
+		}
+	}
+	return clamp && a->count ? (int)a->count - 1 : -1;
+}
+
+/* ---- the Pad's speeds (kaanapali.dtsi gpu_opp_table + iceland's overrides; gmu_opp_table) ---------------------- */
+
+static const struct {
+	uint32_t mhz, level, kbps, hw;
+} gpu_opps[] = {
+	{ 160, 50, 2136718, 0x0f }, { 191, 51, 2136718, 0x0f }, { 222, 52, 2136718, 0x0f }, { 282, 54, 5285156, 0x0f },
+	{ 342, 56, 5285156, 0x0f }, { 382, 60, 5285156, 0x0f }, { 422, 64, 6074218, 0x0f }, { 461, 76, 6074218, 0x0f },
+	{ 500, 80, 6074218, 0x0f }, { 578, 128, 6074218, 0x0f }, { 646, 144, 8171875, 0x0f }, { 726, 192, 8171875, 0x0f },
+	{ 826, 224, 12449218, 0x0f }, { 902, 256, 12449218, 0x0f }, { 1000, 384, 16500000, 0x0f },
+	{ 1050, 416, 16500000, 0x0f }, { 1100, 432, 20832031, 0x07 }, { 1200, 448, 20832031, 0x07 },
+	{ 1300, 452, 20832031, 0x03 },
+};
+static const struct {
+	uint32_t mhz, level;
+} gmu_opps[] = { { 475, 56 }, { 575, 64 }, { 700, 128 }, { 725, 192 }, { 750, 256 } };
+
+#define GX_MAX                  32
+#define CX_MAX                  6
+#define BW_MAX                  16
+static uint32_t gpu_mhz[GX_MAX], gpu_level[GX_MAX], gpu_kbps[GX_MAX], gx_votes[GX_MAX], dep_votes[GX_MAX];
+static uint32_t cx_votes[CX_MAX], bw_kbps[BW_MAX];
+static unsigned n_gpu, n_gmu, n_bw;
+
+/* HFI messages, built before anything is written */
+#define BW_WORDS                160
+static uint32_t perf_msg[5 + 3 * GX_MAX + 2 + 2 * CX_MAX], perf_words, bw_msg[BW_WORDS];
+
+#define BCM_CMD(commit, valid, x, y) \
+	((uint32_t)(commit) << 30 | (uint32_t)(valid) << 29 | ((uint32_t)(x) & 0x3fff) << 14 | ((uint32_t)(y) & 0x3fff))
+
+static bool
+tables_build(uint32_t binmask)
+{
+	struct arc gfx = { .name = "gfx.lvl" }, mx = { .name = "mx.lvl" }, cx = { .name = "cx.lvl" },
+	    gmxc = { .name = "gmxc.lvl" }, gbx = { .name = "gbx.lvl" };
+	const struct arc *sec;
+	static const struct {
+		const char *name;
+		uint32_t buswidth;
+		bool fixed;
+		uint32_t perfmode, perfmode_kbps;
+	} bcms[] = { { "SH0", 16, false, 0, 0 }, { "MC0", 4, false, 0, 0 }, { "ACV", 0, true, 1u << 2, 10687500 } };
+	const uint8_t *aux[3];
+	unsigned aux_len[3], at = 0;
+	uint32_t unit[3] = { 0 }, width[3] = { 0 }, vcd[3] = { 0 };
+
+	if (!arc_read(&gfx, false) || !arc_read(&mx, false) || !arc_read(&cx, false)) {
+		say("cmd-db lacks gfx / mx / cx: no tables\n");
+		return false;
+	}
+	sec = arc_read(&gmxc, false) ? &gmxc : &mx;
+	(void)arc_read(&gbx, false);
+
+	/* a6xx_gmu_build_freq_table: "off" + the OPPs this speed bin has; the bandwidths likewise, ascending, unique */
+	n_gpu = 1;
+	n_bw = 1;
+	gpu_mhz[0] = gpu_level[0] = gpu_kbps[0] = 0;
+	bw_kbps[0] = 0;
+	for (unsigned i = 0; i < sizeof(gpu_opps) / sizeof(gpu_opps[0]) && n_gpu < GX_MAX; i++) {
+		if (!(gpu_opps[i].hw & binmask)) {
+			continue;
+		}
+		gpu_mhz[n_gpu] = gpu_opps[i].mhz;
+		gpu_level[n_gpu] = gpu_opps[i].level;
+		gpu_kbps[n_gpu] = gpu_opps[i].kbps;
+		n_gpu++;
+	}
+	for (uint32_t floor = 1;;) {
+		uint32_t best = 0;
+
+		for (unsigned i = 1; i < n_gpu; i++) {
+			if (gpu_kbps[i] >= floor && (best == 0 || gpu_kbps[i] < best)) {
+				best = gpu_kbps[i];
+			}
+		}
+		if (best == 0 || n_bw >= BW_MAX) {
+			break;
+		}
+		bw_kbps[n_bw++] = best;
+		floor = best + 1;
+	}
+
+	/*
+	 * a6xx_gmu_rpmh_arc_votes_init (gfx over gmxc / mx) and a6xx_gmu_rpmh_dep_votes_init (mx, gbx). "Off" (index 0):
+	 * a6xx_gmu_get_arc_level gives level 0 for frequency 0, whose index is 0 in any list.
+	 */
+	gx_votes[0] = (uint32_t)gfx.level[0] << 16 | (uint32_t)arc_index(sec, gfx.level[0], true) << 8;
+	dep_votes[0] = 0xffffffff;
+	for (unsigned i = 1; i < n_gpu; i++) {
+		int p = arc_index(&gfx, gpu_level[i], false), s, m;
+
+		if (p < 0) {
+			say("gfx.lvl lacks level %u (%u MHz): no tables (Linux gives up here too)\n", gpu_level[i], gpu_mhz[i]);
+			return false;
+		}
+		s = arc_index(sec, gfx.level[p], true);
+		gx_votes[i] = (uint32_t)gfx.level[p] << 16 | (uint32_t)s << 8 | (uint32_t)p;
+		m = arc_index(&mx, gpu_level[i], true);
+		dep_votes[i] = 0x3fffu << 14 | (uint32_t)m << 8 | 0xff;
+		if (gbx.count) {
+			int bx = arc_index(&gbx, gfx.level[p], true);
+
+			dep_votes[i] = (dep_votes[i] & ~(0x3fu << 20)) | ((uint32_t)bx & 0x3f) << 20;
+		}
+	}
+	n_gmu = 1;
+	cx_votes[0] = (uint32_t)cx.level[0] << 16 | (uint32_t)arc_index(&mx, cx.level[0], true) << 8;
+	for (unsigned i = 0; i < sizeof(gmu_opps) / sizeof(gmu_opps[0]) && n_gmu < CX_MAX; i++, n_gmu++) {
+		int p = arc_index(&cx, gmu_opps[i].level, false), s;
+
+		if (p < 0) {
+			say("cx.lvl lacks level %u (GMU %u MHz): no tables\n", gmu_opps[i].level, gmu_opps[i].mhz);
+			return false;
+		}
+		s = arc_index(&mx, cx.level[p], true);
+		cx_votes[n_gmu] = (uint32_t)cx.level[p] << 16 | (uint32_t)s << 8 | (uint32_t)p;
+	}
+
+	/* a8xx_hfi_send_perf_table */
+	perf_msg[at++] = 0;
+	perf_msg[at++] = 0;
+	perf_msg[at++] = 1;                     /* HFI_TABLE_GPU_PERF */
+	perf_msg[at++] = n_gpu;
+	perf_msg[at++] = 3;
+	for (unsigned i = 0; i < n_gpu; i++) {
+		perf_msg[at++] = gx_votes[i];
+		perf_msg[at++] = dep_votes[i];
+		perf_msg[at++] = gpu_mhz[i] * 1000;
+	}
+	perf_msg[at++] = n_gmu;
+	perf_msg[at++] = 2;
+	perf_msg[at++] = cx_votes[0];
+	perf_msg[at++] = 0;
+	for (unsigned i = 1; i < n_gmu; i++) {
+		perf_msg[at++] = cx_votes[i];
+		perf_msg[at++] = gmu_opps[i - 1].mhz * 1000;
+	}
+	perf_words = at;
+	for (unsigned i = 0; i < n_gpu; i++) {
+		say("perf %2u: %4u MHz level %3u: gx vote %#010x dep %#010x\n", i, gpu_mhz[i], gpu_level[i], gx_votes[i],
+		    dep_votes[i]);
+	}
+	for (unsigned i = 0; i < n_gmu; i++) {
+		say("gmu %u: %u MHz: cx vote %#010x\n", i, i ? gmu_opps[i - 1].mhz : 0, cx_votes[i]);
+	}
+
+	/* a6xx_gmu_rpmh_bw_votes_init + a6xx_generate_bw_table */
+	bzero(bw_msg, sizeof(bw_msg));
+	for (unsigned j = 0; j < 3; j++) {
+		bw_msg[24 + j] = cmd_db_find(bcms[j].name, &aux[j], &aux_len[j]);
+		if (bw_msg[24 + j] == 0 || aux[j] == NULL || aux_len[j] < 8) {
+			say("cmd-db lacks %s (or its data): no bus table\n", bcms[j].name);
+			return false;
+		}
+		unit[j] = aux[j][0] | aux[j][1] << 8 | aux[j][2] << 16 | (uint32_t)aux[j][3] << 24;
+		width[j] = aux[j][4] | aux[j][5] << 8;
+		vcd[j] = aux[j][6];
+		if (!bcms[j].fixed && unit[j] == 0) {
+			say("cmd-db %s has unit 0: no bus table\n", bcms[j].name);
+			return false;
+		}
+	}
+	{
+		const uint8_t *cn0aux;
+		unsigned cn0len;
+
+		bw_msg[6] = cmd_db_find("CN0", &cn0aux, &cn0len);
+	}
+	say("bus: SH0 %#x (unit %u width %u vcd %u), MC0 %#x (%u %u %u), ACV %#x (%u %u %u), CN0 %#x\n", bw_msg[24], unit[0],
+	    width[0], vcd[0], bw_msg[25], unit[1], width[1], vcd[1], bw_msg[26], unit[2], width[2], vcd[2], bw_msg[6]);
+	if (bw_msg[6] == 0) {
+		say("cmd-db lacks CN0: no bus table\n");
+		return false;
+	}
+	bw_msg[1] = n_bw;
+	bw_msg[2] = 1;
+	bw_msg[3] = 3;
+	for (unsigned i = 0; i < n_bw; i++) {
+		uint32_t *d = &bw_msg[32 + 8 * i];
+
+		for (unsigned j = 0; j < 3; j++) {
+			bool commit = j == 2 || vcd[j] != vcd[j + 1];
+
+			if (bw_kbps[i] == 0) {
+				d[j] = BCM_CMD(commit, 0, 0, 0);
+			} else if (bcms[j].fixed) {
+				d[j] = BCM_CMD(commit, 1, 0, bw_kbps[i] >= bcms[j].perfmode_kbps ? bcms[j].perfmode : 0);
+			} else {
+				uint64_t peak = (uint64_t)bw_kbps[i] * width[j] / bcms[j].buswidth * 1000 / unit[j];
+				uint32_t vote = (uint32_t)(peak < 1 ? 1 : peak > 0x3fff ? 0x3fff : peak);
+
+				d[j] = BCM_CMD(commit, 1, vote, vote);
+			}
+		}
+		say("bus %u: %8u kB/s: SH0 %#010x MC0 %#010x ACV %#010x\n", i, bw_kbps[i], d[0], d[1], d[2]);
+	}
+	for (unsigned j = 0; j < 3; j++) {
+		if (bw_msg[32 + j] & BCM_CMD(1, 0, 0, 0)) {
+			bw_msg[5] |= 1u << j;
+		}
+	}
+	bw_msg[12] = BCM_CMD(1, 0, 0, 0);       /* cnoc_cmds_data[0][0] */
+	bw_msg[18] = BCM_CMD(1, 1, 0, 1);       /* cnoc_cmds_data[1][0] */
+	bw_msg[4] = 1;
+	return true;
+}
+
+/* ---- the GMU firmware (md1 fw/) ---------------------------------------------------------------------------------- */
+
+#define FW_NAME                 "gen80200_gmu.bin"
+#define SQE_NAME                "gen80200_sqe.fw"
+#define ZAP_NAME                "gen80200_zap.mbn"
+
+/*
+ * The three firmware images as symbols linked into the kernel (owner decision 1, 12 Nov: SHA-pinned files, never
+ * executed, strong symbols over weak defaults), in UniXNU's form: Adreno740/NativeAdrenoFirmwareDefaults.cpp
+ * defines native_adreno_firmware_image[1] = { 0 } and native_adreno_firmware_image_size = 0 weak, so the kernel
+ * links without firmware and a zero length is refused. These are ours, the same shape; a zero length means "no
+ * firmware": fw_check() says so and the driver stops after its read-only survey instead of starting the GPU, so
+ * nothing touches the hardware with an empty image. base/tools/mk-adreno-firmware-object.py writes the strong
+ * definitions from the pinned files and xnu-build.sh links them (XNU_GPU_FIRMWARE_OBJECT); the pins are
+ * base/configs/gpu-firmware.pins, the bytes stay in ~/mainline/build and are never committed.
+ *
+ * visibility("hidden") is not decoration: a weak definition of default visibility makes ld64 956.6 emit a weak
+ * bind (a chained-fixup import, lib_ordinal 253) for every reference to it, and this kernel's fixup walker applies
+ * rebases only (osfmk/mach/dyld_kernel_fixups.h), while the prelink refuses an image with imports. Hidden, the
+ * reference is resolved inside the image - imports 0 - and a strong definition from the firmware object still
+ * takes the place of these defaults (g5: 6 imports before, 0 after; pinned sizes in the strong build).
+ */
+__attribute__((weak, visibility("hidden"))) const uint8_t native_adreno_firmware_image[1] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t native_adreno_firmware_image_size = 0;
+__attribute__((weak, visibility("hidden"))) const uint8_t native_adreno_sqe_firmware_image[1] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t native_adreno_sqe_firmware_image_size = 0;
+__attribute__((weak, visibility("hidden"))) const uint8_t native_adreno_zap_firmware_image[1] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t native_adreno_zap_firmware_image_size = 0;
+
+struct linked_fw {
+	const char *name;
+	const uint8_t *const image;
+	const uint64_t *const size;
+};
+static const struct linked_fw linked_fws[] = {
+	{ FW_NAME, native_adreno_firmware_image, &native_adreno_firmware_image_size },
+	{ SQE_NAME, native_adreno_sqe_firmware_image, &native_adreno_sqe_firmware_image_size },
+	{ ZAP_NAME, native_adreno_zap_firmware_image, &native_adreno_zap_firmware_image_size },
+};
+
+/* A firmware image: the one linked into this kernel when it has bytes (pinned when it was linked), else md1's fw/. */
+static const uint8_t *
+fw_image(const char *name, uint64_t *size, int *disk)
+{
+	for (unsigned i = 0; i < sizeof(linked_fws) / sizeof(linked_fws[0]); i++) {
+		if (strcmp(linked_fws[i].name, name) != 0) {
+			continue;
+		}
+		if (*linked_fws[i].size != 0) {
+			*size = *linked_fws[i].size;
+			if (disk != NULL) {
+				*disk = -1;                     /* (linked in: not from a disk) */
+			}
+			return linked_fws[i].image;
+		}
+	}
+	return redwood_image_file("fw", name, size, disk);
+}
+#define ITCM_BASE               0x00000000u
+#define DTCM_BASE               0x10004000u
+#define TCM_SIZE                0x4000u
+
+struct fw_block {
+	uint32_t addr, size, type, value;
+};
+static const uint8_t *fw;
+static uint64_t fw_size;
+static uint32_t fw_version;
+
+static bool
+fw_check(void)
+{
+	uint32_t blocks = 0, itcm = 0, dtcm = 0, other = 0;
+	int disk = -1;
+
+	fw = fw_image(FW_NAME, &fw_size, &disk);
+	if (fw == NULL) {
+		say("no firmware: fw/%s is neither in md1 (userland-ipad/build.sh GPU=1 puts it there) nor linked into this "
+		    "kernel; the GPU stays off\n", FW_NAME);
+		return false;
+	}
+	fw_version = 0;
+	for (uint64_t at = 0; at + sizeof(struct fw_block) <= fw_size;) {
+		struct fw_block b;
+
+		memcpy(&b, fw + at, sizeof(b));
+		if (at + sizeof(b) + b.size > fw_size) {
+			say("fw/%s: block %u at +%#llx runs past the file's end\n", FW_NAME, blocks, at);
+			fw = NULL;
+			return false;
+		}
+		if (b.size != 0) {
+			if (b.addr - ITCM_BASE < TCM_SIZE) {
+				itcm += b.size;
+			} else if (b.addr - DTCM_BASE < TCM_SIZE) {
+				dtcm += b.size;
+				/* CORE_FW_VERSION = DTCM_START + 0xff8 dwords: DTCM byte 0x3fe0 (run ipad9 read byte 0xff8: 0) */
+				if (DTCM_BASE + 0x3fe0 >= b.addr && DTCM_BASE + 0x3fe4 <= b.addr + b.size) {
+					memcpy(&fw_version, fw + at + sizeof(b) + (DTCM_BASE + 0x3fe0 - b.addr), 4);
+				}
+			} else {
+				other += b.size;
+			}
+		}
+		blocks++;
+		at += sizeof(b) + b.size;
+	}
+	if (fw_version == 0) {
+		say("fw/%s: the version word (DTCM +0x3fe0) is not in the file: read from the GMU after the load\n", FW_NAME);
+	}
+	char where[24];
+	if (disk >= 0) {
+		snprintf(where, sizeof(where), "on md%d", disk);
+	} else {
+		strlcpy(where, "linked into this kernel", sizeof(where));
+	}
+	say("fw/%s %s: %llu bytes, %u blocks (ITCM %u, DTCM %u, memory %u bytes), version word %#x = %u.%u.%u\n",
+	    FW_NAME, where, fw_size, blocks, itcm, dtcm, other, fw_version, fw_version >> 28, fw_version >> 16 & 0xfff,
+	    fw_version & 0xffff);
+	return blocks != 0 && itcm != 0;
+}
+
+/* ---- the GMU's memory and its SMMU context ------------------------------------------------------------------------ */
+
+/* a6xx_gmu_init (a8xx) layout; the log and HFI blocks placed after the dummy page (any free address would do) */
+#define ICACHE_IOVA             0x00004000u
+#define ICACHE_SIZE             (0x1000000u - 0x4000u)
+#define DUMMY_IOVA              0x60000000u
+#define DUMMY_SIZE              0x4000u
+#define LOG_IOVA                0x60004000u
+#define LOG_SIZE                0x4000u
+#define HFI_IOVA                0x60008000u
+#define HFI_SIZE                0x4000u
+#define DEBUG_IOVA              0x60400000u
+#define DEBUG_SIZE              0x7000u
+
+#define PTE_VALID               3ull
+#define PTE_SHARED              (2ull << 8)
+#define PTE_ACCESSED            (1ull << 10)
+#define PTE_NOT_GLOBAL          (1ull << 11)
+#define PTE_GMU                 (PTE_SHARED | PTE_ACCESSED | PTE_NOT_GLOBAL)    /* attr index 0: normal non-cacheable */
+#define PTE_ADDR                0x0000fffffffff000ull
+#define TABLES_MAX              32
+/*
+ * One AArch64 4 KB page table is 512 entries of 8 bytes, whatever the kernel's page size is: the SMMU walks 4 KB
+ * tables, as UniXNU's Adreno740 (NativeAdrenoGpuContext.h:30, GpuPageBytes = 0x1000) and donyanchen's PianoA830
+ * (adreno830/NativeAdrenoGpuContext.h:28) size theirs. Four of them share one allocation, and the allocation is
+ * 4 x 4096 bytes rather than one PAGE_SIZE: on this 4 KB kernel one PAGE_SIZE held a quarter of a group, and
+ * tables 1..3 landed in whatever the kernel had put after it (g0, 12 Nov; on iPadOS 4 x 4096 == PAGE_SIZE and the
+ * old code was right by accident).
+ */
+#define TABLE_BYTES             4096u
+#define TABLES_PER_GROUP        4
+
+struct block {
+	const char *name;
+	uint32_t iova, size;
+	vm_offset_t va;
+	vm_size_t alloc;
+	uint64_t attr;                  /* page attributes; 0: the GMU's (PTE_GMU) */
+};
+/*
+ * Stage 4: the 3D core's own blocks, in the same tables (the core's context bank 0 and the GMU's bank share them, each
+ * with its own ASID), between the GMU's icache (to 16 MB) and GMEM's range (64 MB + 18 MB, UCHE_*_GC_GMEM_RANGE_MIN).
+ * Unprivileged pages for the core as dada's method; the SQE read-only.
+ */
+#define PTE_UNPRIVILEGED        (1ull << 6)
+#define PTE_READ_ONLY           (1ull << 7)
+#define PTE_CORE                (PTE_GMU | PTE_UNPRIVILEGED)
+#define RING_IOVA               0x02000000u
+#define RING_SIZE               0x8000u         /* MSM_GPU_RINGBUFFER_SZ 32 KB: CP_RB_CNTL BUFSZ 12, BLKSZ 2 */
+#define SQE_IOVA                0x02100000u
+#define SQE_SIZE                0x20000u        /* gen80200_sqe.fw: 119156 bytes (vendor 0x094), 121172 (stock) */
+#define SCRATCH_IOVA            0x02200000u     /* +0 rptr shadow, +0x40 BV rptr, +0x100 fence, +0x1000 test word */
+#define SCRATCH_SIZE            0x4000u
+#define PWRUP_IOVA              0x02300000u     /* CP_ME_INIT's power-up register list: left empty */
+#define PWRUP_SIZE              0x4000u
+#define IB_IOVA                 0x02400000u     /* stage 5: the indirect buffer, its first 4 KB page unmapped at the end */
+#define IB_SIZE                 0x4000u
+static struct block icache = { "icache", ICACHE_IOVA, ICACHE_SIZE, 0, 0, 0 }, dummy = { "dummy", DUMMY_IOVA, DUMMY_SIZE, 0, 0, 0 },
+    gmu_log = { "log", LOG_IOVA, LOG_SIZE, 0, 0, 0 }, hfi_mem = { "hfi", HFI_IOVA, HFI_SIZE, 0, 0, 0 },
+    gmu_debug = { "debug", DEBUG_IOVA, DEBUG_SIZE, 0, 0, 0 },
+    core_ring = { "ring", RING_IOVA, RING_SIZE, 0, 0, PTE_CORE },
+    core_sqe = { "sqe", SQE_IOVA, SQE_SIZE, 0, 0, PTE_CORE | PTE_READ_ONLY },
+    core_scratch = { "scratch", SCRATCH_IOVA, SCRATCH_SIZE, 0, 0, PTE_CORE },
+    core_pwrup = { "pwrup", PWRUP_IOVA, PWRUP_SIZE, 0, 0, PTE_CORE },
+    core_ib = { "ib", IB_IOVA, IB_SIZE, 0, 0, PTE_CORE };
+static struct block *const blocks[] = { &icache, &dummy, &gmu_log, &hfi_mem, &gmu_debug, &core_ring, &core_sqe,
+	                                &core_scratch, &core_pwrup, &core_ib };
+#define BLOCKS                  (sizeof(blocks) / sizeof(blocks[0]))
+
+static vm_offset_t table_pages[(TABLES_MAX + TABLES_PER_GROUP - 1) / TABLES_PER_GROUP];
+static uint64_t *tables[TABLES_MAX];
+static uint64_t table_pa[TABLES_MAX];
+static unsigned n_tables;
+
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+}
+
+static int
+table_new(void)
+{
+	if (n_tables == TABLES_MAX) {
+		return -1;
+	}
+	if (n_tables % TABLES_PER_GROUP == 0) {
+		if (kmem_alloc(kernel_map, &table_pages[n_tables / TABLES_PER_GROUP], TABLES_PER_GROUP * TABLE_BYTES,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return -1;
+		}
+	}
+	tables[n_tables] = (uint64_t *)(table_pages[n_tables / TABLES_PER_GROUP] + TABLE_BYTES * (n_tables % TABLES_PER_GROUP));
+	table_pa[n_tables] = kvtophys((vm_offset_t)tables[n_tables]);
+	return (int)n_tables++;
+}
+
+static int
+table_of(uint64_t entry)
+{
+	for (unsigned i = 0; i < n_tables; i++) {
+		if (table_pa[i] == (entry & PTE_ADDR)) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/* 4 KB granule, 39 bits, three levels; table 0 the root */
+static bool
+map_page(uint64_t iova, uint64_t pa, uint64_t attr)
+{
+	int t = 0;
+
+	if ((n_tables == 0 && table_new() != 0) || (iova >> 39)) {
+		return false;
+	}
+	for (unsigned level = 0; level < 2; level++) {
+		uint64_t *e = &tables[t][iova >> (30 - 9 * level) & 0x1ff];
+
+		if (!(*e & 1)) {
+			int n = table_new();
+
+			if (n < 0) {
+				return false;
+			}
+			*e = table_pa[n] | PTE_VALID;
+		}
+		t = table_of(*e);
+		if (t < 0) {
+			return false;
+		}
+	}
+	tables[t][iova >> 12 & 0x1ff] = (pa & PTE_ADDR) | (attr ? attr : PTE_GMU) | PTE_VALID;
+	return true;
+}
+
+static void
+memory_free(void)
+{
+	for (unsigned i = 0; i < BLOCKS; i++) {
+		if (blocks[i]->va) {
+			kmem_free(kernel_map, blocks[i]->va, blocks[i]->alloc);
+			blocks[i]->va = 0;
+		}
+	}
+	for (unsigned i = 0; i < (n_tables + TABLES_PER_GROUP - 1) / TABLES_PER_GROUP; i++) {
+		kmem_free(kernel_map, table_pages[i], TABLES_PER_GROUP * TABLE_BYTES);
+	}
+	n_tables = 0;
+}
+
+static bool
+memory_make(void)
+{
+	for (unsigned i = 0; i < BLOCKS; i++) {
+		struct block *b = blocks[i];
+
+		/*
+		 * The HFI block and the core's scratch block also get one CPU view each, mapped from their first page's
+		 * physical address over the whole size (hfi_init, the fence view): their pages must be physically
+		 * contiguous. kmem_alloc does not promise that, and run hw-1 (14 Nov) got "the HFI block is not in one
+		 * piece" and no GPU. The GMU and the core see every block page by page through the SMMU, so the others
+		 * can stay as they are.
+		 */
+		const bool contiguous = b == &hfi_mem || b == &core_scratch;
+		kern_return_t kr;
+
+		b->alloc = round_page(b->size);
+		kr = contiguous ?
+		    kmem_alloc_contig(kernel_map, &b->va, b->alloc, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) :
+		    kmem_alloc(kernel_map, &b->va, b->alloc, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT);
+		if (kr != KERN_SUCCESS) {
+			say("no memory for the GMU's %s (%#x bytes%s)\n", b->name, b->size, contiguous ? ", contiguous" : "");
+			b->va = 0;
+			return false;
+		}
+		for (uint32_t off = 0; off < b->size; off += 4096) {
+			if (!map_page(b->iova + off, kvtophys(b->va + off), b->attr)) {
+				say("no page table for %#x\n", b->iova + off);
+				return false;
+			}
+		}
+	}
+	for (unsigned i = 0; i < n_tables; i++) {
+		to_memory((vm_offset_t)tables[i], TABLE_BYTES);
+	}
+	for (unsigned i = 0; i < BLOCKS; i++) {
+		to_memory(blocks[i]->va, blocks[i]->alloc);
+	}
+	say("GPU memory: icache %#x (%u KB), dummy %#x, log %#x, hfi %#x, debug %#x; core ring %#x, sqe %#x, scratch %#x, "
+	    "pwrup %#x; %u page tables, root at %#llx\n", ICACHE_IOVA, ICACHE_SIZE / 1024, DUMMY_IOVA, LOG_IOVA, HFI_IOVA,
+	    DEBUG_IOVA, RING_IOVA, SQE_IOVA, SCRATCH_IOVA, PWRUP_IOVA, n_tables, table_pa[0]);
+	return true;
+}
+
+/* MMU-500 stage 1, 39-bit VA, 36-bit output (the Pad's SMMU: "48-bit VA -> 36-bit IPA") */
+#define CBAR_S1                 (1u << 16 | 3u << 8 | 0xfu << 12)
+#define TCR_39                  (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define TCR2_36                 (1u | 1u << 4 | 7u << 15)
+#define MAIR0_NC                0xf404ff44u
+#define SCTLR_ON                (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 12)
+#define FSR_ALL                 0xc00001feu
+
+static int ctx_cb = -1, ctx_smr = -1;
+static uint32_t ctx_old_smr, ctx_old_s2cr, ctx_old_cbar, ctx_old_cba2r, ctx_old_sctlr, ctx_old_actlr, old_scr0;
+static bool scr0_changed;
+
+static bool
+smmu_tlb_sync_global(void)
+{
+	W_SMMU(SMMU_sTLBGSYNC, "sTLBGSYNC", 0);
+	return wait_bits(smmu + SMMU_sTLBGSTATUS, 1, 0, 100000);
+}
+
+static bool
+smmu_context_on(void)
+{
+	struct snapshot *s = &after;            /* (scratch: the live SMMU state now that CX is on) */
+	uint64_t root = table_pa[0] | 1ull << 48;
+	uint32_t cb, smr = SMR_VALID | GMU_STREAM;
+
+	survey(s, true);
+	if (!s->smmu) {
+		say("SMMU not readable with CX and its clock on: stopping\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < s->nsmr; i++) {
+		if ((s->smr[i] & SMR_VALID) && ((s->smr[i] ^ GMU_STREAM) & ~(s->smr[i] >> 16) & 0x7fff) == 0) {
+			say("SMMU: SMR %u (%#x) already matches stream %u (S2CR %#x): not taking it over\n", i, s->smr[i], GMU_STREAM,
+			    s->s2cr[i]);
+			return false;
+		}
+	}
+	for (uint32_t i = 0; i < s->nsmr && ctx_smr < 0; i++) {
+		if (!(s->smr[i] & SMR_VALID)) {
+			ctx_smr = (int)i;
+		}
+	}
+	/* context bank 0 is the GPU's (arm-smmu-qcom adreno); the first other bank off and named by no S2CR */
+	for (uint32_t i = 1; i < s->ncb && ctx_cb < 0; i++) {
+		bool used = (s->cb_sctlr[i] & 1) != 0;
+
+		for (uint32_t j = 0; j < s->nsmr; j++) {
+			used |= (s->smr[j] & SMR_VALID) && (s->s2cr[j] >> 16 & 3) == 0 && (s->s2cr[j] & 0xff) == i;
+		}
+		if (!used) {
+			ctx_cb = (int)i;
+		}
+	}
+	if (ctx_smr < 0 || ctx_cb < 0) {
+		say("SMMU: no free SMR (%d) or context bank (%d)\n", ctx_smr, ctx_cb);
+		ctx_smr = ctx_cb = -1;
+		return false;
+	}
+	cb = (uint32_t)ctx_cb;
+	old_scr0 = s->scr0;
+	ctx_old_smr = s->smr[ctx_smr];
+	ctx_old_s2cr = s->s2cr[ctx_smr];
+	ctx_old_cbar = s->cbar[cb];
+	ctx_old_cba2r = rd(smmu + SMMU_CBA2R(cb));
+	ctx_old_sctlr = s->cb_sctlr[cb];
+	ctx_old_actlr = rd(smmu + SMMU_CB(cb) + CB_ACTLR);
+	say("SMMU: sCR0 %#x; SMR %d and context bank %u for the GMU's stream %u\n", s->scr0, ctx_smr, cb, GMU_STREAM);
+	W_SMMU(SMMU_CB(cb) + CB_SCTLR, "CB_SCTLR", 0);
+	W_SMMU(SMMU_CB(cb) + CB_ACTLR, "CB_ACTLR", ACTLR_ADRENO_GMU);  /* qcom_adreno_smmu_init_context */
+	W_SMMU(SMMU_CBA2R(cb), "CBA2R", 1);
+	W_SMMU(SMMU_CBAR(cb), "CBAR", CBAR_S1);
+	W_SMMU(SMMU_CB(cb) + CB_TCR2, "CB_TCR2", TCR2_36);
+	W_SMMU(SMMU_CB(cb) + CB_TCR, "CB_TCR", TCR_39);
+	W_SMMU(SMMU_CB(cb) + CB_TTBR0, "CB_TTBR0_LO", (uint32_t)root);
+	W_SMMU(SMMU_CB(cb) + CB_TTBR0 + 4, "CB_TTBR0_HI", (uint32_t)(root >> 32));
+	W_SMMU(SMMU_CB(cb) + CB_TTBR1, "CB_TTBR1_LO", 0);
+	W_SMMU(SMMU_CB(cb) + CB_TTBR1 + 4, "CB_TTBR1_HI", 0);
+	W_SMMU(SMMU_CB(cb) + CB_MAIR0, "CB_MAIR0", MAIR0_NC);
+	W_SMMU(SMMU_CB(cb) + CB_MAIR1, "CB_MAIR1", 0);
+	W_SMMU(SMMU_CB(cb) + CB_FSR, "CB_FSR", FSR_ALL);
+	W_SMMU(SMMU_CB(cb) + CB_TLBIASID, "CB_TLBIASID", 1);
+	W_SMMU(SMMU_CB(cb) + CB_TLBSYNC, "CB_TLBSYNC", 0);
+	if (!wait_bits(smmu + SMMU_CB(cb) + CB_TLBSTATUS, 1, 0, 100000)) {
+		say("SMMU: context bank %u: TLB sync does not finish\n", cb);
+		return false;
+	}
+	W_SMMU(SMMU_CB(cb) + CB_SCTLR, "CB_SCTLR", SCTLR_ON);
+	W_SMMU(SMMU_S2CR(ctx_smr), "S2CR", cb);
+	W_SMMU(SMMU_SMR(ctx_smr), "SMR", smr);
+	if (s->scr0 & sCR0_CLIENTPD) {
+		/* arm_smmu_device_reset: global TLB invalidate, then translation on (unmatched streams keep their sCR0 setting) */
+		W_SMMU(SMMU_TLBIALLNSNH, "TLBIALLNSNH", 0);
+		W_SMMU(SMMU_TLBIALLH, "TLBIALLH", 0);
+		if (!smmu_tlb_sync_global()) {
+			say("SMMU: global TLB sync does not finish\n");
+			return false;
+		}
+		W_SMMU(SMMU_sCR0, "sCR0", s->scr0 & ~sCR0_CLIENTPD);
+		scr0_changed = true;
+	}
+	if (rd(smmu + SMMU_SMR(ctx_smr)) != smr || (rd(smmu + SMMU_S2CR(ctx_smr)) & 0x300ff) != cb ||
+	    !(rd(smmu + SMMU_CB(cb) + CB_SCTLR) & 1) || rd(smmu + SMMU_CB(cb) + CB_TTBR0) != (uint32_t)root ||
+	    (rd(smmu + SMMU_sCR0) & sCR0_CLIENTPD)) {
+		say("SMMU did not take it: smr %#x s2cr %#x sctlr %#x ttbr0 %#x sCR0 %#x\n", rd(smmu + SMMU_SMR(ctx_smr)),
+		    rd(smmu + SMMU_S2CR(ctx_smr)), rd(smmu + SMMU_CB(cb) + CB_SCTLR), rd(smmu + SMMU_CB(cb) + CB_TTBR0),
+		    rd(smmu + SMMU_sCR0));
+		return false;
+	}
+	return true;
+}
+
+static bool
+smmu_faulted(const char *when)
+{
+	uint32_t fsr;
+
+	if (ctx_cb < 0) {
+		return false;
+	}
+	fsr = rd(smmu + SMMU_CB((uint32_t)ctx_cb) + CB_FSR);
+	if (!(fsr & FSR_ALL)) {
+		return false;
+	}
+	say("SMMU FAULT (%s): fsr %#x far %#x%08x fsynr0 %#x\n", when, fsr, rd(smmu + SMMU_CB((uint32_t)ctx_cb) + CB_FAR + 4),
+	    rd(smmu + SMMU_CB((uint32_t)ctx_cb) + CB_FAR), rd(smmu + SMMU_CB((uint32_t)ctx_cb) + CB_FSYNR0));
+	return true;
+}
+
+static void
+smmu_context_off(void)
+{
+	uint32_t cb;
+
+	if (ctx_cb < 0) {
+		return;
+	}
+	cb = (uint32_t)ctx_cb;
+	if (!smmu_readable()) {
+		say("SMMU: CX or its clock is off: context %u left as it is (CX's collapse resets it)\n", cb);
+		ctx_cb = ctx_smr = -1;
+		return;
+	}
+	/*
+	 * Run ipad11: CX was off at the survey, so what the kit read just after powering CX were the SMMU's reset (UNKNOWN)
+	 * values; writing those back (CB_SCTLR 0xb3be71c) and then a TLB sync raised an SError. Now: the stream unrouted,
+	 * the bank's TLB invalidated while the bank is still the kit's own valid one, then the bank off (SCTLR 0). The other
+	 * words go back to what was read only when the survey had found the SMMU powered (real state worth keeping).
+	 */
+	W_SMMU(SMMU_SMR(ctx_smr), "SMR", found.smmu ? ctx_old_smr : 0);
+	W_SMMU(SMMU_S2CR(ctx_smr), "S2CR", found.smmu ? ctx_old_s2cr : S2CR_FAULT);
+	W_SMMU(SMMU_CB(cb) + CB_TLBIASID, "CB_TLBIASID", 1);
+	W_SMMU(SMMU_CB(cb) + CB_TLBSYNC, "CB_TLBSYNC", 0);
+	if (!wait_bits(smmu + SMMU_CB(cb) + CB_TLBSTATUS, 1, 0, 100000)) {
+		say("SMMU: context %u: TLB sync does not finish\n", cb);
+	}
+	W_SMMU(SMMU_CB(cb) + CB_SCTLR, "CB_SCTLR", found.smmu ? (ctx_old_sctlr & ~1u) : 0);
+	if (found.smmu) {
+		W_SMMU(SMMU_CBAR(cb), "CBAR", ctx_old_cbar);
+		W_SMMU(SMMU_CBA2R(cb), "CBA2R", ctx_old_cba2r);
+		W_SMMU(SMMU_CB(cb) + CB_ACTLR, "CB_ACTLR", ctx_old_actlr);
+	}
+	if (scr0_changed) {
+		W_SMMU(SMMU_sCR0, "sCR0", old_scr0);
+		scr0_changed = false;
+	}
+	ctx_cb = ctx_smr = -1;
+}
+
+/* ---- TrustZone ------------------------------------------------------------------------------------------------------ */
+
+/* every SiP call of our kernel under one lock (defined in hakios_iceland_adsp.c; Linux: qcom_scm_lock) */
+#include <kern/locks.h>
+extern lck_mtx_t hakios_iceland_scm_lock;
+static int32_t scm3_unlocked(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *answer);
+
+static int32_t
+scm3(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *answer)
+{
+	int32_t r;
+
+	lck_mtx_lock(&hakios_iceland_scm_lock);
+	r = scm3_unlocked(fn, arginfo, a, b, c, answer);
+	lck_mtx_unlock(&hakios_iceland_scm_lock);
+	return r;
+}
+
+/*
+ * Stage 5 (scm_waitq): the ADSP kit's __scm_smc_do handling for answer 2 (the call parked in TZ's wait queue): resumed
+ * with QCOM_SCM_WAITQ_RESUME (SiP service 0x24 command 2, one value: the call context TZ returned in x2), every 10 ms
+ * for at most 3 s. Stages 2-4 keep their plain loop (only "interrupted" resumed), unchanged.
+ */
+static uint32_t scm_waitq;
+
+static int32_t scm4_unlocked(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t d,
+    uint64_t *answer);
+
+static int32_t
+scm3_unlocked(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *answer)
+{
+	return scm4_unlocked(fn, arginfo, a, b, c, 0, answer);
+}
+
+/* (stage 6: a fourth argument in x5, for qcom_scm_set_gpu_smmu_aperture; 0 everywhere else, as before) */
+static int32_t
+scm4_unlocked(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t d, uint64_t *answer)
+{
+	uint64_t session = 0, f = fn, ai = arginfo, xa = a, xb = b, xc = c, xd = d;
+	int waits = 0;
+
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 || f != fn ? f : 1;
+		register uint64_t x1 __asm__("x1") = ai;
+		register uint64_t x2 __asm__("x2") = xa;
+		register uint64_t x3 __asm__("x3") = xb;
+		register uint64_t x4 __asm__("x4") = xc;
+		register uint64_t x5 __asm__("x5") = xd;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 == 2 && scm_waitq && waits < 300) {
+			if (waits++ == 0) {
+				say("TZ call %#llx put in TZ's wait queue (wq %#llx, call %#llx): resumed every 10 ms\n", fn, x1, x2);
+			}
+			delay_for_interval(10, NSEC_PER_MSEC);
+			f = 1ull << 30 | 2ull << 24 | 0x24u << 8 | 2;   /* WAITQ_RESUME */
+			ai = 1;
+			xa = x2;
+			xb = xc = xd = 0;
+			session = 0;
+			i = 0;
+			continue;
+		}
+		if (x0 == 1) {
+			f = fn;                         /* "interrupted": the next round passes 1 (SCM_INTERRUPTED) */
+			continue;
+		}
+		*answer = x1;
+		return (int32_t)x0;
+	}
+	return -1;
+}
+
+static int32_t
+scm(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t *answer)
+{
+	return scm3(fn, arginfo, a, 0, 0, answer);
+}
+
+/* ---- power up: what Linux's runtime resume of the GMU does (cx genpd, clocks), undone in reverse ----------------- */
+
+static struct {
+	bool gdsc_waits, cx, gpll0_div, gemnoc, pll_configured, pll_enabled, gmu_rcg, hub_rcg;
+	bool ahb, cx_gmu, cxo, hub_cx_int, smmu_vote;
+	uint32_t gdscr, gmu_cfg, hub_cfg;
+	uint32_t pll[13];
+} took;
+
+static const uint32_t pll_regs[13] = { PLL_MODE, PLL_OPMODE, PLL_STATE, PLL_STATUS, PLL_L, PLL_ALPHA, PLL_USER_CTL,
+	                               PLL_USER_CTL_U, PLL_CONFIG_CTL, PLL_CONFIG_CTL_U, PLL_CONFIG_CTL_U1,
+	                               PLL_TEST_CTL, PLL_TEST_CTL_U };
+
+static bool
+branch_on(uint32_t cbcr, const char *name, bool *took_it, bool poll)
+{
+	if (CC(cbcr) & CBCR_ENABLE) {
+		say("%s: enabled already (%#x)\n", name, CC(cbcr));
+		return true;
+	}
+	W_CC(cbcr, name, CC(cbcr) | CBCR_ENABLE);
+	*took_it = true;
+	if (!poll) {
+		sleep_us(10);           /* BRANCH_HALT_DELAY */
+		return true;
+	}
+	if (!wait_bits(GPUCC(cbcr), CBCR_OFF, 0, 2000)) {
+		say("%s stays off (%#x)\n", name, CC(cbcr));
+		return false;
+	}
+	return true;
+}
+
+static void
+branch_back(uint32_t cbcr, const char *name, bool *took_it)
+{
+	if (*took_it) {
+		W_CC(cbcr, name, CC(cbcr) & ~CBCR_ENABLE);
+		*took_it = false;
+	}
+}
+
+/* clk_rcg2_shared: force on, configuration, update, force off */
+static bool
+rcg_set(uint32_t rcgr, uint32_t cfg, const char *name)
+{
+	char n_cmd[24], n_cfg[24];
+
+	snprintf(n_cmd, sizeof(n_cmd), "%s_CMD", name);
+	snprintf(n_cfg, sizeof(n_cfg), "%s_CFG", name);
+	W_CC(rcgr, n_cmd, CC(rcgr) | RCG_ROOT_EN);
+	W_CC(rcgr + 4, n_cfg, (CC(rcgr + 4) & ~(0x71fu | 3u << 12 | 1u << 20)) | cfg);
+	W_CC(rcgr, n_cmd, CC(rcgr) | RCG_UPDATE);
+	if (!wait_bits(GPUCC(rcgr), RCG_UPDATE, 0, 5000)) {
+		say("%s does not take its configuration (cmd %#x cfg %#x)\n", name, CC(rcgr), CC(rcgr + 4));
+		W_CC(rcgr, n_cmd, CC(rcgr) & ~RCG_ROOT_EN);
+		return false;
+	}
+	W_CC(rcgr, n_cmd, CC(rcgr) & ~RCG_ROOT_EN);
+	return true;
+}
+
+/* clk_lucid_evo_pll_configure (skipped if running) + alpha_pll_lucid_evo_enable, gpucc-kaanapali.c's 950 MHz */
+static bool
+pll0_on(void)
+{
+	vm_offset_t p = GPUCC(PLL0);
+
+	for (unsigned i = 0; i < 13; i++) {
+		took.pll[i] = rd(p + pll_regs[i]);
+	}
+	if (rd(p + PLL_USER_CTL) & PLL_VOTE_RUN) {
+		say("PLL0 is in FSM vote mode (user %#x): not this kit's to drive\n", rd(p + PLL_USER_CTL));
+		return false;
+	}
+	if ((rd(p + PLL_OPMODE) & PLL_RUN) && (rd(p + PLL_MODE) & PLL_OUTCTRL)) {
+		say("PLL0 runs already (mode %#x L %#x): left as it is\n", rd(p + PLL_MODE), rd(p + PLL_L));
+		return true;
+	}
+	took.pll_configured = true;
+	W_CC(PLL0 + PLL_L, "PLL0_L", 0x31u | 0x48u << 16);
+	W_CC(PLL0 + PLL_ALPHA, "PLL0_ALPHA", 0x7aaa);
+	W_CC(PLL0 + PLL_CONFIG_CTL, "PLL0_CONFIG_CTL", 0x25c400e7);
+	W_CC(PLL0 + PLL_CONFIG_CTL_U, "PLL0_CONFIG_CTL_U", 0x0a8062e0);
+	W_CC(PLL0 + PLL_CONFIG_CTL_U1, "PLL0_CONFIG_CTL_U1", 0xf51dea20);
+	W_CC(PLL0 + PLL_USER_CTL, "PLL0_USER_CTL", 0x00000408);
+	W_CC(PLL0 + PLL_USER_CTL_U, "PLL0_USER_CTL_U", 0x00000002);
+	W_CC(PLL0 + PLL_MODE, "PLL0_MODE", rd(p + PLL_MODE) & ~PLL_OUTCTRL);
+	W_CC(PLL0 + PLL_OPMODE, "PLL0_OPMODE", PLL_STANDBY);
+	W_CC(PLL0 + PLL_MODE, "PLL0_MODE", rd(p + PLL_MODE) | PLL_RESET_N);
+	took.pll_enabled = true;
+	W_CC(PLL0 + PLL_OPMODE, "PLL0_OPMODE", PLL_RUN);
+	if (!wait_bits(p + PLL_MODE, PLL_LOCK_DET, PLL_LOCK_DET, 1500)) {
+		say("PLL0 does not lock (mode %#x)\n", rd(p + PLL_MODE));
+		return false;
+	}
+	W_CC(PLL0 + PLL_USER_CTL, "PLL0_USER_CTL", rd(p + PLL_USER_CTL) | PLL_OUT_MASK);
+	W_CC(PLL0 + PLL_MODE, "PLL0_MODE", rd(p + PLL_MODE) | PLL_OUTCTRL);
+	say("PLL0 locked: mode %#x L %#x alpha %#x user %#x\n", rd(p + PLL_MODE), rd(p + PLL_L), rd(p + PLL_ALPHA),
+	    rd(p + PLL_USER_CTL));
+	return true;
+}
+
+static void
+pll0_back(void)
+{
+	if (took.pll_enabled) {
+		/* _alpha_pll_lucid_evo_disable (with reset, as unprepare) */
+		W_CC(PLL0 + PLL_MODE, "PLL0_MODE", CC(PLL0 + PLL_MODE) & ~PLL_OUTCTRL);
+		W_CC(PLL0 + PLL_USER_CTL, "PLL0_USER_CTL", CC(PLL0 + PLL_USER_CTL) & ~PLL_OUT_MASK);
+		W_CC(PLL0 + PLL_OPMODE, "PLL0_OPMODE", PLL_STANDBY);
+		took.pll_enabled = false;
+	}
+	if (took.pll_configured) {
+		/* the configuration words as found (MODE last: its RESET_N as found) */
+		for (unsigned i = 4; i < 13; i++) {
+			if (CC(PLL0 + pll_regs[i]) != took.pll[i]) {
+				W_CC(PLL0 + pll_regs[i], "PLL0 (as found)", took.pll[i]);
+			}
+		}
+		W_CC(PLL0 + PLL_OPMODE, "PLL0_OPMODE (as found)", took.pll[1]);
+		W_CC(PLL0 + PLL_MODE, "PLL0_MODE (as found)", took.pll[0]);
+		took.pll_configured = false;
+	}
+}
+
+static uint32_t ao_hz, gmu_on_xo;
+
+static bool
+power_up(void)
+{
+	uint32_t before, after_count;
+	uint64_t t0, ns;
+
+	say("power: CX switch (GDSCR %#x, status %#x)\n", CC(CX_GDSCR), CC(CX_GDS_HW_CTRL));
+	took.gdscr = CC(CX_GDSCR);
+	if ((took.gdscr & GDSC_WAIT_MASK) != GDSC_WAIT_CX) {
+		W_CC(CX_GDSCR, "CX_GDSCR (waits)", (CC(CX_GDSCR) & ~GDSC_WAIT_MASK) | GDSC_WAIT_CX);
+		took.gdsc_waits = true;
+	}
+	if (!cx_on()) {
+		W_CC(CX_GDSCR, "CX_GDSCR", CC(CX_GDSCR) & ~GDSC_SW_COLLAPSE);
+		took.cx = true;
+		sleep_us(1);
+		if (!wait_bits(GPUCC(CX_GDS_HW_CTRL), GDSC_POWER_ON, GDSC_POWER_ON, 2000)) {
+			say("CX does not come on (GDSCR %#x, status %#x)\n", CC(CX_GDSCR), CC(CX_GDS_HW_CTRL));
+			return false;
+		}
+		sleep_us(1);
+	} else {
+		say("CX is on already (another voter)\n");
+	}
+	if (!(CC(CX_GDSCR) & GDSC_RETAIN_FF)) {
+		W_CC(CX_GDSCR, "CX_GDSCR (retain ff)", CC(CX_GDSCR) | GDSC_RETAIN_FF);
+	}
+
+	say("power: GCC's GPLL0_DIV vote for the hub, gpu_gemnoc_gfx\n");
+	if (!(rd(gcc + GCC_GPLL0_VOTE) & GCC_VOTE_GPLL0_DIV)) {
+		W_GCC(GCC_GPLL0_VOTE, "GCC_GPLL0_VOTE", rd(gcc + GCC_GPLL0_VOTE) | GCC_VOTE_GPLL0_DIV);
+		took.gpll0_div = true;
+		sleep_us(10);
+	}
+
+	took.gmu_cfg = CC(GMU_RCGR + 4);
+	took.hub_cfg = CC(HUB_RCGR + 4);
+	if (gmu_on_xo) {
+		/* icegpu_xo=1: the GMU left on its 19.2 MHz XO root, as data-a-live's first GMU boots on SM8850 ran */
+		say("power: icegpu_xo=1: no PLL0, the GMU's root left as found (cfg %#x)\n", took.gmu_cfg);
+	} else {
+		say("power: PLL0 (950 MHz, even 475 MHz for the GMU)\n");
+		if (!pll0_on()) {
+			return false;
+		}
+		took.gmu_rcg = true;
+		if (!rcg_set(GMU_RCGR, RCG_CFG_GMU_475, "GMU_RCGR")) {
+			return false;
+		}
+	}
+	took.hub_rcg = true;
+	if (!rcg_set(HUB_RCGR, RCG_CFG_HUB_150, "HUB_RCGR")) {
+		return false;
+	}
+
+	/* a6xx_gmu_resume: clk_bulk_prepare_enable in the DT's order (ahb, gmu, cxo, memnoc, hub), the SMMU's clock */
+	if (!branch_on(CBCR_AHB, "CBCR_AHB", &took.ahb, false) || !branch_on(CBCR_CX_GMU, "CBCR_CX_GMU", &took.cx_gmu, true) ||
+	    !branch_on(CBCR_CXO, "CBCR_CXO", &took.cxo, true)) {
+		return false;
+	}
+	if (!(rd(gcc + GCC_GPU_GEMNOC_GFX_CBCR) & CBCR_ENABLE)) {
+		W_GCC(GCC_GPU_GEMNOC_GFX_CBCR, "GCC_GPU_GEMNOC_GFX_CBCR", rd(gcc + GCC_GPU_GEMNOC_GFX_CBCR) | CBCR_ENABLE);
+		took.gemnoc = true;
+		if (!wait_bits(gcc + GCC_GPU_GEMNOC_GFX_CBCR, CBCR_OFF, 0, 2000)) {
+			say("gcc gpu_gemnoc_gfx reads off (%#x): voted clock, not relied on\n", rd(gcc + GCC_GPU_GEMNOC_GFX_CBCR));
+		}
+	}
+	if (!branch_on(CBCR_HUB_CX_INT, "CBCR_HUB_CX_INT", &took.hub_cx_int, true) ||
+	    !branch_on(CBCR_SMMU_VOTE, "CBCR_SMMU_VOTE", &took.smmu_vote, true)) {
+		return false;
+	}
+	if (!gmu_readable()) {
+		say("the GMU's clocks do not all read on: stopping\n");
+		return false;
+	}
+	t0 = mach_absolute_time();
+	before = G(G8_GMU_ALWAYS_ON_COUNTER_L);
+	sleep_ms(10);
+	after_count = G(G8_GMU_ALWAYS_ON_COUNTER_L);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	ao_hz = ns ? (uint32_t)((uint64_t)(after_count - before) * NSEC_PER_SEC / ns) : 0;
+	say("power: up. GMU always-on counter %u Hz (19.2 MHz expected); sysreset %#x, version word %#x, rscc status0 %#x\n",
+	    ao_hz, G(G8_GMU_CM3_SYSRESET), G(G8_GMU_CORE_FW_VERSION), RSCC(G8_GPU_RSCC_RSC_STATUS0_DRV0));
+	return true;
+}
+
+/* everything taken, given back in reverse, to the values found */
+static void
+power_back(void)
+{
+	branch_back(CBCR_SMMU_VOTE, "CBCR_SMMU_VOTE", &took.smmu_vote);
+	branch_back(CBCR_HUB_CX_INT, "CBCR_HUB_CX_INT", &took.hub_cx_int);
+	if (took.gemnoc) {
+		W_GCC(GCC_GPU_GEMNOC_GFX_CBCR, "GCC_GPU_GEMNOC_GFX_CBCR", rd(gcc + GCC_GPU_GEMNOC_GFX_CBCR) & ~CBCR_ENABLE);
+		took.gemnoc = false;
+	}
+	branch_back(CBCR_CXO, "CBCR_CXO", &took.cxo);
+	branch_back(CBCR_CX_GMU, "CBCR_CX_GMU", &took.cx_gmu);
+	branch_back(CBCR_AHB, "CBCR_AHB", &took.ahb);
+	if (took.hub_rcg) {
+		if ((CC(HUB_RCGR + 4) & (0x71fu | 3u << 12 | 1u << 20)) != (took.hub_cfg & (0x71fu | 3u << 12 | 1u << 20))) {
+			(void)rcg_set(HUB_RCGR, took.hub_cfg & (0x71fu | 3u << 12 | 1u << 20), "HUB_RCGR");
+		}
+		took.hub_rcg = false;
+	}
+	if (took.gmu_rcg) {
+		if ((CC(GMU_RCGR + 4) & (0x71fu | 3u << 12 | 1u << 20)) != (took.gmu_cfg & (0x71fu | 3u << 12 | 1u << 20))) {
+			(void)rcg_set(GMU_RCGR, took.gmu_cfg & (0x71fu | 3u << 12 | 1u << 20), "GMU_RCGR");
+		}
+		took.gmu_rcg = false;
+	}
+	pll0_back();
+	if (took.gpll0_div) {
+		W_GCC(GCC_GPLL0_VOTE, "GCC_GPLL0_VOTE", rd(gcc + GCC_GPLL0_VOTE) & ~GCC_VOTE_GPLL0_DIV);
+		took.gpll0_div = false;
+	}
+	if (took.cx) {
+		/* a votable GDSC: collapse asked for, not polled (gdsc_toggle_logic); its state read after 1 ms */
+		W_CC(CX_GDSCR, "CX_GDSCR", CC(CX_GDSCR) | GDSC_SW_COLLAPSE);
+		took.cx = false;
+		sleep_ms(1);
+		say("CX switch: collapse asked, status %#x (%s)\n", CC(CX_GDS_HW_CTRL), cx_on() ? "STILL ON: another voter" :
+		    "off");
+	}
+	if (took.gdsc_waits || (CC(CX_GDSCR) & GDSC_RETAIN_FF) != (took.gdscr & GDSC_RETAIN_FF)) {
+		uint32_t mask = GDSC_WAIT_MASK | GDSC_RETAIN_FF;
+
+		W_CC(CX_GDSCR, "CX_GDSCR (waits / retain as found)", (CC(CX_GDSCR) & ~mask) | (took.gdscr & mask));
+		took.gdsc_waits = false;
+	}
+}
+
+/* ---- the GMU ------------------------------------------------------------------------------------------------------ */
+
+struct hfi_queue_header {
+	uint32_t status, iova, type, size, msg_size, dropped, rx_watermark, tx_watermark, rx_request, tx_request, read_index,
+	    write_index;
+};
+struct hfi_table_header {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
+};
+#define HFI_QUEUES              3
+#define HFI_QUEUE_WORDS         1024
+
+static volatile uint8_t *hfi;           /* uncached view of the HFI block */
+static bool gmu_started, oob_set, fw_loaded;
+static uint32_t hfi_seq;
+
+static volatile struct hfi_queue_header *
+hfi_q(unsigned n)
+{
+	return (volatile struct hfi_queue_header *)(hfi + sizeof(struct hfi_table_header)) + n;
+}
+
+static volatile uint32_t *
+hfi_data(unsigned n)
+{
+	return (volatile uint32_t *)(hfi + 4096 * (n + 1));
+}
+
+/* a6xx_hfi_init */
+static bool
+hfi_init(void)
+{
+	volatile struct hfi_table_header *t;
+
+	/*
+	 * An unmappable I/O view (ml_io_unmap at the end): run ipad12 panicked in vm_map_delete, "Attempting to remove permanent VM
+	 * map entry", because ml_io_map_wcomb's mappings are permanent. The kmem_alloc'd blocks themselves are not KMA_PERMANENT.
+	 */
+	hfi = (volatile uint8_t *)ml_io_map_unmappable((vm_offset_t)kvtophys(hfi_mem.va), HFI_SIZE, VM_WIMG_WCOMB);
+	if (hfi == NULL || kvtophys(hfi_mem.va + HFI_SIZE - 1) != kvtophys(hfi_mem.va) + HFI_SIZE - 1) {
+		say("the HFI block is not in one piece\n");
+		return false;
+	}
+	to_memory(hfi_mem.va, HFI_SIZE);
+	t = (volatile struct hfi_table_header *)hfi;
+	t->version = 0;
+	t->size = sizeof(struct hfi_table_header) + HFI_QUEUES * sizeof(struct hfi_queue_header);
+	t->qhdr0_offset = sizeof(struct hfi_table_header) / 4;
+	t->qhdr_size = sizeof(struct hfi_queue_header) / 4;
+	t->num_queues = t->active_queues = HFI_QUEUES;
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		volatile struct hfi_queue_header *h = hfi_q(i);
+
+		h->iova = HFI_IOVA + 4096 * (i + 1);
+		h->type = 10u << 8 | i;
+		h->status = 1;
+		h->size = HFI_QUEUE_WORDS;
+		h->msg_size = h->dropped = 0;
+		h->rx_watermark = h->tx_watermark = h->rx_request = 1;
+		h->tx_request = 0;
+		h->read_index = h->write_index = 0;
+	}
+	settle();
+	return true;
+}
+
+static void
+gmu_log_tail(void)
+{
+	const volatile uint32_t *log = (const volatile uint32_t *)gmu_log.va;
+	uint32_t next = G(G8_GMU_GENERAL_9) & 0xffff;
+
+	to_memory(gmu_log.va, LOG_SIZE);
+	say("GMU: init %#x hfi %#x g2h %#x ao %#x pwr %#x rpmh %#x busy %#x rscc %#x, log at %u\n", G(G8_GMU_CM3_FW_INIT_RESULT),
+	    G(G8_GMU_HFI_CTRL_STATUS), G(G8_GMU_GMU2HOST_INTR_INFO), G(G8_GMU_AO_HOST_INTERRUPT_STATUS),
+	    G(G8_GMU_PWR_CLK_STATUS), G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE), G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS),
+	    RSCC(G8_GPU_RSCC_RSC_STATUS0_DRV0), next);
+	for (uint32_t i = next > 16 ? next - 16 : 0; i < next && i + 2 <= LOG_SIZE / 16; i += 2) {
+		say("  log %x %x %x %x | %x %x %x %x\n", log[4 * i], log[4 * i + 1], log[4 * i + 2], log[4 * i + 3],
+		    log[4 * i + 4], log[4 * i + 5], log[4 * i + 6], log[4 * i + 7]);
+	}
+	(void)smmu_faulted("GMU state");
+}
+
+static bool
+hfi_receive(unsigned q, uint32_t seq, uint32_t *error)
+{
+	volatile struct hfi_queue_header *h = hfi_q(q);
+	volatile uint32_t *data = hfi_data(q);
+	bool answered = false;
+
+	while (h->read_index != h->write_index) {
+		uint32_t m[8] = { 0 }, at = h->read_index % HFI_QUEUE_WORDS, words = data[at] >> 8 & 0xff;
+
+		for (uint32_t i = 0; i < words; i++) {
+			if (i < 8) {
+				m[i] = data[at];
+			}
+			at = (at + 1) % HFI_QUEUE_WORDS;
+		}
+		h->read_index = (at + 3) / 4 * 4 % HFI_QUEUE_WORDS;
+		/*
+		 * a6xx_hfi_wait_for_ack: the answer is struct a6xx_hfi_msg_response {header, ret_header, error, payload}: its
+		 * header carries the id of the message answered and type 1 (bits 19:16), ret_header the original header with
+		 * our seqnum in bits 31:20. Run ipad11's "0x1030f 0x104c0f 0" was the perf table's ack (id 15, seq 1, 76
+		 * words, error 0), which an id-126 test missed.
+		 */
+		if ((m[0] >> 16 & 0xf) == 1 && (m[0] & 0xff) != 100 && (m[1] >> 20 & 0xfff) == seq) {
+			*error = m[2];
+			answered = true;
+		} else if ((m[0] & 0xff) == 100) {                      /* HFI_F2H_MSG_ERROR */
+			say("THE GMU REPORTS AN ERROR: %#x %#x %#x %#x\n", m[1], m[2], m[3], m[4]);
+		} else {
+			say("the GMU says (queue %u, %u words): %#x %#x %#x %#x\n", q, words, m[0], m[1], m[2], m[3]);
+		}
+		if (words == 0) {
+			break;
+		}
+	}
+	return answered;
+}
+
+static bool hfi_quiet;                 /* (icegpu_dcvs: the level votes' own lines instead of two HFI lines each) */
+static uint32_t fixed_speed;            /* the icegpu_speed level gmu_up voted (icegpu_dcvs falls back to it) */
+
+/* a6xx_hfi_send_msg + a6xx_hfi_wait_for_ack (polled) */
+static bool
+hfi_send(const char *what, uint32_t id, uint32_t *msg, uint32_t words)
+{
+	volatile struct hfi_queue_header *h = hfi_q(0);
+	volatile uint32_t *data = hfi_data(0);
+	uint32_t at = h->write_index % HFI_QUEUE_WORDS, seq = ++hfi_seq % 0xfff, error = 0;
+	bool answered = false;
+
+	msg[0] = seq << 20 | words << 8 | id;
+	if (!hfi_quiet) {
+		say("HFI > %s (message %u, %u words)\n", what, id, words);
+	}
+	for (uint32_t i = 0; i < (words + 3) / 4 * 4; i++) {
+		data[at] = i < words ? msg[i] : 0xfafafafa;
+		at = (at + 1) % HFI_QUEUE_WORDS;
+	}
+	settle();
+	h->write_index = at;
+	settle();
+	W_G(G8_GMU_HOST2GMU_INTR_SET, 1);
+	for (int i = 0; i < 10000 && !answered; i++) {
+		sleep_us(100);
+		if (G(G8_GMU_GMU2HOST_INTR_INFO) & 1) {
+			W_G(G8_GMU_GMU2HOST_INTR_CLR, 1);
+			answered = hfi_receive(1, seq, &error);
+		}
+	}
+	(void)hfi_receive(2, ~0u, &error);
+	if (!answered || error != 0) {
+		say("HFI < %s: %s (%#x)\n", what, answered ? "REFUSED" : "NO ANSWER in 1 s", error);
+		gmu_log_tail();
+		return false;
+	}
+	if (!hfi_quiet) {
+		say("HFI < %s: ok\n", what);
+	}
+	return true;
+}
+
+static uint32_t chip_id;
+
+static bool
+gmu_up(uint32_t speed)
+{
+	uint32_t mask, want, result = 0, wrong = 0, words = 0, in_mem = 0, unmatched = 0, slices, granted = 0;
+	uint32_t empty[2] = { 0, 0 }, vote[4] = { 0 };
+	uint64_t answer = ~0ull;
+	int32_t r;
+
+	if (!hfi_init()) {
+		return false;
+	}
+	/* a6xx_gmu_secure_init (a8xx): TrustZone sets the GPU's software fuses */
+	r = scm(1ull << 30 | 2ull << 24 | 0x28u << 8 | 1, 1, 1u << 0 | 1u << 3, &answer);
+	say("TZ gpu_init_regs (ALWAYS_EN | TSENSE_EN): returns %d (%#llx); sw fuse %#x\n", r, answer,
+	    CXM(G8_CX_MISC_CX_MISC_SW_FUSE_VALUE));
+	if (r != 0) {
+		say("TrustZone refuses gpu_init_regs: stopping (Linux stops here too)\n");
+		return false;
+	}
+
+	/* a8xx_gpu_get_slice_info: the chip id is the DT's with the slice count in bits 7:4 */
+	slices = CXM(G8_CX_MISC_CX_MISC_SLICE_ENABLE_FINAL) & 7;
+	chip_id = DT_CHIP_ID | (uint32_t)__builtin_popcount(slices) << 4;
+	say("CHIP ID %#x (DT 0x44050a01, slice mask %#x: %u slices; Fedora: 0x44050a31)\n", chip_id, slices,
+	    __builtin_popcount(slices));
+
+	W_G(G8_GMU_AO_HOST_INTERRUPT_CLR, 0xffffffff);
+	W_G(G8_GMU_AO_HOST_INTERRUPT_MASK, 0xffffffff);
+	say("boot: %s (TCM_RET_CNTL %#x)\n", CXM(G8_CX_MISC_CX_MISC_TCM_RET_CNTL) == 1 ? "warm (Linux would skip the load)" :
+	    "cold", CXM(G8_CX_MISC_CX_MISC_TCM_RET_CNTL));
+
+	/* a6xx_gmu_fw_start */
+	W_G(G8_GPU_GMU_CX_GMU_CX_FALNEXT_INTF, 1);
+	W_G(G8_GPU_GMU_CX_GMU_CX_FAL_INTF, 1);
+	if (RSCC(G8_GPU_RSCC_RSC_STATUS0_DRV0) & RSCC_ASLEEP_A840) {
+		/* a6xx_rpmh_start (Linux runs it after its own rpmh_stop; here when the RSCC reads asleep) */
+		say("the RSCC reads asleep (status0 %#x): woken\n", RSCC(G8_GPU_RSCC_RSC_STATUS0_DRV0));
+		W_G(G8_GMU_RSCC_CONTROL_REQ, 1u << 1);
+		if (!wait_bits(gpu + 4UL * G8_GMU_RSCC_CONTROL_ACK, 1u << 1, 1u << 1, 10000) ||
+		    !wait_bits(gpu + RSCC_OFF + 4UL * G8_RSCC_SEQ_BUSY_DRV0, ~0u, 0, 10000)) {
+			say("the RSCC does not wake (ack %#x busy %#x)\n", G(G8_GMU_RSCC_CONTROL_ACK), RSCC(G8_RSCC_SEQ_BUSY_DRV0));
+			W_G(G8_GMU_RSCC_CONTROL_REQ, 0);
+			return false;
+		}
+		W_G(G8_GMU_RSCC_CONTROL_REQ, 0);
+	}
+
+	/* a6xx_gmu_fw_load: ITCM / DTCM through registers (the CM3 held in reset first, as dada's method), the rest in memory */
+	W_G(G8_GMU_CM3_SYSRESET, 1);
+	for (int pass = 0; pass < 2; pass++) {
+		for (uint64_t at = 0; at + sizeof(struct fw_block) <= fw_size;) {
+			struct fw_block b;
+			const uint8_t *d = fw + at + sizeof(b);
+
+			memcpy(&b, fw + at, sizeof(b));
+			at += sizeof(b) + b.size;
+			if (b.size == 0) {
+				continue;
+			}
+			if (b.addr - ITCM_BASE < TCM_SIZE || b.addr - DTCM_BASE < TCM_SIZE) {
+				uint32_t reg = b.addr < DTCM_BASE ? G8_GMU_CM3_ITCM_START + (b.addr - ITCM_BASE) / 4 :
+				    G8_GMU_CM3_DTCM_START + (b.addr - DTCM_BASE) / 4;
+
+				for (uint32_t o = 0; o + 4 <= b.size; o += 4) {
+					uint32_t w;
+
+					memcpy(&w, d + o, 4);
+					if (pass == 0) {
+						wr(gpu + 4UL * (reg + o / 4), w);
+						words++;
+					} else if (G(reg + o / 4) != w) {
+						wrong++;
+					}
+				}
+				continue;
+			}
+			if (pass == 1) {
+				continue;
+			}
+			if (b.addr >= ICACHE_IOVA && b.addr + b.size <= ICACHE_IOVA + ICACHE_SIZE) {
+				memcpy((void *)(icache.va + (b.addr - ICACHE_IOVA)), d, b.size);
+				in_mem += b.size;
+			} else if (b.addr >= DUMMY_IOVA && b.addr + b.size <= DUMMY_IOVA + DUMMY_SIZE) {
+				memcpy((void *)(dummy.va + (b.addr - DUMMY_IOVA)), d, b.size);
+				in_mem += b.size;
+			} else {
+				unmatched++;
+				say("fw block %#x (%u bytes) matches no memory (Linux: \"failed to match fw block\", goes on)\n", b.addr,
+				    b.size);
+			}
+		}
+	}
+	writes += words;
+	fw_loaded = true;
+	to_memory(icache.va, icache.alloc);
+	to_memory(dummy.va, dummy.alloc);
+	to_memory(gmu_debug.va, gmu_debug.alloc);
+	to_memory(gmu_log.va, gmu_log.alloc);
+	say("fw: %u TCM words written through registers (not listed one by one), %u read back wrong; %u bytes into memory, "
+	    "%u blocks unmatched; version word %#x (file %#x)\n", words, wrong, in_mem, unmatched, G(G8_GMU_CORE_FW_VERSION),
+	    fw_version);
+	if (wrong != 0) {
+		return false;
+	}
+	W_G(G8_GMU_CM3_FW_INIT_RESULT, 0);
+	W_G(G8_GMU_CM3_BOOT_CONFIG, 2);
+	W_G(G8_GMU_HFI_QTBL_ADDR, HFI_IOVA);
+	W_G(G8_GMU_HFI_QTBL_INFO, 1);
+	W_G(G8_GMU_AHB_FENCE_RANGE_0, 1u << 31 | 0x32u << 18 | 0x8c0);
+	W_G(G8_GMU_CM3_CFG, 0x4052);
+	W_G(G8_GMU_GENERAL_10, GMU_CHIPID);
+	W_G(G8_GMU_GENERAL_8, (LOG_IOVA & 0xfffff000u) | (LOG_SIZE / 4096 - 1));
+	for (unsigned i = 0; i < 4; i++) {
+		W_G(G8_GBIF_QSB_SIDE0 + i, 0x00071e20);
+	}
+	W_G(G8_GBIF_CX_CONFIG, 0x20023000);
+	W_G(G8_GBIF_CX_CONFIG, 0x20023000);
+	W_G(G8_GMU_MRC_GBIF_QOS_CTRL, 0x33);
+	W_G(G8_GMU_SYS_BUS_CONFIG, 1);
+	W_G(G8_GMU_ICACHE_CONFIG, 1);
+	W_G(G8_GMU_DCACHE_CONFIG, 1);
+
+	/* a6xx_gmu_start */
+	if (G(G8_GMU_CORE_FW_VERSION) <= 0x20010004) {
+		mask = 0xffffffff;
+		want = 0xbabeface;
+	} else {
+		mask = 0x1ff;
+		want = 0x100;
+	}
+	say("the GMU's CM3 out of reset (firmware %#x)\n", G(G8_GMU_CORE_FW_VERSION));
+	W_G(G8_GMU_CM3_SYSRESET, 1);
+	W_G(G8_GMU_GENERAL_9, 0);
+	gmu_started = true;
+	W_G(G8_GMU_CM3_SYSRESET, 0);
+	for (int i = 0; i < 1000 && (result & mask) != want; i++) {
+		sleep_us(100);
+		result = G(G8_GMU_CM3_FW_INIT_RESULT);
+	}
+	if ((result & mask) != want) {
+		say("the GMU firmware does not come up (init result %#x)\n", result);
+		gmu_log_tail();
+		return false;
+	}
+	say("THE GMU FIRMWARE RUNS (init result %#x)\n", result);
+	if (smmu_faulted("GMU start")) {
+		return false;
+	}
+
+	/* a6xx_gmu_hfi_start */
+	W_G(G8_GMU_HFI_CTRL_INIT, 1);
+	if (!wait_bits(gpu + 4UL * G8_GMU_HFI_CTRL_STATUS, 1, 1, 100000)) {
+		say("the GMU does not start HFI (status %#x)\n", G(G8_GMU_HFI_CTRL_STATUS));
+		gmu_log_tail();
+		return false;
+	}
+	say("THE GMU'S HFI QUEUES ARE UP (status %#x)\n", G(G8_GMU_HFI_CTRL_STATUS));
+	/*
+	 * a6xx_gmu_resume after a6xx_hfi_start: GMU2HOST cleared, its mask ~CM3_FAULT (bit 23). data-a-live's run on the
+	 * same Adreno 840 (their patch 0170) got no OOB ack with everything masked and the OOB first; with Linux's order
+	 * (mask, vote, then OOB) it did.
+	 */
+	W_G(G8_GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	W_G(G8_GMU_GMU2HOST_INTR_MASK, ~(1u << 23));
+
+	/* a6xx_hfi_start (non-legacy): perf table, bw table, [ACD / BCL / CLX / IFPC / thinmem left out], core fw start, start */
+	if (!hfi_send("perf table", 15, perf_msg, perf_words) || !hfi_send("bw table", 3, bw_msg, BW_WORDS) ||
+	    !hfi_send("core fw start", 14, empty, 2) || !hfi_send("start", 10, empty, 1)) {
+		return false;
+	}
+
+	/* a6xx_gmu_set_initial_freq -> a6xx_hfi_set_freq: blocking, perf index, the index of its OPP's bandwidth */
+	fixed_speed = speed;
+	vote[1] = 1;
+	vote[2] = speed;
+	for (unsigned i = 1; i < n_bw; i++) {
+		if (bw_kbps[i] == gpu_kbps[speed]) {
+			vote[3] = i;
+		}
+	}
+	say("speed: perf %u = %u MHz, bus level %u (%u kB/s)\n", speed, gpu_mhz[speed], vote[3], bw_kbps[vote[3]]);
+	if (!hfi_send("GX_BW_PERF_VOTE", 30, vote, 4)) {
+		return false;
+	}
+
+	/* a6xx_gmu_set_oob(GMU_OOB_GPU_SET), non-legacy bits: request 30, ack 31 */
+	say("OOB GPU set: asking the GMU for the GPU's power\n");
+	oob_set = true;
+	W_G(G8_GMU_HOST2GMU_INTR_SET, OOB_GPU_SET);
+	for (int i = 0; i < 10000 && !(granted & OOB_GPU_ACK); i++) {
+		sleep_us(100);
+		granted = G(G8_GMU_GMU2HOST_INTR_INFO);
+	}
+	W_G(G8_GMU_GMU2HOST_INTR_CLR, OOB_GPU_ACK);
+	(void)wait_bits(gpu + 4UL * G8_GMU_PWR_CLK_STATUS, 3, 0, 100000);      /* a8xx_gmu_gx_is_on, up to 100 ms */
+	say("OOB GPU: g2h %#x, gmu pwr/clk %#x, cx_misc gfx pwr/clk %#x, gx gdscr %#x, rpmh state %#x\n", granted,
+	    G(G8_GMU_PWR_CLK_STATUS), CXM(G8_CX_MISC_CX_MISC_GFX_PWR_CLK_STATUS), rd(gpu + GX_GDSCR_OFF),
+	    G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+	if (!(granted & OOB_GPU_ACK)) {
+		say("the GMU does not grant the GPU's power in 1 s\n");
+		gmu_log_tail();
+		return false;
+	}
+	if (G(G8_GMU_PWR_CLK_STATUS) & 3) {
+		say("GX reads off after the grant (pwr/clk %#x): the 3D core's registers not read\n", G(G8_GMU_PWR_CLK_STATUS));
+	} else {
+		say("THE GPU HAS POWER: rbbm status %#x status1 %#x int0 %#x, cp sqe cntl %#x, cp rb base %#x, "
+		    "slice enable %#x; chip id %#x\n", G(G8_RBBM_STATUS), G(G8_RBBM_STATUS1), G(G8_RBBM_INT_0_STATUS),
+		    G(G8_CP_SQE_CNTL), G(G8_CP_RB_BASE), CXM(G8_CX_MISC_CX_MISC_SLICE_ENABLE_FINAL), chip_id);
+	}
+	/* a6xx_gmu_clear_oob(GMU_OOB_GPU_SET): clear bit 31 */
+	W_G(G8_GMU_HOST2GMU_INTR_SET, OOB_GPU_CLEAR);
+	oob_set = false;
+	return !smmu_faulted("OOB GPU");
+}
+
+/* a6xx_rpmh_stop (a840: status bit 30) */
+static void
+rpmh_stop(void)
+{
+	W_G(G8_GMU_RSCC_CONTROL_REQ, 1);
+	if (!wait_bits(gpu + RSCC_OFF + 4UL * G8_GPU_RSCC_RSC_STATUS0_DRV0, RSCC_ASLEEP_A840, RSCC_ASLEEP_A840, 10000)) {
+		say("the RSCC does not go to sleep (status0 %#x)\n", RSCC(G8_GPU_RSCC_RSC_STATUS0_DRV0));
+	}
+	W_G(G8_GMU_RSCC_CONTROL_REQ, 0);
+}
+
+static void
+hfi_stop(void)
+{
+	for (unsigned i = 0; hfi != NULL && i < HFI_QUEUES; i++) {
+		if (hfi_q(i)->read_index != hfi_q(i)->write_index) {
+			say("HFI queue %u is not empty\n", i);
+		}
+		hfi_q(i)->read_index = 0;
+		hfi_q(i)->write_index = 0;
+	}
+}
+
+/* a6xx_gmu_force_off (no bus halt / soft reset: no command reached the core) */
+static void
+gmu_force_off(void)
+{
+	say("down: the short way (a6xx_gmu_force_off)\n");
+	if (oob_set) {
+		W_G(G8_GMU_HOST2GMU_INTR_SET, OOB_GPU_CLEAR);
+		oob_set = false;
+	}
+	W_G(G8_GMU_GMU_PWR_COL_KEEPALIVE, 0);
+	hfi_stop();
+	W_G(G8_GMU_AO_HOST_INTERRUPT_MASK, 0xffffffff);
+	W_G(G8_GMU_GMU2HOST_INTR_MASK, 0xffffffff);
+	W_G(G8_GPU_GMU_CX_GMU_CX_FALNEXT_INTF, 1);
+	W_G(G8_GMU_AHB_FENCE_STATUS_CLR, 7);
+	W_G(G8_GMU_AO_AHB_FENCE_CTRL, 0);
+	settle();
+	W_G(G8_GMU_CM3_SYSRESET, 1);
+	if (gmu_started) {
+		rpmh_stop();
+	}
+	gmu_started = false;
+}
+
+/* a6xx_gmu_shutdown; false if it had to fall back */
+static bool
+gmu_shutdown(void)
+{
+	uint32_t prep[3] = { 0, 0, 0 };
+
+	say("down: the clean way (a6xx_gmu_shutdown)\n");
+	if (!wait_bits(gpu + 4UL * G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS, CX_BUSY_GPU, 0, 100000)) {
+		say("the GMU does not go idle (busy %#x)\n", G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS));
+		gmu_force_off();
+		return false;
+	}
+	/* a6xx_gmu_notify_slumber */
+	W_G(G8_GMU_CX_GMU_POWER_COUNTER_ENABLE, 0);
+	if (!hfi_send("PREPARE_SLUMBER", 33, prep, 3)) {
+		W_G(G8_GMU_AO_AHB_FENCE_CTRL, 0);
+		W_G(G8_GPU_GMU_CX_GMU_CX_FALNEXT_INTF, 1);
+		gmu_force_off();
+		return false;
+	}
+	W_G(G8_GMU_AO_AHB_FENCE_CTRL, 0);
+	W_G(G8_GPU_GMU_CX_GMU_CX_FALNEXT_INTF, 1);
+	if (!wait_bits(gpu + 4UL * G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS, CX_BUSY_CXGXCPU, 0, 100000)) {
+		say("unable to slumber: busy %#x / %#x (going on, as Linux)\n", G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS),
+		    G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS2));
+	}
+	hfi_stop();
+	W_G(G8_GMU_AO_HOST_INTERRUPT_MASK, 0xffffffff);
+	W_G(G8_GMU_GMU2HOST_INTR_MASK, 0xffffffff);
+	W_G(G8_GMU_CM3_SYSRESET, 1);
+	rpmh_stop();
+	gmu_started = false;
+	return true;
+}
+
+/* a6xx_gmu_gxpd_put (a8xx): GX collapsed in hardware only if it is stuck on */
+static void
+gx_check(void)
+{
+	uint32_t st = G(G8_GMU_PWR_CLK_STATUS);
+
+	if ((st & 3) == 3) {
+		say("GX is off (gmu pwr/clk %#x, gx gdscr %#x)\n", st, rd(gpu + GX_GDSCR_OFF));
+		return;
+	}
+	say("GX STUCK ON (gmu pwr/clk %#x): collapsed in hardware (gxclkctl GDSC)\n", st);
+	wlog(gpu + GX_GDSCR_OFF, GPU_PHYS + GX_GDSCR_OFF, "GX_GDSCR", rd(gpu + GX_GDSCR_OFF) | GDSC_SW_COLLAPSE);
+	if (!wait_bits(gpu + GX_GDSCR_OFF + 4, GDSC_DOWN_COMPLETE, GDSC_DOWN_COMPLETE, 2000)) {
+		say("GX does not report power-down complete (cfg %#x)\n", rd(gpu + GX_GDSCR_OFF + 4));
+	}
+}
