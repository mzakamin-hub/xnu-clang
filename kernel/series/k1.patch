+ *   5. 1 ms: every branch's CBCR read (bit 31 CLK_OFF); with cfg_ahb running and the PHY GDSC on, the PHY's first
+ *      words read (serdes 0x1c07000.., pcs 0x1c07400..) - reads only.
+ *   6. Held 2 s, then undone in reverse: 0x52018 / 0x52000 / 0x52008 back to the found values, TCSR back, PHY GDSC
+ *      then PCIe GDSC back to the found GDSCR (collapse), power-off read; L3I / L1D stay voted (icepcie_release=1
+ *      releases them).
+ */
+static int icepcie;
+static int icepcie_lx;  /* (B) route: hand the chip to the Linux ath12k driver (hakios_iceland_ath12k.c) */
+extern vm_offset_t iceland_ath12k_bar;  /* set by iceland_ath12k_link() at the handoff (46cn3y: "after the handoff") */
+extern int hakios_iceland_omni(int bit);  /* 46cn4b: dadawifi_omni (hakios_iceland_ath12k.c) - G6 0x200, G7 0x400, G9 0x1000 */
+extern int hakios_iceland_rpmh_arc(const char *name, uint32_t vlvl);  /* 46cn4b G6 (hakios_iceland_adsp.c) */
+extern int hakios_iceland_rpmh_vote_vme(const char *name, uint32_t mv, int32_t mode, int enable);
+
+#define GCC_RD(o)       (*(volatile uint32_t *)(gcc + (o)))
+#define GCC_WR(o, v)    do { *(volatile uint32_t *)(gcc + (o)) = (v); __asm__ volatile ("dsb sy" ::: "memory"); \
+	                      say("icepcie: gcc +%05x <- %08x (read back %08x)\n", (o), (uint32_t)(v), GCC_RD(o)); } while (0)
+
+static bool
+pcie_gdsc_on(vm_offset_t gcc, uint32_t off)
+{
+	GCC_WR(off, GCC_RD(off) & ~1u);
+	for (int i = 0; i < 1000; i++) {
+		if (GCC_RD(off) >> 31) {
+			say("icepcie: gdsc +%05x on after %d x 100 us (%08x)\n", off, i, GCC_RD(off));
+			return true;
+		}
+		delay(100);
+	}
+	say("icepcie: gdsc +%05x NOT on in 100 ms (%08x)\n", off, GCC_RD(off));
+	return false;
+}
