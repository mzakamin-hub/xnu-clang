+void native_gop_display_probe(void)
+{
+	unsigned enabled = 0;
+	if (!PE_parse_boot_argn("offline-legacy-gop", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	thread_t thread = nullptr;
+	if (kernel_thread_start(worker, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		gStage = -11;
+	}
+}
