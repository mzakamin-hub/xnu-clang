 		&aBlock->descriptor, _Block_descriptor_ptrauth_discriminator);
 	return ptrauth_auth_data(aBlock->descriptor, ptrauth_key_asda, disc);
+#elif defined(BLOCK_MIXED_DESCRIPTOR_SIGNING)
+	void *desc = (void *)aBlock->descriptor;
+	if (_Block_descriptor_is_signed(desc)) {
+		desc = ptrauth_auth_data(desc, ptrauth_key_asda,
+		    ptrauth_blend_discriminator(&aBlock->descriptor,
+		    _Block_descriptor_ptrauth_discriminator));
+	}
+	return desc;
 #else
 	return aBlock->descriptor;
 #endif
