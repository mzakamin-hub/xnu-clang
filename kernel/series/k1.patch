+/* ---- publication ----------------------------------------------------------------------------------------------------- */
+
+static IOLock * agx_lock;
+static NativeAdrenoGpuPublished * agx_nub;
+static bool agx_personality_added;
+
+static IOLock *
+agx_lock_get(void)
+{
+	if (agx_lock == NULL) {
+		IOLock * lock = IOLockAlloc();
+
+		if (!OSCompareAndSwapPtr(NULL, lock, (void * volatile *)&agx_lock)) {
+			IOLockFree(lock);
+		}
+	}
+	return agx_lock;
+}
+
+/* IOGraphicsFamily's IOAccelerator: its metaclass, by name; the kext is loaded first if nothing has loaded it yet */
+static const OSMetaClass *
+agx_base_find(void)
+{
+	const OSSymbol * name = OSSymbol::withCStringNoCopy(kAGXBaseName);
+	const OSMetaClass * base = name != NULL ? OSMetaClass::getMetaClassWithName(name) : NULL;
+
+	if (name != NULL && base == NULL) {
+		OSReturn r = OSKextLoadKextWithIdentifier(kAGXBaseKext);
+
+		base = OSMetaClass::getMetaClassWithName(name);
+		IOLog("agx: %s loaded now (%#x): %s %s\n", kAGXBaseKext, r, kAGXBaseName, base != NULL ? "found" : "MISSING");
+	}
+	OSSafeReleaseNULL(name);
+	return base;
+}
+
+/* the late class (agx_lock held) */
+static bool
+agx_class_register(void)
+{
+	const OSMetaClass * base;
+	const OSSymbol * kext;
+	AGXAccelerator::MetaClass * meta;
+	void * handle;
+	OSReturn r;
+
+	if (AGXAccelerator::gMeta != NULL) {
+		return true;
+	}
+	base = agx_base_find();
+	if (base == NULL) {
+		IOLog("agx: no %s class: no accelerator\n", kAGXBaseName);
+		return false;
+	}
+	kext = base->getKmodName();
+	/* the shape UniXNU audited in this collection (ioaccelerator-base-abi-26C5035r.json): IOService's, 136 bytes */
+	if (base->getSuperClass() != IOService::metaClass || base->getClassSize() != sizeof(IOService) ||
+	    sizeof(AGXAccelerator) != sizeof(IOService)) {
+		IOLog("agx: %s (%s, %u B) is not IOService's direct subclass of %u B: refused\n", kAGXBaseName,
+		    kext != NULL ? kext->getCStringNoCopy() : "?", base->getClassSize(), (unsigned)sizeof(IOService));
+		return false;
+	}
+	handle = OSMetaClass::preModLoad(kOSKextKernelIdentifier);
+	if (handle == NULL) {
+		IOLog("agx: preModLoad failed\n");
+		return false;
+	}
+	meta = ::new (agx_meta_storage) AGXAccelerator::MetaClass(base);     /* (the global placement form: OSMetaClass hides new) */
+	r = OSMetaClass::postModLoad(handle);
+	if (r != kOSReturnSuccess) {
+		/* (the metaclass stays in its storage, unregistered and unused) */
+		IOLog("agx: %s not registered (%#x)\n", kAGXClassName, r);
+		return false;
+	}
+	AGXAccelerator::gMeta = meta;
+	IOLog("agx: %s registered late: super %s (%s, %u B) < %s\n", kAGXClassName, kAGXBaseName,
+	    kext != NULL ? kext->getCStringNoCopy() : "?", base->getClassSize(), base->getSuperClass()->getClassName());
+	return true;
+}
+
+/* one string property of the personality (OSPtr is a plain retained pointer in this file) */
+static bool
+agx_set(OSDictionary * dictionary, const char * key, const char * value)
+{
+	const OSSymbol * v = OSSymbol::withCString(value);
+	bool ok = v != NULL && dictionary->setObject(key, v);
+
+	OSSafeReleaseNULL(v);
+	return ok;
+}
+
+/* the personality, in IOKit's catalogue (agx_lock held): matched when the nub is registered */
+static bool
+agx_personality_add(void)
+{
+	OSDictionary * personality;
+	OSArray * array = NULL;
+	bool ok = false;
+
+	if (agx_personality_added) {
+		return true;
+	}
+	personality = OSDictionary::withCapacity(8);
+	if (personality != NULL &&
+	    agx_set(personality, kIOClassKey, kAGXClassName) &&
+	    agx_set(personality, kIOProviderClassKey, kAGXNubName) &&
+	    agx_set(personality, kIOMatchCategoryKey, kAGXMatchCategory) &&
+	    agx_set(personality, kCFBundleIdentifierKey, kOSKextKernelIdentifier) &&
+	    agx_set(personality, "MetalPluginName", kAGXPluginName) &&
+	    agx_set(personality, "MetalPluginClassName", kAGXPluginClassName)) {
+		const OSObject * objects[1] = { personality };
+
+		array = OSArray::withObjects(objects, 1);
+		ok = array != NULL && gIOCatalogue->addDrivers(array, false);
+	}
+	OSSafeReleaseNULL(array);
+	OSSafeReleaseNULL(personality);
+	agx_personality_added = ok;
+	IOLog("agx: personality %s on %s (%s; %s / %s): %s\n", kAGXClassName, kAGXNubName, kAGXMatchCategory, kAGXPluginName,
+	    kAGXPluginClassName, ok ? "added" : "NOT ADDED");
+	return ok;
+}
+
+/*
+ * g6b, iceagx_selftest=1 (with iceagx_client=1): a kernel client drives the skeleton's wire once, right after the publish, in
+ * the order of Turnip's first calls (piano 613a209 gpu-userspace.md:129-131): open 0x4147, the tunnel's probe, Query directly
+ * and through the tunnel, a record of the wrong size, a refused method, close. The QEMU proof of the wire with no Metal
+ * client, and g6b-1's harness for the back ends. One line: "agx: selftest PASS ..." or "agx: selftest FAIL at <step> (<ret>)".
+ */
+static IOReturn
+agx_selftest_call(IOUserClient * uc, uint32_t selector, const void * in, uint32_t inSize, void * out, uint32_t * outSize)
+{
+	IOExternalMethodArguments a;
+	IOReturn r;
+
+	bzero(&a, sizeof(a));
+	a.version = kIOExternalMethodArgumentsCurrentVersion;
+	a.selector = selector;
+	a.structureInput = in;
+	a.structureInputSize = inSize;
+	a.structureOutput = out;
+	a.structureOutputSize = *outSize;
+	r = uc->externalMethod(selector, &a, NULL, NULL, NULL);
+	*outSize = a.structureOutputSize;
+	return r;
+}
+
+static void
+agx_selftest(AGXAccelerator * agx)
+{
+	const char * step = "open";
+	IOUserClient * uc = NULL;
+	uint32_t tunnel[2] = { kAGXTunnelMagic, kAGXTunnelProbe };
+	uint8_t zero[8] = {};
+	uint64_t stamp = 0;
+	AGXAbiParams q;
+	uint32_t n = 0;
+	IOReturn r;
+
+	r = agx->newUserClient(kernel_task, NULL, kAGXOpenType, NULL, &uc);
+	if (r != kIOReturnSuccess || uc == NULL) {
+		goto fail;
+	}
+	step = "probe";
+	r = agx_selftest_call(uc, 0, tunnel, sizeof(tunnel), NULL, &n);
+	if (r != kIOReturnSuccess) {
+		goto fail;
+	}
+	step = "Query";
+	bzero(&q, sizeof(q));
+	n = sizeof(q);
+	r = agx_selftest_call(uc, 1, NULL, 0, &q, &n);
+	if (r != kIOReturnSuccess || n != sizeof(q) || q.abi_version != kAGXAbiVersion) {
+		goto fail;
+	}
+	step = "tunnel Query";
+	tunnel[1] = 1;
+	bzero(&q, sizeof(q));
+	n = sizeof(q);
+	r = agx_selftest_call(uc, 0, tunnel, sizeof(tunnel), &q, &n);
+	if (r != kIOReturnSuccess || n != sizeof(q) || q.abi_version != kAGXAbiVersion) {
+		goto fail;
+	}
+	step = "size check";            /* BoAlloc takes 16 bytes: 8 must be refused as a bad argument */
+	n = sizeof(stamp);
+	r = agx_selftest_call(uc, 2, zero, sizeof(zero), &stamp, &n);
+	if (r != kIOReturnBadArgument) {
+		goto fail;
+	}
+	step = "refusal";               /* GetTimestamp's record is right, the method is not in this slice */
+	n = sizeof(stamp);
+	r = agx_selftest_call(uc, 7, NULL, 0, &stamp, &n);
+	if (r != kIOReturnUnsupported) {
+		goto fail;
+	}
+	uc->clientClose();
+	uc->release();
+	IOLog("agx: selftest PASS: open %#x, probe, Query x2 (ABI %u, %u/%u bits), size check, refusal, close\n",
+	    (unsigned)kAGXOpenType, q.abi_version, q.input_bits, q.output_bits);
+	return;
+fail:
+	if (uc != NULL) {
+		uc->clientClose();
+		uc->release();
+	}
+	IOLog("agx: selftest FAIL at %s (%#x)\n", step, r);
+}
+
+/*
+ * g6b-1, iceagx_selftest=2 (with iceagx_client=1): a kernel client drives every method of ABI v2 through the client's own
+ * entry (externalMethod, through the 'NTNL' tunnel on selector 0 as Turnip and the plugin call it), in the order of the
+ * plugin's userland test (AdrenoMetal c1351337 NativeAdrenoUserTest.h:117-180): open, Query, GetDeviceInfo, BoAlloc,
+ * BoMap, BoCpuMap and IOConnectMapMemory64's own path (mapClientMemory64, write-combined), an IB of CP_MEM_WRITEs written
+ * through the CPU view, Submit, WaitFence, the values read back; then an import, a second queue, the timestamp, metadata,
+ * priority, notes, the refusals (bad handles, out of range, wrong sizes, busy, double free, double close), close, and
+ * two connections at once. With the GPU up (the tablet: the probe's window, agx_probe_window) it runs on the A840; with
+ * no GPU (QEMU, iceagx=1) the client is the skeleton and the test checks its clean refusals. iceagx_selftest=3: the live
+ * test on the software stand-in (QEMU). One line: "agx: selftest PASS 2 ..." or "agx: selftest FAIL 2 at <step> (<ret>)".
+ */
+static uint8_t * agx_wire;              /* the tunnel's record: 8 bytes + the largest record (Submit's) */
+
+static IOReturn
+agx_call(IOUserClient * uc, uint32_t method, const void * in, uint32_t inSize, void * out, uint32_t outSize)
+{
+	uint32_t n = outSize, header[2] = { kAGXTunnelMagic, method };
+
+	if (inSize > sizeof(AGXAbiSubmit)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(agx_wire, header, sizeof(header));
+	if (inSize != 0) {
+		memcpy(agx_wire + 8, in, inSize);
+	}
+	return agx_selftest_call(uc, 0, agx_wire, 8 + inSize, out, &n);
+}
+
+/* the open userland makes (IOServiceOpen -> newUserClient); with no accelerator (before the root), the same client unattached */
+static IOReturn
+agx_open(AGXAccelerator * agx, IOUserClient ** uc)
+{
+	AGXDeviceUserClient * d;
+	IOReturn r;
+
+	*uc = NULL;
+	if (agx != NULL) {
+		return agx->newUserClient(kernel_task, NULL, kAGXOpenType, NULL, uc);
+	}
+	d = AGXDeviceUserClient::make(kernel_task, NULL, kAGXOpenType, NULL);
+	if (d == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if ((r = d->mount()) != kIOReturnSuccess) {
+		d->release();
+		return r;
+	}
+	*uc = d;
+	return kIOReturnSuccess;
+}
+
+static void
+agx_close(IOUserClient ** uc)
+{
+	if (*uc != NULL) {
+		(void)(*uc)->clientClose();
+		(*uc)->release();
+		*uc = NULL;
+	}
+}
+
+static uint32_t
+agx_parity(uint32_t v)
+{
+	return 0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1;
+}
+
+/* PM4 CP_MEM_WRITE (type 7, opcode 0x3d): address, one value (the kit's api_selftest and the plugin's test write it so) */
+static uint32_t *
+agx_mem_write(uint32_t * w, uint64_t at, uint32_t value)
+{
+	w[0] = 7u << 28 | 3 | agx_parity(3) << 15 | 0x3du << 16 | agx_parity(0x3d) << 23;
+	w[1] = (uint32_t)at;
+	w[2] = (uint32_t)(at >> 32);
+	w[3] = value;
+	return w + 4;
+}
+
+#define AGX_EXPECT(what, call, want) do { step = (what); r = (call); if (r != (want)) { goto fail; } if ((want) != \
+	        kIOReturnSuccess) { refused++; } } while (0)
+
+static void
+agx_selftest2(AGXAccelerator * agx, uint32_t mode)
+{
+	static const uint32_t V[6] = { 0x0adc0de1u, 0xfeed0002u, 0x600d0003u, 0x0b16b0b3u, 0x1a9071edu, 0x5ec0d005u };
+	const char * step = "open";
+	IOUserClient * uc = NULL, * b = NULL, * c = NULL;
+	IOMemoryMap * view[3] = { NULL, NULL, NULL };
+	volatile uint32_t * w[3] = { NULL, NULL, NULL };
+	uint32_t * host = NULL, refused = 0, i, live, ok = 0;
+	uint64_t at[3], t[2] = { 0, 0 }, st[2] = { 0, 0 }, ns = 0, began;
+	AGXAbiParams q;
+	AGXAbiDeviceInfo info;
+	AGXAbiHandle h[3] = {}, imp = {}, h2 = {}, bh = {};
+	AGXAbiCpuMapReply cr[3];
+	AGXAbiU64 u = {}, f1 = {}, f2 = {}, queue = {};
+	AGXAbiSubmit * s = NULL;
+	AGXAbiMetadata meta;
+	IOReturn r = kIOReturnSuccess;
+
+	agx_wire = IONewData(uint8_t, 8 + sizeof(AGXAbiSubmit));
+	s = IONewZero(AGXAbiSubmit, 1);
+	if (agx_wire == NULL || s == NULL) {
+		r = kIOReturnNoMemory;
+		goto fail;
+	}
+	agx_soft_on = mode == 3;
+	AGX_EXPECT("open", agx_open(agx, &uc), kIOReturnSuccess);
+	step = "probe";
+	{
+		uint32_t probe[2] = { kAGXTunnelMagic, kAGXTunnelProbe }, n = 0;
+
+		if ((r = agx_selftest_call(uc, 0, probe, sizeof(probe), NULL, &n)) != kIOReturnSuccess ||
+		    (r = agx_selftest_call(uc, 255, probe, sizeof(probe), NULL, &n)) != kIOReturnSuccess) {
+			goto fail;
+		}
+	}
+	bzero(&q, sizeof(q));
+	AGX_EXPECT("Query", agx_call(uc, mQuery, NULL, 0, &q, sizeof(q)), kIOReturnSuccess);
+	step = "Query's answer";
+	if (q.abi_version != kAGXAbiVersion) {
+		goto fail;
+	}
+	live = q.flags & kAGXParamsHostImport;
+	if (!live) {
+		/* no GPU: the skeleton; every method but Query refused cleanly, nothing reaches hardware */
+		if (mode != 2) {
+			step = "the stand-in (not live)";
+			goto fail;
+		}
+		for (i = 2; i <= kAGXMethods; i++) {
+			bzero(s, sizeof(*s));
+			bzero(&meta, sizeof(meta));
+			AGX_EXPECT("refused method", agx_call(uc, i, s, agx_in[i], &meta, agx_out[i]), kIOReturnUnsupported);
+		}
+		AGX_EXPECT("size check", agx_call(uc, mBoAlloc, s, 8, h, 8), kIOReturnBadArgument);
+		AGX_EXPECT("unknown method", agx_call(uc, kAGXMethods + 1, NULL, 0, NULL, 0), kIOReturnBadArgument);
+		AGX_EXPECT("close", uc->clientClose(), kIOReturnSuccess);
+		AGX_EXPECT("call after close", agx_call(uc, mQuery, NULL, 0, &q, sizeof(q)), kIOReturnNotReady);
+		AGX_EXPECT("double close", uc->clientClose(), kIOReturnNotOpen);
+		uc->release();
+		uc = NULL;
+		AGX_EXPECT("reopen", agx_open(agx, &b), kIOReturnSuccess);
+		agx_close(&b);
+		IOLog("agx: selftest PASS 2 (no GPU: the skeleton): open %#x, probe, Query (ABI %u, no HostImport), %u refusals "
+		    "(methods 2..18, size, unknown, after close, double close), close, reopen\n", (unsigned)kAGXOpenType,
+		    q.abi_version, refused);
+		goto out;
+	}
+
+	/* the plugin's order: Query, GetDeviceInfo, two BOs, their maps, CPU views (NativeAdrenoUserTest.h:124-143) */
+	step = "Query's live answer";
+	if (q.input_bits != 39 || q.output_bits != 36 || q.max_bo_bytes == 0) {
+		goto fail;
+	}
+	AGX_EXPECT("Query (direct selector)", agx_selftest_call(uc, mQuery, NULL, 0, &q, &(i = sizeof(q))), kIOReturnSuccess);
+	bzero(&info, sizeof(info));
+	AGX_EXPECT("GetDeviceInfo", agx_call(uc, mGetDeviceInfo, NULL, 0, &info, sizeof(info)), kIOReturnSuccess);
+	step = "GetDeviceInfo's answer";
+	if (info.chip_id == 0 || info.va_size == 0 || !(info.flags & kAGXDeviceClientIova) || info.gmem_bytes != 18u << 20) {
+		goto fail;
+	}
+	at[0] = info.va_start;                  /* the IB */
+	at[1] = info.va_start + 0x10000;        /* the target */
+	at[2] = info.va_start + 0x100000;       /* 64 KiB, several pages */
+	for (i = 0; i < 3; i++) {
+		AGXAbiBoAlloc a = { i == 2 ? 0x10000ull : 4096ull, 12, 0 };
+		AGXAbiBoMap m = { 0, at[i], i == 0 ? 1u : 3u, 0, 2, 0 };
+
+		AGX_EXPECT("BoAlloc", agx_call(uc, mBoAlloc, &a, sizeof(a), &h[i], sizeof(h[i])), kIOReturnSuccess);
+		m.handle = h[i].handle;
+		AGX_EXPECT("BoMap", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnSuccess);
+		AGX_EXPECT("BoCpuMap", agx_call(uc, mBoCpuMap, &h[i], sizeof(h[i]), &cr[i], sizeof(cr[i])), kIOReturnSuccess);
+		/* IOConnectMapMemory64's path (is_io_connect_map_memory_into_task -> mapClientMemory64), write-combined as Turnip asks */
+		step = "the CPU view";
+		view[i] = uc->mapClientMemory64(cr[i].token, kernel_task, kIOMapAnywhere | kIOMapWriteCombineCache);
+		if (view[i] == NULL || view[i]->getLength() < cr[i].bytes || cr[i].bytes != a.bytes) {
+			r = kIOReturnVMError;
+			goto fail;
+		}
+		w[i] = (volatile uint32_t *)view[i]->getVirtualAddress();
+		{
+			/* (what mapping the view did to the page's attribute: BoAlloc left it write-combined; a submission re-asserts) */
+			IOByteCount len = 0;
+			ppnum_t pn = (ppnum_t)atop_64(view[i]->getPhysicalSegment(0, &len, kIOMemoryMapperNone));
+
+			w[i][0] = 0;
+			IOLog("agx: selftest: BO %u's first page with its CPU view mapped and written: attribute %#x (write-combined %#x)\n",
+			    i, pn != 0 ? pmap_cache_attributes(pn) : ~0u, (unsigned)VM_WIMG_WCOMB);
+		}
+	}
+	/* an import: kernel pages of this (kernel) client's own, 4 KiB-aligned, written and pushed out first */
+	step = "import's pages";
+	host = (uint32_t *)IOMallocAligned(PAGE_SIZE, PAGE_SIZE);
+	if (host == NULL) {
+		r = kIOReturnNoMemory;
+		goto fail;
+	}
+	for (i = 0; i < 1024; i++) {
+		host[i] = 0x5a5a0000u | i;
+	}
+	agx_push(host, 4096);
+	{
+		AGXAbiBoImport im = { (uint64_t)(uintptr_t)host, 4096 };
+		AGXAbiBoMap m = { 0, info.va_start + 0x200000, 3, 0, 2, 0 };
+
+		AGX_EXPECT("BoImport", agx_call(uc, mBoImport, &im, sizeof(im), &imp, sizeof(imp)), kIOReturnSuccess);
+		m.handle = imp.handle;
+		AGX_EXPECT("BoMap (import)", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnSuccess);
+		AGX_EXPECT("BoCpuMap (import)", agx_call(uc, mBoCpuMap, &imp, sizeof(imp), &meta, sizeof(cr[0])),
+		    kIOReturnUnsupported);
+	}
+	/* the IB, written through its write-combined view (NativeAdrenoUserTest.h:145-157) */
+	{
+		uint32_t words[24], * p = words;
+
+		for (i = 0; i < 1024; i++) {
+			w[1][i] = 0xdeadbeef;
+		}
+		p = agx_mem_write(p, at[1] + 0, V[0]);
+		p = agx_mem_write(p, at[1] + 4, V[1]);
+		p = agx_mem_write(p, at[1] + 8, V[2]);
+		p = agx_mem_write(p, at[2] + 0x4010, V[3]);             /* (the 64 KiB BO's second 16 KiB page) */
+		p = agx_mem_write(p, info.va_start + 0x200000 + 4, V[4]);       /* (into the import) */
+		for (i = 0; i < 20; i++) {
+			w[0][i] = words[i];
+		}
+		p = agx_mem_write(words, at[1] + 16, V[5]);             /* the second submission's IB, at +0x100 */
+		for (i = 0; i < 4; i++) {
+			w[0][64 + i] = words[i];
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	bzero(s, sizeof(*s));
+	s->buffer_count = 1;
+	s->buffers[0] = { h[0].handle, at[0], 80 };
+	began = mach_absolute_time();
+	AGX_EXPECT("Submit", agx_call(uc, mSubmit, s, sizeof(*s), &f1, sizeof(f1)), kIOReturnSuccess);
+	{
+		AGXAbiWaitFence wf = { f1.value, 200000000ull };
+
+		AGX_EXPECT("WaitFence", agx_call(uc, mWaitFence, &wf, sizeof(wf), NULL, 0), kIOReturnSuccess);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	agx_push(host, 4096);                   /* (the import is cacheable for the CPU: its lines invalidated before the read) */
+	ok = (w[1][0] == V[0]) + (w[1][1] == V[1]) + (w[1][2] == V[2]) + (w[1][3] == 0xdeadbeef) + (w[2][0x4010 / 4] == V[3]) +
+	    (w[2][0] == 0) + (host[1] == V[4]) + (host[0] == 0x5a5a0000u);
+	step = "the GPU's writes";
+	if (ok != 8) {
+		IOLog("agx: selftest read %#x %#x %#x %#x, %#x %#x, %#x %#x\n", w[1][0], w[1][1], w[1][2], w[1][3], w[2][0x4010 / 4],
+		    w[2][0], host[1], host[0]);
+		r = kIOReturnIOError;
+		goto fail;
+	}
+	/* a second queue, its submission waiting on the first fence (Submit's wait_fence) */
+	AGX_EXPECT("CreateQueue", agx_call(uc, mCreateQueue, &queue, sizeof(queue), &queue, sizeof(queue)), kIOReturnSuccess);
+	s->queue = queue.value;
+	s->wait_fence = f1.value;
+	s->wait_timeout_ns = 100000000ull;
+	s->buffers[0] = { h[0].handle, at[0] + 0x100, 16 };
+	AGX_EXPECT("Submit (queue, wait)", agx_call(uc, mSubmit, s, sizeof(*s), &f2, sizeof(f2)), kIOReturnSuccess);
+	{
+		AGXAbiWaitFence wf = { f2.value, 100000000ull };
+
+		AGX_EXPECT("WaitFence 2", agx_call(uc, mWaitFence, &wf, sizeof(wf), NULL, 0), kIOReturnSuccess);
+	}
+	step = "the second write";
+	if ((int32_t)(uint32_t)(f2.value - f1.value) <= 0 || w[1][4] != V[5]) {
+		r = kIOReturnIOError;
+		goto fail;
+	}
+	AGX_EXPECT("CloseQueue", agx_call(uc, mCloseQueue, &queue, sizeof(queue), NULL, 0), kIOReturnSuccess);
+	AGX_EXPECT("CloseQueue again", agx_call(uc, mCloseQueue, &queue, sizeof(queue), NULL, 0), kIOReturnBadArgument);
+	AGX_EXPECT("GetTimestamp", agx_call(uc, mGetTimestamp, NULL, 0, &t[0], 8), kIOReturnSuccess);
+	AGX_EXPECT("GetTimestamp 2", agx_call(uc, mGetTimestamp, NULL, 0, &t[1], 8), kIOReturnSuccess);
+	step = "the timestamps";
+	if (t[0] == 0 || t[1] < t[0]) {
+		goto fail;
+	}
+	AGX_EXPECT("GetStatus (no counters)", agx_call(uc, mGetStatus, NULL, 0, st, sizeof(st)), kIOReturnUnsupported);
+	bzero(&meta, sizeof(meta));
+	meta.handle = h[1].handle;
+	meta.bytes = 5;
+	memcpy(meta.text, "g6b-1", 5);
+	AGX_EXPECT("SetMetadata", agx_call(uc, mSetMetadata, &meta, sizeof(meta), NULL, 0), kIOReturnSuccess);
+	meta.bytes = 64;
+	bzero(meta.text, sizeof(meta.text));
+	AGX_EXPECT("GetMetadata", agx_call(uc, mGetMetadata, &meta, sizeof(meta), &meta, sizeof(meta)), kIOReturnSuccess);
+	step = "the metadata";
+	if (meta.bytes != 5 || memcmp(meta.text, "g6b-1", 5) != 0) {
+		goto fail;
+	}
+	{
+		AGXAbiPriority p = { 0, 2 }, bad = { 3, 0 };
+		AGXAbiNote note = { 1, 2, { 7, 9 } }, odd = { 9, 0, {} };
+
+		AGX_EXPECT("SetPriority", agx_call(uc, mSetPriority, &p, sizeof(p), NULL, 0), kIOReturnSuccess);
+		AGX_EXPECT("SetPriority 3", agx_call(uc, mSetPriority, &bad, sizeof(bad), NULL, 0), kIOReturnBadArgument);
+		AGX_EXPECT("Note", agx_call(uc, mNote, &note, sizeof(note), NULL, 0), kIOReturnSuccess);
+		AGX_EXPECT("Note kind", agx_call(uc, mNote, &odd, sizeof(odd), NULL, 0), kIOReturnBadArgument);
+	}
+
+	/* refusals: wrong sizes, bad handles, out of range, busy (NativeAdrenoUserClient.cpp's own checks) */
+	{
+		AGXAbiBoAlloc a = { 4097, 12, 0 }, z = { 0, 12, 0 };
+		AGXAbiBoMap m = { 0xdead, info.va_start + 0x300000, 3, 0, 2, 0 };
+		AGXAbiWaitFence wf = { 0, 0 };
+		AGXAbiCpuUnmap cu = { h[1].handle, cr[1].token + 1, 0 };
+
+		AGX_EXPECT("size check", agx_call(uc, mBoAlloc, &a, 8, &h2, sizeof(h2)), kIOReturnBadArgument);
+		AGX_EXPECT("size check out", agx_call(uc, mQuery, NULL, 0, &q, 16), kIOReturnBadArgument);
+		AGX_EXPECT("BoAlloc 4097", agx_call(uc, mBoAlloc, &a, sizeof(a), &h2, sizeof(h2)), kIOReturnBadArgument);
+		AGX_EXPECT("BoAlloc 0", agx_call(uc, mBoAlloc, &z, sizeof(z), &h2, sizeof(h2)), kIOReturnBadArgument);
+		AGX_EXPECT("BoMap bad handle", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBadArgument);
+		m.handle = h[1].handle;
+		AGX_EXPECT("BoMap twice", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBusy);
+		a.bytes = 4096;
+		AGX_EXPECT("BoAlloc 2", agx_call(uc, mBoAlloc, &a, sizeof(a), &h2, sizeof(h2)), kIOReturnSuccess);
+		m.handle = h2.handle;
+		m.iova = 0x1000;
+		AGX_EXPECT("BoMap below the window", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBadArgument);
+		m.iova = info.va_start + info.va_size;
+		AGX_EXPECT("BoMap past the window", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBadArgument);
+		m.iova = at[2] + 0x8000;
+		AGX_EXPECT("BoMap overlapping", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBadArgument);
+		m.iova = at[1] + 0x1000;
+		m.reserved = 1;
+		AGX_EXPECT("BoMap reserved", agx_call(uc, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBadArgument);
+		AGX_EXPECT("BoFree 2", agx_call(uc, mBoFree, &h2, sizeof(h2), NULL, 0), kIOReturnSuccess);
+		s->queue = 0;
+		s->wait_fence = 0;
+		s->buffer_count = 0;
+		AGX_EXPECT("Submit none", agx_call(uc, mSubmit, s, sizeof(*s), &u, sizeof(u)), kIOReturnBadArgument);
+		s->buffer_count = 1;
+		s->buffers[0] = { h2.handle, at[0], 16 };
+		AGX_EXPECT("Submit freed handle", agx_call(uc, mSubmit, s, sizeof(*s), &u, sizeof(u)), kIOReturnBadArgument);
+		s->buffers[0] = { h[0].handle, at[0] + 4092, 8 };
+		AGX_EXPECT("Submit past its BO", agx_call(uc, mSubmit, s, sizeof(*s), &u, sizeof(u)), kIOReturnBadArgument);
+		s->buffers[0] = { h[0].handle, at[0], 16 };
+		s->queue = 7;
+		AGX_EXPECT("Submit closed queue", agx_call(uc, mSubmit, s, sizeof(*s), &u, sizeof(u)), kIOReturnBadArgument);
+		AGX_EXPECT("WaitFence 0", agx_call(uc, mWaitFence, &wf, sizeof(wf), NULL, 0), kIOReturnBadArgument);
+		wf.fence = f2.value + 1000;
+		AGX_EXPECT("WaitFence ahead", agx_call(uc, mWaitFence, &wf, sizeof(wf), NULL, 0), kIOReturnBadArgument);
+		AGX_EXPECT("BoCpuUnmap wrong token", agx_call(uc, mBoCpuUnmap, &cu, sizeof(cu), NULL, 0), kIOReturnBadArgument);
+		AGX_EXPECT("BoFree leased", agx_call(uc, mBoFree, &h[1], sizeof(h[1]), NULL, 0), kIOReturnBusy);
+		AGX_EXPECT("unknown method", agx_call(uc, kAGXMethods + 1, NULL, 0, NULL, 0), kIOReturnUnsupported);
+		AGX_EXPECT("unknown selector", agx_selftest_call(uc, 40, NULL, 0, NULL, &(i = 0)), kIOReturnUnsupported);
+	}
+
+	/* the way back: views unmapped (IOConnectUnmapMemory64), leases given back, every BO freed, then once more */
+	for (i = 0; i < 3; i++) {
+		AGXAbiCpuUnmap cu = { h[i].handle, cr[i].token, 0 };
+		IOByteCount len = 0;
+		ppnum_t pn = (ppnum_t)atop_64(view[i]->getPhysicalSegment(0, &len, kIOMemoryMapperNone));
+
+		/* an owned BO's page write-combined while it lives, the default attribute again once freed (AGXBo) */
+		AGX_EXPECT("BO page write-combined", pn != 0 && (pmap_cache_attributes(pn) & VM_WIMG_MASK) == VM_WIMG_WCOMB ?
+		    kIOReturnSuccess : kIOReturnInternalError, kIOReturnSuccess);
+		view[i]->release();
+		view[i] = NULL;
+		w[i] = NULL;
+		AGX_EXPECT("BoCpuUnmap", agx_call(uc, mBoCpuUnmap, &cu, sizeof(cu), NULL, 0), kIOReturnSuccess);
+		AGX_EXPECT("BoCpuUnmap again", agx_call(uc, mBoCpuUnmap, &cu, sizeof(cu), NULL, 0), kIOReturnBusy);
+		AGX_EXPECT("BoFree", agx_call(uc, mBoFree, &h[i], sizeof(h[i]), NULL, 0), kIOReturnSuccess);
+		if (agx_wc_explicit()) {
+			AGX_EXPECT("BO page default again", (pmap_cache_attributes(pn) & VM_WIMG_MASK) != VM_WIMG_WCOMB ?
+			    kIOReturnSuccess : kIOReturnInternalError, kIOReturnSuccess);
+		} else {
+			IOLog("agx: selftest (iceagx_wc=0): a freed BO page at attribute %#x\n", pmap_cache_attributes(pn));
+		}
+		AGX_EXPECT("BoFree again", agx_call(uc, mBoFree, &h[i], sizeof(h[i]), NULL, 0), kIOReturnBadArgument);
+	}
+	AGX_EXPECT("BoFree (import)", agx_call(uc, mBoFree, &imp, sizeof(imp), NULL, 0), kIOReturnSuccess);
+	AGX_EXPECT("close", uc->clientClose(), kIOReturnSuccess);
+	AGX_EXPECT("call after close", agx_call(uc, mQuery, NULL, 0, &q, sizeof(q)), kIOReturnNotReady);
+	AGX_EXPECT("double close", uc->clientClose(), kIOReturnNotOpen);
+	uc->release();
+	uc = NULL;
+	/* two connections at once (a Metal process opens twice: enumeration, then the device), one closed with a BO left live */
+	AGX_EXPECT("open b", agx_open(agx, &b), kIOReturnSuccess);
+	AGX_EXPECT("open c", agx_open(agx, &c), kIOReturnSuccess);
+	{
+		AGXAbiBoAlloc a = { 8192, 12, 0 };
+		AGXAbiBoMap m = { 0, info.va_start, 3, 0, 2, 0 };
+
+		AGX_EXPECT("b BoAlloc", agx_call(b, mBoAlloc, &a, sizeof(a), &bh, sizeof(bh)), kIOReturnSuccess);
+		m.handle = bh.handle;
+		AGX_EXPECT("b BoMap", agx_call(b, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnSuccess);
+		AGX_EXPECT("c BoMap (b's handle)", agx_call(c, mBoMap, &m, sizeof(m), &u, sizeof(u)), kIOReturnBadArgument);
+		AGX_EXPECT("c Query", agx_call(c, mQuery, NULL, 0, &q, sizeof(q)), kIOReturnSuccess);
+	}
+	AGX_EXPECT("close b (a BO live)", b->clientClose(), kIOReturnSuccess);
+	AGX_EXPECT("close c", c->clientClose(), kIOReturnSuccess);
+	b->release();
+	c->release();
+	b = c = NULL;
+	/* progress markers (agx_mark): refused, logged ("mark 0x1 (start)", "text: g6b", "mark 0x2"), never opens */
+	if (agx != NULL) {
+		static const uint32_t marks[6] = { 0x1, 0x7fff, 0x7067, 0x7036, 0x7062, 0x2 };
+		IOUserClient * m = NULL;
+		SInt32 opens = agx_opens;
+
+		for (i = 0; i < 6; i++) {
+			AGX_EXPECT("marker", agx->newUserClient(kernel_task, NULL, ((uint32_t)kAGXOpenType << 16) | marks[i], NULL, &m),
+			    kIOReturnUnsupported);
+		}
+		AGX_EXPECT("markers are no opens", agx_opens == opens && m == NULL ? kIOReturnSuccess : kIOReturnInternalError,
+		    kIOReturnSuccess);
+	}
+	IOLog("agx: selftest PASS %u (%s%s): open %#x, probe, Query (ABI %u, %u/%u bits, HostImport, max %llu MiB), DeviceInfo "
+	    "(chip %#x, GMEM %u MiB at %#llx, va %#llx+%#llx), 3 BOs + 1 import (%s) mapped, BO pages write-combined (default "
+	    "once freed), IB of 5 CP_MEM_WRITEs: fence %llu in %llu us, 8/8 words; queue %llu fence %llu, timestamps "
+	    "%llu..%llu, metadata, priority, note; %u refusals; close, double close; 2 connections%s\n", mode,
+	    mode == 3 ? "software stand-in" : "GPU", agx == NULL ? ", unpublished" : "", (unsigned)kAGXOpenType,
+	    q.abi_version, q.input_bits, q.output_bits, q.max_bo_bytes >> 20, info.chip_id, info.gmem_bytes >> 20,
+	    info.gmem_base, info.va_start, info.va_size, agx_imports[0] != 0 ? "persistent" : "plain", f1.value, ns / 1000,
+	    queue.value, f2.value, t[0], t[1], refused, agx != NULL ? "; 6 progress markers" : "");
+	goto out;
+fail:
+	IOLog("agx: selftest FAIL %u at %s (%#x)%s\n", mode, step, r, agx == NULL ? " (unpublished)" : "");
+out:
+	for (i = 0; i < 3; i++) {
+		OSSafeReleaseNULL(view[i]);
+	}
+	agx_close(&uc);
+	agx_close(&b);
+	agx_close(&c);
+	if (host != NULL) {
+		IOFreeAligned(host, PAGE_SIZE);
+	}
+	if (s != NULL) {
+		IODelete(s, AGXAbiSubmit, 1);
+	}
+	if (agx_wire != NULL) {
+		IODeleteData(agx_wire, uint8_t, 8 + sizeof(AGXAbiSubmit));
+		agx_wire = NULL;
+	}
+	agx_soft_on = false;
+}
+
+/* the GPU's way down (agx_accelerator_withdraw): every live connection gives its GPU space back while the API still serves */
+static void
+agx_clients_stop(const char * why)
+{
+	uint32_t n = 0;
+
+	if (agx_clients_lock_get() == NULL) {
+		return;
+	}
+	IOLockLock(agx_clients_lock);
+	agx_stopping = true;
+	for (AGXDeviceUserClient * c = agx_clients; c != NULL; c = c->next()) {
+		c->stop();
+		n++;
+	}
+	IOLockUnlock(agx_clients_lock);
+	if (n != 0) {
+		IOLog("agx: %u connection(s) gave the GPU back (%s)\n", n, why);
+	}
+}
+
+/*
+ * The GPU is up (or iceagx=1 says to act as if): the class, the personality, then the nub, registered synchronously, so the
+ * accelerator is matched, started and registered when this returns. Thread context; it may load IOGraphicsFamily.
+ */
+bool
+agx_accelerator_publish(const char * why)
+{
+	IOLock * lock = agx_lock_get();
+	NativeAdrenoGpuPublished * nub = NULL;
+	OSDictionary * matching;
+	IOService * found;
+	uint32_t selftest = 0;
+	bool ok = false;
+
+	if (lock == NULL) {
+		return false;
+	}
+	IOLockLock(lock);
+	if (agx_nub != NULL) {
+		IOLockUnlock(lock);
+		return true;
+	}
+	IOLog("agx: publish (%s)\n", why);
+	if (agx_clients_lock_get() != NULL) {
+		IOLockLock(agx_clients_lock);
+		agx_stopping = false;           /* (connections may mount again) */
+		IOLockUnlock(agx_clients_lock);
+	}
+	if (!agx_class_register() || !agx_personality_add()) {
+		goto out;
+	}
+	nub = new NativeAdrenoGpuPublished;
+	if (nub == NULL || !nub->init() || !nub->attach(IOService::getPlatform())) {
+		IOLog("agx: no %s\n", kAGXNubName);
+		OSSafeReleaseNULL(nub);
+		goto out;
+	}
+	nub->registerService(kIOServiceSynchronous);
+	agx_nub = nub;
+	ok = true;
+
+	/* what Metal's discovery does: IOServiceMatching("IOAccelerator") */
+	matching = IOService::serviceMatching(kAGXBaseName);
+	found = matching != NULL ? IOService::waitForMatchingService(matching, 5 * NSEC_PER_SEC) : NULL;
+	IOLog("agx: IOServiceMatching(\"%s\") finds %s%s\n", kAGXBaseName, found != NULL ? found->getMetaClass()->getClassName() :
+	    "nothing in 5 s", found != NULL && found->getMetaClass() == AGXAccelerator::gMeta ? ": PUBLISHED" : "");
+	if (found != NULL && found->getMetaClass() == AGXAccelerator::gMeta &&
+	    PE_parse_boot_argn("iceagx_selftest", &selftest, sizeof(selftest)) && selftest != 0) {
+		if (selftest == 1) {
+			agx_selftest(static_cast<AGXAccelerator *>(found));
+		} else if (selftest == 2 || selftest == 3) {
+			agx_selftest2(static_cast<AGXAccelerator *>(found), selftest);
+		}
+		agx_selftest_done = true;
+	}
+	OSSafeReleaseNULL(found);
+	OSSafeReleaseNULL(matching);
+out:
+	IOLockUnlock(lock);
+	return ok;
+}
+
+/* the GPU's way down: every connection gives its GPU space back, then the nub is terminated, the accelerator with it */
+void
+agx_accelerator_withdraw(const char * why)
+{
+	IOLock * lock = agx_lock_get();
+	NativeAdrenoGpuPublished * nub;
+
+	if (lock == NULL) {
+		return;
+	}
+	agx_clients_stop(why);
+	IOLockLock(lock);
+	nub = agx_nub;
+	agx_nub = NULL;
+	IOLockUnlock(lock);
+	if (nub != NULL) {
+		nub->terminate(kIOServiceSynchronous);
+		nub->release();
+		IOLog("agx: withdrawn (%s)\n", why);
+	}
+}
+
+static void
+agx_boot_thread(void * parameter, wait_result_t result)
+{
+#pragma unused(parameter, result)
+	(void)agx_accelerator_publish("iceagx=1, no GPU");
+}
+
+/* from redwood_input_init (bsd_init, before launchd): boot-arg iceagx=1 */
+void
+agx_accelerator_boot(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("iceagx", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(agx_boot_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * g6b-1 on the tablet (icegpu=6 icegpu_early=1: icegpu_run calls this once the stage-6 API self-test passed, the API still
+ * serving, before its way down). With iceagx_client=1 iceagx_selftest=2 the accelerator is published (the GPU is up), the
+ * client's self-test runs on the A840 inside that publish, and the accelerator is withdrawn before the kit goes down. If
+ * IOAccelerator's class cannot be had before the root, the same client is tested unattached. Nothing otherwise.
+ */
+void
+agx_probe_window(void)
+{
+	uint32_t client = 0, selftest = 0;
+
+	if (!PE_parse_boot_argn("iceagx_client", &client, sizeof(client)) || client == 0 ||
+	    !PE_parse_boot_argn("iceagx_selftest", &selftest, sizeof(selftest)) || selftest != 2) {
+		return;
+	}
+	agx_selftest_done = false;
+	(void)agx_accelerator_publish("icegpu=6: the probe's window, the ABI v2 client's self-test");
+	if (!agx_selftest_done) {
+		agx_selftest2(NULL, 2);
+	}
+	agx_accelerator_withdraw("the probe's way down");
+}
+
+#endif /* XNU_TARGET_OS_OSX */
