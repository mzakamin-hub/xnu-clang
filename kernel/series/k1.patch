+/*
+ * icetb24's own evidence, only when the timebase is scaled: a 5 s thread call measured by the counter itself
+ * (the counter and its rate are the hardware's; the deadline and mach_absolute_time are the scaled timebase's), then
+ * ten lines a minute apart with both clocks and the count of user-space time traps.
+ */
+static thread_call_t ml_tb_report_call;
+static uint64_t ml_tb_report_counter0, ml_tb_report_abs0, ml_tb_report_traps[2];
+static uint32_t ml_tb_report_n;
+
+static void
+ml_tb_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t counter, abstime, abs_ns = 0, counter_ms, abs_ms, traps[2] = { 0, 0 }, deadline;
+
+	__builtin_arm_isb(ISB_SY);
+	counter = __builtin_arm_rsr64(KERNEL_CNTVCT_EL0);
+	abstime = mach_absolute_time();
+	absolutetime_to_nanoseconds(abstime - ml_tb_report_abs0, &abs_ns);
+	counter_ms = (counter - ml_tb_report_counter0) * 1000 / ml_tb_counter_hz;
+	abs_ms = abs_ns / NSEC_PER_MSEC;
+	for (unsigned cpu = 0; cpu < MAX_CPUS; cpu++) {
+		traps[0] += ml_tb_trap_counts[cpu][0];
+		traps[1] += ml_tb_trap_counts[cpu][1];
+	}
+	if (ml_tb_report_n == 0) {
+		printf("icetb24: a 5 s timer took %llu ms by the counter (%llu Hz), %llu ms by mach_absolute_time: %s\n",
+		    counter_ms, ml_tb_counter_hz, abs_ms,
+		    (counter_ms >= 5000 && counter_ms <= 5250 && abs_ms + 1 >= counter_ms && abs_ms <= counter_ms + 1) ? "ok" : "CHECK");
+	} else {
+		printf("icetb24: minute %u: %llu ms by the counter, %llu ms by mach_absolute_time (%s); traps this minute: "
+		    "%llu mach_absolute_time, %llu mach_continuous_time\n", ml_tb_report_n, counter_ms, abs_ms,
+		    (abs_ms + 1 >= counter_ms && abs_ms <= counter_ms + 1) ? "same" : "DIFFER",
+		    traps[0] - ml_tb_report_traps[0], traps[1] - ml_tb_report_traps[1]);
+	}
+	ml_tb_report_traps[0] = traps[0];
+	ml_tb_report_traps[1] = traps[1];
+	if (ml_tb_report_n++ < 10) {
+		clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(ml_tb_report_call, deadline);
+	}
+}
+
+static void
+ml_tb_report_start(void)
+{
+	uint64_t deadline;
+
+	if (!ml_tb_scaled()) {
+		return;
+	}
+	ml_tb_report_call = thread_call_allocate(ml_tb_report, NULL);
+	if (ml_tb_report_call == NULL) {
+		return;
+	}
+	__builtin_arm_isb(ISB_SY);
+	ml_tb_report_counter0 = __builtin_arm_rsr64(KERNEL_CNTVCT_EL0);
+	ml_tb_report_abs0 = mach_absolute_time();
+	clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(ml_tb_report_call, deadline);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, ml_tb_report_start);
