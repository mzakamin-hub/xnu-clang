+/*
+ * ---- icegeni (kits 23h0 / 23h): the BT UART on its own serial engine, uart18 = QUP wrapper 3 (0x19c0000) SE5 0x1994000.
+ * References (read, not copied): Linux drivers/soc/qcom/qcom-geni-se.c + drivers/tty/serial/qcom_geni_serial.c and
+ * U-Boot drivers/serial/serial_msm_geni.c (both GPL-2.0) for the GENI SE / UART registers and their order; Linux
+ * drivers/bluetooth/hci_qca.c / btqca.c (GPL-2.0) and Android hardware/qcom/bt libbt-vendor (Apache-2.0) for the QCA
+ * UART sequence (version at 115200, peripheral + HCI baud change to the operating speed, download at that speed).
+ *   icegeni=1 (23h0): reads + the SE clock's branch vote only, no bt-enable needed: GCC wrap3 votes / CBCRs, the S5 RCG
+ *     (CMD/CFG/M/N, CMD_DFSR and the 8 DFS levels decoded to Hz), then gcc 0x52018 |= bit 17 (gcc_qupv3_wrap3_s5_clk,
+ *     the vote Linux's "se" clock makes) and, only with every wrap3 clock ON, the wrapper's QUP_HW_VER and SE5's GENI
+ *     registers (FW revision = protocol, 2 = UART; status; FIFO params; clock select / divider; UART config; IOS);
+ *     the vote put back as found.
+ *   icegeni=2/3 (23h): inside 23f2's bt-enable hold (icewifi=2 icespmi=3), instead of 23f3's GPIO UART: refused unless
+ *     the SE runs UART firmware (nothing loads SE firmware here: Linux on this tablet finds UART loaded by the boot
+ *     chain - no qupv3 firmware file exists in iceland-firmware) and the DFS table has a rate for 115200 x oversampling.
+ *     GENI init as geni_se_init + FIFO mode, 1 byte per FIFO word (U-Boot's packing 0xf / 0), 8N1, CTS ignored at
+ *     115200 (23f3 talked without it), RFR automatic; pads gpio24-27 -> function 1 qup3_se5 (DT: 26/27 pull-up,
+ *     24/25 pull-down, 2 mA). HCI_Reset, EDL version, board id. icegeni=3: as hci_qca for WCN7860: IBS wake 0xfd,
+ *     peripheral baud 31 00 f1 ff 02 02 11, 100 ms; RFR not ready, HCI 01 48 fc 01 11 (QCA_BAUDRATE_3200000), the host
+ *     to 3.2 Mbaud (DT max-speed), RFR automatic, 20 ms discarded; version again at 3.2 Mbaud (CTS honoured if the chip
+ *     asserts it); then 23f4b's download over the engine (NVM tag 17 baud kept at the file's 0x11 = 3.2 Mbaud).
+ *     icegeni=2: the download at 115200 over the engine (NVM baud 0).
+ *   Undo: RX / TX commands aborted, every SE register we wrote back to its value as found, pads as found, the S5 vote
+ *   as found; then 23f2's bt-enable low.
+ */
+#define QUP3_PA         0x019c0000u
+#define SE5_PA          0x01994000u
+#define S5_RCG          0xa8640u
+static int icegeni;
+static int f4_geni;                     /* 1: f4_xfer2 goes over the GENI engine */
+static int f4_nvm_keepbaud;             /* 1: NVM tag 17 baud left as in the file (the engine runs at 3.2 Mbaud) */
+static vm_offset_t h_se, h_gcc;
+static uint32_t h_txdepth = 16, h_rxdepth = 16, h_os = 16, h_dfs[8];
+static bool h_dfs_en;
+
+static void
+h_w(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(h_se + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* the S5 RCG's DFS levels in Hz (clk_rcg2_dfs_populate_freq: XO 19.2 MHz, GPLL0 600 MHz, GPLL0 even 300 MHz) */
+static void
+h_dfs_read(vm_offset_t gcc)
+{
+	h_dfs_en = io_rd(gcc, S5_RCG + 0x14) & 1;
+	for (int l = 0; l < 8; l++) {
+		uint32_t cfg = io_rd(gcc, S5_RCG + 0x1c + 4 * l), src = (cfg >> 8) & 7, hid = cfg & 0x1f, mode = (cfg >> 12) & 3;
+		uint64_t p = src == 0 ? 19200000ull : src == 1 ? 600000000ull : src == 6 ? 300000000ull : 0, f = p;
+		if (hid) {
+			f = f * 2 / (hid + 1);
+		}
+		if (mode && p) {
+			uint32_t m = io_rd(gcc, S5_RCG + 0x5c + 4 * l) & 0xffff, n = ((~io_rd(gcc, S5_RCG + 0x9c + 4 * l)) & 0xffff) + m;
+			f = n ? f * m / n : 0;
+		}
+		h_dfs[l] = (uint32_t)f;
+	}
+	say("icegeni: S5 RCG cmd %08x cfg %08x m %08x n %08x d %08x; CMD_DFSR %08x (DFS %s); levels Hz: %u %u %u %u %u %u %u %u\n",
+	    io_rd(gcc, S5_RCG), io_rd(gcc, S5_RCG + 4), io_rd(gcc, S5_RCG + 8), io_rd(gcc, S5_RCG + 0xc), io_rd(gcc, S5_RCG + 0x10),
+	    io_rd(gcc, S5_RCG + 0x14), h_dfs_en ? "on" : "off", h_dfs[0], h_dfs[1], h_dfs[2], h_dfs[3], h_dfs[4], h_dfs[5],
+	    h_dfs[6], h_dfs[7]);
+}
