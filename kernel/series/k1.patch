+
+// ---- the reports ------------------------------------------------------------------------------------------------------------
+bool
+send(const uint8_t *bytes, unsigned length)
+{
+	const IOReturn result = native_iceland_hid_send(gDevice, bytes, length);
+	if (result != kIOReturnSuccess && ++gC.sendErrors <= 5) {
+		IOLog("icehid: handleReport %#x (report %u)\n", result, bytes[0]);
+	}
+	return result == kIOReturnSuccess;
+}
+
+void
+consumerReport(uint16_t pc, uint32_t buttons)
+{
+	uint16_t slots[kConsumerSlots] = {pc, 0, 0, 0};
+	if (buttons & 1u << kButtonVolumeUp) {
+		slots[1] = kUsageVolumeUp;
+	}
+	if (buttons & 1u << kButtonVolumeDown) {
+		slots[2] = kUsageVolumeDown;
+	}
+	if (gPower == 1 && (buttons & 1u << kButtonPower)) {
+		slots[3] = kUsagePower;
+	}
+	uint8_t report[kConsumerReportBytes] = {kReportConsumer};
+	for (unsigned i = 0; i < kConsumerSlots; i++) {
+		report[1 + 2 * i] = uint8_t(slots[i]);
+		report[2 + 2 * i] = uint8_t(slots[i] >> 8);
+	}
+	send(report, sizeof(report));
+}
+
+// ---- w3-keys: the power key's shortcuts and the brightness steps ------------------------------------------------------------
+// One shortcut, typed as a person does: the modifiers, then the key (page 7) and / or the consumer usage (slot 0), both
+// released, then the modifiers. pc and shown are what the consumer report holds besides (put back after).
+void
+chord(uint8_t mods, uint8_t key, uint16_t consumer, uint16_t pc, uint32_t shown, uint32_t holdMs = 80)
+{
+	uint8_t report[kKeyboardReportBytes] = {kReportKeyboard, mods};
+	if (mods) {
+		send(report, sizeof(report));
+		IOSleep(30);
+	}
+	if (key) {
+		report[3] = key;
+		send(report, sizeof(report));
+	}
+	if (consumer) {
+		consumerReport(consumer, shown);
+	}
+	IOSleep(holdMs);
+	if (consumer) {
+		consumerReport(pc, shown);
+	}
+	if (key) {
+		report[3] = 0;
+		send(report, sizeof(report));
+	}
+	if (mods) {
+		IOSleep(30);
+		report[1] = 0;
+		send(report, sizeof(report));
+	}
+}
+
+void
+powerShort(uint64_t heldMs, uint16_t pc, uint32_t shown)
+{
+	gC.powerShort++;
+	if (gPower == 4 && gDarkened && hakios_iceland_backlight_level() == 0) {
+		// the light this key put out comes back (a brightness step that lit it meanwhile ends this: the next press locks)
+		const int error = hakios_iceland_backlight_power(1);
+		gDarkened = false;
+		gC.powerLight++;
+		if (gC.powerShort <= 20) {
+			IOLog("icehid: power key: short press %u (%llu ms): the backlight on again (%d), nothing typed\n", gC.powerShort,
+			    heldMs, error);
+		}
+		return;
+	}
+	if (gPower == 3) {
+		chord(kModControl | kModShift, 0, kUsageEject, pc, shown);
+	} else {
+		chord(kModControl | kModCommand, kKeyQ, 0, pc, shown);
+	}
+	int dark = -1;                                  // =4: the light off after the lock (0, or the backlight's error)
+	if (gPower == 4) {
+		dark = hakios_iceland_backlight_power(0);
+		if (dark == 0) {
+			gDarkened = true;
+			gC.powerDark++;
+		}
+	}
+	if (gC.powerShort <= 20) {
+		IOLog("icehid: power key: short press %u (%llu ms): %s typed%s\n", gC.powerShort, heldMs,
+		    gPower == 3 ? "Control-Shift-Eject (displays to sleep)" : "Control-Command-Q (lock the screen)",
+		    dark == 0 ? ", then the backlight off" : dark > 0 ? ", the backlight NOT switched off (no icebl=2?)" : "");
+	}
+}
+
+void
+powerLong(uint64_t heldMs, uint16_t pc, uint32_t shown)
+{
+	gC.powerLong++;
+	const char *what = "Control + consumer Power";
+	if (gPowerDialog == 1) {
+		chord(kModControl, 0, kUsageEject, pc, shown, 300);
+		what = "Control-Eject (held 300 ms)";
+	} else if (gPowerDialog == 2) {
+		chord(0, kKeyPower, 0, pc, shown);
+		what = "the keyboard page's Power key";
+	} else {
+		chord(kModControl, 0, kUsagePower, pc, shown);  // never with Command: Control-Command-Power is IOHIDSystem's restart
+	}
+	if (gC.powerLong <= 20) {
+		IOLog("icehid: power key: long press %u (held %llu ms): %s typed (the restart / sleep / shut down dialog)\n", gC.powerLong,
+		    heldMs, what);
+	}
+}
+
+void
+brightness(int steps, const char *from)
+{
+	const int level = hakios_iceland_backlight_step(steps);
+	if (level < 0) {
+		if (++gC.brightnessRefused <= 3) {
+			IOLog("icehid: brightness %+d from %s: the backlight refused (%d; icebl=2 not given, or no IC)\n", steps, from, -level);
+		}
+	} else {
+		gC.brightnessSteps++;
+	}
+}
+
+// The pointer's report (no report ID): buttons, X, Y, wheel 0, AC Pan 0. False when there is no pointer device.
+bool
+pointerReport(uint8_t buttons, uint16_t x, uint16_t y)
+{
+	IOService *pointer = __atomic_load_n(&gPointer, __ATOMIC_ACQUIRE);
+	if (!pointer) {
+		return false;
+	}
+	const uint8_t report[kPointerReportBytes] = {buttons, uint8_t(x), uint8_t(x >> 8), uint8_t(y), uint8_t(y >> 8), 0, 0};
+	const IOReturn result = native_iceland_hid_send(pointer, report, sizeof(report));
+	gC.pointer++;
+	if (result != kIOReturnSuccess && ++gC.pointerErrors <= 5) {
+		IOLog("icehid: pointer handleReport %#x\n", result);
+	}
+	return true;
+}
+
+// The digitizer's report for one frame (no report ID): the fingers down (tip + valid), then each finger of the frame before
+// that is gone, once, by its identifier (slot + 1): valid, tip up, at its last place; then the count of both. held is the
+// report thread's record of who is down, and where.
+void
+touchReport(const TouchFrame &frame, TouchFrame *held)
+{
+	IOService *touch = __atomic_load_n(&gTouch, __ATOMIC_ACQUIRE);
+	if (!touch) {
+		return;
+	}
+	uint8_t report[kTouchReportBytes] = {};
+	unsigned n = 0;
+	const auto put = [&](uint8_t bits, unsigned slot, uint16_t x, uint16_t y) {
+		    uint8_t *f = report + n++ *kTouchFingerBytes;
+		    f[0] = bits;
+		    f[1] = uint8_t(slot + 1);
+		    f[2] = uint8_t(x);
+		    f[3] = uint8_t(x >> 8);
+		    f[4] = uint8_t(y);
+		    f[5] = uint8_t(y >> 8);
+	    };
+	for (unsigned slot = 0; slot < kTouchFingers; slot++) {
+		if (frame.mask & 1u << slot) {
+			held->x[slot] = frame.x[slot] > kTouchMax ? uint16_t(kTouchMax) : frame.x[slot];
+			held->y[slot] = frame.y[slot] > kTouchMax ? uint16_t(kTouchMax) : frame.y[slot];
+			put(3, slot, held->x[slot], held->y[slot]);
+		}
+	}
+	const unsigned down = n;
+	for (unsigned slot = 0; slot < kTouchFingers; slot++) {
+		if ((held->mask & ~frame.mask) & 1u << slot) {
+			put(2, slot, held->x[slot], held->y[slot]);
+			gC.touchLifts++;
+		}
+	}
+	held->mask = frame.mask;
+	if (!n) {
+		return;
+	}
+	report[kTouchFingers * kTouchFingerBytes] = uint8_t(n);
+	const IOReturn result = native_iceland_hid_send(touch, report, sizeof(report));
+	gC.touchReports++;
+	if (result != kIOReturnSuccess && ++gC.touchErrors <= 5) {
+		IOLog("icehid: touch handleReport %#x\n", result);
+	}
+	if (gC.touchReports <= 6 || (n != down && gC.touchLifts <= 12)) {      // the first reports, and the first lifts
+		IOLog("icehid: touch report %u: %u down, %u lifted; first entry id %u at %#x, %#x (%#x)\n", gC.touchReports, down, n - down,
+		    report[1], report[2] | report[3] << 8, report[4] | report[5] << 8, result);
+	}
+}
+
+// The motion sensor's report for one sample (no report ID): the three axes in milli-g (the sample is mm/s2, the gsensor's,
+// 1 g = 9807), then the tilt: the edge that is up as tiltZ, in quarter turns of 90 degrees; tiltX and tiltY stay 0 (the hub
+// reports no tilt of its own, only which edge is up, which is what Orientation: Device Orientation carries here).
+void
+sensorReport(const SensorFrame &sample)
+{
+	IOService *sensor = __atomic_load_n(&gSensor, __ATOMIC_ACQUIRE);
+	if (!sensor) {
+		return;
+	}
+	const auto milliG = [](int32_t mm) {
+		    const int64_t value = (int64_t)mm * 1000 / 9807;
+		    return int16_t(value < -32768 ? -32768 : value > 32767 ? 32767 : value);
+	    };
+	const int32_t orient = sample.orient < 0 ? 0 : sample.orient > 3 ? 3 : sample.orient;   // -1: the hub has not decided yet
+	const SensorReport report = {milliG(sample.ax), milliG(sample.ay), milliG(sample.az), 0, 0, int16_t(orient * 90)};
+	const IOReturn result = native_iceland_hid_send(sensor, (const uint8_t *)&report, sizeof(report));
+	gC.sensorReports++;
+	if (result != kIOReturnSuccess && ++gC.sensorErrors <= 5) {
+		IOLog("icehid: sensor handleReport %#x\n", result);
+	}
+	if (gC.sensorReports <= 6) {                                  // the first reports: what the device is given
+		IOLog("icehid: sensor report %u: %d, %d, %d milli-g, tilt %d (orient %d) (%#x)\n", gC.sensorReports, report.ax,
+		    report.ay, report.az, report.tiltZ, sample.orient, result);
+	}
+}
+
+void
+hidThread(void *, wait_result_t)
+{
+	const uint8_t idle[kKeyboardReportBytes] = {kReportKeyboard};
+	bool keys = false;                 // the commands hold a key or a modifier
+	uint16_t pc = 0;                   // the commands' consumer usage
+	uint8_t pb = 0;                    // the pointer's buttons held, and where
+	uint16_t px = 0, py = 0;
+	TouchFrame held = {};              // the digitizer's fingers down, and where
+	uint64_t touchLast = 0;
+	uint32_t buttonsSent = 0, reportedCommands = 0;
+	// w3-keys: the side keys as the button driver has them (buttonsSent is what the consumer report shows of them), the
+	// volume keys hidden from macOS until released (pressed as brightness keys), and the power press under way
+	uint32_t buttonsRaw = 0, hidden = 0;
+	bool powerDown = false, powerUsed = false;
+	uint64_t powerAt = 0;
+	uint64_t last = nowMs(), reported = 0;
+	for (;;) {
+		char line[kLineBytes];
+		bool have = false;
+		IOLockLock(gLock);
+		if (gHead == gTail && !gReleaseWanted && gButtons == buttonsRaw && gTouchHead == gTouchTail && gSensorHead == gSensorTail) {
+			// 100 ms only while a command holds something (the auto-release); else a line, a key or a closed port wakes us
+			const uint32_t waitMs = keys || pc || pb || held.mask ? 100 :
+			    gC.commands - gC.pointerCommands != reportedCommands ? 1000 : 60000;
+			AbsoluteTime deadline;
+			clock_interval_to_deadline(waitMs, kMillisecondScale, &deadline);
+			IOLockSleepDeadline(gLock, &gRing, deadline, THREAD_UNINT);
+		}
+		if (gHead != gTail) {
+			memcpy(line, gRing[gTail % kRingLines], kLineBytes);
+			gTail++;
+			have = true;
+		}
+		TouchFrame frame = {};
+		bool haveFrame = false;
+		if (gTouchHead != gTouchTail) {
+			frame = gTouchRing[gTouchTail % kTouchRing];
+			gTouchTail++;
+			haveFrame = true;
+		}
+		SensorFrame sample = {};
+		bool haveSample = false;
+		if (gSensorHead != gSensorTail) {
+			sample = gSensorRing[gSensorTail % kSensorRing];
+			gSensorTail++;
+			haveSample = true;
+		}
+		const bool release = gReleaseWanted;
+		gReleaseWanted = false;
+		const uint32_t buttons = gButtons;
+		IOLockUnlock(gLock);
+		if (release) {
+			if (keys || pc) {
+				send(idle, sizeof(idle));
+				consumerReport(0, buttonsSent);
+				gC.releases++;
+			}
+			if (pb) {
+				pointerReport(0, px, py);
+				gC.releases++;
+			}
+			keys = false;
+			pc = 0;
+			pb = 0;
+			status("port closed");
+		}
+		if (haveFrame) {
+			touchReport(frame, &held);
+			touchLast = nowMs();
+		} else if (held.mask && nowMs() - touchLast > gHoldMs) {   // the touch thread went quiet with fingers down
+			const TouchFrame none = {};
+			touchReport(none, &held);
+			gC.touchAutoLifts++;
+			touchStatus();
+		}
+		if (haveSample) {
+			sensorReport(sample);
+		}
+		if (buttons != buttonsRaw) {
+			const uint32_t changed = buttons ^ buttonsRaw, pressed = changed & buttons;
+			buttonsRaw = buttons;
+			uint32_t shown = buttons;
+			if (gPower >= 2) {
+				if (pressed & kPowerBit) {
+					powerDown = true;
+					powerUsed = false;
+					powerAt = nowMs();
+				}
+				if (powerDown && gBlKeys && (pressed & kVolumeBits)) {   // power held: the volume keys are the brightness keys
+					if (pressed & 1u << kButtonVolumeUp) {
+						brightness(1, "power + volume up");
+					}
+					if (pressed & 1u << kButtonVolumeDown) {
+						brightness(-1, "power + volume down");
+					}
+					hidden |= pressed & kVolumeBits;
+					if (!powerUsed) {
+						powerUsed = true;                      // this press is a modifier now: no short, no long action
+						gC.powerChordKeys++;
+					}
+				}
+				// The power press is judged when it ends (keys-1: a timer at 1.2 s fired the long press while the owner was
+				// still about to press volume): used as the brightness modifier = nothing more; held icehid_power_long ms
+				// or more = the long press; else the short one.
+				if ((changed & kPowerBit) && !(buttons & kPowerBit) && powerDown) {
+					const uint64_t held = nowMs() - powerAt;
+					if (powerUsed) {
+						if (gC.powerChordKeys <= 20) {
+							IOLog("icehid: power key: released after %llu ms as the brightness modifier: no short or long press\n",
+							    held);
+						}
+					} else if (held >= gPowerLongMs) {
+						powerLong(held, pc, buttonsSent);
+						keys = false;
+					} else {
+						powerShort(held, pc, buttonsSent);
+						keys = false;
+					}
+					powerDown = false;
+				}
+				hidden &= buttons;                             // a hidden key is shown again only after its release
+				shown &= ~(kPowerBit | hidden);
+			}
+			if (shown != buttonsSent) {
+				buttonsSent = shown;
+				consumerReport(pc, shown);
+				gC.buttonReports++;
+			}
+		}
+		if (have) {
+			const Command c = parse(line);
+			last = nowMs();
+			switch (c.op) {
+			case Op::keyboard:
+				send(c.keyboard, sizeof(c.keyboard));
+				keys = c.down;
+				gC.keyboard++;
+				gC.commands++;
+				break;
+			case Op::consumer:
+				if (gBlKeys && (c.usage == kUsageBrightnessUp || c.usage == kUsageBrightnessDown)) {
+					brightness(c.usage == kUsageBrightnessUp ? 1 : -1, "a brightness key");   // and on to macOS, as piano does
+				}
+				pc = c.usage;
+				consumerReport(pc, buttonsSent);
+				gC.consumer++;
+				gC.commands++;
+				break;
+			case Op::release:
+				send(idle, sizeof(idle));
+				pc = 0;
+				consumerReport(0, buttonsSent);
+				keys = false;
+				if (pb) {
+					pointerReport(0, px, py);
+					pb = 0;
+				}
+				gC.releases++;
+				gC.commands++;
+				break;
+			case Op::pointer:
+				if (pointerReport(c.buttons, c.x, c.y)) {
+					pb = c.buttons;
+					px = c.x;
+					py = c.y;
+					gC.commands++;                         // the PC's tool compares this count with what it sent
+					gC.pointerCommands++;                  // ... but a moving finger is no "activity" line
+				} else {
+					gC.bad++;                              // no pointer device (no icehid_ptr=1, no icetouch=3)
+				}
+				break;
+			case Op::status:
+				status("status");
+				clients(true);
+				if (__atomic_load_n(&gPointer, __ATOMIC_ACQUIRE)) {
+					pointerStatus();
+					pointerClients(true);
+				}
+				if (__atomic_load_n(&gTouch, __ATOMIC_ACQUIRE)) {
+					touchStatus();
+					touchClients(true);
+				}
+				if (__atomic_load_n(&gSensor, __ATOMIC_ACQUIRE)) {
+					sensorStatus();
+					sensorClients(true);
+				}
+				break;
+			default:
+				gC.bad++;
+				break;
+			}
+		}
+		const uint64_t now = nowMs();
+		if ((keys || pc || pb) && now - last > gHoldMs) {
+			if (keys || pc) {
+				send(idle, sizeof(idle));
+				consumerReport(0, buttonsSent);
+			}
+			if (pb) {
+				pointerReport(0, px, py);
+			}
+			pc = 0;
+			pb = 0;
+			keys = false;
+			gC.autoReleases++;
+			status("held past icehid_hold, released");
+		}
+		if (gC.commands - gC.pointerCommands != reportedCommands && now - reported > 10000) {   // counts only, at most every 10 s
+			reported = now;
+			reportedCommands = gC.commands - gC.pointerCommands;
+			status("activity");
+		}
+	}
+}
+
+// ---- the self-test (icehid_test=N): a machine with no USB console ------------------------------------------------------------
+void
+testThread(void *, wait_result_t)
+{
+	unsigned waited = 0;
+	for (; !gDriverSeen && waited < 300; waited += 2) {
+		IOSleep(2000);
+	}
+	unsigned seen = 0, t = 0;
+	const unsigned clientWait = gPower >= 2 || gBlKeys ? 900 : 120;   // w3-keys: until WindowServer listens (see the top)
+	for (; t < clientWait && !(seen = clients(false)); t += 2) {   // a client of the event service: macOS listens
+		IOSleep(2000);
+	}
+	IOLog("icehid: self-test: driver %u after %u s, %u clients after %u s more; %u rounds\n", gDriverSeen ? 1 : 0, waited, seen,
+	    t, gTest);
+	for (unsigned round = 1; round <= gTest; round++) {
+		clients(true);
+		const uint32_t leds = gC.leds;
+		for (unsigned i = 0; i < 2; i++) {                      // Caps Lock on, then off: macOS answers each with an LED report
+			iceland_hid_line("K 0 39");
+			IOSleep(400);
+			iceland_hid_line("K 0");
+			IOSleep(2000);
+		}
+		iceland_hid_line("K 2");                                // shift+a, as the PC's tool types a capital
+		iceland_hid_line("K 2 4");
+		IOSleep(60);
+		iceland_hid_line("K 2");
+		iceland_hid_line("K 0");
+		iceland_hid_line("C e9");                               // volume up from a command
+		IOSleep(60);
+		iceland_hid_line("C 0");
+		IOSleep(500);
+		const unsigned keys[] = {kButtonVolumeUp, kButtonVolumeDown, kButtonPower};
+		for (unsigned key : keys) {                             // the side keys, as the button driver calls
+			if (key == kButtonPower && gPower >= 2) {
+				continue;                                       // (its own part below)
+			}
+			iceland_hid_button(key, 1);
+			IOSleep(120);
+			iceland_hid_button(key, 0);
+			IOSleep(500);
+		}
+		const Counts before = gC;
+		if (gBlKeys) {                                          // w3-keys: brightness down, then up again, from commands
+			iceland_hid_line("C 70");
+			IOSleep(60);
+			iceland_hid_line("C 0");
+			IOSleep(500);
+			iceland_hid_line("C 6f");
+			IOSleep(60);
+			iceland_hid_line("C 0");
+			IOSleep(500);
+		}
+		if (gPower >= 2) {
+			if (gBlKeys) {                                      // power held: volume down, volume up = brightness down, up
+				iceland_hid_button(kButtonPower, 1);
+				IOSleep(200);
+				iceland_hid_button(kButtonVolumeDown, 1);
+				IOSleep(120);
+				iceland_hid_button(kButtonVolumeDown, 0);
+				IOSleep(200);
+				iceland_hid_button(kButtonVolumeUp, 1);
+				IOSleep(120);
+				iceland_hid_button(kButtonVolumeUp, 0);
+				IOSleep(200);
+				iceland_hid_button(kButtonPower, 0);
+				IOSleep(1000);
+				iceland_hid_button(kButtonPower, 1);            // keys-1's case: power held past the long press, then volume
+				IOSleep(gPowerLongMs + 300);
+				iceland_hid_button(kButtonVolumeUp, 1);
+				IOSleep(120);
+				iceland_hid_button(kButtonVolumeUp, 0);
+				IOSleep(200);
+				iceland_hid_button(kButtonPower, 0);            // a modifier: no long press, no short press
+				IOSleep(1000);
+			}
+			if (round == 1) {                                   // once: a later round would act on what the first one opened
+				iceland_hid_button(kButtonPower, 1);            // a long press: the dialog, left up the hold
+				IOSleep(gPowerLongMs + 500);
+				iceland_hid_button(kButtonPower, 0);
+				IOSleep(gTestHoldMs);
+				iceland_hid_line("K 0 29");                     // Escape: the dialog's Cancel
+				IOSleep(60);
+				iceland_hid_line("K 0");
+				IOSleep(1000);
+				for (unsigned n = 0; n < (gPower == 4 ? 2u : 1u); n++) {   // a short press: the lock (=4: the light off, on)
+					iceland_hid_button(kButtonPower, 1);
+					IOSleep(150);
+					iceland_hid_button(kButtonPower, 0);
+					IOSleep(n == 0 ? gTestHoldMs : 3000);
+				}
+			}
+		}
+		iceland_hid_line("?");
+		IOSleep(1000);
+		IOLog("icehid: self-test round %u: %u LED reports came back from macOS (2 expected: Caps Lock on, off)\n", round,
+		    gC.leds - leds);
+		if (gPower >= 2 || gBlKeys) {
+			const bool once = gPower >= 2 && round == 1;
+			IOLog("icehid: self-test round %u: power key %u short (%u expected; light off %u, on %u: %u each expected), %u long "
+			    "(%u), %u as the brightness shift (%u); brightness steps %u, refused %u (%u asked); %u send errors\n", round,
+			    gC.powerShort - before.powerShort, once ? (gPower == 4 ? 2 : 1) : 0, gC.powerDark - before.powerDark,
+			    gC.powerLight - before.powerLight, once && gPower == 4 ? 1 : 0, gC.powerLong - before.powerLong, once ? 1 : 0,
+			    gC.powerChordKeys - before.powerChordKeys, gPower >= 2 && gBlKeys ? 2 : 0,
+			    gC.brightnessSteps - before.brightnessSteps, gC.brightnessRefused - before.brightnessRefused,
+			    gBlKeys ? (gPower >= 2 ? 5 : 2) : 0, gC.sendErrors - before.sendErrors);
+		}
+		if (round < gTest) {
+			IOSleep(60 * 1000);
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+// ---- the pointer's self-test (icehid_ptr_test=N), through the entry the touch screen uses -----------------------------------
+void
+pointerTestThread(void *, wait_result_t)
+{
+	enum { kSteps = 16, kStep = 0x100 };
+	unsigned waited = 0;
+	for (; !gPtrDriverSeen && waited < 300; waited += 2) {
+		IOSleep(2000);
+	}
+	unsigned seen = 0;
+	for (unsigned t = 0; t < 300 && !(seen = pointerClients(false)); t += 2) {   // a client of the event service: macOS listens
+		IOSleep(2000);
+	}
+	IOLog("icehid: pointer self-test: driver %u after %u s, %u clients; %u rounds\n", gPtrDriverSeen ? 1 : 0, waited, seen, gPtrTest);
+	for (unsigned round = 1; round <= gPtrTest; round++) {
+		const uint32_t reports = gC.pointer, errors = gC.pointerErrors, bad = gC.bad;
+		const uint32_t x0 = 0x1000 + 0x1800 * (round & 3), y0 = 0x2000;
+		for (unsigned i = 0; i <= kSteps; i++) {                // a move down the diagonal, no button
+			iceland_hid_pointer(0, x0 + i * kStep, y0 + i * kStep);
+			IOSleep(30);
+		}
+		iceland_hid_pointer(1, x0 + kSteps * kStep, y0 + kSteps * kStep);   // a click at its end
+		IOSleep(80);
+		iceland_hid_pointer(0, x0 + kSteps * kStep, y0 + kSteps * kStep);
+		IOSleep(500);
+		for (unsigned i = kSteps; i-- > 0;) {                   // a drag back up, as a finger sends it
+			iceland_hid_pointer(1, x0 + i * kStep, y0 + i * kStep);
+			IOSleep(30);
+		}
+		iceland_hid_pointer(0, x0, y0);
+		IOSleep(1000);
+		iceland_hid_line("?");
+		IOSleep(1000);
+		IOLog("icehid: pointer self-test round %u: %u reports (%u expected), %u errors, %u bad lines; parked at %#x, %#x\n", round,
+		    gC.pointer - reports, 2 * kSteps + 4, gC.pointerErrors - errors, gC.bad - bad, x0, y0);
+		if (round < gPtrTest) {
+			IOSleep(60 * 1000);
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+// ---- the digitizer's self-test (icehid_touch_test=N), through the entry the touch screen uses -------------------------------
+void
+touchTestThread(void *, wait_result_t)
+{
+	enum { kSteps = 16, kStep = 0x100 };
+	unsigned waited = 0;
+	for (; !gTouchDriverSeen && waited < 300; waited += 2) {
+		IOSleep(2000);
+	}
+	unsigned seen = 0, t = 0;
+	for (; t < gTouchWait && !(seen = touchClients(false)); t += 2) {   // a client of the event service: macOS listens
+		IOSleep(2000);
+	}
+	IOLog("icehid: touch self-test: driver %u after %u s, %u clients after %u s more; %u rounds\n", gTouchDriverSeen ? 1 : 0, waited,
+	    seen, t, gTouchTest);
+	if (gTouchDelay != 0) {                                        // icehid_touch_delay: the rounds start later, not at once
+		IOLog("icehid: touch self-test: icehid_touch_delay=%u: the rounds start in %u s\n", gTouchDelay, gTouchDelay);
+		IOSleep(gTouchDelay * 1000);
+	}
+	for (unsigned round = 1; round <= gTouchTest; round++) {
+		const Counts before = gC;
+		uint16_t xs[kTouchFingers] = {}, ys[kTouchFingers] = {};
+		const uint16_t x0 = uint16_t(0x1000 + 0x1800 * (round & 3)), y0 = 0x2000;
+		xs[0] = x0;                                             // a tap
+		ys[0] = y0;
+		iceland_hid_touch(1, xs, ys);
+		IOSleep(80);
+		iceland_hid_touch(0, xs, ys);
+		IOSleep(500);
+		for (unsigned i = 0; i <= kSteps; i++) {                // a drag down the diagonal
+			xs[0] = uint16_t(x0 + i * kStep);
+			ys[0] = uint16_t(y0 + i * kStep);
+			iceland_hid_touch(1, xs, ys);
+			IOSleep(30);
+		}
+		iceland_hid_touch(0, xs, ys);
+		IOSleep(500);
+		xs[0] = x0;                                             // two fingers down together, the second lifts first
+		ys[0] = y0;
+		xs[1] = uint16_t(x0 + 0x800);
+		ys[1] = uint16_t(y0 + 0x800);
+		iceland_hid_touch(3, xs, ys);
+		IOSleep(100);
+		iceland_hid_touch(1, xs, ys);
+		IOSleep(100);
+		iceland_hid_touch(0, xs, ys);
+		IOSleep(1000);
+		iceland_hid_line("?");
+		IOSleep(1000);
+		IOLog("icehid: touch self-test round %u: %u frames, %u reports (%u expected), %u lifts (4 expected), %u errors, %u auto-lifts, "
+		    "%u overrun; from %#x, %#x\n", round, gC.touchFrames - before.touchFrames, gC.touchReports - before.touchReports,
+		    kSteps + 7, gC.touchLifts - before.touchLifts, gC.touchErrors - before.touchErrors,
+		    gC.touchAutoLifts - before.touchAutoLifts, gC.touchOverrun - before.touchOverrun, x0, y0);
+		if (round < gTouchTest) {
+			IOSleep(gTouchGap * 1000);                              // icehid_touch_gap, default 60 s
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+// ---- render1 r4g: the scripted gesture player (icegst=1 | icegst=<s>; default off) ------------------------------------------
+// The owner tests by hand only the keyboard pairing; the render runs' movement is replayed by the kernel instead, through the
+// SAME entries real input uses: iceland_hid_touch() (the digitizer's frames, as bsd/dev/hakios_iceland_touch.c hands them in)
+// and iceland_hid_line() (the keyboard's "K" lines, as the USB console's monitor does). From icegst seconds after boot (1 =
+// the default 480 s: after the autofix restart at ~330-380 s and a settle), deterministic and timed:
+//   idle 120 s, move 120 s, idle 120 s, move 120 s, done.
+// A move block repeats a ~10-s cycle: Mission Control in and out (Control-Up twice), three one-finger drags across the
+// screen's upper middle (where a centred window's title bar lies: it moves; elsewhere a drag selects or scrolls), a
+// two-finger vertical scroll in the middle (up, then down), a three-finger sideways swipe and back, App Expose in and out
+// (Control-Down twice). Frames 16 ms apart (~60 Hz), coordinates 0..0x7fff over the display.
+// A real touch ends it at once: the touch driver stamps hakios_ui_touch_at at every finger down (the player's own frames do
+// not pass there); the player then lifts its fingers, releases every key ("R") and stops for good. Every phase start / end
+// and the stop are "icegesture:" lines with the uptime, so a console can be cut into idle and move phases. No state outside
+// the thread (its stack); it is only started with the word on the line.
+extern "C" volatile uint64_t hakios_ui_touch_at;
+
+uint64_t
+gestureUptime(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_SEC;
+}
+
+// sleeps MS milliseconds in 16-ms steps; false as soon as a real finger came down since the player began (TOUCH0)
+bool
+gestureWait(uint32_t ms, uint64_t touch0)
+{
+	for (uint32_t done = 0; done < ms; done += 16) {
+		if (hakios_ui_touch_at != touch0) {
+			return false;
+		}
+		IOSleep(16);
+	}
+	return hakios_ui_touch_at == touch0;
+}
+
+// one key chord as a person types it: the modifiers and the key down, held 80 ms, everything up
+bool
+gestureKey(const char *down, uint64_t touch0)
+{
+	iceland_hid_line(down);
+	const bool ok = gestureWait(80, touch0);
+	iceland_hid_line("K 0");
+	return ok;
+}
+
+// FINGERS fingers (1..3, 0x600 apart across) from (x0, y0) to (x1, y1) in STEPS frames 16 ms apart, then lifted
+bool
+gestureDrag(unsigned fingers, int x0, int y0, int x1, int y1, unsigned steps, uint64_t touch0, unsigned *frames)
+{
+	uint16_t xs[kTouchFingers] = {}, ys[kTouchFingers] = {};
+	const uint32_t mask = (1u << fingers) - 1;
+	for (unsigned i = 0; i <= steps; i++) {
+		const int x = x0 + (x1 - x0) * (int)i / (int)steps, y = y0 + (y1 - y0) * (int)i / (int)steps;
+		for (unsigned f = 0; f < fingers; f++) {
+			const int fx = x + (int)f * 0x600;
+			xs[f] = uint16_t(fx < 0 ? 0 : fx > 0x7fff ? 0x7fff : fx);
+			ys[f] = uint16_t(y < 0 ? 0 : y > 0x7fff ? 0x7fff : y);
+		}
+		iceland_hid_touch(mask, xs, ys);
+		(*frames)++;
+		if (!gestureWait(16, touch0)) {
+			iceland_hid_touch(0, xs, ys);
+			return false;
+		}
+	}
+	iceland_hid_touch(0, xs, ys);
+	(*frames)++;
+	return gestureWait(300, touch0);
+}
+
+// one move block of SECONDS: the ~10-s cycle until the time is up; false when a real touch ended it
+bool
+gestureMove(uint32_t seconds, uint64_t touch0, unsigned *frames, unsigned *cycles)
+{
+	const uint64_t until = gestureUptime() + seconds;
+	while (gestureUptime() < until) {
+		if (!gestureKey("K 01 52", touch0) || !gestureWait(1800, touch0) ||       // Mission Control (Control-Up) in ...
+		    !gestureKey("K 01 52", touch0) || !gestureWait(1200, touch0)) {       // ... and out
+			return false;
+		}
+		for (unsigned k = 0; k < 3; k++) {                                       // drags across the upper middle and back
+			const int y = 0x1400 + (int)k * 0x700;
+			if (!gestureDrag(1, 0x4000, y, 0x2000, y, 40, touch0, frames) ||
+			    !gestureDrag(1, 0x2000, y, 0x4000, y, 40, touch0, frames)) {
+				return false;
+			}
+		}
+		if (!gestureDrag(2, 0x3800, 0x5000, 0x3800, 0x3000, 40, touch0, frames) ||  // two-finger scroll up, then down
+		    !gestureDrag(2, 0x3800, 0x3000, 0x3800, 0x5000, 40, touch0, frames) ||
+		    !gestureDrag(3, 0x5000, 0x4000, 0x2000, 0x4000, 30, touch0, frames) ||  // three-finger swipe left, then right
+		    !gestureDrag(3, 0x2000, 0x4000, 0x5000, 0x4000, 30, touch0, frames)) {
+			return false;
+		}
+		if (!gestureKey("K 01 51", touch0) || !gestureWait(1500, touch0) ||       // App Expose (Control-Down) in ...
+		    !gestureKey("K 01 51", touch0) || !gestureWait(1200, touch0)) {       // ... and out
+			return false;
+		}
+		(*cycles)++;
+	}
+	return true;
+}
+
+void
+gestureThread(void *arg, wait_result_t)
+{
+	const uint32_t start = (uint32_t)(uintptr_t)arg;
+	unsigned frames = 0, cycles = 0;
+
+	IOLog("icegesture: armed: from %u s after boot: idle 120 s, move 120 s, idle 120 s, move 120 s (digitizer %s); a real touch "
+	    "stops it\n", start, __atomic_load_n(&gTouch, __ATOMIC_ACQUIRE) ? "present" : "ABSENT: key chords only");
+	while (gestureUptime() < start) {
+		IOSleep(1000);
+	}
+	const uint64_t touch0 = hakios_ui_touch_at;
+	for (unsigned p = 0; p < 4; p++) {
+		const Counts before = gC;
+		const unsigned f0 = frames, c0 = cycles;
+		const char *phase = p == 0 ? "idle 1" : p == 1 ? "move 1" : p == 2 ? "idle 2" : "move 2";
+		bool ok;
+
+		IOLog("icegesture: t=%llu %s start\n", gestureUptime(), phase);
+		ok = (p & 1) ? gestureMove(120, touch0, &frames, &cycles) : gestureWait(120 * 1000, touch0);
+		IOLog("icegesture: t=%llu %s end: %u frames, %u cycles, %u touch reports, %u keyboard commands\n", gestureUptime(), phase,
+		    frames - f0, cycles - c0, gC.touchReports - before.touchReports, gC.commands - before.commands);
+		if (!ok) {
+			uint16_t xs[kTouchFingers] = {}, ys[kTouchFingers] = {};
+			iceland_hid_touch(0, xs, ys);
+			iceland_hid_line("R");
+			IOLog("icegesture: t=%llu stopped: a real touch came down (%s); fingers lifted, keys released\n", gestureUptime(),
+			    phase);
+			thread_terminate(current_thread());
+			return;
+		}
+	}
+	IOLog("icegesture: t=%llu done: %u frames, %u cycles\n", gestureUptime(), frames, cycles);
+	thread_terminate(current_thread());
+}
+
+// ---- the motion sensor's self-test (icehid_sns_test=N), through the entry the DSP's samples use ----------------------------
+void
+sensorTestThread(void *, wait_result_t)
+{
+	unsigned waited = 0;
+	for (; !gSensorDriverSeen && waited < 300; waited += 2) {
+		IOSleep(2000);
+	}
+	unsigned seen = 0, t = 0;
+	for (; t < gSensorWait && !(seen = sensorClients(false)); t += 2) {   // a client of the event service: macOS listens
+		IOSleep(2000);
+	}
+	IOLog("icehid: sensor self-test: driver %u after %u s, %u clients after %u s more; %u rounds\n", gSensorDriverSeen ? 1 : 0,
+	    waited, seen, t, gSensorTest);
+	for (unsigned round = 1; round <= gSensorTest; round++) {
+		const Counts before = gC;
+		iceland_hid_sensor(8160, 20, 5960, 0);                  // on the stand, landscape: the hub's own first reading
+		IOSleep(300);
+		iceland_hid_sensor(100, -9000, 2000, 3);                // turned onto its other edge
+		IOSleep(300);
+		iceland_hid_line("?");
+		IOSleep(1000);
+		IOLog("icehid: sensor self-test round %u: %u samples, %u reports (2 expected), %u errors, %u overrun; from %d, %d, %d "
+		    "mm/s2 and orient %d\n", round, gC.sensorSamples - before.sensorSamples, gC.sensorReports - before.sensorReports,
+		    gC.sensorErrors - before.sensorErrors, gC.sensorOverrun - before.sensorOverrun, 8160, 20, 5960, 0);
+		if (round < gSensorTest) {
+			IOSleep(60 * 1000);
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+// ---- the start --------------------------------------------------------------------------------------------------------------
+bool
+eventServicePublished(void *, void *, IOService *service, IONotifier *)
+{
+	for (IOService *provider = service->getProvider(); provider; provider = provider->getProvider()) {
+		if (provider->metaCast("NativeIcelandHid")) {
+			const bool pointer = native_iceland_hid_is_pointer(provider), touch = native_iceland_hid_is_touch(provider);
+			const bool sensor = native_iceland_hid_is_sensor(provider);
+			if (sensor) {
+				gSensorDriverSeen = true;
+			} else if (touch) {
+				gTouchDriverSeen = true;
+			} else if (pointer) {
+				gPtrDriverSeen = true;
+			} else {
+				gDriverSeen = true;
+			}
+			IOLog("icehid: event service %s published on the %s: macOS has it\n", service->getMetaClass()->getClassName(),
+			    sensor ? "motion sensor" : touch ? "touch digitizer" : pointer ? "pointer" : "keyboard");
+			break;
+		}
+	}
+	return true;
+}
+
+__attribute__((noreturn)) void
+fail(int step, const char *why)
+{
+	gStage = -step;
+	IOLog("icehid: not started (step %d: %s)\n", step, why);
+	thread_terminate(current_thread());
+	__builtin_unreachable();
+}
+
+// piano's PianoUsbHIDEventDriver personality, for our pair
+bool
+addPersonality(uint32_t vendorId, uint32_t productId)
+{
+	OSDictionary *p = OSDictionary::withCapacity(6);
+	OSString *bundle = OSString::withCString("com.apple.iokit.IOHIDFamily");
+	OSString *cls = OSString::withCString("IOHIDEventDriver");
+	OSString *provider = OSString::withCString("IOHIDInterface");
+	OSNumber *vendor = OSNumber::withNumber(vendorId, 32);
+	OSNumber *product = OSNumber::withNumber(productId, 32);
+	OSNumber *score = OSNumber::withNumber(3000, 32);
+	bool ok = p && bundle && cls && provider && vendor && product && score && p->setObject(kCFBundleIdentifierKey, bundle) &&
+	    p->setObject(kIOClassKey, cls) && p->setObject(kIOProviderClassKey, provider) && p->setObject("VendorID", vendor) &&
+	    p->setObject("ProductID", product) && p->setObject(kIOProbeScoreKey, score);
+	if (ok) {
+		const OSObject *objects[] = {p};
+		OSArray *drivers = OSArray::withObjects(objects, 1);
+		ok = drivers && gIOCatalogue->addDrivers(drivers, true);
+		OSSafeReleaseNULL(drivers);
+	}
+	OSSafeReleaseNULL(score);
+	OSSafeReleaseNULL(product);
+	OSSafeReleaseNULL(vendor);
+	OSSafeReleaseNULL(provider);
+	OSSafeReleaseNULL(cls);
+	OSSafeReleaseNULL(bundle);
+	OSSafeReleaseNULL(p);
+	return ok;
+}
+
+// The second device (input step 3). A failure here leaves the keyboard as it is.
+void
+startPointer(void)
+{
+	const bool personality = addPersonality(kVendorId, kPointerProductId);
+	IOService *device = native_iceland_hid_allocate_pointer();
+	IOService *parent = IOService::getResourceService();
+	int step = 0;
+	if (!device || !device->metaCast("IOHIDDevice") || !device->init(nullptr) || !parent) {
+		step = 4;
+	} else {
+		device->setProperty("Built-In", true);
+		if (!device->attach(parent)) {
+			step = 5;
+		} else if (!device->start(parent)) {
+			device->detach(parent);
+			step = 6;
+		}
+	}
+	if (step) {
+		OSSafeReleaseNULL(device);
+		IOLog("icehid: pointer not started (step %d)\n", step);
+		return;
+	}
+	__atomic_store_n(&gPointer, device, __ATOMIC_RELEASE);   // held for the life of the system
+	IOLog("icehid: pointer started: product %#x, %u-byte descriptor, registry ID %#llx, personality %s\n", kPointerProductId,
+	    (unsigned)sizeof(kPointerDescriptor), device->getRegistryEntryID(), personality ? "added" : "NOT added");
+	if (gPtrTest) {
+		thread_t thread = nullptr;
+		if (kernel_thread_start(pointerTestThread, nullptr, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+
+// The display's UUID for the digitizer: the string the display itself publishes as IOMFBUUID (iokit/Native/GopFramebuffer/
+// NativeLegacyDisplay.cpp publishDisplayContainer; the tablet's line "disp: NativeLegacyDisplay started ... IOMFBUUID ..."),
+// read from that service rather than made again here. The display starts beside this worker, so it is waited for.
+bool
+displayUUID(char *text, size_t size)
+{
+	OSDictionary *matching = IOService::serviceMatching("NativeLegacyDisplay");
+	if (!matching) {
+		return false;
+	}
+	IOService *display = IOService::waitForMatchingService(matching, 30ull * NSEC_PER_SEC);
+	matching->release();
+	if (!display) {
+		return false;
+	}
+	bool found = false;
+	for (unsigned tries = 0; tries < 50 && !found; tries++) {      // the property is set in its start
+		OSObject *value = display->copyProperty("IOMFBUUID");
+		if (OSString *uuid = OSDynamicCast(OSString, value)) {
+			found = uuid->getLength() == 36 && strlcpy(text, uuid->getCStringNoCopy(), size) < size;
+		}
+		OSSafeReleaseNULL(value);
+		if (!found) {
+			IOSleep(100);
+		}
+	}
+	display->release();
+	return found;
+}
+
+// The digitizer device (input step 4), in the pointer's place. A failure here leaves the keyboard as it is.
+void
+startTouch(void)
+{
+	const bool personality = addPersonality(kVendorId, kTouchProductId);
+	const bool paired = displayUUID(gTouchDisplay, sizeof(gTouchDisplay));
+	if (!paired) {
+		gTouchDisplay[0] = 0;
+	}
+	IOService *device = native_iceland_hid_allocate_touch();
+	IOService *parent = IOService::getResourceService();
+	int step = 0;
+	if (!device || !device->metaCast("IOHIDDevice") || !device->init(nullptr) || !parent) {
+		step = 4;
+	} else {
+		// sheng's set (NativeHidInput.cpp:446-456): a built-in, display-integrated digitizer whose reports are dispatched as
+		// one collection, tied to the display by its UUID (WindowServer) and its container ID (CoreDisplay's EDID route)
+		device->setProperty("Built-In", true);
+		device->setProperty("DisplayIntegrated", true);
+		device->setProperty("DigitizerCollectionDispatch", true);
+		if (paired) {
+			device->setProperty("displayUUID", gTouchDisplay);
+			device->setProperty("kUSBContainerID", gTouchDisplay);
+		}
+		if (!device->attach(parent)) {
+			step = 5;
+		} else if (!device->start(parent)) {
+			device->detach(parent);
+			step = 6;
+		}
+	}
+	if (step) {
+		OSSafeReleaseNULL(device);
+		IOLog("icehid: touch digitizer not started (step %d)\n", step);
+		return;
+	}
+	__atomic_store_n(&gTouch, device, __ATOMIC_RELEASE);   // held for the life of the system
+	IOLog("icehid: touch digitizer started: product %#x, %u-byte descriptor, %u fingers, registry ID %#llx, personality %s, "
+	    "displayUUID %s\n", kTouchProductId, (unsigned)sizeof(kTouchDescriptor), (unsigned)kTouchFingers,
+	    device->getRegistryEntryID(), personality ? "added" : "NOT added",
+	    paired ? gTouchDisplay : "NOT set (no NativeLegacyDisplay with an IOMFBUUID in 30 s): WindowServer will not take it");
+	if (gTouchTest) {
+		thread_t thread = nullptr;
+		if (kernel_thread_start(touchTestThread, nullptr, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+
+// w4-sensors: the motion sensor (icehid_sns=1), beside the keyboard and independent of the touch screen's two devices. A
+// failure here leaves the keyboard as it is.
+void
+startSensor(void)
+{
+	const bool personality = addPersonality(kVendorId, kSensorProductId);
+	IOService *device = native_iceland_hid_allocate_sensor();
+	IOService *parent = IOService::getResourceService();
+	int step = 0;
+	if (!device || !device->metaCast("IOHIDDevice") || !device->init(nullptr) || !parent) {
+		step = 4;
+	} else {
+		device->setProperty("Built-In", true);
+		if (!device->attach(parent)) {
+			step = 5;
+		} else if (!device->start(parent)) {
+			device->detach(parent);
+			step = 6;
+		}
+	}
+	if (step) {
+		OSSafeReleaseNULL(device);
+		IOLog("icehid: motion sensor not started (step %d)\n", step);
+		return;
+	}
+	__atomic_store_n(&gSensor, device, __ATOMIC_RELEASE);   // held for the life of the system
+	IOLog("icehid: motion sensor started: product %#x, %u-byte descriptor, registry ID %#llx, personality %s\n", kSensorProductId,
+	    (unsigned)sizeof(kSensorDescriptor), device->getRegistryEntryID(), personality ? "added" : "NOT added");
+	if (gSensorTest) {
+		thread_t thread = nullptr;
+		if (kernel_thread_start(sensorTestThread, nullptr, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+
+void
+worker(void *, wait_result_t)
+{
+	native_wait_for_launchd("icehid");
+	const OSReturn loaded = OSKextLoadKextWithIdentifier("com.apple.iokit.IOHIDFamily");
+	if (loaded != kOSReturnSuccess && loaded != kOSKextReturnStartStopError) {
+		IOLog("icehid: IOHIDFamily not loaded (%#x)\n", loaded);
+		fail(1, "the family kext");
+	}
+	void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+	if (!handle) {
+		fail(2, "preModLoad");
+	}
+	native_iceland_hid_static_init();
+	const OSReturn meta = OSMetaClass::postModLoad(handle);
+	if (meta) {
+		IOLog("icehid: postModLoad %#x\n", meta);
+		fail(3, "the metaclass");
+	}
+	if (OSDictionary *matching = IOService::serviceMatching("IOHIDEventService")) {
+		gPublished = IOService::addMatchingNotification(gIOFirstPublishNotification, matching, eventServicePublished, nullptr, nullptr);
+		matching->release();
+	}
+	const bool personality = addPersonality(keyboardVendorId(), kProductId);   // the device's own pair (IcelandHidReports.h)
+	IOService *device = native_iceland_hid_allocate();
+	IOService *parent = IOService::getResourceService();
+	if (!device || !device->metaCast("IOHIDDevice") || !device->init(nullptr) || !parent) {
+		OSSafeReleaseNULL(device);
+		fail(4, "the device object");
+	}
+	device->setProperty("Built-In", true);          // kIOHIDBuiltInKey, as piano sets it
+	if (!device->attach(parent)) {
+		device->release();
+		fail(5, "attach");
+	}
+	if (!device->start(parent)) {
+		device->detach(parent);
+		device->release();
+		fail(6, "IOHIDDevice::start");
+	}
+	gDevice = device;                                // held for the life of the system
+	thread_t thread = nullptr;
+	if (kernel_thread_start(hidThread, nullptr, &thread) != KERN_SUCCESS) {
+		fail(7, "the report thread");
+	}
+	thread_deallocate(thread);
+	gStage = 10;
+	__atomic_store_n(&gOpen, true, __ATOMIC_RELEASE);
+	IOLog("icehid: keyboard started: vendor %#x product %#x, %u-byte descriptor, registry ID %#llx, IOHIDEventDriver personality "
+	    "%s; hold %u ms, power key %s\n", keyboardVendorId(), kProductId, (unsigned)sizeof(kDescriptor), device->getRegistryEntryID(),
+	    personality ? "added" : "NOT added", gHoldMs, gPower == 1 ? "consumer Power" : gPower == 2 ? "short = lock, long = dialog" :
+	    gPower == 3 ? "short = displays to sleep, long = dialog" : gPower == 4 ? "short = lock + light off / light on, long = dialog" :
+	    "left out");
+	if (gPower >= 2 || gBlKeys) {
+		IOLog("icehid: power key long press %u ms, dialog shortcut %u; brightness keys %s\n", gPowerLongMs, gPowerDialog,
+		    gBlKeys ? "step the backlight (icebl_keys=1)" : "off");
+	}
+	{
+		/* render1 r4g: icegst=1 (from 480 s) or icegst=<s> (from s seconds after boot, 2..3600): the gesture player */
+		uint32_t gst = 0;
+		if (PE_parse_boot_argn("icegst", &gst, sizeof(gst)) && gst != 0) {
+			const uint32_t from = gst == 1 ? 480 : gst < 3600 ? gst : 3600;
+			if (kernel_thread_start(gestureThread, (void *)(uintptr_t)from, &thread) == KERN_SUCCESS) {
+				thread_deallocate(thread);
+			}
+		}
+	}
+	if (gTest) {
+		if (kernel_thread_start(testThread, nullptr, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	// The touch screen is one device or the other, never both (the owner's rule): the digitizer with icetouch_dig=1, else the
+	// pointer when it is asked for.
+	if (gDig) {
+		IOLog("icehid: touch as digitizer (pointer off): icetouch_dig=1\n");
+		startTouch();
+	} else if (gPtr) {
+		IOLog("icehid: touch as pointer (digitizer off): no icetouch_dig=1\n");
+		startPointer();
+	}
+	// w4-sensors: the motion sensor, a device of its own (no touch screen is involved: it is the Hub's accelerometer)
+	if (gSns) {
+		IOLog("icehid: motion sensor on: icehid_sns=1\n");
+		startSensor();
+	}
+	thread_terminate(current_thread());
+}
+}  // namespace
+
+// ---- the entry points -------------------------------------------------------------------------------------------------------
+// One command line (NUL-terminated, without any prefix). Any thread that may take a mutex; not from interrupt context.
+void
+iceland_hid_line(const char *line)
+{
+	if (!line || !__atomic_load_n(&gOpen, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	IOLockLock(gLock);
+	if (gHead - gTail >= kRingLines) {
+		gC.dropped++;
+	} else {
+		strlcpy(gRing[gHead % kRingLines], line, kLineBytes);
+		gHead++;
+	}
+	IOLockWakeup(gLock, &gRing, true);
+	IOLockUnlock(gLock);
+}
+
+// The lines' source went away (DTR off, a bus reset): what the commands hold is released.
+void
+iceland_hid_port_closed(void)
+{
+	if (!__atomic_load_n(&gOpen, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	IOLockLock(gLock);
+	gReleaseWanted = true;
+	IOLockWakeup(gLock, &gRing, true);
+	IOLockUnlock(gLock);
+}
+
+// A side key changed (bsd/dev/hakios_iceland_buttons.c's thread): button is sys/redwood_input.h's REDWOOD_BUTTON_*.
+void
+iceland_hid_button(uint32_t button, int pressed)
+{
+	if (button < kButtonPower || button > kButtonVolumeDown || !__atomic_load_n(&gOpen, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	IOLockLock(gLock);
+	gC.buttonEvents++;
+	if (button == kButtonPower && !gPower) {
+		gC.powerMasked++;
+	} else {
+		gButtons = pressed ? gButtons | 1u << button : gButtons & ~(1u << button);
+		IOLockWakeup(gLock, &gRing, true);
+	}
+	IOLockUnlock(gLock);
+}
+
+// The pointer (the touch screen's thread, the self-test): buttons bit 0 left, x and y in 0..0x7fff over the display. As a
+// line of the ring, so reports keep their order with everything else; returns at once without a pointer device.
+void
+iceland_hid_pointer(uint32_t buttons, uint32_t x, uint32_t y)
+{
+	if (!__atomic_load_n(&gPointer, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	char line[kLineBytes];
+	const uint32_t max = icelandhid::kPointerMax;
+	snprintf(line, sizeof(line), "A %x %x %x", buttons & 7, x > max ? max : x, y > max ? max : y);
+	iceland_hid_line(line);
+}
+
+// The digitizer (the touch screen's thread, the self-test): one report's finger set. Bit n of mask = slot n (0..9) is down,
+// at xs[n], ys[n] in 0..0x7fff over the display. Queued for the report thread; returns at once without a digitizer device.
+// When the ring is full the newest frame is replaced: the last state always arrives, so no finger stays down.
+void
+iceland_hid_touch(uint32_t mask, const uint16_t *xs, const uint16_t *ys)
+{
+	if (!__atomic_load_n(&gTouch, __ATOMIC_ACQUIRE) || !__atomic_load_n(&gOpen, __ATOMIC_ACQUIRE) || !xs || !ys) {
+		return;
+	}
+	TouchFrame frame = {};
+	frame.mask = uint16_t(mask & ((1u << icelandhid::kTouchFingers) - 1));
+	for (unsigned slot = 0; slot < icelandhid::kTouchFingers; slot++) {
+		if (frame.mask & 1u << slot) {
+			frame.x[slot] = xs[slot];
+			frame.y[slot] = ys[slot];
+		}
+	}
+	IOLockLock(gLock);
+	gC.touchFrames++;
+	if (gTouchHead - gTouchTail >= kTouchRing) {
+		gC.touchOverrun++;
+		gTouchRing[(gTouchHead - 1) % kTouchRing] = frame;
+	} else {
+		gTouchRing[gTouchHead % kTouchRing] = frame;
+		gTouchHead++;
+	}
+	IOLockWakeup(gLock, &gRing, true);
+	IOLockUnlock(gLock);
+}
+
+// The motion sensor (bsd/dev/hakios_iceland_sensors.c's pump thread, at the hub's rate, and the self-test): one accelerometer
+// sample in mm/s2 (the gsensor's units) and which edge of the Pad is up (kern.iceorient: -1 not known yet, 0..3). Queued for
+// the report thread; returns at once without a motion sensor device. When the ring is full the newest sample is replaced: the
+// last reading is the one that counts.
+void
+iceland_hid_sensor(int ax_mm, int ay_mm, int az_mm, int orient)
+{
+	if (!__atomic_load_n(&gSensor, __ATOMIC_ACQUIRE) || !__atomic_load_n(&gOpen, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	SensorFrame sample = {ax_mm, ay_mm, az_mm, orient};
+	IOLockLock(gLock);
+	gC.sensorSamples++;
+	if (gSensorHead - gSensorTail >= kSensorRing) {
+		gC.sensorOverrun++;
+		gSensorRing[(gSensorHead - 1) % kSensorRing] = sample;
+	} else {
+		gSensorRing[gSensorHead % kSensorRing] = sample;
+		gSensorHead++;
+	}
+	IOLockWakeup(gLock, &gRing, true);
+	IOLockUnlock(gLock);
+}
+
+// macOS wrote the keyboard's LED report (NativeIcelandHid::setReport, in the writer's context)
+void
+native_iceland_hid_led_observed(uint32_t leds, uint32_t bytes)
+{
+	gC.leds = gC.leds + 1;
+	gC.lastLeds = leds;
+	if (gC.leds <= 8) {
+		char name[20] = {};
+		proc_selfname(name, sizeof(name));
+		IOLog("icehid: LED report %u from %s: %u bytes, LEDs %02x (Caps Lock %s)\n", gC.leds, name, bytes, leds,
+		    leds & 2 ? "on" : "off");
+	}
+}
+
+// The board entry (IOKitBSDInit, after IOBSD is published)
+void
+native_iceland_hid_probe(void)
+{
+	unsigned enabled = 0;
+	if (!PE_parse_boot_argn("icehid", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	PE_parse_boot_argn("icehid_hold", &gHoldMs, sizeof(gHoldMs));
+	PE_parse_boot_argn("icehid_power", &gPower, sizeof(gPower));
+	PE_parse_boot_argn("icehid_test", &gTest, sizeof(gTest));
+	if (gTest > 8) {
+		gTest = 8;
+	}
+	/* w3-keys */
+	if (gPower > 4) {
+		gPower = 0;
+	}
+	PE_parse_boot_argn("icehid_test_hold", &gTestHoldMs, sizeof(gTestHoldMs));
+	gTestHoldMs = gTestHoldMs < 1000 ? 1000 : gTestHoldMs > 300000 ? 300000 : gTestHoldMs;
+	PE_parse_boot_argn("icehid_power_long", &gPowerLongMs, sizeof(gPowerLongMs));
+	gPowerLongMs = gPowerLongMs < 400 ? 400 : gPowerLongMs > 5000 ? 5000 : gPowerLongMs;
+	PE_parse_boot_argn("icehid_power_dialog", &gPowerDialog, sizeof(gPowerDialog));
+	PE_parse_boot_argn("icebl_keys", &gBlKeys, sizeof(gBlKeys));
+	gBlKeys = gBlKeys == 1;
+	/* input step 3: the pointer device, asked for by name or by the touch screen's reports (icetouch=3) */
+	unsigned touch = 0;
+	PE_parse_boot_argn("icehid_ptr", &gPtr, sizeof(gPtr));
+	if (PE_parse_boot_argn("icetouch", &touch, sizeof(touch)) && touch >= 3) {
+		gPtr = 1;
+	}
+	PE_parse_boot_argn("icehid_ptr_test", &gPtrTest, sizeof(gPtrTest));
+	if (gPtrTest > 8) {
+		gPtrTest = 8;
+	}
+	/* input step 4: the digitizer in the pointer's place (icetouch_dig=1): then no pointer device at all */
+	PE_parse_boot_argn("icetouch_dig", &gDig, sizeof(gDig));
+	gDig = gDig == 1;
+	if (gDig) {
+		gPtr = 0;
+		gPtrTest = 0;
+	}
+	PE_parse_boot_argn("icehid_touch_test", &gTouchTest, sizeof(gTouchTest));
+	if (gTouchTest > 8) {
+		gTouchTest = 8;
+	}
+	PE_parse_boot_argn("icehid_touch_wait", &gTouchWait, sizeof(gTouchWait));
+	gTouchWait = gTouchWait > 900 ? 900 : gTouchWait;
+	PE_parse_boot_argn("icehid_touch_delay", &gTouchDelay, sizeof(gTouchDelay));
+	gTouchDelay = gTouchDelay > 900 ? 900 : gTouchDelay;
+	PE_parse_boot_argn("icehid_touch_gap", &gTouchGap, sizeof(gTouchGap));
+	gTouchGap = gTouchGap < 5 ? 5 : gTouchGap > 600 ? 600 : gTouchGap;
+	/* w4-sensors: the motion sensor beside the keyboard (icehid_sns=1); laneD: also on with the sensor share's umbrella id */
+	if (!PE_parse_boot_argn("icehid_sns", &gSns, sizeof(gSns))) {
+		gSns = PE_iceland_laned('2') ? 1 : 0;
+	}
+	gSns = gSns == 1;
+	PE_parse_boot_argn("icehid_sns_test", &gSensorTest, sizeof(gSensorTest));
+	if (gSensorTest > 8) {
+		gSensorTest = 8;
+	}
+	PE_parse_boot_argn("icehid_sns_wait", &gSensorWait, sizeof(gSensorWait));
+	gSensorWait = gSensorWait > 900 ? 900 : gSensorWait;
+	gLock = IOLockAlloc();
+	gRing = static_cast<char(*)[kLineBytes]>(IOMallocZeroData(kRingLines * kLineBytes));
+	gTouchRing = static_cast<TouchFrame *>(IOMallocZeroData(kTouchRing * sizeof(TouchFrame)));
+	gSensorRing = static_cast<SensorFrame *>(IOMallocZeroData(kSensorRing * sizeof(SensorFrame)));
+	thread_t thread = nullptr;
+	if (!gLock || !gRing || !gTouchRing || !gSensorRing) {
+		gStage = -8;
+	} else if (kernel_thread_start(worker, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		gStage = -9;
+	}
+}
