+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+
+#include <stdarg.h>
+/*
+ * macOS: nothing of this file is built: it is the iPadOS harvest kit, and the prelinked collection
+ * has no room for it. What the ath12k driver needs there (the PCIe0 bring-up, the getters, the
+ * firmware) is bsd/dev/hakios_iceland_pcie.c. The iOS build is this file unchanged.
+ */
+#if !defined(XNU_TARGET_OS_OSX)
+/* 46cn4e: every line still goes to the console; the Wi-Fi ones (icepcie / icewifi) are also kept in the board layer's
+ * Wi-Fi log buffer (hakios_iceland_ath12k.c), dumped at the first SYS_ERR and at 285 s */
+extern void hakios_iceland_wifilog_add(const char *line);
+static void say_f(const char *fmt, ...) __printflike(1, 2);
+static void
+say_f(const char *fmt, ...)
+{
+	char b[768];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(b, sizeof(b), fmt, ap);
+	va_end(ap);
+	printf("%s", b);
+	if (strncmp(b, "icepcie", 7) == 0 || strncmp(b, "icewifi", 7) == 0) {
+		hakios_iceland_wifilog_add(b);
+	}
+}
+#define say(...) say_f(__VA_ARGS__)
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void IOSleep(unsigned int milliseconds);
+
+void hakios_iceland_harvest_init(void);
+void iceland_ath12k_link(void);   /* (B) route: fill the ath12k board layer's getters after the link-up */
+
+/* ---- icepathlog=NAME ------------------------------------------------------------------------------------------- */
+
+static char pathlog_name[MAXCOMLEN + 1];
+static uint32_t pathlog_said;
+
+int hakios_pathlog_want(void);
+int
+hakios_pathlog_want(void)
+{
+	char name[MAXCOMLEN + 1];
+
+	if (pathlog_name[0] == 0 || pathlog_said >= 400) {
+		return 0;
+	}
+	proc_selfname(name, sizeof(name));
+	return strncmp(name, pathlog_name, MAXCOMLEN) == 0;
+}
+
+void hakios_pathlog_open(user_addr_t path, int kernel_path, int flags, int error);
+void
+hakios_pathlog_open(user_addr_t path, int kernel_path, int flags, int error)
+{
+	char buf[256];
+	size_t len = 0;
+	int e;
+
+	if (kernel_path) {
+		e = copystr(CAST_DOWN(const void *, path), buf, sizeof(buf), &len);
+	} else {
+		e = copyinstr(path, buf, sizeof(buf), &len);
+	}
+	if (e != 0 && e != ENAMETOOLONG) {
+		strlcpy(buf, "?", sizeof(buf));
+	}
+	buf[sizeof(buf) - 1] = 0;
+	pathlog_said++;
+	say("icepath: %s[%d] open %s flags %#x -> errno %d\n", pathlog_name, proc_selfpid(), buf, flags, error);
+}
+
+/* ---- icedpu=1: the display controller, read only ------------------------------------------------------------ */
+
+#define DPU_MDSS_PA   0x09800000u
+#define DPU_MDSS_LEN  0x001c8800u
+#define DPU_MDP       0x1000u
+#define DPU_CTL(n)    (DPU_MDP + 0x1f000u + 0x1000u * (n))
+#define DPU_LM(n)     (DPU_MDP + 0x103000u + 0x8000u * (n))
+#define DPU_INTF(n)   (DPU_MDP + 0x18d000u + 0x1000u * (n))
+#define DPU_REC0      0x1000u
+#define DPU_REC1      0x3000u
+#define DPU_SMMU_PA   0x15000000u
+#define DPU_SID       0x800u
+
+static const struct {
+	const char *name;
+	uint32_t base;
+} dpu_sspp[] = {
+	{ "vig0", 0x2b000 }, { "vig1", 0x34000 }, { "vig2", 0x3d000 }, { "vig3", 0x46000 },
+	{ "dma0", 0x97000 }, { "dma1", 0xa0000 }, { "dma2", 0xa9000 }, { "dma3", 0xb2000 },
+	{ "dma4", 0xbb000 }, { "dma5", 0xc4000 },
+};
+
+static vm_offset_t dpu_va;
+
+static inline uint32_t
+dpu_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(dpu_va + off);
+}
+
+static inline uint32_t
+io_rd(vm_offset_t va, uint32_t off)
+{
+	return *(volatile uint32_t *)(va + off);
+}
+
+static void
+dpu_sample(const char *when, uint32_t pipes)
+{
+	say("icedpu: %s: intf1 frame %u line %u status %08x | intf2 frame %u line %u | ctl0 flush %08x ctl1 flush %08x\n", when,
+	    dpu_rd(DPU_INTF(1) + 0xac), dpu_rd(DPU_INTF(1) + 0xb0), dpu_rd(DPU_INTF(1) + 0x26c), dpu_rd(DPU_INTF(2) + 0xac),
+	    dpu_rd(DPU_INTF(2) + 0xb0), dpu_rd(DPU_CTL(0) + 0x18), dpu_rd(DPU_CTL(1) + 0x18));
+	for (unsigned p = 0; p < sizeof(dpu_sspp) / sizeof(dpu_sspp[0]); p++) {
+		if (pipes & (1u << p)) {
+			const uint32_t b = DPU_MDP + dpu_sspp[p].base;
+			say("icedpu: %s: %s current %08x / %08x\n", when, dpu_sspp[p].name, dpu_rd(b + DPU_REC0 + 0x64),
+			    dpu_rd(b + DPU_REC1 + 0x64));
+		}
+	}
+}
+
+/* the apps-SMMU's route for the display stream: stream match, bank, the bank's translation (registers only) */
+static void
+dpu_smmu(uint32_t fetch)
+{
+	vm_offset_t gr0 = ml_io_map_unmappable(DPU_SMMU_PA, PAGE_SIZE, VM_WIMG_IO);
+	bool any = false;
+
+	if (!gr0) {
+		say("icedpu: apps SMMU not mapped\n");
+		return;
+	}
+	const uint32_t id1 = io_rd(gr0, 0x24), nsmr = io_rd(gr0, 0x20) & 0xff;
+	const uint64_t page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	const uint64_t numpage = 1ull << (((id1 >> 28) & 7) + 1);
+	vm_offset_t gr1 = 0;
+
+	for (unsigned i = 0; i < nsmr; i++) {
+		const uint32_t smr = io_rd(gr0, 0x800 + 4 * i);
+		if (!(smr & 0x80000000u) || ((DPU_SID ^ smr) & ~(smr >> 16) & 0x7fff) != 0) {
+			continue;
+		}
+		any = true;
+		const uint32_t s2cr = io_rd(gr0, 0xc00 + 4 * i), type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		say("icedpu: SMMU SMR %u %08x (id %#x mask %#x) S2CR %08x (%s, bank %u)\n", i, smr, smr & 0x7fff, (smr >> 16) & 0x7fff,
+		    s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", cb);
+		if (type != 0) {
+			continue;
+		}
+		if (gr1 == 0) {
+			gr1 = ml_io_map_unmappable(DPU_SMMU_PA + page, PAGE_SIZE, VM_WIMG_IO);
+		}
+		vm_offset_t cbv = ml_io_map_unmappable(DPU_SMMU_PA + numpage * page + cb * page, PAGE_SIZE, VM_WIMG_IO);
+		if (!gr1 || !cbv) {
+			say("icedpu: SMMU bank %u not mapped\n", cb);
+			continue;
+		}
+		say("icedpu: SMMU bank %u: cbar %08x cba2r %08x sctlr %08x actlr %08x tcr %08x ttbr0 %08x%08x fsr %08x%s\n", cb,
+		    io_rd(gr1, 4 * cb), io_rd(gr1, 0x800 + 4 * cb), io_rd(cbv, 0x0), io_rd(cbv, 0x4), io_rd(cbv, 0x30),
+		    io_rd(cbv, 0x24), io_rd(cbv, 0x20), io_rd(cbv, 0x58),
+		    (io_rd(cbv, 0x0) & 1) ? " (translation ON)" : " (translation off: the pipes fetch physical addresses)");
+	}
+	if (!any) {
+		say("icedpu: no SMMU stream match for %#x (of %u entries)%s\n", DPU_SID, nsmr, fetch ? "" : "");
+	}
+}
+
+static void
+dpu_probe(const char *when)
+{
+	uint32_t pipes = 0, fetch = 0;
+
+	if (dpu_va == 0) {
+		dpu_va = ml_io_map_unmappable(DPU_MDSS_PA, DPU_MDSS_LEN, VM_WIMG_IO);
+		if (dpu_va == 0) {
+			say("icedpu: MDSS not mapped\n");
+			return;
+		}
+	}
+	say("icedpu: %s: MDSS hw %08x, DPU top %08x %08x %08x %08x\n", when, dpu_rd(0), dpu_rd(DPU_MDP), dpu_rd(DPU_MDP + 4),
+	    dpu_rd(DPU_MDP + 8), dpu_rd(DPU_MDP + 0xc));
+	for (unsigned n = 0; n < 6; n++) {
+		const uint32_t c = DPU_CTL(n);
+		const uint32_t intf = dpu_rd(c + 0xf4), fetchact = dpu_rd(c + 0xfc), pipe = dpu_rd(c + 0x12c);
+		if (intf == 0 && fetchact == 0 && pipe == 0) {
+			continue;
+		}
+		say("icedpu: ctl%u: top %08x flush %08x start %08x intf %08x master %08x fetch %08x pipe %08x layer %08x "
+		    "merge3d %08x dsc %08x\n", n, dpu_rd(c + 0x14), dpu_rd(c + 0x18), dpu_rd(c + 0x1c), intf, dpu_rd(c + 0x134),
+		    fetchact, pipe, dpu_rd(c + 0x130), dpu_rd(c + 0xe4), dpu_rd(c + 0xe8));
+	}
+	for (unsigned p = 0; p < sizeof(dpu_sspp) / sizeof(dpu_sspp[0]); p++) {
+		const uint32_t b = DPU_MDP + dpu_sspp[p].base;
+		for (unsigned r = 0; r < 2; r++) {
+			const uint32_t q = b + (r ? DPU_REC1 : DPU_REC0);
+			const uint32_t size = dpu_rd(q + 0x14), addr = dpu_rd(q + 0x4c), cur = dpu_rd(q + 0x64);
+			if (size == 0 && addr == 0 && cur == 0) {
+				continue;
+			}
+			pipes |= 1u << p;
+			if (!fetch && cur) {
+				fetch = cur;
+			}
+			say("icedpu: %s rec%u: format %08x unpack %08x op %08x src %08x xy %08x out %08x out-xy %08x addr %08x %08x "
+			    "stride %08x current %08x\n", dpu_sspp[p].name, r, dpu_rd(q + 0x0), dpu_rd(q + 0x4), dpu_rd(q + 0x8), size,
+			    dpu_rd(q + 0x18), dpu_rd(q + 0x1c), dpu_rd(q + 0x20), addr, dpu_rd(q + 0x50), dpu_rd(q + 0x5c), cur);
+		}
+	}
+	if (!pipes) {
+		say("icedpu: no source pipe has an address or size\n");
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		const uint32_t m = DPU_LM(n);
+		say("icedpu: lm%u: op %08x out %08x stage0 op %08x fg-sel %08x stage1 op %08x\n", n, dpu_rd(m + 0x0), dpu_rd(m + 0x4),
+		    dpu_rd(m + 0x40), dpu_rd(m + 0x44), dpu_rd(m + 0x70));
+	}
+	for (unsigned n = 1; n <= 2; n++) {
+		const uint32_t i = DPU_INTF(n);
+		say("icedpu: intf%u (dsi%u): engine %08x config %08x format %08x cmd-trigger %08x status %08x autorefresh %08x\n", n,
+		    n - 1, dpu_rd(i + 0x0), dpu_rd(i + 0x4), dpu_rd(i + 0x90), dpu_rd(i + 0x84), dpu_rd(i + 0x26c), dpu_rd(i + 0x2b4));
+	}
+	dpu_sample(when, pipes);
+	IOSleep(100);
+	dpu_sample("100 ms later", pipes);
+	dpu_smmu(fetch);
+}
+
+/*
+ * ---- icehw=1 (kit 23a, class B: reads only): what the boot chain left powered for the radios and the USB ----------
+ * GCC (0x00100000, always clocked; Linux reads it any time) branch / GDSC registers from gcc-kaanapali.c: bit 31 of a
+ * branch's CBCR = CLK_OFF, bit 0 = enable; bit 31 of a GDSCR = PWR_ON. TLMM pads Linux uses for the WCN7860
+ * (wlan-enable gpio16, PCIe0 reset gpio102 / wake gpio104; none in gpio-reserved-ranges <36 4>). The DWC3's own
+ * registers are read only when its GDSC is on and its master and NoC clocks run (U-Boot's fastboot left it as a
+ * device just before us); the PCIe controller and the BT UART's serial engine are NOT read (unclocked MMIO kills
+ * the kernel), only whether their clocks run.
+ */
+#define GCC_PA          0x00100000u
+#define TLMM_PA         0x0f100000u
+
+static void
+hw_probe(void)
+{
+	static const struct {
+		const char *name;
+		uint32_t off;
+	} regs[] = {
+		{ "pcie0 gdsc", 0x6b004 }, { "pcie0 phy gdsc", 0x6c000 }, { "pcie0 cfg_ahb", 0x6b040 }, { "pcie0 aux", 0x6b044 },
+		{ "pcie0 pipe", 0x6b064 }, { "usb30 gdsc", 0x39004 }, { "usb30 master", 0x39018 }, { "usb30 sleep", 0x39028 },
+		{ "usb3 noc axi", 0x39090 }, { "usb3 phy gdsc", 0x50018 }, { "qup3 s5 (BT uart)", 0xa8630 },
+	};
+	static const unsigned pins[] = { 16, 102, 104 };
+	vm_offset_t gcc = ml_io_map_unmappable(GCC_PA, 0xb0000, VM_WIMG_IO);
+	uint32_t v[sizeof(regs) / sizeof(regs[0])];
+
+	if (gcc == 0) {
+		say("icehw: GCC not mapped\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		v[i] = io_rd(gcc, regs[i].off);
+		say("icehw: gcc %-18s +%05x = %08x (%s)\n", regs[i].name, regs[i].off, v[i],
+		    (regs[i].off == 0x6b004 || regs[i].off == 0x6c000 || regs[i].off == 0x39004 || regs[i].off == 0x50018) ?((v[i] >> 31) ? "power on" : "power OFF") : ((v[i] >> 31) ? "clock OFF" : "clock on"));
+	}
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		vm_offset_t p = ml_io_map_unmappable(TLMM_PA + 0x1000u * pins[i], PAGE_SIZE, VM_WIMG_IO);
+		if (p != 0) {
+			uint32_t ctl = io_rd(p, 0), io = io_rd(p, 4);
+			say("icehw: tlmm gpio%u: ctl %08x (func %u, pull %u, drive %u, oe %u) io %08x (in %u, out %u)\n", pins[i], ctl,
+			    (ctl >> 2) & 0xf, ctl & 3, (ctl >> 6) & 7, (ctl >> 9) & 1, io, io & 1, (io >> 1) & 1);
+		}
+	}
+	/* the DWC3: GDSC on, master and NoC AXI clocks running */
+	if ((v[5] >> 31) && !(v[6] >> 31) && !(v[8] >> 31)) {
+		vm_offset_t d = ml_io_map_unmappable(0x0a600000u + 0xc000u, PAGE_SIZE, VM_WIMG_IO);
+		if (d != 0) {
+			say("icehw: dwc3: GSNPSID %08x GCTL %08x GSTS %08x GUSB2PHYCFG %08x GUSB3PIPECTL %08x DCFG %08x DCTL %08x DSTS %08x\n",
