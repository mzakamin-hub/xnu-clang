+static bool
+amp_init(unsigned d)
+{
+	unsigned a = amp_dev[d].addr;
+	int32_t product, v, version;
+	bool n_variant;
+	uint16_t key;
+	const struct amp_reg *list = NULL;
+	unsigned count = 0;
+
+	amp_w(a, 0x00, 0x0002);
+	product = amp_read(a, 0x03);
+	if (product != 0x9866) {
+		say("amp: %s: product %#x after the reset: not initialised\n", amp_dev[d].name, product);
+		return false;
+	}
+	amp_update(a, 0x00, 0x0001, 0);                         /* power down 0 */
+	amp_update(a, 0x04, 0x0040, 0);                         /* MANAOOSC 0 */
+	v = amp_poll_state(a, true);
+	say("amp: %s: up for the variant reads, STATUS2 %#x\n", amp_dev[d].name, v);
+	v = amp_read(a, 0xf3);
+	if (v >= 0 && (v & 0x1800)) {
+		product--;
+		v = amp_read(a, 0xf4);
+		if (v >= 0 && (v & 0x8000)) {
+			product--;
+		}
+	}
+	v = amp_read(a, 0xf0);
+	n_variant = v >= 0 && (v & 0x0200);
+	v = amp_read(a, 0x06);
+	version = v >= 0 ? v >> 8 : -1;
+	amp_w(a, 0x0f, 0x5a6b);
+	v = amp_read(a, 0xfb);
+	key = (uint16_t)((v >= 0 ? v : 0) ^ 0x005a);
+	amp_w(a, 0xa0, key);
+	amp_w(a, 0xa1, 0x005a);
+	if (product == 0x9864 && version == 0x30) {
+		list = amp_9864;
+		count = sizeof(amp_9864) / sizeof(amp_9864[0]);
+	} else if (product == 0x9865 && version == 0x30 && !n_variant) {
+		list = amp_9865_mn;
+		count = sizeof(amp_9865_mn) / sizeof(amp_9865_mn[0]);
+	}
+	say("amp: %s: TFA%x %s, version %#x: %s\n", amp_dev[d].name, product, n_variant ? "N" : "MN", version,
+	    list ? "the driver's settings for it" : "a variant the driver has no settings for: none applied");
+	for (unsigned i = 0; i < count; i++) {
+		amp_w(a, list[i].reg, list[i].val);
+	}
+	amp_update(a, 0x00, 0x0001, 0x0001);                   /* power down 1 */
+	v = amp_poll_state(a, false);
+	amp_update(a, 0x04, 0x0040, 0x0040);                   /* MANAOOSC 1 */
+	amp_w(a, 0x48, 0x0000);
+	amp_w(a, 0x44, 0xffff);
+	amp_w(a, 0x48, 0x071e);
+	for (unsigned i = 0; i < amp_cfg[d].count; i++) {
+		amp_w(a, amp_cfg[d].regs[i].reg, amp_cfg[d].regs[i].val);
+	}
+	amp_w(a, 0x20, 0x6f91);
+	amp_w(a, 0x21, amp_cfg[d].r21);
+	amp_w(a, 0x22, amp_cfg[d].r22);
+	amp_update(a, 0x58, 0x0002, 0x0002);                   /* H_MUTE 1 */
+	amp_gain_fields(d);
+	return true;
+}
+
+/* everything level B relies on, read back */
+static bool
+amp_check(unsigned d)
+{
+	unsigned a = amp_dev[d].addr;
+	int32_t c0 = amp_read(a, 0x00), c1 = amp_read(a, 0x01), fs = amp_read(a, 0x02), st = amp_read(a, 0x12),
+	    t0 = amp_read(a, 0x20), t1 = amp_read(a, 0x21), t2 = amp_read(a, 0x22), mute = amp_read(a, 0x58);
+	bool ok = c0 >= 0 && (c0 & 1) && !(c0 & 0x8) && mute >= 0 && (mute & 2) && t0 == 0x6f91 && t1 == amp_cfg[d].r21 &&
+	    t2 == amp_cfg[d].r22;
+
+	say("amp: %s read back: DEVICE_CONTROL %#x (power down %u, amplifier %u), SYS_CONTROL1 %#x (MANSCONF %u), FS %#x "
+	    "(rate code %u), STATUS2 %#x (state %u), TDM %#x %#x %#x, MISC %#x (mute %u): %s\n", amp_dev[d].name, c0, c0 & 1,
+	    (c0 >> 3) & 1, c1, (c1 >> 2) & 1, fs, fs & 0xf, st, st & 0xf, t0, t1, t2, mute, (mute >> 1) & 1,
+	    ok ? "POWERED DOWN, MUTED, TDM SET" : "NOT AS EXPECTED");
+	return ok;
+}
+
+static void
+amp_pins_report(const char *when)
+{
+	char line[400];
+	int n = 0;
+
+	line[0] = 0;
+	for (unsigned i = 0; i < 6; i++) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %s gpio%u %#x/%u;", amp_dev[i].name, amp_dev[i].reset,
+		    rd(AMP_CTL(amp_dev[i].reset)), rd(AMP_IO(amp_dev[i].reset)) & 3);
+	}
+	say("amp: %s: resets:%s\n", when, line);
+	say("amp: %s: i2c0 SDA gpio80 %#x/%u SCL gpio83 %#x/%u; i2c22 SDA gpio121 %#x/%u SCL gpio84 %#x/%u\n", when,
+	    rd(AMP_CTL(80)), rd(AMP_IO(80)) & 3, rd(AMP_CTL(83)), rd(AMP_IO(83)) & 3, rd(AMP_CTL(121)), rd(AMP_IO(121)) & 3,
+	    rd(AMP_CTL(84)), rd(AMP_IO(84)) & 3);
+}
+
+static void
+iceamp_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t level = (uint32_t)(uintptr_t)parameter, found = 0, ready = 0, kpbs = 100, verbose = 1;
+
+	PE_parse_boot_argn("iceamp_khz", &kpbs, sizeof(kpbs));
+	PE_parse_boot_argn("iceamp_log", &verbose, sizeof(verbose));
+	amp_log_writes = verbose != 0;
+	amp_set_khz(kpbs >= 10 && kpbs <= 400 ? kpbs : 100);
+	sleep_ms(4000);
+	amp_tlmm = ml_io_map(AMP_TLMM_PHYS, AMP_TLMM_SIZE);
+	if (amp_tlmm == 0) {
+		say("amp: TLMM not mapped\n");
+		amp_thread_busy = false;
+		return;
+	}
+	say("amp: level %u (%s), I2C by hand at about %u kHz\n", level, level >= 2 ? "init, left powered down and muted" :
+	    "read only", amp_khz);
+	amp_pins_report("as found");
+	for (unsigned b = 0; b < 2; b++) {
+		uint32_t found_sda = rd(AMP_CTL(amp_bus[b].sda)), found_scl = rd(AMP_CTL(amp_bus[b].scl));
+
+		amp_sda = amp_bus[b].sda;
+		amp_scl = amp_bus[b].scl;
+		amp_pin_gpio(amp_sda);
+		amp_pin_gpio(amp_scl);
+		amp_wait();
+		amp_wait();
+		say("amp: %s released: SDA %u SCL %u (both 1 = idle, pulled up)\n", amp_bus[b].bus, amp_level(amp_sda),
+		    amp_level(amp_scl));
+		if (amp_level(amp_sda) && amp_level(amp_scl)) {
+			for (unsigned d = 0; d < 6; d++) {
+				int32_t product, control, sys1, status2;
+
+				if (amp_dev[d].bus != b) {
+					continue;
+				}
+				product = amp_read(amp_dev[d].addr, 0x03);
+				control = amp_read(amp_dev[d].addr, 0x00);
+				sys1 = amp_read(amp_dev[d].addr, 0x01);
+				status2 = amp_read(amp_dev[d].addr, 0x12);
+				if (product < 0) {
+					say("amp: %s (%s %#x): NO ANSWER\n", amp_dev[d].name, amp_bus[b].bus, amp_dev[d].addr);
+					continue;
+				}
+				found++;
+				say("amp: %s (%s %#x): PRODUCT %#x%s, DEVICE_CONTROL %#x (power down %u, amplifier %u), "
+				    "SYS_CONTROL1 %#x (MANSCONF %u), STATUS2 %#x (manager state %u)\n", amp_dev[d].name,
+				    amp_bus[b].bus, amp_dev[d].addr, product, product == 0x9866 ? " (TFA9866 family, as tfa9865_init)" :
+				    "", control, control >= 0 ? control & 1 : 9, control >= 0 ? (control >> 3) & 1 : 9, sys1,
+				    sys1 >= 0 ? (sys1 >> 2) & 1 : 9, status2, status2 >= 0 ? status2 & 0xf : 99);
+				if (level >= 2 && amp_init(d) && amp_check(d)) {
+					ready++;
+				}
+			}
+		} else {
+			say("amp: %s is not idle: nothing sent on it\n", amp_bus[b].bus);
+		}
+		wr(AMP_CTL(amp_bus[b].sda), found_sda);
+		wr(AMP_CTL(amp_bus[b].scl), found_scl);
+		settle();
+	}
+	amp_pins_report("given back");
+	say("amp: level %u done: %u of 6 amplifiers answer%s", level, found, level >= 2 ? "" : "\n");
+	if (level >= 2) {
+		say(", %u of 6 INITIALISED, POWERED DOWN AND MUTED; %u register writes, %u not acknowledged\n", ready,
+		    amp_writes, amp_write_fails);
+	}
+	amp_thread_busy = false;
+}
+
+/*
+ * ---- Audio level D (boot-arg icetone=1, OFF by default): a 440 Hz tone for 1 s at -40 dBFS ------------------------
+ * Only together with iceaudio=1 and icesmmu=1 in the same run (C2's SMMU write is the owner's gate): refused otherwise,
+ * and refused if the amplifiers do not all initialise, C2's setup refuses, or the DSP does not map C2's buffer.
+ * The stream graph = the topology's MultiMedia1 (OnePlus-Pad4.m4 STREAM_SG_PCM_ADD with
+ * subgraph-stream-vol-playback-capped.m4; m4-expanded: stream0):
+ *   sub-graph 0x4001 (perf low latency 2, direction RX 2, scenario playback 1), container 0x4001 (GC 0x0B001001,
+ *   position stream, stack 8192, ADSP); WR_SHARED_MEM_EP 0x07001000 iid 0x6001 (0 in / 1 out) -> PCM_DEC 0x07001005
+ *   24578 -> PCM_CNV 0x07001003 24579 -> VOL_CTRL 0x0700101B 24580 -> MFC 0x07001015 24581 -> DATA_LOGGING 0x0700101A
+ *   24582 (code 0x19af, tap 1, mode 0), each output port 1 -> the next one's input port 2; the FE-BE route
+ *   (topology.c audioreach_connect_sub_graphs): LOG 24582:1 -> the back end's MFC 0x6062:2.
+ * The roles as Linux's q6apm-dai.c prepare / q6apm.c / audioreach.c: GRAPH_OPEN (audioreach_alloc_graph_pkt); media
+ * formats in the container's order (q6apm_graph_media_format_pcm: PCM_DEC / PCM_CNV PARAM_ID_PCM_OUTPUT_FORMAT_CFG
+ * 16 bit, interleaved 1 / deinterleaved unpacked 3, 2 ch FL FR; VOL_CTRL nothing; MFC PARAM_ID_MFC_OUTPUT_MEDIA_FORMAT
+ * 48 kHz / 16 bit / 2 ch; LOG module enable + PARAM_ID_DATA_LOGGING_CONFIG); the shared-memory endpoint's
+ * PARAM_ID_MEDIA_FORMAT (q6apm_graph_media_format_shmem: APM_CMD_SET_CFG from the graph's GPR port to module 0x6001);
+ * the volume as the topology's kcontrol does it (audioreach_gain_set_vol_ctrl: PARAM_ID_VOL_CTRL_MASTER_GAIN, Q13,
+ * 8192 = 0 dB = VOL_CTRL_MAX, the topology's cap); GRAPH_PREPARE, GRAPH_START; the data as q6apm_write_async
+ * (DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER_V2 from the graph's port to 0x6001: IOVA, C2's map handle, size, flags
+ * NO_TIMESTAMP 0xff00, token = buffer | size << 16), in 4 KB pieces of C2's 64 KB buffer (16 slots, at most 12
+ * queued), a slot re-filled only after its "done" (DATA_CMD_RSP_WR_SH_MEM_EP_DATA_BUFFER_DONE_V2).
+ * The tone: 440 Hz at 48 kHz (11 cycles every 1200 samples, from a quarter-wave table), 48000 frames x 2 ch x 16 bit =
+ * 192000 bytes (47 pieces), amplitude icetone_amp (327, the most allowed) of 32767 = -40.02 dBFS; HARD GUARD: above 327
+ * (-40 dBFS = 327.67) the level refuses, and every piece's peak is checked before it is sent; 10 ms fades in and out.
+ * The amplifiers, all six, in tfa9865.c's DAPM order: first initialised and left powered down + muted (level B,
+ * amp_init); with the back end running silence and the stream graph started: power down 0 (POWER), MANSCONF 1 (its
+ * POST_PMU), amplifier 1 (AMP), H_MUTE 0 (mute_stream); after the tone (+ 60 ms for the DSP's pipeline): H_MUTE 1,
+ * amplifier 0, MANSCONF 0 (PRE_PMD), power down 1 -- then the stream graph stopped and closed, the back end stopped
+ * and closed, the clock released, the pins given back (C1), the buffer unmapped and the SMMU put back (C2). The
+ * amplifiers' own gain: the board's values from tfa9865.c's lists (not a field the driver knows), unchanged.
+ * icetone=2: Linux's order instead (the stream graph opened before the back end, the FE-BE connection in the back
+ * end's GRAPH_OPEN, as topology.c does) -- the fallback if the DSP refuses the connection in the stream's GRAPH_OPEN.
+ */
+#define TONE_SG                 0x4001u
+#define TONE_CONT               0x4001u
+#define TONE_IID_WRSH           0x6001u
+#define TONE_IID_DEC            24578u
+#define TONE_IID_CNV            24579u
+#define TONE_IID_VOL            24580u
+#define TONE_IID_MFC            24581u
+#define TONE_PORT               0x10000001u     /* our graph's GPR port (apr.c gpr_alloc_port: GPR_DYNAMIC_PORT_START) */
+#define TONE_RATE               48000u
+#define TONE_FRAMES             48000u          /* 1 s */
+#define TONE_BYTES              (TONE_FRAMES * 4u)
+#define TONE_PIECE              4096u
+#define TONE_SLOTS              (C2_BUF_SIZE / TONE_PIECE)
+#define TONE_AHEAD              12u
+#define TONE_FADE               480u            /* 10 ms */
+#define TONE_AMP_MAX            327             /* 20 log10(327 / 32767) = -40.02 dBFS; 328 would be -39.99 */
+#define TONE_VOL                8192u           /* Q13: 0 dB */
+#define TONE_VOL_MAX            8192u           /* the topology's VOL_CTRL_MAX */
+#define DATA_CMD_WR_SH_V2       0x0400100Au
+#define TONE_NO_TIMESTAMP       0xff00u         /* q6apm.h NO_TIMESTAMP, as q6apm-dai.c passes it */
+
+/* round(32767 sin(pi/2 k/300)), k = 0..300 */
+static const int16_t tone_q[301] = {
+	0, 172, 343, 515, 686, 858, 1029, 1201, 1372, 1544, 1715, 1886, 2057, 2229, 2400,
+	2571, 2742, 2913, 3084, 3254, 3425, 3596, 3766, 3937, 4107, 4277, 4447, 4617, 4787, 4956,
+	5126, 5295, 5465, 5634, 5803, 5971, 6140, 6308, 6477, 6645, 6813, 6980, 7148, 7315, 7482,
+	7649, 7816, 7983, 8149, 8315, 8481, 8646, 8812, 8977, 9142, 9306, 9471, 9635, 9799, 9962,
+	10126, 10289, 10451, 10614, 10776, 10938, 11099, 11261, 11422, 11582, 11743, 11903, 12062, 12222, 12381,
+	12539, 12698, 12856, 13013, 13171, 13328, 13484, 13640, 13796, 13952, 14107, 14261, 14415, 14569, 14723,
+	14876, 15029, 15181, 15333, 15484, 15635, 15786, 15936, 16085, 16235, 16384, 16532, 16680, 16827, 16974,
+	17121, 17267, 17412, 17557, 17702, 17846, 17990, 18133, 18276, 18418, 18559, 18701, 18841, 18981, 19121,
+	19260, 19398, 19537, 19674, 19811, 19947, 20083, 20218, 20353, 20487, 20621, 20754, 20886, 21018, 21150,
+	21280, 21411, 21540, 21669, 21798, 21925, 22053, 22179, 22305, 22431, 22555, 22679, 22803, 22926, 23048,
+	23170, 23291, 23411, 23531, 23650, 23768, 23886, 24003, 24120, 24235, 24351, 24465, 24579, 24692, 24804,
+	24916, 25027, 25138, 25247, 25356, 25465, 25572, 25679, 25785, 25891, 25996, 26100, 26203, 26306, 26408,
+	26509, 26610, 26709, 26808, 26907, 27004, 27101, 27197, 27292, 27387, 27481, 27574, 27666, 27758, 27848,
+	27938, 28028, 28116, 28204, 28291, 28377, 28462, 28547, 28631, 28714, 28796, 28878, 28958, 29038, 29117,
+	29196, 29273, 29350, 29426, 29501, 29575, 29648, 29721, 29793, 29864, 29934, 30004, 30072, 30140, 30207,
+	30273, 30338, 30402, 30466, 30529, 30591, 30652, 30712, 30771, 30830, 30888, 30944, 31000, 31056, 31110,
+	31163, 31216, 31268, 31318, 31368, 31418, 31466, 31513, 31560, 31606, 31650, 31694, 31738, 31780, 31821,
+	31862, 31901, 31940, 31978, 32015, 32051, 32086, 32121, 32154, 32187, 32218, 32249, 32279, 32308, 32336,
+	32364, 32390, 32415, 32440, 32464, 32487, 32509, 32530, 32550, 32569, 32587, 32605, 32622, 32637, 32652,
+	32666, 32679, 32691, 32702, 32713, 32722, 32731, 32738, 32745, 32751, 32756, 32760, 32763, 32765, 32767,
+	32767,
+};
+
+static int32_t tone_amp = TONE_AMP_MAX;
+static uint32_t tone_handle;
+/*
+ * icetone_stage (ipad17j, kernel 11d43369, hung the whole SoC -- the loader's core 0 too -- with no log; 17g, the same
+ * path where 0x34 never came up and no sample was sent, did not): the tone in three stages, so runs can bisect it.
+ *   1  the amplifiers only: level B (prepare), then up (power down 0, MANSCONF 1, amplifier 1, H_MUTE 0) for 200 ms
+ *      and down again -- no SMMU write, no stream graph, no back end, no TDM clock (the amplifiers' manager just
+ *      waits for a clock);
+ *   2  + C2 set up and the buffer mapped at the DSP, the back end (C1) and the stream graph started with NO sample
+ *      sent (the DSP plays zeros from its own side), the amplifiers up for 1 s with the TDM running, then down, the
+ *      graph closed, C2 put back -- what 17g did for four amplifiers;
+ *   3  + the samples (the full tone, the default: 17j's path).
+ * In stage 3 bank 7's FSR is read before every piece: at the first fault no further piece is sent.
+ */
+static uint32_t tone_stage = 3;
+static uint32_t c2_fsr_found;           /* bank 7's FSR right after the DSP mapped the buffer (17f/g/i: a steady 0x400) */
+static bool tone_fe_opened, tone_fe_started;
+
+/* sample n of the tone (both channels the same) */
+static int32_t
+tone_sample(uint32_t n)
+{
+	uint32_t k = (n * 11u) % 1200u;         /* 440 / 48000 = 11 / 1200 of a cycle per sample */
+	int32_t q, v;
+
+	q = k <= 300 ? tone_q[k] : k <= 600 ? tone_q[600 - k] : k <= 900 ? -tone_q[k - 600] : -tone_q[1200 - k];
+	v = (int32_t)(((int64_t)q * tone_amp + (q >= 0 ? 16383 : -16383)) / 32767);
+	if (n < TONE_FADE) {
+		v = v * (int32_t)n / (int32_t)TONE_FADE;
+	} else if (n >= TONE_FRAMES - TONE_FADE) {
+		v = v * (int32_t)(TONE_FRAMES - 1 - n) / (int32_t)TONE_FADE;
+	}
+	return v;
+}
+
+/* the stream graph's GRAPH_OPEN (64 + 80 + 80 + 168 + 104 / 120 = 496 / 512 bytes) */
+static bool
+tone_fe_open(struct gchan *apps, bool fe_conn)
+{
+	static const uint32_t mods[6][4] = {    /* module id, instance id, input ports, output ports */
+		{ 0x07001000u, TONE_IID_WRSH, 0, 1 }, { 0x07001005u, TONE_IID_DEC, 1, 1 }, { 0x07001003u, TONE_IID_CNV, 1, 1 },
+		{ 0x0700101Bu, TONE_IID_VOL, 1, 1 }, { AU_MOD_MFC, TONE_IID_MFC, 1, 1 }, { AU_MOD_LOG, TONE_IID_LOG, 1, 1 },
+	};
+	uint8_t b[560], *o = b;
+	uint32_t nconn = fe_conn ? 6 : 5, mc = (20 + nconn * 16 + 7) & ~7u;
+
+	bzero(b, sizeof(b));
+	au_param(&o, APM_IID, 0x08001001, 64 - 16);                    /* sub-graph */
+	au_put(&o, 1);
+	au_put(&o, TONE_SG); au_put(&o, 3);
+	au_put(&o, 0x0800100E); au_put(&o, 4); au_put(&o, AU_PERF_LOW_LATENCY);
+	au_put(&o, 0x0800100F); au_put(&o, 4); au_put(&o, 2);          /* direction RX */
+	au_put(&o, 0x08001010); au_put(&o, 4); au_put(&o, 1);          /* scenario: playback */
+	au_param(&o, APM_IID, 0x08001000, 80 - 16);                    /* container */
+	au_put(&o, 1);
+	au_put(&o, TONE_CONT); au_put(&o, 4);
+	au_put(&o, 0x08001011); au_put(&o, 8); au_put(&o, 1); au_put(&o, AU_CONT_TYPE_GC);
+	au_put(&o, 0x08001012); au_put(&o, 4); au_put(&o, 1);                          /* graph position: stream */
+	au_put(&o, 0x08001013); au_put(&o, 4); au_put(&o, 8192);                       /* stack size */
+	au_put(&o, 0x08001014); au_put(&o, 4); au_put(&o, 2);                          /* processor domain: ADSP */
+	au_param(&o, APM_IID, 0x08001002, 80 - 16);                    /* module list: 20 + 12 + 6 x 8 */
+	au_put(&o, 1);
+	au_put(&o, TONE_SG); au_put(&o, TONE_CONT); au_put(&o, 6);
+	for (unsigned i = 0; i < 6; i++) {
+		au_put(&o, mods[i][0]); au_put(&o, mods[i][1]);
+	}
+	au_param(&o, APM_IID, 0x08001003, 168 - 16);                   /* module properties: 20 + 6 x 24, aligned */
+	au_put(&o, 6);
+	for (unsigned i = 0; i < 6; i++) {
+		au_put(&o, mods[i][1]); au_put(&o, 1); au_put(&o, 0x08001015); au_put(&o, 8); au_put(&o, mods[i][2]);
+		au_put(&o, mods[i][3]);
+	}
+	au_put(&o, 0);
+	au_param(&o, APM_IID, 0x08001004, mc - 16);                    /* connections */
+	au_put(&o, nconn);
+	for (unsigned i = 0; i < 5; i++) {
+		au_put(&o, mods[i][1]); au_put(&o, 1); au_put(&o, mods[i + 1][1]); au_put(&o, 2);
+	}
+	if (fe_conn) {
+		au_put(&o, TONE_IID_LOG); au_put(&o, 1); au_put(&o, AU_IID_MFC); au_put(&o, 2);
+	}
+	o = b + 64 + 80 + 80 + 168 + mc;
+	tone_fe_opened = gpr_call(apps, APM_IID, APM_CMD_GRAPH_OPEN_, b, (uint32_t)(o - b), 0xffffffffu, fe_conn ?
+	    "APM: stream GRAPH_OPEN sub-graph 0x4001 (6 modules) + the FE-BE connection LOG 24582:1 -> MFC 0x6062:2" :
+	    "APM: stream GRAPH_OPEN sub-graph 0x4001 (6 modules)") == 0;
+	return tone_fe_opened;
+}
+
+static void
+tone_fe_close(struct gchan *apps)
+{
+	uint8_t b[32];
+	uint32_t n;
+
+	if (!tone_fe_opened) {
+		return;
+	}
+	if (tone_fe_started) {
+		n = au_mgmt(b, TONE_SG);
+		(void)gpr_call(apps, APM_IID, APM_CMD_GRAPH_STOP_, b, n, 0xffffffffu, "APM: stream GRAPH_STOP sub-graph 0x4001");
+		tone_fe_started = false;
+	}
+	n = au_mgmt(b, TONE_SG);
+	(void)gpr_call(apps, APM_IID, APM_CMD_GRAPH_CLOSE_, b, n, 0xffffffffu, "APM: stream GRAPH_CLOSE sub-graph 0x4001");
+	tone_fe_opened = false;
+}
+
+/* media formats (q6apm_graph_media_format_pcm, then _shmem), the volume, PREPARE, START */
+static bool
+tone_fe_start(struct gchan *apps)
+{
+	uint8_t b[64], *o;
+	bool ok = true;
+	uint32_t n;
+
+	for (unsigned k = 0; k < 2 && ok; k++) {        /* PCM decoder (interleaved), PCM converter (deinterleaved unpacked) */
+		bzero(b, sizeof(b));
+		o = b;
+		au_param(&o, k ? TONE_IID_CNV : TONE_IID_DEC, 0x08001008, 48 - 16);
+		au_put(&o, 1); au_put(&o, 0x09001000); au_put(&o, 20);  /* fixed point, PCM, payload_pcm_output_format_cfg + 2 */
+		au_put16(&o, 16); au_put16(&o, 1); au_put16(&o, 16); au_put16(&o, 15);   /* width, LSB aligned, bits, Q15 */
+		au_put16(&o, 1); au_put16(&o, k ? 3 : 1); au_put16(&o, 0); au_put16(&o, 2); /* LE, interleave, -, 2 ch */
+		*o++ = 1;
+		*o++ = 2;                                                /* FL FR */
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, 48, 0xffffffffu, k ?
+		    "APM: stream PCM converter 24579: 16 bit, 2 ch FL FR, deinterleaved unpacked" :
+		    "APM: stream PCM decoder 24578: 16 bit, 2 ch FL FR, interleaved") == 0;
+	}
+	if (ok) {
+		o = b;
+		au_param(&o, TONE_IID_MFC, 0x08001024, 12);
+		au_put(&o, TONE_RATE); au_put16(&o, 16); au_put16(&o, 2); au_put16(&o, 1); au_put16(&o, 2);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, 28, 0xffffffffu,
+		    "APM: stream MFC 24581 output 48 kHz / 16 bit / 2 ch FL FR") == 0;
+	}
+	if (ok) {
+		o = b;
+		au_param(&o, TONE_IID_LOG, 0x08001026, 4);
+		au_put(&o, 1);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, 20, 0xffffffffu, "APM: stream LOG 24582 enabled") == 0;
+	}
+	if (ok) {
+		o = b;
+		au_param(&o, TONE_IID_LOG, 0x08001031, 12);
+		au_put(&o, 0x19af); au_put(&o, 1); au_put(&o, 0);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, 28, 0xffffffffu, "APM: stream LOG code 0x19af tap 1") == 0;
+	}
+	if (ok) {               /* the shared-memory endpoint, from the graph's port to the module (audioreach_shmem_...) */
+		bzero(b, sizeof(b));
+		o = b;
+		au_param(&o, TONE_IID_WRSH, 0x0800100C, 48 - 16);
+		au_put(&o, 1); au_put(&o, 0x09001000); au_put(&o, 48 - 12);   /* (Linux: payload_size - sizeof(header)) */
+		au_put(&o, TONE_RATE);
+		au_put16(&o, 16); au_put16(&o, 1); au_put16(&o, 16); au_put16(&o, 15); au_put16(&o, 1); au_put16(&o, 2);
+		*o++ = 1;
+		*o++ = 2;
+		ok = gpr_call2(apps, TONE_PORT, TONE_IID_WRSH, APM_CMD_SET_CFG_, b, 48, 0xffffffffu,
+		    "APM: stream WR_SHARED_MEM_EP 0x6001 media format 48 kHz / 16 bit / 2 ch FL FR") == 0;
+	}
+	if (ok) {               /* the volume: audioreach_gain_set_vol_ctrl, never above the topology's cap */
+		o = b;
+		au_param(&o, TONE_IID_VOL, 0x08001035, 4);
+		au_put16(&o, (uint16_t)LESSER(TONE_VOL, TONE_VOL_MAX)); au_put16(&o, 0);
+		ok = gpr_call(apps, APM_IID, APM_CMD_SET_CFG_, b, 20, 0xffffffffu,
+		    "APM: stream volume 24580 master gain 8192 (Q13 = 0 dB, the topology's cap)") == 0;
+	}
+	if (ok) {
+		n = au_mgmt(b, TONE_SG);
+		ok = gpr_call(apps, APM_IID, APM_CMD_GRAPH_PREPARE_, b, n, 0xffffffffu, "APM: stream GRAPH_PREPARE") == 0;
+	}
+	if (ok) {
+		n = au_mgmt(b, TONE_SG);
+		ok = gpr_call(apps, APM_IID, APM_CMD_GRAPH_START_, b, n, 0xffffffffu, "APM: stream GRAPH_START") == 0;
+		tone_fe_started = ok;
+	}
+	return ok;
+}
+
+/* one 4 KB piece to the WR_SHARED_MEM_EP (q6apm_write_async: header + apm_data_cmd_wr_sh_mem_ep_data_buffer_v2) */
+static bool
+tone_send(struct gchan *apps, uint32_t slot, uint32_t len)
+{
+	uint32_t w[17];
+	uint64_t iova = C2_DSP_ADDR + (uint64_t)slot * TONE_PIECE;   /* tagged as q6apm_write_async's ab->phys */
+
+	bzero(w, sizeof(w));
+	w[0] = 0 | 6u << 4 | (uint32_t)sizeof(w) << 8;
+	w[1] = GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8;
+	w[2] = TONE_PORT;
+	w[3] = TONE_IID_WRSH;
+	w[4] = slot | len << 16;                /* token: buffer index | size << APM_WRITE_TOKEN_LEN_SHIFT */
+	w[5] = DATA_CMD_WR_SH_V2;
+	w[6] = (uint32_t)iova;
+	w[7] = (uint32_t)(iova >> 32);
+	w[8] = tone_handle;
+	w[9] = len;
+	w[12] = TONE_NO_TIMESTAMP;              /* (timestamps 0, no metadata buffer) */
+	return g_tx_data(apps, w, sizeof(w));
+}
+
+/* one amplifier bus taken (pins to GPIO, lines idle) / given back as found */
+static uint32_t amp_bus_found[2];
+
+static bool
+amp_bus_take(unsigned b)
+{
+	amp_sda = amp_bus[b].sda;
+	amp_scl = amp_bus[b].scl;
+	amp_bus_found[0] = rd(AMP_CTL(amp_sda));
+	amp_bus_found[1] = rd(AMP_CTL(amp_scl));
+	amp_pin_gpio(amp_sda);
+	amp_pin_gpio(amp_scl);
+	amp_wait();
+	amp_wait();
+	if (amp_level(amp_sda) && amp_level(amp_scl)) {
+		amp_bus_clear();        /* whatever the mux switch looked like to the slaves: 9 clocks + STOP first */
+		return true;
+	}
+	say("tone: %s is not idle (SDA %u SCL %u): nothing sent on it\n", amp_bus[b].bus, amp_level(amp_sda),
+	    amp_level(amp_scl));
+	wr(AMP_CTL(amp_sda), amp_bus_found[0]);
+	wr(AMP_CTL(amp_scl), amp_bus_found[1]);
+	settle();
+	return false;
+}
+
+static void
+amp_bus_give(void)
+{
+	wr(AMP_CTL(amp_sda), amp_bus_found[0]);
+	wr(AMP_CTL(amp_scl), amp_bus_found[1]);
+	settle();
+}
+
+/* level B for all six (amp_init + amp_check): powered down, muted, TDM set */
+static bool
+tone_amps_prepare(void)
+{
+	unsigned ready = 0, fails0 = amp_write_fails;
+
+	for (int i = 0; amp_thread_busy && i < 150; i++) {
+		sleep_ms(100);
+	}
+	if (amp_thread_busy) {
+		say("tone: iceamp's thread still has the amplifier buses after 15 s\n");
+		return false;
+	}
+	if (amp_tlmm == 0) {
+		amp_tlmm = ml_io_map(AMP_TLMM_PHYS, AMP_TLMM_SIZE);
+	}
+	if (amp_tlmm == 0) {
+		say("tone: TLMM not mapped\n");
+		return false;
+	}
+	amp_log_writes = false;                 /* (level B's 298 writes; failures still logged) */
+	for (unsigned b = 0; b < 2; b++) {
+		if (!amp_bus_take(b)) {
+			continue;
+		}
+		for (unsigned d = 0; d < 6; d++) {
+			if (amp_dev[d].bus == b && amp_init(d) && amp_check(d)) {
+				ready++;
+			}
+		}
+		amp_bus_give();
+	}
+	say("tone: amplifiers: %u of 6 initialised (level B), POWERED DOWN AND MUTED; %u writes not acknowledged\n", ready,
+	    amp_write_fails - fails0);
+	return ready == 6 && amp_write_fails == fails0;
+}
+
+/*
+ * Kit 17w: the cap's most raised (owner's go, 1 Nov) from 3277 (-20.0 dBFS) to 29204 (-1.0 dBFS): Linux's ceiling for
+ * these speakers (0.27r6: DSP stream volume 0 dB = 8192 = stock's PAL ceiling, amplifiers at the board's values from
+ * tfa9865.c / stock's tfa98xx.cnt, unchanged; 0.28-3: PipeWire limiter at -1 dBFS). Stock's own ceiling is the same
+ * 0 dB stream (its TFADSP limiter can only lower it). Nothing else changes: same amplifier writes as level D (17o2).
+ *
+ * iceamp_stat=1 (default 0): the amplifiers' protection / status flags read (READ ONLY: no register written, the
+ * latched interrupts are not cleared) after up, 2 s into the sound, before down and after down. The TFA9865 is read
+ * as a TFA2-family part (its INT_CLEAR 0x44 / INT_ENABLE 0x48 = 0x071e in tfa9865.c match the TFA2 map; the layout
+ * is otherwise UNVERIFIED for this part, so the raw values are logged): 0x10 STATUS_FLAGS0 (bit 0 VDDS, 1 PLLS,
+ * 2 OTDS over-temperature, 3 OVDS over-voltage, 4 UVDS under-voltage, 5 CLKS, 8 SPKS speaker error, 9 ACS, 10 SWS,
+ * 11 WDS, 12 AMPS, 15 BODNOK), 0x11 STATUS_FLAGS1 and 0x13 STATUS_FLAGS3 (clip / DC-DC flags in TFA2 maps; raw),
+ * 0x1b / 0x1c (battery / temperature readings in TFA2 maps; raw), 0x40-0x42 the latched interrupt status (bits as
+ * 0x10, so 0x40 holds any OTDS / OVDS / UVDS / SPKS seen while up).
+ *
+ * w4-audio, after tablet run w4-audio-r5a-login-1 (16 Nov; 7 sounds, all six amplifiers, 4 reads each): the TFA2 names do
+ * NOT hold for 0x10 on this part. It read 0x7eaf every time, powered down and muted as well as up and playing -- with
+ * the TFA2 map its PLL-lock, clocks and amplifier-switching bits would have to change between the two. So the line no
+ * longer prints "OTDS / OVDS / UVDS / SPKS" from it (the old line's "UVDS 0" was no low supply, and its "OTDS 1" no
+ * alarm: in NXP's lists those three are ok flags anyway). What does follow the state is 0x11: 0x18 powered down, 0x899
+ * up (once 0xe89, 2 s into macOS's own sound); 0x13, 0x1b, 0x1c and 0x40-0x42 read 0 throughout. The line prints the
+ * raw values and says whether 0x10 / 0x11 / 0x40 are what that run had; "NOT AS RUN r5a" is something to read, not a
+ * verdict. The real protection flags of this part are not known.
+ */
+/*
+ * round 5b: on by default (1): with no protection flags known, every run's status lines are compared with run r5a's.
+ * The look "2 s into the sound" holds this thread for six amplifiers' reads while a stream plays, so it needs
+ * iceamp_stat=2; iceamp_stat=0 turns the reads off.
+ *
+ * w4-audio round 5c (16 Nov): the vendor's field lists, and the guard that uses them. 0x10 is LATCHED (write 1 to
+ * clear): bits 1 OTDS, 2 UVDS, 3 OVDS and 9-14 the output stages' over-current ok flags (1 = good), bit 4 OCDS
+ * over-current and bit 15 DCTH DC on the speaker (1 = bad), bits 0 VDDS, 5 NOCLK, 6 CLKOOR and 7 DCOCPOK (0 = the
+ * booster's current limit) notes only. The latch is why earlier runs read 0x7eaf every time: healthy, with the power-on
+ * and no-clock latches never cleared. 0x11 bit 12 CLIPS and bit 2 TDMERR (live), 0x12 bits 0-3 MANSTATE (9 read while
+ * playing), 0x13 bit 0 BODNOK / bit 1 QPFAIL (latched), 0x40 the latched interrupts, cleared by writing 0x44 (1 boost
+ * over-current, 2 over-temperature, 3 amplifier over-current, 4 under-voltage, 7 DC, 8 brown-out, 10 over-voltage). The
+ * guard clears those latches when the amplifiers come up and polls the six every 250 ms while they are up. An alarm: an
+ * ok flag 0, an over-current, DC, brown-out or charge pump, a latched interrupt, a manager state other than the one it
+ * came up in, or two failed reads in a row. The poll is 30 register reads (some tens of ms) four times a second on the
+ * sender's thread, which holds up to 12 pieces (0.25 s) ahead at the DSP.
+ */
+static uint32_t amp_stat = 1;
+/*
+ * round 5c: the amplifiers' guard (iceamp_guard), and what it keeps per amplifier: the manager state each one had right
+ * after it came up (0xff = not known), the failed reads in a row, and the notes already logged since the last power-up
+ * (bits 0-5, see amp_guard_poll).
+ */
+static uint32_t amp_guard = 2;          /* boot-arg iceamp_guard: 0 off, 1 report only, 2 stop on an alarm (default) */
+static uint8_t amp_guard_manstate[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+static uint8_t amp_guard_bad_reads[6];
+static uint16_t amp_guard_noted[6];
+/*
+ * round 6, information only (no alarm reads these): the amplifier's mode in 0x11 / 0x12 by the vendor's field list
+ * (tfa9866n3: 0x11 bit 3 LPMS low power, 4 LNMS low noise, 5 FWRMS follower, 6 BSTMS boost, 9 SWS amplifier engaged,
+ * 10 AMPS enabled, 14 VGBS Vddp above Vbat; 0x12 bits 7:4 AMPSTE, 12:11 QPCLKSTS). Run w4-audio-r5c-stock-1: 0x899 /
+ * 0x4709 = clocks up, low power + low noise, NOT engaged (no signal in the slot); 0xe89 / 0x929 engaged in low power
+ * mode (quiet tones, Glass); 0xea1 / 0x9a9 follower mode; 0x4ec1 / 0x19a9 boost mode with Vddp above Vbat (the tone at
+ * the cap 13045). A line when an amplifier's mode changes (at most 5 per power-up), and per power-up how many polls
+ * found it engaged and in boost mode: an amplifier that never engages while sound goes out has no signal.
+ */
+#define AMP_MODE_BITS           0x4678u         /* VGBS, SWS, AMPS(0x400), BSTMS, FWRMS, LNMS, LPMS */
+static uint16_t amp_mode_last[6], amp_mode_polls[6], amp_mode_engaged[6], amp_mode_boost[6];
+static uint8_t amp_mode_notes[6];
+
+static void
+amp_mode_note(unsigned d, int32_t s1, int32_t s2)
+{
+	uint16_t mode = (uint16_t)(s1 & AMP_MODE_BITS);
+
+	amp_mode_polls[d]++;
+	amp_mode_engaged[d] += (s1 & 0x0200) != 0;
+	amp_mode_boost[d] += (s1 & 0x0040) != 0;
+	if (mode == amp_mode_last[d] || amp_mode_notes[d] >= 5) {
+		return;
+	}
+	amp_mode_last[d] = mode;
+	amp_mode_notes[d]++;
+	say("amp: mode: %s: 0x11 %#x 0x12 %#x: engaged %u, low power %u, low noise %u, follower %u, boost %u, Vddp above "
+	    "Vbat %u, AMPSTE %#x, QPCLKSTS %u (information)\n", amp_dev[d].name, s1, s2, (s1 >> 9) & 1, (s1 >> 3) & 1,
+	    (s1 >> 4) & 1, (s1 >> 5) & 1, (s1 >> 6) & 1, (s1 >> 14) & 1, (s2 >> 4) & 0xf, (s2 >> 11) & 3);
+}
+
+static void
+amp_status(unsigned d, const char *when)
+{
+	unsigned a = amp_dev[d].addr;
+	int32_t s0 = amp_read_retry(a, 0x10), s1 = amp_read_retry(a, 0x11), s3 = amp_read_retry(a, 0x13),
+	    r1b = amp_read_retry(a, 0x1b), r1c = amp_read_retry(a, 0x1c), i0 = amp_read_retry(a, 0x40),
+	    i1 = amp_read_retry(a, 0x41), i2 = amp_read_retry(a, 0x42);
+	/*
+	 * round 6: with the guard on, the latches are cleared at power-up, so 0x10 reads 0x7e8e (54 reads of run
+	 * w4-audio-r5c-quiet-1, 48 of r5c-stock-1) where run r5a had 0x7eaf; 0x11 up is 0x881 plus mode bits (0x899, 0xe89,
+	 * 0xea1, 0x4ec1 seen). The line says "as expected" for those and no longer "NOT AS RUN r5a" for every healthy read.
+	 */
+	bool known = (s0 == 0x7eaf || (amp_guard != 0 && s0 == 0x7e8e)) && (s1 == 0x18 || (s1 & ~(int32_t)AMP_MODE_BITS) == 0x881) &&
+	    i0 == 0 && i1 == 0 && i2 == 0;
+
+	say("amp: status %s: %s: 0x10 %#x 0x11 %#x 0x13 %#x 0x1b %#x 0x1c %#x 0x40-0x42 %#x %#x %#x (raw; 0x11: 0x18 "
+	    "powered down, 0x881 + mode bits up): %s\n", when, amp_dev[d].name, s0, s1, s3, r1b, r1c, i0, i1, i2,
+	    s0 < 0 || s1 < 0 || i0 < 0 ? "A READ FAILED" : known ? "as expected" :
+	    "NOT AS EXPECTED (0x7e8e / 0x7eaf, 0x18 / 0x881 + mode bits, 0 0 0)");
+}
+
+/* the six amplifiers' status, each bus taken and given back as tone_amps_power does */
+static void
+amp_status_all(const char *when)
+{
+	for (unsigned b = 0; b < 2; b++) {
+		if (!amp_bus_take(b)) {
+			continue;
+		}
+		for (unsigned d = 0; d < 6; d++) {
+			if (amp_dev[d].bus == b) {
+				amp_status(d, when);
+			}
+		}
+		amp_bus_give();
+	}
+}
+
+/*
+ * round 5c: clears the latched status (0x10, 0x13) and the interrupt status (0x40 through 0x44) so that what is read
+ * later happened in this power cycle; the same three registers hold nothing else. The bus is held by the caller.
+ */
+static void
+amp_guard_clear(unsigned d)
+{
+	unsigned a = amp_dev[d].addr;
+
+	amp_w(a, 0x10, 0xfeff);
+	amp_w(a, 0x13, 0x0003);
+	amp_w(a, 0x44, 0xffff);
+	amp_guard_bad_reads[d] = 0;
+	amp_guard_noted[d] = 0;
+	amp_mode_last[d] = 0xffff;
+	amp_mode_polls[d] = amp_mode_engaged[d] = amp_mode_boost[d] = 0;
+	amp_mode_notes[d] = 0;
+	/* round 6: the boost ceiling and the limiter as this power cycle has them */
+	if (!amp_levels(d, "at power-up", false)) {
+		amp_level_alarm = true;
+	}
+}
+
+/*
+ * round 5c: one poll of the six, each bus taken and given back as tone_amps_power does: 30 register reads. False if an
+ * amplifier has an alarm (a failed read counts only from the second in a row). *clips rises once for the poll if any
+ * amplifier clips, not once per amplifier.
+ */
+static bool
+amp_guard_poll(uint32_t *clips)
+{
+	bool was = g_quiet, alarm = false, clipped = false;
+
+	g_quiet = false;                /* the service runs quiet: its guard's lines have to be seen */
+	if (amp_level_alarm) {          /* round 6: amp_levels() at this power-up */
+		amp_level_alarm = false;
+		alarm = true;
+		say("amp: GUARD ALARM: a boost ceiling above the wanted one, an attenuation under stock's 5 or a failed read of "
+		    "them at power-up (the amp: levels lines)\n");
+	}
+	for (unsigned b = 0; b < 2; b++) {
+		if (!amp_bus_take(b)) {
+			continue;
+		}
+		for (unsigned d = 0; d < 6; d++) {
+			unsigned a;
+			int32_t s0, s1, s2, s3, i0;
+			bool state;
+
+			if (amp_dev[d].bus != b) {
+				continue;
+			}
+			a = amp_dev[d].addr;
+			s0 = amp_read_retry(a, 0x10);
+			s1 = amp_read_retry(a, 0x11);
+			s2 = amp_read_retry(a, 0x12);
+			s3 = amp_read_retry(a, 0x13);
+			i0 = amp_read_retry(a, 0x40);
+			if (s0 < 0 || s1 < 0 || s2 < 0 || s3 < 0 || i0 < 0) {
+				if (amp_guard_bad_reads[d] < 255) {
+					amp_guard_bad_reads[d]++;
+				}
+				say("amp: guard: %s: a read failed (%u in a row)\n", amp_dev[d].name,
+				    (unsigned)amp_guard_bad_reads[d]);
+				if (amp_guard_bad_reads[d] >= 2) {      /* one failed poll is a retry, not an alarm */
+					alarm = true;
+				}
+				continue;
+			}
+			amp_guard_bad_reads[d] = 0;
+			state = amp_guard_manstate[d] != 0xff && (s2 & 0xf) != amp_guard_manstate[d];
+			if ((s0 & 0x000e) != 0x000e || (s0 & 0x0010) != 0 || (s0 & 0x7e00) != 0x7e00 ||
+			    (s0 & 0x8000) != 0 || (s3 & 0x0003) != 0 || (i0 & 0x059e) != 0 || state) {
+				alarm = true;
+				say("amp: GUARD ALARM: %s:%s%s%s%s%s%s%s 0x10 %#x 0x11 %#x 0x12 %#x 0x13 %#x 0x40 %#x\n",
+				    amp_dev[d].name,
+				    (s0 & 0x000e) != 0x000e ? " a temperature / supply / over-voltage ok flag is 0;" : "",
+				    (s0 & 0x0010) != 0 ? " over-current;" : "",
+				    (s0 & 0x7e00) != 0x7e00 ? " an output stage's over-current ok flag is 0;" : "",
+				    (s0 & 0x8000) != 0 ? " DC on the speaker;" : "",
+				    (s3 & 0x0003) != 0 ? " brown-out or charge pump;" : "",
+				    (i0 & 0x059e) != 0 ? " an interrupt is latched;" : "",
+				    state ? " the manager left its playing state;" : "",
+				    s0, s1, s2, s3, i0);
+			}
+			amp_mode_note(d, s1, s2);
+			if ((amp_guard_noted[d] & 0x0001) == 0) {       /* the notes, each once per power-up */
+				amp_guard_noted[d] |= 0x0001;
+				say("amp: guard: %s: first read after the clear: 0x10 %#x (0x7e8e expected) 0x11 %#x 0x12 "
+				    "%#x 0x13 %#x 0x40 %#x\n", amp_dev[d].name, s0, s1, s2, s3, i0);
+			}
+			if ((s1 & 0x1000) != 0) {               /* CLIPS */
+				clipped = true;
+				if ((amp_guard_noted[d] & 0x0002) == 0) {
+					amp_guard_noted[d] |= 0x0002;
+					say("amp: guard: %s: note:%s (0x10 %#x 0x11 %#x)\n", amp_dev[d].name,
+					    " clipping (CLIPS)", s0, s1);
+				}
+			}
+			if ((s0 & 0x0060) != 0 && (amp_guard_noted[d] & 0x0004) == 0) {          /* NOCLK or CLKOOR */
+				amp_guard_noted[d] |= 0x0004;
+				say("amp: guard: %s: note:%s (0x10 %#x 0x11 %#x)\n", amp_dev[d].name,
+				    " no clock / clock out of range latched", s0, s1);
+			}
+			if ((s0 & 0x0080) == 0 && (amp_guard_noted[d] & 0x0008) == 0) {          /* DCOCPOK 0 */
+				amp_guard_noted[d] |= 0x0008;
+				say("amp: guard: %s: note:%s (0x10 %#x 0x11 %#x)\n", amp_dev[d].name,
+				    " the booster's current limit was hit (DCOCPOK 0)", s0, s1);
+			}
+			if ((s1 & 0x0104) != 0 && (amp_guard_noted[d] & 0x0010) == 0) {          /* TDMERR or TDMLUTER */
+				amp_guard_noted[d] |= 0x0010;
+				say("amp: guard: %s: note:%s (0x10 %#x 0x11 %#x)\n", amp_dev[d].name, " a TDM error", s0, s1);
+			}
+		}
+		amp_bus_give();
+	}
+	if (clipped) {
+		(*clips)++;
+	}
+	g_quiet = was;
+	return !alarm;
+}
+
+/*
+ * round 5c: AMPGAIN 0 and H_MUTE on all six. The caller powers them down next; the gain stays 0 until the next boot's
+ * init.
+ */
+static void
+amp_guard_silence(void)
+{
+	for (unsigned b = 0; b < 2; b++) {
+		if (!amp_bus_take(b)) {
+			continue;
+		}
+		for (unsigned d = 0; d < 6; d++) {
+			unsigned a;
+
+			if (amp_dev[d].bus != b) {
+				continue;
+			}
+			a = amp_dev[d].addr;
+			amp_update(a, 0x52, 0x1fe0, 0);                 /* AMPGAIN 0: silent */
+			amp_update(a, 0x58, 0x0002, 0x0002);             /* H_MUTE */
+		}
+		amp_bus_give();
+	}
+	say("amp: guard: AMPGAIN 0 and mute written to all six\n");
+}
+
+/*
+ * tfa9865.c's DAPM order for all six. Up: POWER (DEVICE_CONTROL power down 0), its POST_PMU (SYS_CONTROL1 MANSCONF 1),
+ * AMP (DEVICE_CONTROL bit 3 = 1), mute_stream 0 (MISC_CONTROL H_MUTE 0). Down: the reverse (H_MUTE 1, AMP 0, PRE_PMD
+ * MANSCONF 0, power down 1) -- always run in full. Every write logged; each amplifier read back.
+ */
+static bool
+tone_amps_power(bool up)
+{
+	unsigned good = 0, fails0 = amp_write_fails;
+	bool failed[6] = { false };
+
+	amp_log_writes = true;
+	for (unsigned b = 0; b < 2; b++) {
+		if (!amp_bus_take(b)) {
+			continue;
+		}
+		if (amp_stat && !up) {
+			for (unsigned d = 0; d < 6; d++) {
+				if (amp_dev[d].bus == b) {
+					amp_status(d, "before down");
+				}
+			}
+		}
+		if (!up && amp_guard != 0) {            /* round 6: what the guard's polls saw of each one's mode */
+			for (unsigned d = 0; d < 6; d++) {
+				if (amp_dev[d].bus == b && amp_mode_polls[d] != 0) {
+					say("amp: mode: %s: engaged in %u of %u polls, boost mode in %u%s\n", amp_dev[d].name,
+					    (unsigned)amp_mode_engaged[d], (unsigned)amp_mode_polls[d], (unsigned)amp_mode_boost[d],
+					    amp_mode_engaged[d] == 0 ? ": NEVER ENGAGED (no signal in its slot?)" : "");
+					amp_mode_polls[d] = 0;
+				}
+			}
+		}
+		for (unsigned step = 0; step < 4; step++) {
+			for (unsigned d = 0; d < 6; d++) {
+				unsigned a = amp_dev[d].addr;
+				int32_t r;
+
+				if (amp_dev[d].bus != b) {
+					continue;
+				}
+				/* up: an amplifier whose step failed gets no later step (it stays powered down / muted, as DAPM
+				 * would stop at a failed widget); down: always every step */
+				if (up && failed[d]) {
+					continue;
+				}
+				switch (up ? step : 3 - step) {
+				case 0:
+					r = amp_update(a, 0x00, 0x0001, up ? 0 : 0x0001);       /* power down */
+					break;
+				case 1:
+					r = amp_update(a, 0x01, 0x0004, up ? 0x0004 : 0);       /* MANSCONF */
+					break;
+				case 2:
+					r = amp_update(a, 0x00, 0x0008, up ? 0x0008 : 0);       /* amplifier enable */
+					break;
+				default:
+					r = amp_update(a, 0x58, 0x0002, up ? 0 : 0x0002);       /* H_MUTE */
+					break;
+				}
+				if (r < 0 && !failed[d]) {
+					failed[d] = true;
+					say("tone: amp %s: a step %s failed%s\n", amp_dev[d].name, up ? "up" : "down", up ?
+					    ": no further step up for it" : ": the other steps down still run");
+				}
+			}
+		}
+		sleep_ms(10);
+		if (up && amp_guard != 0) {             /* round 5c: what is read below happened in this power cycle */
+			for (unsigned d = 0; d < 6; d++) {
+				if (amp_dev[d].bus == b) {
+					amp_guard_clear(d);
+				}
+			}
+		}
+		for (unsigned d = 0; d < 6; d++) {
+			unsigned a = amp_dev[d].addr;
+			int32_t c0, c1, st, mute;
+			bool as_wanted;
+
+			if (amp_dev[d].bus != b) {
+				continue;
+			}
+			c0 = amp_read_retry(a, 0x00);
+			c1 = amp_read_retry(a, 0x01);
+			st = amp_read_retry(a, 0x12);
+			mute = amp_read_retry(a, 0x58);
+			as_wanted = c0 >= 0 && c1 >= 0 && mute >= 0 && (up ? (!(c0 & 1) && (c0 & 8) && (c1 & 4) && !(mute & 2)) :
+			    ((c0 & 1) && !(c0 & 8) && (mute & 2)));
+			good += as_wanted;
+			say("tone: amp %s: DEVICE_CONTROL %#x (power down %u, amplifier %u), SYS_CONTROL1 %#x (MANSCONF %u), "
+			    "STATUS2 %#x (manager state %u), MISC %#x (mute %u): %s\n", amp_dev[d].name, c0, c0 & 1, (c0 >> 3) & 1,
+			    c1, (c1 >> 2) & 1, st, st & 0xf, mute, (mute >> 1) & 1, as_wanted ? (up ? "UP, UNMUTED" :
+			    "MUTED, POWERED DOWN") : "NOT AS WANTED");
+			if (up) {
+				/* round 5c: the manager state it came up in, what the guard compares each poll against */
+				amp_guard_manstate[d] = st >= 0 ? (uint8_t)(st & 0xf) : 0xff;
+			}
+			if (amp_stat) {
+				amp_status(d, up ? "after up" : "after down");
+			}
+		}
+		amp_bus_give();
+	}
+	amp_log_writes = false;
+	return good == 6 && amp_write_fails == fails0;
+}
+
+/*
+ * ---- Sound service S1 (boot-arg icesnd=1 with icetone=1, OFF by default) ----------------------------------------------
+ * Level D's whole path (amplifiers ready, C2, the back end, the stream graph) kept up for icesnd_secs (default 60, at
+ * most 3600) as a sink of /dev/redwood-audio (redwood_audio.c, the device dada's userland audio plug-in writes: 48 kHz,
+ * 2 x 16 bit; the sink as hakios_dada_audio.c's, credited): what is written goes into a 2 s ring and from there, in
+ * level D's 4 KB pieces (WR_SH_MEM_EP, IOVA | sid << 32), to the DSP. Every sample is scaled by icesnd_cap / 32767
+ * (default until 16 Nov 327: full scale -> -40.02 dBFS, as the tone; now SND_CAP_DEFAULT, -20.0 dBFS, see there) and
+ * clamped to +-cap (a sample above the cap is never sent);
+ * iOS's mute (REDWOOD_AUDIO_SET_VOLUME muted) sends zeros (its level is not applied yet: S2). The amplifiers come up
+ * (tone_amps_power) only when a piece that is not silence is about to go out, and go down after 3 s without one, at the
+ * end and on any failure; bank 7's FSR is read before every piece (a fault stops the service). icesnd_selftest=1: 5 s
+ * after the start the kernel itself writes level D's 440 Hz (full scale, 1 s) into the ring at real time, as a writer
+ * would -- the path proven without userland. Loud (needs the owner's explicit go): icesnd_cap above 327 is taken only
+ * with icesnd_loud=1 and at most SND_CAP_LOUD_MAX (17w: 29204 = -1.0 dBFS; 17o-17v: 3277 = -20.0 dBFS); otherwise the cap stays 327 and a line says so.
+ * No new kind of hardware write: the same writes as level D (17o2), repeated as the sound starts and stops.
+ * w4-audio round 5b (16 Nov): with icesnd_iogate=1 (the default) the amplifiers come up as soon as the audio server
+ * starts IO (iceland_audio_dev_running, bit 0), before the first sample, and the silent backlog waiting in the ring is
+ * dropped then; they go down 5 s after the later of the last sound and the end of IO, never while IO runs. With
+ * icesnd_feed=1 (the default) a piece of zeros goes out while they are up and the ring is empty and the DSP holds fewer
+ * than two pieces, so the path never starves (at most 43 ms before the next real frame). Both 0: the old behaviour.
+ */
+#define SND_RING_FRAMES         96000u          /* 2 s */
+#define SND_PIECE_FRAMES        (TONE_PIECE / 4u)
+#define SND_SILENCE             8
+#define SND_QUIET_MS            5000u           /* (3000 until w4-audio-r4d; 5 s as Linux's soc-core keeps a path up) */
+#define SND_CAP_LOUD_MAX        29204           /* 17w: 20 log10(29204 / 32767) = -1.00 dBFS, Linux's ceiling */
+/*
+ * w4-audio (owner, 16 Nov: "volume levels should be matching OxygenOS and Fedora Linux in our setup"): the stock levels.
+ * What both systems have in common and this path already has: the DSP's stream volume at Q13 8192 = 0 dB (TONE_VOL; Fedora's
+ * control "stream0.vol_ctrl0 MultiMedia1 Playback Volu" reads 8192 of at most 8192 on the tablet; OxygenOS sets a linear
+ * 0..1.0 stream factor), and the six amplifiers at the board's register values, which hold their only two level fields
+ * (0x5f bits 9:5 = 5, an attenuation; 0x76 bits 15:8 = 0xf0 on the middle pair, the largest boost voltage): amp_init()
+ * writes the driver's lists unchanged, and now reads both fields back (amp_gain_fields).
+ * What Fedora adds in front (its speaker sink, /usr/share/pipewire/pipewire.conf.d/62-iceland-speakers.conf, read on the
+ * tablet): a 150 Hz 4th-order high-pass, a cuts-only tone fitted to stock's response, a 2.5:1 compressor over -24 dBFS
+ * with 9 dB of make-up, and a limiter at -1 dBFS. So no sample ever leaves Fedora above -1.0 dBFS (29204: the hard
+ * ceiling here too, SND_CAP_LOUD_MAX), and a full-scale steady tone leaves it, at full volume, at about -8 dBFS at the
+ * most (1.2 kHz; 440 Hz: about -10 dBFS) -- an ESTIMATE from the chain's static curves (scratchpad w4-audio/v09-hp.py),
+ * to be replaced by a measurement of Fedora with the same microphone.
+ * This path has the high-pass (snd_hp) and no compressor, so full scale maps to SND_CAP_STOCK = 13045 (-8.0 dBFS), the
+ * stock level: never louder than Fedora for the loudest steady signal, quieter than it for quiet material (which
+ * Fedora's make-up raises). It is NOT the default (SND_CAP_DEFAULT below); it and anything else above the default, up to
+ * the ceiling, needs icesnd_loud=1.
+ */
+#define SND_CAP_STOCK           13045           /* 20 log10(13045 / 32767) = -8.00 dBFS */
+/*
+ * Owner, 16 Nov, later the same day: "don't play any high volume now". The cap a line without icesnd_cap gets is
+ * -20.0 dBFS again (3277, the level of tablet run w4-audio-d2-2l-r3), and anything above it -- the stock level
+ * included -- needs icesnd_loud=1, the owner's go, as before: a word missing from the line can no longer be loud.
+ */
+#define SND_CAP_DEFAULT         3277            /* 20 log10(3277 / 32767) = -20.00 dBFS */
+#define SND_PREROLL_MS          300u            /* amplifiers up and unmuted this long before the first piece with sound */
+static LCK_GRP_DECLARE(snd_lck_grp, "iceland-snd");
+static LCK_MTX_DECLARE(snd_lock, &snd_lck_grp);
+static int16_t *snd_ring;
+static uint64_t snd_head, snd_tail, snd_lost;
+static uint32_t snd_wanted, snd_secs = 60, snd_selftest, snd_cap = SND_CAP_DEFAULT, snd_hp_on = 1, snd_preroll = SND_PREROLL_MS;
+/*
+ * w4-audio round 5b: the amplifiers follow the audio server's IO (icesnd_iogate, the default), and while they are up a
+ * piece of zeros keeps the stream from starving (icesnd_feed, the default). Both 0: the amplifiers come up with the
+ * first sound and no piece of zeros is made.
+ */
+static uint32_t snd_iogate = 1;
+static uint32_t snd_feed = 1;
+#if XNU_TARGET_OS_OSX
+extern volatile uint32_t iceland_audio_dev_running;     /* bit 0: the audio server runs the speaker engine */
+#endif
+
+/* true while the audio server's speaker engine runs and icesnd_iogate allows it (never under QEMU) */
+static inline bool
+snd_io_running(void)
+{
+#if XNU_TARGET_OS_OSX
+	return snd_iogate != 0 && (iceland_audio_dev_running & 1) != 0;
+#else
+	return false;
+#endif
+}
+
+/*
+ * Fedora's first stage, the speakers' protection from what they cannot play: high-pass 150 Hz, 4th order, as its two
+ * biquads (Q 0.541 and 1.307, 48 kHz; the usual cookbook form). Integers: coefficients Q30, samples and states Q12, each
+ * section's output held to +-2^29 (a full-scale 150 Hz square overshoots by 5.3 dB: 2^28). Checked against the float
+ * response and for silence in -> silence out by scratchpad w4-audio/v09-hp.py, which runs this arithmetic.
+ * icesnd_hp=0 turns it off (a measurement of the path alone).
+ */
+static const int64_t snd_hp_q30[2][5] = {       /* b0, b1, b2, a1, a2 */
+	{ 1054503587, -2109007175, 1054503587, -2108803890, 1035468636 },
+	{ 1065634382, -2131268765, 1065634382, -2131063334, 1057732371 },
+};
+static int64_t snd_hp_state[2][2][4];           /* channel, section: x1, x2, y1, y2 */
+
+static int32_t
+snd_hp(uint32_t channel, int32_t sample)
+{
+	int64_t x = (int64_t)sample << 12;
+
+	for (unsigned s = 0; s < 2; s++) {
+		int64_t *z = snd_hp_state[channel][s];
+		const int64_t *k = snd_hp_q30[s];
+		int64_t y = (k[0] * x + k[1] * z[0] + k[2] * z[1] - k[3] * z[2] - k[4] * z[3] + (1ll << 29)) >> 30;
+
+		y = y > (1ll << 29) ? (1ll << 29) : y < -(1ll << 29) ? -(1ll << 29) : y;
+		z[1] = z[0];
+		z[0] = x;
+		z[3] = z[2];
+		z[2] = y;
+		x = y;
+	}
+	return (int32_t)((x + 2048) >> 12);
+}
+static volatile uint64_t snd_last_us;   /* now_us() of the latest write into the ring */
+static uint32_t snd_vol_q15 = 32768, snd_vol_gen;       /* 21v: iOS's volume as a Q15 gain on top of the cap */
+static bool snd_vol_known;
+
+static uint64_t
+snd_last_write_us(void)
+{
+	return snd_last_us;
+}
+
+static uint32_t
+snd_sink(const int16_t *frames, uint32_t count)
+{
+	uint32_t taken = 0;
+
+	snd_last_us = now_us();
+	lck_mtx_lock(&snd_lock);
+	while (snd_ring != NULL && taken < count && snd_head - snd_tail < SND_RING_FRAMES) {
+		uint32_t at = (uint32_t)(snd_head % SND_RING_FRAMES);
+
+		snd_ring[2 * at] = frames[2 * taken];
+		snd_ring[2 * at + 1] = frames[2 * taken + 1];
+		snd_head++;
+		taken++;
+	}
+	snd_lost += count - taken;
+	lck_mtx_unlock(&snd_lock);
+	return taken;
+}
+
+/*
+ * Sample n of a self-test tone at full scale. icesnd_trill=1 (the default since tablet run w4-audio-r4d): 440 Hz and
+ * 600 Hz in turn, 125 ms each (6000 frames: whole cycles of both, so the phase runs on), instead of one steady 440 Hz.
+ * The PC microphone's records of two runs have each 1 s tone as 0.35 s, 0.8 s of nothing and 0.1 s, while the DSP took the
+ * pieces evenly: what a noise suppressor makes of a steady tone, most likely. A tone that changes four times a second gives
+ * it nothing steady. icesnd_trill=0: the plain 440 Hz. 10 ms fades at both ends, as the tone.
+ */
+static uint32_t snd_trill = 1;
+
+static int32_t
+snd_test_sample(uint32_t n)
+{
+	uint32_t step = snd_trill && ((n / 6000u) & 1) ? 15u : 11u, k = ((n % 6000u) * step) % 1200u;
+	int32_t v = k <= 300 ? tone_q[k] : k <= 600 ? tone_q[600 - k] : k <= 900 ? -tone_q[k - 600] : -tone_q[1200 - k];
+
+	if (n < TONE_FADE) {
+		v = v * (int32_t)n / (int32_t)TONE_FADE;
+	} else if (n >= TONE_FRAMES - TONE_FADE) {
+		v = v * (int32_t)(TONE_FRAMES - 1 - n) / (int32_t)TONE_FADE;
+	}
+	return v;
+}
+
+/* the cap the line asks for, as the rules allow it (boot arguments only: nothing is touched) */
+static uint32_t
+snd_cap_wanted(bool tell)
+{
+	uint32_t loud = 0, cap = SND_CAP_DEFAULT;
+
+	/*
+	 * round 5b (owner, 16 Nov ~11:00: loud volume allowed again, never above stock): icesnd_loud=1 alone means the
+	 * stock level, SND_CAP_STOCK; icesnd_cap=N beside it still sets another cap, up to the hard ceiling.
+	 */
+	PE_parse_boot_argn("icesnd_loud", &loud, sizeof(loud));
+	if (loud == 1) {
+		cap = SND_CAP_STOCK;
+	}
+	PE_parse_boot_argn("icesnd_cap", &cap, sizeof(cap));
+	if (cap == 0 || cap > (uint32_t)SND_CAP_LOUD_MAX || (cap > (uint32_t)SND_CAP_DEFAULT && loud != 1)) {
+		if (tell) {
+			say("snd: icesnd_cap %u REFUSED (%s): the cap stays %d (-20.0 dBFS)\n", cap, cap == 0 ? "zero" :
+			    cap > (uint32_t)SND_CAP_LOUD_MAX ? "above the hard ceiling, 29204 = -1.0 dBFS" :
+			    "above -20 dBFS needs icesnd_loud=1, the owner's go", SND_CAP_DEFAULT);
+		}
+		cap = SND_CAP_DEFAULT;
+	}
+	return cap;
+}
+
+/* for IcelandAudio's first line (QEMU has no DSP: the cap this line would get is shown there too) */
+uint32_t iceland_snd_cap(void);
+uint32_t
+iceland_snd_cap(void)
+{
+	return snd_cap_wanted(false);
+}
+
+static void
+snd_args(void)
+{
+	PE_parse_boot_argn("icesnd_hp", &snd_hp_on, sizeof(snd_hp_on));
+	PE_parse_boot_argn("icesnd_trill", &snd_trill, sizeof(snd_trill));
+	PE_parse_boot_argn("icesnd_preroll", &snd_preroll, sizeof(snd_preroll));
+	snd_preroll = LESSER(snd_preroll, 1000u);
+	PE_parse_boot_argn("icesnd_iogate", &snd_iogate, sizeof(snd_iogate));
+	PE_parse_boot_argn("icesnd_feed", &snd_feed, sizeof(snd_feed));
+	PE_parse_boot_argn("icesnd", &snd_wanted, sizeof(snd_wanted));
+	PE_parse_boot_argn("icesnd_secs", &snd_secs, sizeof(snd_secs));
+	if (ice_rec()) {        /* round 6: the microphone needs the path after it (icesnd_secs is built in: its own word) */
+		snd_secs = 215;
+		PE_parse_boot_argn("icerec_snd", &snd_secs, sizeof(snd_secs));
+		say("snd: icerec=1: the sound service runs %u s, the microphone's service comes after it\n", snd_secs);
+	}
+	PE_parse_boot_argn("icesnd_selftest", &snd_selftest, sizeof(snd_selftest));
+	PE_parse_boot_argn("iceamp_stat", &amp_stat, sizeof(amp_stat));
+	PE_parse_boot_argn("iceamp_guard", &amp_guard, sizeof(amp_guard));
+	snd_secs = snd_secs < 10 ? 10 : snd_secs > 3600 ? 3600 : snd_secs;
+	{
+		/* w4 (macOS): the service ends 12 s before reset-after's end of the run, so the amplifiers are down, the graphs
+		 * closed and bank 7 put back by this thread, in order, before the stop hook's 8 s */
+		uint32_t end = 0, up = (uint32_t)(now_us() / 1000000ull);
+
+		if (PE_parse_boot_argn("reset-after", &end, sizeof(end)) && end != 0 && up + snd_secs + 12 > end) {
+			uint32_t room = end > up + 22 ? end - up - 12 : 10;
+
+			say("snd: icesnd_secs %u cut to %u (the run ends at %u s, now %u s)\n", snd_secs, room, end, up);
+			snd_secs = room;
+		}
+	}
+	snd_cap = snd_cap_wanted(true);
+}
+
+/* the service loop (the stream graph runs; the amplifiers are down): false on a failure */
+static bool
+snd_service(struct gchan *apps)
+{
+	uint64_t t0 = now_us(), last_loud = 0, fed = 0, selftest_k = 0;
+	uint64_t last_io = 0, fed_silence = 0, dropped = 0;
+	uint64_t last_guard = 0;
+	uint32_t clips = 0, guard_polls = 0;
+	uint32_t sent = 0, done = 0, bad = 0, peak_in = 0, peak_out = 0, pieces_loud = 0, ups = 0;
+	uint64_t padded = 0;
+	bool amps = false, ok = true, muted = false, mid_done = false;
+	bool io = false;
+	uint64_t amps_at = 0;
+	const char *why = NULL;
+
+	snd_ring = (int16_t *)kalloc_data(SND_RING_FRAMES * 4, Z_WAITOK | Z_ZERO);
+	if (snd_ring == NULL) {
+		say("snd: no memory for the ring\n");
+		return false;
+	}
+	snd_head = snd_tail = snd_lost = 0;
+	tone_done_in = tone_done_out = 0;
+	redwood_audio_set_sink("the speakers (iceland: ADSP stream graph, icesnd)", snd_sink);
+	ice_snd_live = 1;
+	say("snd: SERVICE UP for %u s: /dev/redwood-audio -> ring -> WR_SH_MEM_EP; cap %u of 32767 (%s), selftest %u; "
+	    "amplifiers come up with the first sound\n", snd_secs, snd_cap, snd_cap == (uint32_t)SND_CAP_DEFAULT ?
+	    "-20.0 dBFS" : snd_cap < (uint32_t)SND_CAP_DEFAULT ? "below -20 dBFS" : snd_cap == (uint32_t)SND_CAP_STOCK ?
+	    "LOUD: -8.0 dBFS, the stock level" : "LOUD TEST",
+	    snd_selftest);
+	say("snd: high-pass 150 Hz %s, %u ms of quiet after the amplifiers come up; the self-test's tones climb 4 dB each, "
+	    "the last one at the cap\n", snd_hp_on ? "on" : "OFF (icesnd_hp=0)", snd_preroll);
+	say("snd: amplifiers follow the audio server's IO: %s; silence pieces while they are up: %s\n",
+	    snd_iogate != 0 ? "yes" : "NO (icesnd_iogate=0)", snd_feed != 0 ? "yes" : "NO (icesnd_feed=0)");
+	say("snd: amplifier guard: %s (iceamp_guard=%u): latches cleared at power-up, six amplifiers read every 250 ms "
+	    "while up\n", amp_guard >= 2 ? "stops on an alarm" : amp_guard == 1 ? "reports only" : "OFF", amp_guard);
+	bzero(snd_hp_state, sizeof(snd_hp_state));
+	g_quiet = true;
+	while (ok && !g_broken && !adsp_stop_req && now_us() - t0 < (uint64_t)snd_secs * 1000000ull) {
+		uint64_t now = now_us();
+		uint32_t gen = 0, below = 0;
+
+		/*
+		 * the selftest: a writer of 1 s of 440 Hz at full scale, 5 s in, at real time. w4-audio: icesnd_selftest=N
+		 * (at most 20) writes it N times, 20 s apart (5, 25, 45 ... s after the service's start), so whoever listens at
+		 * the tablet need not catch one second; between two the amplifiers go down as after any sound (3 s of quiet).
+		 */
+		if (snd_selftest && now - t0 >= 5000000ull && (now - t0 - 5000000ull) / 20000000ull != selftest_k &&
+		    (now - t0 - 5000000ull) / 20000000ull < LESSER(snd_selftest, 20u) && fed >= TONE_FRAMES) {
+			selftest_k = (now - t0 - 5000000ull) / 20000000ull;
+			fed = 0;
+		}
+		if (snd_selftest && now - t0 >= 5000000ull + selftest_k * 20000000ull && fed < TONE_FRAMES) {
+			/*
+			 * w4-audio (16 Nov): a ladder, not six equal tones: the last tone at full scale (it leaves at the cap),
+			 * each one before it 4 dB lower, at most 20 dB down (Q15: 10^(-4k/20)). With the stock cap and six tones:
+			 * -28, -24, -20, -16, -12, -8 dBFS. A microphone must hear 4 dB steps; smaller steps at the top are
+			 * compression or clipping somewhere, and the third tone is the -20 dBFS of run w4-audio-d2-2l-r3.
+			 */
+			static const int32_t ladder_q15[6] = { 32768, 20675, 13045, 8231, 5193, 3277 };
+			uint64_t due = (now - t0 - 5000000ull - selftest_k * 20000000ull) * TONE_RATE / 1000000ull;
+			uint32_t last = LESSER(snd_selftest, 20u) - 1, down = last - (uint32_t)LESSER(selftest_k, (uint64_t)last);
+			int32_t step = ladder_q15[LESSER(down, 5u)];
+			int16_t f[2 * 256];
+			uint32_t n = 0;
+
+			if (fed == 0 && due != 0) {
+				g_quiet = false;
+				say("snd: self-test tone %llu of %u: %s, 1 s, %u dB under full scale (peak %u of 32767 after the cap)\n",
+				    selftest_k + 1, last + 1, snd_trill ? "440 / 600 Hz in turn, 125 ms each" : "440 Hz",
+				    4 * LESSER(down, 5u), (uint32_t)(((uint64_t)snd_cap * (uint32_t)step) >> 15));
+				g_quiet = true;
+			}
+			/*
+			 * Everything that is due goes into the ring now, 256 frames at a time. Until tablet run w4-audio-r4d it was
+			 * 256 frames a pass at the most: after the amplifiers' start (this thread, 0.4 s) the writer crawled behind
+			 * and the sender, below, sent what little there was with zeros behind it -- a quarter of a second of chopped
+			 * tone at the head of each one, in the microphone's record 10 dB under the rest.
+			 */
+			while (fed < TONE_FRAMES && fed < due) {
+				for (n = 0; fed < TONE_FRAMES && fed < due && n < 256; n++, fed++) {
+					int32_t v = (int32_t)(((int64_t)snd_test_sample((uint32_t)fed) * step) >> 15);
+
+					v = v > 32767 ? 32767 : v < -32767 ? -32767 : v;
+					f[2 * n] = f[2 * n + 1] = (int16_t)v;
+				}
+				if (snd_sink(f, n) != n) {
+					break;
+				}
+			}
+		}
+		{
+			/*
+			 * 21v: iOS's volume (REDWOOD_AUDIO_SET_VOLUME from the HAL plug-in: `below` eighths of a dB under full,
+			 * muted) on top of the cap: vol_q15 = 32768 x 10^(-below / 160), computed when the setting changes
+			 * (10^(-1/160) = 0.985711 = 32300 / 32768, one step per eighth of a dB; under -96 dB: silence). The cap
+			 * still bounds every sample.
+			 */
+			bool set = redwood_audio_volume(&below, &muted, &gen);
+
+			if (!set) {
+				muted = false;
+				below = 0;
+			}
+			if (gen != snd_vol_gen || !snd_vol_known) {
+				uint64_t q = 32768;
+
+				for (uint32_t k = 0; k < below && q != 0; k++) {
+					q = (q * 32300 + 16384) >> 15;
+					if (k >= 768) {
+						q = 0;
+					}
+				}
+				snd_vol_q15 = muted ? 0 : (uint32_t)q;
+				snd_vol_gen = gen;
+				snd_vol_known = true;
+				g_quiet = false;
+				say("snd: volume: iOS %s%u/8 dB under full%s -> gain %u/32768 on the cap %u (peak at most %u of 32767)\n",
+				    set ? "" : "(not set yet) ", below, muted ? ", MUTED" : "", snd_vol_q15, snd_cap,
+				    (uint32_t)(((uint64_t)snd_cap * snd_vol_q15) >> 15));
+				g_quiet = true;
+			}
+		}
+		g_pump();
+		if (svc_shared()) {
+			svc_shared_poll(NULL);  /* laneD: the share's clients (the sensors) ride this loop while it runs */
+		}
+		while (tone_done_out != tone_done_in) {
+			if (tone_done_ring[tone_done_out % 64].status != 0) {
+				bad++;
+			}
+			tone_done_out++;
+			done++;
+		}
+		io = snd_io_running();
+		if (io) {
+			last_io = now;
+		}
+		if (io && !amps) {
+			/*
+			 * w4-audio round 5b: the audio server has started IO, so the amplifiers come up now, before any sample,
+			 * out of the way of the stream. Whatever silence waited in the ring while they started is dropped, so
+			 * the stream is not late for the rest of this IO.
+			 */
+			uint64_t silent = 0;
+
+			g_quiet = false;
+			say("snd: the audio server started IO at %llu ms: amplifiers up before the first sample\n", (now - t0) / 1000);
+			amps = true;
+			ups++;
+			amps_at = now;
+			mid_done = false;
+			last_loud = now;
+			if (!tone_amps_power(true)) {
+				ok = false;
+				why = "the amplifiers did not all come up as wanted";
+			} else {
+				lck_mtx_lock(&snd_lock);
+				while (snd_head - snd_tail > SND_PIECE_FRAMES) {
+					uint32_t at = (uint32_t)(snd_tail % SND_RING_FRAMES);
+					int32_t l = snd_ring[2 * at], r = snd_ring[2 * at + 1];
+
+					if (l < -SND_SILENCE || l > SND_SILENCE || r < -SND_SILENCE || r > SND_SILENCE) {
+						break;
+					}
+					snd_tail++;
+					silent++;
+				}
+				lck_mtx_unlock(&snd_lock);
+				dropped += silent;
+				say("snd: amplifiers up after %llu ms; %llu silent frames that waited were dropped\n",
+				    (now_us() - now) / 1000, silent);
+				last_guard = now_us();
+			}
+			g_quiet = true;
+		}
+		/*
+		 * round 5c: the guard, four times a second while the amplifiers are up. A fresh now_us(): in a pass in which
+		 * they have just come up, last_guard was taken after `now`, and the difference would wrap round.
+		 */
+		if (ok && amps && amp_guard != 0 && now_us() - last_guard >= 250000ull) {
+			last_guard = now;
+			guard_polls++;
+			if (!amp_guard_poll(&clips) && amp_guard >= 2) {
+				g_quiet = false;
+				amp_guard_silence();
+				say("snd: GUARD: an amplifier alarm at %llu ms: silenced, powering down, the service stops\n",
+				    (now - t0) / 1000);
+				g_quiet = true;
+				ok = false;
+				why = "GUARD: an amplifier alarm";
+			}
+		}
+		while (ok && sent - done < TONE_AHEAD) {
+			uint64_t avail;
+			uint32_t take, slot = sent % TONE_SLOTS, fsr, loudest = 0;
+			int16_t *pcm = (int16_t *)(c2.buf + (vm_offset_t)slot * TONE_PIECE);
+
+			lck_mtx_lock(&snd_lock);
+			avail = snd_head - snd_tail;
+			lck_mtx_unlock(&snd_lock);
+			/* a whole piece, or what is left once the writer has paused 30 ms (the rest is zeros) */
+			/*
+			 * (w4-audio-r4d: the pause is measured from the clock now. `now` is this pass's start, and a write later
+			 * in the same pass -- the self-test's, or a writer on another core -- made the difference wrap, so every
+			 * short rest went out at once with zeros behind it: 343 pieces for six seconds of tone, not 282.)
+			 */
+			/*
+			 * w4-audio round 5b: a piece of zeros whenever the amplifiers are up and the ring is empty and the DSP
+			 * holds fewer than two pieces. The stream never starves while the amplifiers are up (Linux keeps the
+			 * clock and the path running the same way), and at most two pieces (43 ms) stand before the next real
+			 * frame.
+			 */
+			if (avail == 0 && !(amps && snd_feed != 0 && sent - done < 2)) {
+				break;
+			}
+			if (avail < SND_PIECE_FRAMES) {
+				uint64_t wrote = snd_last_write_us(), clock = now_us();
+
+				if (clock < wrote || clock - wrote < 30000ull) {
+					break;
+				}
+			}
+			fsr = rd(c2.cb + 0x58);
+			if (fsr != 0 && fsr != c2_fsr_found) {
+				say("snd: bank %u FSR %#x (FAR %#x_%08x): a DSP access faulted -- the service stops\n", c2.bank, fsr,
+				    rd(c2.cb + 0x64), rd(c2.cb + 0x60));
+				ok = false;
+				why = "an SMMU fault on bank 7";
+				break;
+			}
+			take = (uint32_t)LESSER(avail, (uint64_t)SND_PIECE_FRAMES);
+			if (take == 0) {
+				fed_silence++;          /* a piece of zeros, not padding behind a short piece */
+			} else {
+				padded += SND_PIECE_FRAMES - take;
+			}
+			lck_mtx_lock(&snd_lock);
+			for (uint32_t i = 0; i < SND_PIECE_FRAMES; i++) {
+				for (uint32_t c = 0; c < 2; c++) {
+					int32_t in = 0, out;
+					uint32_t m;
+
+					if (i < take) {
+						in = snd_ring[2 * ((snd_tail + i) % SND_RING_FRAMES) + c];
+					}
+					m = (uint32_t)(in < 0 ? -in : in);
+					peak_in = GREATER(peak_in, m);
+					loudest = GREATER(loudest, m);
+					if (snd_hp_on) {
+						in = snd_hp(c, in);     /* (it may overshoot full scale: the clamp below holds the cap) */
+					}
+					out = muted ? 0 : (int32_t)(((int64_t)in * snd_cap + (in >= 0 ? 16383 : -16383)) / 32767);
+					out = (int32_t)(((int64_t)out * snd_vol_q15) >> 15);
+					out = out > (int32_t)snd_cap ? (int32_t)snd_cap : out < -(int32_t)snd_cap ? -(int32_t)snd_cap : out;
+					peak_out = GREATER(peak_out, (uint32_t)(out < 0 ? -out : out));
+					pcm[2 * i + c] = (int16_t)out;
+				}
+			}
+			snd_tail += take;
+			lck_mtx_unlock(&snd_lock);
+			if (peak_out > snd_cap) {
+				ok = false;
+				why = "GUARD: a sample above the cap";
+				break;
+			}
+			if (loudest > SND_SILENCE && !muted) {
+				last_loud = now;
+				pieces_loud++;
+				if (!amps) {
+					g_quiet = false;
+					say("snd: sound at %llu ms: amplifiers up\n", (now - t0) / 1000);
+					amps = true;
+					ups++;
+					amps_at = now;
+					mid_done = false;
+					if (!tone_amps_power(true)) {
+						ok = false;
+						why = "the amplifiers did not all come up as wanted";
+						break;
+					}
+					/*
+					 * w4-audio (16 Nov): the amplifiers are up and unmuted (140 ms on the tablet) BEFORE this first
+					 * piece with sound is sent -- and now stay so for icesnd_preroll ms (300) more before it goes out,
+					 * their start settled. Nothing is dropped: the piece and the ring wait (the ring holds 2 s).
+					 */
+					for (uint64_t until = now_us() + (uint64_t)snd_preroll * 1000ull; now_us() < until;) {
+						g_pump();
+						sleep_ms(1);
+					}
+					say("snd: amplifiers up after %llu ms, %u ms of it quiet: the sound goes out\n",
+					    (now_us() - now) / 1000, snd_preroll);
+					last_guard = now_us();
+					g_quiet = true;
+				}
+			}
+			c2_clean(c2.buf + (vm_offset_t)slot * TONE_PIECE, TONE_PIECE);
+			if (!tone_send(apps, slot, TONE_PIECE)) {
+				ok = false;
+				why = "a buffer could not be sent";
+				break;
+			}
+			sent++;
+		}
+		if (amp_stat >= 2 && amps && !mid_done && now - amps_at >= 2000000ull) {   /* 17w: one look while it plays */
+			mid_done = true;
+			g_quiet = false;
+			amp_status_all("2 s into the sound");
+			g_quiet = true;
+		}
+		if (amps && !io && now - GREATER(last_loud, last_io) > SND_QUIET_MS * 1000ull) {
+			g_quiet = false;
+			say("snd: %u ms without sound or IO at %llu ms: amplifiers down\n", SND_QUIET_MS, (now - t0) / 1000);
+			amps = false;
+			(void)tone_amps_power(false);
+			g_quiet = true;
+		}
+		sleep_ms(1);
+	}
+	g_quiet = false;
+	redwood_audio_set_sink("nothing (iceland icesnd ended)", NULL);
+	ice_snd_live = 0;
+	if (amps) {
+		(void)tone_amps_power(false);
+	}
+	for (int i = 0; i < 300 && done != sent; i++) {    /* what the DSP still holds */
+		g_pump();
+		while (tone_done_out != tone_done_in) {
+			tone_done_out++;
+			done++;
+		}
+		sleep_ms(1);
+	}
+	lck_mtx_lock(&snd_lock);
+	kfree_data(snd_ring, SND_RING_FRAMES * 4);
+	snd_ring = NULL;
+	lck_mtx_unlock(&snd_lock);
+	say("snd: SERVICE %s after %llu s: %u pieces sent (%u with sound), %u done (%u status not 0), %llu frames lost (ring "
+	    "full), %llu frames of zeros behind short pieces, %llu pieces of silence fed, %llu silent frames dropped at IO "
+	    "starts, %u guard polls (%u with clipping), peak in %u -> out %u of 32767 (cap %u), amplifiers up %u time(s), "
+	    "now DOWN; bank 7 FSR %#x\n",
+	    ok ? "ENDED" : "FAILED", (now_us() - t0) / 1000000, sent, pieces_loud, done, bad, snd_lost, padded, fed_silence,
+	    dropped, guard_polls, clips, peak_in, peak_out, snd_cap, ups, rd(c2.cb + 0x58));
+	if (!ok) {
+		say("snd: FAIL: %s\n", why);
+	}
+	return ok;
+}
+
+/* with the back end running silence: the stream graph, the amplifiers up, the tone, the amplifiers down, the graph */
+static bool
+tone_play(struct gchan *apps, vm_offset_t tlmm, uint32_t mode)
+{
+	const uint32_t pieces = (TONE_BYTES + TONE_PIECE - 1) / TONE_PIECE;
+	uint32_t sent = 0, done = 0, bad = 0, first_bad_lsw = 0, first_bad_status = 0, peak = 0, ms = 0;
+	uint64_t t_first = 0, t_last = 0, t_progress;
+	bool ok, amps_up = false, played;
+	const char *why = NULL;
+
+	ok = mode == 2 ? tone_fe_opened : tone_fe_open(apps, true);
+	if (!ok) {
+		why = "the stream graph did not open";
+	}
+	if (ok && !tone_fe_start(apps)) {
+		ok = false;
+		why = "the stream graph was not configured / started";
+	}
+	if (ok && snd_wanted == 1) {
+		bool served;
+
+		au_sample(tlmm, "stream graph started (service)");
+		served = snd_service(apps);
+		tone_fe_close(apps);
+		return served;
+	}
+	if (ok) {
+		say("tone: the stream graph runs, no data yet (the back end still sends zeros); amplifiers up next\n");
+		au_sample(tlmm, "stream graph started");
+		amps_up = true;
+		if (!tone_amps_power(true)) {
+			ok = false;
+			why = "the amplifiers did not all come up as wanted";
+		}
+	}
+	if (ok && tone_stage == 2) {
+		/* stage 2: no sample; the amplifiers stay up 1 s with the TDM running, the GPR pumped */
+		say("tone: STAGE 2: amplifiers up, the stream graph running, NO sample sent; holding 1 s\n");
+		for (int i = 0; i < 1000 && !g_broken; i++) {
+			g_pump();
+			sleep_ms(1);
+		}
+		c2_fault_report("stage 2 after 1 s");
+		say("tone: STAGE 2 held 1 s: amplifiers down next\n");
+		ok = false;
+		why = "STAGE 2 (icetone_stage=2): no sample by design";
+	}
+	if (ok) {
+		say("tone: amplifiers UP AND UNMUTED; the tone's %u pieces of %u bytes go out now\n", pieces, TONE_PIECE);
+		tone_done_in = tone_done_out = 0;
+		g_quiet = true;
+		t_progress = now_us();
+		while (done < pieces && ok && !g_broken) {
+			while (ok && sent < pieces && sent - done < TONE_AHEAD) {
+				uint32_t slot = sent % TONE_SLOTS, first = sent * (TONE_PIECE / 4),
+				    frames = LESSER(TONE_PIECE / 4, TONE_FRAMES - first), len = frames * 4;
+				int16_t *pcm = (int16_t *)(c2.buf + (vm_offset_t)slot * TONE_PIECE);
+				uint32_t fsr = rd(c2.cb + 0x58);
+
+				if (fsr != 0 && fsr != c2_fsr_found) {
+					say("tone: bank %u FSR %#x before piece %u (FAR %#x_%08x FSYNR0 %#x): a DSP access faulted -- NO "
+					    "further piece\n", c2.bank, fsr, sent, rd(c2.cb + 0x64), rd(c2.cb + 0x60), rd(c2.cb + 0x68));
+					ok = false;
+					why = "an SMMU fault on bank 7 while streaming";
+					break;
+				}
+				for (uint32_t f = 0; f < frames; f++) {
+					int32_t v = tone_sample(first + f);
+					uint32_t m = (uint32_t)(v < 0 ? -v : v);
+
+					peak = GREATER(peak, m);
+					pcm[2 * f] = (int16_t)v;
+					pcm[2 * f + 1] = (int16_t)v;
+				}
+				if (peak > (uint32_t)TONE_AMP_MAX) {
+					ok = false;
+					why = "GUARD: a sample above -40 dBFS (nothing of that piece sent)";
+					break;
+				}
+				c2_clean(c2.buf + (vm_offset_t)slot * TONE_PIECE, len);
+				if (!tone_send(apps, slot, len)) {
+					ok = false;
+					why = "a buffer could not be sent";
+					break;
+				}
+				if (sent == 0) {
+					t_first = now_us();
+				}
+				sent++;
+			}
+			g_pump();
+			while (tone_done_out != tone_done_in) {
+				uint32_t lsw = tone_done_ring[tone_done_out % 64].lsw, st = tone_done_ring[tone_done_out % 64].status;
+
+				if (lsw != (uint32_t)(C2_IOVA + (done % TONE_SLOTS) * TONE_PIECE) || st != 0) {
+					if (bad++ == 0) {
+						first_bad_lsw = lsw;
+						first_bad_status = st;
+					}
+				}
+				tone_done_out++;
+				done++;
+				t_progress = now_us();
+			}
+			if (ok && now_us() - t_progress > 1000000ull) {
+				ok = false;
+				why = "the DSP took no buffer for 1 s";
+			}
+			sleep_ms(1);
+		}
+		t_last = now_us();
+		g_quiet = false;
+		ms = t_first ? (uint32_t)((t_last - t_first) / 1000) : 0;
+		say("tone: %u of %u pieces sent, %u done by the DSP (%u not as expected%s), peak sample %u of 32767, %u ms "
+		    "from the first send to the last done\n", sent, pieces, done, bad, bad ? "" : ": every status 0", peak, ms);
+		if (bad) {
+			say("tone: the first unexpected done: address %#x status %#x\n", first_bad_lsw, first_bad_status);
+		}
+		if (done == pieces && ms < 800) {
+			say("tone: NOTE: taken faster than real time (%u ms for 1 s): the DSP may not have played all of it\n", ms);
+		}
+		for (int i = 0; i < 60; i++) {          /* the last piece's samples through the DSP's pipeline */
+			g_pump();
+			sleep_ms(1);
+		}
+	}
+	if (amps_up) {
+		bool down = tone_amps_power(false);
+
+		say("tone: amplifiers %s\n", down ? "MUTED AND POWERED DOWN" : "NOT ALL CONFIRMED MUTED AND POWERED DOWN (above)");
+	}
+	played = ok && done == pieces && bad == 0;
+	if (played) {
+		say("tone: THE TONE PLAYED (1 s, 440 Hz, %s dBFS): %u buffers, %u bytes taken by the DSP in %u ms, peak %u of "
+		    "32767, stream volume 8192 (0 dB)\n", tone_amp == TONE_AMP_MAX ? "-40" : "below -40", pieces, TONE_BYTES, ms,
+		    peak);
+	} else {
+		say("tone: FAIL: %s\n", why ? why : "not every buffer was taken back as expected");
+	}
+	tone_fe_close(apps);
+	return played;
+}
+
+/* level D on its own boot-arg: guards, amplifiers ready, C2 set up, C1 + the tone, C2 put back */
+static bool
+audio_tone(struct gchan *apps, uint32_t mode, uint32_t audio, uint32_t smmu)
+{
+	bool c1 = false, played = false;
+	uint32_t amp = TONE_AMP_MAX;
+
+	PE_parse_boot_argn("icetone_amp", &amp, sizeof(amp));
+	mark(M_AUDIO, MARK_BUSY);
+	say("tone: level D (icetone=%u, %s order): 440 Hz for 1 s, 48 kHz, 2 ch x 16 bit, amplitude %u of 32767 (%s), "
+	    "10 ms fades; stream volume %u (Q13; 0 dB = the topology's cap %u); back end 8 x 32 bit TDM; amplifier gain: "
+	    "the board's (tfa9865.c's lists), unchanged\n", mode, mode == 2 ? "Linux's" : "the handover's", amp,
+	    amp == (uint32_t)TONE_AMP_MAX ? "-40.02 dBFS" : amp < (uint32_t)TONE_AMP_MAX ? "below -40 dBFS" :
+	    "ABOVE -40 dBFS", TONE_VOL, TONE_VOL_MAX);
+	if ((mode != 1 && mode != 2) || audio != 1 || smmu != 1) {
+		say("tone: REFUSED: icetone=1 (or 2) runs only with iceaudio=1 and icesmmu=1 (C2, the owner's yes) in the same "
+		    "run: nothing touched\n");
+		mark(M_AUDIO, MARK_FAIL);
+		return false;
+	}
+	if (amp == 0 || amp > (uint32_t)TONE_AMP_MAX || TONE_VOL > TONE_VOL_MAX) {
+		say("tone: REFUSED (GUARD): amplitude %u is above -40 dBFS (at most %d of 32767) or zero, or the volume %u above "
+		    "%u: nothing touched\n", amp, TONE_AMP_MAX, TONE_VOL, TONE_VOL_MAX);
+		mark(M_AUDIO, MARK_FAIL);
+		return false;
+	}
+	tone_amp = (int32_t)amp;
+	snd_args();
+	if (snd_force_tone) {           /* 17t2: the mic's cue beep is level D's plain tone, not the service */
+		snd_wanted = 0;
+		snd_cap = TONE_AMP_MAX;
+	}
+	if (snd_wanted == 1) {
+		say("snd: icesnd=1: level D's path becomes the sound service (stage 3 forced; no tone of its own)\n");
+		tone_stage = 3;
+	}
+	PE_parse_boot_argn("icetone_stage", &tone_stage, sizeof(tone_stage));
+	if (snd_wanted == 1) {
+		tone_stage = 3;
+	}
+	PE_parse_boot_argn("iceamp_clear", &amp_clear_on, sizeof(amp_clear_on));
+	if (tone_stage < 1 || tone_stage > 3) {
+		tone_stage = 3;
+	}
+	say("tone: STAGE %u of 3 (icetone_stage): %s\n", tone_stage, tone_stage == 1 ? "the amplifiers only, up 200 ms and "
+	    "down: no SMMU, no stream graph, no back end, no TDM" : tone_stage == 2 ? "+ C2, the back end and the stream graph "
+	    "with no sample, the amplifiers up 1 s" : "+ the samples (the whole tone)");
+	if (!tone_amps_prepare()) {
+		say("tone: REFUSED: the six amplifiers are not all ready (powered down and muted as found): no SMMU write, no "
+		    "graph\n");
+		mark(M_AUDIO, MARK_FAIL);
+		return false;
+	}
+	if (tone_stage == 1) {
+		bool up, down;
+
+		say("tone: STAGE 1: amplifiers up (no TDM clock: their manager waits)\n");
+		up = tone_amps_power(true);
+		sleep_ms(200);
+		say("tone: STAGE 1: amplifiers down\n");
+		down = tone_amps_power(false);
+		say("tone: STAGE 1 %s: up %s, down %s (no SMMU write, no graph, no back end)\n", up && down ? "PASS" : "FAIL",
+		    up ? "as wanted" : "NOT AS WANTED", down ? "MUTED AND POWERED DOWN" : "NOT ALL CONFIRMED");
+		mark(M_AUDIO, up && down ? MARK_OK : MARK_FAIL);
+		return false;
+	}
+	say("c2: level C2 for level D: option A, SMR 9/10 (icesmmu_smr), our own bank\n");
+	if (!c2_setup()) {
+		say("tone: REFUSED: C2 not set up (nothing written, see the c2 lines): no tone\n");
+		mark(M_AUDIO, MARK_FAIL);
+		return false;
+	}
+	tone_handle = c2_dsp_map(apps);
+	c2_fault_report("after the map");
+	c2_fsr_found = rd(c2.cb + 0x58);
+	if (tone_handle == 0) {
+		c2_teardown();
+		say("tone: REFUSED: the DSP did not map C2's buffer (the SMMU was put back): no tone\n");
+		mark(M_AUDIO, MARK_FAIL);
+		return false;
+	}
+	c1 = audio_c1(apps, mode, &played);
+	c2_fault_report("after the tone");
+	c2_dsp_unmap(apps, tone_handle);
+	c2_teardown();
+	tone_handle = 0;
+	say("tone: level D %s; back end (C1) %s; amplifiers muted and powered down, the graphs closed, the clock released, "
+	    "the pins given back, the SMMU put back\n", played ? "PASS: THE TONE PLAYED" : "FAILED (see \"tone: FAIL\")",
+	    c1 ? "PASS" : "FAILED");
+	mark(M_AUDIO, c1 && played ? MARK_OK : MARK_FAIL);
+	return played;
+}
+
+/*
+ * ---- the ADSP service (boot-arg iceadsp=1): one DSP start shared by sound and the sensors -----------------------------
+ * The kit's levels run once and end; the service keeps the DSP for its clients (hakios_iceland_adsp.h). Its thread, bound
+ * to the highest-numbered processor as the kit's: waits for the first iceadsp_acquire(), starts the DSP as level 6 does
+ * (adsp_reads, adsp_prepare, adsp_start), attaches GLINK with the level-11 routing and FastRPC's intents (IPCRTR 20,
+ * adsp_apps 16, glink_ssr 8, fastrpcglink-apps-dsp 4), says HELLO on IPCRTR and then calls each client's ready(); from
+ * then on it pumps GLINK every 2 ms: NEW_SERVER / DEL_SERVER and data to a registered port go to the client's callbacks,
+ * RESUME_TX is answered, clients' tick() run, FastRPC is served when asked (iceadsp_frpc_serve: bank 8, the sensors PD
+ * attached and kept, apps_std from the root), and every 100 ms the DSP's SMP2P word is read:
+ *   fatal (or GLINK broken)  every client's crashed(), the DSP shut down, banks 8 / 7 back; started again after 1 s while
+ *                            it has users -- after 3 failed starts or crashes it stays down (quarantined) for the boot;
+ *   last release / the run's end (adsp_stop_req)  every client's stop() (messages allowed), DEL_CLIENT for every
+ *                            registered port, 500 ms of pumping, GLINK closed (300 ms), the DSP stopped (dsp_stop), then
+ *                            bank 8, then bank 7. The stop hook (hakios_iceland_adsp_stop) waits for exactly this.
+ * Nothing runs without iceadsp=1, and iceadsp=1 is refused together with icedsp= (the kit owns the DSP then).
+ * iceadsp_test=N (N s, 10..600): a built-in client that acquires, registers for the sensors' service 400, logs what it
+ * hears and releases again -- the service's first tablet check.
+ */
+#define SVC_CLIENTS             8
+#define SVC_REGS                8
+#define SVC_PORT_FIRST          0x4001u         /* (the kit's level 11 uses 0x4000) */
+#define SVC_FAILS_MAX           3
+
+static LCK_GRP_DECLARE(svc_lck_grp, "iceadsp");
+static LCK_MTX_DECLARE(svc_lock, &svc_lck_grp);
+static struct iceadsp_client *svc_client[SVC_CLIENTS];
+static struct iceadsp_client *volatile svc_busy;        /* the client whose callback runs now (release waits for it) */
+static struct {
+	struct iceadsp_client *c;
+	iceadsp_server_t on_server;
+	iceadsp_packet_t on_packet;
+	uint32_t service, resume_node, resume_port;
+	bool replayed, resume_due;
+} svc_reg[SVC_REGS];
+static volatile uint32_t svc_refs;
+static unsigned svc_fails;      /* (starts at 3 - iceadsp_tries: no static more in __DATA, which is at its limit) */
+static bool svc_enabled, svc_ready, svc_quarantined, svc_frpc_wanted, svc_frpc_done;
+static thread_t svc_thread;
+static char svc_frpc_root[96];
+
+int
+iceadsp_acquire(struct iceadsp_client *c)
+{
+	unsigned i, slot = SVC_CLIENTS;
+	int r = 0;
+
+	if (!svc_enabled || c == NULL) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&svc_lock);
+	for (i = 0; i < SVC_CLIENTS && svc_client[i] != c; i++) {
+		if (svc_client[i] == NULL && slot == SVC_CLIENTS) {
+			slot = i;
+		}
+	}
+	if (adsp_stop_req || svc_quarantined) {
+		r = EBUSY;
+	} else if (i < SVC_CLIENTS) {
+		r = EALREADY;
+	} else if (slot == SVC_CLIENTS) {
+		r = ENOSPC;
+	} else {
+		c->is_ready = false;
+		svc_client[slot] = c;
+		svc_refs++;
+	}
+	lck_mtx_unlock(&svc_lock);
+	say("service: %s %s (%u users)\n", c->name, r == 0 ? "acquired the DSP" : r == EBUSY ? "REFUSED (stopping or "
+	    "quarantined)" : r == EALREADY ? "had it already" : "REFUSED (no room)", svc_refs);
+	return r == EALREADY ? 0 : r;
+}
+
+void
+iceadsp_release(struct iceadsp_client *c)
+{
+	bool had = false;
+
+	lck_mtx_lock(&svc_lock);
+	for (unsigned i = 0; i < SVC_CLIENTS; i++) {
+		if (svc_client[i] == c) {
+			svc_client[i] = NULL;
+			svc_refs--;
+			had = true;
+		}
+	}
+	for (unsigned i = 0; i < SVC_REGS; i++) {
+		if (svc_reg[i].c == c) {
+			bzero(&svc_reg[i], sizeof(svc_reg[i]));
+		}
+	}
+	lck_mtx_unlock(&svc_lock);
+	while (svc_busy == c && current_thread() != svc_thread) {
+		sleep_ms(1);
+	}
+	if (had) {
+		say("service: %s released the DSP (%u users)\n", c->name, svc_refs);
+	}
+}
+
+int
+iceadsp_qrtr_register(struct iceadsp_client *c, uint32_t service, iceadsp_server_t on_server, iceadsp_packet_t on_packet,
+    uint32_t *our_port)
+{
+	int r = ENOSPC;
+
+	if (!svc_enabled) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&svc_lock);
+	for (unsigned i = 0; i < SVC_REGS; i++) {
+		if (svc_reg[i].c == NULL) {
+			bzero(&svc_reg[i], sizeof(svc_reg[i]));
+			svc_reg[i].c = c;
+			svc_reg[i].service = service;
+			svc_reg[i].on_server = on_server;
+			svc_reg[i].on_packet = on_packet;
+			*our_port = SVC_PORT_FIRST + i;
+			r = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(&svc_lock);
+	say("service: %s: QRTR service %u %s\n", c->name, service, r ? "NOT registered (no room)" : "registered");
+	return r;
+}
+
+bool
+iceadsp_qrtr_send(uint32_t our_port, uint32_t node, uint32_t port, const void *buf, uint32_t len)
+{
+	static bool told;
+
+	if (current_thread() != svc_thread || q_ch == NULL || our_port < SVC_PORT_FIRST ||
+	    our_port >= SVC_PORT_FIRST + SVC_REGS) {
+		if (!told) {
+			told = true;
+			say("service: a QRTR send from outside the pump's callbacks (or before ready): refused\n");
+		}
+		return false;
+	}
+	return qrtr_send(QRTR_TYPE_DATA, our_port, node, port, buf, len);
+}
+
+int
+iceadsp_frpc_serve(struct iceadsp_client *c, const char *root)
+{
+	if (!svc_enabled) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&svc_lock);
+	strlcpy(svc_frpc_root, root != NULL ? root : frpc_root, sizeof(svc_frpc_root));
+	svc_frpc_wanted = true;
+	svc_frpc_done = false;
+	lck_mtx_unlock(&svc_lock);
+	say("service: %s asks for FastRPC (the sensors PD, files from %s)\n", c->name, svc_frpc_root);
+	return 0;
+}
+
+/* the client in slot i, marked busy while its callback runs (NULL: none) */
+static struct iceadsp_client *
+svc_take(unsigned i)
+{
+	struct iceadsp_client *c;
+
+	lck_mtx_lock(&svc_lock);
+	c = svc_client[i];
+	svc_busy = c;
+	lck_mtx_unlock(&svc_lock);
+	return c;
+}
+
+static void
+svc_server(uint32_t service, uint32_t instance, uint32_t node, uint32_t port, bool gone)
+{
+	for (unsigned i = 0; svc_enabled && i < SVC_REGS; i++) {
+		struct iceadsp_client *c;
+		iceadsp_server_t fn;
+
+		lck_mtx_lock(&svc_lock);
+		c = svc_reg[i].c;
+		fn = svc_reg[i].service == service ? svc_reg[i].on_server : NULL;
+		svc_busy = fn != NULL ? c : NULL;
+		lck_mtx_unlock(&svc_lock);
+		if (fn != NULL) {
+			fn(c, service, instance, node, port, gone);
+		}
+		svc_busy = NULL;
+	}
+}
+
+static bool
+svc_packet(uint32_t node, uint32_t port, uint32_t dst_port, const uint8_t *data, uint32_t len, bool confirm)
+{
+	unsigned i = dst_port - SVC_PORT_FIRST;
+	struct iceadsp_client *c;
+	iceadsp_packet_t fn;
+
+	if (!svc_enabled || dst_port < SVC_PORT_FIRST || i >= SVC_REGS) {
+		return false;
+	}
+	lck_mtx_lock(&svc_lock);
+	c = svc_reg[i].c;
+	fn = svc_reg[i].on_packet;
+	if (c != NULL && confirm) {
+		svc_reg[i].resume_due = true;   /* (answered from the pump's loop, not from inside the pump) */
+		svc_reg[i].resume_node = node;
+		svc_reg[i].resume_port = port;
+	}
+	svc_busy = fn != NULL ? c : NULL;
+	lck_mtx_unlock(&svc_lock);
+	if (c == NULL) {
+		say("service: QRTR data for port %#x, which nobody holds: dropped\n", dst_port);
+	} else if (fn != NULL) {
+		fn(c, node, port, data, len);
+	}
+	svc_busy = NULL;
+	return true;
+}
+
+/* the link's state back to a new DSP's (after a crash, before the next attach) */
+static void
+svc_link_reset(void)
+{
+	g_desc = g_tx = g_tx_size = g_rx = g_rx_size = 0;
+	g_features = G_FEATURE_INTENT_REUSE;
+	g_heard = g_said = 0;
+	g_next_lcid = 1;
+	g_agreed = g_broken = g_closing = false;
+	bzero(g_chan, sizeof(g_chan));
+	g_nchan = 0;
+	bzero(g_rxi, sizeof(g_rxi));
+	q_remote = QRTR_NODE_BCAST;
+	q_packets = 0;
+	q_hello_heard = q_hello_sent = false;
+	bzero(q_srv, sizeof(q_srv));
+	q_nsrv = 0;
+	q_ch = NULL;
+	svc_ready = false;
+	g_svc_quiet = false;
+}
+
+/* a control packet {type, our node, port} from our port to the DSP's control port (RESUME_TX, DEL_CLIENT) */
+static void
+svc_ctrl(uint32_t type, uint32_t our_port, uint32_t node, uint32_t port)
+{
+	uint32_t pkt[5] = { type, QRTR_OUR_NODE, our_port, 0, 0 };
+
+	(void)qrtr_send(type, our_port, node, port, pkt, sizeof(pkt));
+}
+
+static void
+svc_pump_for(uint32_t ms)
+{
+	for (uint64_t t0 = now_us(); now_us() - t0 < ms * 1000ull && !g_broken;) {
+		g_pump();
+		sleep_ms(2);
+	}
+}
+
+/* the stop (last release or the run's end): clients, their ports, GLINK, then the DSP and the banks */
+static void
+svc_down(bool crashed)
+{
+	uint64_t t0 = now_us();
+
+	for (unsigned i = 0; i < SVC_CLIENTS; i++) {
+		struct iceadsp_client *c = svc_take(i);
+
+		if (c != NULL && c->is_ready && !crashed && c->stop != NULL) {
+			c->stop(c);
+		} else if (c != NULL && crashed && c->crashed != NULL) {
+			c->crashed(c);
+		}
+		if (c != NULL) {
+			c->is_ready = false;
+		}
+		svc_busy = NULL;
+	}
+	if (!crashed && q_ch != NULL && !g_broken) {
+		for (unsigned i = 0; i < SVC_REGS; i++) {
+			if (svc_reg[i].c != NULL) {
+				svc_ctrl(QRTR_TYPE_DEL_CLIENT, SVC_PORT_FIRST + i, q_remote, QRTR_PORT_CTRL);
+			}
+		}
+		while (now_us() - t0 < 500000ull && !g_broken) {
+			g_pump();
+			sleep_ms(2);
+		}
+		g_closing = true;
+		for (unsigned i = 0; i < g_nchan; i++) {
+			if (g_chan[i].lcid != 0 && !g_chan[i].close_acked) {
+				(void)g_send(GC_CLOSE, g_chan[i].lcid, 0, NULL, 0);
+			}
+		}
+		svc_pump_for(300);
+	}
+	svc_ready = false;
+	q_ch = NULL;
+	dsp_stop();
+	banks_down();
+	finish(!crashed);
+	svc_frpc_done = false;          /* (done again after a restart) */
+}
+
+/*
+ * the ready part of a life (svc_life's loop body, moved here unchanged by laneD so the share runs the same code): each
+ * client's ready / tick, each registration's replay of the services already known and its RESUME_TX, the FastRPC turn
+ */
+static void
+svc_serve(void)
+{
+	for (unsigned i = 0; i < SVC_CLIENTS; i++) {
+		struct iceadsp_client *c = svc_take(i);
+
+		if (c != NULL && !c->is_ready) {
+			c->is_ready = true;
+			if (c->ready != NULL) {
+				c->ready(c);
+			}
+		} else if (c != NULL && c->tick != NULL) {
+			c->tick(c);
+		}
+		svc_busy = NULL;
+	}
+	for (unsigned i = 0; i < SVC_REGS; i++) {
+		uint32_t service = svc_reg[i].service;
+
+		if (svc_reg[i].c != NULL && !svc_reg[i].replayed) {
+			svc_reg[i].replayed = true;
+			for (unsigned k = 0; k < q_nsrv; k++) {
+				if (q_srv[k].service == service && !q_srv[k].gone && svc_reg[i].on_server != NULL &&
+				    svc_reg[i].c != NULL) {
+					svc_busy = svc_reg[i].c;
+					svc_reg[i].on_server(svc_reg[i].c, service, q_srv[k].instance, q_srv[k].node,
+					    q_srv[k].port, false);
+					svc_busy = NULL;
+				}
+			}
+		}
+		if (svc_reg[i].c != NULL && svc_reg[i].resume_due) {
+			svc_reg[i].resume_due = false;
+			svc_ctrl(QRTR_TYPE_RESUME_TX, SVC_PORT_FIRST + i, svc_reg[i].resume_node, svc_reg[i].resume_port);
+		}
+	}
+	if (svc_frpc_wanted && !svc_frpc_done) {
+		svc_frpc_done = true;
+		strlcpy(frpc_root, svc_frpc_root, sizeof(frpc_root));
+		frpc_serve_forced = frpc_keep_forced = true;
+		(void)frpc_level_22a(3);
+	}
+}
+
+/*
+ * ---- laneD: iceadsp_share=1 (or iceld=<ids> holding '2'), OFF by default ----------------------------------------------
+ * 0z96 / 0z123: the sensors' service (iceadsp=1) was REFUSED beside the audio kit (icedsp=10), each wanting the DSP as
+ * its own, so the light sensor and the rotation stayed off the installed line. With the share, the kit's thread keeps
+ * the one DSP and its GLINK, and the service's clients ride on it: no second start, no second thread. The kit's loops
+ * (glink_listen, and the sound service's when it runs) call svc_shared_poll after their pump: once QRTR's HELLO is out,
+ * the service is READY on the kit's IPCRTR channel and the same svc_serve() as the service's own life runs (clients'
+ * ready / tick, replays, RESUME_TX, FastRPC's sensors PD on bank 8 beside audio's bank 7). The kit's GLINK stays up until
+ * the run's end instead of its 30 s look (icedsp_hold no longer stops the DSP), and at the end the clients are stopped
+ * (or told of a crash) before GLINK closes. Not with icemic (its capture service and FastRPC are kept apart, as icefrpc).
+ * The share's flag is a bit of svc_fails: no new __DATA (at its limit), and svc_main never runs while it is set.
+ */
+#define SVC_SHARED_BIT          0x80000000u
+#define SVC_SHARED              ((svc_fails & SVC_SHARED_BIT) != 0)
+
+int
+iceadsp_share_on(void)
+{
+	uint32_t v = 0;
+
+	if (!PE_parse_boot_argn("iceadsp_share", &v, sizeof(v))) {
+		v = PE_iceland_laned('2') ? 1 : 0;
+	}
+	return v != 0;
+}
+
+static bool
+svc_shared(void)
+{
+	return SVC_SHARED;
+}
+
+static void
+svc_shared_init(uint32_t kit)
+{
+	svc_fails |= SVC_SHARED_BIT;
+	strlcpy(svc_frpc_root, frpc_root, sizeof(svc_frpc_root));
+	svc_frpc_wanted = true;         /* the sensors PD before the sound service (its one-off FastRPC turn blocks) */
+	svc_frpc_done = false;
+	svc_enabled = true;
+	say("service: SHARED with the audio kit (iceadsp_share, icedsp=%u): clients ride its DSP once QRTR is up; FastRPC's "
+	    "sensors PD first\n", kit);
+}
+
+/* with icemic (its capture service): no FastRPC turn, as icefrpc refuses beside it; the clients ride QRTR only */
+static void
+svc_shared_no_frpc(void)
+{
+	if (SVC_SHARED && !svc_frpc_done) {
+		svc_frpc_done = true;
+		say("service: SHARED: no FastRPC beside icemic (as icefrpc): the clients ride QRTR only\n");
+	}
+}
+
+static void
+svc_shared_poll(struct gchan *ipcrtr)
+{
+	if (!SVC_SHARED || adsp_stop_req || g_broken) {
+		return;
+	}
+	if (!svc_ready) {
+		for (unsigned i = 0; ipcrtr == NULL && i < g_nchan; i++) {     /* (from the sound service's loop) */
+			if (strcmp(g_chan[i].name, "IPCRTR") == 0 && g_chan[i].offered && !g_chan[i].closed) {
+				ipcrtr = &g_chan[i];
+			}
+		}
+		if (ipcrtr == NULL || !q_hello_sent) {
+			return;
+		}
+		q_ch = ipcrtr;
+		svc_thread = current_thread();
+		svc_ready = true;
+		say("service: READY (SHARED): the audio kit's GLINK, IPCRTR open, HELLO sent (the DSP is node %#x); %u user(s)\n",
+		    q_remote, svc_refs);
+	}
+	svc_serve();
+}
+
+static void
+svc_shared_end(bool crashed)
+{
+	uint64_t t0 = now_us();
+
+	if (!SVC_SHARED || !svc_ready) {
+		return;
+	}
+	for (unsigned i = 0; i < SVC_CLIENTS; i++) {
+		struct iceadsp_client *c = svc_take(i);
+
+		if (c != NULL && c->is_ready && !crashed && c->stop != NULL) {
+			c->stop(c);
+		} else if (c != NULL && crashed && c->crashed != NULL) {
+			c->crashed(c);
+		}
+		if (c != NULL) {
+			c->is_ready = false;
+		}
+		svc_busy = NULL;
+	}
+	if (!crashed && q_ch != NULL && !g_broken) {
+		for (unsigned i = 0; i < SVC_REGS; i++) {
+			if (svc_reg[i].c != NULL) {
+				svc_ctrl(QRTR_TYPE_DEL_CLIENT, SVC_PORT_FIRST + i, q_remote, QRTR_PORT_CTRL);
+			}
+		}
+		while (now_us() - t0 < 300000ull && !g_broken) {
+			g_pump();
+			sleep_ms(2);
+		}
+	}
+	svc_ready = false;
+	q_ch = NULL;
+	say("service: SHARED: %s\n", crashed ? "the DSP went down: the clients were told" :
+	    "the run ends: the clients stopped, their ports given back");
+}
+
+/* one life of the DSP: 0 stopped (last release or the run's end), 1 crashed */
+static int
+svc_life(void)
+{
+	struct gchan *ipcrtr = NULL;
+	uint64_t hello_wait = 0, checked = now_us();
+
+	svc_link_reset();
+	g_level = 11;
+	g_wanted[0].intents = 20;       /* IPCRTR 20, adsp_apps 16, glink_ssr 8, FastRPC 4: the 48 intents */
+	g_wanted[3].intents = 4;
+	if (!g_attach()) {
+		svc_down(true);
+		return 1;
+	}
+	while (!adsp_stop_req && svc_refs != 0) {
+		g_pump();
+		if (g_broken) {
+			say("service: GLINK broke: taken as a crash\n");
+			svc_down(true);
+			return 1;
+		}
+		if (ipcrtr == NULL) {
+			for (unsigned i = 0; i < g_nchan; i++) {
+				if (strcmp(g_chan[i].name, "IPCRTR") == 0 && g_chan[i].offered && !g_chan[i].closed) {
+					ipcrtr = &g_chan[i];
+					hello_wait = now_us();
+				}
+			}
+		}
+		if (ipcrtr != NULL && !q_hello_sent && (q_hello_heard || now_us() - hello_wait > 200000ull)) {
+			if (!qrtr_hello(ipcrtr)) {
+				q_hello_sent = true;    /* (tried once) */
+			}
+		}
+		if (!svc_ready && ipcrtr != NULL && q_hello_sent) {
+			q_ch = ipcrtr;
+			svc_ready = true;
+			say("service: READY: GLINK up, IPCRTR open, HELLO sent (the DSP is node %#x)\n", q_remote);
+			{
+				uint32_t keep_chat = 0;
+
+				PE_parse_boot_argn("iceadsp_chat", &keep_chat, sizeof(keep_chat));
+				g_svc_quiet = keep_chat == 0;   /* (the per-message GLINK / QRTR lines end here) */
+			}
+		}
+		if (svc_ready) {
+			svc_serve();
+		}
+		if (now_us() - checked > 100000ull) {
+			struct smp2p w;
+
+			checked = now_us();
+			if (their_words(&w) && (slave_kernel(&w) & DSP_FATAL)) {
+				say("service: THE ADSP HAS GIVEN UP\n");
+				crash_reason();
+				svc_down(true);
+				return 1;
+			}
+		}
+		sleep_ms(2);
+	}
+	say("service: %s: stopping the DSP\n", adsp_stop_req ? "the run ends" : "no users left");
+	svc_down(false);
+	return 0;
+}
+
+/* a start as level 6's; false: the DSP is not up (everything given back) */
+static bool
+svc_start(void)
+{
+	int st;
+
+	image_done(&main_image);
+	image_done(&dtb_image);
+	if (!image_find(&dtb_image) || !image_find(&main_image)) {
+		say("service: an image is missing: the DSP stays down (nothing touched)\n");
+		return false;
+	}
+	if (psci_smp_hvc) {
+		say("service: PSCI is over hvc here: QEMU, not the Pad: the DSP's blocks are not touched\n");
+		return false;
+	}
+	if (!adsp_reads() || !adsp_prepare(true)) {
+		finish(false);
+		return false;
+	}
+	st = adsp_start(true);
+	if (st < 0) {
+		finish(false);
+		return false;
+	}
+	if (st == 0) {
+		dsp_stop();
+		finish(false);
+		return false;
+	}
+	image_done(&main_image);        /* (both authenticated: the metadata pages are no longer TrustZone's) */
+	image_done(&dtb_image);
+	return true;
+}
+
+static void
+svc_main(__unused void *parameter, __unused wait_result_t result)
+{
+	int last = ml_get_max_cpu_number();
+
+	svc_thread = current_thread();
+	if (last > 0 && cpu_to_processor(last) != PROCESSOR_NULL) {
+		thread_bind(cpu_to_processor(last));
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	say("service: up on cpu %d, waiting for the first user\n", cpu_number());
+	while (!adsp_stop_req) {
+		bool failed;
+
+		if (svc_refs == 0 || svc_quarantined) {
+			sleep_ms(20);
+			continue;
+		}
+		say("service: starting the DSP for %u user(s)\n", svc_refs);
+		failed = !svc_start() || svc_life() != 0;
+		if (failed && ++svc_fails >= SVC_FAILS_MAX) {
+			svc_quarantined = true;
+			say("service: the last allowed start failed or crashed (iceadsp_tries): the DSP stays down for this boot "
+			    "(quarantined)\n");
+		} else if (failed) {
+			for (int i = 0; i < 50 && !adsp_stop_req; i++) {
+				sleep_ms(20);           /* 1 s before the next start */
+			}
+		}
+	}
+	adsp_thread_live = 0;
+}
+
+/* ---- iceadsp_test=N: a built-in client (the service's first check) ---- */
+static struct iceadsp_client svc_test;
+static uint32_t svc_test_port;
+static unsigned svc_test_servers, svc_test_packets, svc_test_ticks;
+
+static void
+svc_test_ready(struct iceadsp_client *c)
+{
+	say("service test: %s: ready (%u QRTR services known)\n", c->name, q_nsrv);
+}
+
+static void
+svc_test_tick(__unused struct iceadsp_client *c)
+{
+	svc_test_ticks++;
+}
+
+static void
+svc_test_stop(struct iceadsp_client *c)
+{
+	say("service test: %s: stop (%u servers, %u packets, %u ticks)\n", c->name, svc_test_servers, svc_test_packets,
+	    svc_test_ticks);
+}
+
+static void
+svc_test_crashed(struct iceadsp_client *c)
+{
+	say("service test: %s: the DSP crashed\n", c->name);
+}
+
+static void
+svc_test_server(__unused struct iceadsp_client *c, uint32_t service, uint32_t instance, uint32_t node, uint32_t port,
+    bool gone)
+{
+	svc_test_servers++;
+	say("service test: service %u instance %#x at %u:%u %s\n", service, instance, node, port, gone ? "gone" : "there");
+}
+
+static void
+svc_test_packet(__unused struct iceadsp_client *c, uint32_t node, uint32_t port, __unused const uint8_t *data,
+    uint32_t len)
+{
+	svc_test_packets++;
+	say("service test: %u bytes from %u:%u\n", len, node, port);
+}
+
+static void
+svc_test_main(void *parameter, __unused wait_result_t result)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)parameter;
+
+	svc_test.name = "iceadsp_test";
+	svc_test.ready = svc_test_ready;
+	svc_test.tick = svc_test_tick;
+	svc_test.stop = svc_test_stop;
+	svc_test.crashed = svc_test_crashed;
+	sleep_ms(3000);
+	if (iceadsp_acquire(&svc_test) != 0) {
+		return;
+	}
+	(void)iceadsp_qrtr_register(&svc_test, SSC_QMI_SERVICE, svc_test_server, svc_test_packet, &svc_test_port);
+	for (uint32_t ms = 0; ms < secs * 1000 && !adsp_stop_req; ms += 50) {
+		sleep_ms(50);
+	}
+	if (!adsp_stop_req) {
+		iceadsp_release(&svc_test);
+	}
+}
+
+/*
+ * iceadsp_pack_test=1: the pack's entries unpacked and checked, and the tar's members counted, in memory only -- no
+ * register, no TrustZone, nothing of the DSP (QEMU's check of a pack-linked kernel).
+ */
+static void
+adsp_pack_test(__unused void *parameter, __unused wait_result_t result)
+{
+	static const char *const names[] = { "adsp_dtb.mbn", "adsp.mbn", "sensors.tar" };
+	const uint8_t *p, *tar = NULL;
+	uint64_t n, tlen = 0, at = 0;
+	unsigned members = 0;
+
+	if (adsp_pack == NULL) {
+		say("pack test: no pack in this kernel (or not kept): nothing touched\n");
+		return;
+	}
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		bool ok = adsp_pack_entry(names[i], &p, &n);
+
+		say("pack test: %s: %s (%llu B)\n", names[i], ok ? "OK" : "MISSING OR BAD", ok ? n : 0);
+		if (ok && i == 2) {
+			tar = p;
+			tlen = n;
+		}
+	}
+	while (tar != NULL && at + 512 <= tlen && tar[at] != 0) {
+		uint64_t size = 0;
+
+		for (int k = 124; k < 136 && tar[at + k] >= '0' && tar[at + k] <= '7'; k++) {
+			size = size * 8 + (uint64_t)(tar[at + k] - '0');
+		}
+		members++;
+		at += 512 + ((size + 511) & ~511ull);
+	}
+	say("pack test: sensors.tar holds %u members; sensors/sns_reg.conf %s\n", members,
+	    adsp_pack_tar_member("sensors/sns_reg.conf", &p, &n) ? "found" : "not found");
+}
+
+static void
+svc_init(void)
+{
+	uint32_t test = 0, tries = SVC_FAILS_MAX;
+	thread_t thread;
+
+	PE_parse_boot_argn("iceadsp_tries", &tries, sizeof(tries));
+	svc_fails = SVC_FAILS_MAX - (tries < 1 ? 1 : tries > SVC_FAILS_MAX ? SVC_FAILS_MAX : tries);
+	svc_enabled = true;
+	adsp_used = 1;
+	adsp_thread_live = 1;
+	if (kernel_thread_start(svc_main, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		adsp_thread_live = 0;
+		svc_enabled = false;
+		return;
+	}
+	if (PE_parse_boot_argn("iceadsp_test", &test, sizeof(test)) && test != 0) {
+		test = test < 10 ? 10 : test > 600 ? 600 : test;
+		if (kernel_thread_start(svc_test_main, (void *)(uintptr_t)test, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+
+void
+hakios_iceland_adsp_init(void)
+{
+	uint32_t stage = 0, marks_wanted = 1, amp = 0;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("iceamp", &amp, sizeof(amp)) && amp != 0) {
+		amp_thread_busy = true;
+		if (kernel_thread_start(iceamp_thread, (void *)(uintptr_t)(amp > 2 ? 2 : amp), &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			amp_thread_busy = false;
+		}
+	}
+	{
+		uint32_t svc = 0, kit = 0, pt = 0;
+
+		if (PE_parse_boot_argn("iceadsp_pack_test", &pt, sizeof(pt)) && pt != 0 &&
+		    kernel_thread_start(adsp_pack_test, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+		bool share = iceadsp_share_on() != 0;
+
+		if ((PE_parse_boot_argn("iceadsp", &svc, sizeof(svc)) && svc != 0) || share) {
+			if (PE_parse_boot_argn("icedsp", &kit, sizeof(kit)) && kit != 0 && share) {
+				svc_shared_init(kit);   /* laneD: the kit below keeps the DSP; the clients ride on it */
+			} else if (PE_parse_boot_argn("icedsp", &kit, sizeof(kit)) && kit != 0) {
+				say("service: REFUSED: iceadsp=%u together with icedsp=%u (the kit's levels own the DSP): not started\n",
+				    svc, kit);
+			} else {
+				svc_init();
+				return;
+			}
+		}
+	}
+	if (!PE_parse_boot_argn("icedsp", &stage, sizeof(stage)) || stage == 0) {
+		uint32_t lux_test = 0;
+
+		if (PE_parse_boot_argn("icelux_test", &lux_test, sizeof(lux_test)) && lux_test != 0) {
+			lux_selftest(lux_test);         /* (the light's receive path on made-up packets: no hardware) */
+		}
+		if (PE_parse_boot_argn("icemic", &amp, sizeof(amp)) && amp != 0) {
+			mic("E REFUSED: icemic=%u needs icedsp=10 (GPR / PRM up): nothing touched\n", amp);
+		}
+		return;
+	}
+	if (stage > 11) {
+		stage = 11;
+	}
+	PE_parse_boot_argn("icedsp_marks", &marks_wanted, sizeof(marks_wanted));
+	marks_on = marks_wanted != 0;
+	if (marks_on && kernel_thread_start(mark_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	adsp_used = 1;
+	adsp_thread_live = 1;
+	if (kernel_thread_start(icedsp_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		adsp_thread_live = 0;
+	}
+}
diff --git a/bsd/dev/hakios_iceland_adsp.h b/bsd/dev/hakios_iceland_adsp.h
new file mode 100644
index 0000000000000000000000000000000000000000..fa4e042b2c8fd6b4954c271277992840ddc8170f
--- /dev/null
+++ b/bsd/dev/hakios_iceland_adsp.h
@@ -0,0 +1,77 @@
+/*
+ * The OnePlus Pad 4's (iceland) audio DSP as a shared platform layer for sound and the sensors
+ * (bsd/dev/hakios_iceland_adsp.c).
+ */
+#ifndef _HAKIOS_ICELAND_ADSP_H_
+#define _HAKIOS_ICELAND_ADSP_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/*
+ * The one source of every file the layer takes from outside the kernel: "adsp.mbn", "adsp_dtb.mbn" (today from
+ * /chosen), later the sensor tree's files. *ptr stays valid for the whole boot. false: not there.
+ */
+bool iceadsp_image(const char *name, const uint8_t **ptr, uint64_t *len);
+
+/*
+ * The run's end. _stop: from a thread (reset-after, loader_return_after, "xl stop"): the DSP's clients stop, GLINK
+ * closes, the DSP is shut down, then the apps-SMMU banks 8 and 7. _quiesce: from loader_return (a panic's end, A3),
+ * before U-Boot's UFS slot is given back and before pcie_quiesce, with a panic's rules (no message, no sleep, no lock
+ * waited for). Both do nothing without icedsp= / iceadsp=.
+ */
+void hakios_iceland_adsp_stop(void);
+void hakios_iceland_adsp_quiesce(void);
+
+/*
+ * ---- the ADSP service (boot-arg iceadsp=1; refused together with the kit's icedsp=) ---------------------------------
+ * One DSP start shared by every client (sound, the sensors), reference counted: the first iceadsp_acquire() starts it
+ * (PAS, GLINK, the IPC router), the last iceadsp_release() stops it (clients, GLINK, PAS shutdown, banks 8 / 7). One
+ * long-lived thread pumps GLINK; every callback runs on that thread, and iceadsp_qrtr_send() is accepted only there.
+ * The client structure stays valid until iceadsp_release() returns (release waits for a callback in progress).
+ */
+struct iceadsp_client {
+	const char *name;
+	void (*ready)(struct iceadsp_client *c);        /* GLINK up, IPCRTR open, HELLO exchanged (again after a restart) */
+	void (*tick)(struct iceadsp_client *c);         /* every pass of the pump (2-10 ms) while ready: state machines */
+	void (*stop)(struct iceadsp_client *c);         /* the stop: messages allowed; 500 ms for all clients together */
+	void (*crashed)(struct iceadsp_client *c);      /* the DSP went down by itself: look up again after ready */
+	bool is_ready;                                  /* (the layer's) */
+};
+typedef void (*iceadsp_server_t)(struct iceadsp_client *c, uint32_t service, uint32_t instance, uint32_t node,
+    uint32_t port, bool gone);
+typedef void (*iceadsp_packet_t)(struct iceadsp_client *c, uint32_t node, uint32_t port, const uint8_t *data,
+    uint32_t len);
+
+int iceadsp_acquire(struct iceadsp_client *c);         /* 0; ENODEV (no service), EBUSY (stopping / quarantined), ENOSPC */
+void iceadsp_release(struct iceadsp_client *c);
+/*
+ * A QRTR client port of c's for service (QMI service id): on_server for every NEW_SERVER / DEL_SERVER of it (also
+ * those heard before the registration), on_packet for every data packet to the port (RESUME_TX is the layer's).
+ * The port goes when c is released; the layer sends DEL_CLIENT for it at the stop.
+ */
+int iceadsp_qrtr_register(struct iceadsp_client *c, uint32_t service, iceadsp_server_t on_server,
+    iceadsp_packet_t on_packet, uint32_t *our_port);
+bool iceadsp_qrtr_send(uint32_t our_port, uint32_t node, uint32_t port, const void *buf, uint32_t len);
+/*
+ * The layer's FastRPC: bank 8 (SMR 11/12, inside the UFS census), "fastrpcglink-apps-dsp", the sensors PD attached and
+ * kept, and its apps_std calls served read-only from root (NULL: icefrpc_root's default) -- files iceadsp_image()
+ * knows first, then the volume. Done once the DSP is ready (again after a restart).
+ */
+int iceadsp_frpc_serve(struct iceadsp_client *c, const char *root);
+
+/*
+ * The sensors client's samples (hakios_iceland_sensors.c) into this file's sysctls: kern.iceaccel_x/_y/_z/_seq (mm/s2)
+ * and kern.icelux/_acc/_seq (milli-lux). _test_read: the accelerometer's z (0) or the light (1), for icesns_test.
+ */
+void iceadsp_sns_accel(int x, int y, int z);
+void iceadsp_sns_lux(int mlux, int accuracy);
+int iceadsp_sns_test_read(int what);
+
+/*
+ * laneD: iceadsp_share=1 (or the lane's umbrella iceld=<ids> holding '2'): the service's clients ride the audio kit's
+ * running DSP (icedsp=10) instead of being refused beside it; alone (no icedsp=) it is iceadsp=1. 0 = off (install65).
+ */
+int iceadsp_share_on(void);
+
+#endif /* _HAKIOS_ICELAND_ADSP_H_ */
diff --git a/bsd/dev/hakios_iceland_amp.c b/bsd/dev/hakios_iceland_amp.c
new file mode 100644
index 0000000000000000000000000000000000000000..c4fb37eede0f9e815194564a195c3a35185f3082
--- /dev/null
+++ b/bsd/dev/hakios_iceland_amp.c
@@ -0,0 +1,111 @@
+/*
+ * Kit 20aa (its own kernel tree): the Pad 4's CPUs as two clusters, Apple's Edge scheduler, and a small performance
+ * controller that puts UI work on the two prime cores.
+ *
+ * The board config (BCM2837 here) says MAX_CPU_CLUSTERS 2 / __ARM_AMP__, so osfmk/kern/sched.h turns on
+ * CONFIG_SCHED_EDGE (Clutch + Edge); the cpu nodes' cluster-type is "E" for the six Oryon-M cores (MPIDR Aff2 0) and "P"
+ * for the prime pair (Aff2 1) - from a LOADER_AMP loader (20aa) or, without the property, from ml_parse_cpu_topology's
+ * Aff2 fallback (20aa2, osfmk/arm64/machine_routines.c) - which makes clusters 0 (E, the boot cluster) and 1 (P).
+ *
+ * Edge leaves placement to the performance controller (Apple's CLPC): without one every thread group prefers the boot
+ * cluster and nothing runs on P. After data-a-live's patch 0320 (APSL-2.0, same SoC, xnu-8796: "P-spill" through
+ * sched_perfcontrol_thread_group_recommend) and UniXNU's zzyf-sheng-amp (BSD-2-Clause-Patent: UI threads on the P
+ * cluster) - written here for xnu-12377, where that call panics under Edge and the interface is
+ * sched_perfcontrol_thread_group_preferred_clusters_set(): every thread group prefers P for its fixed-priority, UI,
+ * user-initiated and default work; utility and background work prefer E. Registering resyncs the groups that already
+ * exist (thread_group_resync). The governor's two domains (hakios_iceland_cpu.c, "icecpu: governor: d0 .. d1 ..") are
+ * the two clusters, so its 2 s line shows where the work went; this file adds "iceclu:" lines.
+ *
+ * Boot-arg iceclu=1 (default 0: no controller, Edge defaults - everything on E). Kernels scan20aa and scan39 (20aa2).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/kern_types.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <arm/machine_routines.h>
+
+#define say(...) printf("iceclu: " __VA_ARGS__)
+
+extern void IOSleep(unsigned int milliseconds);
+static uint32_t amp_e = UINT32_MAX, amp_p = UINT32_MAX;
+static uint64_t amp_groups;
+
+static void
+amp_tg_init(thread_group_data_t data)
+{
+	uint32_t overrides[PERFCONTROL_CLASS_MAX];
+
+	if (data == NULL || data->thread_group_data == NULL || amp_p == UINT32_MAX) {
+		return;
+	}
+	for (int i = 0; i < PERFCONTROL_CLASS_MAX; i++) {
+		overrides[i] = SCHED_PERFCONTROL_PREFERRED_CLUSTER_OVERRIDE_NONE;
+	}
+	overrides[PERFCONTROL_CLASS_UTILITY] = amp_e;
+	overrides[PERFCONTROL_CLASS_BACKGROUND] = amp_e;
+	sched_perfcontrol_thread_group_preferred_clusters_set(data->thread_group_data, amp_p, overrides, 0);
+	__atomic_fetch_add(&amp_groups, 1, __ATOMIC_RELAXED);
+}
+
+static struct sched_perfcontrol_callbacks amp_callbacks = {
+	.version = SCHED_PERFCONTROL_CALLBACKS_VERSION_3,       /* up to thread_group_deinit: the init callback is what we want */
+	.thread_group_init = amp_tg_init,
+};
+
+static void
+amp_thread(void *arg __unused, wait_result_t w __unused)
+{
+	const ml_topology_info_t *t = ml_get_topology_info();
+
+	if (t == NULL) {
+		say("no topology\n");
+		return;
+	}
+	say("%u cpus in %u clusters (types mask %#x, boot cluster %u)\n", t->num_cpus, t->num_clusters, t->cluster_types,
+	    t->boot_cluster != NULL ? t->boot_cluster->cluster_id : UINT32_MAX);
+	for (unsigned i = 0; i < t->num_clusters; i++) {
+		const ml_topology_cluster_t *c = &t->clusters[i];
+
+		say("cluster %u: type %u (1 E, 2 P), cpus mask %#llx, first cpu %u\n", c->cluster_id, (unsigned)c->cluster_type,
+		    (unsigned long long)c->cpu_mask, c->first_cpu_id);
+		if (c->cluster_type == CLUSTER_TYPE_E) {
+			amp_e = c->cluster_id;
+		} else if (c->cluster_type == CLUSTER_TYPE_P) {
+			amp_p = c->cluster_id;
+		}
+	}
+	if (t->num_clusters != 2 || amp_e == UINT32_MAX || amp_p == UINT32_MAX) {
+		say("not one E and one P cluster: no controller\n");
+		return;
+	}
+	sched_perfcontrol_register_callbacks(&amp_callbacks, 0);
+	say("registered as the performance controller: thread groups prefer P (cluster %u) for fixed / UI / user-initiated / "
+	    "default work, E (cluster %u) for utility / background; %llu groups so far\n", amp_p, amp_e,
+	    (unsigned long long)__atomic_load_n(&amp_groups, __ATOMIC_RELAXED));
+	for (unsigned n = 1; n <= 30; n++) {
+		IOSleep(10 * 1000);
+		say("%u s: %llu thread groups placed\n", n * 10, (unsigned long long)__atomic_load_n(&amp_groups, __ATOMIC_RELAXED));
+	}
+}
+
+void hakios_iceland_amp_init(void);
+
+void
+hakios_iceland_amp_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("iceclu", &on, sizeof(on)) || on == 0) {
+		const ml_topology_info_t *t = ml_get_topology_info();
+
+		printf("iceclu: off (Edge defaults); %u clusters\n", t != NULL ? t->num_clusters : 0);
+		return;
+	}
+	if (kernel_thread_start(amp_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
