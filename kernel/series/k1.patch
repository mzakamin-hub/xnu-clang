+/*
+ * The software stand-in (iceagx_selftest=3 only, the self-test's kernel connections only, one thread): a space is a list of
+ * 4 KB pages; a submission runs its IBs' CP_MEM_WRITE packets (PM4 type 7, opcode 0x3d: address, values) on the CPU through
+ * the physical pages, each write pushed out of the cache; every fence is done when it is returned. Nothing reaches hardware.
+ */
+struct AGXSoftPage {
+	uint64_t va, pa;
+};
+static struct {
+	bool used;
+	AGXSoftPage * pages;
+	uint32_t n, cap;
+} agx_soft[8];
+static bool agx_soft_on;
+static uint32_t agx_soft_fence = 16, agx_soft_writes;
+
+static bool
+agx_soft_up(void)
+{
+	return agx_soft_on;
+}
+
+static int
+agx_soft_create(uint32_t * space)
+{
+	for (uint32_t i = 0; i < 8; i++) {
+		if (!agx_soft[i].used) {
+			agx_soft[i].used = true;
+			agx_soft[i].n = 0;
+			*space = i;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static void
+agx_soft_destroy(uint32_t space)
+{
+	if (space < 8 && agx_soft[space].used) {
+		if (agx_soft[space].pages != NULL) {
+			IODeleteData(agx_soft[space].pages, AGXSoftPage, agx_soft[space].cap);
+		}
+		bzero(&agx_soft[space], sizeof(agx_soft[space]));
+	}
+}
+
+static int
+agx_soft_map(uint32_t space, uint64_t va, const uint64_t * pa, uint32_t pages, bool read_only)
+{
+	(void)read_only;
+	if (space >= 8 || !agx_soft[space].used) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < pages; i++) {
+		if (agx_soft[space].n == agx_soft[space].cap) {
+			uint32_t cap = agx_soft[space].cap ? 2 * agx_soft[space].cap : 64;
+			AGXSoftPage * made = IONewData(AGXSoftPage, cap);
+
+			if (made == NULL) {
+				return -1;
+			}
+			if (agx_soft[space].pages != NULL) {
+				memcpy(made, agx_soft[space].pages, agx_soft[space].n * sizeof(AGXSoftPage));
+				IODeleteData(agx_soft[space].pages, AGXSoftPage, agx_soft[space].cap);
+			}
+			agx_soft[space].pages = made;
+			agx_soft[space].cap = cap;
+		}
+		agx_soft[space].pages[agx_soft[space].n++] = { va + 4096ull * i, pa[i] };
+	}
+	return 0;
+}
+
+static int
+agx_soft_unmap(uint32_t space, uint64_t va, uint64_t size)
+{
+	if (space >= 8 || !agx_soft[space].used) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < agx_soft[space].n;) {
+		if (agx_soft[space].pages[i].va >= va && agx_soft[space].pages[i].va < va + size) {
+			agx_soft[space].pages[i] = agx_soft[space].pages[--agx_soft[space].n];
+		} else {
+			i++;
+		}
+	}
+	return 0;
+}
+
+static uint64_t
+agx_soft_pa(uint32_t space, uint64_t va)
+{
+	for (uint32_t i = 0; i < agx_soft[space].n; i++) {
+		if (agx_soft[space].pages[i].va == (va & ~0xfffull)) {
+			return agx_soft[space].pages[i].pa | (va & 0xffc);
+		}
+	}
+	return 0;
+}
+
+static int
+agx_soft_submit(uint32_t space, const uint64_t * ib, const uint32_t * dwords, uint32_t n, uint32_t * fence)
+{
+	if (space >= 8 || !agx_soft[space].used) {
+		return -1;
+	}
+	for (uint32_t b = 0; b < n; b++) {
+		uint32_t w[64];
+		uint32_t count = dwords[b] < 64 ? dwords[b] : 64;
+
+		for (uint32_t i = 0; i < count; i++) {
+			uint64_t pa = agx_soft_pa(space, ib[b] + 4ull * i);
+
+			if (pa == 0) {
+				return -1;              /* (a fault: the IB is not in the space) */
+			}
+			flush_dcache64(pa, 4, TRUE);    /* (the CPU wrote it through a write-combined view) */
+			w[i] = ml_phys_read_word((vm_offset_t)pa);
+		}
+		for (uint32_t i = 0; i < count;) {
+			uint32_t h = w[i], words = (h >> 28) == 7 ? (h & 0x3fff) : (h >> 28) == 4 ? (h & 0x7f) : 0;
+
+			if ((h >> 28) == 7 && ((h >> 16) & 0x7f) == 0x3d && words >= 3 && i + words < count) {
+				uint64_t at = w[i + 1] | (uint64_t)w[i + 2] << 32;
+
+				for (uint32_t k = 3; k <= words; k++) {
+					uint64_t pa = agx_soft_pa(space, at + 4ull * (k - 3));
+
+					if (pa == 0) {
+						return -1;
+					}
+					ml_phys_write_word((vm_offset_t)pa, w[i + k]);
+					flush_dcache64(pa, 4, TRUE);
+					agx_soft_writes++;
+				}
+			}
+			i += 1 + words;
+		}
+	}
+	*fence = ++agx_soft_fence;
+	return 0;
+}
+
+static bool
+agx_soft_done(uint32_t fence)
+{
+	return (int32_t)(agx_soft_fence - fence) >= 0;
+}
+
+static int
+agx_soft_wait(uint32_t fence, uint32_t ms)
+{
+	(void)ms;
+	return agx_soft_done(fence) ? 0 : -1;
+}
+
+static uint64_t
+agx_soft_ticks(void)
+{
+	return mach_absolute_time();
+}
+
+static void
+agx_soft_facts(uint32_t * chip, uint64_t * gmem_base, uint64_t * trap, uint64_t * va_start, uint64_t * va_size)
+{
+	*chip = 0x44050a31;             /* (the A840's, as the stand-in answers; Fedora's msm chip id) */
+	*gmem_base = 0x4000000;
+	*trap = 0x1fffffffff000ull;
+	*va_start = 0x100000000ull;
+	*va_size = 0x100000000ull;
+}
+
+static const AGXGpu agx_softgpu = {
+	"software stand-in", agx_soft_up, agx_soft_create, agx_soft_destroy, agx_soft_map, agx_soft_unmap, agx_soft_submit,
+	agx_soft_done, agx_soft_wait, agx_soft_ticks, agx_soft_facts
+};
+
+/* the CPU's lines of [start, start + size) cleaned and invalidated (DC CIVAC works on the physical line whatever the view) */
+static void
+agx_push(const void * start, size_t size)
+{
+	for (uintptr_t a = (uintptr_t)start & ~(uintptr_t)63; a < (uintptr_t)start + size; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Every page of a wired buffer given `attr` (VM_WIMG_WCOMB, or VM_WIMG_USE_DEFAULT back), or with `check` only those not
+ * at it (the re-assertion); returns how many pages changed, and in *found (if given) the attribute the last of them had.
+ * One pmap call a page (NativeAdrenoCpu.cpp:122-124, :137-142).
+ */
+static uint32_t
+agx_bo_attr(IOMemoryDescriptor * md, uint64_t bytes, unsigned int attr, bool check, unsigned int * found = NULL)
+{
+	uint32_t changed = 0;
+
+	for (uint64_t off = 0; off < bytes; off += PAGE_SIZE) {
+		IOByteCount got = 0;
+		addr64_t pa = md->getPhysicalSegment(off, &got, kIOMemoryMapperNone);
+		ppnum_t pn;
+		unsigned int had;
+
+		if (pa == 0 || got < PAGE_SIZE) {
+			continue;
+		}
+		pn = (ppnum_t)atop_64(pa);
+		had = pmap_cache_attributes(pn) & VM_WIMG_MASK;
+		if (check && had == (attr & VM_WIMG_MASK)) {
+			continue;
+		}
+		if (found != NULL) {
+			*found = had;
+		}
+		pmap_set_cache_attributes(pn, attr);
+		changed++;
+	}
+	return changed;
+}
+
+/*
+ * g6b-2 diagnostic switch iceagx_wc=0|1 (default 1). 1: owned buffers as below (AGXBo: wired, write-combined and restored
+ * explicitly, a separate CPU view). 0: g6b-1's buffers (c114a2b), for the A3 hand-back's comparison: pageable
+ * write-combined memory of no task, the client's view that descriptor itself, no attribute call of ours, the pages' reset
+ * left to XNU's reap (vm_object.c:1750-1758).
+ */
+static bool
+agx_wc_explicit(void)
+{
+	static int wc = -1;
+
+	if (wc < 0) {
+		uint32_t v = 1;
+
+		(void)PE_parse_boot_argn("iceagx_wc", &v, sizeof(v));
+		wc = v != 0;
+		if (!wc) {
+			IOLog("agx: iceagx_wc=0: owned buffers are g6b-1's (pageable write-combined, reset by XNU at the reap)\n");
+		}
+	}
+	return wc != 0;
+}
+
+/*
+ * An import's descriptor (g6b-2 F3, as Adreno740 c0e3199 NativeAdrenoMemory.cpp:162-175): first with a memory entry of its
+ * own (kIOMemoryPersistent), which references the VM object, so the owner may unmap or free its range while the GPU still
+ * uses it and the object lives on until the import completes, instead of being torn down under a wired UPL (their
+ * int-233..235: the owner stuck in vm_deallocate). A range no memory entry can be made of is imported plainly, as before.
+ */
+static volatile UInt32 agx_imports[2];  /* [0] persistent, [1] plain */
+
+static IOMemoryDescriptor *
+agx_import_range(mach_vm_address_t start, mach_vm_size_t bytes, IODirection direction, task_t task)
+{
+	IOMemoryDescriptor * md = IOMemoryDescriptor::withAddressRange(start, bytes, direction | kIOMemoryPersistent, task);
+
+	if (md != NULL) {
+		OSIncrementAtomic((volatile SInt32 *)&agx_imports[0]);
+		return md;
+	}
+	md = IOMemoryDescriptor::withAddressRange(start, bytes, direction, task);
+	if (md != NULL && OSIncrementAtomic((volatile SInt32 *)&agx_imports[1]) < 4) {
+		IOLog("agx: an import of %llu bytes without a memory entry of its own (kIOMemoryPersistent refused)\n", bytes);
+	}
+	return md;
+}
+
+/*
+ * The page attribute of an owned buffer, as Adreno740 c0e3199 keeps it (g6b-2, after the g6b-1 tablet run that did not
+ * come back into U-Boot: G6B-1.md sections 8-9).
+ *  - Allocation: wired kernel memory, default-cacheable (NativeAdrenoMemory.cpp:127-133), zeroed and its lines cleaned
+ *    and invalidated (:151-152, :233), then every page made write-combined by an explicit pmap call
+ *    (NativeAdrenoCpu.cpp:112-128, called at :235 from makeWriteCombined, NativeAdrenoUserClient.cpp:197), before the
+ *    GPU or a client maps it (NativeAdrenoMemory.h:76-78). The pmap rewrites every mapping it tracks; on this kernel's
+ *    SPTM pmap that includes the page's physical-aperture entry (pmap.c:10647-10660, the PAPT header of each page).
+ *  - Each submission: a page found back at another attribute is made write-combined again (NativeAdrenoSubmit.cpp:127-131,
+ *    NativeAdrenoCpu.cpp:129-146): XNU's view machinery can set a page's attribute when it populates or tears down a
+ *    device-pager view (NativeAdrenoMemory.h:22-24, their int-100).
+ *  - Free: after the GPU unmap and with no CPU view left (NativeAdrenoUserClient.cpp:293-303), the pages get the default
+ *    attribute back by the same explicit call, before they are unwired and released (NativeAdrenoMemory.cpp:244-268).
+ *    Here their lines are then cleaned and invalidated once more through the kernel's mapping, now cacheable again, so
+ *    nothing a speculative fill brought in survives them (Adreno740 does none: its aperture kept a cacheable block
+ *    mapping, NativeAdrenoCpu.cpp:106-111).
+ * g6b-1 made them pageable write-combined memory and left the reset to XNU, when the VM object is reaped
+ * (vm_object.c:1750-1758): only once its last reference goes, after the unwire, at no point the client knows.
+ * The CPU view is a separate descriptor of the same physical pages (NativeAdrenoPublish.cpp:354-392), write-combined: the
+ * kit and Turnip map it so (and Adreno740's kIOMapInhibitCache is VM_WIMG_IO, Device nGnRnE, over DRAM:
+ * IOMemoryDescriptor.cpp:359, pmap.c:10787-10800), and a mapping asking any other mode is made write-combined
+ * (AGXBoView::makeMapping). The view holds no reference on the pages: they are freed only when no mapping of the view
+ * is left (BoFree, shut). An import pins the owning task's pages; its attribute is never touched, and it has no CPU view.
+ */
+struct AGXBo {
+	uint64_t handle;                /* 0: a free slot; never reused within a connection (Turnip keys BOs by it) */
+	uint64_t bytes;
+	uint64_t iova;                  /* 0: not in the GPU's space */
+	uint64_t from;                  /* an import's first byte in `memory` */
+	IOMemoryDescriptor * memory;    /* prepared (wired) */
+	IOMemoryDescriptor * view;      /* the CPU view (made at the first BoCpuMap) */
+	uint32_t leases;                /* BoCpuMap's not given back */
+	uint32_t fence;                 /* the last submission that named it */
+	bool imported, read_only;
+	/* render1, iceagx_wcscan=2: the pages are known write-combined (no view event since a quiet walk); clean walks since */
+	bool wc_clean;
+	uint8_t wc_quiet;
+	uint32_t meta_bytes;
+	char meta[64];
+	uint64_t wc_event;              /* iceagx_wcscan=2: absolute time of the last view event (map, mapping, last unmap) */
+};
+
+/*
+ * render1, iceagx_wcscan=2: a view event on a buffer -- its CPU view made or leased (BoCpuMap), a mapping of it handed out
+ * (clientMemoryForType), its last lease given back and the view's mappings taken down (BoCpuUnmap) -- may set its
+ * pages' attribute: the view's device-pager VM object resets every page to the default (0x2, cacheable) when it is
+ * reaped (vm_object.c's reap, the g6b-1 note above), which comes after the unmap, at a time nobody here sees. The
+ * buffer is walked at every submission from such an event until two walks found nothing, the later one at least
+ * 250 ms after the event.
+ */
+static inline void
+agx_bo_view_event(AGXBo * bo)
+{
+	bo->wc_clean = false;
+	bo->wc_quiet = 0;
+	bo->wc_event = mach_absolute_time();
+}
+
+/* The CPU view of an owned buffer: its physical pages, write-combined by the view's own pager, whatever a mapping asks. */
+class AGXBoView : public IOGeneralMemoryDescriptor
+{
+	OSDeclareDefaultStructors(AGXBoView);
+public:
+	static AGXBoView * make(IOMemoryDescriptor * backing, uint64_t bytes);
+	virtual IOMemoryMap * makeMapping(IOMemoryDescriptor * owner, task_t intoTask, IOVirtualAddress atAddress,
+	    IOOptionBits options, IOByteCount offset, IOByteCount length) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AGXBoView, IOGeneralMemoryDescriptor);
+
+AGXBoView *
+AGXBoView::make(IOMemoryDescriptor * backing, uint64_t bytes)
+{
+	uint32_t count = 0, cap = (uint32_t)(bytes / PAGE_SIZE) + 1;
+	IOAddressRange * ranges = IONewData(IOAddressRange, cap);
+	AGXBoView * view = NULL;
+
+	if (ranges == NULL) {
+		return NULL;
+	}
+	for (uint64_t off = 0; off < bytes; off += PAGE_SIZE) {
+		IOByteCount got = 0;
+		addr64_t pa = backing->getPhysicalSegment(off, &got, kIOMemoryMapperNone);
+
+		if (pa == 0 || (pa & PAGE_MASK) || got < PAGE_SIZE) {
+			count = 0;
+			break;
+		}
+		if (count != 0 && ranges[count - 1].address + ranges[count - 1].length == pa) {
+			ranges[count - 1].length += PAGE_SIZE;
+		} else if (count < cap) {
+			ranges[count].address = pa;
+			ranges[count].length = PAGE_SIZE;
+			count++;
+		}
+	}
+	view = count != 0 ? new AGXBoView : NULL;
+	/* (the cache mode of a physical descriptor is its pager's, kIOMemoryBufferCacheMask: IOMemoryDescriptor.cpp:796-807) */
+	if (view != NULL && !view->initWithOptions(ranges, count, 0, NULL, (IOOptionBits)kIODirectionInOut |
+	    (IOOptionBits)kIOMemoryTypePhysical64 | ((IOOptionBits)kIOWriteCombineCache << kIOMemoryBufferCacheShift), NULL)) {
+		view->release();
+		view = NULL;
+	}
+	IODeleteData(ranges, IOAddressRange, cap);
+	return view;
+}
+
+IOMemoryMap *
+AGXBoView::makeMapping(IOMemoryDescriptor * owner, task_t intoTask, IOVirtualAddress atAddress, IOOptionBits options,
+    IOByteCount offset, IOByteCount length)
+{
+	IOOptionBits mode = options & kIOMapCacheMask;
+
+	if (mode != kIOMapDefaultCache && mode != kIOMapWriteCombineCache) {
+		/* (createMappingInTask hands the new IOMemoryMap in atAddress, kIOMap64Bit: IOMemoryDescriptor.cpp:6128-6138) */
+		options = (options & ~kIOMapCacheMask) | kIOMapWriteCombineCache;
+		if ((options & kIOMap64Bit) && atAddress != 0) {
+			IOMemoryMap * mapping = (IOMemoryMap *)atAddress;
+
+			mapping->fOptions = (mapping->fOptions & ~kIOMapCacheMask) | kIOMapWriteCombineCache;
+		}
+	}
+	return IOGeneralMemoryDescriptor::makeMapping(owner, intoTask, atAddress, options, offset, length);
+}
+
+/* every live connection, for the GPU's way down (agx_clients_stop); its lock is taken before any connection's own */
+static IOLock * agx_clients_lock;
+static class AGXDeviceUserClient * agx_clients;
+static bool agx_stopping;
+
+static IOLock *
+agx_clients_lock_get(void)
+{
+	if (agx_clients_lock == NULL) {
+		IOLock * lock = IOLockAlloc();
+
+		if (!OSCompareAndSwapPtr(NULL, lock, (void * volatile *)&agx_clients_lock)) {
+			IOLockFree(lock);
+		}
+	}
+	return agx_clients_lock;
+}
