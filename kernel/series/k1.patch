+/*
+ * AGXDeviceUserClient (the class name macOS's sandbox profiles admit: piano gpu-userspace.md:164-165). With the GPU up (the
+ * A840's stage-6 API serving) a connection gets its own GPU space and every method of ABI v2. With no GPU it keeps g6b-0's
+ * skeleton: the probe and Query answered, every other method refused with kIOReturnUnsupported, named once. Both only with
+ * boot-arg iceagx_client=1.
+ */
+class AGXDeviceUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AGXDeviceUserClient);
+	char name_[20];
+	uint32_t refused_;              /* skeleton: methods refused once already, a bit each */
+	task_t task_;
+	IOLock * lock_;
+	const AGXGpu * gpu_;            /* NULL: no GPU (the skeleton) */
+	uint32_t space_;
+	bool live_, closed_, stopped_;
+	AGXBo * bos_;
+	uint32_t cap_, count_;          /* slots, live objects; a CPU-map token is a slot's index + 1 */
+	uint64_t next_;                 /* the next handle */
+	uint32_t last_;                 /* this connection's last fence */
+	uint32_t made_, imports_, submits_;     /* buffers made (of them imported), submissions: the line at its end */
+	uint64_t ibs_;
+	uint64_t look_;                 /* absolute time its submissions spent looking at its buffers' page attributes */
+	/*
+	 * render1 (icerender= rows, agx_render_rows; iceagx_wcscan=): the longest look of one submission and the pages looked
+	 * at since the last row; the waits for a fence (WaitFence and a submission's wait_fence: count, total and how many
+	 * took 9 ms or more, i.e. came by the 10 ms re-check); the values the last row saw; the walk's mode and its audit.
+	 * Heap (the object), zero at birth like every other counter here.
+	 */
+	uint64_t lookMax_, pagesWin_, rLook_, waitAbs_, rWaitAbs_;
+	uint32_t rSubs_, rIbs_, waits_, rWaits_, waitsLong_, rWaitsLong_;
+	uint32_t wcscan_, audits_, missed_, missedSaid_;
+	uint64_t lastAudit_;            /* render1: absolute time of the last full walk (iceagx_wcscan=1|2) */
+	uint32_t queues_, qfence_[kAGXQueues];
+	uint32_t said_, notes_;
+	int32_t fg_, bg_;
+	uint64_t ib_[kAGXMaxBuffers];
+	uint32_t dw_[kAGXMaxBuffers];
+	AGXDeviceUserClient * link_;
+	IOReturn run(uint32_t method, const void * in, uint32_t inSize, void * out, uint32_t * outSize);
+	IOReturn live(uint32_t method, const void * in, void * out);
+	AGXBo * find(uint64_t handle);
+	AGXBo * slot(void);
+	void unmapAll(bool wait);
+	bool shut(void);
+	bool releaseBo(IOMemoryDescriptor * memory, IOMemoryDescriptor * view, uint64_t bytes, bool owned);
+	void dropViews(IOMemoryDescriptor * memory);
+	uint64_t maxBytes(void);
+	int pid_;                       /* gains1 (P6): the opening process, for the memory telemetry's per-client row */
+	/* render1: one fence wait of the client's (outside lock_: atomics) */
+	void noteWait(uint64_t abs)
+	{
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(abs, &ns);
+		OSAddAtomic64((SInt64)abs, (volatile SInt64 *)&waitAbs_);
+		OSIncrementAtomic((volatile SInt32 *)&waits_);
+		if (ns >= 9000000) {
+			OSIncrementAtomic((volatile SInt32 *)&waitsLong_);
+		}
+	}
+public:
+	static void renderRows(void);
+	static AGXDeviceUserClient * make(task_t task, void * securityID, UInt32 type, OSDictionary * properties);
+	static void memRow(uint64_t t);
+	IOReturn mount(void);
+	void stop(void);
+	bool isLive(void) const
+	{
+		return live_;
+	}
+	AGXDeviceUserClient * next(void) const
+	{
+		return link_;
+	}
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+	APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * arguments, IOExternalMethodDispatch * dispatch,
+	    OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
