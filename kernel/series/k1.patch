+static bool
+core_faulted(const char *when)
+{
+	uint32_t fsr;
+
+	if (core_cb < 0 || !smmu_readable()) {
+		return false;
+	}
+	fsr = rd(smmu + SMMU_CB(0) + CB_FSR);
+	if (!(fsr & FSR_ALL)) {
+		return false;
+	}
+	say("core SMMU FAULT (%s): fsr %#x far %#x%08x fsynr0 %#x\n", when, fsr, rd(smmu + SMMU_CB(0) + CB_FAR + 4),
+	    rd(smmu + SMMU_CB(0) + CB_FAR), rd(smmu + SMMU_CB(0) + CB_FSYNR0));
+	return true;
+}
