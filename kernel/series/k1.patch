+/* ---- the Pad's blocks ----------------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x80000UL
+#define GCC_GPLL0_VOTE          0x52000         /* bit 15 gpu_gpll0_clk_src, bit 16 gpu_gpll0_div_clk_src */
+#define GCC_VOTE_GPLL0_DIV      (1u << 16)
+#define GCC_GPU_CFG_AHB_CBCR    0x71004         /* critical */
+#define GCC_GPU_GEMNOC_GFX_CBCR 0x71010
+
+#define GPU_PHYS                0x03d00000UL    /* gpu 0x6c000, gmu 0x3d37000, gxclkctl 0x3d64000, gpucc, cx_mem */
+#define GPU_SIZE                0xa0000UL
+#define GPUCC_OFF               0x90000UL
+#define RSCC_OFF                0x50000UL       /* a6xx_gmu_init, a8xx: the GPU's base + 0x50000 */
+#define CX_MISC_OFF             0x9e000UL       /* gpu reg "cx_mem" 0x3d9e000 */
+#define GX_GDSCR_OFF            0x68024UL       /* gxclkctl 0x3d64000 + 0x4024 */
+
+#define SMMU_PHYS               0x03da0000UL
+#define SMMU_SIZE               0x40000UL
+
+#define CMD_DB_PHYS             0x81c60000UL
+#define CMD_DB_SIZE             0x20000UL
+
+/* gpucc-kaanapali.c */
+#define PLL0                    0x0000
+#define PLL_MODE                0x00
+#define PLL_OPMODE              0x04
+#define PLL_STATE               0x08
+#define PLL_STATUS              0x0c
+#define PLL_L                   0x10
+#define PLL_ALPHA               0x14
+#define PLL_USER_CTL            0x18
+#define PLL_USER_CTL_U          0x1c
+#define PLL_CONFIG_CTL          0x20
+#define PLL_CONFIG_CTL_U        0x24
+#define PLL_CONFIG_CTL_U1       0x28
+#define PLL_TEST_CTL            0x2c
+#define PLL_TEST_CTL_U          0x30
+#define PLL_OUTCTRL             (1u << 0)
+#define PLL_RESET_N             (1u << 2)
+#define PLL_LOCK_DET            (1u << 31)
+#define PLL_RUN                 1u
+#define PLL_STANDBY             0u
+#define PLL_OUT_MASK            7u
+#define PLL_VOTE_RUN            (1u << 25)      /* LUCID_EVO_ENABLE_VOTE_RUN (FSM mode) */
+#define GMU_RCGR                0x9318
+#define HUB_RCGR                0x93f0
+#define HUB_DIV                 0x9430
+#define RCG_UPDATE              (1u << 0)
+#define RCG_ROOT_EN             (1u << 1)
+#define RCG_ROOT_OFF            (1u << 31)
+#define RCG_CFG_GMU_475         (2u << 8 | 1u | 1u << 20)       /* PLL0 even, div 1, hw_clk_ctrl */
+#define RCG_CFG_HUB_150         (6u << 8 | 3u | 1u << 20)       /* GPLL0_DIV, div 2, hw_clk_ctrl */
+#define CBCR_AHB                0x90bc
+#define CBCR_CX_GMU             0x90d4
+#define CBCR_CXO                0x90e4
+#define CBCR_HUB_CX_INT         0x90e8
+#define CBCR_MEMNOC_GFX         0x90ec
+#define CBCR_GX_GMU             0x9060
+#define CBCR_SMMU_VOTE          0x7000
+#define CBCR_HUB_AON            0x93ec
+#define CBCR_RSCC_HUB_AON       0x93e8
+#define CBCR_RSCC_XO_AON        0x9004
+#define CBCR_CXO_AON            0x9008
+#define CBCR_ENABLE             (1u << 0)
+#define CBCR_OFF                (1u << 31)
+#define CX_GDSCR                0x9080
+#define CX_GDS_HW_CTRL          0x9094
+#define GDSC_SW_COLLAPSE        (1u << 0)
+#define GDSC_RETAIN_FF          (1u << 11)
+#define GDSC_WAIT_MASK          (0xfu << 20 | 0xfu << 16 | 0xfu << 12)
+#define GDSC_WAIT_CX            (2u << 20 | 2u << 16 | 8u << 12)
+#define GDSC_POWER_ON           (1u << 31)
+#define GDSC_DOWN_COMPLETE      (1u << 15)      /* in GDSCR + 4 (POLL_CFG_GDSCR) */
+
+/* a8xx_catalog.c / a6xx_gmu.c */
+#define GMU_CHIPID              0x8020100u
+#define DT_CHIP_ID              0x44050a01u
+#define GMU_STREAM              5u
+#define OOB_GPU_SET             (1u << 30)
+#define OOB_GPU_ACK             (1u << 31)
+#define OOB_GPU_CLEAR           (1u << 31)
+#define RSCC_ASLEEP_A840        (1u << 30)
+#define CX_BUSY_GPU             (1u << 23)      /* GPUBUSYIGNAHB */
+#define CX_BUSY_CXGXCPU         (1u << 30)      /* CXGXCPUBUSYIGNAHB */
+
+static vm_offset_t gcc, gpu, smmu;
+static const uint8_t *cmd_db;
+static uint32_t writes;
+
+#define GPUCC(off)              (gpu + GPUCC_OFF + (off))
+
+/* every register write: what it was, what it is set to */
+static void
+wlog(vm_offset_t va, uint64_t pa, const char *name, uint32_t v)
+{
+	uint32_t was = rd(va);
+
+	wr(va, v);
+	writes++;
+	say("w %s @%#llx: %#x -> %#x\n", name, pa, was, v);
+}
+
+#define W_GCC(off, name, v)     wlog(gcc + (off), GCC_PHYS + (off), name, v)
+#define W_CC(off, name, v)      wlog(GPUCC(off), GPU_PHYS + GPUCC_OFF + (off), name, v)
+#define W_G(reg, v)             wlog(gpu + 4UL * (reg), GPU_PHYS + 4UL * (reg), #reg, v)
+#define W_RSCC(reg, v)          wlog(gpu + RSCC_OFF + 4UL * (reg), GPU_PHYS + RSCC_OFF + 4UL * (reg), #reg, v)
+#define W_SMMU(off, name, v)    wlog(smmu + (off), SMMU_PHYS + (off), name, v)
+#define G(reg)                  rd(gpu + 4UL * (reg))
+#define RSCC(reg)               rd(gpu + RSCC_OFF + 4UL * (reg))
+#define CXM(reg)                rd(gpu + CX_MISC_OFF + 4UL * (reg))
+#define CC(off)                 rd(GPUCC(off))
+
+static bool
+wait_bits(vm_offset_t a, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t t = 0; t < us; t += 10) {
+		if ((rd(a) & mask) == want) {
+			return true;
+		}
+		sleep_us(10);
+	}
+	return (rd(a) & mask) == want;
+}
+
+/* ---- state found, state now ---------------------------------------------------------------------------------- */
+
+static bool
+cx_on(void)
+{
+	return (CC(CX_GDS_HW_CTRL) & GDSC_POWER_ON) != 0;
+}
+
+static bool
+clock_runs(uint32_t cbcr)
+{
+	return (CC(cbcr) & CBCR_OFF) == 0;
+}
+
+/* Linux reads the GMU block only with CX on and the GMU's ahb / gmu / hub clocks enabled */
+static bool
+gmu_readable(void)
+{
+	return cx_on() && clock_runs(CBCR_AHB) && clock_runs(CBCR_CX_GMU) && clock_runs(CBCR_HUB_CX_INT);
+}
+
+static bool
+smmu_readable(void)
+{
+	return cx_on() && clock_runs(CBCR_SMMU_VOTE);
+}
+
+struct sreg {
+	const char *name;
+	uint8_t where;                  /* 0 gcc, 1 gpucc, 2 gpu block (gmu readable), 3 rscc, 4 cx_misc */
+	uint32_t off;                   /* bytes (gcc, gpucc, gpu block offset) or words (gpu regs, rscc, cx_misc) */
+};
+#define S_GCC(o)        { #o, 0, o }
+#define S_CC(o)         { #o, 1, o }
+#define S_G(r)          { #r, 2, r }
+#define S_R(r)          { #r, 3, r }
+#define S_X(r)          { #r, 4, r }
