+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland S7 item 8: UniXNU SoftwareAES da07dd5, unchanged below this comment (see NativeAES.cpp).
+#pragma once
+#include <IOKit/IOService.h>
+#include <IOKit/IOMemoryDescriptor.h>
+
+// Ordinary iOS ABI, qualified against the original component and live metadata.
+class IOCryptoAccelerator : public IOService {
+  OSDeclareDefaultStructors(IOCryptoAccelerator)
+#if defined(NATIVE_AES_DARWIN26) && NATIVE_AES_DARWIN26
+  // Darwin 26 (26C5035r, 24A446): the parent declares getAlgorithmName (its slot is signed with
+  // _ZN19IOCryptoAccelerator16getAlgorithmNameEv); IOAESAccelerator overrides it.
+public:
+  virtual const char *getAlgorithmName();
+#endif
+};
+struct IOAESIV { unsigned char bytes[16]; };
+struct IOAESKeyData {
+  uint32_t bits;
+  unsigned char bytes[32];
+  uint32_t selector;
+};
+enum IOAESOperation : unsigned { IOAESEncrypt = 0, IOAESDecrypt = 1 };
+class IOAESAcceleratorCommand;
+using IOAESCompletion = void (*)(void *, int);
+class IOAESAccelerator : public IOCryptoAccelerator {
+  OSDeclareDefaultStructors(IOAESAccelerator)
+  unsigned char originalFields[0x98];
+public:
+  bool start(IOService *) override;
+  IOWorkLoop *getWorkLoop() const override;
+  IOReturn callPlatformFunction(const OSSymbol *, bool, void *, void *, void *, void *) override;
+#if defined(NATIVE_AES_DARWIN26) && NATIVE_AES_DARWIN26
+  const char *getAlgorithmName() override;
+#else
+  virtual const char *getAlgorithmName();
+#endif
+  virtual IOReturn performAES(void *, void *, task_t, unsigned long long, IOAESIV *,
+                             IOAESOperation, IOAESKeyData *, IOAESCompletion, void *);
+  virtual IOReturn performAES(IOMemoryDescriptor *, IOMemoryDescriptor *, unsigned long long,
+                             IOAESIV *, IOAESOperation, IOAESKeyData *, unsigned long long,
+                             unsigned long long, IOAESCompletion, void *);
+  virtual bool isKeySupported(unsigned);
+  virtual unsigned getSupportedOptions();
+  virtual IOReturn performAESQuantum(IOAESAcceleratorCommand *);
+  virtual void completeAESQuantum(IOAESAcceleratorCommand *);
+  virtual IOReturn performImmediateAES(IOAESAcceleratorCommand *);
+  virtual void disableHardwareKey(unsigned);
+  virtual void createSpecialKeys();
+  virtual IOReturn _queueLocked(IOAESAcceleratorCommand *);
+  virtual void _startCommand();
+  virtual void _completeAES(IOAESAcceleratorCommand *);
+};
+static_assert(sizeof(IOService) == 0x88, "source IOService ABI changed");
+static_assert(sizeof(IOCryptoAccelerator) == 0x88, "original crypto parent ABI changed");
+static_assert(sizeof(IOAESAccelerator) == 0x120, "original AES instance ABI changed");
+static_assert(sizeof(IOAESIV) == 16 && __builtin_offsetof(IOAESKeyData, selector) == 36,
+              "original raw key/IV ABI changed");
diff --git a/iokit/Native/SoftwareAES/SoftwareAesProbe.cpp b/iokit/Native/SoftwareAES/SoftwareAesProbe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e747472963437d44dc62d305bfac82ae978353be
--- /dev/null
+++ b/iokit/Native/SoftwareAES/SoftwareAesProbe.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland S7 item 8: registers UniXNU's software AES-CBC provider (NativeAES.cpp, an IOAESAccelerator of the original
+// IOCryptoAcceleratorFamily). From UniXNU-sheng 1108068 package/SoftwareAesProbe.cpp (the late registration, unchanged in
+// substance) and the busy-leaf report of its package/LegacyDisplayProbe.cpp (busyReport, re-implemented shorter).
+//
+// AppleImage4 starts on the device tree's "defaults" node and, in kmod_expert_finalize, waits for an IOAESAccelerator
+// service without a limit while it holds its expert lock (26C5035r). This board has no AES engine node (an Apple SoC's
+// AppleS8000AES matches "aes,s8000"), so the wait never ends: "defaults" never finishes matching, IOKit never goes
+// quiet, and the network configuration (240 s), the TimeSync clock manager and through it WindowServer wait on that
+// (sheng's macOS run29/run30; piano's 27.3 line). NativeAES registers itself after its NIST known-answer tests pass;
+// it serves software keys only and refuses hardware key selectors (0x8a4, AppleImage4's nonce key, is derived from
+// /chosen/unique-chip-id and says so in NativeAESSoftwareKeysOnly).
+//
+// When: IOKitBSDInit() calls native_software_aes_probe() right after it publishes the IOBSD resource, the moment UniXNU's
+// own personality for NativeAES matches at (UniXNU dff2765 native-aes-personality.patch: IOResources, IOResourceMatch
+// IOBSD). Late, as sheng does it on 26C5035r: the family kext has no personality here and is loaded first, so the
+// parent class exists before NativeAES's metaclass is made (the object keeps no __mod_init_func: iokit/conf
+// Makefile.template, NATIVE_LATE_FILES).
+//
+// native-aes=0 leaves the provider out (the "before" of a run pair); the busy report runs either way, every 10 s for
+// at most 10 minutes while IOKit's root is busy, and logs the busy leaves (a busy service with no busy client: name,
+// class, busy count, whether its own matching finished) whenever the set changes: "iokit busy: ...".
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IORegistryEntry.h>
+#include <libkern/c++/OSMetaClass.h>
+#include <libkern/OSKextLib.h>
+#include <kern/thread.h>
+
+extern kmod_info_t g_kernel_kmod_info;
+extern "C" void native_aes_static_init(void) __asm__("__GLOBAL__sub_I_NativeAES.cpp");
+extern "C" {
+extern volatile uint32_t native_aes_kat_status, native_aes_interface_status, native_aes_completed,
+    native_aes_unsupported_key, native_aes_nonce_key_uses;
+extern volatile uint64_t native_aes_bytes;
+// 0 not run, 1 started (NativeAES registered itself), 2 left out (native-aes=0), negative: the step that failed.
+volatile int native_software_aes_state = 0;
+void native_software_aes_probe(void);
+}
+
+namespace {
+
+void
+fail(int step)
+{
+	native_software_aes_state = -step;
+	IOLog("SoftwareAES: not started (%d)\n", -step);
+	thread_terminate(current_thread());
+}
+
+void
+worker(void *, wait_result_t)
+{
+	// The family has no personality on this board; loading it makes the parent class before NativeAES registers.
+	const OSReturn loaded = OSKextLoadKextWithIdentifier("com.apple.iokit.IOCryptoAcceleratorFamily");
+	if (loaded != kOSReturnSuccess && loaded != kOSKextReturnStartStopError) {
+		fail(1);
+	}
+	void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+	if (!handle) {
+		fail(2);
+	}
+	native_aes_static_init();
+	if (OSMetaClass::postModLoad(handle)) {
+		fail(3);
+	}
+	OSObject *object = OSMetaClass::allocClassWithName("NativeAES");
+	IOService *aes = OSDynamicCast(IOService, object);
+	IOService *parent = IOService::getResourceService();
+	if (!aes || !parent || !aes->init()) {
+		OSSafeReleaseNULL(object);
+		fail(4);
+	}
+	if (!aes->attach(parent)) {
+		aes->release();
+		fail(5);
+	}
+	// NativeAES::start runs the NIST known-answer tests and registers the service only when they pass.
+	if (!aes->start(parent)) {
+		aes->detach(parent);
+		aes->release();
+		fail(6);
+	}
+	aes->release();
+	native_software_aes_state = 1;
+	IOLog("SoftwareAES: IOAESAccelerator registered (KAT %u, interface %u)\n", native_aes_kat_status,
+	    native_aes_interface_status);
+	// What the provider served, once AppleImage4 and the boot's users have had their turn.
+	IOSleep(240 * 1000);
+	IOLog("SoftwareAES: %u requests, %llu bytes, %u with the nonce key, %u refused (hardware key)\n",
+	    native_aes_completed, native_aes_bytes, native_aes_nonce_key_uses, native_aes_unsupported_key);
+	thread_terminate(current_thread());
+}
+
+void
+busyReport(void *, wait_result_t)
+{
+	static char last[384];
+	char line[384];
+
+	for (unsigned round = 1; round <= 60; round++) {
+		IOSleep(10 * 1000);
+		IOService *root = IOService::getServiceRoot();
+		unsigned busy = root ? (unsigned)root->getBusyState() : 0;
+		int at = snprintf(line, sizeof(line), "iokit busy: root %u at %u s after IOBSD:", busy, round * 10);
+		unsigned shown = 0;
+		OSPtr<IORegistryIterator> it = busy ? IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively) : NULL;
+		IORegistryEntry *entry;
+		while (it && shown < 6 && at < (int)sizeof(line) - 1 && (entry = it->getNextObject())) {
+			IOService *service = OSDynamicCast(IOService, entry);
+			if (!service || !service->getBusyState()) {
+				continue;
+			}
+			bool leaf = true;
+			OSPtr<OSIterator> clients = service->getClientIterator();
+			OSObject *client;
+			while (leaf && clients && (client = clients->getNextObject())) {
+				IOService *c = OSDynamicCast(IOService, client);
+				leaf = !(c && c->getBusyState());
+			}
+			if (!leaf) {
+				continue;
+			}
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %s(%s,%u,%c)", service->getName(),
+			    service->getMetaClass()->getClassName(), (unsigned)service->getBusyState(),
+			    (service->getState() & kIOServiceMatchedState) ? 'm' : '-');
+			shown++;
+		}
+		// the busy set, without the time, decides whether this round is new
+		const char *set = strchr(line, ':');
+		set = set ? strchr(set + 1, ':') : NULL;
+		if (!set || strcmp(set, last)) {
+			IOLog("%s\n", line);
+			if (set) {
+				strlcpy(last, set, sizeof(last));
+			}
+		}
+		if (!busy) {
+			break;
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+}  // namespace
+
+// The board entry (IOKitBSDInit, right after IOBSD is published), macOS only.
+void
+native_software_aes_probe(void)
+{
+	thread_t thread = nullptr;
+	if (kernel_thread_start(busyReport, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	uint32_t enabled = 1;
+	if (PE_parse_boot_argn("native-aes", &enabled, sizeof(enabled)) && !enabled) {
+		native_software_aes_state = 2;
+		IOLog("SoftwareAES: left out (native-aes=0)\n");
+		return;
+	}
+	thread = nullptr;
+	if (kernel_thread_start(worker, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		native_software_aes_state = -7;
+	}
+}
diff --git a/iokit/Native/SoftwareAES/gen_bindings.py b/iokit/Native/SoftwareAES/gen_bindings.py
