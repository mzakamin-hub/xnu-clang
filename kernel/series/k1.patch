+/*
+ * ---- progress marks on the panel ----------------------------------------------------------------------------------
+ * A row of 25 squares (104 px, every 130 px from x 96, y 160 to 264 of the panel; the native landscape frame, upright
+ * in the keyboard case), one per step below. Dark grey: not reached; YELLOW: under way (the last yellow one is where it
+ * stuck); green: done; red: failed (the kit stopped there cleanly). Drawn at once before and after each step and
+ * redrawn every 300 ms by a thread of its own (iOS draws over them), so a photo tells the step even with no log.
+ * Boot-arg icedsp_marks=0: none.
+ */
+#include <console/video_console.h>
+extern struct vc_info vinfo;            /* the boot framebuffer, as the text console knows it */
+
+enum {
+	M_PARSE = 1,            /* /chosen and the images' ELF headers (RAM only) */
+	M_SMEM,                 /* SMEM partition, the DSP's SMP2P item, last words, cmd-db (reads) */
+	M_RSC_AOSS,             /* the RSC's id and TCS 0, the AOSS mailbox (reads) */
+	M_CE_UP,                /* RPMh: the crypto engine's bus vote (CE0) */
+	M_DTB_INIT,             /* TZ PAS init image, adsp_dtb.mbn */
+	M_DTB_MEM,              /* TZ PAS mem setup, adsp_dtb.mbn */
+	M_DTB_COPY,             /* adsp_dtb.mbn copied into q6-adsp-dtb@a1380000 and read back */
+	M_ITEM,                 /* our SMP2P item 429 (SMEM write under the hardware lock), the DSP rung */
+	M_AOSS_ON,              /* RPMh LP0 (LPASS's bus to DDR), then AOSS "load_state adsp on" */
+	M_RAILS_UP,             /* RPMh lcx / lmx at their highest level */
+	M_DTB_AUTH,             /* TZ auth and reset, adsp_dtb.mbn */
+	M_MAIN_INIT,            /* TZ PAS init image, adsp.mbn */
+	M_MAIN_MEM,             /* TZ PAS mem setup, adsp.mbn */
+	M_MAIN_COPY,            /* adsp.mbn copied into adspslpi@a1400000 and read back */
+	M_MAIN_AUTH,            /* TZ auth and reset, adsp.mbn: the DSP starts */
+	M_READY,                /* waiting for "ready" (10 s) and the hold */
+	M_STOP,                 /* our stop bit, the DSP's stop-ack */
+	M_SHUTDOWN,             /* TZ PAS shutdown (main, dtb) */
+	M_POWER_DOWN,           /* AOSS "off", rails and CE0 given back */
+	M_DONE,                 /* the kit has finished (green) */
+	M_GLINK,                /* levels 7-9: GLINK over SMEM with the DSP (version; 8: our channels open) -- right of "done" */
+	M_QRTR,                 /* level 9: QRTR HELLO both ways and the DSP's services listed */
+	M_GPR,                  /* level 10: GPR on adsp_apps: the APM's state, then PRM */
+	M_SNS,                  /* level 11: sensors over SNS (service 400): SUIDs, accel samples */
+	M_AUDIO,                /* iceaudio=1: audio level C1, the speakers' back end running silence; icetone: level D */
+	MARKS = M_AUDIO
+};
+enum { MARK_NONE, MARK_BUSY, MARK_OK, MARK_FAIL };
+static volatile uint8_t marks[MARKS + 1];
+static bool marks_on;
+
+static void
+mark_draw(void)
+{
+	static const uint32_t colour[] = { 0x00303030, 0x00ffff00, 0x0000ff00, 0x00ff0000 };   /* 0xXXRRGGBB */
+
+	if (!marks_on || vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || vinfo.v_width < 96 + MARKS * 130 ||
+	    vinfo.v_height < 264) {
+		return;
+	}
+	for (unsigned i = 1; i <= MARKS; i++) {
+		uint32_t c = colour[marks[i] & 3], x0 = 96 + (i - 1) * 130;
+
+		for (uint32_t y = 160; y < 264; y++) {
+			volatile uint32_t *row = (volatile uint32_t *)(vinfo.v_baseaddr + (vm_offset_t)y * vinfo.v_rowbytes) + x0;
+
+			for (uint32_t x = 0; x < 104; x++) {
+				row[x] = c;
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+mark(unsigned step, uint8_t state)
+{
+	static const char *const what[] = { "-", "under way", "done", "FAILED" };
+
+	if (step == 0 || step > MARKS) {
+		return;
+	}
+	marks[step] = state;
+	say("mark %u: %s\n", step, what[state & 3]);
+	mark_draw();
+}
+
+static void
+mark_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		mark_draw();
+		delay_for_interval(300, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- the Pad's values ---------------------------------------------------------------------------------------- */
+
+#define SMEM_PHYS               0x81d00000UL
+#define SMEM_SIZE               0x00200000u
+#define HOST_APPS               0
+#define HOST_ADSP               2
+#define SMEM_CANARY             0xa5a5
+#define ITEM_SMP2P_THEIRS       443
+#define ITEM_SMP2P_OURS         429
+#define ITEM_CRASH_REASON       423
+#define MUTEX_PHYS              0x01f43000UL    /* tcsr_mutex lock 3 */
+#define MUTEX_APPS              1
+#define IPCC_PHYS               0x01106000UL
+#define IPCC_SEND_ID            0x0c
+#define IPCC_CLIENT_AOP         0
+#define IPCC_CLIENT_LPASS       3
+#define IPCC_SIGNAL_QMP         0
+#define IPCC_SIGNAL_SMP2P       2
+#define AOSS_PHYS               0x0c300000UL
+#define CMD_DB_PHYS             0x81c60000UL
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x18920000UL    /* apps_rsc drv-2 */
+#define TCS_BASE                0xd00
+#define ADSP_MEM                0xa1400000UL
+#define ADSP_MEM_SIZE           0x5000000UL
+#define DTB_MEM                 0xa1380000UL
+#define DTB_MEM_SIZE            0x80000UL
+#define PAS_ADSP                1
+#define PAS_ADSP_DTB            0x24
+
+static vm_offset_t smem, ipcc, aoss, rsc, mutex;
+static const uint8_t *cmd_db;
+
+/* ---- shared memory ------------------------------------------------------------------------------------------- */
+
+struct toc_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+};
+struct partition_header {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, free_uncached, free_cached, reserved[3];
+};
+struct item_header {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_header;
+	uint32_t reserved;
+};
+
+static void
+peek(uint32_t offset, void *to, uint32_t size)
+{
+	for (uint32_t i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = offset + i < SMEM_SIZE ? *(volatile uint8_t *)(smem + offset + i) : 0;
+	}
+}
+
+static void
+poke(uint32_t offset, uint32_t value)
+{
+	wr(smem + offset, value);
+	settle();
+}
+
+static uint32_t part_offset, part_cacheline;
+
+static bool
+find_partition(void)
+{
+	uint8_t magic[4];
+	uint32_t count;
+
+	peek(SMEM_SIZE - 0x1000, magic, 4);
+	count = rd(smem + SMEM_SIZE - 0x1000 + 8);
+	if (memcmp(magic, "$TOC", 4) != 0 || count > 64) {
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		struct toc_entry e;
+		struct partition_header h;
+
+		peek(SMEM_SIZE - 0x1000 + 32 + i * (uint32_t)sizeof(e), &e, sizeof(e));
+		if (e.offset == 0 || !((e.host0 == HOST_APPS && e.host1 == HOST_ADSP) || (e.host0 == HOST_ADSP &&
+		    e.host1 == HOST_APPS))) {
+			continue;
+		}
+		peek(e.offset, &h, sizeof(h));
+		if ((uint64_t)e.offset + e.size > SMEM_SIZE - 0x1000 || memcmp(h.magic, "$PRT", 4) != 0 || h.size != e.size) {
+			return false;
+		}
+		part_offset = e.offset;
+		part_cacheline = e.cacheline;
+		return true;
+	}
+	return false;
+}
+
+/* an item of partition 0/2 (or, when `global`, of the global one: hosts 0xfffe), its place and size; 0 if absent */
+static uint32_t
+find_item_in(uint32_t partition, uint32_t cacheline, uint32_t want, uint32_t *size, char *list, size_t list_size)
+{
+	struct partition_header h;
+	struct item_header e;
+	uint32_t at, found = 0;
+	int n = 0;
+
+	if (partition == 0) {
+		return 0;
+	}
+	peek(partition, &h, sizeof(h));
+	if (h.free_uncached > h.size || h.free_cached > h.size) {
+		return 0;
+	}
+	for (at = sizeof(h); at + sizeof(e) <= h.free_uncached;) {
+		peek(partition + at, &e, sizeof(e));
+		if (e.canary != SMEM_CANARY || e.size > h.size) {
+			break;
+		}
+		if (list != NULL && n < (int)list_size - 16) {
+			n += snprintf(list + n, list_size - (size_t)n, " %u", e.item);
+		}
+		if (e.item == want && found == 0) {
+			found = partition + at + (uint32_t)sizeof(e) + e.padding_header;
+			*size = e.size - e.padding_data;
+		}
+		at += (uint32_t)sizeof(e) + e.padding_header + e.size;
+	}
+	if (cacheline != 0 && !(cacheline & (cacheline - 1))) {
+		uint32_t back = ((uint32_t)sizeof(e) + cacheline - 1) & ~(cacheline - 1);
+
+		for (at = h.size - back; at > h.free_cached && at < h.size;) {
+			peek(partition + at, &e, sizeof(e));
+			if (e.canary != SMEM_CANARY || e.size > at) {
+				break;
+			}
+			if (list != NULL && n < (int)list_size - 16) {
+				n += snprintf(list + n, list_size - (size_t)n, " %uc", e.item);
+			}
+			if (e.item == want && found == 0) {
+				found = partition + at - e.size;
+				*size = e.size - e.padding_data;
+			}
+			if (e.size + back > at) {
+				break;
+			}
+			at -= e.size + back;
+		}
+	}
+	return found;
+}
+
+static uint32_t
+find_item(uint32_t want, uint32_t *size)
+{
+	return find_item_in(part_offset, part_cacheline, want, size, NULL, 0);
+}
+
+/* qcom_smem_alloc_private: an uncached item at the partition's mark, under the hardware lock */
+static bool
+alloc_item(uint32_t item, uint32_t bytes)
+{
+	struct partition_header h;
+	struct item_header e;
+	uint32_t size = (bytes + 7) & ~7u, need = (uint32_t)sizeof(e) + size, at, owner = 0;
+	bool made = false;
+
+	lck_mtx_lock(&redwood_smem_alloc_lock);
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr(mutex, MUTEX_APPS);
+		owner = rd(mutex);
+		if (owner == MUTEX_APPS) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	if (owner != MUTEX_APPS) {
+		say("the SMEM lock is held by %u for a second: item %u not made\n", owner, item);
+		lck_mtx_unlock(&redwood_smem_alloc_lock);
+		return false;
+	}
+	peek(part_offset, &h, sizeof(h));
+	for (at = sizeof(h); at < h.free_uncached && h.free_uncached <= h.free_cached;) {
+		peek(part_offset + at, &e, sizeof(e));
+		if (e.canary != SMEM_CANARY || e.item == item || e.size > h.size) {
+			break;
+		}
+		at += (uint32_t)sizeof(e) + e.padding_header + e.size;
+	}
+	if (at != h.free_uncached || at + need > h.free_cached) {
+		say("partition 0/2: entries end at +%#x, mark +%#x, cached mark +%#x: item %u not made\n", at, h.free_uncached,
+		    h.free_cached, item);
+	} else {
+		poke(part_offset + at, SMEM_CANARY | item << 16);
+		poke(part_offset + at + 4, size);
+		poke(part_offset + at + 8, size - bytes);
+		poke(part_offset + at + 12, 0);
+		poke(part_offset + __offsetof(struct partition_header, free_uncached), at + need);
+		made = true;
+	}
+	wr(mutex, 0);
+	lck_mtx_unlock(&redwood_smem_alloc_lock);
+	return made;
+}
+
+/* ---- SMP2P ---------------------------------------------------------------------------------------------------- */
+
+struct smp2p {
+	uint32_t magic, version;
+	uint16_t local, remote, total, valid;
+	uint32_t flags;
+	struct {
+		char name[16];
+		uint32_t value;
+	} entry[16];
+};
+#define SMP2P_MAGIC             0x504d5324
+#define SMP2P_AT_VERSION        4
+#define SMP2P_AT_HOSTS          8
+#define SMP2P_AT_COUNTS         12
+#define SMP2P_AT_NAME(i)        (20 + 20 * (i))
+#define SMP2P_AT_VALUE(i)       (36 + 20 * (i))
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+
+static uint32_t their_item, our_item;
+
+static bool
+their_words(struct smp2p *w)
+{
+	uint32_t size = 0;
+
+	if (their_item == 0) {
+		their_item = find_item(ITEM_SMP2P_THEIRS, &size);
+		if (their_item == 0 || size < sizeof(*w)) {
+			their_item = 0;
+			return false;
+		}
+	}
+	peek(their_item, w, sizeof(*w));
+	return w->magic == SMP2P_MAGIC;
+}
+
+static uint32_t
+slave_kernel(const struct smp2p *w)
+{
+	for (unsigned i = 0; i < w->valid && i < 16; i++) {
+		if (strncmp(w->entry[i].name, "slave-kernel", 16) == 0) {
+			return w->entry[i].value;
+		}
+	}
+	return 0;
+}
+
+static void
+show_words(const char *what, const struct smp2p *w)
+{
+	char line[256];
+	int n = 0;
+
+	line[0] = 0;
+	for (unsigned i = 0; i < w->valid && i < 16 && n < (int)sizeof(line) - 40; i++) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %.16s=%#x;", w->entry[i].name, w->entry[i].value);
+	}
+	say("%s: SMP2P v%u features %#x, %u -> %u, flags %#x, %u/%u entries:%s\n", what, w->version & 0xff, w->version >> 8,
+	    w->local, w->remote, w->flags, w->valid, w->total, line);
+}
+
+static void
+crash_reason(void)
+{
+	char text[81];
+	uint32_t size = 0, at = find_item(ITEM_CRASH_REASON, &size);
+
+	if (at == 0) {
+		uint32_t global = 0, cacheline = 0;
+
+		/* (Linux looks in the global partition too: the table's entry with hosts 0xfffe) */
+		for (uint32_t i = 0, count = rd(smem + SMEM_SIZE - 0x1000 + 8); i < count && i < 64; i++) {
+			struct toc_entry e;
+
+			peek(SMEM_SIZE - 0x1000 + 32 + i * (uint32_t)sizeof(e), &e, sizeof(e));
+			if (e.host0 == 0xfffe && e.host1 == 0xfffe) {
+				global = e.offset;
+				cacheline = e.cacheline;
+			}
+		}
+		at = find_item_in(global, cacheline, ITEM_CRASH_REASON, &size, NULL, 0);
+	}
+	if (at == 0 || size == 0) {
+		say("the DSP's last words (item %u): none\n", ITEM_CRASH_REASON);
+		return;
+	}
+	bzero(text, sizeof(text));
+	peek(at, text, LESSER(size, sizeof(text) - 1));
+	say("the DSP's last words (item %u, %u bytes): \"%s\"\n", ITEM_CRASH_REASON, size, text);
+}
+
+static void
+ring(uint32_t client, uint32_t signal)
+{
+	wr(ipcc + IPCC_SEND_ID, client << 16 | signal);
+}
+
+/* our item 429: made if missing (as Linux's smp2p probe), filled in: "master-kernel" = 0, version 1, restart acks */
+static bool
+our_item_ready(void)
+{
+	uint32_t size = 0, name[4] = { 0 };
+	struct smp2p ours;
+
+	our_item = find_item(ITEM_SMP2P_OURS, &size);
+	if (our_item == 0) {
+		if (!alloc_item(ITEM_SMP2P_OURS, (uint32_t)sizeof(struct smp2p))) {
+			return false;
+		}
+		our_item = find_item(ITEM_SMP2P_OURS, &size);
+		if (our_item == 0) {
+			say("item %u is not found where it was just made\n", ITEM_SMP2P_OURS);
+			return false;
+		}
+		say("our SMP2P item %u made at %#lx\n", ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	} else {
+		say("our SMP2P item %u is there at %#lx: filled in again\n", ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	}
+	for (uint32_t at = 0; at < sizeof(ours); at += 4) {
+		poke(our_item + at, 0);
+	}
+	poke(our_item, SMP2P_MAGIC);
+	poke(our_item + SMP2P_AT_HOSTS, HOST_APPS | HOST_ADSP << 16);
+	strlcpy((char *)name, "master-kernel", sizeof(name));
+	for (uint32_t w = 0; w < 4; w++) {
+		poke(our_item + SMP2P_AT_NAME(0) + 4 * w, name[w]);
+	}
+	poke(our_item + SMP2P_AT_COUNTS, 16 | 1u << 16);
+	poke(our_item + SMP2P_AT_VERSION, 1u << 8 | 1);        /* features: restart acks; version 1 */
+	ring(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+	peek(our_item, &ours, sizeof(ours));
+	show_words("our item", &ours);
+	return ours.magic == SMP2P_MAGIC;
+}
+
+static void
+our_stop_bit(bool on)
+{
+	poke(our_item + SMP2P_AT_VALUE(0), on ? 1 : 0);
+	ring(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+}
+
+/* ---- the always-on processor's mailbox (qcom_aoss.c) ------------------------------------------------------------ */
+
+#define QMP_MAGIC_VALUE         0x4d41494c
+#define QMP_UP                  0x0000ffffu
+#define QMP_DOWN                0xffff0000u
+#define QMP_THEIR_LINK          0x0c
+#define QMP_THEIR_CHANNEL       0x14
+#define QMP_OUR_LINK            0x24
+#define QMP_OUR_LINK_ACK        0x28
+#define QMP_OUR_CHANNEL         0x2c
+#define QMP_OUR_CHANNEL_ACK     0x30
+#define QMP_THEIR_LINK_ACK      0x10
+#define QMP_THEIR_CHANNEL_ACK   0x18
+#define QMP_OUR_BOX_SIZE        0x34
+#define QMP_OUR_BOX             0x38
+#define QMP_MSG_LEN             64
+
+static uint32_t our_box;
+
+static bool
+qmp_wait(uint32_t offset, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms; i++) {
+		if (rd(aoss + offset) == value) {
+			return true;
+		}
+		sleep_ms(1);
+	}
+	return rd(aoss + offset) == value;
+}
+
+static bool
+qmp_open(void)
+{
+	uint32_t box = rd(aoss + QMP_OUR_BOX), size = rd(aoss + QMP_OUR_BOX_SIZE);
+
+	if (rd(aoss) != QMP_MAGIC_VALUE || rd(aoss + 4) != 1 || size < QMP_MSG_LEN + 4 || box < 0x3c || box + size > 0x400 ||
+	    (box & 3)) {
+		say("AOSS mailbox: not one this knows (magic %#x, version %u, box %#x size %#x)\n", rd(aoss), rd(aoss + 4), box,
+		    size);
+		return false;
+	}
+	if (rd(aoss + QMP_OUR_LINK) == QMP_UP && rd(aoss + QMP_OUR_LINK_ACK) == QMP_UP && rd(aoss + QMP_OUR_CHANNEL) == QMP_UP &&
+	    rd(aoss + QMP_THEIR_CHANNEL) == QMP_UP && rd(aoss + QMP_OUR_CHANNEL_ACK) == QMP_UP) {
+		our_box = box;
+		say("AOSS mailbox: open already\n");
+		return true;
+	}
+	wr(aoss + QMP_THEIR_LINK_ACK, rd(aoss + QMP_THEIR_LINK));
+	wr(aoss + QMP_OUR_LINK, QMP_UP);
+	ring(IPCC_CLIENT_AOP, IPCC_SIGNAL_QMP);
+	if (!qmp_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		say("AOSS mailbox: our link not acknowledged\n");
+		wr(aoss + QMP_OUR_LINK, QMP_DOWN);
+		ring(IPCC_CLIENT_AOP, IPCC_SIGNAL_QMP);
+		return false;
+	}
+	wr(aoss + QMP_OUR_CHANNEL, QMP_UP);
+	ring(IPCC_CLIENT_AOP, IPCC_SIGNAL_QMP);
+	if (!qmp_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		say("AOSS mailbox: their channel does not open\n");
+		wr(aoss + QMP_OUR_CHANNEL, QMP_DOWN);
+		wr(aoss + QMP_OUR_LINK, QMP_DOWN);
+		ring(IPCC_CLIENT_AOP, IPCC_SIGNAL_QMP);
+		return false;
+	}
+	wr(aoss + QMP_THEIR_CHANNEL_ACK, QMP_UP);
+	ring(IPCC_CLIENT_AOP, IPCC_SIGNAL_QMP);
+	if (!qmp_wait(QMP_OUR_CHANNEL_ACK, QMP_UP, 1000)) {
+		say("AOSS mailbox: our channel not acknowledged\n");
+		return false;
+	}
+	our_box = box;
+	say("AOSS mailbox: opened\n");
+	return true;
+}
+
+static bool
+qmp_send(const char *text)
+{
+	uint32_t words[QMP_MSG_LEN / 4] = { 0 };
+	bool sent = false;
+
+	lck_mtx_lock(&redwood_aop_mailbox_lock);
+	if (our_box == 0 && !qmp_open()) {
+		goto out;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	if (rd(aoss + our_box) != 0) {
+		say("AOSS mailbox still holds %u bytes: \"%s\" not sent\n", rd(aoss + our_box), text);
+		goto out;
+	}
+	for (unsigned i = 0; i < QMP_MSG_LEN / 4; i++) {
+		wr(aoss + our_box + 4 + 4 * i, words[i]);
+	}
+	wr(aoss + our_box, QMP_MSG_LEN);
+	settle();
+	ring(IPCC_CLIENT_AOP, IPCC_SIGNAL_QMP);
+	sent = qmp_wait(our_box, 0, 1000);
+	if (!sent) {
+		wr(aoss + our_box, 0);
+	}
+	say("AOSS: \"%s\" %s\n", text, sent ? "taken" : "NOT TAKEN within a second");
+out:
+	lck_mtx_unlock(&redwood_aop_mailbox_lock);
+	return sent;
+}
+
+/* ---- RPMh: the rails lcx / lmx (cmd-db, rpmh-rsc) ------------------------------------------------------------------- */
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+/*
+ * cmd-db lies outside the kernel's RAM window, so its "write-combined" mapping is Device memory (pmap's wimg_to_pte):
+ * one byte at a time, never memcpy (its wide, unaligned loads fault there: the GPU kit's run ipad8)
+ */
+static void
+cmd_db_copy(void *to, const uint8_t *from, size_t n)
+{
+	for (size_t i = 0; i < n; i++) {
+		((uint8_t *)to)[i] = ((const volatile uint8_t *)from)[i];
+	}
+}
+
+/* address of a resource and (for a rail) its levels; *highest = the position of its highest level */
+static uint32_t
+cmd_db_lookup(const char *name, int *highest, char *levels, size_t levels_size)
+{
+	char id[8] = { 0 };
+	const uint8_t *data;                    /* after version, magic, 8 slave headers (16 bytes each), checksum, reserved */
+
+	if (!(cmd_db[4] == 0xdb && cmd_db[5] == 0x30 && cmd_db[6] == 0x03 && cmd_db[7] == 0x0c)) {
+		return 0;
+	}
+	memcpy(id, name, LESSER(strlen(name), sizeof(id)));
+	data = cmd_db + 8 + 8 * sizeof(struct cmd_db_slave) + 8;
+	for (unsigned s = 0; s < 8; s++) {
+		struct cmd_db_slave slave;
+
+		cmd_db_copy(&slave, cmd_db + 8 + s * sizeof(slave), sizeof(slave));
+		if (slave.id == 0 || slave.count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave.count; i++) {
+			struct cmd_db_entry e;
+
+			cmd_db_copy(&e, data + slave.header_offset + i * sizeof(e), sizeof(e));
+			if (memcmp(e.id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			if (highest != NULL) {
+				const uint8_t *lv = data + slave.data_offset + e.offset;
+				int n = 0;
+
+				*highest = -1;
+				/* every level, as rpmhpd_update_level_mapping (RPMH_ARC_MAX_LEVELS 32; gfx.lvl has more than 16) */
+				for (unsigned l = 0; l < e.length / 2u && l < 32; l++) {
+					unsigned v = lv[2 * l] | lv[2 * l + 1] << 8;
+
+					if (l > 0 && v == 0) {
+						break;
+					}
+					*highest = (int)l;
+					if (levels != NULL && n < (int)levels_size - 8) {
+						n += snprintf(levels + n, levels_size - (size_t)n, " %u", v);
+					}
+				}
+			}
+			return e.address;
+		}
+	}
+	return 0;
+}
+
+static struct {
+	uint32_t wait, control, status, enable, cmd, stride;
+} tcs = { 0x10, 0x14, 0x18, 0x1c, 0x30, 20 };
+#define TCS(r)                  (rsc + TCS_BASE + (r))
+#define TCS_IRQ_STATUS          (rsc + TCS_BASE + 0x04)
+#define TCS_IRQ_CLEAR           (rsc + TCS_BASE + 0x08)
+#define TCS_ACTIVE_MODE         (1u << 16)
+#define TCS_TRIGGER             (1u << 24)
+#define MSGID_WRITE_WAITED      (8u | 1u << 8 | 1u << 16)
+
+static uint32_t lcx_addr, lmx_addr;
+static int lcx_top, lmx_top;
+static bool rails_held;
+
+/* every use of TCS 0 (this file's and hakios_iceland_rpmh_vote's callers in other drivers) goes under this lock */
+static LCK_GRP_DECLARE(rpmh_lck_grp, "iceland-rpmh");
+static LCK_MTX_DECLARE(rpmh_lock, &rpmh_lck_grp);
+
+static bool rpmh_write_n_locked(const uint32_t *a, const uint32_t *v, unsigned n);
+
+/* n (1 or 2) commands through the active TCS 0, waited for (rpmh-rsc's __tcs_buffer_write + __tcs_set_trigger) */
+static bool
+rpmh_write_n(const uint32_t *a, const uint32_t *v, unsigned n)
+{
+	bool done;
+
+	lck_mtx_lock(&rpmh_lock);
+	done = rpmh_write_n_locked(a, v, n);
+	lck_mtx_unlock(&rpmh_lock);
+	return done;
+}
+
+static bool
+rpmh_write_n_locked(const uint32_t *a, const uint32_t *v, unsigned n)
+{
+	uint64_t began;
+	uint32_t done = 0, mask = (1u << n) - 1;
+
+	if (rd(TCS(tcs.status)) == 0) {
+		say("RPMh TCS 0 busy (control %#x): not asked\n", rd(TCS(tcs.control)));
+		return false;
+	}
+	wr(TCS_IRQ_CLEAR, 1);
+	for (unsigned i = 0; i < n; i++) {
+		wr(TCS(tcs.cmd + i * tcs.stride), MSGID_WRITE_WAITED);
+		wr(TCS(tcs.cmd + i * tcs.stride + 4), a[i]);
+		wr(TCS(tcs.cmd + i * tcs.stride + 8), v[i]);
+	}
+	wr(TCS(tcs.wait), mask);
+	wr(TCS(tcs.enable), mask);
+	settle();
+	wr(TCS(tcs.control), rd(TCS(tcs.control)) & ~TCS_TRIGGER);
+	wr(TCS(tcs.control), rd(TCS(tcs.control)) | TCS_ACTIVE_MODE);
+	wr(TCS(tcs.control), rd(TCS(tcs.control)) | TCS_TRIGGER);
+	for (began = now_us(); now_us() - began < 100000;) {
+		if ((done = rd(TCS_IRQ_STATUS) & 1) != 0) {
+			break;
+		}
+		delay_for_interval(50, NSEC_PER_USEC);
+	}
+	wr(TCS_IRQ_CLEAR, 1);
+	wr(TCS(tcs.control), rd(TCS(tcs.control)) & ~(TCS_TRIGGER | TCS_ACTIVE_MODE));
+	wr(TCS(tcs.enable), 0);
+	return done != 0;
+}
+
+/*
+ * ---- Exported RPMh regulator votes (for other iceland drivers, e.g. the WCN7860's power: kit 23c) ------------------
+ *   int hakios_iceland_rpmh_vote(const char *name, int32_t mode, uint32_t uv, bool enable);
+ *   int hakios_iceland_rpmh_release(const char *name);
+ * name = the cmd-db resource as rpmh-regulator builds it ("L15B_E0", "B1B_E0", "L2G_E0", "S1J_E1", ...: "%c%d%s"
+ * type letter, index, pmic-id for "_E" pmic-ids). As rpmh-regulator's requests, each one command, waited for, through
+ * the apps RSC's TCS 0 under rpmh_lock: mode >= 0 -> MODE (+8) = mode (the raw PMIC mode value rpmh-regulator sends:
+ * nldo530 LPM 4 / OPM 5 / HPM 7, BOB PFM 4 / AUTO 6 / PWM 7, SMPS ...), uv != 0 -> VOLTAGE (+0) = uv in mV (rounded
+ * up), then ENABLE (+4) = enable. release = ENABLE 0 only (this DRV's vote off; RPMh keeps the other DRVs' votes --
+ * but a vote the boot chain made on the apps DRV for the same resource goes too: callers decide). Every command is
+ * logged ("icedsp: RPMh vote: ..."). Returns 0, -1 (not in cmd-db: nothing sent), -2 (a command not done). Works
+ * before or without icedsp: the RSC and cmd-db are mapped on first use.
+ */
+static bool
+rpmh_ensure(void)
+{
+	if (rsc == 0) {
+		vm_offset_t r = ml_io_map(RSC_PHYS, 0x10000);
+
+		if (r == 0) {
+			return false;
+		}
+		if ((rd(r) >> 16 & 0xff) >= 3) {
+			tcs.wait = 0x20; tcs.control = 0x24; tcs.status = 0x28; tcs.enable = 0x2c; tcs.cmd = 0x34; tcs.stride = 24;
+		}
+		rsc = r;
+	}
+	if (cmd_db == NULL) {
+		cmd_db = (const uint8_t *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	}
+	return cmd_db != NULL;
+}
+
+int hakios_iceland_rpmh_vote(const char *name, int32_t mode, uint32_t uv, bool enable);
+int hakios_iceland_rpmh_release(const char *name);
+
+int
+hakios_iceland_rpmh_vote(const char *name, int32_t mode, uint32_t uv, bool enable)
+{
+	uint32_t addr, a, v;
+	bool ok = true;
+
+	lck_mtx_lock(&rpmh_lock);
+	if (!rpmh_ensure() || (addr = cmd_db_lookup(name, NULL, NULL, 0)) == 0) {
+		lck_mtx_unlock(&rpmh_lock);
+		say("RPMh vote: %s not in cmd-db (or no RSC): nothing sent\n", name);
+		return -1;
+	}
+	if (mode >= 0) {
+		a = addr + 8;
+		v = (uint32_t)mode;
+		ok &= rpmh_write_n_locked(&a, &v, 1);
+		say("RPMh vote: %s MODE (%#x) = %u: %s\n", name, a, v, ok ? "done" : "NOT DONE");
+	}
+	if (ok && uv != 0) {
+		a = addr;
+		v = (uv + 999) / 1000;
+		ok &= rpmh_write_n_locked(&a, &v, 1);
+		say("RPMh vote: %s VOLTAGE (%#x) = %u mV: %s\n", name, a, v, ok ? "done" : "NOT DONE");
+	}
+	if (ok) {
+		a = addr + 4;
+		v = enable ? 1 : 0;
+		ok &= rpmh_write_n_locked(&a, &v, 1);
+		say("RPMh vote: %s ENABLE (%#x) = %u: %s\n", name, a, v, ok ? "done" : "NOT DONE");
+	}
+	lck_mtx_unlock(&rpmh_lock);
+	return ok ? 0 : -2;
+}
+
+int
+hakios_iceland_rpmh_release(const char *name)
+{
+	return hakios_iceland_rpmh_vote(name, -1, 0, false);
+}
+
+/* a resource's cmd-db address (0 = not there, or no cmd-db); reads only: for a driver's survey before it votes */
+uint32_t hakios_iceland_rpmh_addr(const char *name);
+
+uint32_t
+hakios_iceland_rpmh_addr(const char *name)
+{
+	uint32_t addr;
+
+	lck_mtx_lock(&rpmh_lock);
+	addr = rpmh_ensure() ? cmd_db_lookup(name, NULL, NULL, 0) : 0;
+	lck_mtx_unlock(&rpmh_lock);
+	return addr;
+}
+
+/*
+ * scan45 (kit 34ux2, icewifi_uv=1 in the harvest driver): the same commands in the order Linux's regulator core and
+ * rpmh-regulator send them for a consumer's rail (set_machine_constraints: voltage, then the initial mode; the enable
+ * last) and UniXNU's WifiProbe sends them: VOLTAGE (+0) = mv (when mv != 0), MODE (+8) = mode (when mode >= 0), then
+ * ENABLE (+4) = enable (when enable >= 0). Each one command, waited for, logged as hakios_iceland_rpmh_vote's. mv is
+ * in mV as sent (no rounding here). A voltage-only command (34ux2's release) is hakios_iceland_rpmh_volt(name, mv)
+ * below. Returns 0, -1 (not in cmd-db: nothing sent), -2 (a command not done).
+ */
+int hakios_iceland_rpmh_vote_vme(const char *name, uint32_t mv, int32_t mode, int enable);
+int hakios_iceland_rpmh_volt(const char *name, uint32_t mv);
+
+int
+hakios_iceland_rpmh_vote_vme(const char *name, uint32_t mv, int32_t mode, int enable)
+{
+	uint32_t addr, a, v;
+	bool ok = true;
+
+	lck_mtx_lock(&rpmh_lock);
+	if (!rpmh_ensure() || (addr = cmd_db_lookup(name, NULL, NULL, 0)) == 0) {
+		lck_mtx_unlock(&rpmh_lock);
+		say("RPMh vote: %s not in cmd-db (or no RSC): nothing sent\n", name);
+		return -1;
+	}
+	if (mv != 0) {
+		a = addr;
+		v = mv;
+		ok &= rpmh_write_n_locked(&a, &v, 1);
+		say("RPMh vote: %s VOLTAGE (%#x) = %u mV: %s (scan45 order: voltage, mode, enable)\n", name, a, v,
+		    ok ? "done" : "NOT DONE");
+	}
+	if (ok && mode >= 0) {
+		a = addr + 8;
+		v = (uint32_t)mode;
+		ok &= rpmh_write_n_locked(&a, &v, 1);
+		say("RPMh vote: %s MODE (%#x) = %u: %s\n", name, a, v, ok ? "done" : "NOT DONE");
+	}
+	if (ok && enable >= 0) {
+		a = addr + 4;
+		v = enable ? 1 : 0;
+		ok &= rpmh_write_n_locked(&a, &v, 1);
+		say("RPMh vote: %s ENABLE (%#x) = %u: %s\n", name, a, v, ok ? "done" : "NOT DONE");
+	}
+	lck_mtx_unlock(&rpmh_lock);
+	return ok ? 0 : -2;
+}
+
+/* one VOLTAGE command only (mv may be 0: this DRV's voltage request taken back), nothing else */
+int
+hakios_iceland_rpmh_volt(const char *name, uint32_t mv)
+{
+	uint32_t addr, a, v;
+	bool ok;
+
+	lck_mtx_lock(&rpmh_lock);
+	if (!rpmh_ensure() || (addr = cmd_db_lookup(name, NULL, NULL, 0)) == 0) {
+		lck_mtx_unlock(&rpmh_lock);
+		say("RPMh vote: %s not in cmd-db (or no RSC): nothing sent\n", name);
+		return -1;
+	}
+	a = addr;
+	v = mv;
+	ok = rpmh_write_n_locked(&a, &v, 1);
+	lck_mtx_unlock(&rpmh_lock);
+	say("RPMh vote: %s VOLTAGE (%#x) = %u mV (voltage only): %s\n", name, a, v, ok ? "done" : "NOT DONE");
+	return ok ? 0 : -2;
+}
+
+static bool
+rpmh_write2(uint32_t a0, uint32_t v0, uint32_t a1, uint32_t v1)
+{
+	const uint32_t a[2] = { a0, a1 }, v[2] = { v0, v1 };
+
+	return rpmh_write_n(a, v, 2);
+}
+
+/*
+ * The crypto engine's bus clock (BCM "CE0", the only one on MASTER_CRYPTO's path that is not keep-alive: kaanapali.c
+ * icc-rpmh, qxm_crypto). Linux's qcom_scm votes the path MASTER_CRYPTO -> SLAVE_EBI1 (the scm node's interconnects)
+ * at peak UINT_MAX around every PAS call (qcom_scm_bw_enable/disable): TrustZone hashes and checks the images with the
+ * crypto engine, and without the vote its clock may be off -- a PAS call that never comes back. The command is
+ * bcm-voter's tcs_cmd_gen: commit (bit 30), valid (bit 29), vote_x (avg) 0, vote_y (peak) clipped to 0x3fff.
+ */
+#define BCM_COMMIT              (1u << 30)
+#define BCM_VALID               (1u << 29)
+#define BCM_VOTE_MAX            0x3fffu
+static uint32_t ce0_addr, lp0_addr;
+static bool ce_held, ce_wanted = true, lp0_held, lp0_wanted = true;
+
+/* one BCM at peak (up) or no vote (down), as tcs_cmd_gen; *held follows what RPMh took */
+static bool
+bcm_vote(const char *name, const char *what, uint32_t addr, bool up, bool *held)
+{
+	uint32_t v = up ? BCM_COMMIT | BCM_VALID | BCM_VOTE_MAX : BCM_COMMIT;
+	bool done;
+
+	if (!up && !*held) {
+		return true;
+	}
+	if (addr == 0) {
+		say("cmd-db has no %s: no %s vote\n", name, what);
+		return false;
+	}
+	done = rpmh_write_n(&addr, &v, 1);
+	say("RPMh: %s (%#x) = %#x (%s %s): %s\n", name, addr, v, what, up ? "on" : "released", done ? "done" : "NOT DONE");
+	*held = up && done;
+	return done;
+}
+
+static bool
+crypto_vote(bool up)
+{
+	return !ce_wanted || bcm_vote("CE0", "crypto engine bus", ce0_addr, up, &ce_held);
+}
+
+/*
+ * The DSP's own path to DDR: qcom_q6v5_prepare() sets the remoteproc node's interconnects (MASTER_LPASS_PROC ->
+ * SLAVE_EBI1, TAG_ALWAYS) to peak UINT_MAX before "load_state on", and qcom_q6v5_handover_interrupt() /
+ * qcom_q6v5_unprepare() set it back to 0. On that path (kaanapali.c: qnm_lpinoc_dsp_qns4m .. qns_lpi_aon_noc ..
+ * qnm_lpass_lpinoc / qns_lpass_aggnoc .. gem noc .. llcc .. ebi) BCM "LP0" is the only one that is not keep-alive,
+ * apart from ACV (DDR's one-hot "active" mask): SH0 and MC0 are keep-alive and already voted by the boot chain for
+ * the display, and are left alone, as is ACV (a release would take the boot chain's vote away too). data-a-live
+ * (same SoC, patch 0228): without this vote the DSP never says ready. icedsp_ddr=0: none.
+ */
+static bool
+lpass_bus_vote(bool up)
+{
+	return !lp0_wanted || bcm_vote("LP0", "LPASS bus to DDR", lp0_addr, up, &lp0_held);
+}
+
+/*
+ * Exported for other iceland drivers (the WCN7860 kit 23e2i: BCM "SN4", PCIe0 -> DDR): one BCM by its cmd-db name, at
+ * peak max (up) or no vote (down), the same command as CE0 / LP0 above. 0 done, -1 not in cmd-db, -2 not done.
+ */
+int hakios_iceland_rpmh_bcm(const char *name, bool up);
+
+int
+hakios_iceland_rpmh_bcm(const char *name, bool up)
+{
+	uint32_t addr = 0;
+	bool held = !up, done;
+
+	lck_mtx_lock(&rpmh_lock);
+	if (rpmh_ensure()) {
+		addr = cmd_db_lookup(name, NULL, NULL, 0);
+	}
+	lck_mtx_unlock(&rpmh_lock);
+	if (addr == 0) {
+		say("RPMh BCM: %s not in cmd-db (or no RSC): nothing sent\n", name);
+		return -1;
+	}
+	done = bcm_vote(name, "exported BCM", addr, up, &held);
+	return done ? 0 : -2;
+}
+
+/*
+ * 20y (hakios_iceland_cpu.c, icecpu_ddr): one BCM by its cmd-db name, a whole BCM_TCS_CMD word as the caller made it
+ * (commit, valid, AB, IB). It replaces this RSC's earlier vote on that BCM. 0 done, -1 not in cmd-db, -2 not done.
+ */
+int hakios_iceland_rpmh_bcm_cmd(const char *name, uint32_t cmd);
+
+int
+hakios_iceland_rpmh_bcm_cmd(const char *name, uint32_t cmd)
+{
+	uint32_t addr = 0;
+	bool done;
+
+	lck_mtx_lock(&rpmh_lock);
+	if (rpmh_ensure()) {
+		addr = cmd_db_lookup(name, NULL, NULL, 0);
+	}
+	lck_mtx_unlock(&rpmh_lock);
+	if (addr == 0) {
+		return -1;
+	}
+	done = rpmh_write_n(&addr, &cmd, 1);
+	return done ? 0 : -2;
+}
+
+/*
+ * 46cn4b G6 (the Wi-Fi omnibus, owner's yes 7 Nov): an ARC rail (e.g. "lmx.lvl") voted to the first level of its
+ * cmd-db table that is >= vlvl (rpmhpd's mapping of a corner value to a level index). Returns the level index sent,
+ * -1 not in cmd-db / no table, -2 not done. Never released here (RPMh takes the highest vote over all voters).
+ */
+int hakios_iceland_rpmh_arc(const char *name, uint32_t vlvl);
+
+int
+hakios_iceland_rpmh_arc(const char *name, uint32_t vlvl)
+{
+	char levels[256];
+	int highest = -1, idx = -1, n = 0;
+	uint32_t addr = 0, v, val[32];
+	bool done;
+
+	lck_mtx_lock(&rpmh_lock);
+	if (rpmh_ensure()) {
+		addr = cmd_db_lookup(name, &highest, levels, sizeof(levels));
+	}
+	if (addr == 0 || highest < 0) {
+		lck_mtx_unlock(&rpmh_lock);
+		say("RPMh ARC: %s not in cmd-db (or no level table): nothing sent\n", name);
+		return -1;
+	}
+	/* the table as text " v0 v1 ..." (cmd_db_lookup's form) back into numbers */
+	for (const char *p = levels; *p && n < 32;) {
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			break;
+		}
+		v = 0;
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (uint32_t)(*p++ - '0');
+		}
+		val[n++] = v;
+	}
+	for (int i = 0; i < n; i++) {
+		if (val[i] >= vlvl) {
+			idx = i;
+			break;
+		}
+	}
+	if (idx < 0) {
+		lck_mtx_unlock(&rpmh_lock);
+		say("RPMh ARC: %s levels%s: none >= %u: nothing sent\n", name, levels, vlvl);
+		return -1;
+	}
+	v = (uint32_t)idx;
+	done = rpmh_write_n_locked(&addr, &v, 1);
+	lck_mtx_unlock(&rpmh_lock);
+	say("RPMh ARC: %s (%#x) levels%s: level index %d (value %u, asked %u) sent: %s\n", name, addr, levels, idx, val[idx],
+	    vlvl, done ? "done" : "NOT DONE");
+	return done ? idx : -2;
+}
+
+static bool
+rails(bool up)
+{
+	bool done = rpmh_write2(lcx_addr, up ? (uint32_t)lcx_top : 0, lmx_addr, up ? (uint32_t)lmx_top : 0);
+
+	say("RPMh: lcx.lvl (%#x) = %d, lmx.lvl (%#x) = %d: %s\n", lcx_addr, up ? lcx_top : 0, lmx_addr, up ? lmx_top : 0,
+	    done ? "done" : "NOT DONE");
+	rails_held = up && done;
+	return done;
+}
+
+/* ---- TrustZone ---------------------------------------------------------------------------------------------------- */
+
+#define SCM_FN(svc, cmd)        ((1ull << 30) | (2ull << 24) | (uint64_t)(svc) << 8 | (cmd))
+#define SCM_PAS_INIT_IMAGE      SCM_FN(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_FN(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_FN(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_FN(2, 6)
+#define SCM_ARGS_VAL_RW         (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+#define SCM_WAITQ_SLEEP         2               /* qcom_scm.h: the call waits in TZ's wait queue (a1 = wq, a2 = call) */
+#define SCM_V2_EBUSY            (-12)
+#define SCM_WAITQ_RESUME        SCM_FN(0x24, 2) /* QCOM_SCM_SVC_WAITQ, QCOM_SCM_WAITQ_RESUME: (call context) */
+
+/*
+ * Every secure-world (SiP) call of our kernel goes through this one lock, as Linux's qcom_scm_lock serialises
+ * __scm_smc_do: two yielding calls in TZ at once leave one in TZ's wait queue (answer SCM_WAITQ_SLEEP), and a call
+ * left there is never finished -- every later call is answered 2 (data-a-live, same SoC, patch 0227). Users: this kit
+ * and the GPU kit (hakios_iceland_gpu.c, gpu_init_regs and the zap PAS calls). Not under it: PSCI (fast calls the
+ * hypervisor answers) and the hypervisor watchdog pet (owner 6); the dada-only drivers (redwood_adsp / _adreno / _wifi)
+ * stay off on this tablet.
+ */
+static LCK_GRP_DECLARE(hakios_iceland_scm_group, "iceland-scm");
+LCK_MTX_DECLARE(hakios_iceland_scm_lock, &hakios_iceland_scm_group);
+
+/* one SMC, the session register (x6) carried in and out (the QCOM_A6 quirk) */
+static uint64_t
+smc8(uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *session, uint64_t *r1,
+    uint64_t *r2)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a;
+	register uint64_t x3 __asm__("x3") = b;
+	register uint64_t x4 __asm__("x4") = c;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = *session;
+	register uint64_t x7 __asm__("x7") = 0;
+
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+	    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	*session = x6;
+	*r1 = x1;
+	*r2 = x2;
+	return x0;
+}
+
+/*
+ * As __scm_smc_do: under the lock, "interrupted" resumed with the same arguments, "wait queue" resumed with
+ * WAITQ_RESUME (polled every 10 ms for at most 3 s: this tablet's scm node has no wait-queue interrupt, so Linux
+ * never sleeps there either -- with the lock it should not happen at all), "busy" retried after 30 ms up to 20 times.
+ */
+/*
+ * try_only (a panic's rules: hakios_iceland_adsp_quiesce): the lock is only tried, never waited for -- held means a call
+ * is in TrustZone from a core that may be stopped, and another call now would be the one left in TZ's wait queue:
+ * nothing is called then (-2). The waits inside are delay_for_interval, which spins with interrupts off.
+ */
+static int32_t
+scm_do(const char *what, uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *answer,
+    bool try_only)
+{
+	uint64_t session = 0, r0 = 0, r1 = 0, r2 = 0;
+	int busy = 0;
+
+	do {
+		uint64_t f = fn, ai = arginfo, x2 = a, x3 = b, x4 = c;
+		int interrupted = 0, waits = 0;
+
+		if (!try_only) {
+			lck_mtx_lock(&hakios_iceland_scm_lock);
+		} else if (!lck_mtx_try_lock(&hakios_iceland_scm_lock)) {
+			say("TZ %s: another call holds TrustZone's lock: not called\n", what);
+			*answer = ~0ull;
+			return -2;
+		}
+		for (;;) {
+			r0 = smc8(f, ai, x2, x3, x4, &session, &r1, &r2);
+			if (r0 == SCM_INTERRUPTED && ++interrupted < 100) {
+				f = SCM_INTERRUPTED;
+				continue;
+			}
+			if (r0 == SCM_WAITQ_SLEEP && waits < 300) {
+				if (waits++ == 0) {
+					say("TZ %s: put in TZ's wait queue (wq %#llx, call %#llx): resumed every 10 ms\n", what, r1, r2);
+				}
+				delay_for_interval(10, NSEC_PER_MSEC);
+				f = SCM_WAITQ_RESUME;
+				ai = 1;
+				x2 = r2;
+				x3 = x4 = 0;
+				session = 0;
+				interrupted = 0;
+				continue;
+			}
+			break;
+		}
+		lck_mtx_unlock(&hakios_iceland_scm_lock);
+		if ((int32_t)r0 == SCM_V2_EBUSY && busy < 20) {
+			delay_for_interval(30, NSEC_PER_MSEC);
+		}
+	} while ((int32_t)r0 == SCM_V2_EBUSY && busy++ < 20);
+	*answer = r1;
+	say("TZ %s (%#llx, %#llx, %#llx): returns %d, answer %#llx\n", what, a, b, c, (int32_t)r0, r1);
+	return r0 == SCM_INTERRUPTED || r0 == SCM_WAITQ_SLEEP ? -1 : (int32_t)r0;
+}
+
+static int32_t
+scm(const char *what, uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *answer)
+{
+	return scm_do(what, fn, arginfo, a, b, c, answer, false);
+}
+
+static bool
+scm_ok(const char *what, uint64_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c)
+{
+	uint64_t answer = ~0ull;
+
+	return scm(what, fn, arginfo, a, b, c, &answer) == 0 && answer == 0;
+}
+
+/* ---- the images ---------------------------------------------------------------------------------------------------- */
+
+struct elf32_ehdr {
+	uint8_t ident[16];
+	uint16_t type, machine;
+	uint32_t version, entry, phoff, shoff, flags;
+	uint16_t ehsize, phentsize, phnum, shentsize, shnum, shstrndx;
+};
+struct elf32_phdr {
+	uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+};
+#define PH_IS_HASH(f)           (((f) >> 24 & 7) == 2)
+#define PH_RELOCATABLE          (1u << 27)
+#define MAX_PH                  80
+
+/*
+ * ---- the images' source: iceadsp_image() ----------------------------------------------------------------------------
+ * Every file the ADSP layer takes from outside the kernel comes through this one function: the two images today, the
+ * sensor tree's files (the FastRPC file server) once the delivery the owner picks exists. Today's source: /chosen's
+ * {physical address, size} pairs, "hakios,adsp-fw" / "hakios,adsp-dtb" (U-Boot + a loader of the iPadOS chain; the
+ * UniXNU chain's ADT has neither). The mapping is made once and kept (as image_find always did).
+ */
+static const struct {
+	const char *name, *prop;
+} iceadsp_chosen[] = { { "adsp.mbn", "hakios,adsp-fw" }, { "adsp_dtb.mbn", "hakios,adsp-dtb" } };
+static struct {
+	vm_offset_t va;
+	uint64_t pa, size;
+} iceadsp_chosen_map[sizeof(iceadsp_chosen) / sizeof(iceadsp_chosen[0])];
+
+/*
+ * The private pack (the owner's delivery (a); made by runs/w3-audio/scripts/mk-adsp-pack.py, linked by hakios-macos'
+ * xnu-build.sh as XNU_ADSP_PACK_OBJECT, strong over these weak empty defaults): "ICEADSP1", u32 count, u32 0, then per
+ * entry char name[48], u64 size, u64 zsize, u8 sha256[32] and one zlib stream padded to 8 -- adsp.mbn, adsp_dtb.mbn and
+ * sensors.tar (the sensor tree's sensors/, odm/, socinfo/ as ustar). It lies in __BOOTDATA, which the kernel gives back
+ * at lockdown: with icedsp=, iceadsp= or iceadsp_pack_test= it is copied out before (adsp_pack_keep, as icepcie's Wi-Fi
+ * pack), and each entry is inflated on its first use, checked against its sha256, and kept. No pack: /chosen as before.
+ */
+__attribute__((weak, visibility("hidden"))) const uint8_t native_adsp_pack[8] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t native_adsp_pack_size = 0;
+#define ADSP_PACK_ENTRIES       4
+static const uint8_t *adsp_pack;
+static uint64_t adsp_pack_len;
+static struct {
+	const uint8_t *data;
+	uint64_t size;
+	bool bad;
+} adsp_pack_out[ADSP_PACK_ENTRIES];
+
+static void
+adsp_pack_keep(void)
+{
+	uint32_t v = 0;
+	vm_offset_t va = 0;
+	uint64_t n = native_adsp_pack_size;
+
+	if (n == 0) {
+		return;
+	}
+	if (!(PE_parse_boot_argn("icedsp", &v, sizeof(v)) && v != 0) && !(PE_parse_boot_argn("iceadsp", &v, sizeof(v)) &&
+	    v != 0) && !(PE_parse_boot_argn("iceadsp_pack_test", &v, sizeof(v)) && v != 0) && !iceadsp_share_on()) {
+		printf("icedsp: pack: %llu B linked, not kept (no icedsp= / iceadsp= / iceadsp_pack_test=)\n", n);
+		return;
+	}
+	if (n < 16 || memcmp(native_adsp_pack, "ICEADSP1", 8) != 0) {
+		printf("icedsp: pack: %llu B linked, not one this knows: not kept\n", n);
+		return;
+	}
+	if (kmem_alloc(kernel_map, &va, round_page(n), KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("icedsp: pack: no memory for %llu B\n", n);
+		return;
+	}
+	memcpy((void *)va, native_adsp_pack, (size_t)n);
+	adsp_pack = (const uint8_t *)va;
+	adsp_pack_len = n;
+	printf("icedsp: pack kept: %llu B (out of __BOOTDATA before lockdown)\n", n);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, adsp_pack_keep);
+
+/* zlib's state from kalloc, its size in front (as kern_exec.c's addon inflate) */
+static voidpf
+adsp_zalloc(voidpf opaque __unused, uInt items, uInt size)
+{
+	size_t bytes = (size_t)items * size + 16;
+	uint8_t *block = kalloc_data(bytes, Z_WAITOK | Z_ZERO);
+
+	if (block == NULL) {
+		return Z_NULL;
+	}
+	memcpy(block, &bytes, sizeof(bytes));
+	return block + 16;
+}
+
+static void
+adsp_zfree(voidpf opaque __unused, voidpf address)
+{
+	uint8_t *block = (uint8_t *)address - 16;
+	size_t bytes = 0;
+
+	memcpy(&bytes, block, sizeof(bytes));
+	kfree_data(block, bytes);
+}
+
+/* entry name of the pack, inflated (once) and checked: false if absent or bad (adsp_pack_lock held) */
+static bool
+adsp_pack_entry_locked(const char *name, const uint8_t **ptr, uint64_t *len)
+{
+	uint64_t at = 16;
+	uint32_t count;
+
+	if (adsp_pack == NULL) {
+		return false;
+	}
+	memcpy(&count, adsp_pack + 8, 4);
+	for (uint32_t i = 0; i < count && i < ADSP_PACK_ENTRIES && at + 48 + 16 + 32 <= adsp_pack_len; i++) {
+		uint64_t size, zsize;
+		const uint8_t *h = adsp_pack + at;
+
+		memcpy(&size, h + 48, 8);
+		memcpy(&zsize, h + 56, 8);
+		if (h[47] != 0 || zsize > adsp_pack_len - at - 96) {
+			say("pack: entry %u is damaged: nothing more read\n", i);
+			return false;
+		}
+		if (strcmp((const char *)h, name) != 0) {
+			at += (96 + zsize + 7) & ~7ull;
+			continue;
+		}
+		if (adsp_pack_out[i].bad) {
+			return false;
+		}
+		if (adsp_pack_out[i].data == NULL) {
+			vm_offset_t va = 0;
+			z_stream zs;
+			uint8_t sum[SHA256_DIGEST_LENGTH];
+			SHA256_CTX ctx;
+			int rc;
+
+			if (size == 0 || size > 128ull * 1024 * 1024 || kmem_alloc(kernel_map, &va, round_page(size),
+			    KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+				say("pack: %s: no memory for %llu B\n", name, size);
+				adsp_pack_out[i].bad = true;
+				return false;
+			}
+			bzero(&zs, sizeof(zs));
+			zs.zalloc = adsp_zalloc;
+			zs.zfree = adsp_zfree;
+			zs.next_in = (Bytef *)(uintptr_t)(h + 96);
+			zs.avail_in = (uInt)zsize;
+			zs.next_out = (Bytef *)va;
+			zs.avail_out = (uInt)size;
+			rc = inflateInit(&zs);
+			if (rc == Z_OK) {
+				rc = inflate(&zs, Z_FINISH);
+				inflateEnd(&zs);
+			}
+			SHA256_Init(&ctx);
+			SHA256_Update(&ctx, (const void *)va, (size_t)size);
+			SHA256_Final(sum, &ctx);
+			if (rc != Z_STREAM_END || zs.total_out != size || memcmp(sum, h + 64, sizeof(sum)) != 0) {
+				say("pack: %s does not unpack as recorded (%d, %llu of %llu B, sha256 %s): not used\n", name, rc,
+				    (uint64_t)zs.total_out, size, memcmp(sum, h + 64, sizeof(sum)) ? "DIFFERS" : "ok");
+				kmem_free(kernel_map, va, round_page(size));
+				adsp_pack_out[i].bad = true;
+				return false;
+			}
+			adsp_pack_out[i].data = (const uint8_t *)va;
+			adsp_pack_out[i].size = size;
+			say("pack: %s: %llu B unpacked from %llu, sha256 %02x%02x%02x%02x... as recorded\n", name, size, zsize,
+			    sum[0], sum[1], sum[2], sum[3]);
+		}
+		*ptr = adsp_pack_out[i].data;
+		*len = adsp_pack_out[i].size;
+		return true;
+	}
+	return false;
+}
+
+static LCK_GRP_DECLARE(adsp_pack_grp, "iceadsp-pack");
+static LCK_MTX_DECLARE(adsp_pack_lock, &adsp_pack_grp);
+
+/* the same, one caller at a time (the kit's or service's thread, the file server, iceadsp_pack_test) */
+static bool
+adsp_pack_entry(const char *name, const uint8_t **ptr, uint64_t *len)
+{
+	bool ok;
+
+	lck_mtx_lock(&adsp_pack_lock);
+	ok = adsp_pack_entry_locked(name, ptr, len);
+	lck_mtx_unlock(&adsp_pack_lock);
+	return ok;
+}
+
+/* a member of the pack's sensors.tar (ustar: 512-byte headers, name at 0, size in octal at 124, prefix at 345) */
+static bool
+adsp_pack_tar_member(const char *name, const uint8_t **ptr, uint64_t *len)
+{
+	const uint8_t *tar;
+	uint64_t tlen, at = 0;
+
+	if (!adsp_pack_entry("sensors.tar", &tar, &tlen)) {
+		return false;
+	}
+	while (at + 512 <= tlen && tar[at] != 0) {
+		char full[256];
+		uint64_t size = 0;
+
+		for (int k = 124; k < 136 && tar[at + k] >= '0' && tar[at + k] <= '7'; k++) {
+			size = size * 8 + (uint64_t)(tar[at + k] - '0');
+		}
+		if (tar[at + 345] != 0) {
+			snprintf(full, sizeof(full), "%.155s/%.100s", (const char *)tar + at + 345, (const char *)tar + at);
+		} else {
+			snprintf(full, sizeof(full), "%.100s", (const char *)tar + at);
+		}
+		if (size > tlen - at - 512) {
+			return false;
+		}
+		if ((tar[at + 156] == '0' || tar[at + 156] == 0) && strcmp(full, name) == 0) {
+			*ptr = tar + at + 512;
+			*len = size;
+			return true;
+		}
+		at += 512 + ((size + 511) & ~511ull);
+	}
+	return false;
+}
+
+bool
+iceadsp_image(const char *name, const uint8_t **ptr, uint64_t *len)
+{
+	if (adsp_pack != NULL) {
+		if (adsp_pack_entry(name, ptr, len) || adsp_pack_tar_member(name, ptr, len)) {
+			return true;
+		}
+		if (strcmp(name, "adsp.mbn") == 0 || strcmp(name, "adsp_dtb.mbn") == 0) {
+			say("%s: not in the pack (or not usable): /chosen is asked\n", name);
+		}
+	}
+	for (size_t i = 0; i < sizeof(iceadsp_chosen) / sizeof(iceadsp_chosen[0]); i++) {
+		DTEntry chosen;
+		void const *prop = NULL;
+		unsigned int size = 0;
+		uint64_t words[2];
+
+		if (strcmp(name, iceadsp_chosen[i].name) != 0) {
+			continue;
+		}
+		if (iceadsp_chosen_map[i].va == 0) {
+			if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+			    SecureDTGetProperty(chosen, iceadsp_chosen[i].prop, &prop, &size) != kSuccess || size < 16) {
+				say("%s: no /chosen/%s (U-Boot did not load it, or the loader did not pass it)\n", name,
+				    iceadsp_chosen[i].prop);
+				return false;
+			}
+			memcpy(words, prop, 16);
+			if (words[0] == 0 || words[1] < 4096 || words[1] > 128ull * 1024 * 1024 || (words[0] & 0xfff)) {
+				say("%s: /chosen/%s = %#llx, %#llx: not usable\n", name, iceadsp_chosen[i].prop, words[0], words[1]);
+				return false;
+			}
+			/*
+			 * Plain RAM U-Boot wrote through its caches (and the loader wrote back): mapped cacheable, so the reads are
+			 * coherent with any line still cached and fast. (WCOMB outside the kernel's window would be Device memory.)
+			 * Still read a byte at a time (file_read / fbyte).
+			 */
+			iceadsp_chosen_map[i].va = ml_io_map_unmappable(words[0], (words[1] + 0x3fff) & ~0x3fffull,
+			    VM_WIMG_COPYBACK);
+			if (iceadsp_chosen_map[i].va == 0) {
+				return false;
+			}
+			iceadsp_chosen_map[i].pa = words[0];
+			iceadsp_chosen_map[i].size = words[1];
+			say("%s: /chosen/%s: %llu bytes at %#llx\n", name, iceadsp_chosen[i].prop, words[1], words[0]);
+		}
+		*ptr = (const uint8_t *)iceadsp_chosen_map[i].va;
+		*len = iceadsp_chosen_map[i].size;
+		return true;
+	}
+	return false;
+}
+
+/*
+ * ---- the DSP's two regions are not this kernel's RAM ----------------------------------------------------------------
+ * q6-adsp-dtb@a1380000 + 0x80000 and adspslpi@a1400000 + 0x5000000 (kaanapali.dtsi, no-map). On the UniXNU chain the
+ * loader's runs of memory outside the window start at 0xa6400000, the end of adspslpi (every run's "memory outside the
+ * span: run 0 0xa6400000"), and the window is at 0x8c0004000: the regions are neither. Checked before every PAS call
+ * that hands TrustZone a region (image_load): a page in the window or adopted outside it (pmap_valid_page, as icepcie's
+ * lowdma check) refuses the whole load, with nothing sent.
+ */
+extern unsigned long gPhysBase, gPhysSize;
+extern boolean_t pmap_valid_page(ppnum_t pn);
+
+static bool
+dsp_region_free(const char *name, uint64_t pa, uint64_t size)
+{
+	for (uint64_t a = pa & ~(uint64_t)PAGE_MASK; a < pa + size; a += PAGE_SIZE) {
+		if ((a >= gPhysBase && a < (uint64_t)gPhysBase + gPhysSize) || pmap_valid_page((ppnum_t)atop_64(a))) {
+			say("%s: REFUSED: its region %#llx + %#llx holds page %#llx, which is this kernel's memory (window %#lx + "
+			    "%#lx or adopted outside it): no PAS call\n", name, pa, size, a, gPhysBase, gPhysSize);
+			return false;
+		}
+	}
+	say("%s: region %#llx + %#llx checked page by page: not this kernel's memory (window %#lx + %#lx, no page adopted "
+	    "outside it)\n", name, pa, size, gPhysBase, gPhysSize);
+	return true;
+}
+
+struct image {
+	const char *name;
+	uint64_t pa, size;
+	vm_offset_t va;                 /* the file, mapped */
+	uint32_t pas;
+	uint64_t region, region_size;
+	struct elf32_phdr ph[MAX_PH];
+	uint32_t phnum, hash, min_addr, max_addr;
+	vm_offset_t meta;               /* the metadata buffer (meta_bytes(): contiguous pages), kept until the auth */
+	vm_offset_t meta_nc;            /* the same pages, non-cacheable: written only through this */
+	bool loaded;
+	bool pas_init;                  /* TrustZone took its init image: a PAS shutdown of its id is due (in the padding) */
+};
+static struct image main_image = { .name = "adsp.mbn", .pas = PAS_ADSP, .region = ADSP_MEM, .region_size = ADSP_MEM_SIZE };
+static struct image dtb_image = { .name = "adsp_dtb.mbn", .pas = PAS_ADSP_DTB, .region = DTB_MEM,
+	                          .region_size = DTB_MEM_SIZE };
+
+static uint8_t
+fbyte(const struct image *im, uint64_t at)
+{
+	return at < im->size ? *(volatile uint8_t *)(im->va + at) : 0;
+}
+
+static void
+file_read(const struct image *im, uint64_t at, void *to, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		((uint8_t *)to)[i] = fbyte(im, at + i);
+	}
+}
+
+static bool
+image_find(struct image *im)
+{
+	const uint8_t *file = NULL;
+	uint64_t len = 0;
+	struct elf32_ehdr eh;
+
+	if (!iceadsp_image(im->name, &file, &len)) {
+		return false;
+	}
+	im->va = (vm_offset_t)file;
+	im->size = len;
+	im->pa = 0;
+	for (size_t i = 0; i < sizeof(iceadsp_chosen) / sizeof(iceadsp_chosen[0]); i++) {
+		if (iceadsp_chosen_map[i].va == im->va) {
+			im->pa = iceadsp_chosen_map[i].pa;      /* (for the lines only) */
+		}
+	}
+	file_read(im, 0, &eh, sizeof(eh));
+	if (memcmp(eh.ident, "\177ELF\1\1", 6) != 0 || eh.phentsize != 32 || eh.phnum == 0 || eh.phnum > MAX_PH ||
+	    (uint64_t)eh.phoff + 32ull * eh.phnum > im->size) {
+		say("%s at %#llx (%llu bytes): not an ELF32 image this knows (phnum %u)\n", im->name, im->pa, im->size, eh.phnum);
+		return false;
+	}
+	im->phnum = eh.phnum;
+	im->hash = ~0u;
+	im->min_addr = ~0u;
+	im->max_addr = 0;
+	for (uint32_t i = 0; i < eh.phnum; i++) {
+		struct elf32_phdr *p = &im->ph[i];
+
+		file_read(im, eh.phoff + 32ull * i, p, 32);
+		if (PH_IS_HASH(p->flags)) {
+			im->hash = i;
+		} else if (p->type == 1 && p->memsz != 0) {
+			im->min_addr = LESSER(im->min_addr, p->paddr);
+			im->max_addr = GREATER(im->max_addr, p->paddr + p->memsz);
+			if (!(p->flags & PH_RELOCATABLE) || (uint64_t)p->offset + p->filesz > im->size) {
+				say("%s: segment %u is not relocatable or beyond the file\n", im->name, i);
+				return false;
+			}
+		}
+	}
+	im->max_addr = (im->max_addr + 0xfff) & ~0xfffu;
+	if (im->hash == ~0u || im->min_addr == ~0u || im->max_addr - im->min_addr > im->region_size ||
+	    (uint64_t)im->ph[im->hash].offset + im->ph[im->hash].filesz > im->size) {
+		say("%s: hash segment %u, span %#x..%#x: does not fit its region (%#llx)\n", im->name, im->hash, im->min_addr,
+		    im->max_addr, im->region_size);
+		return false;
+	}
+	say("%s: %llu bytes at %#llx, %u program headers, hash segment %u (%u bytes), span %#x..%#x -> region %#llx "
+	    "(%#x of %#llx)\n", im->name, im->size, im->pa, im->phnum, im->hash, im->ph[im->hash].filesz, im->min_addr,
+	    im->max_addr, im->region, im->max_addr - im->min_addr, im->region_size);
+	return true;
+}
+
+/*
+ * qcom_mdt_pas_init + qcom_mdt_load_no_init: metadata to TrustZone (init image), the region (mem setup), then, with
+ * `copy`, the segments copied in (and read back). m_init/m_mem/m_copy: the progress marks of the three steps.
+ * The metadata page: as qcom_scm_pas_init_image's dma_alloc_coherent buffer, written through a non-cacheable view only
+ * (TrustZone protects it during the call: a dirty cached line written back then is an XPU violation).
+ */
+/*
+ * The metadata buffer's size: the ELF header + program headers + hash segment, in whole pages. Tablet run w3-audio-1:
+ * adsp.mbn's is 8124 B (54 headers + a 6344-byte hash segment), more than the 4 KB page this used to be. Capped at
+ * 64 KB (qcom_mdt_read_metadata's are a few KB; a larger one is not an image this knows).
+ */
+#define META_MAX                0x10000u
+
+static vm_size_t
+meta_bytes(const struct image *im)
+{
+	return round_page((vm_size_t)(52 + 32 * im->phnum) + im->ph[im->hash].filesz);
+}
+
+static bool
+image_load(struct image *im, bool copy, unsigned m_init, unsigned m_mem, unsigned m_copy)
+{
+	uint32_t ehdr_size = 52 + 32 * im->phnum, hash_size = im->ph[im->hash].filesz, meta_size = ehdr_size + hash_size;
+	vm_size_t meta_alloc = meta_bytes(im);
+	vm_offset_t region;
+	uint64_t written = 0, wrong = 0;
+
+	if (meta_size > META_MAX) {
+		say("%s: metadata of %u bytes is more than %u: not an image this knows\n", im->name, meta_size, META_MAX);
+		mark(m_init, MARK_FAIL);
+		return false;
+	}
+	if (!dsp_region_free(im->name, im->region, im->region_size)) {
+		mark(m_init, MARK_FAIL);
+		return false;
+	}
+	/* physically contiguous, as qcom_scm_pas_init_image's dma_alloc_coherent buffer: TrustZone gets one address */
+	if (kmem_alloc_contig(kernel_map, &im->meta, meta_alloc, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		im->meta = 0;
+		say("%s: no contiguous %lu bytes for its metadata\n", im->name, (unsigned long)meta_alloc);
+		mark(m_init, MARK_FAIL);
+		return false;
+	}
+	for (vm_offset_t line = im->meta; line < im->meta + meta_alloc; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+	im->meta_nc = ml_io_map_unmappable((vm_offset_t)kvtophys(im->meta), meta_alloc, VM_WIMG_WCOMB);
+	if (im->meta_nc == 0) {
+		mark(m_init, MARK_FAIL);
+		return false;
+	}
+	file_read(im, 0, (void *)im->meta_nc, ehdr_size);
+	file_read(im, im->ph[im->hash].offset, (void *)(im->meta_nc + ehdr_size), hash_size);
+	settle();
+	mark(m_init, MARK_BUSY);
+	say("%s: metadata %u bytes (headers %u + hash %u) in %lu contiguous bytes at %#llx\n", im->name, meta_size, ehdr_size,
+	    hash_size, (unsigned long)meta_alloc, (uint64_t)kvtophys(im->meta));
+	if (!scm_ok("init image", SCM_PAS_INIT_IMAGE, SCM_ARGS_VAL_RW, im->pas, kvtophys(im->meta), 0)) {
+		say("%s: TrustZone does not take it\n", im->name);
+		mark(m_init, MARK_FAIL);
+		return false;
+	}
+	im->pas_init = true;
+	mark(m_init, MARK_OK);
+	mark(m_mem, MARK_BUSY);
+	if (!scm_ok("mem setup", SCM_PAS_MEM_SETUP, 3, im->pas, im->region, im->max_addr - im->min_addr)) {
+		say("%s: TrustZone does not take its region\n", im->name);
+		mark(m_mem, MARK_FAIL);
+		return false;
+	}
+	mark(m_mem, MARK_OK);
+	if (!copy) {
+		say("%s: accepted by TrustZone; not copied (this level)\n", im->name);
+		return true;
+	}
+	mark(m_copy, MARK_BUSY);
+	region = ml_io_map_unmappable(im->region, im->region_size, VM_WIMG_WCOMB);
+	if (region == 0) {
+		mark(m_copy, MARK_FAIL);
+		return false;
+	}
+	for (uint32_t i = 0; i < im->phnum; i++) {
+		const struct elf32_phdr *p = &im->ph[i];
+		vm_offset_t to;
+
+		if (p->type != 1 || PH_IS_HASH(p->flags) || p->memsz == 0) {
+			continue;
+		}
+		to = region + (p->paddr - im->min_addr);
+		for (uint32_t at = 0; at < p->memsz; at++) {
+			*(volatile uint8_t *)(to + at) = at < p->filesz ? fbyte(im, (uint64_t)p->offset + at) : 0;
+		}
+		written += p->memsz;
+	}
+	settle();
+	for (uint32_t i = 0; i < im->phnum; i++) {
+		const struct elf32_phdr *p = &im->ph[i];
+		vm_offset_t to = region + (p->paddr - im->min_addr);
+
+		if (p->type != 1 || PH_IS_HASH(p->flags) || p->memsz == 0) {
+			continue;
+		}
+		for (uint32_t at = 0; at < p->filesz; at++) {
+			wrong += *(volatile uint8_t *)(to + at) != fbyte(im, (uint64_t)p->offset + at);
+		}
+	}
+	ml_io_unmap(region, im->region_size);
+	say("%s: %llu bytes into %#llx, read back: %llu differ\n", im->name, written, im->region, wrong);
+	im->loaded = wrong == 0;
+	mark(m_copy, im->loaded ? MARK_OK : MARK_FAIL);
+	return im->loaded;
+}
+
+static void
+image_done(struct image *im)
+{
+	if (im->meta_nc != 0) {
+		ml_io_unmap(im->meta_nc, meta_bytes(im));
+		im->meta_nc = 0;
+	}
+	if (im->meta != 0) {
+		kmem_free(kernel_map, im->meta, meta_bytes(im));
+		im->meta = 0;
+	}
+}
+
+/* ---- all of it together ------------------------------------------------------------------------------------------- */
+
+/*
+ * ---- GLINK over SMEM with the DSP (levels 7-9) --------------------------------------------------------------------
+ * The DT's remoteproc_adsp glink-edge: qcom,remote-pid 2, label "lpass", IPCC client LPASS (3) signal GLINK_QMP (0)
+ * both ways. qcom_glink_smem_register (run by Linux as the remoteproc's subdevice, right after the start): item 478 =
+ * the descriptor (32 bytes: tx tail, tx head, rx tail, rx head), 479 = our fifo (16 KB, ours to make), 480 = the DSP's
+ * fifo (the DSP makes it; looked up when needed); our rx tail and tx head set to 0, then qcom_glink_native_probe sends
+ * VERSION 1 with feature INTENT_REUSE. qcom_glink_native_rx: 8-byte messages {cmd, param1, param2} + payload, all
+ * 8-aligned. Polled, no interrupt.
+ *   level 7: listen: version answered, the DSP's OPENs listed and left unanswered.
+ *   level 8: + the DSP's "IPCRTR", "adsp_apps" and "glink_ssr" answered as qcom_glink_rx_open + the drivers' endpoint
+ *            create do (OPEN_ACK with its id, then our OPEN with our id), and once the DSP acks ours, receive intents
+ *            offered as qcom_glink_announce_create (one INTENT message each) -- from one table of 48 intents of 1 KB
+ *            (data-a-live's lesson: 24 was too few), 24 / 16 / 8; data assembled, RX_DONE_W_REUSE; its intents kept for
+ *            our sends (RX_INTENT_REQ when none fits); our channels closed again at the end (qcom_glink_native_remove).
+ *   level 9: + QRTR on "IPCRTR" (net/qrtr: af_qrtr.c v1 header, ns.c): our HELLO from node 1 port CTRL to the DSP's
+ *            node (0xffffffff until known, as qrtr_hello_work), its HELLO taken, and the NEW_SERVER announcements its
+ *            name service sends to a new peer listed (service, instance, node, port). (A NEW_LOOKUP to a remote name
+ *            service is refused by ns.c -- lookups are a local client's -- so the announcements are the list.)
+ */
+#define ITEM_GLINK_DESC         478
+#define ITEM_GLINK_TX           479             /* SMEM_GLINK_NATIVE_XPRT_FIFO_0 */
+#define ITEM_GLINK_RX           480             /* SMEM_GLINK_NATIVE_XPRT_FIFO_1 */
+#define IPCC_SIGNAL_GLINK       0
+#define GD_TX_TAIL              0
+#define GD_TX_HEAD              4
+#define GD_RX_TAIL              8
+#define GD_RX_HEAD              12
+#define GLINK_TX_SIZE           16384u
+#define GLINK_RESERVE           16u
+#define G_FEATURE_INTENT_REUSE  1u
+#define G_INTENTS               48
+#define G_INTENT_SIZE           1024u
+#define G_CHANNELS              16
+#define G_REMOTE_INTENTS        160             /* (adsp_apps: the DSP offers 116 small ones: ipad17c) */
+enum {
+	GC_VERSION = 0, GC_VERSION_ACK = 1, GC_OPEN = 2, GC_CLOSE = 3, GC_OPEN_ACK = 4, GC_INTENT = 5, GC_RX_DONE = 6,
+	GC_INTENT_REQ = 7, GC_INTENT_REQ_ACK = 8, GC_TX_DATA = 9, GC_ZERO_COPY = 10, GC_CLOSE_ACK = 11, GC_TX_DATA_CONT = 12,
+	GC_READ_NOTIF = 13, GC_RX_DONE_REUSE = 14, GC_SIGNALS = 15,
+};
+
+struct gmsg {
+	uint16_t cmd, param1;
+	uint32_t param2;
+};
+
+struct gchan {
+	char name[33];
+	uint32_t rcid, lcid, prio, quota;       /* lcid 0: not answered */
+	bool closed, open_acked, offered, close_acked;
+	unsigned messages, ri_offered;
+	uint32_t ri_largest;            /* the largest intent the DSP has offered on it */
+	struct {
+		uint32_t id, size;
+		bool there, in_use;
+	} ri[G_REMOTE_INTENTS];
+};
+
+/* the channels this answers (level 8) and their share of the 48 intents (FastRPC's only with icefrpc >= 2) */
+static struct {
+	const char *name;
+	uint32_t intents;
+} g_wanted[] = { { "IPCRTR", 24 }, { "adsp_apps", 16 }, { "glink_ssr", 8 }, { "fastrpcglink-apps-dsp", 0 } };
+
+static uint32_t g_desc, g_tx, g_tx_size, g_rx, g_rx_size, g_features = G_FEATURE_INTENT_REUSE, g_heard, g_said;
+static uint32_t g_level, g_next_lcid = 1;
+static bool g_agreed, g_broken, g_closing;
+static struct gchan g_chan[G_CHANNELS];
+static unsigned g_nchan;
+static struct {
+	struct gchan *ch;
+	uint32_t fill;
+	uint8_t buf[G_INTENT_SIZE];
+} g_rxi[G_INTENTS];                     /* intent id = index + 1 */
+
+static void qrtr_rx(struct gchan *ch, const uint8_t *p, uint32_t len);
+static void gpr_rx(const uint8_t *p, uint32_t len);
+static void frpc_rx(const uint8_t *p, uint32_t len);
+
+static const char *
+g_name(unsigned c)
+{
+	static const char *const n[] = { "version", "version-ack", "open", "close", "open-ack", "intent", "rx-done",
+		                         "intent-req", "intent-req-ack", "data", "zero-copy", "close-ack", "data-cont",
+		                         "read-notif", "rx-done-reuse", "signals" };
+
+	return c < 16 ? n[c] : "?";
+}
+
+static uint32_t
+g_word(uint32_t offset)
+{
+	return rd(smem + offset);
+}
+
+static uint32_t
+g_avail(void)
+{
+	uint32_t head, tail, size = 0;
+
+	if (g_rx == 0) {
+		g_rx = find_item(ITEM_GLINK_RX, &size);
+		if (g_rx == 0) {
+			return 0;
+		}
+		g_rx_size = size;
+		say("GLINK: the DSP's fifo (item %u) at %#lx, %u bytes\n", ITEM_GLINK_RX, SMEM_PHYS + g_rx, g_rx_size);
+	}
+	head = g_word(g_desc + GD_RX_HEAD);
+	tail = g_word(g_desc + GD_RX_TAIL);
+	if (g_rx_size < 64 || head >= g_rx_size || tail >= g_rx_size) {
+		return 0;
+	}
+	return head >= tail ? head - tail : g_rx_size - tail + head;
+}
+
+static void
+g_peek(void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (g_word(g_desc + GD_RX_TAIL) + offset) % g_rx_size;
+
+	for (uint32_t i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = *(volatile uint8_t *)(smem + g_rx + (at + i) % g_rx_size);
+	}
+}
+
+static void
+g_advance(uint32_t count)
+{
+	poke(g_desc + GD_RX_TAIL, (g_word(g_desc + GD_RX_TAIL) + count) % g_rx_size);
+}
+
+/* a + b into our fifo, padded to 8, the head moved after the data, the DSP rung (glink_smem_tx_write + kick) */
+static bool
+g_write(const void *a, uint32_t al, const void *b, uint32_t bl)
+{
+	uint32_t head = g_word(g_desc + GD_TX_HEAD), tail = g_word(g_desc + GD_TX_TAIL), len = al + bl,
+	    padded = (len + 7) & ~7u, room;
+
+	if (head >= g_tx_size || tail >= g_tx_size) {
+		say("GLINK: our fifo's head %#x / tail %#x out of range: nothing sent\n", head, tail);
+		return false;
+	}
+	room = tail <= head ? g_tx_size - head + tail : tail - head;
+	if (room < padded + GLINK_RESERVE) {
+		say("GLINK: no room in our fifo (%u bytes free) for %u bytes\n", room, padded);
+		return false;
+	}
+	for (uint32_t i = 0; i < padded; i++) {
+		uint8_t v = i < al ? ((const uint8_t *)a)[i] : i < len ? ((const uint8_t *)b)[i - al] : 0;
+
+		*(volatile uint8_t *)(smem + g_tx + (head + i) % g_tx_size) = v;
+	}
+	settle();
+	poke(g_desc + GD_TX_HEAD, (head + padded) % g_tx_size);
+	ring(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+	g_said++;
+	return true;
+}
+
+static bool
+g_send(unsigned cmd, uint32_t p1, uint32_t p2, const void *more, uint32_t more_len)
+{
+	struct gmsg m = { (uint16_t)cmd, (uint16_t)p1, p2 };
+	bool sent = g_write(&m, sizeof(m), more, more_len);
+
+	if (!sent || (!g_quiet && !g_svc_quiet)) {
+		say("GLINK > %s %u %#x%s\n", g_name(cmd), p1, p2, sent ? "" : ": NOT SENT");
+	}
+	return sent;
+}
+
+static struct gchan *
+g_by_rcid(uint32_t rcid)
+{
+	for (unsigned i = 0; i < g_nchan; i++) {
+		if (g_chan[i].rcid == rcid && !g_chan[i].closed) {
+			return &g_chan[i];
+		}
+	}
+	return NULL;
+}
+
+static struct gchan *
+g_by_lcid(uint32_t lcid)
+{
+	for (unsigned i = 0; lcid != 0 && i < g_nchan; i++) {
+		if (g_chan[i].lcid == lcid) {
+			return &g_chan[i];
+		}
+	}
+	return NULL;
+}
+
+/* qcom_glink_rx_open (OPEN_ACK with its id) + qcom_glink_create_remote (our OPEN with our id and the name) */
+static void
+g_answer(struct gchan *ch, uint32_t quota)
+{
+	char name[40];
+	uint32_t name_len = (uint32_t)strlen(ch->name) + 1;
+
+	ch->lcid = g_next_lcid++;
+	ch->quota = quota;
+	(void)g_send(GC_OPEN_ACK, ch->rcid, 0, NULL, 0);
+	bzero(name, sizeof(name));
+	strlcpy(name, ch->name, sizeof(name));
+	(void)g_send(GC_OPEN, ch->lcid, name_len, name, (name_len + 7) & ~7u);
+	say("GLINK: \"%s\" answered: its channel %u, ours %u\n", ch->name, ch->rcid, ch->lcid);
+}
+
+/* qcom_glink_announce_create: the base set of intents, one INTENT message each */
+static void
+g_offer(struct gchan *ch)
+{
+	uint32_t given = 0;
+
+	for (uint32_t i = 0; i < G_INTENTS && given < ch->quota; i++) {
+		uint32_t w[2] = { G_INTENT_SIZE, i + 1 };
+
+		if (g_rxi[i].ch != NULL) {
+			continue;
+		}
+		g_rxi[i].ch = ch;
+		g_rxi[i].fill = 0;
+		if (!g_send(GC_INTENT, ch->lcid, 1, w, sizeof(w))) {
+			g_rxi[i].ch = NULL;
+			break;
+		}
+		given++;
+	}
+	ch->offered = true;
+	say("GLINK: \"%s\" IS OPEN both ways (ours %u, theirs %u): %u intents of %u bytes offered\n", ch->name, ch->lcid,
+	    ch->rcid, given, G_INTENT_SIZE);
+}
+
+/* one whole message on an open channel: QRTR at level 9, else shown */
+static void
+g_deliver(struct gchan *ch, const uint8_t *p, uint32_t len)
+{
+	ch->messages++;
+	if (g_level >= 9 && strcmp(ch->name, "IPCRTR") == 0) {
+		qrtr_rx(ch, p, len);
+		return;
+	}
+	if (g_level >= 10 && strcmp(ch->name, "adsp_apps") == 0) {
+		gpr_rx(p, len);
+		return;
+	}
+	if (g_level >= 10 && strcmp(ch->name, "fastrpcglink-apps-dsp") == 0) {
+		frpc_rx(p, len);
+		return;
+	}
+	say("GLINK: data on \"%s\", %u bytes: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x "
+	    "%02x\n", ch->name, len, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11], p[12], p[13],
+	    p[14], p[15]);
+}
+
+/* what the DSP has queued, as qcom_glink_native_rx */
+static void
+g_pump(void)
+{
+	while (!g_broken) {
+		struct gmsg m;
+		uint32_t avail = g_avail(), len = sizeof(m), w[2] = { 0, 0 };
+		struct gchan *ch;
+
+		if (avail < sizeof(m)) {
+			return;
+		}
+		g_peek(&m, 0, sizeof(m));
+		if (m.cmd == GC_OPEN) {
+			len += m.param2 & 0xffff;               /* (the upper half of param2 is the priority) */
+		} else if (m.cmd == GC_INTENT) {
+			len += 8 * m.param2;
+		} else if (m.cmd == GC_TX_DATA || m.cmd == GC_TX_DATA_CONT) {
+			if (avail < 16) {
+				return;
+			}
+			g_peek(w, 8, 8);
+			len = 16 + w[0];
+		}
+		len = (len + 7) & ~7u;
+		if (len > g_rx_size - 8) {
+			say("GLINK < %s %u %#x of %u bytes: not believed; nothing more is read\n", g_name(m.cmd), m.param1, m.param2,
+			    len);
+			g_broken = true;
+			return;
+		}
+		if (avail < len) {
+			return;
+		}
+		g_heard++;
+		if (m.cmd != GC_TX_DATA && m.cmd != GC_TX_DATA_CONT && m.cmd != GC_INTENT) {
+			chat("GLINK < %s %u %#x\n", g_name(m.cmd), m.param1, m.param2);
+		}
+		switch (m.cmd) {
+		case GC_VERSION:
+			g_advance(len);
+			if (m.param1 == 1) {
+				g_features &= m.param2;
+			}
+			if (m.param1 != 0) {
+				(void)g_send(GC_VERSION_ACK, 1, g_features, NULL, 0);
+			}
+			break;
+		case GC_VERSION_ACK:
+			g_advance(len);
+			if (m.param1 == 1 && m.param2 == g_features) {
+				if (!g_agreed) {
+					say("GLINK: VERSION 1 AGREED (features %#x)\n", g_features);
+				}
+				g_agreed = true;
+			} else if (m.param1 != 0) {
+				g_features &= m.param2;
+				(void)g_send(GC_VERSION, 1, g_features, NULL, 0);
+			}
+			break;
+		case GC_OPEN: {
+			char name[33];
+			uint32_t name_len = m.param2 & 0xffff, quota = 0;
+
+			bzero(name, sizeof(name));
+			g_peek(name, sizeof(m), name_len < sizeof(name) - 1 ? name_len : sizeof(name) - 1);
+			g_advance(len);
+			/*
+			 * (After our CLOSE the DSP acks, closes its side and opens the same name again with a new id -- its
+			 * service waits for a client again, as when a Linux driver unbinds: ipad16j. Not answered then.)
+			 */
+			for (unsigned i = 0; g_level >= 8 && !g_closing && i < sizeof(g_wanted) / sizeof(g_wanted[0]); i++) {
+				if (strcmp(name, g_wanted[i].name) == 0) {
+					quota = g_wanted[i].intents;
+				}
+			}
+			say("GLINK: THE DSP OPENS \"%s\" (its channel %u, priority %u)%s\n", name, m.param1, m.param2 >> 16,
+			    quota ? "" : g_closing ? ": we are closing, left unanswered (it waits for us again)" :
+			    ": left unanswered");
+			if (g_nchan < G_CHANNELS) {
+				ch = &g_chan[g_nchan++];
+				bzero(ch, sizeof(*ch));
+				strlcpy(ch->name, name, sizeof(ch->name));
+				ch->rcid = m.param1;
+				ch->prio = m.param2 >> 16;
+				if (quota != 0) {
+					g_answer(ch, quota);
+				}
+			}
+			break;
+		}
+		case GC_OPEN_ACK:
+			g_advance(len);
+			if ((ch = g_by_lcid(m.param1)) != NULL && !ch->open_acked) {
+				ch->open_acked = true;
+				if (!ch->offered) {
+					g_offer(ch);
+				}
+			}
+			break;
+		case GC_CLOSE:
+			g_advance(len);
+			if ((ch = g_by_rcid(m.param1)) != NULL) {
+				ch->closed = true;
+				say("GLINK: the DSP closes \"%s\"\n", ch->name);
+				for (unsigned i = 0; i < G_INTENTS; i++) {      /* its intents back to the table */
+					if (g_rxi[i].ch == ch) {
+						g_rxi[i].ch = NULL;
+					}
+				}
+			}
+			(void)g_send(GC_CLOSE_ACK, m.param1, 0, NULL, 0);
+			break;
+		case GC_CLOSE_ACK:
+			g_advance(len);
+			if ((ch = g_by_lcid(m.param1)) != NULL) {
+				ch->close_acked = true;
+			}
+			break;
+		case GC_INTENT:
+			ch = g_by_rcid(m.param1);
+			for (uint32_t i = 0; ch != NULL && i < m.param2; i++) {
+				uint32_t iw[2];
+
+				g_peek(iw, 8 + 8 * i, 8);
+				{
+					int slot = -1, smallest = -1;
+
+					for (unsigned n = 0; n < G_REMOTE_INTENTS && slot < 0; n++) {
+						if (!ch->ri[n].there || ch->ri[n].id == iw[1]) {
+							slot = (int)n;
+						} else if (!ch->ri[n].in_use &&
+						    (smallest < 0 || ch->ri[n].size < ch->ri[smallest].size)) {
+							smallest = (int)n;
+						}
+					}
+					if (slot < 0 && smallest >= 0 && ch->ri[smallest].size < iw[0]) {
+						slot = smallest;        /* (table full: a bigger one replaces the smallest free one) */
+					}
+					if (slot >= 0) {
+						ch->ri[slot].there = true;
+						ch->ri[slot].in_use = false;
+						ch->ri[slot].size = iw[0];
+						ch->ri[slot].id = iw[1];
+					}
+					if (iw[0] > ch->ri_largest) {
+						ch->ri_largest = iw[0];
+					}
+					ch->ri_offered++;
+				}
+			}
+			if (ch != NULL) {
+				uint32_t sz = 0;
+
+				if (m.param2 >= 1) {
+					g_peek(&sz, 8, 4);
+				}
+				say("GLINK < intent x%u on \"%s\" (first %u bytes; %u offered on it so far, largest %u)\n", m.param2,
+				    ch->name, sz, ch->ri_offered, ch->ri_largest);
+			}
+			g_advance(len);
+			break;
+		case GC_RX_DONE:
+		case GC_RX_DONE_REUSE:
+			ch = g_by_rcid(m.param1);
+			for (unsigned n = 0; ch != NULL && n < G_REMOTE_INTENTS; n++) {
+				if (ch->ri[n].there && ch->ri[n].id == m.param2) {
+					ch->ri[n].in_use = false;
+					ch->ri[n].there = m.cmd == GC_RX_DONE_REUSE;
+				}
+			}
+			g_advance(len);
+			break;
+		case GC_INTENT_REQ: {
+			/* qcom_glink_handle_intent_req: an intent of that size made and offered, then the answer */
+			uint32_t granted = 0;
+
+			g_advance(len);
+			ch = g_by_rcid(m.param1);
+			if (ch == NULL || ch->lcid == 0) {
+				say("GLINK: an intent request on a channel not answered (%u): ignored\n", m.param1);
+				break;
+			}
+			for (uint32_t i = 0; m.param2 <= G_INTENT_SIZE && i < G_INTENTS; i++) {
+				uint32_t iw[2] = { G_INTENT_SIZE, i + 1 };
+
+				if (g_rxi[i].ch == NULL) {
+					g_rxi[i].ch = ch;
+					g_rxi[i].fill = 0;
+					granted = g_send(GC_INTENT, ch->lcid, 1, iw, sizeof(iw));
+					break;
+				}
+			}
+			(void)g_send(GC_INTENT_REQ_ACK, ch->lcid, granted, NULL, 0);
+			break;
+		}
+		case GC_TX_DATA:
+		case GC_TX_DATA_CONT: {
+			uint32_t iid = m.param2, chunk = w[0], left = w[1];
+
+			ch = g_by_rcid(m.param1);
+			if (ch == NULL || iid == 0 || iid > G_INTENTS || g_rxi[iid - 1].ch != ch ||
+			    chunk > G_INTENT_SIZE - g_rxi[iid - 1].fill) {
+				say("GLINK < data of %u bytes on %u for intent %u: not one of ours or too much: dropped\n", chunk,
+				    m.param1, iid);
+				g_advance(len);
+				break;
+			}
+			g_peek(g_rxi[iid - 1].buf + g_rxi[iid - 1].fill, 16, chunk);
+			g_rxi[iid - 1].fill += chunk;
+			g_advance(len);
+			if (left == 0) {
+				uint32_t whole = g_rxi[iid - 1].fill;
+
+				g_rxi[iid - 1].fill = 0;
+				if (g_features & G_FEATURE_INTENT_REUSE) {
+					(void)g_send(GC_RX_DONE_REUSE, ch->lcid, iid, NULL, 0);
+				} else {
+					uint32_t iw[2] = { G_INTENT_SIZE, iid };
+
+					(void)g_send(GC_RX_DONE, ch->lcid, iid, NULL, 0);
+					(void)g_send(GC_INTENT, ch->lcid, 1, iw, sizeof(iw));
+				}
+				g_deliver(ch, g_rxi[iid - 1].buf, whole);
+			}
+			break;
+		}
+		case GC_READ_NOTIF:
+			g_advance(len);
+			ring(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+			break;
+		case GC_INTENT_REQ_ACK:
+		case GC_SIGNALS:
+			g_advance(len);
+			break;
+		default:
+			say("GLINK: a command this does not know (%u): nothing more is read\n", m.cmd);
+			g_broken = true;
+			return;
+		}
+	}
+}
+
+/* one message to the DSP on an open channel, in one of its intents (qcom_glink_tx + qcom_glink_request_intent) */
+static bool
+g_tx_data(struct gchan *ch, const void *data, uint32_t len)
+{
+	struct {
+		struct gmsg m;
+		uint32_t chunk, left;
+	} h;
+	int n = -1;
+
+	for (int pass = 0; pass < 2 && n < 0; pass++) {
+		for (unsigned i = 0; i < G_REMOTE_INTENTS; i++) {
+			if (ch->ri[i].there && !ch->ri[i].in_use && ch->ri[i].size >= len) {
+				n = (int)i;
+				break;
+			}
+		}
+		if (n < 0 && pass == 0) {
+			uint64_t t0 = now_us();
+
+			say("GLINK: %u bytes to send on \"%s\": no free intent of the DSP's fits (largest it has offered %u): "
+			    "asking for one (RX_INTENT_REQ)\n", len, ch->name, ch->ri_largest);
+
+			(void)g_send(GC_INTENT_REQ, ch->lcid, len, NULL, 0);
+			while (now_us() - t0 < 1000000ull && !g_broken) {
+				bool got = false;
+
+				g_pump();
+				for (unsigned i = 0; i < G_REMOTE_INTENTS; i++) {
+					got |= ch->ri[i].there && !ch->ri[i].in_use && ch->ri[i].size >= len;
+				}
+				if (got) {
+					break;
+				}
+				sleep_ms(2);
+			}
+		}
+	}
+	if (n < 0) {
+		say("GLINK: no intent of the DSP's for %u bytes on \"%s\": not sent\n", len, ch->name);
+		return false;
+	}
+	h.m.cmd = GC_TX_DATA;
+	h.m.param1 = (uint16_t)ch->lcid;
+	h.m.param2 = ch->ri[n].id;
+	h.chunk = len;
+	h.left = 0;
+	ch->ri[n].in_use = true;
+	if (!g_write(&h, sizeof(h), data, len)) {
+		ch->ri[n].in_use = false;
+		return false;
+	}
+	chat("GLINK > data, %u bytes on \"%s\" in its intent %u\n", len, ch->name, ch->ri[n].id);
+	return true;
+}
+
+/* qcom_glink_smem_register + the version qcom_glink_native_probe sends */
+static bool
+g_attach(void)
+{
+	uint32_t size = 0;
+
+	g_desc = find_item(ITEM_GLINK_DESC, &size);
+	if (g_desc == 0 && alloc_item(ITEM_GLINK_DESC, 32)) {
+		g_desc = find_item(ITEM_GLINK_DESC, &size);
+	}
+	if (g_desc == 0 || size != 32) {
+		say("GLINK: descriptor item %u: %s (%u bytes)\n", ITEM_GLINK_DESC, g_desc ? "of the wrong size" : "missing", size);
+		return false;
+	}
+	g_tx = find_item(ITEM_GLINK_TX, &g_tx_size);
+	if (g_tx == 0 && alloc_item(ITEM_GLINK_TX, GLINK_TX_SIZE)) {
+		g_tx = find_item(ITEM_GLINK_TX, &g_tx_size);
+	}
+	if (g_tx == 0 || g_tx_size < 1024) {
+		say("GLINK: our fifo item %u: %s (%u bytes)\n", ITEM_GLINK_TX, g_tx ? "too small" : "missing", g_tx_size);
+		return false;
+	}
+	say("GLINK: descriptor at %#lx (tx tail %#x head %#x, rx tail %#x head %#x), our fifo at %#lx, %u bytes\n",
+	    SMEM_PHYS + g_desc, g_word(g_desc + GD_TX_TAIL), g_word(g_desc + GD_TX_HEAD), g_word(g_desc + GD_RX_TAIL),
+	    g_word(g_desc + GD_RX_HEAD), SMEM_PHYS + g_tx, g_tx_size);
+	poke(g_desc + GD_RX_TAIL, 0);
+	poke(g_desc + GD_TX_HEAD, 0);
+	return g_send(GC_VERSION, 1, g_features, NULL, 0);
+}
+
+/* ---- QRTR on "IPCRTR" (level 9) ---- */
+#define QRTR_TYPE_DATA          1
+#define QRTR_TYPE_HELLO         2
+#define QRTR_TYPE_BYE           3
+#define QRTR_TYPE_NEW_SERVER    4
+#define QRTR_TYPE_DEL_SERVER    5
+#define QRTR_TYPE_DEL_CLIENT    6
+#define QRTR_TYPE_RESUME_TX     7
+#define QRTR_PORT_CTRL          0xfffffffeu
+#define QRTR_NODE_BCAST         0xffffffffu
+#define QRTR_OUR_NODE           1u              /* af_qrtr.c qrtr_local_nid */
+#define QRTR_OUR_PORT           0x4000u         /* level 11's client port (af_qrtr.c's first ephemeral port) */
+
+static uint32_t q_remote = QRTR_NODE_BCAST, q_packets, q_resume_node, q_resume_port, q_resume_due;
+static void ssc_qmi(const uint8_t *p, uint32_t len);
+/* the ADSP service's side of QRTR (iceadsp=1; see "the ADSP service" below) */
+static struct gchan *q_ch;              /* the service's IPCRTR channel (the kit's level 11 uses s_ch) */
+static void svc_server(uint32_t service, uint32_t instance, uint32_t node, uint32_t port, bool gone);
+static bool svc_packet(uint32_t node, uint32_t port, uint32_t dst_port, const uint8_t *data, uint32_t len, bool confirm);
+/* laneD: the share (iceadsp_share=1; see svc_shared_init) */
+extern int PE_iceland_laned(char id);
+static bool svc_shared(void);
+static void svc_shared_init(uint32_t kit);
+static void svc_shared_poll(struct gchan *ipcrtr);
+static void svc_shared_end(bool crashed);
+static void svc_shared_no_frpc(void);
+static bool q_hello_heard, q_hello_sent;
+static struct {
+	uint32_t service, instance, node, port;
+	bool gone;
+} q_srv[48];
+static unsigned q_nsrv;
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+/* qrtr_endpoint_post: a v1 or v2 header, then (control packets) struct qrtr_ctrl_pkt */
+static void
+qrtr_rx(__unused struct gchan *ch, const uint8_t *p, uint32_t len)
+{
+	uint32_t type, src_node, src_port, dst_node, dst_port, size, hl, confirm;
+	const uint8_t *c;
+
+	q_packets++;
+	if (len >= 32 && le32(p) == 1) {
+		type = le32(p + 4);
+		src_node = le32(p + 8);
+		src_port = le32(p + 12);
+		confirm = le32(p + 16);
+		size = le32(p + 20);
+		dst_node = le32(p + 24);
+		dst_port = le32(p + 28);
+		hl = 32;
+	} else if (len >= 16 && p[0] == 3) {
+		type = p[1];
+		confirm = p[2] & 1;
+		hl = 16 + p[3];
+		size = le32(p + 4);
+		src_node = le16(p + 8);
+		src_port = le16(p + 10);
+		dst_node = le16(p + 12);
+		dst_port = le16(p + 14);
+		src_port = src_port == 0xfffe ? QRTR_PORT_CTRL : src_port;
+		dst_port = dst_port == 0xfffe ? QRTR_PORT_CTRL : dst_port;
+	} else {
+		say("QRTR: a packet of %u bytes with version %#x: not known\n", len, len >= 4 ? le32(p) : 0);
+		return;
+	}
+	if (hl > len || size > len - hl) {
+		say("QRTR: header %u + %u bytes in a packet of %u: dropped\n", hl, size, len);
+		return;
+	}
+	c = p + hl;
+	switch (type) {
+	case QRTR_TYPE_HELLO:
+		say("QRTR < HELLO from node %u port %#x (to %u:%#x)\n", src_node, src_port, dst_node, dst_port);
+		q_hello_heard = true;
+		q_remote = src_node;
+		break;
+	case QRTR_TYPE_NEW_SERVER:
+	case QRTR_TYPE_DEL_SERVER:
+		if (size >= 20) {
+			uint32_t service = le32(c + 4), instance = le32(c + 8), node = le32(c + 12), port = le32(c + 16);
+			unsigned i;
+
+			say("QRTR < %s: service %u (%#x) instance %u (version %u, instance %u) node %u port %u\n",
+			    type == QRTR_TYPE_NEW_SERVER ? "NEW_SERVER" : "DEL_SERVER", service, service, instance, instance & 0xff,
+			    instance >> 8, node, port);
+			for (i = 0; i < q_nsrv; i++) {
+				if (q_srv[i].service == service && q_srv[i].instance == instance && q_srv[i].node == node &&
+				    q_srv[i].port == port) {
+					break;
+				}
+			}
+			if (i == q_nsrv && q_nsrv < sizeof(q_srv) / sizeof(q_srv[0])) {
+				q_srv[q_nsrv].service = service;
+				q_srv[q_nsrv].instance = instance;
+				q_srv[q_nsrv].node = node;
+				q_srv[q_nsrv].port = port;
+				q_nsrv++;
+			}
+			if (i < q_nsrv) {
+				q_srv[i].gone = type == QRTR_TYPE_DEL_SERVER;
+			}
+			svc_server(service, instance, node, port, type == QRTR_TYPE_DEL_SERVER);
+		}
+		break;
+	case QRTR_TYPE_BYE:
+	case QRTR_TYPE_DEL_CLIENT:
+		say("QRTR < %s from node %u (client %u:%u)\n", type == QRTR_TYPE_BYE ? "BYE" : "DEL_CLIENT", src_node,
+		    size >= 12 ? le32(c + 4) : 0, size >= 12 ? le32(c + 8) : 0);
+		break;
+	case QRTR_TYPE_RESUME_TX:
+		break;
+	case QRTR_TYPE_DATA:
+		if (svc_packet(src_node, src_port, dst_port, c, size, confirm != 0)) {
+			break;
+		}
+		if (dst_port == QRTR_OUR_PORT && g_level >= 11) {
+			if (confirm) {
+				q_resume_node = src_node;           /* (sent from the listen loop, not from inside the pump) */
+				q_resume_port = src_port;
+				q_resume_due++;
+			}
+			ssc_qmi(c, size);
+			break;
+		}
+		say("QRTR < data from %u:%#x to %u:%#x, %u bytes: not ours, dropped\n", src_node, src_port, dst_node, dst_port,
+		    size);
+		break;
+	default:
+		say("QRTR < type %u from %u:%#x to %u:%#x, %u bytes%s: not ours, dropped\n", type, src_node, src_port, dst_node,
+		    dst_port, size, confirm ? " (confirm asked)" : "");
+		break;
+	}
+}
+
+/* qrtr_hello_work: HELLO from our node's control port to the DSP's (its node, or 0xffffffff while unknown) */
+static bool
+qrtr_hello(struct gchan *ch)
+{
+	uint8_t pkt[52];
+	uint32_t *w = (uint32_t *)pkt;
+
+	bzero(pkt, sizeof(pkt));
+	w[0] = 1;                               /* QRTR_PROTO_VER_1 */
+	w[1] = QRTR_TYPE_HELLO;
+	w[2] = QRTR_OUR_NODE;
+	w[3] = QRTR_PORT_CTRL;
+	w[4] = 0;                               /* confirm_rx */
+	w[5] = 20;                              /* sizeof(struct qrtr_ctrl_pkt) */
+	w[6] = q_remote;
+	w[7] = QRTR_PORT_CTRL;
+	w[8] = QRTR_TYPE_HELLO;                 /* pkt->cmd */
+	if (!g_tx_data(ch, pkt, sizeof(pkt))) {
+		return false;
+	}
+	q_hello_sent = true;
+	say("QRTR > HELLO from node %u to node %#x\n", QRTR_OUR_NODE, q_remote);
+	return true;
+}
+
+/*
+ * ---- GPR on "adsp_apps" (level 10): the AudioReach APM's state, then PRM -------------------------------------------
+ * The DT's gpr node: qcom,glink-channels "adsp_apps", qcom,domain GPR_DOMAIN_ID_ADSP (2); services q6apm (reg 1 =
+ * GPR_APM_MODULE_IID) and q6prm (reg 2). apr.h struct gpr_hdr: word 0 = version 0 (4 bits) | header size 6 words
+ * (4 bits) << 4 | packet size << 8; word 1 = dest domain | src domain << 8 (APPS 3); src port, dest port, token, opcode.
+ * q6apm_get_apm_state: audioreach_alloc_apm_cmd_pkt(0, APM_CMD_GET_SPF_STATE) = header + struct apm_cmd_header (16
+ * bytes, payload size 0), src port GPR_APM_MODULE_IID, dest port APM_MODULE_INSTANCE_ID; the answer
+ * APM_CMD_RSP_GET_SPF_STATE carries the state in its first word (q6apm_callback; non-zero = ready). The first query is
+ * sent again after 1 s if unanswered (data-a-live, same SoC: the first is often lost). q6prm only requests / releases
+ * resources (clocks, LPR); "no change" = APM_CMD_GET_CFG to the PRM module for PARAM_ID_RSC_HW_CORE (q6prm's own
+ * param, hw block 0): any answer (data or GPR_BASIC_RSP_RESULT with a status) shows PRM serving. icedsp_prm=0: not sent.
+ */
+#define GPR_DOMAIN_ADSP         2
+#define GPR_DOMAIN_APPS         3
+#define GPR_APM_IID             1
+#define GPR_PRM_IID             2
+#define GPR_BASIC_RSP_RESULT    0x02001005u
+#define GPR_BASIC_EVT_ACCEPTED  0x02001006u
+#define APM_CMD_GET_SPF_STATE   0x01001021u
+#define APM_CMD_RSP_GET_SPF_STATE 0x02001007u
+#define APM_CMD_GET_CFG         0x01001007u
+#define APM_CMD_RSP_GET_CFG     0x02001000u
+#define PARAM_ID_RSC_HW_CORE    0x08001032u
+
+static uint32_t gpr_apm_answers, gpr_apm_state = ~0u, gpr_prm_answers, gpr_prm_opcode, gpr_prm_status = ~0u, gpr_packets;
+/* the last packet, for the synchronous calls of the audio level (gpr_call) */
+static volatile uint32_t gpr_rx_seq, gpr_rx_opcode, gpr_rx_w0, gpr_rx_w1;
+/*
+ * Level D: the WR_SHARED_MEM_EP's "buffer done" events (q6apm.c graph_callback: DATA_CMD_RSP_WR_SH_MEM_EP_DATA_BUFFER_DONE
+ * (_V2) = {buf_addr_lsw, buf_addr_msw, mem_map_handle, status, ...}), kept in order for the feeding loop
+ */
+#define DATA_RSP_WR_DONE        0x05001000u
+#define DATA_RSP_WR_DONE_V2     0x05001004u
+static struct {
+	uint32_t lsw, status;
+} tone_done_ring[64];
+static uint32_t tone_done_in, tone_done_out;
+/*
+ * 17r2: the RD_SHARED_MEM_EP's "buffer filled" answers (q6apm.c graph_callback DATA_CMD_RSP_RD_SH_MEM_EP_DATA_BUFFER_V2 =
+ * struct data_cmd_rsp_rd_sh_mem_ep_data_buffer_done_v2 {status, buf_addr_lsw, buf_addr_msw, mem_map_handle, data_size,
+ * offset, timestamp_lsw, timestamp_msw, flags, num_frames, ...}; the GPR token = the buffer index q6apm_read sent)
+ */
+#define DATA_RSP_RD_DONE_V2     0x05001005u
+static struct {
+	uint32_t token, status, lsw, msw, size, offset, frames, flags;
+} mic_rd_ring[32];
+static uint32_t mic_rd_in, mic_rd_out;
+
+static void
+gpr_rx(const uint8_t *p, uint32_t len)
+{
+	uint32_t w0, hdr_words, pkt_size, src_port, dst_port, token, opcode, pl;
+	const uint8_t *q;
+
+	gpr_packets++;
+	if (len < 24) {
+		say("GPR < %u bytes: too short\n", len);
+		return;
+	}
+	w0 = le32(p);
+	hdr_words = (w0 >> 4) & 0xf;
+	pkt_size = w0 >> 8;
+	src_port = le32(p + 8);
+	dst_port = le32(p + 12);
+	token = le32(p + 16);
+	opcode = le32(p + 20);
+	if (hdr_words < 6 || pkt_size != len || hdr_words * 4 > len) {
+		say("GPR < bad header %#x (%u words, %u bytes) in %u bytes\n", w0, hdr_words, pkt_size, len);
+		return;
+	}
+	q = p + hdr_words * 4;
+	pl = len - hdr_words * 4;
+	if ((opcode == DATA_RSP_WR_DONE_V2 || opcode == DATA_RSP_WR_DONE) && pl >= 16) {
+		if (tone_done_in - tone_done_out < 64) {
+			tone_done_ring[tone_done_in % 64].lsw = le32(q);
+			tone_done_ring[tone_done_in % 64].status = le32(q + 12);
+			tone_done_in++;
+		}
+		chat("GPR < buffer done %#x status %#x (token %#x)\n", le32(q), le32(q + 12), token);
+		return;
+	}
+	if (opcode == DATA_RSP_RD_DONE_V2 && pl >= 40) {
+		if (mic_rd_in - mic_rd_out < 32) {
+			mic_rd_ring[mic_rd_in % 32].token = token;
+			mic_rd_ring[mic_rd_in % 32].status = le32(q);
+			mic_rd_ring[mic_rd_in % 32].lsw = le32(q + 4);
+			mic_rd_ring[mic_rd_in % 32].msw = le32(q + 8);
+			mic_rd_ring[mic_rd_in % 32].size = le32(q + 16);
+			mic_rd_ring[mic_rd_in % 32].offset = le32(q + 20);
+			mic_rd_ring[mic_rd_in % 32].flags = le32(q + 32);
+			mic_rd_ring[mic_rd_in % 32].frames = le32(q + 36);
+			mic_rd_in++;
+		}
+		chat("GPR < read done %#x status %#x size %u (token %#x)\n", le32(q + 4), le32(q), le32(q + 16), token);
+		return;
+	}
+	chat("GPR < opcode %#x from port %u (domain %u) to %u, token %u, %u payload bytes: %#x %#x %#x %#x\n", opcode,
+	    src_port, p[5], dst_port, token, pl, pl >= 4 ? le32(q) : 0, pl >= 8 ? le32(q + 4) : 0, pl >= 12 ? le32(q + 8) : 0,
+	    pl >= 16 ? le32(q + 12) : 0);
+	gpr_rx_opcode = opcode;
+	gpr_rx_w0 = pl >= 4 ? le32(q) : 0;
+	gpr_rx_w1 = pl >= 8 ? le32(q + 4) : 0;
+	gpr_rx_seq++;
+	if (opcode == APM_CMD_RSP_GET_SPF_STATE && pl >= 4) {
+		gpr_apm_answers++;
+		gpr_apm_state = le32(q);
+		say("GPR: THE APM ANSWERS: SPF state %u (%s)\n", gpr_apm_state, gpr_apm_state ? "ready" : "not ready");
+	} else if (src_port == GPR_PRM_IID || dst_port == GPR_PRM_IID) {
+		gpr_prm_answers++;
+		gpr_prm_opcode = opcode;
+		if (opcode == GPR_BASIC_RSP_RESULT && pl >= 8) {
+			gpr_prm_status = le32(q + 4);
+		} else if (opcode == APM_CMD_RSP_GET_CFG && pl >= 4) {
+			gpr_prm_status = le32(q);
+		}
+		say("GPR: THE PRM ANSWERS: opcode %#x, status %#x\n", opcode, gpr_prm_status);
+	}
+}
+
+/* one GPR packet: the header, an apm_cmd_header (payload size `extra`), `extra` bytes */
+static bool
+gpr_send(struct gchan *ch, uint32_t src_port, uint32_t dst_port, uint32_t opcode, const void *extra, uint32_t extra_len)
+{
+	uint8_t pkt[640];       /* (level D's stream GRAPH_OPEN: 24 + 16 + 512) */
+	uint32_t *w = (uint32_t *)pkt, size = 24 + 16 + extra_len;
+
+	if (size > sizeof(pkt)) {
+		return false;
+	}
+	bzero(pkt, sizeof(pkt));
+	w[0] = 0 | 6u << 4 | size << 8;
+	w[1] = GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8;
+	w[2] = src_port;
+	w[3] = dst_port;
+	w[4] = 0;                       /* token */
+	w[5] = opcode;
+	w[9] = extra_len;               /* apm_cmd_header.payload_size (address and map handle 0: in band) */
+	if (extra_len != 0) {
+		memcpy(pkt + 40, extra, extra_len);
+	}
+	if (!g_tx_data(ch, pkt, size)) {
+		return false;
+	}
+	chat("GPR > opcode %#x from port %#x to %#x, %u bytes\n", opcode, src_port, dst_port, size);
+	return true;
+}
+
+static bool
+gpr_apm_query(struct gchan *ch)
+{
+	return gpr_send(ch, GPR_APM_IID, GPR_APM_IID, APM_CMD_GET_SPF_STATE, NULL, 0);
+}
+
+static bool
+gpr_prm_query(struct gchan *ch)
+{
+	uint32_t param[5] = { GPR_PRM_IID, PARAM_ID_RSC_HW_CORE, 4, 0, 0 };    /* apm_module_param_data + hw block 0 */
+
+	return gpr_send(ch, GPR_PRM_IID, GPR_PRM_IID, APM_CMD_GET_CFG, param, sizeof(param));
+}
+
+/*
+ * ---- Sensors over the SNS client service (level 11) -------------------------------------------------------------
+ * QMI service 400 (0x190, QMI_SERVICE_SSC) at the DSP's node 5, port from its NEW_SERVER (19 in ipad16j). Our QRTR
+ * client port QRTR_OUR_PORT (an ephemeral port as af_qrtr.c's first, 0x4000 on). QMI over QRTR (qmi_interface.c):
+ * 7-byte header {u8 type (0 request, 2 response, 4 indication), u16 txn, u16 msg id, u16 length} + TLVs {u8 type,
+ * u16 length, value}. The SSC messages, as libqmi encodes them (read from Fedora's libqmi-glib: qmi_client_ssc_control
+ * builds message 0x20 with TLV 0x01 = u16 length + bytes and TLV 0x10 = u8 report type; indications 0x21 (small) /
+ * 0x22 (large) carry TLV 0x01 = u64 client id, TLV 0x02 = u16 length + bytes). The bytes are protobuf messages
+ * (interface facts from libssc's .proto files, field numbers only -- no libssc code, it is GPL-3.0):
+ *   SscClientRequest {1 uid {1 fixed64 low, 2 fixed64 high}, 2 fixed32 msg_id, 3 config {1 processor = 1 (APPS),
+ *   2 suspend_mode = 0}, 4 request {2 bytes msg}}; SscClientResponse {1 uid, 2 repeated {1 fixed32 msg_id,
+ *   2 fixed64 timestamp (19.2 MHz), 3 bytes msg}}. SUID sensor uid 0xabab...ab both halves; msg 512 = SUID request
+ *   {1 string data_type, 2 bool enable_updates = 0, 3 bool only_default_values = 1}, answered by 768 {1 data_type,
+ *   2 repeated uid}; 513 = enable continuous {1 float sample_rate} (answer 768 = config), 10 = disable, 1025 =
+ *   measurement; accel {1 repeated float acceleration m/s^2 [x, y, z], 2 int32 accuracy}.
+ * Steps: SUID for "accel" and "ambient_light", accel enabled at icedsp_rate (10) Hz, samples for 5 s, disabled, our
+ * port closed (DEL_CLIENT, as qrtr_port_remove). RESUME_TX sent for every packet that asks (confirm_rx).
+ */
+#define QRTR_TYPE_RESUME_TX_    7
+#define QMI_REQUEST             0
+#define QMI_RESPONSE            2
+#define QMI_INDICATION          4
+#define SSC_QMI_SERVICE         400
+#define SSC_MSG_CONTROL         0x20
+#define SSC_IND_SMALL           0x21
+#define SSC_IND_LARGE           0x22
+#define SSC_SUID_UID            0xababababababababull
+#define SSC_REQ_SUID            512
+#define SSC_REQ_ENABLE          513
+#define SSC_REQ_ON_CHANGE       514             /* enable, reports on change: no body (the light sensor, icelux=1) */
+#define SSC_REQ_DISABLE         10
+#define SSC_RSP_SUID            768
+#define SSC_MEASUREMENT         1025
+
+static struct gchan *s_ch;
+static uint32_t s_port, s_txn = 1, s_responses, s_results_bad, s_indications, s_samples, s_suids;
+/*
+ * 28a: the accelerometer for iOS's orientation -- read only, in mm/s2 as the SNS sample (x / y / z of the Pad's
+ * sensor frame), _seq the count of samples so far (0: none yet). A userland daemon polls them.
+ */
+static int ice_ax, ice_ay, ice_az, ice_aseq;
+SYSCTL_INT(_kern, OID_AUTO, iceaccel_x, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_ax, 0, "iceland accel x, mm/s2");
+SYSCTL_INT(_kern, OID_AUTO, iceaccel_y, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_ay, 0, "iceland accel y, mm/s2");
+SYSCTL_INT(_kern, OID_AUTO, iceaccel_z, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_az, 0, "iceland accel z, mm/s2");
+SYSCTL_INT(_kern, OID_AUTO, iceaccel_seq, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_aseq, 0, "iceland accel samples");
+static uint64_t s_accel_low, s_accel_high, s_light_low, s_light_high;
+static bool s_accel, s_light, s_enabled_ack;
+/*
+ * The ambient light for macOS's brightness (boot-arg icelux=1 with icedsp=11; off by default) -- read only. The light
+ * sensor (STK36C01 behind the sensor hub, data type "ambient_light") reports on change: enabled with message 514 and
+ * no body, measurements as the accelerometer's 1025 with {1 repeated float intensity (lux first), 2 int32 accuracy}
+ * (interface facts from libssc's ssc-sensor-light.proto and its message numbers; no libssc code, it is GPL-3.0).
+ * kern.icelux is the latest sample in milli-lux, kern.icelux_acc its accuracy (0-3), kern.icelux_seq the count of
+ * samples so far (0: none yet). A userland daemon polls them.
+ */
+static int ice_lux, ice_lux_acc, ice_lux_seq;
+SYSCTL_INT(_kern, OID_AUTO, icelux, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_lux, 0, "iceland ambient light, milli-lux");
+SYSCTL_INT(_kern, OID_AUTO, icelux_acc, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_lux_acc, 0, "iceland ambient light accuracy");
+SYSCTL_INT(_kern, OID_AUTO, icelux_seq, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_lux_seq, 0, "iceland ambient light samples");
+static uint32_t s_light_samples;
+static bool s_light_on, s_light_ack;
+
+/* the service's sensors client (hakios_iceland_sensors.c, icesns=) publishes through the same sysctls */
+void
+iceadsp_sns_accel(int x, int y, int z)
+{
+	ice_ax = x;
+	ice_ay = y;
+	ice_az = z;
+	ice_aseq++;
+}
+
+extern void hakios_iceland_backlight_lux(int mlux, int accuracy);       /* hakios_iceland_backlight.c: icebl_auto=1 */
+
+void
+iceadsp_sns_lux(int mlux, int accuracy)
+{
+	hakios_iceland_backlight_lux(mlux, accuracy);   /* (returns at once unless the backlight follows the light) */
+	ice_lux = mlux;
+	ice_lux_acc = accuracy;
+	ice_lux_seq++;
+}
+
+int
+iceadsp_sns_test_read(int what)
+{
+	return what == 0 ? ice_az : ice_lux;
+}
+
+static uint8_t *
+pb_varint(uint8_t *o, uint64_t v)
+{
+	do {
+		*o++ = (uint8_t)((v & 0x7f) | (v > 0x7f ? 0x80 : 0));
+		v >>= 7;
+	} while (v != 0);
+	return o;
+}
+
+static uint8_t *
+pb_fixed(uint8_t *o, uint64_t v, unsigned bytes)
+{
+	for (unsigned i = 0; i < bytes; i++) {
+		*o++ = (uint8_t)(v >> (8 * i));
+	}
+	return o;
+}
+
+/* one protobuf field: *field, *wire, the value (varint / fixed) or the bytes; NULL at the end or on an error */
+static const uint8_t *
+pb_next(const uint8_t *p, const uint8_t *end, uint32_t *field, uint32_t *wire, uint64_t *v, const uint8_t **b,
+    uint32_t *blen)
+{
+	uint64_t key = 0, x = 0;
+	unsigned s = 0;
+
+	if (p >= end) {
+		return NULL;
+	}
+	while (p < end && s < 64) {
+		key |= (uint64_t)(*p & 0x7f) << s;
+		s += 7;
+		if (!(*p++ & 0x80)) {
+			break;
+		}
+	}
+	*field = (uint32_t)(key >> 3);
+	*wire = (uint32_t)(key & 7);
+	switch (*wire) {
+	case 0:
+		for (s = 0; p < end && s < 64;) {
+			x |= (uint64_t)(*p & 0x7f) << s;
+			s += 7;
+			if (!(*p++ & 0x80)) {
+				break;
+			}
+		}
+		*v = x;
+		return p;
+	case 1:
+	case 5: {
+		unsigned n = *wire == 1 ? 8 : 4;
+
+		if ((uint64_t)(end - p) < n) {
+			return NULL;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			x |= (uint64_t)p[i] << (8 * i);
+		}
+		*v = x;
+		return p + n;
+	}
+	case 2:
+		for (s = 0; p < end && s < 64;) {
+			x |= (uint64_t)(*p & 0x7f) << s;
+			s += 7;
+			if (!(*p++ & 0x80)) {
+				break;
+			}
+		}
+		if (x > (uint64_t)(end - p)) {
+			return NULL;
+		}
+		*b = p;
+		*blen = (uint32_t)x;
+		return p + x;
+	default:
+		return NULL;
+	}
+}
+
+/* a float's bits as milli-units, without the FPU's float formatting (printf has no %f here) */
+static int32_t
+milli(uint32_t bits)
+{
+	int exp = (int)((bits >> 23) & 0xff) - 127, sign = (bits >> 31) ? -1 : 1;
+	uint64_t mant = (bits & 0x7fffff) | 0x800000, m;
+
+	if (((bits >> 23) & 0xff) == 0 || exp < -20) {
+		return 0;
+	}
+	if (exp > 20) {
+		return sign * 2000000000;
+	}
+	m = mant * 1000;
+	m = exp >= 23 ? m << (exp - 23) : m >> (23 - exp);
+	return sign * (int32_t)m;
+}
+
+static bool
+qrtr_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *data, uint32_t len)
+{
+	uint8_t pkt[320];
+	uint32_t *w = (uint32_t *)pkt;
+	struct gchan *ch = q_ch != NULL ? q_ch : s_ch;
+
+	if (ch == NULL || 32 + len > sizeof(pkt)) {
+		return false;
+	}
+	bzero(pkt, sizeof(pkt));
+	w[0] = 1;
+	w[1] = type;
+	w[2] = QRTR_OUR_NODE;
+	w[3] = src_port;
+	w[4] = 0;
+	w[5] = len;
+	w[6] = dst_node;
+	w[7] = dst_port;
+	memcpy(pkt + 32, data, len);
+	return g_tx_data(ch, pkt, 32 + ((len + 3) & ~3u));
+}
+
+/* one SscClientRequest in a QMI SSC control request (report type large, as libssc) */
+static bool
+ssc_request(uint64_t low, uint64_t high, uint32_t msg_id, const uint8_t *msg, uint32_t msg_len, const char *what)
+{
+	uint8_t pb[160], qmi[220], *o = pb, *q;
+	uint32_t pb_len, qmi_len;
+
+	*o++ = 0x0a; *o++ = 18;                                         /* 1 uid */
+	*o++ = 0x09; o = pb_fixed(o, low, 8);
+	*o++ = 0x11; o = pb_fixed(o, high, 8);
+	*o++ = 0x15; o = pb_fixed(o, msg_id, 4);                        /* 2 msg_id */
+	*o++ = 0x1a; *o++ = 4; *o++ = 0x08; *o++ = 1; *o++ = 0x10; *o++ = 0;   /* 3 config: APPS, wakeup */
+	*o++ = 0x22;                                                    /* 4 request */
+	if (msg_len != 0) {
+		o = pb_varint(o, 2 + msg_len);
+		*o++ = 0x12;
+		o = pb_varint(o, msg_len);
+		memcpy(o, msg, msg_len);
+		o += msg_len;
+	} else {
+		*o++ = 0;
+	}
+	pb_len = (uint32_t)(o - pb);
+	q = qmi;
+	*q++ = QMI_REQUEST;
+	q = pb_fixed(q, s_txn, 2);
+	q = pb_fixed(q, SSC_MSG_CONTROL, 2);
+	qmi_len = 3 + 2 + pb_len + 3 + 1;
+	q = pb_fixed(q, qmi_len, 2);
+	*q++ = 0x01; q = pb_fixed(q, 2 + pb_len, 2); q = pb_fixed(q, pb_len, 2);
+	memcpy(q, pb, pb_len);
+	q += pb_len;
+	*q++ = 0x10; q = pb_fixed(q, 1, 2); *q++ = 1;                  /* report type large */
+	if (!qrtr_send(QRTR_TYPE_DATA, QRTR_OUR_PORT, q_remote, s_port, qmi, (uint32_t)(q - qmi))) {
+		say("SNS: %s not sent\n", what);
+		return false;
+	}
+	say("SNS > %s (txn %u, msg %u, %u protobuf bytes)\n", what, s_txn, msg_id, pb_len);
+	s_txn++;
+	return true;
+}
+
+static bool
+ssc_suid(const char *data_type)
+{
+	uint8_t m[48], *o = m;
+	uint32_t n = (uint32_t)strlen(data_type);
+
+	*o++ = 0x0a; *o++ = (uint8_t)n;
+	memcpy(o, data_type, n);
+	o += n;
+	*o++ = 0x10; *o++ = 0;                  /* enable_updates false */
+	*o++ = 0x18; *o++ = 1;                  /* only_default_values true */
+	return ssc_request(SSC_SUID_UID, SSC_SUID_UID, SSC_REQ_SUID, m, (uint32_t)(o - m), data_type);
+}
+
+/* one SscClientResponse body */
+static void
+ssc_body(uint64_t low, uint64_t high, uint32_t msg_id, uint64_t ts, const uint8_t *m, uint32_t len)
+{
+	const uint8_t *p = m, *end = m + len, *b = NULL;
+	uint32_t f, w, bl = 0;
+	uint64_t v = 0;
+
+	if (low == SSC_SUID_UID && high == SSC_SUID_UID && msg_id == SSC_RSP_SUID) {
+		char type[24] = { 0 };
+		uint64_t ul = 0, uh = 0;
+		unsigned uids = 0;
+
+		while ((p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL) {
+			if (f == 1 && w == 2) {
+				memcpy(type, b, LESSER(bl, sizeof(type) - 1));
+			} else if (f == 2 && w == 2) {
+				const uint8_t *r = b, *re = b + bl, *bb;
+				uint32_t ff, ww, bbl;
+				uint64_t vv;
+
+				while ((r = pb_next(r, re, &ff, &ww, &vv, &bb, &bbl)) != NULL) {
+					if (ff == 1) {
+						ul = uids == 0 ? vv : ul;
+					} else if (ff == 2) {
+						uh = uids == 0 ? vv : uh;
+					}
+				}
+				uids++;
+			}
+		}
+		s_suids++;
+		say("SNS < SUID for \"%s\": %u sensor(s)%s, uid %016llx %016llx\n", type, uids, uids ? "" : " -- NONE", uh, ul);
+		if (uids && strcmp(type, "accel") == 0) {
+			s_accel = true; s_accel_low = ul; s_accel_high = uh;
+		} else if (uids && strcmp(type, "ambient_light") == 0) {
+			s_light = true; s_light_low = ul; s_light_high = uh;
+		}
+		return;
+	}
+	if (s_accel && low == s_accel_low && high == s_accel_high && msg_id == SSC_MEASUREMENT) {
+		uint32_t axis[3] = { 0, 0, 0 }, n = 0, accuracy = 0;
+
+		while ((p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL) {
+			if (f == 1 && w == 5 && n < 3) {
+				axis[n++] = (uint32_t)v;
+			} else if (f == 1 && w == 2) {                  /* (packed) */
+				for (uint32_t i = 0; i + 4 <= bl && n < 3; i += 4) {
+					axis[n++] = le32(b + i);
+				}
+			} else if (f == 2 && w == 0) {
+				accuracy = (uint32_t)v;
+			}
+		}
+		s_samples++;
+		/* 28a: the latest sample for userland (sysctl kern.iceaccel_x / _y / _z in mm/s2, _seq counts them) */
+		ice_ax = milli(axis[0]);
+		ice_ay = milli(axis[1]);
+		ice_az = milli(axis[2]);
+		ice_aseq = (int)s_samples;
+		if (s_samples <= 60) {
+			int32_t x = milli(axis[0]), y = milli(axis[1]), z = milli(axis[2]);
+
+			say("SNS < ACCEL %u: x %d.%03d y %d.%03d z %d.%03d m/s2 (accuracy %u, t %llu)\n", s_samples,
+			    x / 1000, (x < 0 ? -x : x) % 1000, y / 1000, (y < 0 ? -y : y) % 1000, z / 1000, (z < 0 ? -z : z) % 1000,
+			    accuracy, ts);
+		}
+		return;
+	}
+	if (s_accel && low == s_accel_low && high == s_accel_high && msg_id == SSC_RSP_SUID) {
+		uint32_t rate = 0;
+
+		while ((p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL) {
+			if (f == 1 && w == 5) {
+				rate = (uint32_t)v;
+			}
+		}
+		s_enabled_ack = true;
+		say("SNS < accel config: sample rate %d.%03d Hz\n", milli(rate) / 1000, milli(rate) % 1000);
+		return;
+	}
+	if (s_light && low == s_light_low && high == s_light_high && msg_id == SSC_MEASUREMENT) {
+		uint32_t lux[2] = { 0, 0 }, n = 0, accuracy = 0;
+		int32_t mlux;
+
+		while ((p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL) {
+			if (f == 1 && w == 5 && n < 2) {
+				lux[n++] = (uint32_t)v;
+			} else if (f == 1 && w == 2) {                  /* (packed) */
+				for (uint32_t i = 0; i + 4 <= bl && n < 2; i += 4) {
+					lux[n++] = le32(b + i);
+				}
+			} else if (f == 2 && w == 0) {
+				accuracy = (uint32_t)v;
+			}
+		}
+		if (n == 0) {
+			say("SNS < LIGHT: a measurement of %u bytes without an intensity: not taken\n", len);
+			return;
+		}
+		mlux = milli(lux[0]);
+		s_light_samples++;
+		ice_lux = mlux < 0 ? 0 : mlux;
+		ice_lux_acc = (int)accuracy;
+		ice_lux_seq = (int)s_light_samples;
+		if (s_light_samples <= 20) {
+			say("SNS < LIGHT %u: %d.%03d lux (raw %d.%03d, accuracy %u, t %llu)\n", s_light_samples, ice_lux / 1000,
+			    ice_lux % 1000, milli(lux[1]) / 1000, (milli(lux[1]) < 0 ? -milli(lux[1]) : milli(lux[1])) % 1000,
+			    accuracy, ts);
+		}
+		return;
+	}
+	if (s_light && low == s_light_low && high == s_light_high && msg_id == SSC_RSP_SUID) {
+		s_light_ack = true;
+		say("SNS < light config answered (%u bytes)\n", len);
+		return;
+	}
+	say("SNS < msg %u for %016llx %016llx, %u bytes\n", msg_id, high, low, len);
+}
+
+/* a QMI packet from the SNS service: the control response, or an indication with an SscClientResponse */
+static void
+ssc_qmi(const uint8_t *p, uint32_t len)
+{
+	uint32_t type, txn, msg, mlen, at;
+	const uint8_t *data = NULL;
+	uint32_t data_len = 0, result = ~0u, error = ~0u;
+
+	if (len < 7) {
+		return;
+	}
+	type = p[0];
+	txn = le16(p + 1);
+	msg = le16(p + 3);
+	mlen = le16(p + 5);
+	if (mlen > len - 7) {
+		say("SNS < QMI length %u in %u bytes\n", mlen, len);
+		return;
+	}
+	for (at = 7; at + 3 <= 7 + mlen;) {
+		uint32_t t = p[at], l = le16(p + at + 1);
+
+		if (at + 3 + l > 7 + mlen) {
+			break;
+		}
+		if (t == 0x02 && type == QMI_RESPONSE && l >= 4) {
+			result = le16(p + at + 3);
+			error = le16(p + at + 5);
+		} else if (t == 0x02 && type == QMI_INDICATION && l >= 2) {
+			data_len = LESSER(le16(p + at + 3), l - 2);
+			data = p + at + 5;
+		}
+		at += 3 + l;
+	}
+	if (type == QMI_RESPONSE) {
+		s_responses++;
+		s_results_bad += result != 0;
+		say("SNS < response txn %u msg %#x: result %u error %u\n", txn, msg, result, error);
+		return;
+	}
+	if (type != QMI_INDICATION || (msg != SSC_IND_SMALL && msg != SSC_IND_LARGE) || data == NULL) {
+		say("SNS < QMI type %u msg %#x, %u bytes: not taken\n", type, msg, mlen);
+		return;
+	}
+	s_indications++;
+	{
+		const uint8_t *q = data, *end = data + data_len, *b = NULL;
+		uint32_t f, w, bl = 0;
+		uint64_t v = 0, low = 0, high = 0;
+
+		while ((q = pb_next(q, end, &f, &w, &v, &b, &bl)) != NULL) {
+			if (f == 1 && w == 2) {
+				const uint8_t *r = b, *re = b + bl, *bb;
+				uint32_t ff, ww, bbl;
+				uint64_t vv;
+
+				while ((r = pb_next(r, re, &ff, &ww, &vv, &bb, &bbl)) != NULL) {
+					if (ff == 1) {
+						low = vv;
+					} else if (ff == 2) {
+						high = vv;
+					}
+				}
+			} else if (f == 2 && w == 2) {
+				const uint8_t *r = b, *re = b + bl, *bb = NULL, *m = NULL;
+				uint32_t ff, ww, bbl = 0, ml = 0, mid = 0;
+				uint64_t vv = 0, ts = 0;
+
+				while ((r = pb_next(r, re, &ff, &ww, &vv, &bb, &bbl)) != NULL) {
+					if (ff == 1) {
+						mid = (uint32_t)vv;
+					} else if (ff == 2) {
+						ts = vv;
+					} else if (ff == 3 && ww == 2) {
+						m = bb;
+						ml = bbl;
+					}
+				}
+				if (m != NULL || ml == 0) {
+					ssc_body(low, high, mid, ts, m ? m : b, ml);
+				}
+			}
+		}
+	}
+}
