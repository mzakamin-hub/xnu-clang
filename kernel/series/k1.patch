+#include <libkern/crypto/sha2.h>
+#include "hakios_iceland_adsp.h"
+
+extern uint32_t psci_smp_hvc;          /* osfmk/arm64/psci_smp.c: 1 = QEMU's virt, not the Pad */
+
+/*
+ * The kits' result lines also go straight into the loader's log (loader_log_line, osfmk/arm64/loader_return.c) as
+ * "icekit: ...": in the ESP-pack runs of 31 Oct (17q3, 21b, 22c) the kernel's printf lines stopped reaching the
+ * loader's log about 52-54 s after the start (the message buffer's copy ends there too), so 21b's sound and 22c's
+ * FastRPC lines after that were lost. Only the kits' own lines (snd / frpc / mic / tone / c2 / amp / audio), not the
+ * GLINK / GPR traffic; "icekit: " starts with "ice", so the loader also keeps them through a ring wrap.
+ */
+extern void loader_log_line(const char *line);
+static void kit_line(const char *prefix, const char *fmt, ...) __printflike(2, 3);
+
+static void
+kit_line(const char *prefix, const char *fmt, ...)
+{
+	static const char *const kits[] = { "snd: ", "frpc: ", "tone: ", "c2: ", "amp: ", "audio: " };
+	char line[400];
+	int n;
+	va_list ap;
+	bool kit = strcmp(prefix, "mic: ") == 0;
+
+	n = snprintf(line, sizeof(line), "%s", prefix);
+	va_start(ap, fmt);
+	(void)vsnprintf(line + n, sizeof(line) - (size_t)n, fmt, ap);
+	va_end(ap);
+	printf("%s", line);
+	for (size_t i = 0; !kit && i < sizeof(kits) / sizeof(kits[0]); i++) {
+		kit = strncmp(line + n, kits[i], strlen(kits[i])) == 0;
+	}
+	if (kit) {
+		char out[420];
+
+		snprintf(out, sizeof(out), "icekit: %s", line);
+		loader_log_line(out);
+	}
+}
+#define say(...) kit_line("icedsp: ", __VA_ARGS__)
+/* per-message lines (GLINK / GPR traffic), left out while the tone's buffers stream (level D: g_quiet) */
+static bool g_quiet;
+/* ... and, with iceadsp=1, from the service's READY on (iceadsp_chat=1 keeps them): a stream is thousands of packets */
+static bool g_svc_quiet;
+/* the run's end (hakios_iceland_adsp_stop / _quiesce): every long loop of the kit and the service looks at it */
+static volatile uint32_t adsp_stop_req;
+static bool snd_force_tone;           /* 17t2: audio_tone plays the plain tone even with icesnd=1 (the mic's cue) */
+struct gchan;
+static bool audio_tone(struct gchan *apps, uint32_t mode, uint32_t audio, uint32_t smmu);
+#define chat(...) do { if (!g_quiet && !g_svc_quiet) { say(__VA_ARGS__); } } while (0)
+#define LESSER(a, b) ((a) < (b) ? (a) : (b))
+#define GREATER(a, b) ((a) > (b) ? (a) : (b))
