+static void
+check_guard_walk(void)
+{
+	static const int32_t temps[] = { 520, 530, 520, 509, 520 };
+	static const bool want[] = { false, true, true, false, false };
+	bool stopped = false, pass = true;
+	char seen[96];
+	size_t off = 0;
+	unsigned i;
+
+	seen[0] = '\0';
+	for (i = 0; i < sizeof(temps) / sizeof(temps[0]); i++) {
+		stopped = icechg_guard_stop(stopped, temps[i], 3850, 5000, 0);
+		if (stopped != want[i])
+			pass = false;
+		if (off < sizeof(seen))
+			off += (size_t)snprintf(seen + off, sizeof(seen) - off, "%s%s",
+						i != 0 ? " " : "", stopped ? "stopped" : "running");
+	}
+	verdict("guard walk: 52 C on, 53 C off, 52 C still off, 50.9 C on again, 52 C stays on",
+		pass, seen);
+}
