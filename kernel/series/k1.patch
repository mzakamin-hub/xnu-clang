+/* the invariant every plan must keep: no write, or a raise that stays under three ceilings */
+static void
+check_invariant(const struct plan_case *c, const struct icechg_plan *p)
+{
+	char name[192];
+	char detail[160];
+	const char *which = "";
+	bool pass = true;
+
+	if (p->icl_ma > ICECHG_TOP_MA) {
+		pass = false;
+		which = "above 2000 mA";
+	} else if (p->icl_ma > c->in.source_ma) {
+		pass = false;
+		which = "above the source maximum";
+	} else if (p->icl_ma != 0 && p->icl_ma <= c->in.icl_ma) {
+		pass = false;
+		which = "not above the limit already in force";
+	}
+	snprintf(name, sizeof(name), "never lower: %s", c->name);
+	snprintf(detail, sizeof(detail), "icl_ma=%u, in.icl_ma=%u, in.source_ma=%u: %s",
+		 p->icl_ma, c->in.icl_ma, c->in.source_ma, which);
+	verdict(name, pass, detail);
+}
+
+static void
+check_case(const struct plan_case *c)
+{
+	struct icechg_plan p;
+	char detail[224];
+	bool pass;
+
+	icechg_plan(&c->in, &p);
+	pass = p.ask_9v == c->ask_9v && p.icl_ma == c->icl_ma &&
+	    (c->why == NULL || (p.why != NULL && strstr(p.why, c->why) != NULL));
+	snprintf(detail, sizeof(detail), "got ask_9v=%s icl_ma=%u why=%s",
+		 p.ask_9v ? "true" : "false", p.icl_ma, p.why != NULL ? p.why : "(null)");
+	verdict(c->name, pass, detail);
+	check_invariant(c, &p);
+}
