new file mode 100755
index 0000000000000000000000000000000000000000..7e1949f330c9deb6c6cdfa11e4dd15d2631ab86c
--- /dev/null
+++ b/bsd/dev/hakios_iceland_camera_stream.h
@@ -0,0 +1,1694 @@
+/*
+ * hakios_iceland_camera_stream.h - icecam=3 / icecam=4: RAW frames of the Pad 4's front camera into kernel memory.
+ * Part of hakios_iceland_camera.c (included there, after the sensor's power and bus helpers); nothing here runs
+ * below icecam=3.
+ *
+ * The route is the one the owner's Linux runs this camera on (linux a2e1ea44d3c3, read by object; facts only): the
+ * sensor in a RAW10 mode, CSIPHY5 (D-PHY, 4 lanes) -> CSID0 -> TFE0's RDI0 write master, a raw dump: no ISP block.
+ *   kaanapali.dtsi:4087-4284       camss: csid0 0x9253000, vfe0 (TFE 0) 0x9151000, csiphy5 0x952d000; iommus apps_smmu
+ *                                  stream 0x1c00; power domains TFE_0_GDSC, TITAN_TOP_GDSC; :4547 camcc 0x956d000 on
+ *                                  MMCX + MXC (low_svs), GCC_CAMERA_AHB_CLK; :4522 csiphy5: CSIPHY5_CLK, CSI5PHYTIMER,
+ *                                  CORE_AHB; supplies 0.9 V = L3I (0.88 V), 1.2 V = L1D (the board file :1161-1163)
+ *   camcc-kaanapali.c              PLL0 (0x0) 1200 MHz: L 0x3e, CAL_L 0x48, alpha 0x8000, config 0x25c400e7 /
+ *                                  0x0a8062e0 / 0xf51dea20, user 0x8408 (even / 2, odd / 3), user_u 2; PLL3 (0x3000)
+ *                                  720.56 MHz: L 0x25, alpha 0x8777, user 0x408 (Taycan EKO_T: the GPU's PLL0 layout);
+ *                                  sources (CMD, CFG = CMD + 4: source 10:8, divider 2 x div - 1 in 4:0): cphy_rx
+ *                                  0x21064 and csid 0x212a4 at 400 MHz (PLL0 main 1, / 3), csi5phytimer 0x200a4 at
+ *                                  400 MHz (PLL0 odd 3, / 1), tfe_0 0x21018 at 360.28 MHz (PLL3 even 6, / 1),
+ *                                  camnoc_rt_axi 0x212cc at 300 MHz (PLL0 even 2, / 2; hw_clk_ctrl: CFG bit 20);
+ *                                  the AHB sources get no rate in Linux (left as found); branches and GDSCs below
+ *   camss.c:92-314                 csid_res / vfe_res_kaanapali: which clocks each block takes, and their rates
+ *   phy-qcom-mipi-csi2-3ph-dphy.c  mipi_csi2_dphy_3nm_kaanapali: common block at 0x1000, status at +0x138; reset,
+ *                                  version, CTRL5 = clock lane bit 7 | data lanes 0 2 4 6, CTRL6 = 1, CTRL7 = 2,
+ *                                  CTRL0 = 0, the lane list (skew calibration entries not written), CTRL11..21 = 0;
+ *                                  settle count = (85 ns + 6 x UI / 2) / the timer's period - 6
+ *   camss-csid-gen4.c              the CSID's reset, RX and RDI registers and its register-update commands
+ *   camss-vfe-gen4.c               the TFE's bus at 0x1000: write master 23 = RDI0, frame mode, address >> 8
+ *   camss-vfe.c:506-600            two addresses queued at the start, the next one at every buffer-done
+ *   drivers/media/i2c/sc1320cs.c   the stream start: soft reset 0x0103 = 1, 0.2 ms, the mode's list, exposure
+ *                                  0x3e00 (24 bit, lines << 5), frame length 0x320e, gain 0x3e08 (ladder) and 0x3e07
+ *                                  (fine), then 0x0100 = 1; front: 1632x1224 BGGR10, 4 lanes, link 330 MHz, 30 fps
+ *   interconnect/qcom/kaanapali.c:1303  BCM "MM1": the camera NoC's masters to the multimedia NoC
+ * The SMMU window is hakios_iceland_pcie.c's (the same apps SMMU, proven on the tablet): a free stream match register
+ * and a free context bank, stage 1, a 32-bit input space, only the frame buffers mapped; unmatched streams fault on
+ * this SMMU (sCR0 0x2b0406: USFCFG), so without the window the write master could store nothing.
+ * UniXNU's Pad 8 Pro port (docs/drivers/camera.md, MIT) gave the order of the teardown (the window first, while its
+ * clocks run), the report before the power-down, and the stale buffer-done rule.
+ *
+ * The sensor's register list is not in this file: it comes from the stock camera's bus trace and is the owner's
+ * private data. A private build links iceland_cam_front_tbl / _n (strong); without them level 3 stops before any
+ * camera-subsystem write.
+ *
+ *   icecam=3        the survey, then: the front sensor streaming, icecam_frames (4) frames into three buffers, the
+ *                   newest whole one measured (written extent, per Bayer position min / mean / max and an 8-bin
+ *                   histogram, a text thumbnail), everything powered down and put back
+ *   icecam=4        ... for icecam_secs (20) seconds, each frame made into a half-size BGRA picture on the CPU, the
+ *                   gain following the picture's brightness; a line a second
+ *   icecam_stop=N   stop after step N (301..316) and take everything down again
+ *   icecam_gain=G   the start gain x 128 (512 = 4x, Linux's start), icecam_exp=L the exposure in lines (2495)
+ *   icecam_mmcx=V / icecam_mxc=V  the level asked of the two rails (320: at or above the boot display's)
+ *   icecam_smr=N / icecam_cb=N    the SMMU's stream match register (14) and context bank (10)
+ */
+
+struct icecam_reg {
+	uint16_t reg;
+	uint8_t val, pad;
+};
+__attribute__((weak, visibility("hidden"))) const struct icecam_reg iceland_cam_front_tbl[1] = { { 0, 0, 0 } };
+__attribute__((weak, visibility("hidden"))) const uint32_t iceland_cam_front_tbl_n = 0;
+
+extern int hakios_iceland_rpmh_bcm(const char *name, bool up);
+extern int hakios_iceland_rpmh_arc(const char *name, uint32_t vlvl);
+
+/* ---- the geometry and the pure parts (the host test runs these) ---------------------------------------------------- */
+
+#define CAM_W                   1632u
+#define CAM_H                   1224u
+#define CAM_BPL                 (CAM_W * 10u / 8u)              /* 2040: RAW10, MIPI packing */
+#define CAM_BPL16               ((CAM_BPL + 15u) & ~15u)        /* 2048: the driver's stride for FRAME_INCR */
+#define CAM_BUF_BYTES           0x300000u                       /* a frame (at most 2048 x 1224) and its guard */
+#define CAM_BUFS                3u
+#define CAM_FILL                0xa5u
+#define CAM_IOVA                0x10000000u
+#define CAM_LINK_HZ             330000000ull
+#define CAM_TIMER_HZ            400000000u
+#define CAM_VTS                 2500u
+#define CAM_BLACK               64u                             /* of 1023 (the owner's Linux tuning) */
+#define OUT_W                   (CAM_W / 2u)
+#define OUT_H                   (CAM_H / 2u)
+
+/* phy_qcom_mipi_csi2_settle_cnt_calc */
+static uint32_t
+cam_settle(uint64_t link_hz, uint32_t timer_hz)
+{
+	uint32_t ui_ps = (uint32_t)(1000000000000ull / link_hz) / 2;
+	uint32_t settle_ps = 85000 + 6 * ui_ps, timer_ps = (uint32_t)(1000000000000ull / timer_hz);
+
+	return settle_ps / timer_ps < 6 ? 0 : settle_ps / timer_ps - 6;
+}
+
+/* pixel x of a RAW10 MIPI-packed line: four pixels' top 8 bits in four bytes, their low 2 bits in the fifth */
+static inline uint32_t
+cam_px(const uint8_t *row, uint32_t x)
+{
+	const uint8_t *g = row + (x >> 2) * 5;
+
+	return (uint32_t)g[x & 3] << 2 | ((g[4] >> ((x & 3) * 2)) & 3);
+}
+
+struct cam_stats {
+	uint32_t min[4], max[4], hist[4][8];
+	uint64_t sum[4], n[4];
+};
+
+/* per Bayer position (row parity x 2 + column parity): every pixel of every `step`-th row pair */
+static void
+cam_measure(const uint8_t *frame, uint32_t stride, uint32_t step, struct cam_stats *s)
+{
+	bzero(s, sizeof(*s));
+	for (unsigned k = 0; k < 4; k++) {
+		s->min[k] = 1023;
+	}
+	for (uint32_t y = 0; y + 1 < CAM_H; y += 2 * step) {
+		for (uint32_t r = 0; r < 2; r++) {
+			const uint8_t *row = frame + (uint64_t)(y + r) * stride;
+
+			for (uint32_t x = 0; x < CAM_W; x++) {
+				uint32_t v = cam_px(row, x), k = r * 2 + (x & 1);
+
+				s->sum[k] += v;
+				s->n[k]++;
+				s->hist[k][v >> 7]++;
+				if (v < s->min[k]) {
+					s->min[k] = v;
+				}
+				if (v > s->max[k]) {
+					s->max[k] = v;
+				}
+			}
+		}
+	}
+}
+
+/* how far the buffer was written: one past the last byte that is not the fill */
+static uint32_t
+cam_extent(const uint8_t *buf, uint32_t size)
+{
+	while (size > 0 && buf[size - 1] == CAM_FILL) {
+		size--;
+	}
+	return size;
+}
+
+static bool
+cam_all_fill(const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		if (p[i] != CAM_FILL) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* 48 x 16 cells of the green pixels' brightness (black level off, the frame's own maximum as white) */
+#define THUMB_W                 48u
+#define THUMB_H                 16u
+static void
+cam_thumb_row(const uint8_t *frame, uint32_t stride, uint32_t ty, uint32_t white, char *out)
+{
+	static const char shade[] = " .:-=+*#%@";
+	uint32_t y0 = ty * (CAM_H / THUMB_H);
+
+	for (uint32_t tx = 0; tx < THUMB_W; tx++) {
+		uint32_t x0 = tx * (CAM_W / THUMB_W), sum = 0, n = 0;
+
+		for (uint32_t y = y0; y < y0 + CAM_H / THUMB_H; y += 8) {
+			const uint8_t *row = frame + (uint64_t)y * stride;         /* an even row: B G B G */
+
+			for (uint32_t x = x0 | 1; x < x0 + CAM_W / THUMB_W; x += 4) {
+				uint32_t v = cam_px(row, x);
+
+				sum += v > CAM_BLACK ? v - CAM_BLACK : 0;
+				n++;
+			}
+		}
+		sum = n ? sum / n : 0;
+		out[tx] = shade[white ? MIN(sum * 9 / white, 9u) : 0];
+	}
+	out[THUMB_W] = 0;
+}
+
+/*
+ * The half-size picture: each 2 x 2 quad (B G / G R) one BGRA pixel, from the pixels' top 8 bits; black level off,
+ * rough daylight gains (red x 1.8, blue x 1.6: a start, not a calibration), a square-root tone curve. Returns the
+ * mean of the quads' green before the gains (0..255, black level off): the brightness the gain follows.
+ */
+static uint8_t cam_curve[256];
+
+static void
+cam_curve_init(void)
+{
+	for (uint32_t i = 0, r = 0; i < 256; i++) {
+		while ((r + 1) * (r + 1) <= i * 255) {
+			r++;
+		}
+		cam_curve[i] = (uint8_t)r;
+	}
+}
+
+static uint32_t
+cam_debayer(const uint8_t *frame, uint32_t stride, uint8_t *bgra, uint32_t means[3])
+{
+	uint64_t gsum = 0, sum[3] = { 0, 0, 0 };
+	const uint32_t black = CAM_BLACK >> 2;
+
+	for (uint32_t y = 0; y < OUT_H; y++) {
+		const uint8_t *r0 = frame + (uint64_t)(2 * y) * stride, *r1 = r0 + stride;
+		uint8_t *o = bgra + (uint64_t)y * OUT_W * 4;
+
+		for (uint32_t x = 0; x < OUT_W; x += 2, r0 += 5, r1 += 5, o += 8) {
+			for (uint32_t k = 0; k < 2; k++) {
+				uint32_t b = r0[2 * k], g = ((uint32_t)r0[2 * k + 1] + r1[2 * k]) / 2, r = r1[2 * k + 1];
+
+				b = b > black ? b - black : 0;
+				g = g > black ? g - black : 0;
+				r = r > black ? r - black : 0;
+				gsum += g;
+				b = MIN(b * 410 >> 8, 255u);
+				r = MIN(r * 461 >> 8, 255u);
+				g = MIN(g, 255u);
+				o[4 * k] = cam_curve[b];
+				o[4 * k + 1] = cam_curve[g];
+				o[4 * k + 2] = cam_curve[r];
+				o[4 * k + 3] = 0xff;
+				sum[0] += o[4 * k + 2];
+				sum[1] += o[4 * k + 1];
+				sum[2] += o[4 * k];
+			}
+		}
+	}
+	for (unsigned k = 0; k < 3; k++) {
+		means[k] = (uint32_t)(sum[k] / (OUT_W * OUT_H));
+	}
+	return (uint32_t)(gsum / (OUT_W * OUT_H));
+}
+
+/* the gain (x 128) for the next frames: toward a green mean of 56 of 255, at most x 4 a step, inside 1x .. 64x */
+static uint32_t
+cam_ae(uint32_t gain, uint32_t green)
+{
+	uint32_t want;
+
+	if (green >= 42 && green <= 70) {
+		return gain;
+	}
+	want = green == 0 ? gain * 4 : (uint32_t)((uint64_t)gain * 56 / green);
+	want = MIN(want, gain * 4);
+	want = MAX(want, gain / 4);
+	return MIN(MAX(want, 128u), 8192u);
+}
+
+/* sc1320cs.c's gain split: the analogue ladder's step and the fine digital gain */
+static void
+cam_gain_regs(uint32_t gain, uint8_t *ladder, uint8_t *fine)
+{
+	static const uint8_t steps[] = { 0x00, 0x08, 0x09, 0x0b, 0x0f, 0x1f, 0x3f };
+	uint32_t step = 0, f;
+
+	while (step < 6 && (gain >> (step + 1)) >= 128) {
+		step++;
+	}
+	f = gain >> step;
+	*ladder = steps[step];
+	*fine = (uint8_t)MIN(MAX(f, 0x80u), 0xffu);
+}
+
+/* the window's tables: 4 KB pages, level 1 -> level 2 -> `n3` level-3 tables, `bytes` at CAM_IOVA -> pa */
+static void
+cam_tables(uint64_t *l1, uint64_t *l2, uint64_t *l3, uint64_t l2_pa, const uint64_t *l3_pa, uint32_t n3, uint64_t pa,
+    uint32_t bytes)
+{
+	l1[(CAM_IOVA >> 30) & 0x1ff] = l2_pa | 3;
+	for (uint32_t k = 0; k < n3; k++) {
+		l2[((CAM_IOVA >> 21) & 0x1ff) + k] = l3_pa[k] | 3;
+	}
+	/* Normal non-cacheable (AttrIndx 0), outer shareable, access flag, read/write, nG, XN: hakios_iceland_pcie.c's */
+	for (uint32_t i = 0; i < bytes / 0x1000; i++) {
+		l3[i] = (pa + i * 0x1000ull) | 3 | 1ull << 10 | 2ull << 8 | 1ull << 6 | 1ull << 11 | 3ull << 53;
+	}
+}
