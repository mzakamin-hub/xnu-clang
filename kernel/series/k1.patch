+			 stop_cases[i].stopped ? "true" : "false", (int)stop_cases[i].t,
+			 stop_cases[i].batt, stop_cases[i].vbus, stop_cases[i].over);
+		snprintf(detail, sizeof(detail), "got %s, want %s", got ? "true" : "false",
+			 stop_cases[i].want ? "true" : "false");
+		verdict(name, got == stop_cases[i].want, detail);
