+uint32_t redwood_audio_capture(int16_t *mono, uint32_t count);          // bsd/dev/redwood_audio.c
+void iceland_hid_line(const char *line);                                // iokit/Native/IcelandHid/IcelandHidProbe.cpp
+uint32_t iceland_snd_cap(void);                                         // bsd/dev/hakios_iceland_adsp.c
+// For a post-mortem: the stage (4 published; negative: the step that failed) and the engines' counters.
+extern volatile int iceland_audio_dev_stage;
+extern volatile uint32_t iceland_audio_dev_clients, iceland_audio_dev_running, iceland_audio_dev_in_running;
+extern volatile uint64_t iceland_audio_dev_periods, iceland_audio_dev_late, iceland_audio_dev_sound;
+extern volatile uint64_t iceland_audio_dev_selectors, iceland_audio_dev_bad_selectors, iceland_audio_dev_maps;
+extern volatile uint64_t iceland_audio_dev_in_periods, iceland_audio_dev_captured, iceland_audio_dev_starts;
+extern volatile uint64_t iceland_audio_dev_in_padded;
+// The microphone's source, for its stop line (bsd/dev/hakios_iceland_adsp.c, msv_take's clamp).
+extern volatile uint64_t ice_icemic_skipped, ice_icemic_backlog;
+volatile int iceland_audio_dev_stage;
+volatile uint32_t iceland_audio_dev_clients, iceland_audio_dev_running, iceland_audio_dev_in_running;
+volatile uint64_t iceland_audio_dev_periods, iceland_audio_dev_late, iceland_audio_dev_sound;
+volatile uint64_t iceland_audio_dev_selectors, iceland_audio_dev_bad_selectors, iceland_audio_dev_maps;
+volatile uint64_t iceland_audio_dev_in_periods, iceland_audio_dev_captured, iceland_audio_dev_starts;
+volatile uint64_t iceland_audio_dev_in_padded;  // frames of the input periods the source could not give (zero-padded)
+}
+
+namespace {
+enum : uint32_t {
+	// The ring a whole number of periods (32, 160 ms): the engine moves a period at a time and never splits one at the wrap.
+	kRate = 48000, kRingFrames = 32 * 240, kPeriodFrames = 240,     // 5 ms
+	kChannels = 2, kInputChannels = 1, kStreamID = 1,
+	kSafetyOffset = 2 * kPeriodFrames, kLatency = kPeriodFrames,
+	kTransportBuiltIn = 0x626c746e,                                 // 'bltn'
+	kFormatLinearPCM = 0x6c70636d,                                  // 'lpcm'
+	kFlagsS16 = 0x4 | 0x8,                                          // signed integer, packed (little endian)
+	kTerminalSpeaker = 0x73706b72,                                  // 'spkr'
+	kTerminalMicrophone = 0x6d696372,                               // 'micr'
+	kStatusType = 0, kStreamMemory = 0x10000000,
+	kSilence = 8,                                                   // samples no larger than this are silence
+};
+struct EngineStatus { volatile uint64_t sampleTime, hostTime, seed, reserved, writeEnd; };
+static_assert(sizeof(EngineStatus) >= 0x28, "the audio server refuses a smaller engine status");
+static_assert(kRingFrames % kPeriodFrames == 0, "the ring holds whole periods");
+constexpr int64_t
+fixed64(uint32_t hz)
+{
+	return int64_t(hz) << 32;
+}
+// Wired kernel memory a client maps: the engine status and the ring.
+const IOOptionBits kShared = IOOptionBits(kIODirectionInOut) | IOOptionBits(kIOMemoryKernelUserShared);
+uint32_t gUnknownLogged;
+}  // namespace
+
+class IcelandAudioDevice : public IOService {
+	OSDeclareDefaultStructors(IcelandAudioDevice)
+	typedef IOService super;
+public:
+	IOBufferMemoryDescriptor *statusMemory, *ring;
+	IOLock *lock;
+	thread_t engine;
+	bool running, stopping;
+	bool isInput;                   // the microphone device: one input stream, filled from the capture source
+	uint64_t startTime;
+	uint64_t micStartPeriods, micStartCaptured;     // the counters at the microphone's StartIO (its stop line)
+	uint64_t micStartPadded, micStartSkipped, micStartLate; // the same for the source's counters and the late periods
+	uint32_t seed;
+	int32_t hogOwner;
+
+	uint32_t
+	channels() const
+	{
+		return isInput ? uint32_t(kInputChannels) : uint32_t(kChannels);
+	}
+	bool initDevice(bool input);
+	void free() override;
+	bool start(IOService *provider) override;
+	EngineStatus *
+	status()
+	{
+		return static_cast<EngineStatus *>(statusMemory->getBytesNoCopy());
+	}
+	IOMemoryDescriptor *memory(uint32_t type);
+	IOReturn startIO();
+	IOReturn stopIO();
+	void publish(IORegistryEntry *entry);
+	IOReturn setProperties(OSObject *properties) override;
+	IOReturn apply(OSObject *properties, IORegistryEntry *client);
+	static void engineMain(void *, wait_result_t);
+	void run();
+};
+
+class IcelandAudioUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IcelandAudioUserClient)
+	typedef IOUserClient super;
+	IcelandAudioDevice *device;
+	bool startedIO;
+public:
+	bool start(IOService *provider) override;
+	IOReturn clientClose() override;
+	void stop(IOService *provider) override;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch,
+	    OSObject *target, void *reference) override;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) override;
+	IOReturn registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon) override;
+	IOReturn setProperties(OSObject *properties) override;
+};
+
+OSDefineMetaClassAndStructors(IcelandAudioDevice, IOService)
+OSDefineMetaClassAndStructors(IcelandAudioUserClient, IOUserClient)
