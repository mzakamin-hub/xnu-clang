+static bool
+cam_stop_at(uint32_t n)
+{
+	if (cam.stop != 0 && cam.stop <= n) {
+		say("icecam_stop=%u: stopping after step %u\n", cam.stop, n);
+		return true;
+	}
+	return false;
+}
