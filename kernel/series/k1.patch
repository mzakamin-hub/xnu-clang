+	__asm__ volatile (".arch_extension pauth\n pacda %0, %1" : "+r" (sig[2]) : "r" (modifier));
+	__asm__ volatile (".arch_extension pauth\n pacdb %0, %1" : "+r" (sig[3]) : "r" (modifier));
+	__asm__ volatile (".arch_extension pauth\n pacga %0, %1, %2" : "=r" (sig[4]) : "r" (value), "r" (modifier));
