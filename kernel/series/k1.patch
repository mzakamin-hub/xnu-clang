+/*
+ * The GPU's own SMMU context, as arm-smmu-qcom gives it: bank 0 (qcom_adreno_smmu_alloc_context_bank: the GPU device,
+ * stream 0), ACTLR 0x303 (client match "qcom,adreno"), stream 0 and the LPAC stream 1 (CP_SMMU_STREAM_ID_LPAC 0x101)
+ * routed to it; HUPCF (SCTLR bit 8) as data-a-live's patch 0316 and dada's method: the context keeps serving after a fault.
+ */
+static bool
+core_smmu_on(void)
+{
+	struct snapshot *s = &after;
+	uint64_t root = table_pa[0];            /* ASID 0 (the GMU's bank: ASID 1) */
+	const uint32_t streams[2] = { 0, 1 };
+
+	survey(s, true);
+	if (!s->smmu || s->ncb == 0) {
+		say("core: SMMU not readable: stopping\n");
+		return false;
+	}
+	if (s->cb_sctlr[0] & 1) {
+		say("core: SMMU context bank 0 is in use (sctlr %#x): not taking it over\n", s->cb_sctlr[0]);
+		return false;
+	}
+	for (uint32_t i = 0; i < s->nsmr; i++) {
+		for (unsigned k = 0; k < 2; k++) {
+			if ((s->smr[i] & SMR_VALID) && ((s->smr[i] ^ streams[k]) & ~(s->smr[i] >> 16) & 0x7fff) == 0) {
+				say("core: SMR %u (%#x) already matches stream %u: not taking it over\n", i, s->smr[i], streams[k]);
+				return false;
+			}
+		}
+	}
+	for (uint32_t i = 0, k = 0; i < s->nsmr && k < 2; i++) {
+		if (!(s->smr[i] & SMR_VALID) && (int)i != ctx_smr) {
+			core_smr[k++] = (int)i;
+		}
+	}
+	if (core_smr[1] < 0) {
+		say("core: no two free SMRs\n");
+		core_smr[0] = core_smr[1] = -1;
+		return false;
+	}
+	core_old_cbar = s->cbar[0];
+	core_old_cba2r = rd(smmu + SMMU_CBA2R(0));
+	core_old_actlr = rd(smmu + SMMU_CB(0) + CB_ACTLR);
+	core_cb = 0;
+	say("core: SMMU context bank 0, SMRs %d and %d for streams 0 and 1\n", core_smr[0], core_smr[1]);
+	W_SMMU(SMMU_CB(0) + CB_SCTLR, "CB0_SCTLR", 0);
+	W_SMMU(SMMU_CB(0) + CB_ACTLR, "CB0_ACTLR", 0x303);
+	W_SMMU(SMMU_CBA2R(0), "CBA2R0", 1);
+	W_SMMU(SMMU_CBAR(0), "CBAR0", CBAR_S1);
+	W_SMMU(SMMU_CB(0) + CB_TCR2, "CB0_TCR2", TCR2_36);
+	W_SMMU(SMMU_CB(0) + CB_TCR, "CB0_TCR", TCR_39);
+	W_SMMU(SMMU_CB(0) + CB_TTBR0, "CB0_TTBR0_LO", (uint32_t)root);
+	W_SMMU(SMMU_CB(0) + CB_TTBR0 + 4, "CB0_TTBR0_HI", (uint32_t)(root >> 32));
+	W_SMMU(SMMU_CB(0) + CB_TTBR1, "CB0_TTBR1_LO", 0);
+	W_SMMU(SMMU_CB(0) + CB_TTBR1 + 4, "CB0_TTBR1_HI", 0);
+	W_SMMU(SMMU_CB(0) + CB_MAIR0, "CB0_MAIR0", MAIR0_NC);
+	W_SMMU(SMMU_CB(0) + CB_MAIR1, "CB0_MAIR1", 0);
+	W_SMMU(SMMU_CB(0) + CB_FSR, "CB0_FSR", FSR_ALL);
+	W_SMMU(SMMU_CB(0) + CB_TLBIASID, "CB0_TLBIASID", 0);
+	W_SMMU(SMMU_CB(0) + CB_TLBSYNC, "CB0_TLBSYNC", 0);
+	if (!wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000)) {
+		say("core: context bank 0: TLB sync does not finish\n");
+		return false;
+	}
+	W_SMMU(SMMU_CB(0) + CB_SCTLR, "CB0_SCTLR", SCTLR_ON | 1u << 8);
+	for (unsigned k = 0; k < 2; k++) {
+		W_SMMU(SMMU_S2CR(core_smr[k]), "S2CR", 0);
+		W_SMMU(SMMU_SMR(core_smr[k]), "SMR", SMR_VALID | streams[k]);
+	}
+	if (rd(smmu + SMMU_SMR(core_smr[0])) != SMR_VALID || !(rd(smmu + SMMU_CB(0) + CB_SCTLR) & 1) ||
+	    rd(smmu + SMMU_CB(0) + CB_TTBR0) != (uint32_t)root) {
+		say("core: the SMMU did not take it: smr %#x sctlr %#x ttbr0 %#x\n", rd(smmu + SMMU_SMR(core_smr[0])),
+		    rd(smmu + SMMU_CB(0) + CB_SCTLR), rd(smmu + SMMU_CB(0) + CB_TTBR0));
+		return false;
+	}
+	return true;
+}
