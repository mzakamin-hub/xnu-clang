+static uint64_t ring_drops, drops_told;
+static uint32_t in_op;                  /* the USB thread is inside the gadget: a quiesce then only halts */
+
+enum { PH_IDLE, PH_SETUP, PH_DATA, PH_WAIT_STATUS, PH_STATUS };
