+/*
+ * ---- icespmi=4 (kit 23f3, CLASS C: the BT UART, inside 23f2's bt-enable hold) ------------------------------------
+ * 23f2: with bt-enable high the WCN7860 drives its UART TX (our RX, gpio27) and RTS (our CTS, gpio24) high within
+ * 50 ms - the chip's ROM UART is up. The pads are in function 0 (plain GPIO, ctl 0x1) under XNU.
+ * The serial engine (uart18 = QUP wrap3 SE5, 0x1994000) is NOT driven here: its registers need the wrapper's GCC
+ * clocks (0x52018 bits 8 m_ahb, 9 s_ahb, 10 core, 11 core_2x, 17 s5) AND the QUP-core / config interconnect votes
+ * (DT interconnects clk_virt MASTER_QUP_CORE_3, gem_noc -> config_noc SLAVE_QUP_3: RPMh BCM commands = a NEW kind of
+ * write, not built), its protocol firmware must already be UART and its S5 RCG set for 115200 x 16; reading an
+ * unclocked QUP register can hang the bus (the touch driver avoids the same engine type for that reason). 23f3 only
+ * READS that state: the five GCC votes and CBCRs, and - only if every one of them reads ON - the SE's
+ * GENI_FW_REVISION_RO (+0x68, protocol in bits 15:8: 2 = UART) and GENI_STATUS (+0x40).
+ * The bytes go instead over the same pads as GPIOs (the method of hakios_iceland_touch.c's SPI): 8N1 at 115200
+ * (8.68 us a bit), TX gpio26 driven by deadline (mach_absolute_time), RX gpio27 sampled in a tight loop with
+ * interrupts off and every edge time-stamped, then decoded (start bit, samples at 1.5 + k bit times, stop bit checked).
+ * Our RTS (gpio25) is left as found: pulled down = asserted (the chip may send); the chip's RTS (gpio24) only logged.
+ *   writes (TLMM, the kind 23c2 / 23d2 write for gpio16 / gpio102): gpio26 io = out 1 (idle), ctl = function 0 +
+ *   output enable (2 mA, no pull); then per byte the io register; undo: gpio26 ctl / io as found.
+ *   sent (H4): HCI_Reset 01 03 0c 00 (expect 04 0e 04 01 03 0c 00), then QCA's version request (btqca
+ *   qca_read_soc_version: EDL_PATCH_CMD 0xfc00, EDL_PATCH_VER_REQ_CMD 0x19 = 01 00 fc 01 19; expect a 04 ff vendor
+ *   event); a 5 ms quiet capture first; each reply captured for 30 ms (interrupts off at most ~31 ms at a time).
+ */
+#define F3_TX                   26
+#define F3_RX                   27
+#define F3_MAXEDGE              2048
+static int f3_level_arg;                /* icespmi; 4 = 23f3 */
+static uint32_t f3_et[F3_MAXEDGE];
+static uint8_t f3_ev[F3_MAXEDGE];
+
+static int
+f3_txrx(vm_offset_t tx, vm_offset_t rx, uint32_t io_idle, const uint8_t *b, int n, uint32_t cap_us, uint32_t *maxgap_ns)
+{
+	uint64_t t0, now, bit = 0, end, last_s, maxgap = 0, dl;
+	uint32_t lv;
+	int edges = 0;
+	boolean_t ie;
+
+	nanoseconds_to_absolutetime(cap_us * 1000ull, &end);
+	ie = ml_set_interrupts_enabled(FALSE);
+	t0 = mach_absolute_time();
+	/* TX: start bit, 8 data bits LSB first, stop bit; each level written at its deadline */
+	for (int i = 0; i < n; i++) {
+		for (int k = 0; k < 10; k++) {
+			uint32_t level = k == 0 ? 0 : k == 9 ? 1 : (b[i] >> (k - 1)) & 1;
+			nanoseconds_to_absolutetime((bit * 1000000000ull) / 115200, &dl);
+			while (mach_absolute_time() - t0 < dl) {
+			}
+			*(volatile uint32_t *)(tx + 4) = level ? (io_idle | 2u) : (io_idle & ~2u);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			bit++;
+		}
+	}
+	nanoseconds_to_absolutetime((bit * 1000000000ull) / 115200, &dl);
+	while (mach_absolute_time() - t0 < dl) {
+	}
+	/* RX: every edge of gpio27 for cap_us */
+	t0 = last_s = mach_absolute_time();
+	lv = io_rd(rx, 4) & 1;
+	while ((now = mach_absolute_time()) - t0 < end) {
+		uint32_t v = io_rd(rx, 4) & 1;
+		if (now - last_s > maxgap) {
+			maxgap = now - last_s;
+		}
+		last_s = now;
+		if (v != lv) {
+			if (edges < F3_MAXEDGE) {
+				f3_et[edges] = (uint32_t)(now - t0);
+				f3_ev[edges] = (uint8_t)v;
+			}
+			edges++;
+			lv = v;
+		}
+	}
+	ml_set_interrupts_enabled(ie);
+	absolutetime_to_nanoseconds(maxgap, &maxgap);
+	*maxgap_ns = (uint32_t)maxgap;
+	return edges;
+}
+
+/* the level at t (abs ticks since the capture start), from the edge list; idle 1 before the first edge */
+static uint32_t
+f3_level(int edges, uint64_t t)
+{
+	uint32_t v = 1;
+
+	for (int i = 0; i < edges && i < F3_MAXEDGE && f3_et[i] <= t; i++) {
+		v = f3_ev[i];
+	}
+	return v;
+}
+
+static int
+f3_decode(int edges, uint8_t *out, int max, int *framing)
+{
+	uint64_t T, half, t;
+	int n = 0, e = 0;
+
+	nanoseconds_to_absolutetime(1000000000ull / 115200, &T);
+	half = T / 2;
+	*framing = 0;
+	while (e < edges && e < F3_MAXEDGE && n < max) {
+		uint32_t byte = 0;
+		if (f3_ev[e] != 0) {                    /* a start bit begins with a falling edge */
+			e++;
+			continue;
+		}
+		t = f3_et[e];
+		for (int k = 0; k < 8; k++) {
+			byte |= f3_level(edges, t + T + half + (uint64_t)k * T) << k;
+		}
+		if (f3_level(edges, t + 9 * T + half) != 1) {
+			(*framing)++;
+		}
+		out[n++] = (uint8_t)byte;
+		while (e < edges && e < F3_MAXEDGE && f3_et[e] < t + 9 * T + half) {
+			e++;
+		}
+	}
+	return n;
+}
+
+static void
+f3_cmd(const char *name, vm_offset_t tx, vm_offset_t rx, uint32_t io_idle, const uint8_t *b, int n, uint32_t cap_us)
+{
+	uint8_t r[96];
+	char hex[96 * 3 + 1];
+	uint32_t gap = 0;
+	int edges = f3_txrx(tx, rx, io_idle, b, n, cap_us, &gap), framing = 0, m;
+
+	m = f3_decode(edges, r, (int)sizeof(r), &framing);
+	for (int i = 0; i < m; i++) {
+		snprintf(hex + 3 * i, 4, "%02x ", r[i]);
+	}
+	hex[m ? 3 * m - 1 : 0] = 0;
+	say("icespmi: 23f3 %s: sent %d bytes, %u us captured: %d edges (max sample gap %u ns), %d bytes [%s], framing errors %d\n",
+	    name, n, cap_us, edges, gap, m, hex, framing);
+	if (edges > 0 && m == 0) {
+		say("icespmi: 23f3 %s: first edges (ticks/level): %u/%u %u/%u %u/%u %u/%u %u/%u %u/%u\n", name, f3_et[0], f3_ev[0],
+		    f3_et[1], f3_ev[1], f3_et[2], f3_ev[2], f3_et[3], f3_ev[3], f3_et[4], f3_ev[4], f3_et[5], f3_ev[5]);
+	}
+}
