+#define SWRS_SCP_HOST_CLK_DIV2_CTL_BANK(m) (0x00e0 + 0x10 * (m))
+#define SWRS_DP_CHANNEL_ENABLE_BANK(n, m) (0x120 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_SAMPLE_CONTROL_1_BANK(n, m) (0x122 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_SAMPLE_CONTROL_2_BANK(n, m) (0x123 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_OFFSET_CONTROL_1_BANK(n, m) (0x124 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_OFFSET_CONTROL_2_BANK(n, m) (0x125 + 0x100 * (n) + 0x10 * (m))
+#define SWRS_DP_LANE_CONTROL_BANK(n, m) (0x128 + 0x100 * (n) + 0x10 * (m))
+#define SWRM_MCP_STATUS                 0x104c
+#define SWRM_MCP_FRAME_CTRL_BANK(m)     (0x101c + 0x40 * (m))
+#define SWRM_DP_PORT_CTRL_BANK(n, m)    (0x1024 + 0x100 * (n) + 0x40 * (m))
+#define SWRM_DP_PORT_CTRL_2_BANK(n, m)  (0x1028 + 0x100 * (n) + 0x40 * (m))
+#define SWRM_DP_PORT_HCTRL_BANK(n, m)   (0x1034 + 0x100 * (n) + 0x40 * (m))
+#define SWRM_DP_SAMPLECTRL2_BANK(n, m)  (0x103c + 0x100 * (n) + 0x40 * (m))
+
+static uint8_t write_id;
+
+/* a register of the codec's (device codec_device on the bus) written and, unless `check' is 0, read back */
+static bool
+codec_put(uint16_t reg, uint8_t value, uint8_t check)
+{
+	uint8_t back = 0;
+
+	if (broken) {
+		return false;
+	}
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, reg, value, write_id);
+	if (check == 0) {
+		note("mic: the codec's %#06x <- %#04x\n", reg, value);
+		return true;
+	}
+	if (!swr_read(codec_device, reg, &back) || (back & check) != (value & check)) {
+		say("mic: the codec's %#06x <- %#04x, but it reads %#04x: STOPPING HERE\n", reg, value, back);
+		broken = true;
+		return false;
+	}
+	note("mic: the codec's %#06x <- %#04x, reads back\n", reg, value);
+	return true;
+}
+
+static bool
+codec_bits(uint16_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now = 0;
+
+	if (broken || !swr_read(codec_device, reg, &now)) {
+		broken = true;
+		return false;
+	}
+	return (now & mask) == (value & mask) || codec_put(reg, (uint8_t)((now & ~mask) | (value & mask)), mask);
+}
+
+/* a command to all devices on the bus (device 15, command id 15: Android's broadcasts) */
+static void
+broadcast(uint16_t reg, uint8_t value)
+{
+	swr_write(0xf, reg, value, 0xf);
+	note("mic: SoundWire, to all: %#06x <- %#04x\n", reg, value);
+	sleep_ms(10);           /* ("10 ms for the broadcast to complete", swrm_cmd_fifo_wr_cmd()) */
+}
+
+/* to all devices, with an ordinary command id (swrm_cmd_fifo_wr_cmd(..., 0xF, 0x00, ...)) */
+static void
+to_all(uint16_t reg, uint8_t value)
+{
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(0xf, reg, value, write_id);
+	note("mic: SoundWire, to all: %#06x <- %#04x\n", reg, value);
+}
+
+/* wcd938x_bind(), wcd938x_set_micbias_data(), wcd938x_init_reg() */
+static bool
+codec_init(void)
+{
+	uint8_t efuse = 0;
+	/* the tree's qcom,cdc-micbias1..4-mv: 2750 mV, (2750 - 1000) / 50 */
+	const uint8_t vout = (2750 - 1000) / 50;
+
+	if (!codec_put(WCD_INTR_LEVEL_0, 0, 0xff) || !codec_put(WCD_INTR_LEVEL_0 + 1, 0, 0xff) ||
+	    !codec_put(WCD_INTR_LEVEL_0 + 2, 0, 0xff) ||
+	    !codec_bits(WCD_ANA_MICB1, 0x3f, vout) || !codec_bits(WCD_ANA_MICB2, 0x3f, vout) ||
+	    !codec_bits(WCD_ANA_MICB3, 0x3f, vout) || !codec_bits(WCD_ANA_MICB4, 0x3f, vout) ||
+	    !codec_bits(WCD_SLEEP_CTL, 0x0e, 0x0e) || !codec_bits(WCD_SLEEP_CTL, 0x80, 0x80)) {
+		return false;
+	}
+	sleep_ms(1);
+	if (!codec_bits(WCD_SLEEP_CTL, 0x40, 0x40)) {
+		return false;
+	}
+	sleep_ms(1);
+	if (!codec_bits(WCD_LDORXTX_CONFIG, 0x10, 0x00) || !codec_bits(WCD_BIAS_VBG_FINE_ADJ, 0xf0, 0x80) ||
+	    !codec_bits(WCD_ANA_BIAS, 0x80, 0x80) || !codec_bits(WCD_ANA_BIAS, 0x40, 0x40)) {
+		return false;
+	}
+	sleep_ms(10);
+	if (!codec_bits(WCD_ANA_BIAS, 0x40, 0x00) || !codec_bits(WCD_HPH_NEW_INT_RDAC_GAIN_CTL, 0xf0, 0x00) ||
+	    !codec_bits(WCD_HPH_NEW_INT_RDAC_HD2_CTL_L, 0x1f, 0x15) || !codec_bits(WCD_HPH_NEW_INT_RDAC_HD2_CTL_R, 0x1f, 0x15) ||
+	    !codec_bits(WCD_HPH_REFBUFF_UHQA_CTL, 0xc0, 0x80) || !codec_bits(WCD_CDC_DMIC_CTL, 0x02, 0x02) ||
+	    !codec_bits(WCD_TXFE_ICTRL_STG2CASC_ULP, 0xff, 0x14) || !codec_bits(WCD_TXFE_ICTRL_STG2MAIN_ULP, 0x1f, 0x08) ||
+	    !codec_bits(WCD_TX_REQ_FB_CTL_0, 0xff, 0x55) || !codec_bits(WCD_TX_REQ_FB_CTL_0 + 1, 0xff, 0x44) ||
+	    !codec_bits(WCD_TX_REQ_FB_CTL_0 + 2, 0xff, 0x11) || !codec_bits(WCD_TX_REQ_FB_CTL_0 + 3, 0xff, 0x00) ||
+	    !codec_bits(WCD_TX_REQ_FB_CTL_0 + 4, 0xff, 0x00) ||
+	    !codec_bits(WCD_MICB1_TEST_CTL_1, 0xe0, 0xe0) || !codec_bits(WCD_MICB2_TEST_CTL_1, 0xe0, 0xe0) ||
+	    !codec_bits(WCD_MICB3_TEST_CTL_1, 0xe0, 0xe0) || !codec_bits(WCD_MICB4_TEST_CTL_1, 0xe0, 0xe0) ||
+	    !codec_bits(WCD_TX_3_4_TEST_BLK_EN2, 0x01, 0x00) || !swr_read(codec_device, WCD_EFUSE_REG_30, &efuse) ||
+	    !codec_bits(WCD_SLEEP_CTL, 0x0e, (uint8_t)((efuse & 0x07) << 1)) ||
+	    !codec_bits(WCD_HPH_SURGE_HPHLR_SURGE_EN, 0xc0, 0x00)) {
+		return false;
+	}
+	say("mic: the codec is set up as wcd938x_init_reg() sets it up (efuse 30: %#x)\n", efuse);
+	return true;
+}
+
+/*
+ * The bus and ADC1's data port as Android has them while the phone records from its handset
+ * microphones (the HAL's "handset-mic" = "handset-dmic-endfire": ADC1, the main microphone, and
+ * ADC4, the top one, both in "low power" mode). With two ADCs on, wcd938x_codec_enable_adc() asks
+ * for twice an ADC's 4.8 MHz, 9.6 MHz, and swr-mstr-ctrl adds its ports' rates up to the same: the
+ * bus at 9.6 MHz (MCLK / 1), the frame 50 rows x 16 columns, the codec's TX clock rate "9.6 MHz".
+ * The ports then come from the 9.6 MHz tables: the codec's (the tree's qcom,swr-phy-dev-addr makes
+ * swrm_get_device_frame_shape() use swrdev_frame_params_9p6MHz: tx_wcd_9p6MHz TX1 { si 3, offsets
+ * 0 0, lane 1 }) and the master's (sm_port_map_shima, usecase 0: tx_frame_params_shima TX1 { si 7,
+ * offsets 0 0, lane 1 }). ADC1 alone is all that is on here; its port is the codec's port 0 (its
+ * DP1), channel 1, to the master's port 1, channel 1. Written into the bank not in use, then the
+ * banks switched, then the other bank.
+ *
+ * Android's tables for ADC1 alone (the "main-mic" path: a 4.8 MHz bus, si 7 on both sides) carry
+ * half of what ADC1 makes in "low power" mode: what comes out of the decimator is then a loud,
+ * clipped tone at about the bus clock / 560, whatever the microphone hears (mic_main=1 shows it).
+ */
+static uint8_t bank_now;
+static uint32_t adc_on = 1;             /* boot-arg mic_adc=0 (a test): ADC1 and its mic bias left off, the port alone */
+static uint32_t main_timing;            /* boot-arg mic_main=1 (a test): the bus and ports of Android's one-microphone tables */
+static uint32_t tap;                    /* boot-arg mic_tap=1 (a test): the vibration motor (haptic=5) runs from 2 s to 3 s of listening */
+static uint32_t test_bits;              /* boot-arg mic_test=N (tests): 1 no mic bias, 2 the ADC's input held (HPF init) */
+
+static bool
+port_config(uint8_t bank, bool first)
+{
+	uint8_t codec_interval = main_timing ? 7 : 3, master_interval = 7;
+
+	/* the codec's side (swrm_apply_port_config() first: the devices' clock halved in that bank) */
+	if (first) {
+		to_all(SWRS_SCP_HOST_CLK_DIV2_CTL_BANK(bank), 0x01);
+	}
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_CHANNEL_ENABLE_BANK(0, bank), 0x01, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_SAMPLE_CONTROL_1_BANK(0, bank), codec_interval, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_SAMPLE_CONTROL_2_BANK(0, bank), 0, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_OFFSET_CONTROL_1_BANK(0, bank), 0, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_OFFSET_CONTROL_2_BANK(0, bank), 0, write_id);
+	write_id = write_id < 14 ? write_id + 1 : 0;
+	swr_write(codec_device, SWRS_DP_LANE_CONTROL_BANK(0, bank), 1, write_id);
+	note("mic: the codec's data port 1, bank %u: channel 1 on, sample interval %u, offsets 0 0, lane 1\n", bank, codec_interval);
+	/* the master's port 1 */
+	return put(&tx_swr, "DP_PORT_CTRL (port 1): channel 1, offsets 0 0, interval 7", SWRM_DP_PORT_CTRL_BANK(1, bank),
+	           0x01u << 24 | 0u << 16 | 0u << 8 | master_interval, 0xffffffff) &&
+	       put(&tx_swr, "DP_SAMPLECTRL2 (port 1)", SWRM_DP_SAMPLECTRL2_BANK(1, bank), 0, 0xff) &&
+	       put(&tx_swr, "DP_PORT_CTRL_2 (port 1): lane 1", SWRM_DP_PORT_CTRL_2_BANK(1, bank), 1, 0xff) &&
+	       /* (it reads 0 back on the phone whatever is written; Android writes it and never reads it) */
+	       put(&tx_swr, "DP_PORT_HCTRL (port 1): hstop 15, hstart 0", SWRM_DP_PORT_HCTRL_BANK(1, bank), 0xf0, 0);
+}
+
+static bool
+datapath_on(void)
+{
+	/* the codec's TX clock rate: "9.6 MHz" (0) in both banks; "4.8 MHz" (1) for mic_main=1 */
+	uint8_t current = 0, bank, rate = main_timing ? 1 : 0;
+	uint32_t frame;
+
+	/* wcd938x_codec_enable_adc(): the codec's TX clock rate in the bank about to be used */
+	if (!swr_read(codec_device, SWRS_SCP_CONTROL, &current)) {
+		return false;
+	}
+	bank = (current & 0x40) ? 0 : 1;
+	if (!codec_bits(WCD_SWR_TX_CLK_RATE, bank ? 0xf0 : 0x0f, (uint8_t)(bank ? rate << 4 : rate))) {
+		return false;
+	}
+	/* swrm_slvdev_datapath_control() */
+	bank = (swr_rd(SWRM_MCP_STATUS) & 1) ? 0 : 1;
+	if (!put(&tx_swr, "CPU1_INTERRUPT_EN", SWRM_CPU1_INTERRUPT_EN, SWRM_INTERRUPT_STATUS_MASK, 0) || !port_config(bank, true)) {
+		return false;
+	}
+	/*
+	 * 50 rows, 16 columns; the bus at 9.6 MHz: MCLK / 1, "ssp period" 9.6 MHz x 2 / (50 x 16 x 4000) = 6
+	 * (mic_main=1: 4.8 MHz, MCLK / 2, 3)
+	 */
+	frame = (swr_rd(SWRM_MCP_FRAME_CTRL_BANK(bank)) & ~0xff07ffu) | 1u << 3 | 7u | (main_timing ? 1u : 0u) << 8 |
+	    (main_timing ? 3u - 1 : 6u - 1) << 16;
+	if (!put(&tx_swr, main_timing ? "MCP_FRAME_CTRL (the bank to come): 50 x 16, MCLK / 2" :
+	    "MCP_FRAME_CTRL (the bank to come): 50 x 16, MCLK / 1", SWRM_MCP_FRAME_CTRL_BANK(bank), frame, 0xff07ff)) {
+		return false;
+	}
+	broadcast(SWRS_SCP_FRAME_CTRL_BANK(bank), 1u << 3 | 7u);       /* (enable_bank_switch(): the switch itself) */
+	bank_now = (swr_rd(SWRM_MCP_STATUS) & 1);
+	say("mic: the banks switched: the master is in bank %u now (asked for %u)\n", bank_now, bank);
+	if (bank_now != bank || !port_config(bank ? 0 : 1, false)) {
+		return false;
+	}
+	/* and the codec's rate in the other bank */
+	if (!codec_bits(WCD_SWR_TX_CLK_RATE, bank ? 0x0f : 0xf0, (uint8_t)(bank ? rate : rate << 4))) {
+		return false;
+	}
+	/* (what the codec's port says it is set to, both banks; its interrupts) */
+	for (uint8_t b = 0; b < 2; b++) {
+		uint8_t v[6] = { 0 };
+
+		(void)swr_read(codec_device, SWRS_DP_CHANNEL_ENABLE_BANK(0, b), &v[0]);
+		(void)swr_read(codec_device, SWRS_DP_SAMPLE_CONTROL_1_BANK(0, b), &v[1]);
+		(void)swr_read(codec_device, SWRS_DP_OFFSET_CONTROL_1_BANK(0, b), &v[2]);
+		(void)swr_read(codec_device, SWRS_DP_LANE_CONTROL_BANK(0, b), &v[3]);
+		(void)swr_read(codec_device, SWRS_SCP_FRAME_CTRL_BANK(b), &v[4]);
+		(void)swr_read(codec_device, SWRS_SCP_HOST_CLK_DIV2_CTL_BANK(b), &v[5]);
+		note("mic: the codec's DP1, bank %u: channels %#x, interval %u, offset %u, lane %u; frame %#x, div2 %#x\n", b, v[0], v[1],
+		    v[2], v[3], v[4], v[5]);
+	}
+	{
+		uint8_t status = 0, control = 0, dp_int = 0, dp_ctl = 0;
+
+		(void)swr_read(codec_device, 0x0040, &status);
+		(void)swr_read(codec_device, SWRS_SCP_CONTROL, &control);
+		(void)swr_read(codec_device, 0x0100, &dp_int);
+		(void)swr_read(codec_device, 0x0102, &dp_ctl);
+		note("mic: the codec's SCP int status %#x, control/status %#x; DP1 int status %#x, port control %#x; the master's DP1 "
+		    "interrupt status %#x\n", status, control, dp_int, dp_ctl, swr_rd(0x1100));
+	}
+	return true;
+}
+
+/* "MIC BIAS1" (wcd938x_micbias_control(MICB_ENABLE)), then ADC1's request (wcd938x_enable_req()) in "low power" mode */
+static bool
+adc1_on(void)
+{
+	return codec_bits(WCD_CDC_DIG_CLK_CTL, 0xf0, 0xf0) && codec_bits(WCD_CDC_ANA_CLK_CTL, 0x10, 0x10) &&
+	       codec_bits(WCD_CDC_ANA_TX_CLK_CTL, 0x01, 0x01) && codec_bits(WCD_MICB1_TEST_CTL_2, 0x01, 0x01) &&
+	       codec_bits(WCD_MICB2_TEST_CTL_2, 0x01, 0x01) && codec_bits(WCD_MICB3_TEST_CTL_2, 0x01, 0x01) &&
+	       codec_bits(WCD_MICB4_TEST_CTL_2, 0x01, 0x01) && codec_bits(WCD_ANA_MICB1, 0xc0, (test_bits & 1) ? 0x00 : 0x40) &&
+	       /* "ADC1 Volume" 6 (Xiaomi's mixer paths) */
+	       codec_bits(WCD_ANA_TX_CH1, 0x1f, 6) &&
+	       codec_bits(WCD_CDC_ANA_CLK_CTL, 0x08, 0x08) && codec_bits(WCD_CDC_ANA_CLK_CTL, 0x10, 0x10) &&
+	       codec_bits(WCD_CDC_REQ_CTL, 0x02, 0x02) && codec_bits(WCD_CDC_REQ_CTL, 0x01, 0x00) &&
+	       codec_bits(WCD_ANA_TX_CH2, 0x40, 0x40) && codec_bits(WCD_CDC_TX_ANA_MODE_0_1, 0x0f, 0x05) &&
+	       codec_bits(WCD_CDC_DIG_CLK_CTL, 0x10, 0x10) && codec_bits(WCD_ANA_TX_CH2, 0x40, (test_bits & 2) ? 0x40 : 0x00);
+}
+
+/* ---- the TX macro's decimator 1 ------------------------------------------------------------------------- */
+
+#define TX_TOP_CSR_SWR_CTRL             0x088
+#define TX_SWR_MIC0_CTL                 0x0d0
+#define TX_SWR_MIC1_CTL                 0x0d4
+#define TX_SWR_MIC2_CTL                 0x0c0
+#define TX_ADC_MUX1_CFG0                0x108
+#define TX_ADC_MUX1_CFG1                0x10c
+#define TX1_PATH_CTL                    0x480
+#define TX1_PATH_CFG0                   0x484
+#define TX1_VOL_CTL                     0x48c
+#define TX1_PATH_SEC2                   0x498
+
+#define VA_CORE_ID_0                    0x0c0
+#define VA_CORE_ID_1                    0x0c4
+#define VA_SWR_MIC_CTL0                 0x0d0
+#define VA_SWR_MIC_CTL1                 0x0d4
+#define VA_SWR_MIC_CTL2                 0x0d8
+
+static uint32_t found_dec[10], found_va_mic[3];
+static uint32_t smic_input = 1;         /* boot-arg mic_input=N: TX SMIC MUX1's input (1 SWR_MIC0, Android's; 0 ZERO, a test) */
+static bool dec_taken, va_mic_taken;
+static unsigned bolero_version;         /* 20 or 21: the digital codec's own core ID (bolero_soc_codec_probe()) */
+static uint8_t hpf_cut_off;             /* the decimator's high-pass filter as it was found */
+
+static const uint32_t dec_regs[] = {
+	TX_TOP_CSR_SWR_CTRL, TX_SWR_MIC0_CTL, TX_SWR_MIC1_CTL, TX_SWR_MIC2_CTL, TX_SWR_MIC2_CTL + 4, TX_SWR_MIC2_CTL + 8,
+	TX_SWR_MIC2_CTL + 12, TX_ADC_MUX1_CFG0, TX_ADC_MUX1_CFG1, TX1_PATH_CTL,
+};
+
+/*
+ * Which bolero this is: its core ID, as bolero_soc_codec_probe() reads it (01 0F: 2.0, 02 0E: 2.1),
+ * whatever the tree says ("qcom,bolero-version" 4). 2.1 has the SoundWire mics' clock dividers in
+ * the VA macro, which va_macro_init() sets (SWR_MIC_CTL0..2: 0xEE, 0xCC); 2.0 in the TX macro,
+ * which tx_macro_enable_dec() sets.
+ */
+static bool
+bolero_look(void)
+{
+	uint32_t id0 = get(&va_macro, "CORE_ID_0", VA_CORE_ID_0) & 0xff, id1 = get(&va_macro, "CORE_ID_1", VA_CORE_ID_1) & 0xff;
+
+	bolero_version = id0 == 0x01 && id1 == 0x0f ? 20 : id0 == 0x02 && id1 == 0x0e ? 21 : 0;
+	say("mic: the digital codec is bolero %s\n", bolero_version == 20 ? "2.0" : bolero_version == 21 ? "2.1" : "OF AN UNKNOWN VERSION");
+	if (bolero_version != 21) {
+		return bolero_version == 20;
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		found_va_mic[i] = get(&va_macro, "SWR_MIC_CTL (as found)", VA_SWR_MIC_CTL0 + 4 * i);
+	}
+	va_mic_taken = true;
+	return put_bits(&va_macro, "SWR_MIC_CTL0 (va_macro_init())", VA_SWR_MIC_CTL0, 0xee, 0xcc) &&
+	       put_bits(&va_macro, "SWR_MIC_CTL1", VA_SWR_MIC_CTL1, 0xee, 0xcc) &&
+	       put_bits(&va_macro, "SWR_MIC_CTL2", VA_SWR_MIC_CTL2, 0xee, 0xcc);
+}
+
+/* the mixer controls' writes ("TX SMIC MUX1" SWR_MIC0, "TX DEC1 MUX" SWR_MIC), hw_params' rate, and the decimator's PMU */
+static bool
+dec1_on(void)
+{
+	uint32_t cfg0;
+
+	for (size_t i = 0; i < sizeof(dec_regs) / sizeof(dec_regs[0]); i++) {
+		found_dec[i] = get(&tx_macro, "(as found)", dec_regs[i]);
+	}
+	dec_taken = true;
+	if (!put_bits(&tx_macro, "TX1_TX_PATH_CFG0: an analog mic", TX1_PATH_CFG0, 0x80, 0x00) ||
+	    !put_bits(&tx_macro, smic_input == 1 ? "ADC_MUX1_CFG0: SWR_MIC0" : "ADC_MUX1_CFG0: ANOTHER INPUT (mic_input)", TX_ADC_MUX1_CFG0,
+	    0x0f, smic_input & 0x0f) ||
+	    !put_bits(&tx_macro, "ADC_MUX1_CFG1: SWR_MIC", TX_ADC_MUX1_CFG1, 0x03, 0x01) ||
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CTL: 48 kHz", TX1_PATH_CTL, 0x0f, 0x04) ||
+	    /* PRE_PMU: the decimator's mode (0), its PGA muted */
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CFG0: mode 0", TX1_PATH_CFG0, 0x06, 0x00) ||
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CTL: muted", TX1_PATH_CTL, 0x10, 0x10) ||
+	    /* POST_PMU: on; the high-pass filter at 150 Hz while it settles */
+	    !put_bits(&tx_macro, "TX1_TX_PATH_CTL: on", TX1_PATH_CTL, 0x20, 0x20)) {
+		return false;
+	}
+	cfg0 = get(&tx_macro, "TX1_TX_PATH_CFG0", TX1_PATH_CFG0);
+	hpf_cut_off = (cfg0 & 0x60) >> 5;
+	if (hpf_cut_off != 2 && !put_bits(&tx_macro, "TX1_TX_PATH_CFG0: high-pass 150 Hz", TX1_PATH_CFG0, 0x60, 2u << 5)) {
+		return false;
+	}
+	if (hpf_cut_off != 2) {
+		if (!put_bits(&tx_macro, "TX1_TX_PATH_SEC2: filter gate", TX1_PATH_SEC2, 0x03, 0x02)) {
+			return false;
+		}
+		sleep_ms(6);
+		if (!put_bits(&tx_macro, "TX1_TX_PATH_SEC2", TX1_PATH_SEC2, 0x02, 0x00)) {
+			return false;
+		}
+	}
+	/* the gain, written again after the decimator is on ("TX_DEC1 Volume" 84: 0 dB) */
+	if (!put(&tx_macro, "TX1_TX_VOL_CTL: 0 dB", TX1_VOL_CTL, get(&tx_macro, "TX1_TX_VOL_CTL", TX1_VOL_CTL), 0xff)) {
+		return false;
+	}
+	if (bolero_version != 20) {
+		return true;
+	}
+	/* bolero 2.0 only: the SoundWire mics' clocks */
+	return put_bits(&tx_macro, "TOP_CSR_SWR_CTRL", TX_TOP_CSR_SWR_CTRL, 0x01, 0x01) &&
+	       put_bits(&tx_macro, "SWR_MIC0_CTL", TX_SWR_MIC0_CTL, 0x0e, 0x0c) &&
+	       put_bits(&tx_macro, "SWR_MIC1_CTL", TX_SWR_MIC1_CTL, 0x0e, 0x0c) &&
+	       put_bits(&tx_macro, "SWR_MIC2_CTL", TX_SWR_MIC2_CTL, 0x0e, 0x00) &&
+	       put_bits(&tx_macro, "SWR_MIC3_CTL", TX_SWR_MIC2_CTL + 4, 0x0e, 0x00) &&
+	       put_bits(&tx_macro, "SWR_MIC4_CTL", TX_SWR_MIC2_CTL + 8, 0x0e, 0x00) &&
+	       put_bits(&tx_macro, "SWR_MIC5_CTL", TX_SWR_MIC2_CTL + 12, 0x0e, 0x00);
+}
+
+/* after TX_MACRO_AMIC_UNMUTE_DELAY_MS: the PGA unmuted */
+static bool
+dec1_unmute(void)
+{
+	return put_bits(&tx_macro, "TX1_TX_PATH_CTL: unmuted", TX1_PATH_CTL, 0x10, 0x00);
+}
+
+/* after TX_MACRO_AMIC_HPF_DELAY_MS: the codec's hold on ADC1 let go, the filter back to where it was */
+static bool
+dec1_settled(void)
+{
+	return codec_bits(WCD_ANA_TX_CH2, 0x40, (test_bits & 2) ? 0x40 : 0x00) &&
+	       put_bits(&tx_macro, "TX1_TX_PATH_CFG0: high-pass as it was", TX1_PATH_CFG0, 0x60, (uint32_t)hpf_cut_off << 5) &&
+	       put_bits(&tx_macro, "TX1_TX_PATH_SEC2: filter gate", TX1_PATH_SEC2, 0x03, 0x02) &&
+	       (spin_us(21), put_bits(&tx_macro, "TX1_TX_PATH_SEC2", TX1_PATH_SEC2, 0x03, 0x01));
+}
+
+static void
+dec1_off(void)
+{
+	if (!dec_taken) {
+		return;
+	}
+	broken = false;
+	(void)put_bits(&tx_macro, "TX1_TX_PATH_CTL: muted", TX1_PATH_CTL, 0x10, 0x10);
+	(void)put_bits(&tx_macro, "TX1_TX_PATH_CTL: off", TX1_PATH_CTL, 0x20, 0x00);
+	for (size_t i = 0; i < sizeof(dec_regs) / sizeof(dec_regs[0]); i++) {
+		(void)put(&tx_macro, "(put back as found)", dec_regs[i], found_dec[i], 0);
+	}
+	dec_taken = false;
+}
+
+static void
+va_mic_off(void)
+{
+	if (!va_mic_taken) {
+		return;
+	}
+	broken = false;
+	for (unsigned i = 0; i < 3; i++) {
+		(void)put(&va_macro, "SWR_MIC_CTL (put back as found)", VA_SWR_MIC_CTL0 + 4 * i, found_va_mic[i], 0);
+	}
+	va_mic_taken = false;
+}
+
+/* ---- the DSP: the codec DMA port, a device path for recording, a stream that is read ------------------ */
+
+#define APR_SVC_ASM                             7
+#define APR_SVC_ADM                             8
+#define AFE_PORT_CMD_DEVICE_START               0x000100e5u
+#define AFE_PORT_CMD_DEVICE_STOP                0x000100e6u
+#define AFE_PORT_CMD_SET_PARAM_V2               0x000100efu
+#define AFE_MODULE_AUDIO_DEV_INTERFACE          0x0001020cu
+#define AFE_PARAM_ID_CODEC_DMA_CONFIG           0x000102b8u
+#define MIC_PORT                                0xb037          /* TX_CDC_DMA_TX_3 */
+#define ADM_CMD_DEVICE_OPEN_V5                  0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5               0x00010329u
+#define ADM_CMD_DEVICE_CLOSE_V5                 0x00010327u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5          0x00010325u
+#define ADM_PATH_LIVE_RECORDING                 2
+#define ADM_MATRIX_AUDIO_TX                     1
+#define ADM_TOPOLOGY_NONE                       0x00010312u
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS          0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS       0x00010d93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS        0x00010d94u
+#define ASM_STREAM_CMD_OPEN_READ_V3             0x00010db4u
+#define ASM_STREAM_CMD_SET_ENCDEC_PARAM         0x00010c10u
+#define ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2      0x00010da3u
+#define ASM_SESSION_CMD_RUN_V2                  0x00010daau
+#define ASM_DATA_CMD_READ_V2                    0x00010dacu
+#define ASM_DATA_EVENT_READ_DONE_V2             0x00010d9au
+#define ASM_STREAM_CMD_CLOSE                    0x00010bcdu
+#define ASM_TOPOLOGY_NONE                       0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2      0x00010da5u
+#define ASM_SHMEM_4K_POOL                       3
+#define MIC_SESSION                             2               /* (the speakers' is 1) */
+#define MIC_STREAM_PORT                         (MIC_SESSION << 8 | 1)
+#define READ_TOKEN                              0x40000000u     /* | the period */
+#define PCM_CHANNEL_FC                          3
+#define MIC_RATE                                48000
+#define MIC_PERIODS                             8
+#define MIC_PERIOD_FRAMES                       960             /* 20 ms, one channel of 16 bits */
+#define MIC_PERIOD_BYTES                        (MIC_PERIOD_FRAMES * 2)
+
+static uintptr_t mic_memory;
+static uint64_t mic_address;
+static bool memory_taken, mic_mapped, mic_copp_open, mic_stream_open, mic_port_on;
+static uint32_t mic_map_handle, mic_copp;
+static volatile uint32_t read_ready, read_errors, reads_done;
+static volatile uint32_t read_sizes[MIC_PERIODS];
+
+static bool
+mic_events(uint8_t service, __unused uint16_t port, uint32_t opcode, uint32_t token, const uint32_t *payload, uint32_t length)
+{
+	if (service != APR_SVC_ASM || !(token & READ_TOKEN) || (token & 0x3fffffff) >= MIC_PERIODS) {
+		return false;
+	}
+	if (opcode == ASM_DATA_EVENT_READ_DONE_V2) {
+		if (length < 24 || payload[0] != 0) {
+			OSIncrementAtomic((volatile SInt32 *)&read_errors);
+		}
+		read_sizes[token & 0x3fffffff] = length >= 24 ? payload[4] : 0;
+		OSIncrementAtomic((volatile SInt32 *)&reads_done);
+		OSBitOrAtomic(1u << (token & 31), &read_ready);
+		return true;
+	}
+	if (opcode == APR_BASIC_RSP_RESULT) {
+		OSIncrementAtomic((volatile SInt32 *)&read_errors);
+		OSBitOrAtomic(1u << (token & 31), &read_ready);
+		read_sizes[token & 0x3fffffff] = 0;
+		return true;
+	}
+	return false;
+}
+
+static bool
+mic_read(unsigned period)
+{
+	uint32_t read[5] = { (uint32_t)(mic_address + 4096 * period), (uint32_t)((mic_address + 4096 * period) >> 32),
+		             mic_map_handle, MIC_PERIOD_BYTES, period };
+
+	return redwood_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, READ_TOKEN | period, ASM_DATA_CMD_READ_V2, read, sizeof(read), 0, NULL);
+}
+
+static bool
+afe_port_param(uint32_t module, uint32_t param, const void *data, uint16_t size, const char *what)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	*(uint16_t *)packet = MIC_PORT;
+	*(uint16_t *)(packet + 2) = (uint16_t)(sizeof(*p) + size);
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, AFE_PORT_CMD_SET_PARAM_V2, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+/* the stream and the path, opened, mapped and routed (msm-pcm-q6 and q6adm/q6asm at a recording's open and prepare) */
+static bool
+dsp_path_on(void)
+{
+	struct {
+		uint16_t pool, regions;
+		uint32_t property, low, high, size;
+	} __attribute__((packed)) map = { ASM_SHMEM_4K_POOL, 1, 0, 0, 0, 0 };
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) open = { 0, ADM_PATH_LIVE_RECORDING, MIC_PORT, 0xffff, ADM_TOPOLOGY_NONE, 1, 16, MIC_RATE,
+		                           { PCM_CHANNEL_FC } };
+	struct {
+		uint32_t mode, endpoint, topology, format;
+		uint16_t bits, reserved;
+	} __attribute__((packed)) reading = { 0, 0, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2, 16, 0 };
+	struct {
+		uint32_t param, size, frames_per_buffer, block_size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) encoder = { ASM_PARAM_ID_ENCDEC_ENC_CFG_BLK_V2, 28, 0, 20, 1, 16, MIC_RATE, 1, 0, { PCM_CHANNEL_FC } };
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps;
+		uint16_t copp[2];
+	} __attribute__((packed)) route = { ADM_MATRIX_AUDIO_TX, 1, MIC_SESSION, 1, { 0, 0 } };
+	struct redwood_apr_answer answer;
+	uint32_t bytes = 0;
+
+	if (!redwood_audio_dsp_memory(&mic_memory, &mic_address, &bytes) || bytes < MIC_PERIODS * 4096) {
+		say("mic: no memory the DSP can see\n");
+		return false;
+	}
+	memory_taken = true;
+	map.low = (uint32_t)mic_address;
+	map.high = (uint32_t)(mic_address >> 32);
+	map.size = MIC_PERIODS * 4096;
+	redwood_adsp_apr_events_second(mic_events);
+	if (!command("our periods for the microphone, mapped for the DSP", APR_SVC_ASM, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map,
+	    sizeof(map), ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, &answer)) {
+		return false;
+	}
+	mic_mapped = true;
+	mic_map_handle = answer.words[0];
+	say("mic: our %u KB at %#llx are the DSP's handle %#x\n", MIC_PERIODS * 4, mic_address, mic_map_handle);
+	if (!redwood_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_OPEN_READ_V3, &reading, sizeof(reading), APR_WAIT_MS,
+	    &answer) || answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the stream, opened for reading: %s (%#x %#x)\n", "REFUSED OR NO ANSWER", answer.opcode, answer.words[1]);
+		return false;
+	}
+	mic_stream_open = true;
+	say("mic: the stream (session 2), opened for reading 16-bit linear PCM, no processing: done\n");
+	if (!redwood_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_SET_ENCDEC_PARAM, &encoder, sizeof(encoder), APR_WAIT_MS,
+	    &answer) || answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the stream's format: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[1]);
+		return false;
+	}
+	say("mic: the stream's format: 1 channel of 16 bits at 48 kHz: done\n");
+	if (!redwood_adsp_apr(APR_SVC_ADM, MIC_PORT, 0, ADM_CMD_DEVICE_OPEN_V5, &open, sizeof(open), APR_WAIT_MS, &answer) ||
+	    answer.opcode != ADM_CMDRSP_DEVICE_OPEN_V5 || answer.words[0] != 0) {
+		say("mic: a device path from the port: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[0]);
+		return false;
+	}
+	mic_copp_open = true;
+	mic_copp = answer.words[1] & 0xffff;
+	route.copp[0] = (uint16_t)mic_copp;
+	say("mic: the device path from port %#x is open: COPP %u (live recording, no processing, 1 channel, 16 bits, 48 kHz)\n",
+	    MIC_PORT, mic_copp);
+	return command("the device path routed to session 2", APR_SVC_ADM, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route), 0,
+	           NULL);
+}
+
+/* the codec DMA port: TX_CDC_DMA_TX_3, one channel of 16 bits at 48 kHz from decimator 1 */
+static bool
+dsp_port_on(void)
+{
+	struct {
+		uint32_t version, rate;
+		uint16_t bits, format, channels, mask;
+	} __attribute__((packed)) config = { 1, MIC_RATE, 16, 0, 1, 1u << 1 };
+	uint16_t start[2] = { MIC_PORT, 0 };
+
+	if (!afe_port_param(AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_CODEC_DMA_CONFIG, &config, sizeof(config),
+	    "the port TX_CDC_DMA_TX_3 (0xb037): 1 channel of 16 bits at 48 kHz, decimator 1")) {
+		return false;
+	}
+	mic_port_on = command("the port 0xb037, started", APR_SVC_AFE, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+	return mic_port_on;
+}
+
+static void
+dsp_off(void)
+{
+	uint16_t stop[2] = { MIC_PORT, 0 };
+
+	if (mic_stream_open) {
+		(void)redwood_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_STREAM_CMD_CLOSE, NULL, 0, APR_WAIT_MS, NULL);
+		say("mic: the stream, closed\n");
+		mic_stream_open = false;
+	}
+	if (mic_copp_open) {
+		(void)redwood_adsp_apr(APR_SVC_ADM, (uint16_t)mic_copp, 0, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, APR_WAIT_MS, NULL);
+		say("mic: the device path, closed\n");
+		mic_copp_open = false;
+	}
+	if (mic_port_on) {
+		(void)command("the port 0xb037, stopped", APR_SVC_AFE, AFE_PORT_CMD_DEVICE_STOP, stop, sizeof(stop), 0, NULL);
+		mic_port_on = false;
+	}
+	if (mic_mapped) {
+		(void)command("our periods, unmapped", APR_SVC_ASM, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &mic_map_handle,
+		    sizeof(mic_map_handle), 0, NULL);
+		mic_mapped = false;
+	}
+	redwood_adsp_apr_events_second(NULL);
+	if (memory_taken) {
+		redwood_audio_dsp_memory_put();
+		memory_taken = false;
+	}
+}
+
+/* ---- mic=4: the microphone for iOS ------------------------------------------------------------------- */
+
+/*
+ * What the microphone hears goes into a ring, and /dev/redwood-mic gives it to iOS's audio server
+ * (RedwoodAudio.driver's device "Codec", userland/src/audio_plugin.c): 16-bit samples, one channel,
+ * 48 kHz. The path is up only while the device is open (the audio server opens it when its input
+ * starts and closes it when it stops), and a read never waits: it gives what has come, keeping the
+ * reader about 40 ms behind the DSP (it comes in 20 ms periods), and nothing until that much is
+ * there; the audio server makes up the rest with silence.
+ */
+#define RING_FRAMES             16384           /* 341 ms; a power of two */
+#define RING_KEEP               1920            /* 40 ms: how far behind the DSP a reader is kept */
+#define RING_MOST               4800            /* 100 ms: more than this waiting, and the oldest is skipped */
+
+static int16_t *ring;
+static volatile uint64_t ring_written;          /* frames put into the ring since the device was made */
+static uint64_t ring_read;                      /* frames taken from it (one reader: the audio server) */
+static bool ring_primed;                        /* the reader is RING_KEEP behind; false after it ran dry */
+static uint64_t ring_skipped, ring_dry;         /* frames skipped, reads that found too little: said when iOS stops */
+static volatile uint32_t ios_wants;             /* the device is open */
+static volatile bool stopping;                  /* the run ends (redwood_mic_dsp_down()) */
+
+static void
+ring_put(const int16_t *samples, uint32_t count)
+{
+	uint64_t at = ring_written;
+
+	for (uint32_t i = 0; i < count; i++) {
+		ring[(at + i) % RING_FRAMES] = samples[i];
+	}
+	__atomic_store_n(&ring_written, at + count, __ATOMIC_RELEASE);
+}
+
+static int
+mic_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint64_t written = __atomic_load_n(&ring_written, __ATOMIC_ACQUIRE), avail, want;
+	int error = 0;
+
+	if (ring == NULL || uio_resid(uio) < 2) {
+		return 0;
+	}
+	want = (uint64_t)uio_resid(uio) / 2;
+	avail = written - ring_read;
+	if (avail > RING_MOST) {
+		ring_skipped += avail - RING_KEEP;
+		ring_read = written - RING_KEEP;
+		avail = RING_KEEP;
+	}
+	if (!ring_primed) {
+		if (avail < RING_KEEP) {
+			return 0;
+		}
+		ring_primed = true;
+	}
+	if (avail < want) {
+		ring_dry++;
+		ring_primed = false;
+	}
+	while (want > 0 && avail > 0 && error == 0) {
+		uint64_t at = ring_read % RING_FRAMES, n = want < avail ? want : avail;
+
+		n = n < RING_FRAMES - at ? n : RING_FRAMES - at;
+		error = uiomove((caddr_t)&ring[at], (int)(n * 2), uio);
+		ring_read += n;
+		want -= n;
+		avail -= n;
+	}
+	return error;
+}
+
+static int
+mic_dev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	ios_wants = 1;
+	return 0;
+}
+
+/* (on the last close) */
+static int
+mic_dev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	ios_wants = 0;
+	return 0;
+}
+
+static const struct cdevsw mic_cdevsw = {
+	.d_open = mic_dev_open, .d_close = mic_dev_close, .d_read = mic_dev_read, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* ---- listening ---------------------------------------------------------------------------------------------- */
+
+static uint32_t mic_secs = 10;
+
+/*
+ * The stream run, read for mic_secs (for_ios: while iOS has the device open): how loud it is, every
+ * second (for iOS: the first three, then every 30th); into the recording with rec_sound_mic=1; for
+ * iOS into the ring.
+ */
+static void
+listen(bool for_ios)
+{
+	uint32_t run[3] = { 0, 0, 0 }, frames = 0, seconds = 0, peak = 0, periods = 0, empty = 0;
+	int64_t sum = 0;
+	uint64_t squares = 0;
+	unsigned next = 0;
+	bool unmuted = false, settled = false;
+	uint64_t began = mach_absolute_time(), now, elapsed_ms;
+
+	struct redwood_apr_answer answer;
+
+	read_ready = 0;
+	reads_done = read_errors = 0;
+	if (!redwood_adsp_apr(APR_SVC_ASM, MIC_STREAM_PORT, 0, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), APR_WAIT_MS, &answer) ||
+	    answer.opcode != APR_BASIC_RSP_RESULT || answer.words[1] != 0) {
+		say("mic: the session, run: REFUSED OR NO ANSWER (%#x %#x)\n", answer.opcode, answer.words[1]);
+		return;
+	}
+	say("mic: the session 2, run: done\n");
+	for (unsigned p = 0; p < MIC_PERIODS; p++) {
+		if (!mic_read(p)) {
+			say("mic: a read could not be sent\n");
+			return;
+		}
+	}
+	if (for_ios) {
+		say("mic: LISTENING for iOS: %u reads of 20 ms given to the DSP\n", MIC_PERIODS);
+	} else {
+		say("mic: LISTENING: %u reads of 20 ms given to the DSP; for %u s\n", MIC_PERIODS, mic_secs);
+	}
+	for (;;) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &now);
+		elapsed_ms = now / NSEC_PER_MSEC;
+		if (!unmuted && elapsed_ms >= 200) {            /* TX_MACRO_AMIC_UNMUTE_DELAY_MS */
+			unmuted = dec1_unmute();
+		}
+		if (!settled && elapsed_ms >= 300) {            /* TX_MACRO_AMIC_HPF_DELAY_MS */
+			settled = dec1_settled();
+		}
+		if (tap && elapsed_ms >= 2000 && elapsed_ms < 3000) {
+			redwood_haptic_pretend(20000);
+		} else if (tap == 1 && elapsed_ms >= 3000) {
+			redwood_haptic_pretend(0);
+			tap = 2;
+		}
+		if ((for_ios ? (!ios_wants || stopping) : elapsed_ms >= mic_secs * 1000ull) || broken) {
+			break;
+		}
+		if (!(read_ready & (1u << next))) {
+			if (elapsed_ms > 1500 && reads_done == 0) {
+				say("mic: NO READ HAS COME BACK in 1.5 s\n");
+				break;
+			}
+			sleep_ms(2);
+			continue;
+		}
+		OSBitAndAtomic(~(1u << next), &read_ready);
+		{
+			int16_t *samples = (int16_t *)(mic_memory + 4096 * next);
+			uint32_t got = read_sizes[next] / 2;
+			int16_t stereo[2 * 240];
+
+			for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + MIC_PERIOD_BYTES; line += 64) {
+				__asm__ volatile ("dc ivac, %0" : : "r" (line));
+			}
+			__asm__ volatile ("dsb sy");
+			got = got > MIC_PERIOD_FRAMES ? MIC_PERIOD_FRAMES : got;
+			empty += got == 0;
+			for (uint32_t i = 0; i < got; i++) {
+				int32_t v = samples[i];
+				uint32_t a = (uint32_t)(v < 0 ? -v : v);
+
+				sum += v;
+				squares += (uint64_t)((int64_t)v * v);
+				peak = a > peak ? a : peak;
+			}
+			frames += got;
+			if (for_ios) {
+				ring_put(samples, got);
+			}
+			if (redwood_audio_recording_mic()) {
+				for (uint32_t i = 0; i < got; i += 240) {
+					uint32_t n = got - i < 240 ? got - i : 240;
+
+					for (uint32_t j = 0; j < n; j++) {
+						stereo[2 * j] = stereo[2 * j + 1] = samples[i + j];
+					}
+					redwood_audio_record_fed(stereo, n);
+				}
+			}
+		}
+		periods++;
+		(void)mic_read(next);
+		next = (next + 1) % MIC_PERIODS;
+		if (frames >= MIC_RATE) {
+			uint64_t mean_square = squares / frames;
+			uint32_t rms = 0;
+			int db10 = -999;
+
+			while ((uint64_t)(rms + 1) * (rms + 1) <= mean_square) {
+				rms++;
+			}
+			if (rms > 0) {
+				/* 20 log10(rms / 32768), in tenths, by a table of halvings: good enough to tell loud from quiet */
+				uint32_t r = rms;
+				int tenths = 0;
+
+				while (r < 16384) {
+					r *= 2;
+					tenths -= 60;   /* 6.02 dB a halving, near enough */
+				}
+				db10 = tenths - (int)((32768 - r) * 60 / 16384);
+			}
+			seconds++;
+			if (!for_ios || seconds <= 3 || seconds % 30 == 0) {
+				say("mic: second %u: %u frames (%u periods, %u empty), level %d.%d dBFS (rms %u), peak %u, mean %lld; "
+				    "reads %u, errors %u%s%s\n", seconds, frames, periods, empty, db10 / 10, db10 < 0 ? -db10 % 10 : db10 % 10,
+				    rms, peak, sum / (int64_t)frames, reads_done, read_errors, unmuted ? "" : " (muted)",
+				    settled ? "" : " (settling)");
+			}
+			frames = periods = empty = peak = 0;
+			sum = 0;
+			squares = 0;
+		}
+	}
+}
+
+static void
+undo(void)
+{
+	dsp_off();
+	dec1_off();
+	va_mic_off();
+	master_off();
+	tx_clocks_off();
+	pins_restore();
+	reset_restore();
+	clocks_off();
+}
+
+/* Everything up to the stream's run, in a recording's order; false (and `broken') if any of it fails. */
+static bool
+path_up(void)
+{
+	if (!clocks_on()) {
+		say("mic: the clocks were not all given: the blocks are not touched\n");
+		return false;
+	}
+	if (!reset_release() || !pins_on() || !tx_clocks_on() || !master_on()) {
+		return false;
+	}
+	sleep_ms(5);    /* ("5 ms for SoundWire's auto-enumeration", wcd938x_bind()) */
+	if ((codec_device = codec_wait()) == 0) {
+		return false;
+	}
+	swr_write(0xf, SWRS_SCP_INT_STATUS_MASK_1, 0x04, 0xf);  /* (swrm_runtime_resume(): broadcast) */
+	sleep_ms(10);
+	if (!quiet) {
+		codec_look();
+	}
+	if (level < 3) {
+		return true;
+	}
+	/* the stream and path, the port's format and start, the codec's widgets */
+	return bolero_look() && codec_init() && dsp_path_on() && dsp_port_on() && dec1_on() && (!adc_on || adc1_on()) &&
+	       datapath_on();
+}
+
+/*
+ * mic=4: the path up whenever iOS opens /dev/redwood-mic, down when it closes it; after three
+ * recordings that broke off, no more until the run ends.
+ */
+static void
+for_ios(void)
+{
+	int major = cdevsw_add(-1, &mic_cdevsw);
+	unsigned recordings = 0, failures = 0;
+
+	ring = kalloc_data(RING_FRAMES * sizeof(int16_t), Z_WAITOK | Z_ZERO);
+	if (ring == NULL || major < 0 ||
+	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-mic") == NULL) {
+		say("mic: /dev/redwood-mic cannot be made\n");
+		return;
+	}
+	say("mic: THE MICROPHONE IS IOS'S (/dev/redwood-mic) from here on, until the run ends: it listens only while iOS records\n");
+	while (!stopping) {
+		uint64_t began, ns;
+		bool failed;
+
+		if (!ios_wants) {
+			sleep_ms(20);
+			continue;
+		}
+		lck_mtx_lock(&mic_lock);
+		if (stopping) {
+			lck_mtx_unlock(&mic_lock);
+			break;
+		}
+		recordings++;
+		quiet = recordings > 1;
+		ring_primed = false;
+		ring_skipped = ring_dry = 0;
+		ring_read = __atomic_load_n(&ring_written, __ATOMIC_ACQUIRE);
+		began = mach_absolute_time();
+		say("mic: iOS records (%u): the path up%s\n", recordings, quiet ? " (the lines that say all went well are not said again)" :
+		    "");
+		if (path_up()) {
+			listen(true);
+		}
+		failed = broken;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		say("mic: iOS's recording %u %s after %llu.%llu s; last: %s; %llu frames skipped as too late, %llu reads found too little\n",
+		    recordings, failed ? "BROKE OFF" : "ended", ns / NSEC_PER_SEC, ns % NSEC_PER_SEC / (NSEC_PER_SEC / 10), last_write,
+		    ring_skipped, ring_dry);
+		undo();
+		lck_mtx_unlock(&mic_lock);
+		if (failed) {
+			broken = false;
+			if (++failures >= 3) {
+				say("mic: three recordings broke off: the microphone stays off until the run ends\n");
+				break;
+			}
+			/* (not again until iOS has closed the device and opened it again) */
+			while (ios_wants && !stopping) {
+				sleep_ms(20);
+			}
+		}
+	}
+}
+
+static void
+mic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	say("mic: level %u: %s\n", level, level == 1 ? "a look, after the LPASS's votes and clocks; nothing written to the codec" :
+	    level == 2 ? "the codec brought up to answer on SoundWire, nothing of it set; then all undone" :
+	    level == 3 ? "the main microphone, as Android records from it, listened to; then all undone" :
+	    "the main microphone for iOS (/dev/redwood-mic), up while iOS records");
+	if (level == 4) {
+		for_ios();
+	} else {
+		lck_mtx_lock(&mic_lock);
+		if (level == 1) {
+			if (clocks_on()) {
+				sleep_ms(10);
+				look();
+			} else {
+				say("mic: the clocks were not all given: the blocks are not touched\n");
+			}
+		} else {
+			if (path_up() && level >= 3) {
+				listen(false);
+			}
+			say("mic: %s; last: %s\n", broken ? "STOPPED" : level >= 3 ? "listened" : "done", last_write);
+		}
+		undo();
+		lck_mtx_unlock(&mic_lock);
+	}
+	running = false;
+	say("mic: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+redwood_mic_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("mic", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+#if defined(XNU_TARGET_OS_OSX)
+	/* The collection's __DATA has no room for the 400-line cache: heap, and only when the boot arg asks for it. */
+	kept = kalloc_data(KEPT_LINES * sizeof(*kept), Z_WAITOK | Z_ZERO);
+	if (kept == NULL) {
+		printf("mic: no memory for the %u-byte line cache; the mic log is off\n",
+		    (unsigned)(KEPT_LINES * sizeof(*kept)));
+	}
+#endif
+	level = level > 4 ? 4 : level;
+	PE_parse_boot_argn("mic_secs", &mic_secs, sizeof(mic_secs));
+	PE_parse_boot_argn("mic_input", &smic_input, sizeof(smic_input));
+	PE_parse_boot_argn("mic_adc", &adc_on, sizeof(adc_on));
+	PE_parse_boot_argn("mic_main", &main_timing, sizeof(main_timing));
+	PE_parse_boot_argn("mic_test", &test_bits, sizeof(test_bits));
+	PE_parse_boot_argn("mic_tap", &tap, sizeof(tap));
+	mic_secs = mic_secs < 1 ? 1 : mic_secs > 600 ? 600 : mic_secs;
+	running = true;
+	if (kernel_thread_start(mic_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+redwood_mic_dsp_down(void)
+{
+	stopping = true;
+	if (running) {
+		lck_mtx_lock(&mic_lock);
+		undo();
+		lck_mtx_unlock(&mic_lock);
+	}
+}
diff --git a/bsd/dev/redwood_net.c b/bsd/dev/redwood_net.c
new file mode 100644
index 0000000000000000000000000000000000000000..2188997ea8bef99ed4b4e037917d7ed7f380ebd0
--- /dev/null
+++ b/bsd/dev/redwood_net.c
@@ -0,0 +1,400 @@
+/*
+ * en0: a network interface that is Ethernet as far as the rest of the kernel and iOS can tell.
+ *
+ * iOS expects its interfaces from IONetworkingFamily, which this kernel does not have; the BSD
+ * half of the kernel does not need it. The interface is made with the kernel's own interface
+ * KPI, the way bsd/net/if_fake.c makes its "feth": family Ethernet, the stock Ethernet framing
+ * and demultiplexing, one function that is given a frame to send and one call to hand a frame
+ * that has arrived to the stack. What iOS's user space makes of an interface that has no
+ * IOKit object behind it is another matter: see userland/src/net_test.m.
+ *
+ * What carries the frames is a link driver's business; sys/redwood_net.h is all that the two
+ * know of each other. The first link is QEMU's virtio network device (redwood_virtio_net.c).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include <sys/redwood_net.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#if !defined(XNU_TARGET_OS_OSX)
+extern void RedwoodWLANStart(const char *interface, const uint8_t *address);  /* iokit/Kernel/RedwoodWLAN.cpp */
+#endif
+
+static LCK_GRP_DECLARE(net_lck_grp, "redwood-net");
+static LCK_MTX_DECLARE(net_tx_lock, &net_lck_grp);
+static const struct redwood_net_link *net_link;
+static bool net_link_up;
+static ifnet_t net_ifp;
+
+/* What has gone through: said once a minute while anything moves. */
+static struct {
+	uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+} net_count;
+
+/*
+ * Boot-arg net_trace=N: a line in the log for each of the first N frames, either way.
+ * Boot-arg net_names=1: a line for every name asked of a DNS server and for every TCP connection
+ * begun from here -- which is how to see what a system that has just been given a network does
+ * with it (up to NAMES_MAX lines).
+ */
+#define NAMES_MAX       3000
+static uint32_t net_trace, net_names;
+
+static void
+trace_frame(const char *way, const uint8_t *frame, size_t length, size_t whole)
+{
+	static uint32_t said, names;
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	bool ports;
+
+	if (length < ETHER_HDR_LEN + 28 || (said >= net_trace && (!net_names || names >= NAMES_MAX))) {
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	l4 = ip + 4 * (ip[0] & 0xf);
+	ports = type == ETHERTYPE_IP && (ip[9] == IPPROTO_TCP || ip[9] == IPPROTO_UDP) && l4 + 4 <= end;
+	if (net_names && names < NAMES_MAX && ports && way[0] == 'o') {
+		if (ip[9] == IPPROTO_UDP && (l4[2] << 8 | l4[3]) == 53 && l4 + 8 + 12 < end) {
+			char name[128];
+			const uint8_t *label = l4 + 8 + 12;
+			size_t n = 0;
+
+			/* the question: lengths and labels, up to a zero */
+			while (label < end && *label != 0 && *label < 64 && label + 1 + *label < end && n + *label + 2 < sizeof(name)) {
+				memcpy(name + n, label + 1, *label);
+				n += *label;
+				name[n++] = '.';
+				label += 1 + *label;
+			}
+			name[n ? n - 1 : 0] = 0;
+			names++;
+			printf("net: asks for the name %s (type %u)\n", name, label + 2 < end ? label[1] << 8 | label[2] : 0);
+		} else if (ip[9] == IPPROTO_TCP && l4 + 14 <= end && (l4[13] & 0x12) == 0x02) {
+			names++;
+			printf("net: connects to %u.%u.%u.%u port %u\n", ip[16], ip[17], ip[18], ip[19], l4[2] << 8 | l4[3]);
+		}
+	}
+	if (said >= net_trace) {
+		return;
+	}
+	said++;
+	if (type == ETHERTYPE_IP) {
+		printf("net: %s %zu bytes: IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s\n", way, whole, ip[9] == IPPROTO_TCP ? "TCP" :
+		    ip[9] == IPPROTO_UDP ? "UDP" : ip[9] == IPPROTO_ICMP ? "ICMP" : "protocol?", ip[12], ip[13], ip[14], ip[15],
+		    ports ? l4[0] << 8 | l4[1] : 0, ip[16], ip[17], ip[18], ip[19], ports ? l4[2] << 8 | l4[3] : 0,
+		    ip[9] == IPPROTO_TCP && ports && l4 + 14 <= end ? (l4[13] & 2 ? " SYN" : l4[13] & 1 ? " FIN" : l4[13] & 4 ? " RST" : "") : "");
+	} else {
+		printf("net: %s %zu bytes: %s (type %#x) to %02x:%02x:%02x:%02x:%02x:%02x\n", way, whole, type == ETHERTYPE_ARP ? "ARP" :
+		    type == ETHERTYPE_IPV6 ? "IPv6" : "?", type, frame[0], frame[1], frame[2], frame[3], frame[4], frame[5]);
+	}
+}
+
+/* ... of a frame on its way out: the start of it is enough */
+static void
+trace_packet(mbuf_t packet, size_t length)
+{
+	uint8_t start[192];
+	size_t have = length < sizeof(start) ? length : sizeof(start);
+
+	if ((net_trace || net_names) && mbuf_copydata(packet, 0, have, start) == 0) {
+		trace_frame("out", start, have, length);
+	}
+}
+
+/* ---- the interface -------------------------------------------------------------------------------- */
+
+/* The stack has a frame to send (a chain of mbufs that starts with the Ethernet header). */
+static errno_t
+net_output(ifnet_t ifp, mbuf_t packet)
+{
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length <= REDWOOD_NET_FRAME_MAX && net_link_up) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		trace_packet(packet, length);
+		lck_mtx_lock(&net_tx_lock);
+		sent = net_link->transmit(packet, length);
+		lck_mtx_unlock(&net_tx_lock);
+	}
+	if (sent) {
+		net_count.sent++;
+		net_count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		net_count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+/* A frame has arrived. */
+void
+redwood_net_input(const uint8_t *frame, size_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	trace_frame("in ", frame, length, length);
+	if (net_ifp == NULL || length < ETHER_HDR_LEN || length > REDWOOD_NET_FRAME_MAX ||
+	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		net_count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		net_count.dropped_in++;
+		return;
+	}
+	/* as every Ethernet driver hands a frame up: the header noted and stepped over */
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, net_ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(net_ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	net_count.received++;
+	net_count.received_bytes += length;
+	ifnet_input(net_ifp, packet, &stats);
+}
+
+static unsigned net_ioctls_said;
+
+static errno_t
+net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	/* (a radio says it is one here too: IO80211.framework lists the interfaces whose media is 802.11) */
+	const int media[] = { (net_link->wireless ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (net_link->wireless && net_ioctls_said < 80) {
+		char who[32] = "?";
+
+		/* (while iOS's Wi-Fi side is being got to talk to this: who asks the interface what) */
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			net_ioctls_said++;
+			printf("net: en0 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		/* running whenever it is up: the link is there or it is not, nothing is switched on */
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		/* what configd asks to learn whether the cable is in */
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (net_link_up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* the link hands us everything anyway */
+	default:
+		/* what iOS's Wi-Fi side asks of a radio's interface: bsd/dev/redwood_apple80211.c */
+		error = net_link->wireless ? redwood_apple80211_ioctl(command, data) : EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* Tell whoever listens for kernel events (configd does) that the link is up, or down. */
+static void
+net_link_event(ifnet_t ifp, uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(ifp);
+	about->if_unit = ifnet_unit(ifp);
+	strlcpy(about->if_name, ifnet_name(ifp), IFNAMSIZ);
+	ifnet_event(ifp, header);
+}
+
+void
+redwood_net_link_state(bool up)
+{
+	if (net_ifp == NULL || up == net_link_up) {
+		return;
+	}
+	net_link_up = up;
+	printf("net: the link (%s) is %s\n", net_link->name, up ? "up" : "down");
+	/* 46cn4h (design 4, as sheng): RUNNING follows the link, so a link down takes the routes with it */
+	ifnet_set_flags(net_ifp, up && (ifnet_flags(net_ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+	net_link_event(net_ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+/* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
+static void
+net_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t said = 0, total;
+	unsigned quiet = 0;
+
+	for (unsigned tick = 1;; tick++) {
+		quiet = net_link->poll != NULL && net_link->poll() ? 0 : quiet + 1;
+		if (net_ifp != NULL && tick % 64 == 0) {
+			/* 46cn4h (design 2): when configd (after its IOKit-quiet / network-stack waits) brings en0 up */
+			static uint16_t was = 0xffff;
+			uint16_t now = (uint16_t)ifnet_flags(net_ifp);
+
+			if (now != was) {
+				uint64_t ns;
+
+				absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+				printf("net: 46cn4h %s flags %#x -> %#x (UP %u RUNNING %u) at %llu s\n", ifnet_name(net_ifp), was, now,
+				    (now & IFF_UP) != 0, (now & IFF_RUNNING) != 0, ns / 1000000000ull);
+				was = now;
+			}
+		}
+		/* about once a minute, if anything has moved since */
+		total = net_count.sent + net_count.received + net_count.dropped_out + net_count.dropped_in;
+		if (tick % 8192 == 0 && total != said) {
+			said = total;
+			printf("net: so far %llu frames sent (%llu bytes), %llu received (%llu bytes); dropped: %llu out, %llu in\n",
+			    net_count.sent, net_count.sent_bytes, net_count.received, net_count.received_bytes,
+			    net_count.dropped_out, net_count.dropped_in);
+		}
+		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+	}
+}
+
+bool
+redwood_net_attach(const struct redwood_net_link *link)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		/*
+		 * The simple model: every frame straight to net_output(). And no Skywalk "nexus" made for
+		 * the interface by itself: sockets are all that is asked of it so far.
+		 */
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "redwood-en0",
+		.uniqueid_len = 11,
+		.name = "en",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = link->wireless ? IFNET_SUBFAMILY_WIFI : IFNET_SUBFAMILY_ANY,
+		.type = IFT_ETHER,
+		.output = net_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = net_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	const uint8_t *address = link->address;
+	ifnet_t ifp = NULL;
+	thread_t thread;
+	errno_t error;
+
+	if (net_link != NULL) {
+		printf("net: en0 is on %s already; %s is not attached\n", net_link->name, link->name);
+		return false;
+	}
+	net_link = link;
+	net_link_up = link->up;
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("net: the interface cannot be made: error %d\n", error);
+		net_link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("net: the interface cannot be attached: error %d\n", error);
+		ifnet_release(ifp);
+		net_link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	net_ifp = ifp;
+	if (net_link_up) {
+		net_link_event(ifp, KEV_DL_LINK_ON);
+	}
+	if (link->wireless) {
+		/* (a radio's address is the phone's own: not for the log; and iOS's Wi-Fi side finds the interface by a service) */
+		printf("net: en0 attached on %s (a radio), link %s\n", link->name, net_link_up ? "up" : "down");
+#if !defined(XNU_TARGET_OS_OSX)
+		/* The registry entries of iokit/Kernel/RedwoodWLAN.cpp are the iOS stand-in's: the macOS kernel
+		 * takes IONetworkingFamily from the prelinked collection (run q19: a second registration of
+		 * IONetworkInterface made that kext fail on the duplicate class). */
+		RedwoodWLANStart("en0", address);
+#endif
+	} else {
+		printf("net: en0 attached on %s, address %02x:%02x:%02x:%02x:%02x:%02x, link %s\n", link->name, address[0],
+		    address[1], address[2], address[3], address[4], address[5], net_link_up ? "up" : "down");
+	}
+	if (kernel_thread_start(net_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+redwood_net_init(void)
+{
+	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
+	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+	redwood_virtio_net_init();
+}
diff --git a/bsd/dev/redwood_qmi.c b/bsd/dev/redwood_qmi.c
new file mode 100644
index 0000000000000000000000000000000000000000..e88ec7be96365d13f2ccc92d00ca4656c9915bde
--- /dev/null
+++ b/bsd/dev/redwood_qmi.c
@@ -0,0 +1,957 @@
+/*
+ * QMI: the helpers of sys/redwood_qmi.h -- messages coded by tables, a handle on the IPC router,
+ * requests as transactions, indications to handlers.
+ *
+ * The interface is that of Linux's QMI helpers, because the driver that uses it (ath11k's qmi.c)
+ * was written for them and is compiled as it is. The code is not Linux's: it is written from the
+ * interface's meaning and from the public descriptions of the wire format (a 7-byte header, then
+ * type-length-value triples; see below at "the coding").
+ *
+ * Where it deliberately does not behave as Linux's does, each of them for a message that is not
+ * well formed (a message Linux decodes right is decoded the same here):
+ *   - a TLV is taken to be as long as it says: what its element does not use is skipped, and an
+ *     element that needs more than its TLV has is an error. (Linux reads on past the TLV.)
+ *   - a TLV of a type the table does not have is skipped, whatever its type. (Linux refuses the
+ *     message if the type is below 0x10.)
+ *   - a string that would fill its C buffer to the last byte is an error: the buffer is elem_len
+ *     bytes and ends with a zero. (Linux writes the zero one byte past it.)
+ *
+ * The same file is compiled into the kernel and, for its tests, on the machine that builds it
+ * (tools/qmi-test): the few things it needs from an operating system are in the first section.
+ */
+#include <sys/redwood_qmi.h>
+#include <sys/redwood_qrtr.h>
+
+/* ---- what is needed of the operating system ---------------------------------------------------- */
+
+#ifdef KERNEL
+
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <string.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/time.h>
+
+static LCK_GRP_DECLARE(qmi_lck_grp, "redwood-qmi");
+
+struct os_lock {
+	lck_mtx_t mutex;
+};
+
+static void *
+os_alloc(size_t size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+static void
+os_free(void *memory, size_t size)
+{
+	kfree_data(memory, size);
+}
+
+static void
+os_lock_init(struct os_lock *l)
+{
+	lck_mtx_init(&l->mutex, &qmi_lck_grp, LCK_ATTR_NULL);
+}
+
+static void
+os_lock_destroy(struct os_lock *l)
+{
+	lck_mtx_destroy(&l->mutex, &qmi_lck_grp);
+}
+
+static void
+os_lock(struct os_lock *l)
+{
+	lck_mtx_lock(&l->mutex);
+}
+
+static void
+os_unlock(struct os_lock *l)
+{
+	lck_mtx_unlock(&l->mutex);
+}
+
+static uint64_t
+os_now_ms(void)
+{
+	uint64_t now, ns;
+
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* With the lock held: sleep until os_wake(what) or for that long. */
+static void
+os_wait(struct os_lock *l, void *what, uint64_t ms)
+{
+	struct timespec ts = { .tv_sec = (time_t)(ms / 1000), .tv_nsec = (long)(ms % 1000) * NSEC_PER_MSEC };
+
+	msleep(what, &l->mutex, PZERO, "redwood-qmi", &ts);
+}
+
+static void
+os_wake(__unused struct os_lock *l, void *what)
+{
+	wakeup(what);
+}
+
+#define os_log(...)     printf(__VA_ARGS__)
+
+#else /* a program on the machine that builds this: the tests */
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+struct os_lock {
+	pthread_mutex_t mutex;
+	pthread_cond_t woken;
+};
+
+static void *
+os_alloc(size_t size)
+{
+	return calloc(1, size ? size : 1);
+}
+
+static void
+os_free(void *memory, size_t size)
+{
+	(void)size;
+	free(memory);
+}
+
+static void
+os_lock_init(struct os_lock *l)
+{
+	pthread_mutex_init(&l->mutex, NULL);
+	pthread_cond_init(&l->woken, NULL);
+}
+
+static void
+os_lock_destroy(struct os_lock *l)
+{
+	pthread_mutex_destroy(&l->mutex);
+	pthread_cond_destroy(&l->woken);
+}
+
+static void
+os_lock(struct os_lock *l)
+{
+	pthread_mutex_lock(&l->mutex);
+}
+
+static void
+os_unlock(struct os_lock *l)
+{
+	pthread_mutex_unlock(&l->mutex);
+}
+
+static uint64_t
+os_now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+static void
+os_wait(struct os_lock *l, void *what, uint64_t ms)
+{
+	struct timespec until;
+
+	(void)what;                     /* one condition for all: whoever is woken looks again */
+	clock_gettime(CLOCK_REALTIME, &until);
+	until.tv_sec += (time_t)(ms / 1000);
+	until.tv_nsec += (long)(ms % 1000) * 1000000;
+	if (until.tv_nsec >= 1000000000) {
+		until.tv_sec++;
+		until.tv_nsec -= 1000000000;
+	}
+	pthread_cond_timedwait(&l->woken, &l->mutex, &until);
+}
+
+static void
+os_wake(struct os_lock *l, void *what)
+{
+	(void)what;
+	pthread_cond_broadcast(&l->woken);
+}
+
+#define os_log(...)     fprintf(stderr, __VA_ARGS__)
+
+#endif
+
+/* ---- the coding -------------------------------------------------------------------------------- */
+
+/*
+ * A message: the header, then TLVs -- type (1 byte), length (2), value -- in any order. Numbers
+ * are little-endian. A table describes the C structure a message is coded from or into, top
+ * level element by element; elements of one TLV follow each other and share its type:
+ *
+ *   [QMI_OPT_FLAG]   a byte in C that says whether the TLV is in the message at all
+ *   [QMI_DATA_LEN]   the count of the array that follows. In C it is always a 32-bit number,
+ *                    whatever the element's elem_size says (the tables are made by a tool that
+ *                    writes "uint32_t x_len" for every count, and Linux reads and writes four
+ *                    bytes there); elem_size is its size in the message: 1 byte if it is 1, else 2
+ *   the value        numbers of 1, 2, 4 or 8 bytes; a string (at the top level just its
+ *                    characters: the TLV's length is the string's); a structure, which is its
+ *                    own elements one after the other with nothing in between; or an array of
+ *                    any of these
+ *
+ * Inside a structure there are no TLVs and nothing is optional: a count if the element is a
+ * variable array, a length before a string (1 byte if the string's C buffer is at most 255
+ * bytes, else 2), then the values.
+ */
+#define TLV_HEADER      3
+
+struct writer {
+	uint8_t *at, *end;
+};
+
+struct reader {
+	const uint8_t *at, *end;
+};
+
+static bool
+put(struct writer *w, const void *bytes, size_t count)
+{
+	if ((size_t)(w->end - w->at) < count) {
+		return false;
+	}
+	memcpy(w->at, bytes, count);
+	w->at += count;
+	return true;
+}
+
+static bool
+put_number(struct writer *w, uint64_t value, unsigned size)
+{
+	uint8_t bytes[8];
+
+	for (unsigned i = 0; i < size; i++) {
+		bytes[i] = (uint8_t)(value >> (8 * i));
+	}
+	return put(w, bytes, size);
+}
+
+static bool
+get_number(struct reader *r, uint64_t *value, unsigned size)
+{
+	if ((size_t)(r->end - r->at) < size) {
+		return false;
+	}
+	*value = 0;
+	for (unsigned i = 0; i < size; i++) {
+		*value |= (uint64_t)r->at[i] << (8 * i);
+	}
+	r->at += size;
+	return true;
+}
+
+/* A number of the C structure, of 1, 2, 4 or 8 bytes, as the machine keeps it. */
+static uint64_t
+load(const void *from, unsigned size)
+{
+	uint8_t v8;
+	uint16_t v16;
+	uint32_t v32;
+	uint64_t v64;
+
+	switch (size) {
+	case 1: memcpy(&v8, from, 1); return v8;
+	case 2: memcpy(&v16, from, 2); return v16;
+	case 4: memcpy(&v32, from, 4); return v32;
+	default: memcpy(&v64, from, 8); return v64;
+	}
+}
+
+static void
+store(void *to, uint64_t value, unsigned size)
+{
+	uint8_t v8 = (uint8_t)value;
+	uint16_t v16 = (uint16_t)value;
+	uint32_t v32 = (uint32_t)value;
+
+	switch (size) {
+	case 1: memcpy(to, &v8, 1); break;
+	case 2: memcpy(to, &v16, 2); break;
+	case 4: memcpy(to, &v32, 4); break;
+	default: memcpy(to, &value, 8); break;
+	}
+}
+
+static bool
+is_number(const struct qmi_elem_info *e)
+{
+	return e->data_type >= QMI_UNSIGNED_1_BYTE && e->data_type <= QMI_SIGNED_4_BYTE_ENUM &&
+	       (e->elem_size == 1 || e->elem_size == 2 || e->elem_size == 4 || e->elem_size == 8);
+}
+
+static unsigned
+count_size(const struct qmi_elem_info *count)
+{
+	return count->elem_size == 1 ? 1 : 2;
+}
+
+static int encode_structure(struct writer *w, const struct qmi_elem_info *ei, const uint8_t *structure);
+
+/* `count` entries of one element. */
+static int
+encode_value(struct writer *w, const struct qmi_elem_info *e, const uint8_t *from, uint32_t count, bool top)
+{
+	if (is_number(e)) {
+		for (uint32_t i = 0; i < count; i++) {
+			if (!put_number(w, load(from + (size_t)i * e->elem_size, e->elem_size), e->elem_size)) {
+				return -EMSGSIZE;
+			}
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRUCT && e->ei_array != NULL) {
+		for (uint32_t i = 0; i < count; i++) {
+			int error = encode_structure(w, e->ei_array, from + (size_t)i * e->elem_size);
+
+			if (error) {
+				return error;
+			}
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRING && count == 1) {
+		size_t length = strnlen((const char *)from, e->elem_len);
+
+		if (length >= e->elem_len) {
+			return -EINVAL;                 /* no zero in the buffer */
+		}
+		if (!top && !put_number(w, length, e->elem_len <= 255 ? 1 : 2)) {
+			return -EMSGSIZE;
+		}
+		return put(w, from, length) ? 0 : -EMSGSIZE;
+	}
+	return -EINVAL;
+}
+
+/*
+ * The count and the entries of the element at *e (a QMI_DATA_LEN first, if the element is a variable
+ * array); leaves *e at the last element used.
+ */
+static int
+encode_counted(struct writer *w, const struct qmi_elem_info **e, const uint8_t *structure, bool top)
+{
+	uint32_t count = 1;
+
+	if ((*e)->data_type == QMI_DATA_LEN) {
+		const struct qmi_elem_info *length = (*e)++;
+
+		count = (uint32_t)load(structure + length->offset, sizeof(uint32_t));
+		if ((*e)->array_type != VAR_LEN_ARRAY || count > (*e)->elem_len || (count_size(length) == 1 && count > 255)) {
+			return -EINVAL;
+		}
+		if (!put_number(w, count, count_size(length))) {
+			return -EMSGSIZE;
+		}
+	} else if ((*e)->array_type == STATIC_ARRAY) {
+		count = (*e)->elem_len;
+	} else if ((*e)->array_type != NO_ARRAY) {
+		return -EINVAL;                         /* a variable array nothing counts */
+	}
+	return encode_value(w, *e, structure + (*e)->offset, count, top);
+}
+
+static int
+encode_structure(struct writer *w, const struct qmi_elem_info *ei, const uint8_t *structure)
+{
+	for (const struct qmi_elem_info *e = ei; e->data_type != QMI_EOTI; e++) {
+		int error = e->data_type == QMI_OPT_FLAG ? -EINVAL : encode_counted(w, &e, structure, false);
+
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+int
+redwood_qmi_encode(uint8_t type, uint16_t message, uint16_t transaction, const struct qmi_elem_info *ei, const void *structure,
+    void *buffer, size_t size)
+{
+	struct writer w = { .at = buffer, .end = (uint8_t *)buffer + size };
+	uint8_t *start = buffer, *tlv;
+	const struct qmi_elem_info *e;
+
+	if (size < QMI_HEADER_SIZE) {
+		return -EMSGSIZE;
+	}
+	w.at += QMI_HEADER_SIZE;
+	for (e = structure != NULL ? ei : NULL; e != NULL && e->data_type != QMI_EOTI; e++) {
+		uint8_t tlv_type = e->tlv_type;
+		int error;
+
+		if (e->data_type == QMI_OPT_FLAG) {
+			if (!load((const uint8_t *)structure + e->offset, 1)) {
+				/* not there: on to the next element of another TLV */
+				while (e[1].data_type != QMI_EOTI && e[1].tlv_type == tlv_type) {
+					e++;
+				}
+				continue;
+			}
+			e++;
+			if (e->data_type == QMI_EOTI || e->tlv_type != tlv_type) {
+				return -EINVAL;
+			}
+		}
+		tlv = w.at;
+		if ((size_t)(w.end - w.at) < TLV_HEADER) {
+			return -EMSGSIZE;
+		}
+		w.at += TLV_HEADER;
+		error = encode_counted(&w, &e, structure, true);
+		if (error) {
+			return error;
+		}
+		if (w.at - tlv - TLV_HEADER > 0xffff) {
+			return -EMSGSIZE;
+		}
+		tlv[0] = tlv_type;
+		tlv[1] = (uint8_t)(w.at - tlv - TLV_HEADER);
+		tlv[2] = (uint8_t)((w.at - tlv - TLV_HEADER) >> 8);
+	}
+	if (w.at - start - QMI_HEADER_SIZE > 0xffff) {
+		return -EMSGSIZE;
+	}
+	start[0] = type;
+	start[1] = (uint8_t)transaction;
+	start[2] = (uint8_t)(transaction >> 8);
+	start[3] = (uint8_t)message;
+	start[4] = (uint8_t)(message >> 8);
+	start[5] = (uint8_t)(w.at - start - QMI_HEADER_SIZE);
+	start[6] = (uint8_t)((w.at - start - QMI_HEADER_SIZE) >> 8);
+	return (int)(w.at - start);
+}
+
+static int decode_structure(struct reader *r, const struct qmi_elem_info *ei, uint8_t *structure);
+
+static int
+decode_value(struct reader *r, const struct qmi_elem_info *e, uint8_t *to, uint32_t count, bool top)
+{
+	uint64_t value;
+
+	if (is_number(e)) {
+		for (uint32_t i = 0; i < count; i++) {
+			if (!get_number(r, &value, e->elem_size)) {
+				return -EINVAL;
+			}
+			store(to + (size_t)i * e->elem_size, value, e->elem_size);
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRUCT && e->ei_array != NULL) {
+		for (uint32_t i = 0; i < count; i++) {
+			int error = decode_structure(r, e->ei_array, to + (size_t)i * e->elem_size);
+
+			if (error) {
+				return error;
+			}
+		}
+		return 0;
+	}
+	if (e->data_type == QMI_STRING && count == 1) {
+		value = (uint64_t)(r->end - r->at);             /* at the top level: all of the TLV */
+		if (!top && !get_number(r, &value, e->elem_len <= 255 ? 1 : 2)) {
+			return -EINVAL;
+		}
+		if (value >= e->elem_len || value > (uint64_t)(r->end - r->at)) {
+			return -EINVAL;
+		}
+		memcpy(to, r->at, (size_t)value);
+		to[value] = 0;
+		r->at += value;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int
+decode_counted(struct reader *r, const struct qmi_elem_info **e, uint8_t *structure, bool top)
+{
+	uint32_t count = 1;
+
+	if ((*e)->data_type == QMI_DATA_LEN) {
+		const struct qmi_elem_info *length = (*e)++;
+		uint64_t value;
+
+		if (!get_number(r, &value, count_size(length))) {
+			return -EINVAL;
+		}
+		if ((*e)->array_type != VAR_LEN_ARRAY || value > (*e)->elem_len) {
+			return -EINVAL;
+		}
+		store(structure + length->offset, value, sizeof(uint32_t));
+		count = (uint32_t)value;
+	} else if ((*e)->array_type == STATIC_ARRAY) {
+		count = (*e)->elem_len;
+	} else if ((*e)->array_type != NO_ARRAY) {
+		return -EINVAL;
+	}
+	return decode_value(r, *e, structure + (*e)->offset, count, top);
+}
+
+static int
+decode_structure(struct reader *r, const struct qmi_elem_info *ei, uint8_t *structure)
+{
+	for (const struct qmi_elem_info *e = ei; e->data_type != QMI_EOTI; e++) {
+		int error = e->data_type == QMI_OPT_FLAG ? -EINVAL : decode_counted(r, &e, structure, false);
+
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+int
+redwood_qmi_decode(const void *buffer, size_t length, const struct qmi_elem_info *ei, void *structure)
+{
+	const uint8_t *start = buffer;
+	struct reader r;
+	size_t said;
+
+	if (buffer == NULL || length < QMI_HEADER_SIZE || ei == NULL || structure == NULL) {
+		return -EINVAL;
+	}
+	said = start[5] | (size_t)start[6] << 8;
+	if (said > length - QMI_HEADER_SIZE) {
+		return -EINVAL;
+	}
+	r.at = start + QMI_HEADER_SIZE;
+	r.end = r.at + said;
+	while (r.at < r.end) {
+		const struct qmi_elem_info *e;
+		struct reader value;
+		uint8_t tlv_type;
+		int error;
+
+		if (r.end - r.at < TLV_HEADER) {
+			return -EINVAL;
+		}
+		tlv_type = r.at[0];
+		value.at = r.at + TLV_HEADER;
+		value.end = value.at + (r.at[1] | (size_t)r.at[2] << 8);
+		if (value.end > r.end) {
+			return -EINVAL;
+		}
+		r.at = value.end;
+		for (e = ei; e->data_type != QMI_EOTI && e->tlv_type != tlv_type; e++) {
+		}
+		if (e->data_type == QMI_EOTI) {
+			continue;                       /* nothing we know: a newer firmware's, say */
+		}
+		if (e->data_type == QMI_OPT_FLAG) {
+			store((uint8_t *)structure + e->offset, 1, 1);
+			e++;
+			if (e->data_type == QMI_EOTI || e->tlv_type != tlv_type) {
+				return -EINVAL;
+			}
+		}
+		error = decode_counted(&value, &e, structure, true);
+		if (error) {
+			return error;
+		}
+	}
+	return (int)(QMI_HEADER_SIZE + said);
+}
+
+const struct qmi_elem_info qmi_response_type_v01_ei[] = {
+	{
+		.data_type = QMI_SIGNED_2_BYTE_ENUM, .elem_len = 1, .elem_size = sizeof(uint16_t), .array_type = NO_ARRAY,
+		.tlv_type = QMI_COMMON_TLV_TYPE, .offset = offsetof(struct qmi_response_type_v01, result),
+	},
+	{
+		.data_type = QMI_SIGNED_2_BYTE_ENUM, .elem_len = 1, .elem_size = sizeof(uint16_t), .array_type = NO_ARRAY,
+		.tlv_type = QMI_COMMON_TLV_TYPE, .offset = offsetof(struct qmi_response_type_v01, error),
+	},
+	{ .data_type = QMI_EOTI },
+};
+
+/* ---- handles ----------------------------------------------------------------------------------- */
+
+/* What stands behind a handle (its `sock` points here). */
+struct qmi_state {
+	struct qmi_handle *handle;
+	const struct redwood_qrtr_ops *transport;
+	struct redwood_qrtr_port *port;
+	struct os_lock lock;                    /* the lists below and the transactions in them */
+	struct qmi_ops ops;
+	const struct qmi_msg_handler *handlers;
+	size_t largest;
+	struct qmi_txn *transactions;
+	uint16_t last_id;
+	struct qmi_service *services;
+	bool connected;
+	uint32_t peer_node, peer_port;
+	/* said in the log once each, so that a firmware that talks a lot cannot fill it */
+	bool said_malformed, said_undecoded, said_unknown;
+};
+
+static const struct redwood_qrtr_ops *qmi_transport;
+
+void
+redwood_qmi_set_transport(const struct redwood_qrtr_ops *ops)
+{
+	qmi_transport = ops;
+}
+
+static struct qmi_state *
+state_of(struct qmi_handle *qmi)
+{
+	return qmi != NULL ? (struct qmi_state *)(void *)qmi->sock : NULL;
+}
+
+/* With the lock held. */
+static struct qmi_txn **
+find_transaction(struct qmi_state *s, const struct qmi_txn *txn, uint16_t id)
+{
+	struct qmi_txn **p;
+
+	for (p = &s->transactions; *p != NULL; p = &(*p)->next) {
+		if (txn != NULL ? *p == txn : (*p)->id == id) {
+			return p;
+		}
+	}
+	return NULL;
+}
+
+/* A message that is not the reply somebody waits for: to its handler, if it has one. */
+static void
+to_handler(struct qmi_state *s, uint8_t type, uint16_t id, uint16_t message, uint32_t node, uint32_t port, const void *data,
+    size_t length)
+{
+	const struct qmi_msg_handler *h;
+	struct sockaddr_qrtr from = { .sq_family = AF_QIPCRTR, .sq_node = node, .sq_port = port };
+	struct qmi_txn txn = { .qmi = s->handle, .id = id };
+	void *decoded;
+	int result;
+
+	for (h = s->handlers; h != NULL && h->fn != NULL; h++) {
+		if (h->type == type && h->msg_id == message) {
+			break;
+		}
+	}
+	if (h == NULL || h->fn == NULL) {
+		if (!s->said_unknown) {
+			s->said_unknown = true;
+			os_log("qmi: a message nobody handles: type %u, id %#x, %zu bytes (said once)\n", type, message, length);
+		}
+		return;
+	}
+	decoded = os_alloc(h->decoded_size);
+	if (decoded == NULL) {
+		return;
+	}
+	result = redwood_qmi_decode(data, length, h->ei, decoded);
+	if (result < 0) {
+		if (!s->said_undecoded) {
+			s->said_undecoded = true;
+			os_log("qmi: message %#x (type %u, %zu bytes) cannot be decoded: %d (said once)\n", message, type, length, result);
+		}
+	} else {
+		h->fn(s->handle, &from, &txn, decoded);
+	}
+	os_free(decoded, h->decoded_size);
+}
+
+/* The router has a datagram for us. */
+static void
+qmi_receive(void *context, uint32_t node, uint32_t port, const void *data, size_t length)
+{
+	struct qmi_state *s = context;
+	const uint8_t *header = data;
+	struct qmi_txn **found, *txn;
+	uint16_t id, message;
+	uint8_t type;
+
+	if (length < QMI_HEADER_SIZE || length > s->largest + QMI_HEADER_SIZE ||
+	    (size_t)(header[5] | header[6] << 8) > length - QMI_HEADER_SIZE) {
+		if (!s->said_malformed) {
+			s->said_malformed = true;
+			os_log("qmi: a datagram of %zu bytes from %u:%u is no message we take (said once)\n", length, node, port);
+		}
+		return;
+	}
+	type = header[0];
+	id = (uint16_t)(header[1] | header[2] << 8);
+	message = (uint16_t)(header[3] | header[4] << 8);
+	if (type == QMI_RESPONSE) {
+		os_lock(&s->lock);
+		found = find_transaction(s, NULL, id);
+		txn = found != NULL ? *found : NULL;
+		if (txn != NULL && !txn->done && txn->ei != NULL && txn->dest != NULL) {
+			txn->result = redwood_qmi_decode(data, length, txn->ei, txn->dest);
+			txn->done = true;
+			os_wake(&s->lock, txn);
+			os_unlock(&s->lock);
+			return;
+		}
+		os_unlock(&s->lock);
+		if (txn == NULL) {
+			return;                         /* a reply to nothing: late, after its transaction was given up */
+		}
+	}
+	to_handler(s, type, id, message, node, port, data, length);
+}
+
+/* The router says a server we asked about is there, or is gone. */
+static void
+qmi_server(void *context, bool arrived, uint32_t service, uint32_t version, uint32_t instance, uint32_t node, uint32_t port)
+{
+	struct qmi_state *s = context;
+	struct qmi_service *svc, **p;
+
+	os_lock(&s->lock);
+	for (p = &s->services; *p != NULL; p = &(*p)->next) {
+		if ((*p)->node == node && (*p)->port == port) {
+			break;
+		}
+	}
+	svc = *p;
+	if (!arrived && svc != NULL) {
+		*p = svc->next;
+	}
+	os_unlock(&s->lock);
+
+	if (arrived && svc == NULL) {
+		svc = os_alloc(sizeof(*svc));
+		if (svc == NULL) {
+			return;
+		}
+		svc->service = service;
+		svc->version = version;
+		svc->instance = instance;
+		svc->node = node;
+		svc->port = port;
+		if (s->ops.new_server != NULL && s->ops.new_server(s->handle, svc) < 0) {
+			os_free(svc, sizeof(*svc));
+			return;
+		}
+		os_lock(&s->lock);
+		svc->next = s->services;
+		s->services = svc;
+		os_unlock(&s->lock);
+	} else if (!arrived && svc != NULL) {
+		if (s->ops.del_server != NULL) {
+			s->ops.del_server(s->handle, svc);
+		}
+		os_free(svc, sizeof(*svc));
+	}
+}
+
+int
+qmi_handle_init(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops, const struct qmi_msg_handler *handlers)
+{
+	const struct redwood_qrtr_ops *transport = qmi_transport;
+	struct qmi_state *s;
+
+	qmi->sock = NULL;
+	if (transport == NULL) {
+		return -ENXIO;
+	}
+	s = os_alloc(sizeof(*s));
+	if (s == NULL) {
+		return -ENOMEM;
+	}
+	s->handle = qmi;
+	s->transport = transport;
+	s->largest = largest;
+	s->handlers = handlers;
+	if (ops != NULL) {
+		s->ops = *ops;
+	}
+	os_lock_init(&s->lock);
+	qmi->sock = (struct socket *)(void *)s;         /* before the port: callbacks may come at once */
+	s->port = transport->open(qmi_receive, qmi_server, s);
+	if (s->port == NULL) {
+		qmi->sock = NULL;
+		os_lock_destroy(&s->lock);
+		os_free(s, sizeof(*s));
+		return -ENXIO;
+	}
+	return 0;
+}
+
+/* Nobody may be waiting in qmi_txn_wait() on this handle any more. */
+void
+qmi_handle_release(struct qmi_handle *qmi)
+{
+	struct qmi_state *s = state_of(qmi);
+	struct qmi_service *svc;
+
+	if (s == NULL) {
+		return;
+	}
+	s->transport->close(s->port);                   /* no callback after this */
+	while ((svc = s->services) != NULL) {
+		s->services = svc->next;
+		os_free(svc, sizeof(*svc));
+	}
+	qmi->sock = NULL;
+	os_lock_destroy(&s->lock);
+	os_free(s, sizeof(*s));
+}
+
+int
+qmi_add_lookup(struct qmi_handle *qmi, unsigned int service, unsigned int version, unsigned int instance)
+{
+	struct qmi_state *s = state_of(qmi);
+	int error;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	error = s->transport->lookup(s->port, service, version, instance);
+	return error > 0 ? -error : error;
+}
+
+int
+redwood_qmi_connect(struct socket *sock, uint32_t node, uint32_t port)
+{
+	struct qmi_state *s = (struct qmi_state *)(void *)sock;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	s->peer_node = node;
+	s->peer_port = port;
+	s->connected = true;
+	os_unlock(&s->lock);
+	return 0;
+}
+
+int
+qmi_txn_init(struct qmi_handle *qmi, struct qmi_txn *txn, const struct qmi_elem_info *ei, void *structure)
+{
+	struct qmi_state *s = state_of(qmi);
+	uint16_t id;
+
+	memset(txn, 0, sizeof(*txn));
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	txn->qmi = qmi;
+	txn->ei = ei;
+	txn->dest = structure;
+	os_lock(&s->lock);
+	/* the next number nobody else has (0 to 65534, round and round) */
+	for (id = (uint16_t)(s->last_id + 1);; id++) {
+		if (id == 0xffff) {
+			id = 0;
+		}
+		if (find_transaction(s, NULL, id) == NULL) {
+			break;
+		}
+		if (id == s->last_id) {
+			os_unlock(&s->lock);
+			return -ENOMEM;                 /* 65535 of them at once */
+		}
+	}
+	s->last_id = id;
+	txn->id = id;
+	txn->next = s->transactions;
+	s->transactions = txn;
+	os_unlock(&s->lock);
+	return id;
+}
+
+int
+qmi_send_request(struct qmi_handle *qmi, struct sockaddr_qrtr *sq, struct qmi_txn *txn, int msg_id, size_t largest,
+    const struct qmi_elem_info *ei, const void *structure)
+{
+	struct qmi_state *s = state_of(qmi);
+	uint32_t node, port;
+	bool connected;
+	size_t size = largest + QMI_HEADER_SIZE;
+	void *buffer;
+	int length, error;
+
+	if (s == NULL || txn == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	connected = s->connected;
+	node = s->peer_node;
+	port = s->peer_port;
+	os_unlock(&s->lock);
+	if (sq != NULL) {
+		node = sq->sq_node;
+		port = sq->sq_port;
+	} else if (!connected) {
+		return -ENOTCONN;
+	}
+	buffer = os_alloc(size);
+	if (buffer == NULL) {
+		return -ENOMEM;
+	}
+	length = redwood_qmi_encode(QMI_REQUEST, (uint16_t)msg_id, txn->id, ei, structure, buffer, size);
+	if (length < 0) {
+		os_free(buffer, size);
+		return length;
+	}
+	error = s->transport->send(s->port, node, port, buffer, (size_t)length);
+	os_free(buffer, size);
+	return error > 0 ? -error : error;
+}
+
+void
+qmi_txn_cancel(struct qmi_txn *txn)
+{
+	struct qmi_state *s = state_of(txn->qmi);
+	struct qmi_txn **found;
+
+	if (s == NULL) {
+		return;
+	}
+	os_lock(&s->lock);
+	found = find_transaction(s, txn, 0);
+	if (found != NULL) {
+		*found = txn->next;
+	}
+	os_unlock(&s->lock);
+}
+
+int
+redwood_qmi_txn_wait_ms(struct qmi_txn *txn, uint64_t milliseconds)
+{
+	struct qmi_state *s = state_of(txn->qmi);
+	uint64_t now = os_now_ms(), until = now + milliseconds;
+	struct qmi_txn **found;
+	int result;
+
+	if (s == NULL) {
+		return -EINVAL;
+	}
+	os_lock(&s->lock);
+	while (!txn->done && now < until) {
+		os_wait(&s->lock, txn, until - now);
+		now = os_now_ms();
+	}
+	found = find_transaction(s, txn, 0);
+	if (found != NULL) {
+		*found = txn->next;
+	}
+	result = txn->done ? txn->result : -ETIMEDOUT;
+	os_unlock(&s->lock);
+	return result;
+}
diff --git a/bsd/dev/redwood_sound.c b/bsd/dev/redwood_sound.c
new file mode 100644
index 0000000000000000000000000000000000000000..98d5901d4d9d5d723bab779b5f34747f56dac3e4
--- /dev/null
+++ b/bsd/dev/redwood_sound.c
@@ -0,0 +1,1546 @@
+/*
+ * The phone's sound, step 3: what the audio DSP's services are told so that the speakers play.
+ * Every address and number below belongs to the POCO X5 Pro (redwood), and nothing here happens
+ * unless boot-arg sound=N asks for it, with adsp=1 (redwood_adsp.c), which starts the DSP and
+ * calls redwood_sound_dsp_up() once its audio services are up.
+ *
+ * Under Android the speakers' sound goes from the audio server through three of the DSP's
+ * services: ASM, a stream the samples are written into; ADM, the matrix that routes a stream to
+ * a device path ("COPP"); and AFE, the port at the SoC's interface. The two amplifiers
+ * (redwood_speaker.c) sit on the primary TDM interface, which the DSP runs: Android's
+ * PRI_TDM_RX_0, AFE port 0x9000 in group 0x9100 (with 0x9002, unused). The samples themselves
+ * lie in memory of ours that the DSP reads through the application processors' SMMU, as
+ * stream 0x1801 (Android: qcom,msm-audio-ion, iommus <&apps_smmu 0x1801 0>, its addresses from
+ * 0x10000000, and the stream's low four bits in bits 32 to 35 of every address the DSP is given:
+ * qcom,smmu-sid-mask 0xf, msm_audio_ion.c).
+ *
+ *   sound=1  the port: the TDM pins to the interface, the interface's bit clock, the group, the
+ *            port, started; whether the bit clock and the frame sync then toggle at the pins is
+ *            looked at; held for sound_secs (default 3), then everything stopped and put back
+ *   sound=2  ... and a stream: our memory shown to the DSP through the SMMU, a device path
+ *            (ADM) to the port, an ASM stream routed to it, and a test tone -- 1 kHz at -20 dBFS,
+ *            both channels -- written into it for sound_secs (at most 3); the DSP's "written"
+ *            events say whether it takes the samples at 48 kHz. The amplifiers stay off.
+ *   sound=3  ... and the amplifiers, with the tone playing: set up as Android's driver sets them
+ *            up, started once the clock runs, faded in to sound_below eighths of a dB under
+ *            Android's own level (default 160: 20 dB under, the least it may be is 0), faded
+ *            out and powered down at the end. Audible.
+ *   sound=4  what iOS plays (/dev/redwood-audio, redwood_audio.c), until the run ends: the port
+ *            and the stream as above, kept running (silence when iOS writes nothing); the
+ *            amplifiers set up once and powered down, started and faded in (the driver's quick
+ *            fade) whenever a write is not silence, stopped after three seconds of silence; their
+ *            level is what is set on the plug-in's volume control (ioctl REDWOOD_AUDIO_SET_VOLUME):
+ *            so far under sound_below, which stays the loudest, and at 0 they stay off. (iOS sets
+ *            that control only once, to the top, and applies its volume to the samples itself --
+ *            see userland/src/audio_plugin.c --; at its volume 0 it writes silence, and the
+ *            amplifiers stay off for that too.) On their way the samples go through the speakers'
+ *            guard (redwood_guard.c), in place of the DSP's speaker protection that Android has:
+ *            sound_gain eighths of a dB of gain (default and most 96, 12 dB: iOS's own processing
+ *            keeps its top that far under full scale), a high-pass filter, three averages of the
+ *            power at the speakers and a peak limiter. sound_guard_as=N, for a test: the guard
+ *            reckons the amplifiers N eighths of a dB under Android's level (louder than they are)
+ *            and holds back as it would there -- with sound_below=720 (the amplifiers at -90 dB)
+ *            what it does at the loudest can be seen in the log and the recording without a sound.
+ *
+ * The numbers are Android's own, from the phone's live device tree (qcom,msm-dai-tdm-pri-rx and
+ * its port, the pins pri_tdm_*_active), its mixer paths (the speaker: PRI_TDM_RX_0 at 48 kHz,
+ * two channels, S32_LE) and its kernel (Xiaomi's redwood-s-oss, techpack/audio: asoc/lahaina.c,
+ * asoc/msm-dai-q6-v2.c, dsp/q6afe.c, dsp/q6adm.c, dsp/q6asm.c):
+ *   - the bit clock: the interface's internal one (clock 0x200, "PRI_TDM_IBIT"), attribute 4
+ *     ("invert, couple no", msm-dai-q6-v2.c's default; the tree names none), at 48000 x 32 bits x
+ *     2 slots = 3.072 MHz -- the machine driver sets that rate itself (lahaina.c, which on redwood
+ *     halves its four slots to two: "Using default tdm max slot: 4" in Android's log), not the
+ *     tree's 1.536 MHz
+ *   - the group: ports 0x9000 and 0x9002, two 32-bit slots, mask 3, 48 kHz
+ *   - the port: two channels of 32 bits at 48 kHz, linear PCM; sync mode 0, sync source 1, data
+ *     out 0, inverted sync 1, data delay 1; slot mapping: channels at byte offsets 0 and 4 (slot
+ *     0, the amplifier at 0x35; slot 1, the one at 0x34), MSB-aligned
+ *   - the pins: GPIO 97 (bit clock) and 100 (frame sync) function mi2s0, 8 mA, no pull, output
+ *     high; 98 and 99 (data in and out) function mi2s0, 8 mA, no pull (pinctrl-yupik.c: function
+ *     1 for all four)
+ *   - the path: ADM's device open (version 5) for playback to port 0x9000 with no processing
+ *     (topology 0x10312), two channels, 24 bits, 48 kHz; the stream: ASM session 1, stream 1,
+ *     opened for writing linear PCM of 16 bits, no processing (0x10c68), routed to that path
+ *
+ * What is started is stopped, and what is written is put back, when the time is over -- or, if
+ * the DSP is to be shut down earlier (the run's end), before that (redwood_sound_dsp_down()).
+ * The amplifiers are powered down on a panic's way out (redwood_sound_quiesce()).
+ *
+ * Message layouts: the files above, and Linux's sound/soc/qcom/qdsp6/ (q6afe.c, q6adm.c,
+ * q6asm.c); the SMMU: redwood_wifi.c, which does the same for the Wi-Fi's stream.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/redwood_audio.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>  /* xnu-12377: KMA_*/kmem_alloc moved to the internal header */
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+/* The SMMU's match registers and contexts are found free and taken by the Wi-Fi's start as well (redwood_wifi.c). */
+extern lck_mtx_t redwood_smmu_lock;
+
+static LCK_GRP_DECLARE(sound_lock_group, "redwood-sound");
+static LCK_MTX_DECLARE(sound_lock, &sound_lock_group);  /* the path being set up or taken down */
+
+static uint32_t level, seconds = 3, below = 240, pause_ms = 1000, gain = REDWOOD_GUARD_MAX_GAIN;
+static uint32_t guard_as = UINT32_MAX;  /* boot-arg sound_guard_as=N: the guard reckons the amplifiers at most N under (a test) */
+static char last_write[96] = "nothing written";
+
+/* ---- what is said: to the loader's log as well, as it happens ---------------------------------------- */
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds / 1000;
+}
+
+/* The time of day (UTC, as the host gave it: boot-arg epoch) and since the kernel began, for whoever listens. */
+static void
+say_when(const char *what)
+{
+	clock_sec_t secs;
+	clock_usec_t usecs;
+	uint64_t up = now_us();
+
+	clock_get_calendar_microtime(&secs, &usecs);
+	say("sound: %s at %02lu:%02lu:%02lu.%01u UTC (%llu.%01llu s after the kernel began)\n", what, (unsigned long)(secs / 3600 % 24),
+	    (unsigned long)(secs / 60 % 60), (unsigned long)(secs % 60), (unsigned)(usecs / 100000), up / 1000000, up / 100000 % 10);
+}
+
+/* Time for the loader to note what has just been said, before something not yet seen to be harmless. */
+static void
+announce(const char *what)
+{
+	say("sound: %s\n", what);
+	if (pause_ms) {
+		sleep_ms(pause_ms);
+	}
+}
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+struct block {
+	const char *name;
+	uint32_t phys, size;
+	vm_offset_t base;
+};
+
+static uint32_t
+get(struct block *b, const char *name, uint32_t offset)
+{
+	uint32_t value;
+
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	value = rd(b->base + offset);
+	say("sound: %s %s (%#x) = %#x\n", b->name, name, b->phys + offset, value);
+	return value;
+}
+
+static void
+put(struct block *b, const char *name, uint32_t offset, uint32_t value)
+{
+	if (b->base == 0) {
+		b->base = ml_io_map(b->phys, b->size);
+	}
+	say("sound: about to write %s %s at %#x: %#x\n", b->name, name, b->phys + offset, value);
+	snprintf(last_write, sizeof(last_write), "wrote %#x to %s %s at %#x", value, b->name, name, b->phys + offset);
+	wr(b->base + offset, value);
+}
+
+/* ---- the TDM pins ------------------------------------------------------------------------------------- */
+
+static struct block tlmm = { "pin controller", 0x0f100000, 0x100000 };
+#define GPIO_CFG(n)             (0x1000u * (n))         /* [1:0] pull, [5:2] function, [8:6] drive (mA / 2 - 1), [9] output */
+#define GPIO_IO(n)              (0x1000u * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_MI2S0               (1u << 2)
+#define CFG_8MA                 (3u << 6)
+#define CFG_OUTPUT              (1u << 9)
+
+static const struct {
+	unsigned pin;
+	const char *name;
+	uint32_t cfg, io;               /* Android's active state */
+} tdm_pins[] = {
+	{ 97, "gpio97 (bit clock)", CFG_MI2S0 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 100, "gpio100 (frame sync)", CFG_MI2S0 | CFG_8MA | CFG_OUTPUT, 2 },
+	{ 98, "gpio98 (data in)", CFG_MI2S0 | CFG_8MA, 0 },
+	{ 99, "gpio99 (data out)", CFG_MI2S0 | CFG_8MA, 0 },
+};
+#define TDM_PINS                (sizeof(tdm_pins) / sizeof(tdm_pins[0]))
+static uint32_t found_cfg[TDM_PINS], found_io[TDM_PINS];
+static bool pins_taken;
+
+static void
+pins_on(void)
+{
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		found_cfg[i] = get(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin));
+		found_io[i] = get(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin));
+	}
+	pins_taken = true;
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		put(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin), tdm_pins[i].io);
+		put(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin), tdm_pins[i].cfg);
+	}
+}
+
+static void
+pins_off(void)
+{
+	if (!pins_taken) {
+		return;
+	}
+	for (unsigned i = 0; i < TDM_PINS; i++) {
+		put(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin), found_cfg[i]);
+		put(&tlmm, tdm_pins[i].name, GPIO_IO(tdm_pins[i].pin), found_io[i] & 2);
+		get(&tlmm, tdm_pins[i].name, GPIO_CFG(tdm_pins[i].pin));
+	}
+	pins_taken = false;
+}
+
+/* Whether a pin toggles: read many times as fast as it goes. */
+static void
+pin_activity(unsigned pin, const char *name, uint32_t *changes, uint32_t *ones)
+{
+	uint32_t last = rd(tlmm.base + GPIO_IO(pin)) & 1, reads = 20000;
+	uint64_t began = now_us();
+
+	*changes = *ones = 0;
+	for (uint32_t i = 0; i < reads; i++) {
+		uint32_t now = rd(tlmm.base + GPIO_IO(pin)) & 1;
+
+		*changes += now != last;
+		*ones += now;
+		last = now;
+	}
+	say("sound: %s: %u changes and %u ones in %u reads (%llu us)\n", name, *changes, *ones, reads, now_us() - began);
+}
+
+/* ---- APR ------------------------------------------------------------------------------------------- */
+
+#define APR_SVC_AFE             4
+#define APR_SVC_ASM             7
+#define APR_SVC_ADM             8
+#define APR_BASIC_RSP_RESULT    0x000110e8u
+#define APR_WAIT_MS             1000
+
+static const char *
+dsp_error(uint32_t status)
+{
+	static const char *const names[] = { "ok", "failed", "bad parameter", "unsupported", "version", "unexpected", "panic",
+		                             "no resource", "bad handle", "already", "not ready", "pending", "busy", "aborted",
+		                             "preempted", "continue", "immediate", "not implemented", "need more", "no memory",
+		                             "not there" };
+
+	return status < sizeof(names) / sizeof(names[0]) ? names[status] : "an error this does not know";
+}
+
+/*
+ * One command, its answer waited for: true if the answer is the basic one with status 0, or the
+ * opcode `wanted' (then in *answer).
+ */
+static bool
+command(const char *what, uint8_t service, uint16_t port, uint32_t opcode, const void *payload, uint32_t length, uint32_t wanted,
+    struct redwood_apr_answer *answer)
+{
+	struct redwood_apr_answer local;
+
+	if (answer == NULL) {
+		answer = &local;
+	}
+	snprintf(last_write, sizeof(last_write), "sent %s (opcode %#x)", what, opcode);
+	if (!redwood_adsp_apr(service, port, 0, opcode, payload, length, APR_WAIT_MS, answer)) {
+		say("sound: %s (opcode %#x to service %u, port %#x): NO ANSWER\n", what, opcode, service, port);
+		return false;
+	}
+	if (answer->opcode == APR_BASIC_RSP_RESULT && answer->words[0] == opcode) {
+		say("sound: %s: %s%s\n", what, answer->words[1] == 0 ? "done" : "REFUSED: ", answer->words[1] == 0 ? "" :
+		    dsp_error(answer->words[1]));
+		return answer->words[1] == 0 && wanted == 0;
+	}
+	if (wanted != 0 && answer->opcode == wanted) {
+		return true;
+	}
+	say("sound: %s: an answer not expected: opcode %#x, %u bytes: %#x %#x\n", what, answer->opcode, answer->length,
+	    answer->words[0], answer->words[1]);
+	return false;
+}
+
+/* ---- AFE: the port ---------------------------------------------------------------------------------- */
+
+#define AFE_PORT_CMD_DEVICE_START               0x000100e5u
+#define AFE_PORT_CMD_DEVICE_STOP                0x000100e6u
+#define AFE_PORT_CMD_SET_PARAM_V2               0x000100efu
+#define AFE_SVC_CMD_SET_PARAM                   0x000100f3u
+#define AFE_MODULE_AUDIO_DEV_INTERFACE          0x0001020cu
+#define AFE_PARAM_ID_TDM_CONFIG                 0x0001029du
+#define AFE_MODULE_TDM                          0x0001028au
+#define AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG   0x00010297u
+#define AFE_MODULE_GROUP_DEVICE                 0x00010254u
+#define AFE_PARAM_ID_GROUP_DEVICE_ENABLE        0x00010256u
+#define AFE_PARAM_ID_GROUP_DEVICE_TDM_CONFIG    0x0001029eu
+#define AFE_MODULE_CLOCK_SET                    0x0001028fu
+#define AFE_PARAM_ID_CLOCK_SET                  0x00010290u
+
+#define PORT                    0x9000          /* PRI_TDM_RX_0 */
+#define GROUP                   0x9100          /* PRI_TDM_RX */
+#define GROUP_OTHER_PORT        0x9002
+#define PORT_INVALID            0xffff
+#define CLOCK_PRI_TDM_IBIT      0x200
+#define CLOCK_INVERT_COUPLE_NO  4
+#define RATE                    48000
+#define SLOTS                   2
+#define SLOT_BITS               32
+#define PORT_BITS               32              /* the mixer path's S32_LE */
+
+struct afe_param {
+	uint32_t module, param;
+	uint16_t size, reserved;
+} __attribute__((packed));
+
+struct afe_clock_set {
+	uint32_t version, id, hz;
+	uint16_t attribute, root;
+	uint32_t enable;
+} __attribute__((packed));
+
+struct afe_group_tdm {
+	uint32_t version;
+	uint16_t group, reserved;
+	uint16_t ports[8];
+	uint32_t channels, rate, bits;
+	uint16_t slots, slot_bits;
+	uint32_t slot_mask;
+} __attribute__((packed));
+
+struct afe_group_enable {
+	uint16_t group, enable;
+} __attribute__((packed));
+
+struct afe_tdm {
+	uint32_t version, channels, rate, bits;
+	uint16_t data_format, sync_mode, sync_source, slots, data_out, invert_sync, data_delay, slot_bits;
+	uint32_t slot_mask;
+} __attribute__((packed));
+
+struct afe_slot_mapping {
+	uint32_t version;
+	uint16_t channels, bits;
+	uint32_t align;
+	uint16_t offsets[8];
+} __attribute__((packed));
+
+/* A parameter for the AFE as a whole (its clocks, its groups): in the packet, not in shared memory. */
+static bool
+afe_service_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	uint32_t *head = (uint32_t *)packet;
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	head[0] = (uint32_t)sizeof(*p) + size;          /* payload size; address 0 and handle 0: in band */
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, 0, AFE_SVC_CMD_SET_PARAM, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+/* A parameter of the port. */
+static bool
+afe_port_param(const char *what, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	uint8_t packet[16 + sizeof(struct afe_param) + 64];
+	struct afe_param *p = (struct afe_param *)(packet + 16);
+
+	bzero(packet, sizeof(packet));
+	*(uint16_t *)packet = PORT;
+	*(uint16_t *)(packet + 2) = (uint16_t)(sizeof(*p) + size);
+	p->module = module;
+	p->param = param;
+	p->size = size;
+	memcpy(packet + 16 + sizeof(*p), data, size);
+	return command(what, APR_SVC_AFE, 0, AFE_PORT_CMD_SET_PARAM_V2, packet, 16 + (uint32_t)sizeof(*p) + size, 0, NULL);
+}
+
+static bool clock_on, group_on, port_on;
+
+static bool
+afe_clock(bool on)
+{
+	struct afe_clock_set clock = { 1, CLOCK_PRI_TDM_IBIT, RATE * SLOT_BITS * SLOTS, CLOCK_INVERT_COUPLE_NO, 0, on };
+
+	return afe_service_param(on ? "the TDM bit clock (0x200) at 3.072 MHz, on" : "the TDM bit clock, off", AFE_MODULE_CLOCK_SET,
+	           AFE_PARAM_ID_CLOCK_SET, &clock, sizeof(clock));
+}
+
+static bool
+afe_on(void)
+{
+	struct afe_group_tdm group = {
+		.version = 1, .group = GROUP, .ports = { PORT, GROUP_OTHER_PORT, PORT_INVALID, PORT_INVALID, PORT_INVALID,
+		                                         PORT_INVALID, PORT_INVALID, PORT_INVALID },
+		.channels = SLOTS, .rate = RATE, .bits = SLOT_BITS, .slots = SLOTS, .slot_bits = SLOT_BITS, .slot_mask = 3,
+	};
+	struct afe_group_enable enable = { GROUP, 1 };
+	struct afe_tdm tdm = {
+		.version = 1, .channels = 2, .rate = RATE, .bits = PORT_BITS, .data_format = 0, .sync_mode = 0, .sync_source = 1,
+		.slots = SLOTS, .data_out = 0, .invert_sync = 1, .data_delay = 1, .slot_bits = SLOT_BITS, .slot_mask = 3,
+	};
+	struct afe_slot_mapping mapping = { .version = 1, .channels = 2, .bits = PORT_BITS, .align = 0,
+		                            .offsets = { 0, 4, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff } };
+	uint16_t start[2] = { PORT, 0 };
+
+	announce("the DSP is asked for the TDM interface's bit clock, the group, the port and its start (AFE)");
+	clock_on = afe_clock(true);
+	if (!clock_on) {
+		return false;
+	}
+	group_on = afe_service_param("the group 0x9100: ports 0x9000 0x9002, 2 slots of 32 bits, 48 kHz", AFE_MODULE_GROUP_DEVICE,
+	    AFE_PARAM_ID_GROUP_DEVICE_TDM_CONFIG, &group, sizeof(group)) &&
+	    afe_service_param("the group 0x9100, on", AFE_MODULE_GROUP_DEVICE, AFE_PARAM_ID_GROUP_DEVICE_ENABLE, &enable,
+	    sizeof(enable));
+	if (!group_on) {
+		return false;
+	}
+	if (!afe_port_param("the port 0x9000: 2 channels of 32 bits at 48 kHz in 2 slots, sync 0 1, inverted, delay 1",
+	    AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_TDM_CONFIG, &tdm, sizeof(tdm)) ||
+	    !afe_port_param("the port's slots: channels at bytes 0 and 4", AFE_MODULE_TDM, AFE_PARAM_ID_PORT_SLOT_MAPPING_CONFIG,
+	    &mapping, sizeof(mapping))) {
+		return false;
+	}
+	port_on = command("the port 0x9000, started", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL);
+	return port_on;
+}
+
+static void
+afe_off(void)
+{
+	uint16_t stop[2] = { PORT, 0 };
+	struct afe_group_enable disable = { GROUP, 0 };
+
+	if (port_on) {
+		command("the port 0x9000, stopped", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_STOP, stop, sizeof(stop), 0, NULL);
+		port_on = false;
+	}
+	if (group_on) {
+		afe_service_param("the group 0x9100, off", AFE_MODULE_GROUP_DEVICE, AFE_PARAM_ID_GROUP_DEVICE_ENABLE, &disable,
+		    sizeof(disable));
+		group_on = false;
+	}
+	if (clock_on) {
+		afe_clock(false);
+		clock_on = false;
+	}
+}
+
+/* ---- the DSP's view of our memory: stream 0x1801 of the SMMU ------------------------------------------- */
+
+static struct block apps_smmu = { "apps smmu", 0x15000000, 0x2000 };
+static struct block apps_smmu_second = { "apps smmu", 0, 0x1000 };              /* the second page: a word per context */
+static struct block apps_smmu_context = { "apps smmu, the audio context", 0, 0x1000 };
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_SMR(n)             (0x800 + 4 * (n))       /* bit 31 valid, [30:16] mask, [14:0] stream */
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))       /* [17:16] 0 translate 1 bypass 2 fault, [7:0] context */
+#define SMMU_CBAR(n)            (4 * (n))
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))
+#define SMMU_CBA2R_64_BIT       1
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)
+#define SMMU_MAIR0              0xf404ff44
+#define SMMU_FSR_ALL            0xc00001fe
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define AUDIO_PTE               (3ull | 1ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)       /* as redwood_wifi.c's */
+
+#define AUDIO_STREAM            0x1801
+#define AUDIO_ADDRESSES         0x10000000ull   /* dt: qcom,iommu-dma-addr-pool of qcom,msm-audio-ion */
+#define AUDIO_STREAM_BITS       (1ull << 32)    /* the stream's low bits (0x1801 & 0xf), where the DSP takes them from */
+
+#define PERIODS                 8
+#define PERIOD_FRAMES           960             /* 20 ms */
+#define PERIOD_BYTES            (PERIOD_FRAMES * 4)
+#define BUFFER_BYTES            (PERIODS * 4096)        /* a page each */
+#define MIC_BYTES               (16 * 4096)             /* the microphones' (redwood_mic.c), behind the periods */
+#define SHARED_BYTES            (BUFFER_BYTES + MIC_BYTES)
+
+static struct {
+	bool found, on, passed;         /* passed: the boot chain lets the stream through untranslated */
+	uint32_t page, pages, match, context, old_smr, old_s2cr, old_sctlr;
+	vm_offset_t tables;             /* three of 4K: the root, one of the second level, one of the third */
+} space;
+static vm_offset_t buffer;              /* BUFFER_BYTES of ours, the periods (and MIC_BYTES behind them: the microphones') */
+static uint64_t buffer_address;         /* as the DSP is to know it */
+
+static bool
+space_find(void)
+{
+	bool used[256] = { false };
+	uint32_t scr0 = get(&apps_smmu, "scr0", SMMU_SCR0), idr0 = get(&apps_smmu, "idr0", SMMU_IDR0);
+	uint32_t idr1 = get(&apps_smmu, "idr1", SMMU_IDR1), matches = idr0 & 0xff, contexts = idr1 & 0xff;
+
+	if (scr0 & 1u << 3) {
+		say("sound: this SMMU numbers its streams with 16 bits, which nothing here is written for\n");
+		return false;
+	}
+	space.page = idr1 >> 31 ? 0x10000 : 0x1000;
+	space.pages = 2u << (idr1 >> 28 & 7);
+	if (2 * space.pages * space.page != 0x100000) {
+		say("sound: the SMMU says it has 2 x %u pages of %#x bytes, not a megabyte: its contexts are not looked for\n",
+		    space.pages, space.page);
+		return false;
+	}
+	space.match = ~0u;
+	for (uint32_t n = 0; n < matches && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(apps_smmu.base + SMMU_SMR(n)), s2cr = rd(apps_smmu.base + SMMU_S2CR(n));
+		uint32_t stream = smr & 0x7fff, mask = smr >> 16 & 0x7fff;
+
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+			if (((stream ^ AUDIO_STREAM) & ~mask) == 0) {
+				say("sound: match register %u covers the audio stream already: stream %#x mask %#x, s2cr %#x\n", n,
+				    stream, mask, s2cr);
+				if ((s2cr >> 16 & 3) == 1) {
+					space.passed = true;
+					return true;
+				}
+				say("sound: ... and does not let it through untranslated: it is somebody's, and is left alone\n");
+				return false;
+			}
+		} else if (space.match == ~0u) {
+			space.match = n;
+			space.old_smr = smr;
+			space.old_s2cr = s2cr;
+		}
+	}
+	for (space.context = 0; space.context < contexts && used[space.context]; space.context++) {
+	}
+	if (space.match == ~0u || space.context >= contexts) {
+		say("sound: the SMMU has no match register or no context left\n");
+		return false;
+	}
+	apps_smmu_second.phys = apps_smmu.phys + space.page;
+	apps_smmu_context.phys = apps_smmu.phys + (space.pages + space.context) * space.page;
+	say("sound: the boot chain has set nothing up for stream %#x; free: match register %u (smr %#x, s2cr %#x) and context %u, at "
+	    "%#x\n", AUDIO_STREAM, space.match, space.old_smr, space.old_s2cr, space.context, apps_smmu_context.phys);
+	space.old_sctlr = get(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR);
+	if (space.old_sctlr & 1) {
+		say("sound: CONTEXT %u IS SWITCHED ON although no stream is sent through it: it is somebody's, and is left alone\n",
+		    space.context);
+		return false;
+	}
+	space.found = true;
+	return true;
+}
+
+static void
+space_faults(void)
+{
+	uint32_t status, global;
+
+	if (!space.on) {
+		return;
+	}
+	status = rd(apps_smmu_context.base + SMMU_CB_FSR);
+	global = rd(apps_smmu.base + SMMU_SGFSR);
+	if ((status & SMMU_FSR_ALL) == 0 && global == 0) {
+		say("sound: the SMMU has refused the DSP nothing (context %u: fsr %#x; sgfsr 0)\n", space.context, status);
+		return;
+	}
+	say("sound: THE SMMU HAS REFUSED A REQUEST: context %u: status %#x, address %#llx, syndrome %#x; the SMMU as a whole: status "
+	    "%#x, stream %#x\n", space.context, status, (uint64_t)rd(apps_smmu_context.base + SMMU_CB_FAR + 4) << 32 |
+	    rd(apps_smmu_context.base + SMMU_CB_FAR), rd(apps_smmu_context.base + SMMU_CB_FSYNR0), global,
+	    rd(apps_smmu.base + SMMU_SGFSYNR1));
+}
+
+/* Our buffer behind the DSP's addresses from AUDIO_ADDRESSES on, through a context of ours. */
+static bool
+space_on(void)
+{
+	uint64_t *root, *second, *third, table_root;
+	uint32_t smr = SMMU_SMR(space.match), s2cr = SMMU_S2CR(space.match), sees = 1u << 31 | AUDIO_STREAM;
+
+	if (kmem_alloc(kernel_map, &space.tables, 3 * 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	root = (uint64_t *)space.tables;
+	second = (uint64_t *)(space.tables + 4096);
+	third = (uint64_t *)(space.tables + 8192);
+	root[AUDIO_ADDRESSES >> 30 & 0x1ff] = kvtophys((vm_offset_t)second) | 3;
+	second[AUDIO_ADDRESSES >> 21 & 0x1ff] = kvtophys((vm_offset_t)third) | 3;
+	for (unsigned page = 0; page < SHARED_BYTES / 4096; page++) {
+		third[(AUDIO_ADDRESSES >> 12 & 0x1ff) + page] = kvtophys(buffer + 4096 * page) | AUDIO_PTE;
+	}
+	for (vm_offset_t line = space.tables; line < space.tables + 3 * 4096; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	table_root = kvtophys(space.tables) | (uint64_t)space.context << 48;
+	say("sound: THE SMMU IS ABOUT TO BE WRITTEN: context %u gets page tables of ours (root %#llx) for the %u KB of the periods and the microphones' "
+	    "at %#llx, and match register %u sends stream %#x through it\n", space.context, table_root & PTE_ADDRESS,
+	    SHARED_BYTES / 1024, AUDIO_ADDRESSES, space.match, AUDIO_STREAM);
+	if (pause_ms) {
+		sleep_ms(pause_ms);
+	}
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, 0);
+	put(&apps_smmu_second, "cba2r", SMMU_CBA2R(space.context), SMMU_CBA2R_64_BIT);
+	put(&apps_smmu_second, "cbar", SMMU_CBAR(space.context), SMMU_CBAR_STAGE_1);
+	put(&apps_smmu_context, "tcr2", SMMU_CB_TCR2, SMMU_TCR2);
+	put(&apps_smmu_context, "tcr", SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	put(&apps_smmu_context, "ttbr0, low", SMMU_CB_TTBR0, (uint32_t)table_root);
+	put(&apps_smmu_context, "ttbr0, high", SMMU_CB_TTBR0 + 4, (uint32_t)(table_root >> 32));
+	put(&apps_smmu_context, "ttbr1, low", SMMU_CB_TTBR1, 0);
+	put(&apps_smmu_context, "ttbr1, high", SMMU_CB_TTBR1 + 4, 0);
+	put(&apps_smmu_context, "mair0", SMMU_CB_MAIR0, SMMU_MAIR0);
+	put(&apps_smmu_context, "mair1", SMMU_CB_MAIR1, 0);
+	put(&apps_smmu_context, "fsr", SMMU_CB_FSR, SMMU_FSR_ALL);
+	put(&apps_smmu_context, "tlbiasid", SMMU_CB_TLBIASID, space.context);
+	put(&apps_smmu_context, "tlbsync", SMMU_CB_TLBSYNC, 1);
+	for (unsigned ms = 0; rd(apps_smmu_context.base + SMMU_CB_TLBSTATUS) & 1; ms++) {
+		if (ms == 100) {
+			say("sound: the SMMU does not finish forgetting old translations\n");
+			return false;
+		}
+		sleep_ms(1);
+	}
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	space.on = true;
+	put(&apps_smmu, "s2cr", s2cr, space.context);
+	put(&apps_smmu, "smr", smr, sees);
+	if (get(&apps_smmu, "smr", smr) != sees || (get(&apps_smmu, "s2cr", s2cr) & 0x300ff) != space.context ||
+	    !(get(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR) & 1) ||
+	    get(&apps_smmu_context, "ttbr0, low", SMMU_CB_TTBR0) != (uint32_t)table_root) {
+		say("sound: THE SMMU DID NOT TAKE WHAT WAS WRITTEN: stream %#x is not going through context %u\n", AUDIO_STREAM,
+		    space.context);
+		return false;
+	}
+	say("sound: THE AUDIO STREAM GOES THROUGH CONTEXT %u of the SMMU, with our page tables\n", space.context);
+	return true;
+}
+
+static void
+space_off(void)
+{
+	if (!space.on) {
+		return;
+	}
+	space_faults();
+	say("sound: the audio stream and context %u of the SMMU are put back as they were found\n", space.context);
+	put(&apps_smmu, "smr", SMMU_SMR(space.match), space.old_smr);
+	put(&apps_smmu, "s2cr", SMMU_S2CR(space.match), space.old_s2cr);
+	put(&apps_smmu_context, "sctlr", SMMU_CB_SCTLR, space.old_sctlr);
+	get(&apps_smmu, "smr", SMMU_SMR(space.match));
+	space.on = false;
+}
+
+/*
+ * The DSP's view of our memory is one: the sound's periods and the microphones' buffers behind them
+ * (redwood_mic.c), through the same stream and context. Whoever comes first sets it up, whoever
+ * leaves last takes it down. user: 0 the sound, 1 the microphones. With redwood_smmu_lock held.
+ */
+static uint32_t space_users;
+
+static bool
+shared_get(unsigned user)
+{
+	if (space_users == 0) {
+		if (buffer == 0 && kmem_alloc(kernel_map, &buffer, SHARED_BYTES, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			buffer = 0;
+			say("sound: no memory for the DSP's buffers\n");
+			return false;
+		}
+		if (!space.found && !space.passed && !space_find()) {
+			return false;
+		}
+		if (!space.passed && !space.on && !space_on()) {
+			return false;
+		}
+		buffer_address = space.passed ? (kvtophys(buffer) | AUDIO_STREAM_BITS) : (AUDIO_ADDRESSES | AUDIO_STREAM_BITS);
+		if (space.passed) {
+			for (unsigned page = 1; page < SHARED_BYTES / 4096; page++) {
+				if (kvtophys(buffer + 4096 * page) != kvtophys(buffer) + 4096 * page) {
+					say("sound: the DSP's buffers are not one piece of memory, and the stream is not translated\n");
+					return false;
+				}
+			}
+		}
+	}
+	space_users |= 1u << user;
+	return true;
+}
+
+static void
+shared_put(unsigned user)
+{
+	if (!(space_users & 1u << user)) {
+		return;
+	}
+	space_users &= ~(1u << user);
+	if (space_users == 0) {
+		space_off();
+	}
+}
+
+bool
+redwood_audio_dsp_memory(uintptr_t *memory, uint64_t *dsp_address, uint32_t *bytes)
+{
+	bool ok;
+
+	lck_mtx_lock(&redwood_smmu_lock);
+	ok = shared_get(1);
+	lck_mtx_unlock(&redwood_smmu_lock);
+	if (ok) {
+		*memory = buffer + BUFFER_BYTES;
+		*dsp_address = buffer_address + BUFFER_BYTES;
+		*bytes = MIC_BYTES;
+	}
+	return ok;
+}
+
+void
+redwood_audio_dsp_memory_put(void)
+{
+	lck_mtx_lock(&redwood_smmu_lock);
+	shared_put(1);
+	lck_mtx_unlock(&redwood_smmu_lock);
+}
+
+/* ---- ADM and ASM: the path and the stream --------------------------------------------------------------- */
+
+#define ADM_CMD_DEVICE_OPEN_V5                  0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5               0x00010329u
+#define ADM_CMD_DEVICE_CLOSE_V5                 0x00010327u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5          0x00010325u
+#define ADM_PATH_PLAYBACK                       1
+#define ADM_MATRIX_AUDIO_RX                     0
+#define ADM_TOPOLOGY_NONE                       0x00010312u
+#define ADM_BITS                                24
+
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS          0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS       0x00010d93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS        0x00010d94u
+#define ASM_STREAM_CMD_OPEN_WRITE_V3            0x00010db3u
+#define ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2        0x00010d98u
+#define ASM_SESSION_CMD_RUN_V2                  0x00010daau
+#define ASM_DATA_CMD_WRITE_V2                   0x00010dabu
+#define ASM_DATA_EVENT_WRITE_DONE_V2            0x00010d99u
+#define ASM_SESSION_EVENT_RX_UNDERFLOW          0x00010c17u
+#define ASM_STREAM_CMD_CLOSE                    0x00010bcdu
+#define ASM_TOPOLOGY_NONE                       0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2      0x00010da5u
+#define ASM_SHMEM_4K_POOL                       3
+#define SESSION                                 1
+#define STREAM_PORT                             (SESSION << 8 | 1)
+#define WRITE_TOKEN                             0x80000000u     /* | the period: what a write's "done" carries back */
+#define PCM_CHANNEL_FL                          1
+#define PCM_CHANNEL_FR                          2
+
+static volatile bool stopping;          /* the run is ending: whatever plays stops */
+static bool mapped, copp_open, stream_open;
+static uint32_t map_handle, copp;
+static volatile uint32_t returned;      /* the periods the DSP has said it is done with (a bit each) */
+static volatile uint32_t written_done, underflows, write_errors;
+
+/* The DSP's events: the "done" of every write, and underflows. On the link's thread. */
+static bool
+events(uint8_t service, __unused uint16_t port, uint32_t opcode, uint32_t token, const uint32_t *payload, uint32_t length)
+{
+	if (service != APR_SVC_ASM) {
+		return false;
+	}
+	if (opcode == ASM_DATA_EVENT_WRITE_DONE_V2 && (token & WRITE_TOKEN)) {
+		if (length >= 16 && payload[3] != 0) {
+			OSIncrementAtomic((volatile SInt32 *)&write_errors);
+		}
+		OSIncrementAtomic((volatile SInt32 *)&written_done);
+		OSBitOrAtomic(1u << (token & 31), &returned);
+		return true;
+	}
+	if (opcode == APR_BASIC_RSP_RESULT && (token & WRITE_TOKEN)) {
+		/* (a write the DSP refused outright: it answers it as a command) */
+		OSIncrementAtomic((volatile SInt32 *)&write_errors);
+		OSIncrementAtomic((volatile SInt32 *)&written_done);
+		OSBitOrAtomic(1u << (token & 31), &returned);
+		return true;
+	}
+	if (opcode == ASM_SESSION_EVENT_RX_UNDERFLOW) {
+		OSIncrementAtomic((volatile SInt32 *)&underflows);
+		return true;
+	}
+	return false;
+}
+
+static bool
+stream_on(void)
+{
+	struct {
+		uint16_t pool, regions;
+		uint32_t property;
+		uint32_t low, high, size;
+	} __attribute__((packed)) map = { ASM_SHMEM_4K_POOL, 1, 0, (uint32_t)buffer_address, (uint32_t)(buffer_address >> 32),
+		                          BUFFER_BYTES };
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) open = { 0, ADM_PATH_PLAYBACK, PORT, 0xffff, ADM_TOPOLOGY_NONE, 2, ADM_BITS, RATE,
+		                           { PCM_CHANNEL_FL, PCM_CHANNEL_FR } };
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps;
+		uint16_t copp[2];
+	} __attribute__((packed)) route = { ADM_MATRIX_AUDIO_RX, 1, SESSION, 1, { 0, 0 } };
+	struct {
+		uint32_t flags;
+		uint16_t sink, bits;
+		uint32_t topology, format;
+	} __attribute__((packed)) write = { 0, 0, 16, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	struct {
+		uint32_t size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) format = { 20, 2, 16, RATE, 1, 0, { PCM_CHANNEL_FL, PCM_CHANNEL_FR } };
+	uint32_t run[3] = { 0, 0, 0 };
+	struct redwood_apr_answer answer;
+
+	announce("the DSP is given our periods (ASM), a device path to the port (ADM) and a stream routed to it (ASM)");
+	if (!command("our periods, mapped for the DSP", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map, sizeof(map),
+	    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, &answer)) {
+		return false;
+	}
+	mapped = true;
+	map_handle = answer.words[0];
+	say("sound: our %u KB at %#llx are the DSP's handle %#x\n", BUFFER_BYTES / 1024, buffer_address, map_handle);
+	if (!command("a device path to the port: playback, no processing, 2 channels of 24 bits at 48 kHz", APR_SVC_ADM, PORT,
+	    ADM_CMD_DEVICE_OPEN_V5, &open, sizeof(open), ADM_CMDRSP_DEVICE_OPEN_V5, &answer)) {
+		return false;
+	}
+	if (answer.words[0] != 0) {
+		say("sound: the device path: REFUSED: %s\n", dsp_error(answer.words[0]));
+		return false;
+	}
+	copp_open = true;
+	copp = answer.words[1] & 0xffff;        /* (the upper half is reserved) */
+	route.copp[0] = (uint16_t)copp;
+	say("sound: the device path is open: COPP %u\n", copp);
+	if (!command("the stream, opened for writing: 16-bit linear PCM, no processing", APR_SVC_ASM, STREAM_PORT,
+	    ASM_STREAM_CMD_OPEN_WRITE_V3, &write, sizeof(write), 0, NULL)) {
+		return false;
+	}
+	stream_open = true;
+	return command("session 1 routed to the device path", APR_SVC_ADM, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route),
+	           0, NULL) &&
+	       command("the stream's format: 2 channels of 16 bits at 48 kHz, left and right", APR_SVC_ASM, STREAM_PORT,
+	           ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, &format, sizeof(format), 0, NULL) &&
+	       command("the session, run", APR_SVC_ASM, STREAM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), 0, NULL);
+}
+
+static void
+stream_off(void)
+{
+	uint32_t handle = map_handle;
+
+	if (stream_open) {
+		command("the stream, closed", APR_SVC_ASM, STREAM_PORT, ASM_STREAM_CMD_CLOSE, NULL, 0, 0, NULL);
+		stream_open = false;
+	}
+	if (copp_open) {
+		command("the device path, closed", APR_SVC_ADM, (uint16_t)copp, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, 0, NULL);
+		copp_open = false;
+	}
+	if (mapped) {
+		command("our periods, unmapped", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &handle, sizeof(handle), 0, NULL);
+		mapped = false;
+	}
+}
+
+/* ---- the test tone ----------------------------------------------------------------------------------- */
+
+/* 1 kHz at 48 kHz, -20 dBFS (a peak of 3277): one cycle */
+static const int16_t tone[48] = {
+	0, 428, 848, 1254, 1638, 1995, 2317, 2600, 2838, 3028, 3165, 3249,
+	3277, 3249, 3165, 3028, 2838, 2600, 2317, 1995, 1638, 1254, 848, 428,
+	0, -428, -848, -1254, -1638, -1995, -2317, -2600, -2838, -3028, -3165, -3249,
+	-3277, -3249, -3165, -3028, -2838, -2600, -2317, -1995, -1638, -1254, -848, -428,
+};
+static uint32_t tone_at;
+
+static void
+period_fill(unsigned period, bool silent)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+
+	for (unsigned frame = 0; frame < PERIOD_FRAMES; frame++) {
+		int16_t sample = silent ? 0 : tone[tone_at++ % 48];
+
+		samples[2 * frame] = sample;
+		samples[2 * frame + 1] = sample;
+	}
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));        /* the DSP reads memory, not our caches */
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static bool
+period_write(unsigned period)
+{
+	uint32_t write[8] = { (uint32_t)(buffer_address + 4096 * period), (uint32_t)((buffer_address + 4096 * period) >> 32),
+		              map_handle, PERIOD_BYTES, period, 0, 0, 0 };
+
+	return redwood_adsp_apr(APR_SVC_ASM, STREAM_PORT, WRITE_TOKEN | period, ASM_DATA_CMD_WRITE_V2, write, sizeof(write), 0, NULL);
+}
+
+/*
+ * The tone, written period after period as the DSP gives them back, for `ms'; then silence until
+ * the DSP has given every period back. What came back and how fast is said.
+ */
+static bool
+play(uint32_t ms, bool amplifiers)
+{
+	uint64_t began, last_look, ended;
+	uint32_t sent = 0, done_before = written_done, healthy_looks = 0;
+	bool ok = true, tone_over = false;
+
+	returned = 0;
+	tone_at = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill(p, false);
+	}
+	began = last_look = now_us();
+	for (unsigned p = 0; p < PERIODS; p++) {
+		if (!period_write(p)) {
+			say("sound: the write of period %u could not be sent\n", p);
+			return false;
+		}
+		sent++;
+	}
+	for (;;) {
+		uint32_t back = returned;
+		uint64_t now = now_us();
+
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (!(back & 1u << p) || tone_over) {
+					continue;
+				}
+				period_fill(p, false);
+				if (!period_write(p)) {
+					say("sound: the write of period %u could not be sent\n", p);
+					ok = false;
+					tone_over = true;
+					break;
+				}
+				sent++;
+			}
+		}
+		if (!tone_over && (now - began >= ms * 1000ull || stopping)) {
+			tone_over = true;
+		}
+		if (tone_over && written_done - done_before >= sent) {
+			break;
+		}
+		if (now - began > ms * 1000ull + 2000000) {
+			say("sound: THE DSP HAS NOT GIVEN EVERY PERIOD BACK 2 s after the end (%u of %u)\n", written_done - done_before,
+			    sent);
+			ok = false;
+			break;
+		}
+		if (written_done == done_before && now - began > 1000000) {
+			say("sound: THE DSP HAS GIVEN NO PERIOD BACK IN A SECOND\n");
+			ok = false;
+			break;
+		}
+		if (amplifiers && now - last_look >= 200000) {
+			last_look = now;
+			healthy_looks++;
+			if (!redwood_speaker_healthy()) {
+				ok = false;
+				tone_over = true;
+			}
+		}
+		sleep_ms(2);
+	}
+	ended = now_us();
+	{
+		uint32_t done = written_done - done_before;
+		uint64_t frames = (uint64_t)done * PERIOD_FRAMES, us = ended - began;
+
+		say("sound: %u periods written, %u given back (%u with an error), %u underflows, in %llu ms: the DSP took %llu frames a "
+		    "second%s\n", sent, done, write_errors, underflows, us / 1000, us ? frames * 1000000 / us : 0,
+		    amplifiers ? "" : " (the amplifiers off: nothing to hear)");
+		if (amplifiers) {
+			say("sound: the amplifiers' status looked at %u times while it played\n", healthy_looks);
+		}
+	}
+	return ok;
+}
+
+/* ---- sound=4: what iOS plays ------------------------------------------------------------------------------ */
+
+/*
+ * /dev/redwood-audio's writer (the audio server's real-time thread, redwood_audio.c) puts frames
+ * into a ring and does not wait; the feeder, a thread of ours, takes them from there into each
+ * period the DSP gives back (and silence when there is nothing), so the stream never stops
+ * while the run lasts. The amplifiers are only on while there is sound: the watcher starts them
+ * (and fades them in to sound_below) when a write is not silence, and stops them after three
+ * seconds of silence or no writes.
+ */
+#define RING_FRAMES             32768           /* 0.68 s; a power of two, the indices run on and wrap */
+#define SILENCE                 8               /* samples no larger than this are silence (as redwood_audio.c's) */
+#define QUIET_BEFORE_OFF_US     3000000ull
+
+#if defined(XNU_TARGET_OS_OSX)
+/* (macOS: allocated in redwood_sound_dsp_up; the collection's __DATA has no room) */
+static int16_t *ring;
+#else
+static int16_t ring[RING_FRAMES * 2];
+#endif
+static volatile uint32_t ring_head, ring_tail;  /* frames: written by the sink, taken by the feeder */
+static volatile uint64_t last_sound_us;         /* when the latest write that was not silence came */
+static volatile bool feeder_runs, watcher_runs;
+static uint64_t fed_frames, silent_frames, ios_frames;
+static volatile uint32_t ios_peak;              /* the largest sample since the amplifiers last started */
+
+/* From the writer's thread, under redwood_audio.c's lock: never waits. */
+static uint32_t
+ios_sink(const int16_t *frames, uint32_t count)
+{
+	uint32_t head = ring_head, room = RING_FRAMES - (head - ring_tail), taken = count < room ? count : room;
+	bool sound = false;
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (ring == NULL) {
+		return 0;
+	}
+#endif
+
+	for (uint32_t i = 0; i < taken; i++) {
+		int16_t left = frames[2 * i], right = frames[2 * i + 1];
+		uint32_t l = left < 0 ? (uint32_t)-(int32_t)left : (uint32_t)left, r = right < 0 ? (uint32_t)-(int32_t)right : (uint32_t)right;
+
+		ring[2 * ((head + i) % RING_FRAMES)] = left;
+		ring[2 * ((head + i) % RING_FRAMES) + 1] = right;
+		sound |= l > SILENCE || r > SILENCE;
+		if (l > ios_peak || r > ios_peak) {
+			ios_peak = l > r ? l : r;
+		}
+	}
+	OSMemoryBarrier();
+	ring_head = head + taken;
+	ios_frames += taken;
+	if (sound) {
+		last_sound_us = now_us();
+	}
+	return taken;
+}
+
+static uint32_t guard_periods;                  /* periods through the guard */
+static volatile bool guard_on;                  /* the amplifiers are on: what the guard lets through is heard */
+
+/* tenths of a dB as text: "-5.7" */
+static const char *
+db_text(char *text, int tenths)
+{
+	snprintf(text, 16, "%s%d.%d", tenths < 0 ? "-" : "", (tenths < 0 ? -tenths : tenths) / 10, (tenths < 0 ? -tenths : tenths) % 10);
+	return text;
+}
+
+/* What the guard has done since it was last said (redwood_guard.c), as one line; nothing if `quiet'. */
+static void
+guard_say(const char *when, bool quiet)
+{
+	struct redwood_guard_report r;
+	char t[6][16];
+
+	redwood_guard_take_report(&r);
+	if (r.blocks == 0 || quiet) {
+		return;
+	}
+	/* (levels at the speakers: dB under a full-scale square wave at Android's level; gains in dB) */
+	say("sound: the guard%s: peaks in %u, out %u (of 32768); gain now %s dB, least %s dB, held down by the 0.2 s/3 s/60 s "
+	    "averages in %u/%u/%u of %u periods; peaks limited in %u frames (by %s dB at most); averages %s/%s/%s dB\n",
+	    when, r.peak_in, r.peak_out, db_text(t[0], redwood_guard_decibels(r.gain * r.gain >> 30)),
+	    db_text(t[1], redwood_guard_decibels(r.least_gain * r.least_gain >> 30)), r.rms_blocks, r.fast_blocks, r.slow_blocks,
+	    r.blocks, r.limited_frames, db_text(t[2], redwood_guard_decibels((uint64_t)r.least_peak_gain * r.least_peak_gain >> 2)),
+	    db_text(t[3], redwood_guard_decibels(r.rms)), db_text(t[4], redwood_guard_decibels(r.fast)),
+	    db_text(t[5], redwood_guard_decibels(r.slow)));
+}
+
+/* A period from the ring, the rest of it silence. */
+static void
+period_fill_ios(unsigned period)
+{
+	int16_t *samples = (int16_t *)(buffer + 4096 * period);
+	uint32_t tail = ring_tail, available = ring_head - tail, n = available < PERIOD_FRAMES ? available : PERIOD_FRAMES;
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (ring == NULL) {
+		n = 0;
+		available = 0;
+	}
+#endif
+	OSMemoryBarrier();
+	for (uint32_t i = 0; i < n; i++) {
+		samples[2 * i] = ring[2 * ((tail + i) % RING_FRAMES)];
+		samples[2 * i + 1] = ring[2 * ((tail + i) % RING_FRAMES) + 1];
+	}
+	bzero(samples + 2 * n, (PERIOD_FRAMES - n) * 4);
+	OSMemoryBarrier();
+	ring_tail = tail + n;
+	fed_frames += n;
+	silent_frames += PERIOD_FRAMES - n;
+	/* the guard, on every period, silence too: its filter and its averages go on (redwood_guard.c) */
+	redwood_guard_process(samples, PERIOD_FRAMES);
+	if (n != 0 && redwood_audio_recording_fed()) {
+		redwood_audio_record_fed(samples, n);
+	}
+	guard_periods++;
+	for (vm_offset_t line = (vm_offset_t)samples; line < (vm_offset_t)samples + PERIOD_BYTES; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+static void
+feeder_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t sent = 0, failed = 0;
+
+	returned = 0;
+	for (unsigned p = 0; p < PERIODS; p++) {
+		period_fill_ios(p);
+		sent += period_write(p);
+	}
+	while (!stopping) {
+		uint32_t back = returned;
+		static bool was_on;
+
+		if (guard_on && !was_on) {
+			guard_say("", true);    /* (what it did to the silence meanwhile is of no interest) */
+			guard_periods = 0;
+		} else if (was_on && !guard_on) {
+			guard_say(" until the amplifiers stopped", false);
+		} else if (guard_on && guard_periods >= 250) {
+			guard_say(", 5 s", false);
+			guard_periods = 0;
+		}
+		was_on = guard_on;
+		if (back != 0) {
+			OSBitAndAtomic(~back, &returned);
+			for (unsigned p = 0; p < PERIODS; p++) {
+				if (back & 1u << p) {
+					period_fill_ios(p);
+					if (period_write(p)) {
+						sent++;
+					} else {
+						failed++;
+					}
+				}
+			}
+		}
+		sleep_ms(2);
+	}
+	say("sound: the feeder stops: %u periods written (%u could not be sent), %u given back (%u with an error), %u underflows; "
+	    "from iOS %llu frames came, %llu went to the DSP, %llu of silence filled in\n", sent, failed, written_done, write_errors,
+	    underflows, ios_frames, fed_frames, silent_frames);
+	feeder_runs = false;
+	thread_terminate(current_thread());
+}
+
+/* The amplifiers' level as the guard is to reckon with it (sound_guard_as: louder than it is, for a test). */
+static void
+guard_level(uint32_t level_below)
+{
+	redwood_guard_attenuation(level_below < guard_as ? level_below : guard_as);
+}
+
+/*
+ * The amplifiers are off. The guard goes on at their level all the same: what it lets through now reaches them
+ * 160 ms later, behind the periods queued at the DSP, and if that is sound, they will have been started by then
+ * (70 ms after it comes). While they are off nothing but silence comes, and the averages fall as a speaker cools.
+ * Only when nothing can be heard at all -- iOS's volume at 0, the amplifiers given up on -- is the guard told so.
+ */
+static void
+guard_off(bool unheard)
+{
+	guard_on = false;
+	if (unheard) {
+		redwood_guard_attenuation(REDWOOD_GUARD_SILENT);
+	}
+}
+
+/*
+ * The amplifiers on while there is sound, at the volume iOS has set (redwood_audio_volume(): how
+ * far under the loudest, sound_below under Android's level), and off while iOS's volume is 0;
+ * their status looked at every 200 ms while they are on. On the sound's thread.
+ */
+static void
+watch(void)
+{
+	bool on = false, given_up = false, muted = false;
+	uint64_t last_look = 0, last_monitor = 0;
+	uint32_t starts = 0, changes = 0, generation = 0, extra = 0, monitor = 0, monitor_looks = 0;
+
+	guard_level(below);                     /* (from the first sample on: see guard_off()) */
+
+	while (!stopping) {
+		uint64_t now = now_us(), sounded = last_sound_us;
+		uint32_t extra_now, generation_now;
+		bool muted_now;
+
+		if (redwood_audio_volume(&extra_now, &muted_now, &generation_now) && generation_now != generation) {
+			generation = generation_now;
+			extra = extra_now;
+			muted = muted_now;
+			changes++;
+			say("sound: iOS sets the volume: %s%u.%03u dB under the loudest, which is %u.%03u dB under Android's level%s\n",
+			    muted ? "muted (0), " : "", extra / 8, extra % 8 * 125, below / 8, below % 8 * 125,
+			    on ? (muted ? ": the amplifiers are stopped" : ": the amplifiers follow") : "");
+			if (muted) {
+				guard_off(true);
+				if (on) {
+					redwood_speaker_stop();
+					on = false;
+				}
+			} else if (on && !redwood_speaker_volume(below + extra, 1)) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (!given_up) {
+				guard_level(below + extra);
+			}
+		}
+		if (!on && !given_up && !muted && sounded != 0 && now - sounded < 100000) {
+			say_when("iOS plays: the amplifiers are started");
+			starts++;
+			ios_peak = 0;
+			if (!redwood_speaker_start() || !redwood_speaker_volume(below + extra, 1)) {
+				say("sound: THE AMPLIFIERS DID NOT START; iOS's sound goes on to the DSP, unheard\n");
+				guard_off(true);
+				given_up = true;
+			} else {
+				on = true;
+				guard_on = true;
+				last_look = now_us();
+				last_monitor = 0;
+				monitor_looks = 0;
+				/* (what is written now is heard after the periods already queued at the DSP: PERIODS x 20 ms) */
+				say("sound: the amplifiers are up %llu ms after the first write that was not silence; that write reaches "
+				    "them %u ms after it was made, behind the periods queued at the DSP\n", (last_look - sounded) / 1000,
+				    PERIODS * PERIOD_FRAMES / 48);
+			}
+		} else if (on && now - sounded > QUIET_BEFORE_OFF_US) {
+			say_when("three seconds of silence: the amplifiers are stopped");
+			say("sound: what iOS wrote while they were on peaked at %u%% of full scale (%u)\n", ios_peak * 100 / 32768,
+			    ios_peak);
+			guard_off(false);
+			redwood_speaker_stop();
+			on = false;
+		} else if (on && now - last_look >= 200000) {
+			last_look = now;
+			if (!redwood_speaker_healthy()) {
+				guard_off(true);
+				on = false;
+				given_up = true;
+			} else if (now - last_monitor >= 1000000) {
+				/* the amplifiers' temperature and the battery as they see it, every second: a reduction if Android's table asks for one */
+				uint32_t wanted;
+
+				last_monitor = now;
+				wanted = redwood_speaker_monitor(monitor_looks++ % 10 == 0);
+				if (wanted != monitor) {
+					say("sound: the amplifiers' watch asks for %u.%03u dB less (it was %u.%03u)\n", wanted / 8, wanted % 8 * 125,
+					    monitor / 8, monitor % 8 * 125);
+					monitor = wanted;
+					redwood_guard_monitor(monitor);
+				}
+			}
+		}
+		sleep_ms(5);
+	}
+	guard_off(true);
+	say("sound: the watcher stops; the amplifiers were started %u times, iOS set the volume %u times%s\n", starts, changes,
+	    given_up ? ", and the amplifiers were then given up on" : "");
+	watcher_runs = false;
+}
+
+/* ---- the whole ---------------------------------------------------------------------------------------- */
+
+static bool running, taken_down;
+
+static void
+take_down(void)
+{
+	stopping = true;
+	if (level >= 4) {
+		redwood_audio_set_sink("nothing", NULL);
+	}
+	for (unsigned ms = 0; ms < 3000 && (feeder_runs || watcher_runs); ms++) {
+		sleep_ms(1);
+	}
+	lck_mtx_lock(&sound_lock);
+	if (running && !taken_down) {
+		taken_down = true;
+		redwood_speaker_stop();
+		stream_off();
+		afe_off();
+		pins_off();
+		lck_mtx_lock(&redwood_smmu_lock);
+		shared_put(0);
+		lck_mtx_unlock(&redwood_smmu_lock);
+		redwood_adsp_apr_events(NULL);
+		say("sound: everything of the sound's is stopped and put back\n");
+	}
+	lck_mtx_unlock(&sound_lock);
+}
+
+static void
+sound_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	const uint8_t *acf = NULL;
+	uint64_t acf_size = 0;
+	uint32_t changes, ones, sync_changes, sync_ones;
+	bool ok = false;
+
+	lck_mtx_lock(&sound_lock);
+	if (taken_down) {
+		lck_mtx_unlock(&sound_lock);
+		thread_terminate(current_thread());
+	}
+	if (level == 4) {
+		say("sound: level 4: what iOS plays, through the port, a stream and the amplifiers, until the run ends\n");
+	} else {
+		say("sound: level %u: %s, for %u s\n", level, level == 1 ? "the speakers' TDM port" : level == 2 ?
+		    "the port and a stream with a test tone, the amplifiers off" :
+		    "the port, a stream with a test tone, and the amplifiers", seconds);
+	}
+	if (level >= 3) {
+		acf = redwood_adsp_fw_file("aw882xx_acf.bin", &acf_size);
+		if (acf == NULL) {
+			say("sound: no /fw/aw882xx_acf.bin: put the phone's /vendor/etc/aw882xx_acf.bin into fw-audio/ and run SYSTEM=1 "
+			    "userland/build.sh\n");
+			goto out;
+		}
+	}
+	if (level >= 2) {
+		lck_mtx_lock(&redwood_smmu_lock);
+		ok = shared_get(0);
+		lck_mtx_unlock(&redwood_smmu_lock);
+		if (!ok) {
+			goto out;
+		}
+		ok = false;
+		redwood_adsp_apr_events(events);
+	}
+	announce("the TDM pins (GPIO 97 to 100) to the interface, as Android's active state has them");
+	pins_on();
+	if (!afe_on()) {
+		goto out;
+	}
+	sleep_ms(20);
+	pin_activity(97, "the bit clock (gpio97)", &changes, &ones);
+	pin_activity(100, "the frame sync (gpio100)", &sync_changes, &sync_ones);
+	say("sound: %s\n", changes > 100 && sync_changes > 4 ? "THE TDM CLOCK AND FRAME SYNC RUN at the pins" :
+	    "THE PINS DO NOT SHOW A RUNNING TDM CLOCK");
+	if (level == 1) {
+		sleep_ms(seconds * 1000);
+		ok = true;
+		goto out;
+	}
+	if (!stream_on()) {
+		goto out;
+	}
+	if (level == 4) {
+		thread_t feeder;
+
+		announce("the amplifiers, set up from Android's Music profile, powered down until iOS plays");
+		if (!redwood_speaker_prepare(acf, acf_size)) {
+			goto out;
+		}
+		redwood_adsp_fw_free(acf, acf_size);
+		acf = NULL;
+		feeder_runs = true;
+		if (kernel_thread_start(feeder_thread, NULL, &feeder) != KERN_SUCCESS) {
+			feeder_runs = false;
+			say("sound: no thread for the feeder\n");
+			goto out;
+		}
+		thread_deallocate(feeder);
+		watcher_runs = true;
+		redwood_audio_set_sink("the speakers (the audio DSP, redwood_sound.c)", ios_sink);
+		say("sound: WHAT IOS PLAYS GOES TO THE SPEAKERS from here on, %u.%03u dB under Android's level, until the run ends\n",
+		    below / 8, below % 8 * 125);
+		say("sound: through the guard (redwood_guard.c): %u.%03u dB of gain first (sound_gain), then high-pass at 200 Hz; peaks "
+		    "3 dB, the 0.2 s/3 s/60 s power 6/9/12 dB under full scale at Android's level\n", gain / 8, gain % 8 * 125);
+		if (guard_as < below) {
+			say("sound: sound_guard_as=%u: FOR A TEST the guard reckons the amplifiers %u.%03u dB under Android's level, louder "
+			    "than they are, and holds back as much as it would there\n", guard_as, guard_as / 8, guard_as % 8 * 125);
+		}
+		lck_mtx_unlock(&sound_lock);
+		watch();
+		thread_terminate(current_thread());
+	}
+	if (level >= 3) {
+		/* the clock runs (the port is started, the stream as well): the amplifiers can lock to it */
+		announce("the amplifiers, set up from Android's Music profile, then started at the lowest volume");
+		if (!redwood_speaker_prepare(acf, acf_size) || !redwood_speaker_start()) {
+			goto out;
+		}
+	}
+	/* (the amplifiers are faded in before the tone begins: they fade in on silence, and the tone starts at that level) */
+	if (level >= 3 && !redwood_speaker_volume(below, 50)) {
+		goto out;
+	}
+	if (level >= 3) {
+		say("sound: THE TONE PLAYS NOW for %u s: 1 kHz at -20 dBFS, both speakers, %u.%03u dB under Android's level\n",
+		    seconds, below / 8, below % 8 * 125);
+	}
+	say_when("the tone begins");
+	ok = play(seconds * 1000, level >= 3);
+	say_when("the tone has ended");
+	space_faults();
+out:
+	if (acf != NULL) {
+		redwood_adsp_fw_free(acf, acf_size);
+	}
+	lck_mtx_unlock(&sound_lock);
+	take_down();
+	say("sound: %s; last: %s\n", ok ? "LEVEL DONE" : "STOPPED SHORT", last_write);
+	thread_terminate(current_thread());
+}
+
+void
+redwood_sound_dsp_up(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sound", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+#if defined(XNU_TARGET_OS_OSX)
+	/* The collection's __DATA has no room for the 128 KB ring: heap, and only when the boot arg asks for it. */
+	ring = kalloc_data(RING_FRAMES * 2 * sizeof(*ring), Z_WAITOK | Z_ZERO);
+	if (ring == NULL) {
+		printf("sound: no memory for the %u-byte ring; the tone stays off\n",
+		    (unsigned)(RING_FRAMES * 2 * sizeof(*ring)));
+		return;
+	}
+#endif
+	if (level > 4) {
+		level = 4;
+	}
+	PE_parse_boot_argn("sound_secs", &seconds, sizeof(seconds));
+	PE_parse_boot_argn("sound_below", &below, sizeof(below));
+	PE_parse_boot_argn("sound_pause", &pause_ms, sizeof(pause_ms));
+	PE_parse_boot_argn("sound_guard_as", &guard_as, sizeof(guard_as));
+	PE_parse_boot_argn("sound_gain", &gain, sizeof(gain));
+	if (gain > REDWOOD_GUARD_MAX_GAIN) {
+		gain = REDWOOD_GUARD_MAX_GAIN;
+	}
+	redwood_guard_configure(true, gain);
+	if (level >= 2 && level <= 3 && seconds > 3) {
+		seconds = 3;            /* the test tone: three seconds at most */
+	}
+	running = true;
+	if (kernel_thread_start(sound_thread, NULL, &thread) != KERN_SUCCESS) {
+		running = false;
+		say("sound: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+void
+redwood_sound_dsp_down(void)
+{
+	if (running) {
+		take_down();
+	}
+}
+
+void
+redwood_sound_quiesce(void)
+{
+	redwood_speaker_quiesce();
+}
diff --git a/bsd/dev/redwood_sparse.c b/bsd/dev/redwood_sparse.c
new file mode 100644
index 0000000000000000000000000000000000000000..0a8654cd78bddd179bfcb8f53bdd3333c923e49e
--- /dev/null
+++ b/bsd/dev/redwood_sparse.c
@@ -0,0 +1,281 @@
+/*
+ * A block device over an image that holds only some of its blocks (/dev/rsp0).  Only with
+ * boot-arg apfs_sparse=<offset>.
+ *
+ * This exists so that the real iOS root volume can be read on the phone.  The phone has
+ * no driver for its own storage, so a volume there has to live in a RAM disk, and that
+ * volume is 5368 MB against the 4288 MB its firmware leaves usable.  But a given walk
+ * reads only some of those blocks, so tools/apfs/mksparse.py writes out the ones it reads
+ * together with a table saying where each went, and this serves them at their original
+ * addresses.  The APFS driver above cannot tell the difference: every block it asks for is
+ * there, at the address it asks for.
+ *
+ * The image rides at the end of the resident RAM disk, after the image that is the root -- an
+ * APFS container, which ends where its own superblock says, so what follows is nothing to it
+ * -- and apfs_sparse is the byte offset where it starts.
+ *
+ * A block that is not in the image reads as zeros and is counted.  Nothing should ask for
+ * one; the count is printed so that it does not go unnoticed if something does.
+ *
+ * Read only.
+ */
+
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <sys/redwood_sparse.h>
+
+extern dev_t mdevlookup(int devid);
+extern int mdevgetkernelrange(dev_t dev, vm_offset_t *base, uint64_t *size);
+
+#define SPARSE_MAGIC   "REDWOODSPARSE1\0\0"
+#define SPARSE_SECTOR  512
+
+struct sparse_header {
+	char     sh_magic[16];
+	uint32_t sh_block_size;
+	uint64_t sh_block_count;        /* of the container this stands in for */
+	uint64_t sh_present;            /* how many of them are here */
+	uint64_t sh_table_off;          /* from the start of this header */
+	uint64_t sh_data_off;
+} __attribute__((packed));
+
+static const uint8_t *sparse_table;     /* sh_block_count 32-bit entries */
+static const uint8_t *sparse_data;
+static uint32_t sparse_block_size;
+static uint64_t sparse_block_count;
+static uint64_t sparse_present;
+static bool sparse_ready;
+static int sparse_bmajor = -1, sparse_cmajor = -1;
+static uint64_t sparse_hits, sparse_misses;
+
+static int
+sparse_open(__unused dev_t dev, int flags, __unused int devtype, __unused proc_t p)
+{
+	if (!sparse_ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sparse_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused proc_t p)
+{
+	return 0;
+}
+
+/* Where block `blk` of the container is in the image, or NULL if it is not here. */
+static const uint8_t *
+sparse_block(uint64_t blk)
+{
+	uint32_t slot;
+
+	if (blk >= sparse_block_count) {
+		return NULL;
+	}
+	memcpy(&slot, sparse_table + blk * 4, sizeof(slot));
+	if (slot == 0) {
+		return NULL;
+	}
+	return sparse_data + (uint64_t)(slot - 1) * sparse_block_size;
+}
+
+static void
+sparse_strategy(buf_t bp)
+{
+	uint8_t *dst;
+	uint64_t off;
+	size_t left;
+
+	if (!sparse_ready) {
+		buf_seterror(bp, ENXIO);
+		buf_biodone(bp);
+		return;
+	}
+	if (!(buf_flags(bp) & B_READ)) {
+		buf_seterror(bp, EROFS);
+		buf_biodone(bp);
+		return;
+	}
+	off = (uint64_t)buf_blkno(bp) * SPARSE_SECTOR;
+	left = buf_count(bp);
+	dst = (uint8_t *)buf_dataptr(bp);
+
+	if (off >= sparse_block_count * sparse_block_size) {
+		buf_setresid(bp, buf_count(bp));
+		buf_seterror(bp, (off == sparse_block_count * sparse_block_size) ? 0 : EINVAL);
+		buf_biodone(bp);
+		return;
+	}
+	while (left > 0) {
+		uint64_t blk = off / sparse_block_size;
+		uint32_t skew = (uint32_t)(off % sparse_block_size);
+		size_t n = sparse_block_size - skew;
+		const uint8_t *src;
+
+		if (n > left) {
+			n = left;
+		}
+		src = sparse_block(blk);
+		if (src == NULL) {
+			/* nothing asked for this when the image was made */
+			bzero(dst, n);
+			sparse_misses++;
+		} else {
+			memcpy(dst, src + skew, n);
+			sparse_hits++;
+		}
+		dst += n;
+		off += n;
+		left -= n;
+	}
+	buf_setresid(bp, 0);
+	buf_biodone(bp);
+}
+
+static int
+sparse_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int fflag,
+    __unused proc_t p)
+{
+	if (!sparse_ready) {
+		return ENXIO;
+	}
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = SPARSE_SECTOR;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		/* spec_open() sets 512 and back, and takes a refusal for a broken device */
+		return (*(uint32_t *)data == SPARSE_SECTOR) ? 0 : EINVAL;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = sparse_block_count *
+		    (sparse_block_size / SPARSE_SECTOR);
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 0;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sparse_size(__unused dev_t dev)
+{
+	return sparse_ready ? SPARSE_SECTOR : -1;
+}
+
+static const struct bdevsw sparse_bdevsw = {
+	.d_open     = sparse_open,
+	.d_close    = sparse_close,
+	.d_strategy = sparse_strategy,
+	.d_ioctl    = sparse_ioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sparse_size,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sparse_cdevsw = {
+	.d_open       = sparse_open,
+	.d_close      = sparse_close,
+	.d_read       = eno_rdwrt,
+	.d_write      = eno_rdwrt,
+	.d_ioctl      = sparse_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+void
+redwood_sparse_report(void)
+{
+	if (!sparse_ready) {
+		return;
+	}
+	printf("sparse: %llu blocks served, %llu asked for that are not in the image\n",
+	    (unsigned long long)sparse_hits, (unsigned long long)sparse_misses);
+}
+
+void
+redwood_sparse_init(void)
+{
+	uint64_t off = 0;
+	vm_offset_t base = 0;
+	uint64_t size = 0;
+	const struct sparse_header *hdr;
+	dev_t md;
+
+	if (!PE_parse_boot_argn("apfs_sparse", &off, sizeof(off)) || off == 0) {
+		return;
+	}
+	md = mdevlookup(0);
+	if (md == (dev_t)-1 || mdevgetkernelrange(md, &base, &size) != 0) {
+		printf("sparse: md0 is not a memory disk this can be read from\n");
+		return;
+	}
+	if (off + sizeof(*hdr) > size) {
+		printf("sparse: offset %llu is past the end of md0 (%llu bytes)\n",
+		    (unsigned long long)off, (unsigned long long)size);
+		return;
+	}
+	hdr = (const struct sparse_header *)(base + off);
+	if (memcmp(hdr->sh_magic, SPARSE_MAGIC, sizeof(hdr->sh_magic)) != 0) {
+		printf("sparse: no sparse image at offset %llu in md0\n",
+		    (unsigned long long)off);
+		return;
+	}
+	sparse_block_size = hdr->sh_block_size;
+	sparse_block_count = hdr->sh_block_count;
+	sparse_present = hdr->sh_present;
+	if (sparse_block_size < SPARSE_SECTOR || (sparse_block_size % SPARSE_SECTOR) != 0 ||
+	    sparse_block_count == 0 || sparse_present == 0 ||
+	    sparse_present > sparse_block_count) {
+		printf("sparse: the header makes no sense\n");
+		return;
+	}
+	if (off + hdr->sh_data_off + sparse_present * sparse_block_size > size ||
+	    off + hdr->sh_table_off + sparse_block_count * 4 > size) {
+		printf("sparse: the image does not fit in md0 (%llu bytes)\n",
+		    (unsigned long long)size);
+		return;
+	}
+	sparse_table = (const uint8_t *)(base + off + hdr->sh_table_off);
+	sparse_data = (const uint8_t *)(base + off + hdr->sh_data_off);
+
+	sparse_bmajor = bdevsw_add(-1, &sparse_bdevsw);
+	if (sparse_bmajor < 0) {
+		printf("sparse: bdevsw_add failed\n");
+		return;
+	}
+	sparse_cmajor = cdevsw_add_with_bdev(-1, &sparse_cdevsw, sparse_bmajor);
+	if (sparse_cmajor < 0) {
+		printf("sparse: cdevsw_add failed\n");
+		return;
+	}
+	if (devfs_make_node(makedev(sparse_bmajor, 0), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR,
+	    0600, "rsp0") == NULL) {
+		printf("sparse: devfs_make_node failed\n");
+		return;
+	}
+	sparse_ready = true;
+	printf("sparse: /dev/rsp0 stands in for %llu blocks of %u, %llu of them here "
+	    "(%llu MB), at offset %llu of md0\n", (unsigned long long)sparse_block_count,
+	    sparse_block_size, (unsigned long long)sparse_present,
+	    (unsigned long long)(sparse_present * sparse_block_size / (1024 * 1024)),
+	    (unsigned long long)off);
+}
diff --git a/bsd/dev/redwood_speaker.c b/bsd/dev/redwood_speaker.c
new file mode 100644
index 0000000000000000000000000000000000000000..cd1bcc7e2ecde405e0f4c15a8d71ce9309e4dd0e
--- /dev/null
+++ b/bsd/dev/redwood_speaker.c
@@ -0,0 +1,1211 @@
+/*
+ * The speakers of the POCO X5 Pro (redwood): their two amplifiers. Every address below belongs
+ * to this phone, and nothing here is touched unless a boot-arg asks for it.
+ *
+ * Each speaker has an amplifier of its own, an Awinic AW88261 (chip ID 0x2113, a "smart PA"),
+ * set up over I2C -- the bus of the SoC's serial engine 3, GPIO 12 data and 13 clock, on which
+ * Android's device tree and its running kernel have these two and nothing else -- and fed by
+ * the SoC's first TDM interface ("MI2S 0": GPIO 97 bit clock, 100 frame sync, 99 data out),
+ * which the audio DSP drives (redwood_sound.c). In Android's tree the amplifier at 0x35 is
+ * "sound-channel 0" and takes slot 0 of the frame (the left channel), the one at 0x34 is
+ * channel 1 and takes slot 1; neither has a reset pin.
+ *
+ * Two uses:
+ *
+ *   speaker_probe=1    reads registers and nothing else: the pins, the power names (below)
+ *   speaker_probe=2    ... and asks the amplifiers who they are (I2C, below)
+ *
+ *   redwood_speaker_prepare() and the rest (sys/redwood_audio.h), for boot-arg sound=3 of
+ *   redwood_sound.c: the amplifiers set up and run exactly as Android's own driver does it
+ *   (Xiaomi's redwood-s-oss kernel, techpack/audio/asoc/codecs/aw88263s_m20: aw882xx_device.c,
+ *   aw882xx_init.c and aw882xx_pid_2113_reg.h; the phone runs its version 2.0.0), with the
+ *   registers' values from Android's own configuration file -- /vendor/etc/aw882xx_acf.bin of
+ *   the phone, which userland/build.sh puts into /fw of the system image from fw-audio/ and
+ *   which is not in this repository. Its "Music" profile is what Android plays the speakers
+ *   with (tinymix: aw_dev_0_prof, aw_dev_1_prof); 55 of its 57 registers read back from the
+ *   idle chips under Android exactly as the file has them, and the other two as the driver
+ *   leaves them (0x04 powered down and muted, 0x08 with the feedback off).
+ *
+ * What the driver does and this does the same way, per amplifier:
+ *
+ *   prepare  reads the chip ID and the four fuse registers; a soft reset (0x55aa into
+ *            register 0); the profile's registers, every one but three as the file has them:
+ *            0x04 keeps the power-down, amplifier power-down and mute bits as they are and
+ *            sets the mute of the power stage ("ULS"), 0x08 has the feedback off, and 0x05 (the
+ *            volume) is turned down to the lowest, -90 dB, right after; 0x50 gets the value the
+ *            driver works out from the fuses (8192 * (1000 + icalk) / (1000 + vcalk)), which for
+ *            this phone's two chips is the value Android left in them
+ *   start    only while the TDM clock runs: power-down off, 2 ms, the PLL locked (status bits 0
+ *            and 4); amplifier power-down off, 1 ms, the status as the driver wants it (bits 0, 4,
+ *            8, 9); the feedback on; the two mutes off; the interrupts read away; the volume
+ *            stays at the lowest
+ *   volume   stepwise, 6 dB a step (the driver takes one every 100 us), to `below' eighths of a dB
+ *            under Android's own level (the profile's 0x05, -2.1 dB, with Android's
+ *            aw_dev_N_volume 0) and never above it
+ *   stop     the power stage muted, the volume stepped down to the lowest, muted, the feedback
+ *            off, 1 ms, amplifier power-down, power-down
+ *
+ * Every write is said in the log and read back; a value that does not read back as written, a
+ * byte nobody acknowledges, or a fault in the status register (under-voltage, over-current of
+ * the boost or the output, over-temperature, no clock, the watchdog, over-voltage) has both
+ * amplifiers powered down at once (amplifier power-down and power-down, bits 1 and 0 of 0x04)
+ * and nothing more done. What is not done, compared with Android: the DSP's Awinic algorithm,
+ * which protects the speakers with their calibration (aw882xx_rx_switch); in its place the
+ * samples go through redwood_guard.c on their way here. The driver's monitor is done
+ * (redwood_speaker_monitor(), below): once a second the chips' temperature and the battery's
+ * voltage, and the reduction that the file's table asks for at either.
+ *
+ * I2C is done by hand: a pin is either pulled low or let go (and the pull-ups raise it), at 100
+ * kHz at most. For each register read or written the two pins are taken from the serial engine
+ * (function qup03) as GPIOs and given back as they were found right after.
+ *
+ * Register layouts: the files above, and Linux's sound/soc/codecs/aw88261.c; pins:
+ * drivers/pinctrl/qcom/pinctrl-yupik.c of the same kernel and the phone's own device tree.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/redwood_audio.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static vm_offset_t tlmm, gcc, cmd_db;
+static uint32_t probe_level;
+static bool leaving;                    /* on a panic's way out: nothing sleeps, nothing is said but to the loader */
+
+/* Every line to the loader's log as well: what is written to the amplifiers should be known even if the kernel dies. */
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving) {
+		printf("%s", line);
+	}
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* Waits without sleeping (also with interrupts off, on a panic's way out). */
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- pins ------------------------------------------------------------------------------------------ */
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x100000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_PULL_UP             3
+#define CFG_OUTPUT              (1u << 9)
+
+#define PIN_SDA                 12      /* the serial engine's first pin is the data line, the second the clock */
+#define PIN_SCL                 13
+
+static const struct {
+	unsigned pin;
+	const char *what;
+} pins[] = {
+	{ 12, "I2C data" }, { 13, "I2C clock" }, { 97, "MI2S 0 bit clock" }, { 100, "MI2S 0 word select" },
+	{ 98, "MI2S 0 data 0" }, { 99, "MI2S 0 data 1" }, { 102, "the amplifier 0x35's interrupt" },
+	{ 45, "the amplifier 0x34's interrupt" },
+};
+
+static void
+show_pins(void)
+{
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		uint32_t cfg = rd(GPIO_CFG(pins[i].pin)), io = rd(GPIO_IO(pins[i].pin));
+
+		say("speaker: gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", pins[i].pin, pins[i].what,
+		    (cfg >> 2) & 15, cfg & 3, (((cfg >> 6) & 7) + 1) * 2, (cfg & CFG_OUTPUT) ? (io & 2 ? "drives high" : "drives low") :
+		    "input", io & 1);
+	}
+}
+
+/* ---- I2C by hand ----------------------------------------------------------------------------------- */
+
+static void
+half_bit(void)
+{
+	spin_us(5);                     /* 100 kHz at most, I2C's standard mode; the bus does not mind slower */
+}
+
+/* A line is pulled low (the pin drives 0) or let go (the pin is an input and the pull-up raises it). */
+static void
+line(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), 0);
+	wr(GPIO_CFG(pin), CFG_PULL_UP | (high ? 0 : CFG_OUTPUT));
+}
+
+static bool
+level(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+i2c_start(void)
+{
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	half_bit();
+	line(PIN_SDA, false);
+	half_bit();
+	line(PIN_SCL, false);
+	half_bit();
+}
+
+static void
+i2c_stop(void)
+{
+	line(PIN_SDA, false);
+	half_bit();
+	line(PIN_SCL, true);
+	half_bit();
+	line(PIN_SDA, true);
+	half_bit();
+}
+
+/* One bit out (the other side's bit in, if we let the data line go): the clock goes up and down once. */
+static bool
+i2c_bit(bool out)
+{
+	bool in;
+
+	line(PIN_SDA, out);
+	half_bit();
+	line(PIN_SCL, true);
+	for (unsigned stretched = 0; !level(PIN_SCL) && stretched < 100; stretched++) {
+		half_bit();             /* (a device may hold the clock low until it is ready) */
+	}
+	half_bit();
+	in = level(PIN_SDA);
+	line(PIN_SCL, false);
+	return in;
+}
+
+/* Returns true if the byte was acknowledged. */
+static bool
+i2c_write(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_bit((byte >> bit) & 1);
+	}
+	return !i2c_bit(true);
+}
+
+static uint8_t
+i2c_read(bool more)
+{
+	uint8_t byte = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		byte = (uint8_t)(byte << 1 | i2c_bit(true));
+	}
+	i2c_bit(!more);                 /* acknowledge all but the last byte */
+	return byte;
+}
+
+/*
+ * The two pins taken from the serial engine for one transaction, and given back as found. False
+ * if the bus is not at rest: then nothing is driven.
+ */
+static uint32_t taken_cfg[2], taken_io[2];
+
+static bool
+bus_take(void)
+{
+	taken_cfg[0] = rd(GPIO_CFG(PIN_SDA));
+	taken_cfg[1] = rd(GPIO_CFG(PIN_SCL));
+	taken_io[0] = rd(GPIO_IO(PIN_SDA));
+	taken_io[1] = rd(GPIO_IO(PIN_SCL));
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	half_bit();
+	if (!level(PIN_SDA) || !level(PIN_SCL)) {
+		wr(GPIO_IO(PIN_SDA), taken_io[0] & 2);
+		wr(GPIO_IO(PIN_SCL), taken_io[1] & 2);
+		wr(GPIO_CFG(PIN_SDA), taken_cfg[0]);
+		wr(GPIO_CFG(PIN_SCL), taken_cfg[1]);
+		return false;
+	}
+	return true;
+}
+
+static void
+bus_give_back(void)
+{
+	wr(GPIO_IO(PIN_SDA), taken_io[0] & 2);
+	wr(GPIO_IO(PIN_SCL), taken_io[1] & 2);
+	wr(GPIO_CFG(PIN_SDA), taken_cfg[0]);
+	wr(GPIO_CFG(PIN_SCL), taken_cfg[1]);
+}
+
+/* A 16-bit register of an Awinic amplifier, most significant byte first. Returns false if nobody answers. */
+static bool
+register_read(uint8_t address, uint8_t reg, uint16_t *value)
+{
+	bool answered;
+
+	if (!bus_take()) {
+		say("speaker: the I2C bus is not at rest (gpio%u reads %u, gpio%u reads %u): not touched\n", PIN_SDA,
+		    level(PIN_SDA), PIN_SCL, level(PIN_SCL));
+		return false;
+	}
+	i2c_start();
+	answered = i2c_write((uint8_t)(address << 1)) && i2c_write(reg);
+	if (answered) {
+		i2c_start();
+		answered = i2c_write((uint8_t)(address << 1 | 1));
+	}
+	if (answered) {
+		*value = (uint16_t)(i2c_read(true) << 8);
+		*value |= i2c_read(false);
+	}
+	i2c_stop();
+	bus_give_back();
+	return answered;
+}
+
+static bool
+register_write(uint8_t address, uint8_t reg, uint16_t value)
+{
+	bool answered;
+
+	if (!bus_take()) {
+		say("speaker: the I2C bus is not at rest (gpio%u reads %u, gpio%u reads %u): not touched\n", PIN_SDA,
+		    level(PIN_SDA), PIN_SCL, level(PIN_SCL));
+		return false;
+	}
+	i2c_start();
+	answered = i2c_write((uint8_t)(address << 1)) && i2c_write(reg) && i2c_write((uint8_t)(value >> 8)) &&
+	    i2c_write((uint8_t)value);
+	i2c_stop();
+	bus_give_back();
+	return answered;
+}
+
+static const char *
+amplifier_name(uint16_t id)
+{
+	switch (id) {
+	case 0x1852: return "AW88194/AW88195";
+	case 0x2013: return "AW88264";
+	case 0x2032: return "AW88266";
+	case 0x2049: return "AW88395";
+	case 0x2055: return "AW88256";
+	case 0x2066: return "AW88166";
+	case 0x2071: return "AW88350";
+	case 0x2113: return "AW88261";
+	case 0x2183: return "AW88399";
+	case 0x2308: return "AW88230";
+	}
+	return "an amplifier this list does not know";
+}
+
+/* ---- the amplifiers, as Android's driver runs them -------------------------------------------------- */
+
+#define AW_ID                   0x00            /* reads the chip ID; 0x55aa written resets the chip */
+#define AW_ID_AW88261           0x2113
+#define AW_SOFT_RESET           0x55aa
+#define AW_SYSST                0x01
+#define AW_SYSINT               0x02            /* read: cleared */
+#define AW_SYSINTM              0x03
+#define AW_SYSCTRL              0x04
+#define AW_SYSCTRL2             0x05            /* [9:0] the volume, attenuation: [9:6] 6 dB steps, [5:0] eighths of a dB */
+#define AW_I2SCTRL3             0x08
+#define AW_VBAT                 0x21            /* [9:0] the battery's voltage as the amplifier sees it: x 6025 / 1023 mV */
+#define AW_TEMP                 0x22            /* [9:0] the amplifier's temperature, degrees Celsius, two's complement */
+#define AW_PVDD                 0x23            /* [9:0] its boosted supply */
+#define AW_ISNDAT               0x24            /* the current and voltage sense, as last measured */
+#define AW_VSNDAT               0x25
+#define AW_DBGCTRL              0x14
+#define AW_VSNTM1               0x50
+#define AW_EFRH4                0x78
+#define AW_EFRH3                0x79
+#define AW_EFRL4                0x7c
+#define AW_EFRL3                0x7d
+
+#define SYSCTRL_PWDN            (1u << 0)
+#define SYSCTRL_AMPPD           (1u << 1)
+#define SYSCTRL_HMUTE           (1u << 8)
+#define SYSCTRL_ULS_HMUTE       (1u << 14)
+#define I2SCTRL3_TXEN           (1u << 6)
+#define DBGCTRL_EF_OR           (1u << 3)       /* the fuses' two copies are or-ed; else and-ed */
+#define SYSINTM_DEFAULT         0xffff
+
+#define SYSST_PLLS              (1u << 0)
+#define SYSST_OTHS              (1u << 1)
+#define SYSST_OCDS              (1u << 3)
+#define SYSST_CLKS              (1u << 4)
+#define SYSST_NOCLKS            (1u << 5)
+#define SYSST_WDS               (1u << 6)
+#define SYSST_SWS               (1u << 8)
+#define SYSST_BSTS              (1u << 9)
+#define SYSST_BSTOCS            (1u << 11)
+#define SYSST_UVLS              (1u << 14)
+#define SYSST_OVP2S             (1u << 15)
+#define SYSST_PLL_CHECK         (SYSST_CLKS | SYSST_PLLS)
+#define SYSST_CHECK             (SYSST_BSTS | SYSST_SWS | SYSST_CLKS | SYSST_PLLS)
+#define SYSST_FAULTS            (SYSST_OVP2S | SYSST_UVLS | SYSST_BSTOCS | SYSST_WDS | SYSST_NOCLKS | SYSST_OCDS | SYSST_OTHS)
+
+#define VOLUME_LOWEST           (90 * 8)        /* the driver's "mute volume", in eighths of a dB */
+#define VOLUME_STEP             (6 * 8)
+#define STATUS_TRIES            10              /* the driver's AW_DEV_SYSST_CHECK_MAX, 2 ms apart */
+
+/* Android's configuration file ("ACF", Awinic's format; Linux: sound/soc/codecs/aw88395/aw88395_lib.c) */
+#define ACF_PROFILE_MUSIC       0
+#define ACF_DATA_REGISTERS      4               /* a block with a header of its own and registers in it */
+#define ACF_DATA_MONITOR        10              /* the driver's "monitor": what to do when the chip is cold or the battery low */
+#define MONITOR_ROWS            8
+#define ACF_BLOCK_HEADER        0x3c
+
+struct amplifier {
+	uint8_t address;
+	unsigned device;                /* the file's device number for it (Android's sound-channel) */
+	const char *where;
+	uint16_t profile[64][2];        /* register, value */
+	unsigned count;
+	uint16_t sysctrl;               /* what the profile has for 0x04, 0x08 and 0x05 */
+	uint16_t i2sctrl3;
+	uint16_t volume_at;             /* Android's level: from the profile's 0x05, in eighths of a dB of attenuation */
+	uint16_t volume;                /* where it is now */
+	uint16_t volume_high;           /* the profile's bits 15:10 of 0x05, which the volume leaves as they are */
+	bool prepared, started;
+	/* the monitor's tables (from the file) and what was last seen */
+	struct { int16_t min, max; uint16_t less; } temp_rows[MONITOR_ROWS], vbat_rows[MONITOR_ROWS];
+	unsigned temp_count, vbat_count, looks;
+	int temps[3], vbats[3];
+	int temp_row, vbat_row;
+};
+
+static struct amplifier amplifiers[2] = {
+	{ .address = 0x35, .device = 0, .where = "0x35, slot 0", .temp_row = -1, .vbat_row = -1 },
+	{ .address = 0x34, .device = 1, .where = "0x34, slot 1", .temp_row = -1, .vbat_row = -1 },
+};
+static bool broken;                     /* something went wrong: both have been powered down, nothing more is done */
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/*
+ * The driver's monitor for one amplifier (Android has it on: aw_dev_N_monitor), from the file: every second it
+ * reads the chip's temperature and the battery's voltage, and a table says what to do for each range of them.
+ * This file's: at 7 to 100 degrees nothing; at 2 to 5 degrees 3 dB less, at -2 to 0 4.5 dB, at -50 to -5 8 dB (and
+ * a lower current limit for the boost, which is not done here); from 3.85 V nothing, at 3.65 to 3.75 V and up to
+ * 3.55 V a lower "vmax" for the DSP's algorithm, which does not run here. In its temperature rows a vmax goes with
+ * each reduction of the volume, so the battery rows' vmax is turned into a volume reduction in the same proportion
+ * (the first temperature row's: 3 dB for its vmax): 1.6 and 3.1 dB. Between the ranges the last one holds.
+ *   block: checksum (of the bytes after it), version, chip name[16], ui version, the time and count of looks,
+ *   switches, then for the temperatures and for the voltages each: a value, the number of rows, a row's size and
+ *   the rows' offset; a row: int16 lowest, int16 highest, uint16 boost current, uint16 reduction (eighths of a
+ *   dB), int32 vmax
+ */
+static void
+acf_monitor(uint16_t device, const uint8_t *block, uint32_t length)
+{
+	struct amplifier *a = NULL;
+	uint32_t sum = 0, temp_count, temp_size, temp_at, vbat_count, vbat_size, vbat_at;
+	int64_t per_eighth = 0;
+
+	for (unsigned i = 0; i < 2; i++) {
+		if (amplifiers[i].device == device) {
+			a = &amplifiers[i];
+		}
+	}
+	if (a == NULL || length < 0x48) {
+		return;
+	}
+	for (uint32_t i = 4; i < length; i++) {
+		sum += block[i];
+	}
+	temp_count = le32(block + 0x2c);
+	temp_size = le32(block + 0x30);
+	temp_at = le32(block + 0x34);
+	vbat_count = le32(block + 0x3c);
+	vbat_size = le32(block + 0x40);
+	vbat_at = le32(block + 0x44);
+	if (sum != le32(block) || temp_size < 12 || vbat_size < 12 || temp_count > MONITOR_ROWS || vbat_count > MONITOR_ROWS ||
+	    temp_at + temp_count * temp_size > length || vbat_at + vbat_count * vbat_size > length) {
+		say("speaker: device %u's monitor table is not of the shape known: not used\n", device);
+		return;
+	}
+	for (uint32_t i = 0; i < temp_count; i++) {
+		const uint8_t *row = block + temp_at + i * temp_size;
+		int32_t vmax = (int32_t)le32(row + 8);
+
+		a->temp_rows[i].min = (int16_t)(row[0] | row[1] << 8);
+		a->temp_rows[i].max = (int16_t)(row[2] | row[3] << 8);
+		a->temp_rows[i].less = (uint16_t)(row[6] | row[7] << 8);
+		if (per_eighth == 0 && a->temp_rows[i].less != 0 && vmax < 0) {
+			per_eighth = -(int64_t)vmax / a->temp_rows[i].less;
+		}
+	}
+	for (uint32_t i = 0; i < vbat_count; i++) {
+		const uint8_t *row = block + vbat_at + i * vbat_size;
+		int32_t vmax = (int32_t)le32(row + 8);
+
+		a->vbat_rows[i].min = (int16_t)(row[0] | row[1] << 8);
+		a->vbat_rows[i].max = (int16_t)(row[2] | row[3] << 8);
+		a->vbat_rows[i].less = (uint16_t)(row[6] | row[7] << 8);
+		if (vmax < 0 && per_eighth > 0) {
+			a->vbat_rows[i].less += (uint16_t)((-(int64_t)vmax + per_eighth / 2) / per_eighth);
+		}
+	}
+	a->temp_count = temp_count;
+	a->vbat_count = vbat_count;
+	for (uint32_t i = 0; i < temp_count; i++) {
+		say("speaker: the amplifier %s's monitor: at %d to %d degrees, %u.%03u dB less\n", a->where, a->temp_rows[i].min,
+		    a->temp_rows[i].max, a->temp_rows[i].less / 8, a->temp_rows[i].less % 8 * 125);
+	}
+	for (uint32_t i = 0; i < vbat_count; i++) {
+		say("speaker: the amplifier %s's monitor: at %d to %d mV, %u.%03u dB less\n", a->where, a->vbat_rows[i].min,
+		    a->vbat_rows[i].max, a->vbat_rows[i].less / 8, a->vbat_rows[i].less % 8 * 125);
+	}
+}
+
+/* The "Music" profile of every amplifier, from the file; false if the file is not of the shape known. */
+static bool
+acf_profiles(const uint8_t *acf, uint64_t size)
+{
+	uint32_t entry_size, entries, at;
+
+	if (size < 0x50 || size > 0x100000) {
+		say("speaker: the configuration file is %llu bytes: not one of Awinic's\n", size);
+		return false;
+	}
+	entry_size = le32(acf + 0x34);
+	entries = le32(acf + 0x38);
+	at = le32(acf + 0x3c);
+	if (entries == 0 || entries > 64 || entry_size % entries != 0 || entry_size / entries < 0x30 ||
+	    (uint64_t)at + entry_size > size) {
+		say("speaker: the configuration file's table (%u entries, %u bytes at %#x) is not of a shape known\n", entries,
+		    entry_size, at);
+		return false;
+	}
+	for (uint32_t e = 0; e < entries; e++) {
+		const uint8_t *entry = acf + at + e * (entry_size / entries);
+		char name[17];
+		uint16_t device = (uint16_t)(entry[20] | entry[21] << 8), profile = (uint16_t)(entry[26] | entry[27] << 8);
+		uint32_t kind = le32(entry + 28), length = le32(entry + 32), offset = le32(entry + 36);
+		uint32_t checksum, sum = 0, data_length, count;
+		const uint8_t *block = acf + offset;
+		struct amplifier *a = NULL;
+
+		memcpy(name, entry + 4, 16);
+		name[16] = 0;
+		if (kind == ACF_DATA_MONITOR) {
+			acf_monitor(device, acf + offset, (uint64_t)offset + length <= size ? length : 0);
+			continue;
+		}
+		if (kind != ACF_DATA_REGISTERS || profile != ACF_PROFILE_MUSIC || strcmp(name, "aw88261") != 0) {
+			continue;
+		}
+		for (unsigned i = 0; i < 2; i++) {
+			if (amplifiers[i].device == device) {
+				a = &amplifiers[i];
+			}
+		}
+		if (a == NULL || (uint64_t)offset + length > size || length < ACF_BLOCK_HEADER + 4) {
+			say("speaker: the configuration file's entry %u (device %u) does not fit\n", e, device);
+			return false;
+		}
+		checksum = le32(block);
+		data_length = le32(block + 0x10);
+		count = le32(block + ACF_BLOCK_HEADER);
+		if (ACF_BLOCK_HEADER + data_length > length || data_length != 4 + 4 * count || count > 64 ||
+		    le32(block + 0x20) != 2 || le32(block + 0x24) != 2) {
+			say("speaker: device %u's Music profile is not a list of 16-bit registers (%u bytes, %u registers)\n", device,
+			    data_length, count);
+			return false;
+		}
+		for (uint32_t i = 4; i < ACF_BLOCK_HEADER + data_length; i++) {
+			sum += block[i];
+		}
+		if (sum != checksum) {
+			say("speaker: device %u's Music profile does not add up (%#x, the file says %#x)\n", device, sum, checksum);
+			return false;
+		}
+		a->count = count;
+		for (uint32_t i = 0; i < count; i++) {
+			const uint8_t *pair = block + ACF_BLOCK_HEADER + 4 + 4 * i;
+
+			a->profile[i][0] = (uint16_t)(pair[0] | pair[1] << 8);
+			a->profile[i][1] = (uint16_t)(pair[2] | pair[3] << 8);
+		}
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		bool have[3] = { false, false, false };
+
+		for (unsigned r = 0; r < a->count; r++) {
+			uint16_t reg = a->profile[r][0], value = a->profile[r][1];
+
+			if (reg == AW_SYSCTRL) {
+				a->sysctrl = value;
+				have[0] = true;
+			} else if (reg == AW_I2SCTRL3) {
+				a->i2sctrl3 = value;
+				have[1] = true;
+			} else if (reg == AW_SYSCTRL2) {
+				/* the driver's aw_pid_2113_reg_val_to_db() */
+				a->volume_at = (uint16_t)(((value & 0x3ff) >> 6) * VOLUME_STEP + (value & 0x3f));
+				a->volume_high = value & 0xfc00;
+				have[2] = true;
+			} else if (reg == AW_ID || reg >= 0x70) {
+				say("speaker: device %u's Music profile writes register %#x, which is not one of the configuration's\n",
+				    a->device, reg);
+				return false;
+			}
+		}
+		if (a->count == 0 || !have[0] || !have[1] || !have[2] || a->volume_at >= VOLUME_LOWEST) {
+			say("speaker: no usable Music profile for device %u (the amplifier at %#x) in the configuration file\n",
+			    a->device, a->address);
+			return false;
+		}
+		say("speaker: the amplifier %s: Music profile of %u registers; Android's volume there is -%u.%03u dB (%#x)\n", a->where,
+		    a->count, a->volume_at / 8, a->volume_at % 8 * 125, a->volume_at);
+	}
+	return true;
+}
+
+/* Both powered down at once, without the driver's ceremony: a fault, or a value that did not stick. */
+static void
+power_down_now(const char *why)
+{
+	broken = true;
+	say("speaker: %s: BOTH AMPLIFIERS ARE POWERED DOWN AT ONCE (0x04: amplifier power-down and power-down set)\n", why);
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		uint16_t value = 0, after = 0;
+
+		if (!a->prepared && !a->started) {
+			continue;
+		}
+		if (!register_read(a->address, AW_SYSCTRL, &value)) {
+			value = a->sysctrl;
+		}
+		value |= SYSCTRL_PWDN | SYSCTRL_AMPPD | SYSCTRL_HMUTE;
+		if (!register_write(a->address, AW_SYSCTRL, value) || !register_read(a->address, AW_SYSCTRL, &after)) {
+			say("speaker: the amplifier %s: 0x04 <- %#06x NOT ACKNOWLEDGED\n", a->where, value);
+		} else {
+			say("speaker: the amplifier %s: 0x04 <- %#06x, reads %#06x\n", a->where, value, after);
+		}
+		a->started = false;
+	}
+}
+
+/* One register written, said and read back; false (and both powered down) if it did not stick. */
+static bool
+put(struct amplifier *a, uint8_t reg, uint16_t value)
+{
+	uint16_t after = 0;
+
+	if (broken) {
+		return false;
+	}
+	if (!register_write(a->address, reg, value)) {
+		say("speaker: the amplifier %s: %#04x <- %#06x NOT ACKNOWLEDGED\n", a->where, reg, value);
+		power_down_now("a write was not acknowledged");
+		return false;
+	}
+	if (!register_read(a->address, reg, &after)) {
+		say("speaker: the amplifier %s: %#04x <- %#06x, NOT READ BACK\n", a->where, reg, value);
+		power_down_now("a register could not be read back");
+		return false;
+	}
+	say("speaker: the amplifier %s: %#04x <- %#06x, reads %#06x%s\n", a->where, reg, value, after, after == value ? "" :
+	    ": NOT AS WRITTEN");
+	if (after != value) {
+		power_down_now("a register did not read back as written");
+		return false;
+	}
+	return true;
+}
+
+static bool
+get(struct amplifier *a, uint8_t reg, uint16_t *value)
+{
+	if (!register_read(a->address, reg, value)) {
+		say("speaker: the amplifier %s: %#04x NOT READ\n", a->where, reg);
+		return false;
+	}
+	return true;
+}
+
+/* The bits of 0x04 named in `bits' set or cleared, the rest as they read. */
+static bool
+sysctrl(struct amplifier *a, uint16_t bits, bool set)
+{
+	uint16_t value;
+
+	if (broken || !get(a, AW_SYSCTRL, &value)) {
+		return false;
+	}
+	return put(a, AW_SYSCTRL, set ? (value | bits) : (value & ~bits));
+}
+
+/* The volume register at `volume' eighths of a dB of attenuation (the driver's aw_pid_2113_set_volume()). */
+static bool
+set_volume(struct amplifier *a, uint16_t volume)
+{
+	uint16_t value;
+
+	if (volume > VOLUME_LOWEST) {
+		volume = VOLUME_LOWEST;
+	}
+	if (volume < a->volume_at) {
+		volume = a->volume_at;  /* never louder than Android */
+	}
+	/* (the other bits as the profile has them and as they were written: not read first, for a quick fade) */
+	value = (uint16_t)(a->volume_high | (volume / VOLUME_STEP) << 6 | volume % VOLUME_STEP);
+	if (broken || !put(a, AW_SYSCTRL2, value)) {
+		return false;
+	}
+	a->volume = volume;
+	return true;
+}
+
+/* What the status register says, and whether it says a fault. */
+static bool
+faulty(struct amplifier *a, uint16_t *status)
+{
+	if (!get(a, AW_SYSST, status)) {
+		return true;
+	}
+	return (*status & SYSST_FAULTS) != 0;
+}
+
+bool
+redwood_speaker_prepare(const uint8_t *acf, uint64_t size)
+{
+	if (tlmm == 0) {
+		tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	}
+	broken = false;
+	say("speaker: the amplifiers are prepared as Android's driver prepares them; the I2C pins as found:\n");
+	show_pins();
+	if (!acf_profiles(acf, size)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		uint16_t id = 0, h4 = 0, h3 = 0, l4 = 0, l3 = 0, icalk_bits, vcalk_bits;
+		int icalk, vcalk;
+		uint16_t vcalb, ef_or = 0;
+
+		if (!get(a, AW_ID, &id)) {
+			say("speaker: nobody at I2C address %#x: not powered, or not there\n", a->address);
+			power_down_now("an amplifier does not answer");
+			return false;
+		}
+		say("speaker: the amplifier %s: chip ID %#06x, %s\n", a->where, id, amplifier_name(id));
+		if (id != AW_ID_AW88261) {
+			return false;
+		}
+		if (!get(a, AW_EFRH4, &h4) || !get(a, AW_EFRH3, &h3) || !get(a, AW_EFRL4, &l4) || !get(a, AW_EFRL3, &l3)) {
+			return false;
+		}
+		for (unsigned r = 0; r < a->count; r++) {
+			if (a->profile[r][0] == AW_DBGCTRL) {
+				ef_or = a->profile[r][1] & DBGCTRL_EF_OR;
+			}
+		}
+		/* the driver's aw_dev_get_icalk(), aw_dev_get_vcalk() and aw_dev_set_vcalb() */
+		icalk_bits = ef_or ? ((h4 & 0x3ff) | (l4 & 0x3ff)) : ((h4 & 0x3ff) & (l4 & 0x3ff));
+		vcalk_bits = ef_or ? ((h3 & 0x3ff) | (l3 & 0x3ff)) : ((h3 & 0x3ff) & (l3 & 0x3ff));
+		icalk = 1000 + ((icalk_bits & 0x200) ? (int)icalk_bits - 0x400 : (int)icalk_bits);
+		vcalk = 1000 + ((vcalk_bits & 0x200) ? (int)vcalk_bits - 0x400 : (int)vcalk_bits);
+		if (vcalk <= 0 || icalk <= 0) {
+			say("speaker: the amplifier %s: fuses %#x %#x %#x %#x make no sense\n", a->where, h4, h3, l4, l3);
+			return false;
+		}
+		vcalb = (uint16_t)(8192 * icalk / vcalk);
+		say("speaker: the amplifier %s: fuses %#06x %#06x %#06x %#06x: icalk %d, vcalk %d, so 0x50 is to be %#06x\n", a->where,
+		    h4, h3, l4, l3, icalk, vcalk, vcalb);
+
+		say("speaker: the amplifier %s: soft reset (0x00 <- 0x55aa), as the driver does it first\n", a->where);
+		a->prepared = true;
+		if (!register_write(a->address, AW_ID, AW_SOFT_RESET)) {
+			power_down_now("the soft reset was not acknowledged");
+			return false;
+		}
+		wait_ms(2);
+		for (unsigned r = 0; r < a->count; r++) {
+			uint8_t reg = (uint8_t)a->profile[r][0];
+			uint16_t value = a->profile[r][1], now;
+
+			switch (reg) {
+			case AW_SYSINTM:
+				value = SYSINTM_DEFAULT;
+				break;
+			case AW_SYSCTRL:
+				/* the three power and mute bits stay as they are; the power stage's mute on */
+				if (!get(a, AW_SYSCTRL, &now)) {
+					power_down_now("0x04 could not be read");
+					return false;
+				}
+				value = (uint16_t)((value & ~(SYSCTRL_PWDN | SYSCTRL_AMPPD | SYSCTRL_HMUTE)) |
+				    (now & (SYSCTRL_PWDN | SYSCTRL_AMPPD | SYSCTRL_HMUTE)) | SYSCTRL_ULS_HMUTE);
+				break;
+			case AW_I2SCTRL3:
+				value &= (uint16_t)~I2SCTRL3_TXEN;
+				break;
+			case AW_VSNTM1:
+				continue;
+			}
+			if (!put(a, reg, value)) {
+				return false;
+			}
+		}
+		if (!put(a, AW_VSNTM1, vcalb) || !set_volume(a, VOLUME_LOWEST)) {
+			return false;
+		}
+	}
+	say("speaker: BOTH AMPLIFIERS ARE CONFIGURED as Android's Music profile has them: powered down, muted, at the lowest volume\n");
+	return true;
+}
+
+bool
+redwood_speaker_start(void)
+{
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		uint16_t status = 0, interrupts = 0;
+		unsigned tries;
+
+		if (broken || !a->prepared) {
+			return false;
+		}
+		say("speaker: the amplifier %s: power-down off\n", a->where);
+		a->started = true;
+		if (!sysctrl(a, SYSCTRL_PWDN, false)) {
+			return false;
+		}
+		wait_ms(2);
+		for (tries = 0; tries < STATUS_TRIES; tries++) {
+			if (!get(a, AW_SYSST, &status)) {
+				power_down_now("the status could not be read");
+				return false;
+			}
+			if ((status & SYSST_PLL_CHECK) == SYSST_PLL_CHECK) {
+				break;
+			}
+			wait_ms(2);
+		}
+		say("speaker: the amplifier %s: status %#06x: its PLL %s\n", a->where, status, tries < STATUS_TRIES ?
+		    "IS LOCKED to the bit clock" : "DOES NOT LOCK: no clock?");
+		if (tries == STATUS_TRIES) {
+			power_down_now("an amplifier's PLL does not lock");
+			return false;
+		}
+		say("speaker: the amplifier %s: amplifier power-down off\n", a->where);
+		if (!sysctrl(a, SYSCTRL_AMPPD, false)) {
+			return false;
+		}
+		wait_ms(1);
+		for (tries = 0; tries < STATUS_TRIES; tries++) {
+			if (faulty(a, &status)) {
+				break;
+			}
+			if ((status & SYSST_CHECK) == SYSST_CHECK) {
+				break;
+			}
+			wait_ms(2);
+		}
+		say("speaker: the amplifier %s: status %#06x\n", a->where, status);
+		if ((status & SYSST_FAULTS) != 0 || (status & SYSST_CHECK) != SYSST_CHECK) {
+			power_down_now((status & SYSST_FAULTS) ? "an amplifier reports a fault" : "an amplifier's status is not as "
+			    "the driver wants it");
+			return false;
+		}
+		if (!put(a, AW_I2SCTRL3, a->i2sctrl3) ||        /* the feedback on, as the profile has it */
+		    !sysctrl(a, SYSCTRL_ULS_HMUTE, false) || !sysctrl(a, SYSCTRL_HMUTE, false)) {
+			return false;
+		}
+		if (!get(a, AW_SYSINT, &interrupts) || !get(a, AW_SYSINT, &interrupts) || !put(a, AW_SYSINTM, SYSINTM_DEFAULT)) {
+			power_down_now("the interrupts could not be read");
+			return false;
+		}
+		if (faulty(a, &status)) {
+			say("speaker: the amplifier %s: status %#06x\n", a->where, status);
+			power_down_now("an amplifier reports a fault");
+			return false;
+		}
+		say("speaker: THE AMPLIFIER %s RUNS, unmuted at the lowest volume (status %#06x)\n", a->where, status);
+	}
+	return true;
+}
+
+bool
+redwood_speaker_volume(uint32_t below, uint32_t step_ms)
+{
+	uint16_t status;
+
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		uint32_t target = a->volume_at + below;
+
+		if (broken || !a->started) {
+			return false;
+		}
+		if (target > VOLUME_LOWEST) {
+			target = VOLUME_LOWEST;
+		}
+		say("speaker: the amplifier %s: the volume to -%u.%03u dB (Android's level less %u.%03u dB), 6 dB a step every %u ms\n",
+		    a->where, target / 8, target % 8 * 125, (target - a->volume_at) / 8, (target - a->volume_at) % 8 * 125, step_ms);
+	}
+	/* both together, a step every step_ms, the status looked at after every step */
+	for (;;) {
+		bool moved = false;
+
+		for (unsigned i = 0; i < 2; i++) {
+			struct amplifier *a = &amplifiers[i];
+			uint32_t target = a->volume_at + below, next;
+
+			if (target > VOLUME_LOWEST) {
+				target = VOLUME_LOWEST;
+			}
+			if (a->volume == target) {
+				continue;
+			}
+			next = a->volume > target ? (a->volume - target > VOLUME_STEP ? a->volume - VOLUME_STEP : target) :
+			    (target - a->volume > VOLUME_STEP ? a->volume + VOLUME_STEP : target);
+			if (!set_volume(a, (uint16_t)next)) {
+				return false;
+			}
+			/* (a slow fade looks at the status after every step, a quick one once it is over) */
+			if (step_ms >= 10 && faulty(a, &status)) {
+				say("speaker: the amplifier %s: status %#06x\n", a->where, status);
+				power_down_now("an amplifier reports a fault");
+				return false;
+			}
+			moved = true;
+		}
+		if (!moved) {
+			break;
+		}
+		if (step_ms) {
+			wait_ms(step_ms);
+		}
+	}
+	return redwood_speaker_healthy();
+}
+
+bool
+redwood_speaker_healthy(void)
+{
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		uint16_t status;
+
+		if (broken) {
+			return false;
+		}
+		if (!a->started) {
+			continue;
+		}
+		if (faulty(a, &status)) {
+			say("speaker: the amplifier %s: status %#06x\n", a->where, status);
+			power_down_now("an amplifier reports a fault");
+			return false;
+		}
+	}
+	return true;
+}
+
+/* the row of a monitor table that a value falls in; between rows, the one before */
+static int
+monitor_row(const struct amplifier *a, bool temperature, int value, int before)
+{
+	unsigned count = temperature ? a->temp_count : a->vbat_count;
+
+	for (unsigned i = 0; i < count; i++) {
+		int min = temperature ? a->temp_rows[i].min : a->vbat_rows[i].min;
+		int max = temperature ? a->temp_rows[i].max : a->vbat_rows[i].max;
+
+		if (value >= min && value <= max) {
+			return (int)i;
+		}
+	}
+	return before;
+}
+
+/*
+ * The driver's monitor, once: the temperature and the battery voltage of every amplifier that runs (the average of
+ * the last three looks, as the file's count says), and the reduction their tables ask for, the larger of the two
+ * amplifiers'. With `tell', what was read (also the boosted supply and the current and voltage sense, raw).
+ */
+uint32_t
+redwood_speaker_monitor(bool tell)
+{
+	uint32_t wanted = 0;
+
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+		uint16_t vbat = 0, temp = 0, pvdd = 0, isn = 0, vsn = 0;
+		int t = 0, v = 0;
+		uint32_t less = 0;
+
+		if (broken || !a->started) {
+			continue;
+		}
+		if (!get(a, AW_VBAT, &vbat) || !get(a, AW_TEMP, &temp)) {
+			continue;
+		}
+		a->temps[a->looks % 3] = (temp & 0x200) ? (int)(temp & 0x3ff) - 0x400 : (int)(temp & 0x3ff);
+		a->vbats[a->looks % 3] = (int)(vbat & 0x3ff) * 6025 / 1023;
+		a->looks++;
+		for (unsigned k = 0; k < 3 && k < a->looks; k++) {
+			t += a->temps[k];
+			v += a->vbats[k];
+		}
+		t /= (int)(a->looks < 3 ? a->looks : 3);
+		v /= (int)(a->looks < 3 ? a->looks : 3);
+		a->temp_row = monitor_row(a, true, t, a->temp_row);
+		a->vbat_row = monitor_row(a, false, v, a->vbat_row);
+		less = (a->temp_row >= 0 ? a->temp_rows[a->temp_row].less : 0) + (a->vbat_row >= 0 ? a->vbat_rows[a->vbat_row].less : 0);
+		if (less > wanted) {
+			wanted = less;
+		}
+		if (tell) {
+			(void)get(a, AW_PVDD, &pvdd);
+			(void)get(a, AW_ISNDAT, &isn);
+			(void)get(a, AW_VSNDAT, &vsn);
+			say("speaker: the amplifier %s: %d degrees, the battery %d mV (%#05x, %#05x; supply %#05x, sense %#06x %#06x): "
+			    "%u.%03u dB less\n", a->where, t, v, temp, vbat, pvdd, isn, vsn, less / 8, less % 8 * 125);
+		}
+	}
+	return wanted;
+}
+
+void
+redwood_speaker_stop(void)
+{
+	if (broken) {
+		return;                 /* (already powered down) */
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		struct amplifier *a = &amplifiers[i];
+
+		if (!a->started) {
+			continue;
+		}
+		say("speaker: the amplifier %s is stopped as Android's driver stops it\n", a->where);
+		if (!sysctrl(a, SYSCTRL_ULS_HMUTE, true)) {
+			return;
+		}
+		while (a->volume < VOLUME_LOWEST) {
+			if (!set_volume(a, (uint16_t)(a->volume + VOLUME_STEP > VOLUME_LOWEST ? VOLUME_LOWEST : a->volume +
+			    VOLUME_STEP))) {
+				return;
+			}
+			wait_ms(1);
+		}
+		if (!sysctrl(a, SYSCTRL_HMUTE, true) || !put(a, AW_I2SCTRL3, (uint16_t)(a->i2sctrl3 & ~I2SCTRL3_TXEN))) {
+			return;
+		}
+		wait_ms(1);
+		if (!sysctrl(a, SYSCTRL_AMPPD, true) || !sysctrl(a, SYSCTRL_PWDN, true)) {
+			return;
+		}
+		a->started = false;
+		say("speaker: THE AMPLIFIER %s IS POWERED DOWN\n", a->where);
+	}
+}
+
+void
+redwood_speaker_quiesce(void)
+{
+	bool any = false;
+
+	for (unsigned i = 0; i < 2; i++) {
+		any |= amplifiers[i].started;
+	}
+	if (!any || tlmm == 0) {
+		return;
+	}
+	leaving = true;
+	power_down_now("the kernel is on its way out");
+}
+
+/* ---- speaker_probe=N: a look ------------------------------------------------------------------------ */
+
+static void
+show_amplifiers(void)
+{
+	/* the chip ID, then registers that every chip of the family has at the same place and that reading does not change */
+	static const struct {
+		uint8_t reg;
+		const char *name;
+	} more[] = { { 0x01, "status" }, { 0x04, "system control" }, { 0x06, "I2S control" } };
+
+	for (unsigned i = 0; i < 2; i++) {
+		uint16_t id = 0, value = 0;
+
+		if (!register_read(amplifiers[i].address, AW_ID, &id)) {
+			say("speaker: nobody at I2C address %#x: not powered, or not there\n", amplifiers[i].address);
+			continue;
+		}
+		say("speaker: the amplifier %s is there: chip ID %#06x, %s\n", amplifiers[i].where, id, amplifier_name(id));
+		for (unsigned r = 0; r < sizeof(more) / sizeof(more[0]); r++) {
+			if (register_read(amplifiers[i].address, more[r].reg, &value)) {
+				say("speaker:   register %#04x (%s) = %#06x\n", more[r].reg, more[r].name, value);
+			}
+		}
+	}
+}
+
+/* ---- power names of the audio subsystem ------------------------------------------------------------- */
+
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x60000UL
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+/* The RPMh address of a resource by its name in the command database the boot loader left; 0 = none. */
+static uint32_t
+rpmh_address(const char *name)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static void
+show_power(void)
+{
+	/* the subsystem's two supplies and, for the DSP, the processor's own two and the crystal */
+	static const char *const supplies[] = { "lcx.lvl", "lmx.lvl", "cx.lvl", "mx.lvl", "xo.lvl" };
+
+	for (unsigned i = 0; i < sizeof(supplies) / sizeof(supplies[0]); i++) {
+		uint32_t address = rpmh_address(supplies[i]);
+
+		if (address) {
+			say("speaker: supply \"%s\" can be asked for at RPMh address %#x\n", supplies[i], address);
+		} else {
+			say("speaker: no supply \"%s\" in the command database\n", supplies[i]);
+		}
+	}
+	/*
+	 * (The audio subsystem's bus clock, GCC_CFG_NOC_LPASS_CBCR, is not read: on the phone that read
+	 * stops the kernel with a synchronous external abort -- the register is not the main processors'
+	 * to read while the audio subsystem belongs to its DSP.)
+	 */
+}
+
+static void
+probe_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	if (tlmm == 0) {
+		tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	}
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	cmd_db = ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);      /* memory, not registers: no alignment rules */
+	say("speaker: a look at the phone's sound hardware (level %u; nothing is switched on)\n", probe_level);
+	show_pins();
+	show_power();
+	if (probe_level >= 2) {
+		show_amplifiers();
+	}
+	say("speaker: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+redwood_speaker_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("speaker_probe", &probe_level, sizeof(probe_level)) || probe_level == 0) {
+		return;
+	}
+	if (kernel_thread_start(probe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/redwood_sta.c b/bsd/dev/redwood_sta.c
new file mode 100644
index 0000000000000000000000000000000000000000..f4e049005ead2aa7473d89b6278a69f52729ba60
--- /dev/null
+++ b/bsd/dev/redwood_sta.c
@@ -0,0 +1,371 @@
+/*
+ * Darwin-on-redwood: what stands between the two sides of the station boundary
+ * (sys/redwood_sta.h).
+ *
+ * Whoever wants a network asks from wherever it happens to be: an ioctl of wifid's, the thread
+ * that brings the radio up. The station side wants to be called by one thread, one call at a
+ * time, and a scan or a join takes seconds. So what is asked for is noted here and done by a
+ * thread of this file's; the asker returns at once and hears the outcome as an event. One
+ * request of each kind can wait: a second scan asked for while the first has not begun
+ * replaces it, as does a second join.
+ *
+ * What the last scan heard is kept here, so that it can be read without entering the station
+ * side, and so is the list of channels.
+ *
+ * The network the kernel was given in a file is a standing request: joined at the start, and
+ * again whenever the radio is turned back on (Settings' switch), until somebody asks for
+ * another network -- as iOS itself rejoins the networks it knows. If that other network cannot
+ * be joined (a wrong passphrase), the standing one is joined again.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/redwood_input.h>
+#include <sys/redwood_sta.h>
+#include <sys/systm.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define HEARD_MOST      128
+#define CHANNELS_MOST   96
+
+static LCK_GRP_DECLARE(sta_lock_group, "redwood-sta");
+static LCK_MTX_DECLARE(sta_lock, &sta_lock_group);
+
+static const struct redwood_sta_ops *sta_ops;   /* the station side, while there is one */
+static bool sta_thread_made;
+static bool sta_calls;                          /* the thread is in a call of the station side's */
+static unsigned sta_reads;                      /* ... and so many others are in its state() */
+static bool sta_on;                             /* the radio's power, as last asked for */
+
+/* what has been asked for and not begun */
+static bool asked_power, asked_power_on, asked_scan, asked_join, asked_leave;
+static struct redwood_sta_scan asked_scan_what;
+static struct redwood_sta_join asked_join_what;
+static struct redwood_sta_join standing;        /* the network joined whenever the radio comes on (ssid_length 0: none) */
+static struct redwood_sta_join fallback;        /* ... as it was before a join that has not come through yet */
+
+static struct redwood_sta_bss *heard;           /* by the last scan that came to an end */
+static unsigned heard_count;
+static struct redwood_sta_channel channels[CHANNELS_MOST];
+static unsigned channel_count;
+
+static void
+heard_one(const struct redwood_sta_bss *bss, __unused void *context)
+{
+	/* (only the thread writes the list, and it reads the count without the lock) */
+	if (heard_count < HEARD_MOST) {
+		lck_mtx_lock(&sta_lock);
+		heard[heard_count++] = *bss;
+		lck_mtx_unlock(&sta_lock);
+	}
+}
+
+static void
+sta_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct redwood_sta_scan scan;
+	static struct redwood_sta_join join;
+
+	for (;;) {
+		const struct redwood_sta_ops *ops;
+		bool power = false, power_on = false, leave = false, do_join = false, do_scan = false;
+		int error = 0;
+
+		lck_mtx_lock(&sta_lock);
+		while (sta_ops == NULL || !(asked_power || asked_leave || asked_join || asked_scan)) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_ops, THREAD_UNINT);
+		}
+		ops = sta_ops;
+		/* one thing at a time, in the order that makes sense when several wait */
+		if (asked_power) {
+			power = true;
+			power_on = asked_power_on;
+			asked_power = false;
+		} else if (asked_leave) {
+			leave = true;
+			asked_leave = false;
+		} else if (asked_join) {
+			do_join = true;
+			join = asked_join_what;
+			bzero(&asked_join_what, sizeof(asked_join_what));
+			asked_join = false;
+		} else {
+			do_scan = true;
+			scan = asked_scan_what;
+			asked_scan = false;
+		}
+		sta_calls = true;
+		lck_mtx_unlock(&sta_lock);
+
+		if (power) {
+			struct redwood_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+			bool was_joined = false;
+
+			if (state != NULL) {
+				ops->state(state);
+				was_joined = state->phase == REDWOOD_STA_JOINED;
+				kfree_data(state, sizeof(*state));
+			}
+			error = ops->power(power_on);
+			if (!power_on && was_joined) {
+				redwood_apple80211_event(REDWOOD_STA_LINK, 0);
+			}
+			redwood_apple80211_event(REDWOOD_STA_POWER, error == 0 ? power_on : !power_on);
+			lck_mtx_lock(&sta_lock);
+			if (error == 0 && power_on && standing.ssid_length != 0 && !asked_join) {
+				asked_join_what = standing;
+				asked_join = true;
+			}
+			lck_mtx_unlock(&sta_lock);
+		} else if (leave) {
+			ops->leave();
+			redwood_apple80211_event(REDWOOD_STA_LINK, 0);
+		} else if (do_join) {
+			error = ops->join(&join);
+			bzero(&join, sizeof(join));
+			redwood_apple80211_event(REDWOOD_STA_JOIN_DONE, error);
+			if (error == 0) {
+				redwood_apple80211_event(REDWOOD_STA_LINK, 1);
+			}
+			/* a join that did not come through (a wrong passphrase) leaves things as they were: the standing network again */
+			lck_mtx_lock(&sta_lock);
+			if (error != 0 && fallback.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+				standing = asked_join_what = fallback;
+				asked_join = true;
+			}
+			bzero(&fallback, sizeof(fallback));
+			lck_mtx_unlock(&sta_lock);
+		} else if (do_scan) {
+			error = ops->scan(&scan);
+			lck_mtx_lock(&sta_lock);
+			heard_count = 0;
+			lck_mtx_unlock(&sta_lock);
+			ops->heard(heard_one, NULL);
+			redwood_apple80211_event(REDWOOD_STA_SCAN_DONE, error);
+		}
+
+		lck_mtx_lock(&sta_lock);
+		sta_calls = false;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+/* ---- the station side ---------------------------------------------------------------------------------- */
+
+void
+redwood_sta_attach(const struct redwood_sta_ops *ops)
+{
+	thread_t thread;
+
+	if (ops == NULL) {
+		lck_mtx_lock(&sta_lock);
+		sta_ops = NULL;
+		asked_power = asked_scan = asked_join = asked_leave = false;
+		while (sta_calls || sta_reads != 0) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+		}
+		heard_count = channel_count = 0;
+		lck_mtx_unlock(&sta_lock);
+		return;
+	}
+	if (heard == NULL) {
+		heard = kalloc_data(HEARD_MOST * sizeof(*heard), Z_WAITOK | Z_ZERO);
+	}
+	if (heard == NULL) {
+		redwood_wifi_tell("wifi: no memory for what a scan hears: nobody can ask the radio for a network\n");
+		return;
+	}
+	if (!sta_thread_made) {
+		if (kernel_thread_start(sta_runs, NULL, &thread) != KERN_SUCCESS) {
+			redwood_wifi_tell("wifi: no thread for the station: nobody can ask the radio for a network\n");
+			return;
+		}
+		thread_set_thread_name(thread, "wifi-station");
+		thread_deallocate(thread);
+		sta_thread_made = true;
+	}
+	channel_count = ops->channels(channels, CHANNELS_MOST);
+	lck_mtx_lock(&sta_lock);
+	sta_ops = ops;
+	sta_on = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	redwood_apple80211_event(REDWOOD_STA_POWER, 1);
+}
+
+void
+redwood_sta_lost(int error)
+{
+	redwood_apple80211_event(REDWOOD_STA_LINK, error != 0 ? error : ECONNRESET);
+}
+
+/* ---- who wants a network ------------------------------------------------------------------------------- */
+
+bool
+redwood_sta_present(void)
+{
+	return sta_ops != NULL;
+}
+
+bool
+redwood_sta_powered(void)
+{
+	return sta_ops != NULL && sta_on;
+}
+
+bool
+redwood_sta_busy(void)
+{
+	bool busy;
+
+	lck_mtx_lock(&sta_lock);
+	busy = sta_ops != NULL && (sta_calls || asked_power || asked_leave || asked_join || asked_scan);
+	lck_mtx_unlock(&sta_lock);
+	return busy;
+}
+
+int
+redwood_sta_ask_power(bool on)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	sta_on = on;
+	asked_power = true;
+	asked_power_on = on;
+	if (!on) {
+		asked_scan = asked_join = asked_leave = false;
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+redwood_sta_ask_scan(const struct redwood_sta_scan *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	asked_scan_what = *what;
+	asked_scan = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+redwood_sta_ask_join_standing(const struct redwood_sta_join *what)
+{
+	int error = redwood_sta_ask_join(what);
+
+	lck_mtx_lock(&sta_lock);
+	if (error == 0) {
+		standing = *what;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return error;
+}
+
+int
+redwood_sta_ask_join(const struct redwood_sta_join *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	if (standing.ssid_length != 0) {
+		fallback = standing;
+	}
+	bzero(&standing, sizeof(standing));     /* (whoever asks for a network now has the say) */
+	asked_join_what = *what;
+	asked_join = true;
+	asked_leave = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+redwood_sta_ask_leave(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	asked_leave = true;
+	asked_join = false;
+	bzero(&asked_join_what, sizeof(asked_join_what));
+	bzero(&fallback, sizeof(fallback));
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+bool
+redwood_sta_heard(unsigned index, struct redwood_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&sta_lock);
+	if ((there = index < heard_count)) {
+		*bss = heard[index];
+	}
+	lck_mtx_unlock(&sta_lock);
+	return there;
+}
+
+void
+redwood_sta_state(struct redwood_sta_state *state)
+{
+	const struct redwood_sta_ops *ops;
+
+	bzero(state, sizeof(*state));
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	if (ops != NULL) {
+		ops->state(state);
+		lck_mtx_lock(&sta_lock);
+		sta_reads--;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+unsigned
+redwood_sta_channels(struct redwood_sta_channel *out, unsigned most)
+{
+	unsigned count;
+
+	lck_mtx_lock(&sta_lock);
+	count = channel_count < most ? channel_count : most;
+	memcpy(out, channels, count * sizeof(*out));
+	lck_mtx_unlock(&sta_lock);
+	return count;
+}
+
+bool
+redwood_sta_address(uint8_t *address)
+{
+	const struct redwood_sta_ops *ops = sta_ops;
+
+	if (ops != NULL) {
+		memcpy(address, ops->address, 6);
+	}
+	return ops != NULL;
+}
diff --git a/bsd/dev/redwood_torch.c b/bsd/dev/redwood_torch.c
new file mode 100644
index 0000000000000000000000000000000000000000..3a9f95fc45774957690233923640815b37144143
--- /dev/null
+++ b/bsd/dev/redwood_torch.c
@@ -0,0 +1,769 @@
+/*
+ * The flashlight of the POCO X5 Pro (redwood): the flash LED module of the PM8350C (SPMI slave 2,
+ * registers 0xee00; "qcom,pm8350c-flash-led", four channels), the rear flash LED on its channel 0.
+ * Every address and number below belongs to this phone, from Android's own device tree, Xiaomi's
+ * driver for it (drivers/leds/leds-qti-flash.c of the phone's kernel, MiCode redwood-s-oss) and
+ * what Android does when its own flashlight is switched on (its LED class devices read, nothing
+ * written by us):
+ *
+ *   Android's torch    led:torch_0 at 125 mA through led:switch_0 (channel 0 alone), current
+ *                      resolution 12.5 mA ("qcom,ires-ua" 12500): IRESOLUTION bit 0 clear, ITARGET
+ *                      code round(125 / 12.5) - 1 = 9; the module enabled (0x46 = 0x80), then the
+ *                      channel (0x4e bit 0). Off in the reverse order, ITARGET back to 0. The
+ *                      torch has no safety timer (its bit is kept clear, as the driver keeps it)
+ *   at Android's probe channel 0's strobe is the software's (0x4a: bits 6:4 and 2 clear) and its
+ *                      safety timer off (0x3e bit 7 clear)
+ *
+ * Writing to a PMIC is not like writing anywhere else: the PMICs make the phone's supplies. So
+ * every write goes through one function that takes only this module's registers above (the
+ * peripheral the arbiter's channel is checked to be, the registers by a list), every write is
+ * read back, and any surprise ends all writing for the run. Transfers through the arbiter are made
+ * one at a time with the buttons' driver (redwood_spmi_lock()): two at once, and it drops one.
+ *
+ * What iOS's flashlight is on this machine: the loader says the camera has a flash (with torch=N,
+ * /product/camera "flash": MobileGestalt's camera-flash, Control Center's flashlight button), and
+ * libredwood-media.dylib in mediaserverd hands FigFlashlight, which finds no camera here, a device
+ * of ours whose torch level is written to /dev/redwood-torch (userland/src/inject_media.c).
+ *
+ * Nothing here is done unless a boot-arg asks for it:
+ *
+ *   torch=1    a look, reading only: the arbiter's channel for the module and who may write
+ *              through it, the module's type, its registers, the PMIC's temperature alarm
+ *   torch=2    ... and the light on once at Android's torch current for torch_secs (default 2),
+ *              then off, every write read back
+ *   torch=3    ... no light at the start; the light for iOS until the run ends: /dev/redwood-torch
+ *              takes a level of 0 to 1000 (a 32-bit number; thousandths of Android's current, 0
+ *              off) and the module is set to it -- never above Android's 125 mA; a read gives
+ *              what is lit now
+ *
+ * Limits, whatever asks: Android's current at most; the light on for torch_max_s at a time at most
+ * (default 30, never more than 120), after which it stays off until it is asked for anew (0, then
+ * more); while it is on, ten times a second, the module's fault and over-temperature flags, the
+ * PMIC's temperature alarm and the battery's temperature (at most 45 C; from the audio DSP's battery
+ * manager with adsp=1, or the firmware's with battery=1; with neither the other two guard): any of
+ * them, a read that fails or a write that does not read back, and the light goes off and stays off
+ * for the rest of the run. At the run's end (and on a panic's way out) it goes off.
+ *
+ * Register layouts: Linux drivers/spmi/spmi-pmic-arb.c (arbiter version 5: a system's write
+ * channel for a peripheral is 0x10000 bytes of "chnls" per channel), Xiaomi's leds-qti-flash.c,
+ * drivers/thermal/qcom/qcom-spmi-temp-alarm.c.
+ */
+/*
+ * macOS: the kernel is prelinked into Apple's collection, whose __TEXT has no room for this
+ * iPadOS-only driver; gated here so the iOS build is byte-for-byte what it was.
+ */
+#if !defined(XNU_TARGET_OS_OSX)
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/redwood_audio.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static uint32_t level;
+static bool broken, leaving;
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+/* every line to the loader's log as well (and to the console when that may be written) */
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	}
+	return length;
+}
+
+/*
+ * The events that matter (lit, off, cut, trouble) are also kept, and said again at the run's end:
+ * the log of a long run keeps its beginning and its end, and these happen in between.
+ */
+#define NOTES                   24
+static char notes[NOTES][200];
+static unsigned noted;
+
+static void note(const char *format, ...) __printflike(1, 2);
+
+static void
+note(const char *format, ...)
+{
+	char *slot = notes[noted++ % NOTES];
+	uint64_t ns;
+	va_list list;
+	int n;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	n = snprintf(slot, sizeof(notes[0]), "%llu.%03llu s: ", ns / NSEC_PER_SEC, ns / NSEC_PER_MSEC % 1000);
+	va_start(list, format);
+	vsnprintf(slot + n, sizeof(notes[0]) - (size_t)n, format, list);
+	va_end(list);
+	say("torch: %s\n", slot);
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- the PMIC arbiter (version 5) ---------------------------------------------------------------- */
+
+#define ARB_CORE_PHYS           0x0c440000UL    /* the version, and which peripheral each channel is */
+#define ARB_CORE_SIZE           0x1100UL
+#define ARB_CNFG_PHYS           0x0c40a000UL    /* which system may write through each channel */
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_OBSERVER_PHYS       0x0e600000UL    /* reads: 0x80 per channel for our system (the first) */
+#define ARB_OBSERVER_SIZE       0x10000UL
+#define ARB_CHNLS_PHYS          0x0c600000UL    /* writes: 0x10000 per channel */
+#define ARB_SYSTEM              0               /* who we are to the arbiter: the device tree's "qcom,ee" */
+
+#define ARB_VERSION             0x000
+#define ARB_VERSION_5           0x50000000u
+#define ARB_VERSION_7           0x70000000u
+#define ARB_FEATURES            0x004
+#define ARB_CHANNEL(n)          (0x900 + 4 * (n))       /* [19:8] slave and peripheral */
+#define ARB_OWNER(n)            (0x700 + 4 * (n))       /* [2:0] the system that may write through channel n */
+#define ARB_MAX_CHANNELS        512
+
+#define CHANNEL_COMMAND         0x00
+#define CHANNEL_STATUS          0x08
+#define CHANNEL_WDATA0          0x10
+#define OBSERVER_DATA0          0x18
+#define OBSERVER_DATA1          0x1c
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define COMMAND_WRITE           (0u << 27)      /* "extended register write long"; [11:4] register, [2:0] bytes - 1 */
+#define COMMAND_READ            (1u << 27)      /* "extended register read long" */
+#define TRANSFER_TIMEOUT_US     2000
+#define DROPPED                 "the transfer was dropped"
+
+struct peripheral {
+	const char *    name;
+	uint16_t        id;             /* slave << 8 | peripheral */
+	uint16_t        channel;
+	bool            found, writable;
+	vm_offset_t     write;          /* its write channel, mapped (only the flash module's) */
+};
+static struct peripheral flash = { .name = "the PM8350C's flash LED module", .id = 0x2ee };
+static struct peripheral alarm = { .name = "the PM8350C's temperature alarm", .id = 0x20a };
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer;
+static uint8_t alarm_subtype;
+
+/* (the arbiter one transfer at a time with the buttons' driver; at the run's end the others are stopped, perhaps holding it) */
+static void
+lock(void)
+{
+	if (!leaving) {
+		redwood_spmi_lock();
+	}
+}
+
+static void
+unlock(void)
+{
+	if (!leaving) {
+		redwood_spmi_unlock();
+	}
+}
+
+static const char *
+wait_done(vm_offset_t channel)
+{
+	uint64_t start = mach_absolute_time(), interval;
+	uint32_t status;
+
+	nanoseconds_to_absolutetime(TRANSFER_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	do {
+		status = rd(channel + CHANNEL_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	return !(status & STATUS_DONE) ? "no answer from the arbiter" : (status & STATUS_DENIED) ? "the arbiter refuses" :
+	       (status & STATUS_FAILURE) ? "the transfer failed" : (status & STATUS_DROPPED) ? DROPPED : NULL;
+}
+
+/*
+ * `count' (1 to 8) registers from `reg' on; NULL, or what went wrong. A transfer the arbiter drops
+ * now and then (the buttons' driver sees one in a thousand or so, from whatever else is on the bus)
+ * is asked for again, twice at most.
+ */
+static const char *spmi_read_once(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count);
+
+static const char *
+spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	const char *problem = NULL;
+
+	for (int tries = 0; tries < 3; tries++) {
+		if ((problem = spmi_read_once(p, reg, bytes, count)) == NULL || strcmp(problem, DROPPED) != 0) {
+			break;
+		}
+	}
+	return problem;
+}
+
+static const char *
+spmi_read_once(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t channel = arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	const char *problem;
+	uint32_t data[2];
+
+	if (!p->found) {
+		return "no channel";
+	}
+	lock();
+	wr(channel + CHANNEL_COMMAND, COMMAND_READ | (uint32_t)reg << 4 | (count - 1));
+	problem = wait_done(channel);
+	data[0] = rd(channel + OBSERVER_DATA0);
+	data[1] = count > 4 ? rd(channel + OBSERVER_DATA1) : 0;
+	unlock();
+	if (problem != NULL) {
+		return problem;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		bytes[i] = (uint8_t)(data[i / 4] >> (8 * (i % 4)));
+	}
+	return NULL;
+}
+
+/* ---- the flash LED module -------------------------------------------------------------------------- */
+
+#define FLASH_REVISION1         0x00
+#define FLASH_TYPE              0x04            /* 0x18: a flash LED module */
+#define FLASH_SUBTYPE           0x05            /* 0x07: four channels */
+#define FLASH_STATUS1           0x06            /* a channel open or shorted */
+#define FLASH_STATUS2           0x07
+#define  STATUS2_OTST1          0x20            /* over-temperature, the first and the second threshold */
+#define  STATUS2_OTST2          0x10
+#define  STATUS2_VPH_LOW        0x01            /* the supply drooped */
+#define FLASH_INT_RT_STS        0x10
+#define  RT_STS_FAULT           0x01            /* open, short, or its supply not ready */
+#define FLASH_SAFETY_TIMER0     0x3e            /* [7] on */
+#define FLASH_ITARGET0          0x42            /* [6:0]: (code + 1) x the resolution */
+#define FLASH_MODULE_EN         0x46            /* [7] */
+#define FLASH_IRESOLUTION       0x49            /* a bit per channel: 0 12.5 mA, 1 5 mA */
+#define FLASH_STROBE_CTRL0      0x4a            /* [6:4] hardware strobe's kind, [2] hardware strobe */
+#define FLASH_EN_LED_CTRL       0x4e            /* a bit per channel */
+#define FLASH_OTST2_CFG1        0x78
+#define FLASH_OTST1_CFG1        0x7a
+
+#define ALARM_SUBTYPE           0x05            /* 0x08: the first generation, 0x09 the second */
+#define ALARM_STATUS            0x08            /* the over-temperature stage: [1:0] (first generation) or [6:4] */
+
+#define ANDROID_TORCH_MA        125             /* led:torch_0 while Android's flashlight is on */
+#define IRES_UA                 12500           /* its resolution ("qcom,ires-ua") */
+#define ANDROID_ITARGET         9               /* round(125000 / 12500) - 1: the most ever written */
+#define HOTTEST_BATTERY_C       45
+
+static const uint8_t writable_regs[] = {
+	FLASH_SAFETY_TIMER0, FLASH_ITARGET0, FLASH_MODULE_EN, FLASH_IRESOLUTION, FLASH_STROBE_CTRL0, FLASH_EN_LED_CTRL,
+};
+
+static void
+give_up(const char *why)
+{
+	if (!broken) {
+		broken = true;
+		note("%s: no more writing to the flash module for the rest of the run", why);
+	}
+}
+
+/*
+ * One register of the flash module (and of the six above only) written and read back: false, and
+ * no more writing, if it cannot be or does not read back.
+ */
+static bool
+put(uint8_t reg, uint8_t value)
+{
+	const char *problem;
+	uint8_t back = 0xff;
+	bool allowed = false;
+
+	for (size_t i = 0; i < sizeof(writable_regs); i++) {
+		allowed |= writable_regs[i] == reg;
+	}
+	if (broken || !allowed || !flash.writable || flash.write == 0 || flash.id != 0x2ee) {
+		give_up(allowed ? "a write that may not be made" : "a register that is not to be written");
+		return false;
+	}
+	/* (the channel is still the module's: its entry in the arbiter's table is looked at again) */
+	if (((rd(arb_core + ARB_CHANNEL(flash.channel)) >> 8) & 0xfff) != flash.id) {
+		give_up("the arbiter's channel is no longer the flash module's");
+		return false;
+	}
+	for (int tries = 0; tries < 3; tries++) {
+		lock();
+		wr(flash.write + CHANNEL_WDATA0, value);
+		wr(flash.write + CHANNEL_COMMAND, COMMAND_WRITE | (uint32_t)reg << 4);
+		problem = wait_done(flash.write);
+		unlock();
+		if (problem == NULL || strcmp(problem, DROPPED) != 0) {
+			break;          /* (a dropped write has not been made: asked for again, then read back) */
+		}
+	}
+	if (problem != NULL || (problem = spmi_read(&flash, reg, &back, 1)) != NULL) {
+		say("torch: %#04x <- %#04x: %s\n", reg, value, problem);
+		give_up("a write that failed");
+		return false;
+	}
+	if (back != value) {
+		say("torch: %#04x <- %#04x, but it reads %#04x\n", reg, value, back);
+		give_up("a register that did not read back as written");
+		return false;
+	}
+	return true;
+}
+
+static bool
+get(const struct peripheral *p, uint8_t reg, uint8_t *value)
+{
+	const char *problem = spmi_read(p, reg, value, 1);
+
+	if (problem != NULL) {
+		say("torch: reading %#04x of %s: %s\n", reg, p->name, problem);
+		return false;
+	}
+	return true;
+}
+
+/* only the bits of `mask' changed, as the driver's masked writes do */
+static bool
+put_bits(uint8_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now;
+
+	if (!get(&flash, reg, &now)) {
+		give_up("a read that failed");
+		return false;
+	}
+	return (now & mask) == (value & mask) || put(reg, (uint8_t)((now & ~mask) | (value & mask)));
+}
+
+static void
+find_channel(struct peripheral *p, uint32_t channels)
+{
+	for (uint32_t n = 0; n < channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n)), owner;
+
+		if (map == 0 || ((map >> 8) & 0xfff) != p->id) {
+			continue;
+		}
+		owner = rd(arb_cnfg + ARB_OWNER(n)) & 7;
+		say("torch: channel %u is %s (%#x); written by system %u%s\n", n, p->name, map, owner,
+		    owner == ARB_SYSTEM ? ", which is us" : "");
+		if (!p->found || owner == ARB_SYSTEM) {
+			p->found = true;
+			p->channel = (uint16_t)n;
+			p->writable = owner == ARB_SYSTEM;
+		}
+	}
+	if (!p->found) {
+		say("torch: no channel of the arbiter is %s\n", p->name);
+	}
+}
+
+static void
+show_registers(void)
+{
+	uint8_t r[8];
+	char line[200];
+
+	for (unsigned base = 0; base < 0x100; base += 0x20) {
+		int n = snprintf(line, sizeof(line), "torch: %#04x:", base);
+
+		for (unsigned i = 0; i < 0x20; i += 8) {
+			if (spmi_read(&flash, (uint8_t)(base + i), r, 8) != NULL) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " (unreadable)");
+				continue;
+			}
+			for (unsigned j = 0; j < 8; j++) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " %02x", r[j]);
+			}
+		}
+		say("%s\n", line);
+	}
+}
+
+/* What would make the light go off now, or NULL. */
+static const char *
+trouble(void)
+{
+	static char why[180];
+	uint8_t rt = 0, status1 = 0, status2 = 0, alarm_status = 0, stage;
+
+	if (!get(&flash, FLASH_INT_RT_STS, &rt) || !get(&flash, FLASH_STATUS1, &status1) ||
+	    !get(&flash, FLASH_STATUS2, &status2) || (alarm.found && !get(&alarm, ALARM_STATUS, &alarm_status))) {
+		return "a read of the flags that failed";
+	}
+	stage = alarm_subtype == 0x08 ? alarm_status & 0x03 : (alarm_status >> 4) & 0x07;
+	if ((rt & RT_STS_FAULT) || status1 != 0 || (status2 & (STATUS2_OTST1 | STATUS2_OTST2 | STATUS2_VPH_LOW)) || stage != 0) {
+		uint8_t more[8] = { 0 }, latched[2] = { 0 };
+
+		(void)spmi_read(&flash, 0x06, more, 8);
+		(void)spmi_read(&flash, 0x18, latched, 2);
+		snprintf(why, sizeof(why), "the module says fault %#x, channels %#x, temperature and supply %#x (0x06-0x0d: %02x %02x %02x "
+		    "%02x %02x %02x %02x %02x, latched %#x); the PMIC's temperature stage %u", rt, status1, status2, more[0], more[1],
+		    more[2], more[3], more[4], more[5], more[6], more[7], latched[0], stage);
+		return why;
+	}
+	if (redwood_battery_temperature() >= HOTTEST_BATTERY_C) {
+		snprintf(why, sizeof(why), "the battery is at %d C", redwood_battery_temperature());
+		return why;
+	}
+	return NULL;
+}
+
+static bool configured, lit;
+
+/* Android's probe, once: channel 0 strobed by software, its safety timer off. */
+static bool
+configure(void)
+{
+	if (!configured && put_bits(FLASH_STROBE_CTRL0, 0x74, 0x00) && put_bits(FLASH_SAFETY_TIMER0, 0x80, 0x00)) {
+		configured = true;
+	}
+	return configured;
+}
+
+/* The light at `permille' of Android's current: its writes in its order. */
+static bool
+light(uint32_t permille)
+{
+	uint32_t ua = ANDROID_TORCH_MA * 1000 * permille / 1000, code;
+	const char *why;
+
+	if (ua < IRES_UA) {
+		ua = IRES_UA;           /* (the driver's least: one step) */
+	}
+	code = (ua + IRES_UA / 2) / IRES_UA - 1;
+	if (code > ANDROID_ITARGET) {
+		code = ANDROID_ITARGET;
+	}
+	if (!lit && (why = trouble()) != NULL) {
+		note("not lit: %s", why);
+		give_up("trouble before the light");
+		return false;
+	}
+	if (!configure() || !put_bits(FLASH_IRESOLUTION, 0x01, 0x00) || !put_bits(FLASH_ITARGET0, 0x7f, (uint8_t)code)) {
+		return false;
+	}
+	if (!lit && (!put(FLASH_MODULE_EN, 0x80) || !put_bits(FLASH_EN_LED_CTRL, 0x01, 0x01))) {
+		return false;
+	}
+	lit = true;
+	return true;
+}
+
+/* Off, in Android's order: the channel, the module, the target current, the timer's bit. */
+static bool
+dark(void)
+{
+	bool ok = put_bits(FLASH_EN_LED_CTRL, 0x01, 0x00) && put(FLASH_MODULE_EN, 0x00) && put_bits(FLASH_ITARGET0, 0x7f, 0x00) &&
+	    put_bits(FLASH_SAFETY_TIMER0, 0x80, 0x00);
+
+	lit = !ok && lit;
+	return ok;
+}
+
+/* ---- torch=3: the light for iOS --------------------------------------------------------------------- */
+
+static volatile uint32_t wanted;                /* the level asked for last, 0 to 1000 */
+static volatile uint32_t asked;                 /* how many times one was */
+static uint32_t max_secs = 30;
+
+static int
+torch_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t value;
+	int error;
+
+	while (uio_resid(uio) >= (user_ssize_t)sizeof(value)) {
+		if ((error = uiomove((caddr_t)&value, sizeof(value), uio)) != 0) {
+			return error;
+		}
+		wanted = value > 1000 ? 1000 : value;
+		asked++;
+	}
+	return 0;
+}
+
+/* what is lit now: the level, 0 if nothing */
+static uint32_t shown;
+
+static int
+torch_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t value = shown;
+
+	return uiomove((caddr_t)&value, (int)MIN(sizeof(value), (size_t)uio_resid(uio)), uio);
+}
+
+static int
+torch_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw torch_cdevsw = {
+	.d_open = torch_open, .d_close = torch_open, .d_read = torch_read, .d_write = torch_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static uint64_t
+now_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static void
+serve(void)
+{
+	uint32_t applied = 0, times = 0, cut = 0;
+	uint64_t since = 0, last_look = 0;
+	bool waiting_for_off = false;           /* cut at the limit: dark until iOS asks for 0 */
+	int major = cdevsw_add(-1, &torch_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-torch") == NULL) {
+		say("torch: /dev/redwood-torch cannot be made\n");
+		return;
+	}
+	say("torch: THE LIGHT IS IOS'S (/dev/redwood-torch) from here on, until the run ends: at most Android's %u mA, at most %u s "
+	    "at a time\n", ANDROID_TORCH_MA, max_secs);
+	while (!broken) {
+		uint32_t want = wanted;
+		uint64_t now = now_ms();
+
+		if (want == 0) {
+			waiting_for_off = false;
+		}
+		if (waiting_for_off) {
+			want = 0;
+		}
+		if (want != applied) {
+			if (want == 0 ? dark() : light(want)) {
+				if (applied == 0) {
+					since = now;
+					times++;
+				}
+				if (want == 0) {
+					note("off (iOS asked for 0)");
+				} else {
+					note("ON (iOS asked for %u of 1000; the battery %d C)", wanted, redwood_battery_temperature());
+				}
+				applied = want;
+				shown = want;
+			} else {
+				break;
+			}
+		}
+		if (applied != 0 && now - since >= max_secs * 1000ull) {
+			cut++;
+			note("on for %u s, the limit: off until iOS asks again", max_secs);
+			waiting_for_off = true;
+			if (!dark()) {
+				break;
+			}
+			applied = 0;
+			shown = 0;
+			continue;
+		}
+		if (applied != 0 && now - last_look >= 100) {
+			const char *why;
+
+			last_look = now;
+			if ((why = trouble()) != NULL) {
+				note("OFF: %s", why);
+				(void)dark();
+				give_up("trouble while lit");
+				break;
+			}
+		}
+		wait_ms(20);
+	}
+	if (lit) {
+		(void)dark();
+	}
+	shown = 0;
+	say("torch: the light is given up on (%u times lit, %u cut at %u s)\n", times, cut, max_secs);
+}
+
+/* ---- the start ------------------------------------------------------------------------------------- */
+
+static void
+torch_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t version, channels;
+	uint8_t id[2] = { 0, 0 }, revision = 0, alarm_status = 0;
+
+	say("torch: level %u: %s\n", level, level == 1 ? "a look, reading only" : level == 2 ? "the light on once" :
+	    "the light for iOS");
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_OBSERVER_SIZE);
+	version = rd(arb_core + ARB_VERSION);
+	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
+	if (version < ARB_VERSION_5 || version >= ARB_VERSION_7) {
+		say("torch: PMIC arbiter version %#x, not 5: nothing done\n", version);
+		goto out;
+	}
+	if (channels == 0 || channels > ARB_MAX_CHANNELS) {
+		channels = ARB_MAX_CHANNELS;
+	}
+	find_channel(&flash, channels);
+	find_channel(&alarm, channels);
+	if (!flash.found || spmi_read(&flash, FLASH_TYPE, id, 2) != NULL || spmi_read(&flash, FLASH_REVISION1, &revision, 1) != NULL) {
+		say("torch: the flash module cannot be read\n");
+		goto out;
+	}
+	say("torch: the module says type %#x, subtype %#x, revision %#x%s\n", id[0], id[1], revision,
+	    id[0] == 0x18 && id[1] == 0x07 ? ": a flash LED module of four channels, as Android's driver expects" : ": NOT WHAT WAS EXPECTED");
+	show_registers();
+	if (alarm.found && get(&alarm, ALARM_SUBTYPE, &alarm_subtype) && get(&alarm, ALARM_STATUS, &alarm_status)) {
+		uint8_t stage = alarm_subtype == 0x08 ? alarm_status & 0x03 : (alarm_status >> 4) & 0x07;
+
+		say("torch: the PMIC's temperature alarm (subtype %#x) says %#x: stage %u%s\n", alarm_subtype, alarm_status, stage,
+		    stage == 0 ? " (all is well)" : "");
+	} else {
+		alarm.found = false;
+	}
+	if (id[0] != 0x18 || id[1] != 0x07 || level < 2) {
+		goto out;
+	}
+	if (!flash.writable) {
+		say("torch: the channel is not ours to write through: nothing written\n");
+		goto out;
+	}
+	flash.write = ml_io_map(ARB_CHNLS_PHYS + 0x10000UL * flash.channel, 0x1000);
+	PE_parse_boot_argn("torch_max_s", &max_secs, sizeof(max_secs));
+	max_secs = max_secs < 1 ? 1 : max_secs > 120 ? 120 : max_secs;
+	if (level == 2) {
+		uint32_t secs = 2;
+		uint64_t until;
+		const char *why = NULL;
+
+		PE_parse_boot_argn("torch_secs", &secs, sizeof(secs));
+		secs = secs < 1 ? 1 : secs > max_secs ? max_secs : secs;
+		say("torch: the light ON at Android's %u mA (ITARGET %u, 12.5 mA steps) for %u s\n", ANDROID_TORCH_MA, ANDROID_ITARGET,
+		    secs);
+		if (light(1000)) {
+			uint8_t rt = 0, s1 = 0, s2 = 0;
+
+			wait_ms(50);
+			(void)get(&flash, FLASH_INT_RT_STS, &rt);
+			(void)get(&flash, FLASH_STATUS1, &s1);
+			(void)get(&flash, FLASH_STATUS2, &s2);
+			note("lit at Android's %u mA; 50 ms on: interrupt status %#x (%s), channels %#x, temperature and supply %#x",
+			    ANDROID_TORCH_MA, rt, (rt & 0x10) ? "ramped up" : "NOT ramped up", s1, s2);
+			show_registers();
+			for (until = now_ms() + secs * 1000ull; now_ms() < until && (why = trouble()) == NULL;) {
+				wait_ms(100);
+			}
+			if (why != NULL) {
+				note("OFF early: %s", why);
+			}
+			if (dark()) {
+				note("off again after %u s", secs);
+			}
+			show_registers();
+		}
+	} else {
+		serve();
+	}
+out:
+	say("torch: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+redwood_torch_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("torch", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 3 ? 3 : level;
+	if (kernel_thread_start(torch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* At the run's end and on a panic's way out: the light off, if it was ever lit. */
+void
+redwood_torch_quiesce(void)
+{
+	uint8_t module = 0xff, channels = 0xff, target = 0xff;
+
+	if (level < 2 || flash.write == 0) {
+		return;
+	}
+	leaving = true;
+	if (lit) {
+		broken = false;         /* (one last time, whatever went before) */
+		say("torch: at the run's end: the light %s\n", dark() ? "switched off" : "COULD NOT BE SWITCHED OFF");
+	}
+	say("torch: what happened in this run (%u events):\n", noted);
+	for (unsigned i = noted > NOTES ? noted - NOTES : 0; i < noted; i++) {
+		say("torch:   %s\n", notes[i % NOTES]);
+	}
+	(void)spmi_read(&flash, FLASH_MODULE_EN, &module, 1);
+	(void)spmi_read(&flash, FLASH_EN_LED_CTRL, &channels, 1);
+	(void)spmi_read(&flash, FLASH_ITARGET0, &target, 1);
+	say("torch: at the run's end the module reads: enable %#04x, channels %#04x, target %#04x%s\n", module, channels, target,
+	    module == 0 && (channels & 0x01) == 0 && target == 0 ? " (dark)" : " (NOT DARK)");
+}
+#endif /* !defined(XNU_TARGET_OS_OSX) */
diff --git a/bsd/dev/redwood_ufs.c b/bsd/dev/redwood_ufs.c
new file mode 100644
index 0000000000000000000000000000000000000000..57c43ae89fa818cbf00cb6c1c301d5bf43cc69d7
--- /dev/null
+++ b/bsd/dev/redwood_ufs.c
@@ -0,0 +1,1642 @@
+/*
+ * The phone's storage: one block device and one character device for every GPT partition of its
+ * UFS (/dev/ufs_NAME and /dev/rufs_NAME, NAME as the partition table has it). Read only, but for
+ * the one place the data of iOS lives (ufs_write=1, below).
+ *
+ * There is no UFS driver here, and none is needed. UEFI never exits on this port: Qualcomm's own
+ * UFS driver (UFSDxe) has brought up the controller, its PHY, its clocks and power, and stays
+ * resident, and xnuloader keeps serving the kernel from core 0 while the kernel runs on another
+ * core (it already does for the battery). So with ufs=2 on its command line the loader publishes a
+ * page (ufs_shared_pa=) with the table of partitions, a request and an answer, and a buffer; this
+ * driver writes a request -- which partition, which blocks -- and core 0 reads them with that
+ * driver's ReadBlocks into the buffer (xnuloader/loader.c, block_poll). Nothing in this kernel
+ * touches the storage controller.
+ *
+ * Read only wherever a write could do harm, by construction. The block devices never write: the
+ * strategy routine refuses, so no filesystem mounted from one can write, and opening one for
+ * writing is refused. With ufs_write=1 one character device alone takes writes -- /dev/rufs_darwin,
+ * the port's own partition -- and in it only whole blocks from UFS_WRITE_FIRST on, past the iOS
+ * volume and both cryptexes that the build writes from the computer (tools/darwin-write.py); that
+ * is where the data volume of iOS is kept between runs (userland/src/var_store.c). The partition
+ * has to be the one the port was set up with (its name, size, place and logical unit here; its
+ * GUIDs as well on the loader's side), and the loader refuses the same things over again and reads
+ * every write back before it answers. Without ufs_write=1 nothing writes at all.
+ *
+ * One request at a time (the page has one), so requests are serialized by a mutex and split into
+ * pieces of the buffer's size. The kernel writes only the request's cache lines and core 0 only
+ * the answer's (see the loader), both through a mapping that does not cache here, so neither side
+ * ever overwrites the other's. The data buffer, which only core 0's reads fill, is mapped cacheable
+ * and the part of it an answer covers is invalidated here before it is copied out.
+ *
+ * ufs_check=1 reads, once at start, the partitions there are images of in the ROM's
+ * firmware-update/ (bluetooth, xbl, tz, ...) through the same path and prints an FNV-1a hash of
+ * as many bytes as each image has: tools/ufs-survey.py compares those with the images and with
+ * what the loader read itself before the kernel started.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <sys/uio.h>
+#include <sys/redwood_input.h>
+#include <libkern/crc.h>
+#include <vm/memory_types.h>
+#include "redwood_ufshc.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void IOSleep(unsigned int milliseconds);
+extern void loader_return(void);        /* osfmk/arm64/loader_return.c */
+extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);   /* osfmk/arm64/caches_asm.s */
+
+/* the page the loader publishes: the same layout as struct loader_block in xnuloader/loader.c */
+#define BLOCK_MAGIC        0x4b434f4c42574452ULL       /* "RDWBLOCK" */
+#define BLOCK_VERSION      3
+#define BLOCK_MAX_PARTS    160
+#define BLOCK_MAX_UNITS    16
+#define BLOCK_PART_UNIT    1u                          /* a whole logical unit, not a partition */
+#define BLOCK_OP_READ      0u
+#define BLOCK_OP_WRITE     1u
+
+/*
+ * Where a write may go, and nowhere else: darwin, the port's own 20 GiB at the end of logical
+ * unit 0, and in it only past what the build puts there from the computer -- the iOS volume
+ * (blocks 0..1374207) and the two cryptexes behind it (..2042367). The loader keeps the same
+ * bounds and the GUIDs of the partition besides (xnuloader/loader.c, BLOCK_WRITE_FIRST).
+ */
+#define UFS_WRITE_FIRST    2042368ULL                  /* darwin's blocks of 4096 */
+#define UFS_DARWIN_FIRST   25374720ULL                 /* its first LBA on the unit, as the GPT has it */
+#define UFS_DARWIN_BLOCKS  5242875ULL
+
+struct loader_block_part {
+	char name[36];
+	uint32_t block_size;
+	uint64_t blocks;
+	uint64_t start_lba;            /* where it begins on its unit, in the unit's blocks */
+	uint16_t unit;                 /* the unit it is on, its number among the units; 0xffff: not known */
+	uint8_t lun;                   /* a unit's logical unit number as its device path says; 0xff: it does not */
+	uint8_t flags;                 /* BLOCK_PART_UNIT */
+	uint32_t reserved;
+};
+
+struct loader_block {
+	uint64_t magic;
+	uint32_t version, size;
+	uint32_t parts, buffer_size;
+	uint64_t buffer_pa;
+	/*
+	 * Which partition the loader will take writes for this run (its index plus one; 0: none) and
+	 * from which of its blocks. They sit in what was padding, so the page is the size and the
+	 * version it was and one phone goes on being shared: a loader built before writes existed
+	 * leaves them zero, which is no write, and a kernel built before them leaves ask.op zero,
+	 * which is a read.
+	 */
+	uint32_t write_part_plus_one;
+	uint32_t write_reserved;
+	uint64_t write_first;
+	struct {
+		volatile uint32_t request;
+		uint32_t part;
+		uint64_t lba, count;
+		uint32_t op;                   /* BLOCK_OP_READ, BLOCK_OP_WRITE */
+		uint32_t reserved;
+	} ask __attribute__((aligned(128)));
+	struct {
+		volatile uint32_t answered;
+		uint32_t reserved;
+		int64_t status;
+		uint64_t served, failed, bytes, ticks;
+	} answer __attribute__((aligned(128)));
+	struct loader_block_part part[BLOCK_MAX_PARTS] __attribute__((aligned(128)));
+	/* the loader's offer of an area for this kernel's own transfer request list, and UEFI's list */
+	struct {
+		uint64_t hc_pa;
+		uint64_t area_pa;
+		uint32_t area_size, ucd_offset, ucd_size, slots;
+		uint32_t uefi_utrlba, uefi_utrlbau;
+	} native __attribute__((aligned(128)));
+	struct {
+		volatile uint32_t take_back;   /* the loader's: it takes the controller back, send nothing more */
+	} loader_native __attribute__((aligned(128)));
+	struct {
+		volatile uint32_t list_in;     /* this kernel's: its list is in */
+		uint32_t switched_in, switched_out;
+		volatile uint32_t cnr_at_switch;       /* UTRLCNR when its list went in (for the loader's take-back) */
+	} kernel_native __attribute__((aligned(128)));
+};
+
+_Static_assert(__builtin_offsetof(struct loader_block, ask) == 128,
+    "the loader's page must stay the size it was: what is before ask has to fit in its padding");
+
+#define UFS_PAGE           0x4000UL
+#define UFS_TIMEOUT_MS     20000        /* core 0 answers in well under a second; this is for a dead loader */
+
+static volatile struct loader_block *ufs_page;
+static uint8_t *ufs_buffer;             /* the loader's data buffer: filled by it for a read, here for a write */
+static uint32_t ufs_buffer_size, ufs_parts, ufs_seq;
+static volatile bool ufs_closing;      /* the run is ending: nothing more is asked of the loader */
+static uint32_t ufs_bsize[BLOCK_MAX_PARTS];   /* the block size each device is counted in (spec_open sets 512) */
+static int ufs_bmajor = -1, ufs_cmajor = -1;
+static bool ufs_ready, ufs_dead;
+static uint64_t ufs_requests, ufs_errors, ufs_bytes, ufs_wait_us;
+static uint64_t ufs_copy_us;                    /* copying out of the loader's buffer */
+static uint64_t ufs_small, ufs_medium, ufs_large; /* requests of <= 4 KB, <= 64 KB, more */
+static uint64_t ufs_sequential;                 /* requests that start where the one before ended */
+static uint32_t ufs_last_part = ~0u;
+static uint64_t ufs_last_end;
+
+/*
+ * This kernel's own UFS driver (redwood_ufshc.c), with ufs_native=1: each partition's logical
+ * unit and where it begins there, in bytes; reads go that way unless it fails, and then through
+ * the loader again. While its list is in the controller the loader is asked for nothing.
+ */
+static uint8_t ufs_lun[BLOCK_MAX_PARTS];         /* 0xff: not known, read through the loader */
+static uint64_t ufs_lun_offset[BLOCK_MAX_PARTS];
+static bool ufs_native_mapped;
+static uint32_t ufs_native_luns;                /* how many units are mapped (LUN 0..n-1) */
+static volatile bool ufs_native_on;
+static uint64_t ufs_native_fallbacks, ufs_mailbox_refused;
+
+static LCK_GRP_DECLARE(ufs_lck_grp, "redwood-ufs");
+static LCK_MTX_DECLARE(ufs_lock, &ufs_lck_grp);
+/* One writer at a time; never held while the mailbox is, nor while user memory is touched. */
+static LCK_MTX_DECLARE(ufs_write_mtx, &ufs_lck_grp);
+
+/*
+ * Saving the data volume without being asked (userland/src/var_store.c).
+ *
+ * The volume is packed and written by a program, not by this kernel, so the kernel's part is to
+ * say when and to let only one program at a time do it:
+ *
+ *   kern.redwood.var_save   the handshake. The saver writes VAR_SAVE_IDLE when it starts and is
+ *                           then the one that will be asked; on the orderly way back to the loader
+ *                           (loader_return_after expired, or "xl stop") the kernel writes
+ *                           VAR_SAVE_WANTED and waits, and the saver writes VAR_SAVE_DONE when the
+ *                           volume is in the flash. Nobody registered: nothing is asked and
+ *                           nothing waited for, so a run without a saver returns as it always did.
+ *                           A panic does not come this way at all -- there is no program left to
+ *                           ask -- and then the store simply keeps what it had.
+ *   kern.redwood.var_busy   the claim. A write to /dev/rufs_darwin is refused unless the writer
+ *                           holds it, so two savers cannot interleave into one slot. It is held by
+ *                           process number, and a claimant may take it from a process that is gone
+ *                           (a saver killed in the middle leaves no lock behind for the rest of the
+ *                           run). What the one that was killed half-wrote is not lost either: the
+ *                           slot it was writing is not the one holding the newest good archive.
+ */
+#define VAR_SAVE_NONE      0
+#define VAR_SAVE_IDLE      1
+#define VAR_SAVE_WANTED    2
+#define VAR_SAVE_DONE      3
+#define VAR_SAVE_MS        20000        /* at most this long on the way out (var_save_ms=N) */
+
+static volatile int ufs_var_save = VAR_SAVE_NONE;
+static int ufs_var_busy_pid;
+
+/* ufs_write=1 and the one partition it is for: everything else answers EROFS as it always did */
+static int ufs_write_part = -1;
+static volatile bool ufs_write_busy;            /* a write of ours has this kernel's list out: not a failure */
+static bool ufs_write_out, ufs_write_was_native;        /* the list is out for writing, and was in before */
+static uint64_t ufs_writes, ufs_write_bytes, ufs_write_errors, ufs_write_refused;
+
+SYSCTL_DECL(_kern_redwood);
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_requests, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_requests,
+    "requests the phone's storage has answered through the loader");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_errors, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_errors,
+    "requests the phone's storage has refused or not answered");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_bytes,
+    "bytes read from the phone's storage");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_wait_us, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_wait_us,
+    "microseconds spent waiting for core 0's answers");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_copy_us, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_copy_us,
+    "microseconds spent copying out of the loader's buffer");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_writes, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_writes,
+    "requests written into darwin and read back by the loader");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_write_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_write_bytes,
+    "bytes written into darwin");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_write_errors, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_write_errors,
+    "writes the loader refused or did not finish");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_write_refused, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_write_refused,
+    "writes refused here: not darwin, or not past what the build writes");
+
+/* The handshake: 1 to register as the saver, 3 to say the volume is in the flash. 2 is the kernel's. */
+static int
+ufs_sysctl_var_save(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = ufs_var_save, error;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, NULL);
+	if (error != 0 || req->newptr == 0) {
+		return error;
+	}
+	if (value == VAR_SAVE_IDLE && ufs_var_save != VAR_SAVE_WANTED) {
+		ufs_var_save = VAR_SAVE_IDLE;           /* a saver is there; it is the one that will be asked */
+	} else if (value == VAR_SAVE_DONE && ufs_var_save == VAR_SAVE_WANTED) {
+		ufs_var_save = VAR_SAVE_DONE;           /* and it has finished: the way out may go on */
+	} else if (value == VAR_SAVE_NONE) {
+		ufs_var_save = VAR_SAVE_NONE;
+	} else {
+		return EINVAL;
+	}
+	return 0;
+}
+
+SYSCTL_PROC(_kern_redwood, OID_AUTO, var_save, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    ufs_sysctl_var_save, "I", "the data volume's saver: 1 registers, 2 is the kernel asking, 3 is done");
+
+/* The claim on the store: 1 takes it, 0 gives it back; reading says which process holds it. */
+static int
+ufs_sysctl_var_busy(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = ufs_var_busy_pid, error, me = proc_selfpid();
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, NULL);
+	if (error != 0 || req->newptr == 0) {
+		return error;
+	}
+	lck_mtx_lock(&ufs_write_mtx);
+	if (value == 1) {
+		if (ufs_var_busy_pid != 0 && ufs_var_busy_pid != me) {
+			proc_t held = proc_find(ufs_var_busy_pid);
+
+			if (held != NULL) {
+				proc_rele(held);
+				lck_mtx_unlock(&ufs_write_mtx);
+				return EBUSY;   /* another saver has it and is alive: one at a time */
+			}
+			printf("var_store: the claim on the store was left by process %d, which is gone\n",
+			    ufs_var_busy_pid);
+		}
+		ufs_var_busy_pid = me;
+	} else if (value == 0) {
+		if (ufs_var_busy_pid == me || ufs_var_busy_pid == 0) {
+			ufs_var_busy_pid = 0;
+		} else {
+			error = EPERM;
+		}
+	} else {
+		error = EINVAL;
+	}
+	lck_mtx_unlock(&ufs_write_mtx);
+	return error;
+}
+
+SYSCTL_PROC(_kern_redwood, OID_AUTO, var_busy, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    ufs_sysctl_var_busy, "I", "the claim a writer of /dev/rufs_darwin must hold: 1 takes it, 0 gives it back");
+
+/*
+ * Native blocks [lba, lba + count) of partition part, one request of at most the buffer's size:
+ * read into dst, or, with src, written from there. Called with ufs_lock held.
+ */
+static int
+ufs_request(uint32_t op, uint32_t part, uint64_t lba, uint64_t count, uint8_t *dst, const uint8_t *src)
+{
+	uint64_t bytes = count * ufs_page->part[part].block_size, started, waited_ms = 0;
+	uint32_t seq = ++ufs_seq;
+	int64_t status;
+
+	if (ufs_dead || ufs_closing) {
+		return EIO;
+	}
+	if (op == BLOCK_OP_READ) {
+		if (part == ufs_last_part && lba == ufs_last_end) {
+			ufs_sequential++;
+		}
+		ufs_last_part = part;
+		ufs_last_end = lba + count;
+	} else {
+		/*
+		 * The data into the buffer and out of this core's cache before the request is raised:
+		 * core 0 drops its own lines of the buffer and hands it to UEFI's driver.
+		 */
+		memcpy(ufs_buffer, src, (size_t)bytes);
+		FlushPoC_DcacheRegion((vm_offset_t)ufs_buffer, (size_t)bytes);
+		ufs_last_part = ~0u;
+	}
+	ufs_page->ask.part = part;
+	ufs_page->ask.lba = lba;
+	ufs_page->ask.count = count;
+	ufs_page->ask.op = op;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	ufs_page->ask.request = seq;
+	__asm__ volatile ("dmb sy" ::: "memory");
+
+	started = mach_absolute_time();
+	while (ufs_page->answer.answered != seq) {
+		/* spin briefly for a quick answer, then sleep a millisecond at a time */
+		uint64_t us;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &us);
+		us /= 1000;
+		if (us < 2000) {
+			/* the answer to a small request comes in tens of microseconds: look often */
+			__builtin_arm_yield();
+			continue;
+		}
+		IOSleep(1);
+		if (++waited_ms > UFS_TIMEOUT_MS) {
+			/* no answer: the loader is gone or stuck; nothing more is asked of it */
+			printf("ufs: no answer from the loader to request %u in %u s: the storage is off from now on\n",
+			    seq, UFS_TIMEOUT_MS / 1000);
+			ufs_dead = true;
+			ufs_errors++;
+			return EIO;
+		}
+	}
+	__asm__ volatile ("dmb sy" ::: "memory");
+	{
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		ufs_wait_us += ns / 1000;
+	}
+	status = ufs_page->answer.status;
+	if (status != 0) {
+		printf("ufs: %s: blocks %llu..%llu: the loader's %s failed (status %llx)\n",
+		    ufs_page->part[part].name, lba, lba + count - 1,
+		    op == BLOCK_OP_WRITE ? "write" : "read", (uint64_t)status);
+		ufs_errors++;
+		return EIO;
+	}
+	if (op == BLOCK_OP_WRITE) {
+		/* the loader has read the blocks back and found them the same */
+		ufs_writes++;
+		ufs_write_bytes += bytes;
+		return 0;
+	}
+	started = mach_absolute_time();
+	/*
+	 * The buffer is mapped cacheable here (copying out of an uncached mapping went at 870 MB/s,
+	 * as slow as the storage itself). Core 0 cleans and invalidates it after every read, and this
+	 * side only ever fills it for a write of its own and cleans its lines then; whatever this
+	 * core may still hold of an earlier request -- a line brought in by a prefetch, say -- goes
+	 * before the copy.
+	 */
+	FlushPoC_DcacheRegion((vm_offset_t)ufs_buffer, (size_t)bytes);
+	memcpy(dst, ufs_buffer, (size_t)bytes);
+	{
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		ufs_copy_us += ns / 1000;
+	}
+	ufs_requests++;
+	ufs_bytes += bytes;
+	if (bytes <= 4096) {
+		ufs_small++;
+	} else if (bytes <= 65536) {
+		ufs_medium++;
+	} else {
+		ufs_large++;
+	}
+	return 0;
+}
+
+/* One of this driver's devices (block or character): a request to it costs tens of microseconds */
+bool
+redwood_ufs_dev(dev_t dev)
+{
+	return ufs_ready && ((ufs_bmajor >= 0 && major(dev) == ufs_bmajor) ||
+	       (ufs_cmajor >= 0 && major(dev) == ufs_cmajor));
+}
+
+/*
+ * Where the time of reading the storage went, so far: waiting for core 0's answer (of which
+ * the loader's own clock says how long ReadBlocks itself took) and copying out of its buffer.
+ */
+void
+redwood_ufs_report(const char *when)
+{
+	uint64_t loader_ns = 0;
+
+	if (!ufs_ready) {
+		return;
+	}
+	ufshc_report(when);
+	absolutetime_to_nanoseconds(ufs_page->answer.ticks, &loader_ns);
+	printf("ufs: %s: %llu requests (%llu of 4 KB or less, %llu to 64 KB, %llu more; %llu right after "
+	    "the one before), %llu errors, %llu bytes; waiting %llu ms, of it in ReadBlocks %llu ms; "
+	    "copying %llu ms\n", when, ufs_requests, ufs_small, ufs_medium, ufs_large, ufs_sequential,
+	    ufs_errors, ufs_bytes, ufs_wait_us / 1000, loader_ns / 1000000, ufs_copy_us / 1000);
+	if (ufs_write_part >= 0 || ufs_writes != 0 || ufs_write_refused != 0) {
+		printf("ufs: %s: %llu writes into darwin, %llu bytes, read back by the loader; %llu did not "
+		    "finish, %llu refused here\n", when, ufs_writes, ufs_write_bytes, ufs_write_errors,
+		    ufs_write_refused);
+	}
+}
+
+static uint64_t
+ufs_part_bytes(uint32_t part)
+{
+	return ufs_page->part[part].blocks * ufs_page->part[part].block_size;
+}
+
+/*
+ * Bytes [offset, offset + len) of partition part into dst, whatever their alignment, through the
+ * loader: the native blocks that cover them are read a buffer at a time and the wanted bytes
+ * copied out.
+ */
+static int
+ufs_read_mailbox(uint32_t part, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	uint64_t nbs = ufs_page->part[part].block_size, per = ufs_buffer_size / nbs;
+	static uint8_t *bounce;
+	int error = 0;
+
+	if (bounce == NULL) {
+		bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+		if (bounce == NULL) {
+			return ENOMEM;
+		}
+	}
+	lck_mtx_lock(&ufs_lock);
+	if (ufshc_list_in()) {
+		/* this kernel's own transfer list is in the controller: UEFI's driver must not be asked to ring */
+		if (ufs_mailbox_refused++ < 4) {
+			printf("ufs: %s: not asked of the loader while this kernel's own transfer list is in\n",
+			    ufs_page->part[part].name);
+		}
+		lck_mtx_unlock(&ufs_lock);
+		return EIO;
+	}
+	while (len > 0 && error == 0) {
+		uint64_t first = offset / nbs, skip = offset % nbs;
+		uint64_t count = (skip + len + nbs - 1) / nbs, take;
+
+		if (count > per) {
+			count = per;
+		}
+		take = count * nbs - skip;
+		if (take > len) {
+			take = len;
+		}
+		if (skip == 0 && take == count * nbs) {
+			error = ufs_request(BLOCK_OP_READ, part, first, count, dst, NULL);   /* whole blocks: straight in */
+		} else {
+			error = ufs_request(BLOCK_OP_READ, part, first, count, bounce, NULL);
+			if (error == 0) {
+				memcpy(dst, bounce + skip, (size_t)take);
+			}
+		}
+		offset += take;
+		dst += take;
+		len -= take;
+	}
+	lck_mtx_unlock(&ufs_lock);
+	return error;
+}
+
+/* The same, through this kernel's own driver: the partition's unit, from where it begins there */
+static int
+ufs_read_native(uint32_t part, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	if (part >= ufs_parts || ufs_lun[part] == 0xff) {
+		return ENXIO;
+	}
+	return ufshc_read(ufs_lun[part], ufs_lun_offset[part] + offset, dst, len);
+}
+
+/* The switches of lists, with the loader's mailbox held: nothing is asked of UEFI meanwhile */
+static int
+ufs_native_in(bool prove)
+{
+	int error;
+
+	lck_mtx_lock(&ufs_lock);
+	/* (a loader that did not answer may still be inside UEFI's driver) */
+	error = ufs_dead ? EIO : ufshc_switch_in(prove);
+	lck_mtx_unlock(&ufs_lock);
+	return error;
+}
+
+static int
+ufs_native_out(const char *why)
+{
+	int error;
+
+	lck_mtx_lock(&ufs_lock);
+	error = ufshc_switch_out(why);
+	lck_mtx_unlock(&ufs_lock);
+	return error;
+}
+
+/* The way chosen (ufs_native=, kern.redwood.ufs_native); if this kernel's own fails, the loader's */
+static int
+ufs_read(uint32_t part, uint64_t offset, uint8_t *dst, uint64_t len)
+{
+	if (ufs_native_on && ufs_lun[part] != 0xff) {
+		int error = ufs_read_native(part, offset, dst, len);
+
+		if (error == 0) {
+			return 0;
+		}
+		if (ufs_write_busy) {
+			/* the list is out for a write of ours, not broken: this read goes the other way */
+			return ufs_read_mailbox(part, offset, dst, len);
+		}
+		if (ufs_native_on) {
+			ufs_native_on = false;
+			ufs_native_fallbacks++;
+			printf("ufs: %s: bytes %llu..%llu: this kernel's own read failed (%d); through the loader from now on\n",
+			    ufs_page->part[part].name, offset, offset + len - 1, error);
+		}
+		ufs_native_out("a read failed");
+	}
+	return ufs_read_mailbox(part, offset, dst, len);
+}
+
+/*
+ * Whole blocks [offset, offset + len) of the one partition that takes writes, from src, through
+ * the loader. This kernel's own driver never writes -- its whitelist of commands has no write in
+ * it -- so for the length of a write its transfer list goes out and UEFI's driver, which the
+ * loader calls, has the controller again; reads meanwhile go through the loader too (ufs_read),
+ * which is slower and right. Nothing of iOS waits on this but the writer itself: the data volume
+ * is in memory (ramfs) and only its copy for the next boot is written here.
+ */
+static int
+ufs_write(uint32_t part, uint64_t offset, const uint8_t *src, uint64_t len)
+{
+	uint64_t nbs, per;
+	int error = 0;
+
+	if (!ufs_ready || ufs_write_part < 0 || part != (uint32_t)ufs_write_part) {
+		ufs_write_refused++;
+		return EROFS;
+	}
+	nbs = ufs_page->part[part].block_size;
+	if (len == 0 || offset % nbs != 0 || len % nbs != 0) {
+		return EINVAL;          /* whole blocks only: nothing is read before a write */
+	}
+	if (offset / nbs < UFS_WRITE_FIRST || offset > ufs_part_bytes(part) ||
+	    len > ufs_part_bytes(part) - offset) {
+		/* the iOS volume, the cryptexes, and anything past the partition's end: never */
+		ufs_write_refused++;
+		return EROFS;
+	}
+	per = ufs_buffer_size / nbs;
+	lck_mtx_lock(&ufs_write_mtx);
+	/*
+	 * The list goes out once, at the first write, and comes back when the device is closed: a
+	 * whole data volume is written a bufferful at a time, and switching the controller's list
+	 * for each of those would say so a hundred times over and buy nothing. ufs_native_on is
+	 * cleared first, so that a reader about to start goes the other way of its own accord; one
+	 * already inside this kernel's driver gets an error and is sent the other way by
+	 * ufs_write_busy.
+	 */
+	if (!ufs_write_out) {
+		ufs_write_was_native = ufs_native_on;
+		ufs_write_busy = true;
+		ufs_write_out = true;
+		if (ufs_write_was_native) {
+			ufs_native_on = false;
+			ufs_native_out("writing the data volume into darwin");
+		}
+	}
+	while (len > 0 && error == 0) {
+		uint64_t count = len / nbs;
+
+		if (count > per) {
+			count = per;
+		}
+		lck_mtx_lock(&ufs_lock);
+		if (ufshc_list_in()) {
+			/* it did not go out after all: UEFI's driver must not be asked to ring */
+			error = EIO;
+		} else {
+			error = ufs_request(BLOCK_OP_WRITE, part, offset / nbs, count, NULL, src);
+		}
+		lck_mtx_unlock(&ufs_lock);
+		offset += count * nbs;
+		src += count * nbs;
+		len -= count * nbs;
+	}
+	lck_mtx_unlock(&ufs_write_mtx);
+	if (error != 0) {
+		ufs_write_errors++;
+	}
+	return error;
+}
+
+/* The writing over: this kernel's own transfer list back in, and reads through it again. */
+static void
+ufs_write_restore(void)
+{
+	lck_mtx_lock(&ufs_write_mtx);
+	if (ufs_write_out) {
+		if (ufs_write_was_native && ufs_native_in(false) == 0) {
+			ufs_native_on = true;
+		}
+		ufs_write_busy = false;
+		ufs_write_out = false;
+	}
+	lck_mtx_unlock(&ufs_write_mtx);
+}
+
+/* ---- the devices ---- */
+
+static int
+ufs_open(dev_t dev, int flags, __unused int devtype, __unused proc_t p)
+{
+	if (!ufs_ready || (uint32_t)minor(dev) >= ufs_parts || (ufs_page->part[minor(dev)].flags & BLOCK_PART_UNIT)) {
+		return ENXIO;
+	}
+	if (flags & FWRITE) {
+		return EROFS;           /* a block device of this driver never writes */
+	}
+	return 0;
+}
+
+/* The same, for the character devices: the one partition that takes writes may be opened for them. */
+static int
+ufs_copen(dev_t dev, int flags, int devtype, proc_t p)
+{
+	if ((flags & FWRITE) && ufs_write_part >= 0 && (uint32_t)minor(dev) == (uint32_t)ufs_write_part) {
+		flags &= ~FWRITE;
+	}
+	return ufs_open(dev, flags, devtype, p);
+}
+
+static int
+ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static void ufs_write_restore(void);
+
+/* The last close of /dev/rufs_darwin ends the writing: this kernel's own transfer list goes back in. */
+static int
+ufs_cclose(dev_t dev, int flags, int devtype, proc_t p)
+{
+	if (ufs_write_part >= 0 && (uint32_t)minor(dev) == (uint32_t)ufs_write_part) {
+		ufs_write_restore();
+	}
+	return ufs_close(dev, flags, devtype, p);
+}
+
+static void
+ufs_strategy(buf_t bp)
+{
+	uint32_t part = (uint32_t)minor(buf_device(bp));
+	uint64_t offset, len, size;
+	int error;
+
+	if (!ufs_ready || part >= ufs_parts) {
+		buf_seterror(bp, ENXIO);
+		buf_biodone(bp);
+		return;
+	}
+	if (!(buf_flags(bp) & B_READ)) {
+		buf_seterror(bp, EROFS);         /* this device never writes */
+		buf_biodone(bp);
+		return;
+	}
+	size = ufs_part_bytes(part);
+	offset = (uint64_t)buf_blkno(bp) * ufs_bsize[part];
+	len = buf_count(bp);
+	if (offset >= size) {
+		buf_seterror(bp, offset == size ? 0 : EINVAL);
+		buf_setresid(bp, buf_count(bp));
+		buf_biodone(bp);
+		return;
+	}
+	if (offset + len > size) {
+		len = size - offset;
+	}
+	error = ufs_read(part, offset, (uint8_t *)buf_dataptr(bp), len);
+	buf_setresid(bp, (uint32_t)(buf_count(bp) - (error ? 0 : len)));
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+ufs_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int fflag, __unused proc_t p)
+{
+	uint32_t part = (uint32_t)minor(dev), native;
+
+	if (!ufs_ready || part >= ufs_parts) {
+		return ENXIO;
+	}
+	native = ufs_page->part[part].block_size;
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = ufs_bsize[part];
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		/*
+		 * spec_open() sets the block size to 512 to count the device in 512-byte blocks and
+		 * then back, and treats a refusal as a broken device; reads are by byte here, so any
+		 * power of two from 512 to the native block size will do.
+		 */
+		if (*(uint32_t *)data < 512 || *(uint32_t *)data > native ||
+		    (*(uint32_t *)data & (*(uint32_t *)data - 1)) != 0) {
+			return EINVAL;
+		}
+		ufs_bsize[part] = *(uint32_t *)data;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*(uint32_t *)data = native;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = ufs_part_bytes(part) / ufs_bsize[part];
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 0;  /* the block device, which is what a filesystem would ask */
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*(uint64_t *)data = ufs_buffer_size / ufs_bsize[part];
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+ufs_psize(dev_t dev)
+{
+	uint32_t part = (uint32_t)minor(dev);
+
+	return ufs_ready && part < ufs_parts ? (int)ufs_bsize[part] : -1;
+}
+
+/*
+ * A read of /dev/rufs_NAME: a bufferful at a time into memory of this kernel's and out to the
+ * reader with uiomove. Not physio, which hands the driver the reader's own address to copy to --
+ * and this kernel may not touch user memory itself (PAN): the copy has to go through uiomove.
+ * Nothing of this driver is held while it does, for a fault in the reader's memory can come back
+ * here as a read of the storage.
+ */
+static int
+ufs_cread(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t part = (uint32_t)minor(dev);
+	uint64_t size;
+	uint8_t *bounce;
+	int error = 0;
+
+	if (!ufs_ready || part >= ufs_parts) {
+		return ENXIO;
+	}
+	size = ufs_part_bytes(part);
+	if (uio_offset(uio) < 0) {
+		return EINVAL;
+	}
+	bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	if (bounce == NULL) {
+		return ENOMEM;
+	}
+	while (error == 0 && uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < size) {
+		uint64_t at = (uint64_t)uio_offset(uio), want = (uint64_t)uio_resid(uio);
+
+		if (want > ufs_buffer_size) {
+			want = ufs_buffer_size;
+		}
+		if (want > size - at) {
+			want = size - at;
+		}
+		error = ufs_read(part, at, bounce, want);
+		if (error == 0) {
+			error = uiomove((caddr_t)bounce, (int)want, uio);
+		}
+	}
+	kfree_data(bounce, ufs_buffer_size);
+	return error;
+}
+
+/*
+ * A write to /dev/rufs_darwin: whole blocks, out of user memory a bufferful at a time and into the
+ * partition. Nothing of this driver is held while user memory is touched -- a fault there can come
+ * back as a read of the storage -- so the bytes are taken first and written after.
+ */
+static int
+ufs_cwrite(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t part = (uint32_t)minor(dev);
+	uint64_t nbs;
+	uint8_t *bounce;
+	int error = 0;
+
+	if (!ufs_ready || part >= ufs_parts || ufs_write_part < 0 || part != (uint32_t)ufs_write_part) {
+		return EROFS;
+	}
+	if (ufs_var_busy_pid != proc_selfpid()) {
+		/* one writer of the store at a time, and it says so first (kern.redwood.var_busy) */
+		ufs_write_refused++;
+		return EPERM;
+	}
+	nbs = ufs_page->part[part].block_size;
+	if (uio_offset(uio) < 0 || (uint64_t)uio_offset(uio) % nbs != 0 || (uint64_t)uio_resid(uio) % nbs != 0) {
+		return EINVAL;
+	}
+	bounce = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	if (bounce == NULL) {
+		return ENOMEM;
+	}
+	while (error == 0 && uio_resid(uio) > 0) {
+		user_ssize_t want = uio_resid(uio);
+		off_t at = uio_offset(uio);
+
+		if (want > (user_ssize_t)ufs_buffer_size) {
+			want = (user_ssize_t)ufs_buffer_size;
+		}
+		error = uiomove((caddr_t)bounce, (int)want, uio);
+		if (error == 0) {
+			error = ufs_write(part, (uint64_t)at, bounce, (uint64_t)want);
+			if (error != 0) {
+				/* these bytes did not go in: the write is to say so, not to count them */
+				uio_setoffset(uio, at);
+				uio_setresid(uio, uio_resid(uio) + want);
+			}
+		}
+	}
+	kfree_data(bounce, ufs_buffer_size);
+	return error;
+}
+
+static const struct bdevsw ufs_bdevsw = {
+	.d_open     = ufs_open,
+	.d_close    = ufs_close,
+	.d_strategy = ufs_strategy,
+	.d_ioctl    = ufs_ioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw ufs_cdevsw = {
+	.d_open       = ufs_copen,
+	.d_close      = ufs_cclose,
+	.d_read       = ufs_cread,
+	.d_write      = ufs_cwrite,
+	.d_ioctl      = ufs_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+/*
+ * The orderly end of a run, from osfmk/arm64/loader_return.c, in the thread that is about to hand
+ * control back: ask the saver for the data volume and wait for it, so that a run need not have
+ * been told to save. Bounded, and only when a saver registered -- the loader goes on feeding the
+ * watchdog for a minute past the run's own budget, and the host waits a hundred seconds past it,
+ * so twenty seconds here is well inside both. Nothing else of the way out has happened yet: the
+ * GPU, the DSPs and this kernel's transfer list are still as the run had them.
+ */
+void
+redwood_var_save_on_return(void)
+{
+	uint32_t ms = VAR_SAVE_MS;
+	uint64_t waited = 0;
+
+	if (!ufs_ready || ufs_write_part < 0 || ufs_var_save != VAR_SAVE_IDLE) {
+		return;
+	}
+	PE_parse_boot_argn("var_save_ms", &ms, sizeof(ms));
+	printf("var_store: the run is ending: the data volume is asked for\n");
+	ufs_var_save = VAR_SAVE_WANTED;
+	while (ufs_var_save != VAR_SAVE_DONE && waited < ms) {
+		IOSleep(20);
+		waited += 20;
+	}
+	if (ufs_var_save == VAR_SAVE_DONE) {
+		/* what it made of it is in its own lines: this only says it answered */
+		printf("var_store: the saver has finished after %llu ms\n", waited);
+	} else {
+		printf("var_store: the saver did not answer in %u ms: the store keeps what it had\n", ms);
+	}
+}
+
+/* ---- the check: the partitions there are images of, hashed as the loader hashes them ---- */
+
+static const struct {
+	const char *name;
+	uint64_t bytes;
+} ufs_references[] = {
+	{ "bluetooth", 503808 }, { "abl", 208896 }, { "aop", 208896 }, { "xbl", 3706880 },
+	{ "tz", 3710976 }, { "hyp", 3653632 }, { "dsp", 67108864 }, { "modem", 214265856 },
+};
+
+static bool
+ufs_is_reference(const char *name, const char *ref)
+{
+	size_t n = strlen(ref);
+
+	return strncmp(name, ref, n) == 0 &&
+	       (name[n] == 0 || (name[n] == '_' && (name[n + 1] == 'a' || name[n + 1] == 'b') && name[n + 2] == 0));
+}
+
+static void
+ufs_check(void *arg, __unused wait_result_t wr)
+{
+	uint8_t *chunk = kalloc_data(1 << 20, Z_WAITOK);
+
+	/*
+	 * Not at once: what the kernel prints in its first minute or so does not come back with the
+	 * log on the phone (the first line that does is from long after this driver has started), so
+	 * the check waits until it will be read -- unless it runs right at the start (ufs_check=2, then
+	 * back to the loader: the log is short).
+	 */
+	if (arg == NULL) {
+		IOSleep(40000);
+	}
+	printf("ufs: check: %u partitions of the phone's storage, read through %s\n", ufs_parts,
+	    ufs_native_on ? "this kernel's own UFS driver" : "the loader's page");
+	for (uint32_t part = 0; chunk != NULL && part < ufs_parts; part++) {
+		for (unsigned r = 0; r < sizeof(ufs_references) / sizeof(ufs_references[0]); r++) {
+			uint64_t h = 0xcbf29ce484222325ULL, done = 0, started = mach_absolute_time(), ns;
+			uint64_t bytes = ufs_references[r].bytes;
+			int error = 0;
+
+			if (!ufs_is_reference((const char *)ufs_page->part[part].name, ufs_references[r].name)) {
+				continue;
+			}
+			while (done < bytes && error == 0) {
+				uint64_t n = bytes - done < (1 << 20) ? bytes - done : (1 << 20);
+
+				error = ufs_read(part, done, chunk, n);
+				for (uint64_t i = 0; error == 0 && i < n; i++) {
+					h = (h ^ chunk[i]) * 0x100000001b3ULL;
+				}
+				done += n;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+			if (error) {
+				printf("ufs: check %s: read failed (%d)\n", ufs_page->part[part].name, error);
+			} else {
+				printf("ufs: check %s: fnv %llx over %llu bytes, %llu ms\n", ufs_page->part[part].name,
+				    h, bytes, ns / 1000000);
+			}
+		}
+	}
+	if (chunk != NULL) {
+		kfree_data(chunk, 1 << 20);
+	}
+	printf("ufs: check done: %llu requests, %llu errors, %llu bytes, %llu ms waiting\n",
+	    ufs_requests, ufs_errors, ufs_bytes, ufs_wait_us / 1000);
+}
+
+/*
+ * ufs_bench=1: what one request through the loader costs, by size. The partition "darwin" is
+ * read from the front, a different stretch for every size so that nothing the storage itself may
+ * have kept is read twice; for each size, MB/s and microseconds a request, split into the time
+ * core 0 spent in ReadBlocks (its clock in the page, read before and after), the rest of waiting
+ * for its answer (noticing the request, answering), and copying out of its buffer.
+ */
+static void
+ufs_bench(__unused void *arg, __unused wait_result_t wr)
+{
+	static const uint32_t sizes[] = { 4096, 16384, 65536, 262144, 1048576, 4194304 };
+	uint8_t *dst = kalloc_data(ufs_buffer_size, Z_WAITOK);
+	uint32_t part = BLOCK_MAX_PARTS;
+	uint64_t base = 0;
+
+	for (uint32_t i = 0; i < ufs_parts; i++) {
+		if (strcmp((const char *)ufs_page->part[i].name, "darwin") == 0) {
+			part = i;
+		}
+	}
+	if (dst == NULL || part == BLOCK_MAX_PARTS) {
+		printf("ufs: bench: no partition darwin, or no memory\n");
+		return;
+	}
+	for (unsigned z = 0; z < sizeof(sizes) / sizeof(sizes[0]); z++) {
+		uint64_t total = sizes[z] <= 16384 ? (16ULL << 20) : (128ULL << 20), done = 0, n = 0;
+		uint64_t wait0 = ufs_wait_us, copy0 = ufs_copy_us, loader0 = ufs_page->answer.ticks;
+		uint64_t started = mach_absolute_time(), ns, loader_ns;
+		int error = 0;
+
+		while (done < total && error == 0) {
+			error = ufs_read(part, base + done, dst, sizes[z]);
+			done += sizes[z];
+			n++;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		absolutetime_to_nanoseconds(ufs_page->answer.ticks - loader0, &loader_ns);
+		printf("ufs: bench: %7u bytes a request: %4llu MB/s, %llu requests, %llu us each: "
+		    "ReadBlocks %llu, the rest of waiting %llu, copying %llu%s\n", sizes[z],
+		    ns ? (done * 1000ULL) / ns : 0, n, ns / 1000 / n, loader_ns / 1000 / n,
+		    (ufs_wait_us - wait0 - loader_ns / 1000) / n, (ufs_copy_us - copy0) / n,
+		    error ? " (an error)" : "");
+		base += total;
+	}
+	kfree_data(dst, ufs_buffer_size);
+	redwood_ufs_report("after the bench");
+}
+
+/* ---- this kernel's own driver: which unit is which, and whether it reads what the loader reads ---- */
+
+static uint64_t
+ufs_fnv(uint64_t h, const uint8_t *p, uint64_t n)
+{
+	for (uint64_t i = 0; i < n; i++) {
+		h = (h ^ p[i]) * 0x100000001b3ULL;
+	}
+	return h;
+}
+
+static uint32_t
+ufs_entry(const char *name)
+{
+	for (uint32_t i = 0; i < ufs_parts; i++) {
+		if (strcmp((const char *)ufs_page->part[i].name, name) == 0) {
+			return i;
+		}
+	}
+	return BLOCK_MAX_PARTS;
+}
+
+/*
+ * Which logical unit each unit the loader lists is (their device paths do not say): unit k is
+ * taken to be LUN k (ordinary logical units only: never a well-known one), and it is so only if
+ * block 1 (the GPT header, with the unit's own GUID in it) read through the loader
+ * is the same as block 1 of that LUN read here; no other LUN is read. The loader's reads are made
+ * first, with UEFI's list in; then this kernel's list goes in (with its proof) and stays in.
+ */
+static bool
+ufs_native_map(bool all_units)
+{
+	uint8_t *mine = kalloc_data(4096, Z_WAITOK), *theirs = kalloc_data(BLOCK_MAX_UNITS * 4096, Z_WAITOK);
+	uint32_t units[BLOCK_MAX_UNITS], n = 0, mask = 0, darwin = ufs_entry("darwin");
+	bool good = mine != NULL && theirs != NULL;
+
+	memset(ufs_lun, 0xff, sizeof(ufs_lun));
+	for (uint32_t i = 0; good && i < ufs_parts && n < BLOCK_MAX_UNITS; i++) {
+		volatile struct loader_block_part *e = &ufs_page->part[i];
+
+		if ((e->flags & BLOCK_PART_UNIT) == 0 || e->unit >= 8) {
+			continue;
+		}
+		if (!all_units && (darwin == BLOCK_MAX_PARTS || ufs_page->part[darwin].unit != e->unit)) {
+			continue;
+		}
+		if (e->block_size != 4096 || ufs_read_mailbox(i, 4096, theirs + n * 4096, 4096) != 0 ||
+		    memcmp(theirs + n * 4096, "EFI PART", 8) != 0) {
+			printf("ufs: native: %s: no GPT header to know it by (block size %u)\n", e->name, e->block_size);
+			good = false;
+			break;
+		}
+		units[n++] = i;
+		mask |= 1u << e->unit;
+		ufs_native_luns = n;
+	}
+	if (good && !all_units && (n != 1 || ufs_page->part[units[0]].unit != 0)) {
+		printf("ufs: native: darwin is not on the first unit the loader lists: not LUN 0, not read here\n");
+		good = false;
+	}
+	ufshc_set_luns(mask);
+	if (good && ufs_native_in(true) != 0) {
+		good = false;
+	}
+	for (uint32_t k = 0; good && k < n; k++) {
+		volatile struct loader_block_part *e = &ufs_page->part[units[k]];
+
+		if (ufshc_read((uint8_t)e->unit, 4096, mine, 4096) != 0 || memcmp(mine, theirs + k * 4096, 4096) != 0) {
+			printf("ufs: native: %s: LUN %u's block 1 is NOT what the loader reads as its block 1\n", e->name, e->unit);
+			good = false;
+		} else {
+			printf("ufs: native: %s is LUN %u: its GPT header read both ways is the same\n", e->name, e->unit);
+		}
+	}
+	if (!good) {
+		ufs_native_out("the units could not be told");
+		memset(ufs_lun, 0xff, sizeof(ufs_lun));
+	} else {
+		for (uint32_t i = 0; i < ufs_parts; i++) {
+			volatile struct loader_block_part *e = &ufs_page->part[i];
+
+			if (e->unit < 8 && (mask & (1u << e->unit)) && e->block_size == 4096) {
+				ufs_lun[i] = (uint8_t)e->unit;
+				ufs_lun_offset[i] = e->start_lba * 4096;
+			}
+		}
+	}
+	if (mine != NULL) {
+		kfree_data(mine, 4096);
+	}
+	if (theirs != NULL) {
+		kfree_data(theirs, BLOCK_MAX_UNITS * 4096);
+	}
+	return good;
+}
+
+/*
+ * ufs_native_check=1: what this kernel's own driver reads is what the loader reads, byte for
+ * byte. Spans are read a batch at a time, first all through the loader (UEFI's list in), then
+ * all here (this kernel's list in, proved), and compared.
+ */
+struct ufs_span {
+	uint32_t part;
+	uint64_t offset, len;
+};
+
+#define UFS_CMP_BUFFER      (32u << 20)
+
+static uint8_t *ufs_cmp_x, *ufs_cmp_y;
+static uint64_t ufs_cmp_mailbox_ns, ufs_cmp_native_ns, ufs_cmp_bytes, ufs_cmp_spans, ufs_cmp_differ, ufs_cmp_failed;
+
+static bool
+ufs_compare_batch(const struct ufs_span *s, uint32_t n, const char *what, bool quiet)
+{
+	uint64_t at, t, ns, hx = 0xcbf29ce484222325ULL, hy = hx, bytes = 0, mailbox_ns, native_ns;
+	bool same = true;
+	int e = 0;
+
+	t = mach_absolute_time();
+	if (ufs_native_out("the loader reads, to compare") != 0) {
+		e = EIO;
+	}
+	at = 0;
+	for (uint32_t i = 0; e == 0 && i < n; at += s[i].len, i++) {
+		e = ufs_read_mailbox(s[i].part, s[i].offset, ufs_cmp_x + at, s[i].len);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &mailbox_ns);
+	t = mach_absolute_time();
+	if (e == 0 && ufs_native_in(true) != 0) {
+		e = EIO;
+	}
+	at = 0;
+	for (uint32_t i = 0; e == 0 && i < n; at += s[i].len, i++) {
+		e = ufs_read_native(s[i].part, s[i].offset, ufs_cmp_y + at, s[i].len);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &native_ns);
+	ufs_cmp_mailbox_ns += mailbox_ns;
+	ufs_cmp_native_ns += native_ns;
+	if (e != 0) {
+		printf("ufs: native check: %s: a read failed (%d): STOP\n", what, e);
+		ufs_cmp_failed++;
+		return false;
+	}
+	at = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		if (memcmp(ufs_cmp_x + at, ufs_cmp_y + at, s[i].len) != 0) {
+			uint64_t k = 0;
+
+			while (ufs_cmp_x[at + k] == ufs_cmp_y[at + k]) {
+				k++;
+			}
+			printf("ufs: native check: %s %s: DIFFERENT at byte %llu (%02x through the loader, %02x here): STOP\n",
+			    ufs_page->part[s[i].part].name, what, s[i].offset + k, ufs_cmp_x[at + k], ufs_cmp_y[at + k]);
+			same = false;
+			ufs_cmp_differ++;
+		}
+		hx = ufs_fnv(hx, ufs_cmp_x + at, s[i].len);
+		hy = ufs_fnv(hy, ufs_cmp_y + at, s[i].len);
+		at += s[i].len;
+		bytes += s[i].len;
+	}
+	ufs_cmp_spans += n;
+	ufs_cmp_bytes += bytes;
+	if (!quiet || !same) {
+		printf("ufs: native check: %s %s: %u span(s), %llu bytes from %llu: %s (fnv %llx / %llx); loader %llu ms, here "
+		    "%llu ms (switches included)\n", ufs_page->part[s[0].part].name, what, n, bytes, s[0].offset,
+		    same ? "the same" : "NOT THE SAME", hx, hy, mailbox_ns / 1000000, native_ns / 1000000);
+	}
+	return same;
+}
+
+/* Bytes [offset, offset + len) of an entry, compared a buffer at a time; FNV-1a of the first ref bytes too */
+static bool
+ufs_compare(uint32_t part, uint64_t offset, uint64_t len, uint64_t ref, const char *what)
+{
+	uint64_t done = 0, href = 0xcbf29ce484222325ULL;
+	bool same = true;
+
+	while (done < len && same) {
+		struct ufs_span s = { part, offset + done, len - done < UFS_CMP_BUFFER ? len - done : UFS_CMP_BUFFER };
+
+		same = ufs_compare_batch(&s, 1, what, true);
+		if (same && ref > done) {
+			href = ufs_fnv(href, ufs_cmp_x, ref - done < s.len ? ref - done : s.len);
+		}
+		done += s.len;
+	}
+	printf("ufs: native check: %s %s: %llu bytes from %llu: %s%s", ufs_page->part[part].name, what, done, offset,
+	    same ? "the same" : "NOT THE SAME", ref ? "" : "\n");
+	if (ref) {
+		printf("; fnv %llx over the first %llu bytes (the loader's own survey hashes them)\n", href, ref);
+	}
+	return same;
+}
+
+static void
+ufs_native_check(void)
+{
+	uint8_t *h = kalloc_data(4096, Z_WAITOK);
+	uint32_t part;
+	bool going = true;
+
+	ufs_cmp_x = kalloc_data(UFS_CMP_BUFFER, Z_WAITOK);
+	ufs_cmp_y = kalloc_data(UFS_CMP_BUFFER, Z_WAITOK);
+	if (h == NULL || ufs_cmp_x == NULL || ufs_cmp_y == NULL) {
+		printf("ufs: native check: no memory\n");
+		return;
+	}
+	printf("ufs: native check: through the loader and through this kernel's own driver, compared\n");
+	/* every unit's GPT: protective MBR, header, table; the backup table and header at the end */
+	for (uint32_t i = 0; going && i < ufs_parts; i++) {
+		volatile struct loader_block_part *e = &ufs_page->part[i];
+		uint64_t entries_lba, count, size, table, alt, alt_entries;
+		uint32_t want, got;
+
+		if ((e->flags & BLOCK_PART_UNIT) == 0 || ufs_lun[i] == 0xff) {
+			continue;
+		}
+		if (ufs_native_out("the loader reads, to compare") != 0 || ufs_read_mailbox(i, 4096, h, 4096) != 0) {
+			going = false;
+			break;
+		}
+		entries_lba = *(uint64_t *)(h + 72);
+		count = *(uint32_t *)(h + 80);
+		size = *(uint32_t *)(h + 84);
+		alt = *(uint64_t *)(h + 32);
+		table = (count * size + 4095) / 4096;
+		want = *(uint32_t *)(h + 16);
+		*(uint32_t *)(h + 16) = 0;
+		got = crc32(0, h, *(uint32_t *)(h + 12));
+		printf("ufs: native check: %s (LUN %u): GPT header crc %s (%x), table at block %llu, %llu entries of %llu bytes, "
+		    "backup header at block %llu\n", e->name, ufs_lun[i], got == want ? "right" : "WRONG", got, entries_lba, count,
+		    size, alt);
+		going = ufs_compare(i, 0, (entries_lba + table) * 4096, 0, "GPT (MBR, header, table)");
+		if (!going || alt >= e->blocks || ufs_native_out("the loader reads, to compare") != 0 ||
+		    ufs_read_mailbox(i, alt * 4096, h, 4096) != 0 || memcmp(h, "EFI PART", 8) != 0 ||
+		    (alt_entries = *(uint64_t *)(h + 72)) > alt) {
+			printf("ufs: native check: %s: no backup GPT header at block %llu: STOP\n", e->name, alt);
+			going = false;
+			break;
+		}
+		going = ufs_compare(i, alt_entries * 4096, (alt + 1 - alt_entries) * 4096, 0, "backup GPT (table, header)");
+	}
+	/* the partitions there are images of, whole */
+	for (part = 0; going && part < ufs_parts; part++) {
+		if ((ufs_page->part[part].flags & BLOCK_PART_UNIT) || ufs_lun[part] == 0xff) {
+			continue;
+		}
+		for (unsigned r = 0; going && r < sizeof(ufs_references) / sizeof(ufs_references[0]); r++) {
+			if (ufs_is_reference((const char *)ufs_page->part[part].name, ufs_references[r].name)) {
+				going = ufs_compare(part, 0, ufs_part_bytes(part), ufs_references[r].bytes, "whole");
+			}
+		}
+	}
+	/* super's geometry and metadata */
+	if (going && (part = ufs_entry("super")) < BLOCK_MAX_PARTS && ufs_lun[part] != 0xff) {
+		going = ufs_compare(part, 0, 8 << 20, 0, "first 8 MB (geometry, metadata)");
+	}
+	/* darwin: 32 spread megabytes, 256 scattered blocks, 32 pieces that begin and end inside a block */
+	if (going && (part = ufs_entry("darwin")) < BLOCK_MAX_PARTS && ufs_lun[part] != 0xff) {
+		struct ufs_span s[256];
+		uint64_t bytes = ufs_part_bytes(part), seed = 0x9e3779b97f4a7c15ULL, total = 0;
+
+		for (uint32_t k = 0; k < 32; k++) {
+			s[k] = (struct ufs_span){ part, (bytes - (1 << 20)) / 32 * k / 4096 * 4096, 1 << 20 };
+		}
+		going = ufs_compare_batch(s, 32, "spread megabytes", false);
+		for (uint32_t k = 0; k < 256; k++) {
+			seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+			s[k] = (struct ufs_span){ part, (seed >> 16) % (bytes / 4096) * 4096, 4096 };
+		}
+		going = going && ufs_compare_batch(s, 256, "scattered blocks", false);
+		for (uint32_t k = 0; k < 32; k++) {
+			seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+			s[k] = (struct ufs_span){ part, (seed >> 16) % (bytes - (2 << 20)), 1 + (seed >> 40) % (512 << 10) };
+			total += s[k].len;
+		}
+		going = going && ufs_compare_batch(s, 32, "unaligned pieces", false);
+	}
+	kfree_data(h, 4096);
+	printf("ufs: native check %s: %llu spans, %llu bytes, %llu NOT THE SAME, %llu failed reads; through the loader %llu ms, "
+	    "through this kernel's own driver %llu ms (list switches included)\n", going ? "done" : "STOPPED", ufs_cmp_spans,
+	    ufs_cmp_bytes, ufs_cmp_differ, ufs_cmp_failed, ufs_cmp_mailbox_ns / 1000000, ufs_cmp_native_ns / 1000000);
+	ufs_native_out("after the check");
+	ufshc_report("after the check");
+}
+
+/*
+ * ufs_native_bench=1 (with ufs_native=1): what the flash gives with N reads in flight -- N
+ * threads each reading at random places of darwin, a size at a time -- MB/s and microseconds a
+ * read, for 1, 2, 4, 8, 16 and 31 threads. Then back to the loader.
+ */
+struct ufs_nb {
+	uint32_t part, size, per_thread;
+	uint64_t span, seed;
+	volatile uint32_t left;
+	int error;
+};
+
+static void
+ufs_nb_thread(void *arg, __unused wait_result_t wr)
+{
+	struct ufs_nb *nb = arg;
+	uint8_t *buf = kalloc_data(nb->size, Z_WAITOK);
+	uint64_t seed = os_atomic_add(&nb->seed, 0x9e3779b97f4a7c15ULL, relaxed);
+
+	for (uint32_t i = 0; buf != NULL && i < nb->per_thread; i++) {
+		int e;
+
+		seed = seed * 6364136223846793005ULL + 1442695040888963407ULL;
+		e = ufs_read_native(nb->part, (seed >> 20) % (nb->span / nb->size) * nb->size, buf, nb->size);
+		if (e != 0) {
+			nb->error = e;
+		}
+	}
+	if (buf != NULL) {
+		kfree_data(buf, nb->size);
+	}
+	lck_mtx_lock(&ufs_lock);
+	nb->left--;
+	wakeup(nb);
+	lck_mtx_unlock(&ufs_lock);
+}
+
+static void
+ufs_native_bench(void)
+{
+	static const uint32_t sizes[] = { 4096, 32768, 131072, 524288 };
+	static const uint32_t threads[] = { 1, 2, 4, 8, 16, 31 };
+	uint32_t part = ufs_entry("darwin");
+
+	if (part >= BLOCK_MAX_PARTS || ufs_lun[part] == 0xff) {
+		printf("ufs: native bench: no darwin\n");
+		return;
+	}
+	for (unsigned z = 0; z < sizeof(sizes) / sizeof(sizes[0]); z++) {
+		for (unsigned t = 0; t < sizeof(threads) / sizeof(threads[0]); t++) {
+			struct ufs_nb nb = {
+				.part = part, .size = sizes[z], .span = ufs_part_bytes(part),
+				.per_thread = (sizes[z] <= 32768 ? 8192 : 2048) / threads[t] + 1, .seed = 12345 + z * 100 + t,
+			};
+			uint64_t started = mach_absolute_time(), ns, bytes;
+
+			nb.left = threads[t];
+			for (uint32_t i = 0; i < threads[t]; i++) {
+				thread_t th;
+
+				if (kernel_thread_start(ufs_nb_thread, &nb, &th) == KERN_SUCCESS) {
+					thread_deallocate(th);
+				} else {
+					lck_mtx_lock(&ufs_lock);
+					nb.left--;
+					lck_mtx_unlock(&ufs_lock);
+				}
+			}
+			lck_mtx_lock(&ufs_lock);
+			while (nb.left > 0) {
+				msleep(&nb, &ufs_lock, PRIBIO, "ufsbench", NULL);
+			}
+			lck_mtx_unlock(&ufs_lock);
+			absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+			bytes = (uint64_t)nb.per_thread * threads[t] * sizes[z];
+			printf("ufs: native bench: %6u bytes, %2u in flight: %4llu MB/s, %6llu reads/s, %5llu us a read%s\n",
+			    sizes[z], threads[t], ns ? bytes * 1000 / ns : 0, ns ? (bytes / sizes[z]) * 1000000000ULL / ns : 0,
+			    ns / 1000 * threads[t] / (bytes / sizes[z]), nb.error ? " (ERRORS)" : "");
+		}
+	}
+	ufshc_report("after the bench");
+}
+
+/* kern.redwood.ufs_native: 1 while reads go through this kernel's own driver; 0 or 1 may be set */
+static int
+ufs_sysctl_native(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int value = ufs_native_on, error, changed = 0;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error != 0 || !changed) {
+		return error;
+	}
+	if (value != 0) {
+		if (!(ufs_native_mapped && ufshc_available()) || ufs_native_in(true) != 0) {
+			return ENXIO;
+		}
+		ufs_native_on = true;
+	} else {
+		ufs_native_on = false;
+		ufs_native_out("kern.redwood.ufs_native=0");
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern_redwood, OID_AUTO, ufs_native, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0,
+    ufs_sysctl_native, "I", "1: the phone's storage is read by this kernel's own UFS driver, 0: through the loader");
+SYSCTL_QUAD(_kern_redwood, OID_AUTO, ufs_native_fallbacks, CTLFLAG_RD | CTLFLAG_LOCKED, &ufs_native_fallbacks,
+    "times a read of this kernel's own UFS driver failed and the loader's was used instead");
+
+/* ---- bringing it up ---- */
+
+void
+redwood_ufs_init(void)
+{
+	uint64_t pa = 0, buffer_pa;
+	uint32_t check = 0, made = 0;
+	vm_offset_t base;
+
+	if (!PE_parse_boot_argn("ufs_shared_pa", &pa, sizeof(pa)) || pa == 0) {
+		return;                 /* the loader was not asked for ufs=2: there is nothing to read through */
+	}
+	base = ml_io_map_unmappable((vm_offset_t)(pa & ~(UFS_PAGE - 1)),
+	    ((pa & (UFS_PAGE - 1)) + sizeof(struct loader_block) + UFS_PAGE - 1) & ~(UFS_PAGE - 1), VM_WIMG_WCOMB);
+	ufs_page = (volatile struct loader_block *)(base + (pa & (UFS_PAGE - 1)));
+	if (ufs_page->magic != BLOCK_MAGIC || ufs_page->version != BLOCK_VERSION ||
+	    ufs_page->size != sizeof(struct loader_block) || ufs_page->parts > BLOCK_MAX_PARTS) {
+		printf("ufs: the loader's page at %llx is not one this kernel knows (magic %llx, version %u, size %u)\n",
+		    pa, ufs_page->magic, ufs_page->version, ufs_page->size);
+		return;
+	}
+	ufs_parts = ufs_page->parts;
+	ufs_buffer_size = ufs_page->buffer_size;
+	buffer_pa = ufs_page->buffer_pa;
+	ufs_buffer = (const uint8_t *)(ml_io_map_unmappable((vm_offset_t)(buffer_pa & ~(UFS_PAGE - 1)),
+	    ((buffer_pa & (UFS_PAGE - 1)) + ufs_buffer_size + UFS_PAGE - 1) & ~(UFS_PAGE - 1), VM_WIMG_DEFAULT) +
+	    (buffer_pa & (UFS_PAGE - 1)));
+	ufs_seq = ufs_page->answer.answered;      /* a loader that served an earlier kernel counts on from there */
+
+	ufs_bmajor = bdevsw_add(-1, &ufs_bdevsw);
+	ufs_cmajor = ufs_bmajor < 0 ? -1 : cdevsw_add_with_bdev(-1, &ufs_cdevsw, ufs_bmajor);
+	if (ufs_cmajor < 0) {
+		printf("ufs: no device numbers to be had\n");
+		return;
+	}
+	for (uint32_t i = 0; i < ufs_parts; i++) {
+		char name[48];
+
+		ufs_bsize[i] = ufs_page->part[i].block_size;
+		if (ufs_page->part[i].flags & BLOCK_PART_UNIT) {
+			continue;               /* the units are for this kernel's own driver to be checked against */
+		}
+		snprintf(name, sizeof(name), "ufs_%s", ufs_page->part[i].name);
+		if (devfs_make_node(makedev(ufs_bmajor, i), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "%s", name) == NULL) {
+			printf("ufs: no node for %s (the same name twice?)\n", name);
+			continue;
+		}
+		snprintf(name, sizeof(name), "rufs_%s", ufs_page->part[i].name);
+		(void)devfs_make_node(makedev(ufs_cmajor, i), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "%s", name);
+		made++;
+	}
+	ufs_ready = true;
+	printf("ufs: %u partitions of the phone's storage as /dev/ufs_NAME and /dev/rufs_NAME, read only, "
+	    "through the loader's page at %llx and its %u KB buffer\n", made, pa, ufs_buffer_size >> 10);
+
+	/*
+	 * ufs_write=1: /dev/rufs_darwin takes writes, past the iOS volume and the cryptexes. darwin
+	 * has to be the partition the port was set up with, in everything the loader's table says of
+	 * it; the loader looks at its GUIDs besides, and refuses the same bounds of its own accord.
+	 */
+	check = 0;
+	if (PE_parse_boot_argn("ufs_write", &check, sizeof(check)) && check == 1) {
+		uint32_t offered = ufs_page->write_part_plus_one;
+
+		if (offered == 0 || offered > ufs_parts || ufs_page->write_first != UFS_WRITE_FIRST) {
+			printf("ufs: the loader offers no partition to write into (ufs_write=1 on its command "
+			    "line too, and a loader that knows about writes)\n");
+		}
+		for (uint32_t i = 0; offered != 0 && i < ufs_parts; i++) {
+			const char *why = NULL;
+
+			if (strncmp((const char *)ufs_page->part[i].name, "darwin", 7) != 0) {
+				continue;
+			}
+			if (i != offered - 1) {
+				why = "the loader offers another partition";
+			} else if (ufs_page->part[i].flags & BLOCK_PART_UNIT) {
+				why = "it is a whole logical unit, not the partition";
+			} else if (ufs_page->part[i].unit != 0) {
+				/* the first unit UEFI lists, which this kernel's own driver reads as LUN 0 and
+				 * has compared with the loader's reads; the device path this firmware gives
+				 * says no logical unit number at all, so part[].lun is 0xff for every unit */
+				why = "it is not on the first logical unit";
+			} else if (ufs_page->part[i].start_lba != UFS_DARWIN_FIRST) {
+				why = "it does not begin where it did";
+			} else if (ufs_page->part[i].blocks != UFS_DARWIN_BLOCKS) {
+				why = "it is not the size it was";
+			} else if (ufs_page->part[i].block_size != 4096) {
+				why = "its blocks are not 4096 bytes";
+			}
+			if (why != NULL) {
+				printf("ufs: darwin: no write will be asked for: %s\n", why);
+				continue;
+			}
+			ufs_write_part = (int)i;
+		}
+		if (ufs_write_part >= 0) {
+			printf("ufs: /dev/rufs_darwin takes writes, whole blocks from %llu on (%llu MB of it); "
+			    "everything else of the storage is read only\n", UFS_WRITE_FIRST,
+			    (UFS_DARWIN_BLOCKS - UFS_WRITE_FIRST) * 4096 >> 20);
+		} else {
+			printf("ufs: nothing takes writes: darwin is not among the partitions\n");
+		}
+	}
+
+	/*
+	 * ufs_native=1: through this kernel's own driver instead, its own transfer list in the
+	 * controller for the run, if all is as expected; 2: only look; 3: a dry run -- the list in and
+	 * out again, and in once more for the end of the run to take out, no command sent.
+	 */
+	check = 0;
+	memset(ufs_lun, 0xff, sizeof(ufs_lun));
+	if (PE_parse_boot_argn("ufs_native", &check, sizeof(check)) && check != 0) {
+		struct ufshc_loader offer = {
+			.hc_pa = ufs_page->native.hc_pa, .area_pa = ufs_page->native.area_pa,
+			.area_size = ufs_page->native.area_size, .ucd_offset = ufs_page->native.ucd_offset,
+			.ucd_size = ufs_page->native.ucd_size, .slots = ufs_page->native.slots,
+			.uefi_lo = ufs_page->native.uefi_utrlba, .uefi_hi = ufs_page->native.uefi_utrlbau,
+			.take_back = &ufs_page->loader_native.take_back, .list_in = &ufs_page->kernel_native.list_in,
+			.switched_in = (uint32_t *)&ufs_page->kernel_native.switched_in,
+			.switched_out = (uint32_t *)&ufs_page->kernel_native.switched_out,
+			.cnr_at_switch = &ufs_page->kernel_native.cnr_at_switch,
+		};
+		uint32_t mode = check, compare = 0;
+
+		PE_parse_boot_argn("ufs_native_check", &compare, sizeof(compare));
+		if (!ufshc_probe(&offer, mode == 2)) {
+			if (mode != 2) {
+				printf("ufs: this kernel's own UFS driver is not used: through the loader\n");
+			}
+		} else if (mode == 3) {
+			printf("ufs: native: dry run: this kernel's list in and out, no command\n");
+			if (ufs_native_in(false) == 0) {
+				IOSleep(1000);
+				ufs_native_out("dry run");
+				IOSleep(500);
+				ufs_native_in(false);
+				printf("ufs: native: dry run: the list stays in for the end of the run\n");
+			}
+		} else if (ufs_native_map(true)) {
+			ufs_native_mapped = true;
+			if (compare != 0) {
+				/* right here, in bsd_init's thread, and then back to the loader */
+				ufs_native_check();
+				redwood_ufs_report("after the check");
+				loader_return();
+			}
+			ufs_native_on = true;
+			compare = 0;
+			if (PE_parse_boot_argn("ufs_native_bench", &compare, sizeof(compare)) && compare != 0) {
+				ufs_native_bench();
+				redwood_ufs_report("after the bench");
+				loader_return();
+			}
+			printf("ufs: the partitions (LUN 0-%u) are read by this kernel's own UFS driver, its list in the "
+			    "controller (kern.redwood.ufs_native=0: through the loader)\n", ufs_native_luns - 1);
+		} else {
+			printf("ufs: this kernel's own UFS driver is not used: through the loader\n");
+		}
+	}
+
+	if (PE_parse_boot_argn("ufs_bench", &check, sizeof(check)) && check != 0) {
+		/* right here, in bsd_init's thread, and then back to the loader: nothing else is wanted */
+		ufs_bench(NULL, THREAD_AWAKENED);
+		loader_return();
+	}
+	check = 0;
+	if (PE_parse_boot_argn("ufs_check", &check, sizeof(check)) && check == 2) {
+		/* right here, whichever way the partitions are read (ufs_native=), and back to the loader */
+		ufs_check((void *)1, THREAD_AWAKENED);
+		redwood_ufs_report("after the check");
+		loader_return();
+	}
+	if (check == 1) {
+		thread_t thread;
+
+		if (kernel_thread_start(ufs_check, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+}
+
+/*
+ * The run is ending (loader_return, before the other processors are stopped): nothing more is asked
+ * of the loader, and a request it has not answered yet is waited for (2 s at most), so that the loader
+ * is never in the middle of a read of the storage while this kernel takes the processors and the
+ * interrupt controller away -- which, with the system volume read from the storage (DSU=2), it was.
+ */
+void
+redwood_ufs_close(void)
+{
+	uint64_t deadline;
+
+	if (ufs_page == NULL) {
+		return;
+	}
+	ufs_closing = true;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+	while (ufs_page->answer.answered != ufs_page->ask.request && mach_absolute_time() < deadline) {
+		__builtin_arm_yield();
+	}
+}
diff --git a/bsd/dev/redwood_ufshc.c b/bsd/dev/redwood_ufshc.c
new file mode 100644
index 0000000000000000000000000000000000000000..54c3b4e0f9044e0d3542ac617260106e4dc1825c
--- /dev/null
+++ b/bsd/dev/redwood_ufshc.c
@@ -0,0 +1,1334 @@
+/*
+ * The phone's UFS host controller, driven from this kernel -- read only, next to UEFI's driver.
+ *
+ * Reading the storage through the loader (redwood_ufs.c) is one request at a time: Qualcomm's
+ * UFSDxe reads synchronously on core 0, and its transfer request list has room for one request
+ * only (UTRLBA points at a single descriptor, with UFSDxe's command descriptor right behind it,
+ * where slots 8.. would be). The controller takes 32 at once. So for the length of a run this
+ * kernel puts a list of its own into the controller: with nothing in flight, the list is stopped
+ * (UTRLRSR 0), UTRLBA/UTRLBAU are pointed at the new one, the list is started again; at the end
+ * (redwood_ufs_quiesce, from loader_return), what is in flight is waited for, the list stopped,
+ * UEFI's address written back, the list started. The list and its command descriptors are in
+ * memory the loader owns (it offers it in its page, with UEFI's address); the loader checks the
+ * address on every way back from a run and puts UEFI's back itself if the kernel did not
+ * (xnuloader/loader.c, hc_take_back), and neither reads nor writes for the kernel or for its log
+ * while another list is in. While this kernel's list is in, it asks the loader for nothing.
+ *
+ * Nothing else of the controller is changed: no reset, no link startup, no UIC command, no
+ * interrupt enable, aggregation, clock or power setting; the task management list is not
+ * touched; IS and UTRLCNR are only read. UTRLCLR is written only to clear this kernel's own
+ * slots when they do not finish at the end.
+ *
+ * Read only by construction: a command is made in a buffer of its own, and only one that passes
+ * ufshc_permitted() is ever written into a slot; what the slot then holds is read back and must
+ * be the same and pass again before the doorbell is rung. The whitelist checks three things of
+ * every command: the SCSI operation (READ(10)/READ(16), TEST UNIT READY, REQUEST SENSE, INQUIRY,
+ * READ CAPACITY(10/16), nothing else -- no query, no task management, no NOP), the data
+ * direction in the request descriptor (from the device or none, never to it), and the command
+ * UPIU's flags (never W); and the logical unit: never a well-known one (REPORT LUNS, BOOT, RPMB,
+ * the device), and only those reads are allowed to go to now (ufshc_set_luns: LUN 0, where the
+ * iOS volume is, unless a comparison with the loader's reads asks for more). A read's length in
+ * the CDB must be what the UPIU expects. It is tried at the probe on made-up commands that must
+ * pass or be refused. This file builds READ(10) and TEST UNIT READY only.
+ *
+ * Every slot of this list holds a whitelisted command at all times: TEST UNIT READY until it is
+ * used for a read. Slot 0 is kept for the proof that the controller does read this list: after
+ * every switch, before any read, slot 0's TEST UNIT READY is rung and must come back in this
+ * list (its status written here). Were the controller still reading UEFI's list, the doorbell
+ * would run UEFI's slot 0 instead -- so first UEFI's slot 0 must hold a read too (it does: the
+ * loader's last use of the storage before a run is reading back the log it wrote), and the
+ * proof costs nothing either way. Reads go in slots 1..31.
+ *
+ * The doorbell is rung only with interrupts off, after looking that this kernel's list is the
+ * one in the controller and running, that the slot is free, and that the loader is not taking
+ * the controller back (it says so in its page, then waits before it does).
+ *
+ * The list and the command descriptors are mapped here without caching (nothing of them is ever
+ * in a cache line of this kernel's to be written back over what the controller writes); the data
+ * buffers are this kernel's memory, cleaned and invalidated around every read.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <stdarg.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>  /* xnu-12377: KMA_*/kmem_alloc moved to the internal header */
+#include <vm/memory_types.h>
