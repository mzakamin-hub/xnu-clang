+static bool
+amp_levels(unsigned d, const char *when, bool fix)
+{
+	unsigned a = amp_dev[d].addr;
+	int32_t g = amp_read_retry(a, 0x5f), v = amp_read_retry(a, 0x76), l[4];
+	bool read_ok = g >= 0 && v >= 0, lim_ok = true, loud;
+
+	for (unsigned i = 0; i < 4; i++) {
+		l[i] = amp_read_retry(a, (uint8_t)amp_stock_lim[i][0]);
+		read_ok &= l[i] >= 0;
+		lim_ok &= l[i] == (int32_t)amp_stock_lim[i][1];
+	}
+	loud = read_ok && (((g >> 5) & 0x1f) < 5 || (uint32_t)((v >> 8) & 0xff) > amp_dcvos);
