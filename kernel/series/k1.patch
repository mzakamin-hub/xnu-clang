+static void
+stderr_log_fd_desc(struct proc *p, int fd, char *desc, size_t desclen)
+{
+	struct fileproc *fp = NULL;
+	vnode_t vp = NULL;
+	char path[MAXPATHLEN];
+	int len = MAXPATHLEN;   /* vn_getpath takes the buffer size on input */
