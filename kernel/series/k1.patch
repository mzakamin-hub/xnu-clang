+		    io_rd(bar, dbg + 0x28), io_rd(bar, dbg + 0x2c), io_rd(bar, dbg + 0x30), io_rd(bar, dbg + 0x34), io_rd(bar, dbg + 0x38),
+		    io_rd(bar, dbg + 0x3c));
