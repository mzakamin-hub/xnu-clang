+#define E5W(base, who, o, val) do { *(volatile uint32_t *)((base) + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: 23e5f %s +%#x <- %08x (read back %08x)\n", who, (uint32_t)(o), (uint32_t)(val), io_rd(base, o)); } while (0)
