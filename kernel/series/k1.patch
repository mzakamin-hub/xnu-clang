+/* w5-bt: the map entry that holds addr, and the object/file offset of addr in it */
+static void
+icepac_where(uint64_t addr, const char *what)
+{
+	VM_MAP_FIND_LOCK_CTX_DECLARE(ctx);
+	vm_map_t       map = current_map();
+	vm_map_entry_t entry;
+	kern_return_t  kr;
+	uint64_t       a = addr & 0x00007fffffffffffULL;
+
+	if (map == VM_MAP_NULL) {
+		printf("icepac: %s 0x%llx: no map\n", what, (unsigned long long)a);
+		return;
+	}
+	kr = vm_map_find_entry_sh_locked(ctx, &map, a, VMRL_FIND_SH_DEFAULT);
+	if (kr != KERN_SUCCESS) {
+		printf("icepac: %s 0x%llx: no entry (0x%x)\n", what, (unsigned long long)a, kr);
+		return;
+	}
+	entry = vm_map_found_entry_get_entry(ctx);
+	if (entry->is_sub_map) {
+		printf("icepac: %s 0x%llx: submap 0x%llx-0x%llx (shared region)\n", what,
+		    (unsigned long long)a, (unsigned long long)entry->vme_start,
+		    (unsigned long long)entry->vme_end);
+	} else {
+		vm_object_offset_t off = VME_OFFSET(entry);
+
+		printf("icepac: %s 0x%llx: entry 0x%llx-0x%llx +0x%llx obj 0x%llx file 0x%llx\n", what,
+		    (unsigned long long)a, (unsigned long long)entry->vme_start,
+		    (unsigned long long)entry->vme_end, (unsigned long long)(a - entry->vme_start),
+		    (unsigned long long)off, (unsigned long long)(off + (a - entry->vme_start)));
+	}
+	vm_map_found_entry_sh_unlock(ctx, &map);
+}
