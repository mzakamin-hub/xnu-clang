+volatile int native_owner_launchd_disable_status = -1;
+/* the kernel has no strstr: the first NEEDLE in HAYSTACK, or NULL */
+static char *
+native_launchd_strstr(const char *haystack, const char *needle)
+{
+	const size_t n = strlen(needle);
+	for (const char *h = haystack; *h != 0; h++) {
+		if (strncmp(h, needle, n) == 0) {
+			return __DECONST(char *, h);
+		}
+	}
+	return NULL;
+}
+static const char native_launchd_curated[] =
+	"com.apple.photoanalysisd,com.apple.mediaanalysisd,com.apple.coreduetd,"
+	"com.apple.identityservicesd,com.apple.fairplayd.A2,com.apple.passd,"
+	"com.apple.mobile.obliteration,com.apple.mediastream.mstreamd,"
+	"com.apple.icloud.searchpartyd,com.apple.findmy.findmybeaconingd,"
+	"com.apple.familycircled,com.apple.financed,com.apple.softwareupdateservicesd,"
+	"com.apple.ndoagent,com.apple.biomesyncd,com.apple.email.maild,com.apple.amsengagementd,"
+	"com.apple.adid,com.apple.eyereliefd,com.apple.siriknowledged,com.apple.siriinferenced,"
+	"com.apple.siriactionsd,com.apple.duetexpertd,com.apple.modelcatalogd,"
+	"com.apple.PerfPowerServicesExtended,com.apple.perfpowermetricd,"
+	"com.apple.ReportCrashService,com.apple.diagnosticservicesd";
+/* gains2 (icecrash=1): a label found disabled is set back to <false/>: 1 lifted, 0 not there or not disabled, -1 no room */
+static int
+native_launchd_lift(char *out, size_t room, const char *label, char *lifted, size_t list_room)
+{
+	char key[96];
+	const size_t length = strnlen(label, 64);
+	char *at, *v;
+
+	if (length == 0 || length >= 64) {
+		return 0;
+	}
+	snprintf(key, sizeof(key), "<key>%.*s</key>", (int)length, label);
+	at = native_launchd_strstr(out, key);
+	if (at == NULL) {
+		return 0;
+	}
+	v = at + strlen(key);
+	while (*v == ' ' || *v == '\t' || *v == '\n' || *v == '\r') {
+		v++;
+	}
+	if (strncmp(v, "<true/>", 7) != 0) {
+		return 0;
+	}
+	if (strlen(out) + 2 > room) {
+		return -1;
+	}
+	memmove(v + 8, v + 7, strlen(v + 7) + 1);
+	memcpy(v, "<false/>", 8);
+	if (strlen(lifted) + length + 2 <= list_room) {
+		strlcat(lifted, lifted[0] ? "," : "", list_room);
+		strlcat(lifted, label, list_room);
+	}
+	return 1;
+}
+/* one launchd label into the merged dictionary: 0 added, 1 flipped from <false/>, 2 already disabled, -1 skipped. The
+ * label (already "com.apple.<name>") is the key content and the name recorded in added/flipped/kept; a list keeps whole
+ * names only, so a full one never truncates mid-name. The add buffer is the insert made before the last </dict>. */
+static int
+native_launchd_merge(char *out, const char *label, char *add, size_t add_room, char *added, char *flipped, char *kept,
+    size_t list_room)
+{
+	char key[96];
+	const size_t length = strnlen(label, 64);
+	char *at;
+
+	if (length == 0 || length >= 64) {
+		return -1;
+	}
+	snprintf(key, sizeof(key), "<key>%.*s</key>", (int)length, label);
+	at = native_launchd_strstr(out, key);
+	if (at == NULL) {
+		if (strlen(add) + length + 32 >= add_room) {
+			return -1;              /* no room for this key in the insert: never a malformed plist */
+		}
+		strlcat(add, "\t", add_room);
+		strlcat(add, key, add_room);
+		strlcat(add, "\n\t<true/>\n", add_room);
+		if (strlen(added) + length + 2 <= list_room) {
+			strlcat(added, added[0] ? "," : "", list_room);
+			strlcat(added, label, list_room);
+		}
+		return 0;
+	}
+	char *v = at + strlen(key);
+	while (*v == ' ' || *v == '\t' || *v == '\n' || *v == '\r') {
+		v++;
+	}
+	int result = 2;
+	char *list = kept;
+	if (strncmp(v, "<false/>", 8) == 0) {
+		memmove(v + 7, v + 8, strlen(v + 8) + 1);
+		memcpy(v, "<true/>", 7);
+		result = 1;
+		list = flipped;
+	}
+	if (strlen(list) + length + 2 <= list_room) {
+		strlcat(list, list[0] ? "," : "", list_room);
+		strlcat(list, label, list_room);
+	}
+	return result;
+}
+static void
