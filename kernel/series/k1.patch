+/*
+ * ---- icespmi=6 (kit 23f4, CLASS C: the WCN7860's BT firmware over the 23f3 GPIO UART at 115200) --------------------
+ * btqca qca_uart_setup for QCA_WCN7860 (soc_id 0x40210200, ROM 0x0200 -> rom_ver 0x20), after 23f3's version request:
+ *   rampatch fw/brhbtfw20.mbn (ELF_TYPE_PATCH, sha256 74ee832c... = iceland-firmware qca/brhbtfw20.mbn): the whole
+ *   file in 243-byte segments, each the H4 command 01 00 fc <n+2> 1e <n> <data> (EDL_PATCH_TLV_REQ_CMD); download mode
+ *   SKIP_EVT_VSE_CC: no reply to any segment but the last, which gets a command complete (opcode fc00, rtype 0x1e);
+ *   10 ms; board id (EDL 0x23: bid = data[1] << 8 | data[2]) -> NVM fw/brhbtnv20.b<bid %02x>, or brhbtnv20.bin for bid
+ *   0 / 0xffff or a missing file (qca_get_alt_nvm_file); its sha256 must be one of iceland-firmware's four NVM
+ *   contents; TLV_TYPE_NVM: same segment command, each one answered (command complete, rtype 0x1e) before the next.
+ *   NVM tags changed in our copy (btqca changes the same tags): 17 (HCI) data[0] bit 7 (in-band sleep) CLEARED (Linux
+ *   sets it), data[1] (UART baud) = 0 = QCA_BAUDRATE_115200 (file: 0x11 = 3.2 Mbaud; Linux writes its operating
+ *   speed); 27 (deep sleep) data[0] bit 0 CLEARED (file and Linux: set) - no IBS wake protocol on our side. The BD
+ *   address tag (2) is sent as in the file and never logged; Read_BD_ADDR is not sent.
+ *   then QCA_DISABLE_LOGGING (01 17 fc 02 14 00), HCI_Reset, EDL 0x20 build info, HCI Read_Local_Version (01 01 10 00).
+ * TX with interrupts off per command (<= ~22 ms for 248 bytes); RX captured in 20 ms interrupts-off windows, edges
+ * time-stamped on one clock across windows (the gap between windows is logged as the largest sample gap).
+ * Writes: none beyond 23f3's (gpio26 io / ctl, then put back); the chip's RAM patch is volatile (bt-enable low at
+ * 23f2's undo resets it).
+ */
+static const uint8_t f4_fw_sha[32] = {
+	0x74, 0xee, 0x83, 0x2c, 0xd7, 0x24, 0xfb, 0x6a, 0x43, 0x91, 0xbc, 0x06, 0xf4, 0xb0, 0xd9, 0x69,
+	0x7d, 0x36, 0xb4, 0x60, 0xe7, 0xf4, 0xb1, 0x4f, 0xb6, 0xbc, 0x14, 0xb6, 0x9e, 0x7c, 0xc2, 0x87,
+};
+static const uint8_t f4_nvm_sha[4][32] = {
+	{ 0xaa, 0xa2, 0x26, 0x1d, 0x86, 0xb7, 0x9d, 0xa1, 0x56, 0x1a, 0xc6, 0x42, 0xf5, 0x92, 0x50, 0x6a,
+	  0x3d, 0x4d, 0x7d, 0x71, 0xb7, 0xd2, 0x87, 0x73, 0x06, 0x33, 0x4f, 0xbc, 0xe4, 0x39, 0xd8, 0x60 },   /* .b2e */
+	{ 0x83, 0xda, 0xa4, 0x43, 0x10, 0x1d, 0x92, 0x8b, 0x47, 0x8c, 0x0a, 0x8e, 0xd9, 0xaa, 0x64, 0x0e,
+	  0x4f, 0xed, 0x37, 0x4e, 0x3a, 0x62, 0x01, 0x90, 0x09, 0x3e, 0x01, 0x76, 0x42, 0xd0, 0xd4, 0x06 },   /* .b34-39 .b41 .b44 .b46 .b47 */
+	{ 0x06, 0x90, 0xba, 0x88, 0x94, 0x98, 0xdc, 0x37, 0xd7, 0x61, 0x1d, 0x0b, 0x8f, 0x37, 0x43, 0xd3,
+	  0xb2, 0x25, 0xb1, 0xfd, 0xd4, 0xfd, 0xf3, 0xf6, 0x8e, 0x60, 0x46, 0x1d, 0x50, 0x97, 0xe1, 0x7a },   /* .b3e */
+	{ 0x96, 0x71, 0xc2, 0xf0, 0xc1, 0xa8, 0x60, 0xd0, 0xc4, 0x95, 0x5e, 0x04, 0x27, 0xc5, 0x1b, 0x0f,
+	  0x8a, 0xe1, 0x77, 0xb7, 0x3f, 0xb2, 0xa9, 0x33, 0xb8, 0x38, 0x10, 0x2a, 0x5f, 0x05, 0x56, 0x98 },   /* .bin */
+};
+static uint8_t f4_nvm[16384];
