+	const CS_CodeDirectory *cd = pass->cd;
+	const struct cs_hash *md = pass->md;
+	const struct cs_blob *blob = pass->blob;
+	uint8_t *buffer = kalloc_data(CS_NATIVE4K_CHUNK, Z_WAITOK);
+	int error = 0;
+
+	if (buffer == NULL) {
+		error = ENOMEM;
+	}
+	while (error == 0 && os_atomic_load(&pass->error, relaxed) == 0) {
+		const uint64_t chunk = os_atomic_add_orig(&pass->next, (uint64_t)CS_NATIVE4K_CHUNK, relaxed);
+		if (chunk >= pass->limit) {
+			break;
+		}
+		size_t chunk_length = MIN((uint64_t)CS_NATIVE4K_CHUNK, pass->limit - chunk);
+		int resid = 0;
+		off_t position;
+		if (os_add_overflow(blob->csb_base_offset, (off_t)chunk, &position)) {
+			error = EOVERFLOW;
+			break;
+		}
+		const uint64_t read_start = mach_absolute_time();
