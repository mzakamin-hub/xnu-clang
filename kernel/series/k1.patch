+
+IOReturn
+IcelandAudioUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a, IOExternalMethodDispatch *,
+    OSObject *, void *)
+{
+	iceland_audio_dev_selectors = iceland_audio_dev_selectors + 1;
+	switch (selector) {
+	case 0: case 10: {                                      // StartIO, StartIOWithFlags
+		IOReturn r = device->startIO();
+		if (r == kIOReturnSuccess) {
+			startedIO = true;
+		}
+		if (selector == 10 && a->scalarOutputCount >= 1) {
+			a->scalarOutput[0] = 0;
+			a->scalarOutputCount = 1;
+		}
+		return r;
+	}
+	case 1: case 11:                                        // StopIO, StopIOWithFlags
+		startedIO = false;
+		return device->stopIO();
+	case 2:                                                 // SetControlValue: no controls are published
+		if (gUnknownLogged < 16) {
+			gUnknownLogged++;
+			IOLog("icesnddev: SetControlValue on %s (%u scalars: %#llx %#llx, %u bytes): no control is published\n",
+			    device->isInput ? "Mic" : "Speaker", a->scalarInputCount, a->scalarInputCount > 0 ? a->scalarInput[0] : 0,
+			    a->scalarInputCount > 1 ? a->scalarInput[1] : 0, a->structureInputSize);
+		}
+		return kIOReturnBadArgument;
+	case 3:                                                 // PerformConfigChange: none is ever requested
+		return kIOReturnSuccess;
+	case 4: {                                               // SetNominalSampleRate: the one rate there is
+		int64_t rate = 0;
+		if (a->structureInputSize == sizeof(rate)) {
+			memcpy(&rate, a->structureInput, sizeof(rate));
+		}
+		return rate == fixed64(kRate) ? kIOReturnSuccess : kIOReturnUnsupported;
+	}
+	case 5: {                                               // SetStreamCurrentFormat: only the published format
+		struct {
+			int64_t rate;
+			uint32_t id, flags, bytesPerPacket, framesPerPacket, bytesPerFrame, channels, bits, reserved;
+		} f;
+		if (a->scalarInputCount < 1 || a->structureInputSize != sizeof(f)) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(&f, a->structureInput, sizeof(f));
+		return f.rate == fixed64(kRate) && f.id == kFormatLinearPCM && f.channels == device->channels() && f.bits == 16
+		       ? kIOReturnSuccess : kIOReturnUnsupported;
+	}
+	case 6: case 12:                                        // SetStreamActive, SetClientDescription
+		return kIOReturnSuccess;
+	default:
+		iceland_audio_dev_bad_selectors = iceland_audio_dev_bad_selectors + 1;
+		if (gUnknownLogged < 16) {
+			gUnknownLogged++;
+			IOLog("icesnddev: selector %u is not one this device knows (%u scalars, %u bytes)\n", selector,
+			    a->scalarInputCount, a->structureInputSize);
+		}
+		return kIOReturnUnsupported;
+	}
+}
