+
+#define say(...)        printf("icebt: " __VA_ARGS__)
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);              /* bt4: SMEM, read once */
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void IOSleep(unsigned int milliseconds);
+extern uint32_t psci_smp_hvc;                                    /* 1 = QEMU's virt, not the Pad */
+extern int hakios_iceland_wcn_rails_get(const char *who);                                /* hakios_iceland_pcie.c */
+extern void hakios_iceland_wcn_rails_put(const char *who);
+extern const uint8_t *hakios_iceland_wifi_blob(const char *name, uint64_t *size);        /* hakios_iceland_pcie.c */
+
+void hakios_iceland_bt_init(void);
+void hakios_iceland_bt_stop(void);
+void hakios_iceland_bt_quiesce(void);
+
+#define GCC_PA          0x00100000u
+#define TLMM_PA         0x0f100000u
+#define QUP3_PA         0x019c0000u
+#define SE5_PA          0x01994000u
+#define S5_RCG          0xa8640u
+#define GCC_VOTE        0x52018u
+#define BT_PPID         0x98cu          /* SID 9, peripheral 0x8c: GPIO 5 */
+
+/* what is done, for the undo */
+#define D_GPIO  0x01u   /* the PMIC pin's configuration written */
+#define D_EN    0x02u   /* bt-enable high */
+#define D_S5    0x04u   /* the S5 branch vote set here */
+#define D_SE    0x08u   /* SE5's registers written */
+#define D_PADS  0x10u   /* gpio24-27 muxed to the engine */
+#define D_RAIL  0x20u   /* the PMU's rails taken (hakios_iceland_wcn_rails_get) */
+
+static volatile uint32_t done, down_once, stop_req, busy, quiesced;
+static vm_offset_t gcc, se, pad[4], obsv, chnv;
+static uint32_t pad0[4], vote0;
+static int apid = -1;
+static struct {
+	int mode, vin, pull, src;
+} pin0;                                 /* the PMIC pin as found */
+/* bt4: Linux's NVM edits and in-band sleep (the bt4 block after the RX state); stage b tells stage d what it applied, and once
+ * the chip's in-band sleep is on, a wake byte it sends between two packets is acknowledged wherever the bytes are read */
+static uint32_t b4_nvm(uint8_t *nv, uint32_t nsz, uint32_t mode, uint8_t baud);
+static void b4_note_nvm(uint32_t done);
+static bool b4_here(void);
+static bool b4_chip_ibs(void);
+static void b4_chip_byte(uint8_t b);
+
+/*
+ * laneD (23 Nov): the bt2..bt4 kit, OFF by default. icebt4=1 on a line (or the lane's umbrella iceld=<ids> holding '1')
+ * gives icebt_pair, icebt_lesec, icebt_lepb, icebt_lefix, icebt_rxlog, icebt_iso2acl, icebt_bdaddr, icebt_nvm, icebt_ibs
+ * (and kern_exec.c's icebt_t0) bt4a's values; each word on the line still wins. Without it all of them are 0: install65.
+ */
+extern int PE_iceland_laned(char id);
+
+static uint32_t
+b4_kit(void)
+{
+	uint32_t kit = 0;
+
+	if (!PE_parse_boot_argn("icebt4", &kit, sizeof(kit))) {
+		kit = PE_iceland_laned('1') ? 1 : 0;
+	}
+	return kit;
+}
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* a logged write: the value before, the value written, the read-back */
+static void
+pw(vm_offset_t b, const char *n, uint32_t o, uint32_t v)
+{
+	uint32_t was = rd(b, o);
+
+	wr(b, o, v);
+	say("%s +%x %08x > %08x = %08x\n", n, o, was, v, rd(b, o));
+}
+
+static vm_offset_t
+iomap(uint64_t pa, vm_size_t n)
+{
+	return ml_io_map_unmappable((vm_offset_t)pa, n, VM_WIMG_IO);
+}
+
+/* from the thread: sleep; on the way back to the loader (interrupts may be off, the other cores stopped): spin */
+static void
+nap(uint32_t ms)
+{
+	if (quiesced) {
+		delay((int)ms * 1000);
+	} else {
+		IOSleep(ms);
+	}
+}
+
+/* ---- the PMIC pin, through the SPMI arbiter (v8), as hakios_iceland_harvest.c f2_* and hakios_iceland_buttons.c ---- */
+static int
+spmi_rd(uint8_t reg)
+{
+	uint32_t st = 0;
+	int v;
+
+	if (!quiesced) {
+		redwood_spmi_lock();
+	}
+	wr(obsv, 0x0, 1u << 27 | (uint32_t)reg << 4);   /* extended read long, one byte */
+	for (int t = 0; t < 100; t++) {
+		st = rd(obsv, 0x8);
+		if (st & 1) {
+			break;
+		}
+		delay(10);
+	}
+	v = st == 1 ? (int)(rd(obsv, 0x18) & 0xff) : -1;
+	if (!quiesced) {
+		redwood_spmi_unlock();
+	}
+	return v;
+}
+
+static bool
+spmi_wr(const char *name, uint8_t reg, uint8_t val)
+{
+	int was = spmi_rd(reg), rb;
+	uint32_t st = 0;
+
+	if (!quiesced) {
+		redwood_spmi_lock();
+	}
+	wr(chnv, 0x10, val);                            /* WDATA0 */
+	wr(chnv, 0x0, (uint32_t)reg << 4);              /* extended write long, one byte */
+	for (int t = 0; t < 1000; t++) {
+		st = rd(chnv, 0x8);
+		if (st & 1) {
+			break;
+		}
+		delay(1);
+	}
+	if (!quiesced) {
+		redwood_spmi_unlock();
+	}
+	rb = spmi_rd(reg);
+	say("spmi %s 0x8c%02x %02x > %02x = %02x (status %08x: %s)\n", name, reg, (uint32_t)was & 0xff, val, (uint32_t)rb & 0xff, st,
+	    st == 1 ? "done" : "NOT done / failed / denied / dropped");
+	return st == 1 && rb == (int)val;
+}
+
+/* reads only: bus 1's APID for PPID 0x98c and its owner; false = no channel this kernel may write */
+static bool
+spmi_resolve(void)
+{
+	vm_offset_t core = iomap(0x0c400000u, 0x3000), map = iomap(0x0c403000u, 0x8000), own1 = iomap(0x0c43b000u, 0x8000);
+	uint32_t ver, base, cnt, owner = ~0u, o, c;
+	int chosen = -1;
+
+	if (core == 0 || map == 0 || own1 == 0) {
+		say("REFUSED: the SPMI arbiter is not mapped\n");
+		return false;
+	}
+	ver = rd(core, 0);
+	base = rd(core, 0x4) & 0x1fff;
+	cnt = rd(core, 0x8) & 0x1fff;
+	say("spmi arbiter version %08x; bus 1 = APIDs %u..%u\n", ver, base, base + cnt - 1);
+	if ((ver >> 28) != 8 || cnt == 0 || base + cnt > 0x2000 || 4 * cnt > 0x8000) {
+		say("REFUSED: not a v8 arbiter, or bus 1's APID range is not usable\n");
+		return false;
+	}
+	for (uint32_t n = base; n < base + cnt; n++) {
+		uint32_t v = rd(map, 4 * n), w;
+
+		if (v == 0 || (v & 0x1fff) != BT_PPID) {
+			continue;
+		}
+		w = rd(own1, 4 * (n - base));
+		say("spmi APID %u maps PPID 0x98c (map %08x), owner EE %u\n", n, v, w & 7);
+		if (chosen < 0 || (w & 7) == 0) {       /* the first mapping, or the one this EE owns */
+			chosen = (int)n;
+			owner = w;
+		}
+	}
+	if (chosen < 0 || (owner & 7) != 0) {
+		say("REFUSED: PPID 0x98c %s: no write\n", chosen < 0 ? "is not mapped on bus 1" : "is not owned by the apps (EE 0)");
+		return false;
+	}
+	o = 0x0c4c0000u + 0x20u * (uint32_t)chosen;
+	c = 0x0c900000u + 0x200u * (uint32_t)chosen;
+	obsv = iomap(o & ~0xfffu, PAGE_SIZE);
+	chnv = iomap(c & ~0xfffu, PAGE_SIZE);
+	if (obsv == 0 || chnv == 0) {
+		say("REFUSED: the APID's channels are not mapped\n");
+		return false;
+	}
+	obsv += o & 0xfff;
+	chnv += c & 0xfff;
+	apid = chosen;
+	return true;
+}
+
+static bool
+pin_found(void)
+{
+	int sub = spmi_rd(0x05), en = spmi_rd(0x46), outc = spmi_rd(0x45);
+	uint32_t pinout = 1;
+
+	pin0.mode = spmi_rd(0x40);
+	pin0.vin = spmi_rd(0x41);
+	pin0.pull = spmi_rd(0x42);
+	pin0.src = spmi_rd(0x44);
+	say("as found (APID %d): SUBTYPE %02x MODE_CTL %02x DIG_VIN %02x DIG_PULL %02x DIG_OUT_SRC %02x DIG_OUT_CTL %02x EN_CTL "
+	    "%02x RT_STS %02x\n", apid, (uint32_t)sub & 0xff, (uint32_t)pin0.mode & 0xff, (uint32_t)pin0.vin & 0xff,
+	    (uint32_t)pin0.pull & 0xff, (uint32_t)pin0.src & 0xff, (uint32_t)outc & 0xff, (uint32_t)en & 0xff,
+	    (uint32_t)spmi_rd(0x10) & 0xff);
+	/*
+	 * bt1: icebt_pinout=1 (default; 0 = install6's refusal): a pin some earlier system left as a digital output (MODE_CTL
+	 * 01: Linux's pwrseq-qcom-wcn asks for bt-enable as an output) is taken as well; bt_enable() drives it low first.
+	 */
+	(void)PE_parse_boot_argn("icebt_pinout", &pinout, sizeof(pinout));
+	if (sub != 0x12 || en != 0x80 || (pin0.mode != 0 && !(pinout && pin0.mode == 1)) || pin0.vin < 0 || pin0.pull < 0 ||
+	    pin0.src < 0) {
+		say("REFUSED: bt-enable is not an enabled LV GPIO left as an input (or a read failed): nothing written\n");
+		return false;
+	}
+	if (pin0.mode == 1) {
+		say("bt-enable was left as an output (%s): taken (icebt_pinout)\n", (pin0.src & 0x80) ? "high" : "low");
+	}
+	return true;
+}
