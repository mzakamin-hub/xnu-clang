+		if (cn.stopped || e4_now - qw.wt > 2000) {
+			say("icepcie: 46cn1a DONE: %s - vdev start %u, auth status %d, assoc status %d (AID %u), peer assoc conf %u, VDEV_UP %s, "
+			    "tx completions %u, peer delete %u, vdev stopped %u at +%d ms\n", cn.up ? "PASS (associated, VDEV_UP accepted)" :
+			    "NOT associated", cn.vstart_st, cn.auth_rx ? (int)cn.auth_st : -1, cn.assoc_rx ? (int)cn.assoc_st : -1, cn.aid,
+			    cn.peer_conf, cn.up ? "sent" : "not sent", cn.txc, cn.peer_del, cn.stopped, e4_now);
+			qw.st = 39;
+			nx_td_peer = false;
+			if (q_on >= 11 && !cn.up && e4_now < 200000 && cn_pick()) {
+				say("icepcie: 46cn1a3 the next candidate is tried\n");    /* scan116 */
+				qw.st = 60;
+				qw.wt = e4_now;
+			}
+		}
+		break;
+	default:
+		break;                  /* 25 / 39: keep receiving and logging */
+	}
+}
+
+/*
+ * states: 0 wait for the server, 1 PHY_CAP, 2 IND_REGISTER, 3 HOST_CAP, 4 wait REQUEST_MEM, 5 RESPOND_MEM, 6 wait
+ * FW_MEM_READY, 7 CAP, 8 regdb, 9 board, 10 M3_INFO, 11 AUX_UC_INFO, 12 qdss, 13 wait FW_READY, 14 done
+ */
+static void
+q_step(void)
+{
+	uint32_t o = 7;
+
+	if (!q_on || qw.stopped || qw.st == 14 || qw.st == 19 || qw.buf == 0) {
+		return;
+	}
+	if (qw.st >= 20) {
+		w_step();               /* scan83 46wm1: copy engines, HTC, WMI events */
+		return;
+	}
+	if (qw.st == 0) {
+		if (!q_srv || !e4.hello_sent) {
+			return;
+		}
+		say("icepcie: 46qm1 START: WLFW server node %u port %#x; our client node 1 port %#x; QMI arena %#llx (32 MB)\n", q_srv_node,
+		    q_srv_port, Q_PORT, q_pa);
+		if (q_va == 0) {
+			say("icepcie: 46qm1 STOP: no QMI arena\n");
+			qw.stopped = true;
+			return;
+		}
+		qw.board_id = 0xff;
+		q_req(0x57, 0, "PHY_CAP");
+		qw.st = 1;
+		return;
+	}
+	if ((qw.st == 4 && !qw.ind_mem) || (qw.st == 6 && !qw.ind_memready && !qw.ind_mem) || (qw.st == 13 && !qw.ind_ready)) {
+		if (e4_now - qw.wt > 10000) {
+			say("icepcie: 46qm1 STOP: no %s indication within 10 s (state %d)\n", qw.st == 4 ? "REQUEST_MEM" : qw.st == 6 ?
+			    "FW_MEM_READY" : "FW_READY", qw.st);
+			qw.stopped = true;
+		}
+		return;
+	}
+	if (qw.st != 4 && qw.st != 6 && qw.st != 13) {
+		if (!qw.got) {
+			if (e4_now - qw.wt > 10000) {
+				say("icepcie: 46qm1 STOP: no response to msg %#x txn %u within 10 s (state %d)\n", qw.wmsg, qw.wtxn, qw.st);
+				qw.stopped = true;
+			}
+			return;
+		}
+		qw.got = false;
+		say("icepcie: 46qm1 response to msg %#06x: result %u error %u%s\n", qw.wmsg, qw.res, qw.err, qw.res == 0 ? " (SUCCESS)" :
+		    " (FAILURE)");
+		if (qw.res != 0 && qw.st != 1 && !(qw.st == 5 && qw.delayed)) {
+			say("icepcie: 46qm1 STOP: msg %#x failed (result %u error %u)\n", qw.wmsg, qw.res, qw.err);
+			qw.stopped = true;
+			return;
+		}
+	}
+	switch (qw.st) {
+	case 1:                         /* PHY_CAP answered (a failure is only logged, as ath12k) */
+		o = q_u8(o, 0x10, 1);           /* fw_ready_enable */
+		o = q_u32(o, 0x15, 0x4b4e454cu);/* client_id */
+		o = q_u8(o, 0x16, 1);           /* request_mem_enable */
+		o = q_u8(o, 0x17, 1);           /* fw_mem_ready_enable */
+		o = q_u8(o, 0x18, 1);           /* fw_init_done_enable */
+		o = q_u8(o, 0x1b, 1);           /* cal_done_enable */
+		q_req(0x20, o - 7, "IND_REGISTER");
+		qw.st = 2;
+		break;
+	case 2:
+		o = q_u32(o, 0x10, 1);          /* num_clients */
+		o = q_u8(o, 0x13, 0x0e);        /* nm_modem: HOST_CSTATE | SLEEP_CLOCK_SELECT_INTERNAL | PCIE_GLOBAL_RESET */
+		o = q_u8(o, 0x14, 1);           /* bdf_support */
+		o = q_u8(o, 0x16, 1);           /* m3_support */
+		o = q_u8(o, 0x17, 1);           /* m3_cache_support */
+		o = q_u8(o, 0x1a, 0);           /* cal_done */
+		o = q_u8(o, 0x1c, 0);           /* mem_cfg_mode */
+		if (cn_qmlo) {
+			/*
+			 * scan138 (icecn_qmlo=1): the MLO fields Linux sends for a WCN7850-family chip whose PHY_CAP says
+			 * single_chip_mlo_support (ours: TLV 0x13 = 1, num_phy 2; no firmware-2.bin, so ath12k's mlo_capable = that bit):
+			 * ath12k_host_cap_parse_mlo - capable 1, chip id 0, group id 0, max MLO peers 32 (hw params), 1 chip, chip info
+			 * {chip 0, 2 local links, hw link ids 0 / 1, both valid} + 2 empty entries. UniXNU: without them the WCN7850
+			 * firmware fails an allocation in WMI_INIT.
+			 */
+			static const uint8_t ci[18] = { 0, 2, 0, 1, 1, 1 };
+			uint8_t u16v[2] = { 0, 0 };
+			o = q_u8(o, 0x21, 1);
+			o = q_put(o, 0x22, u16v, 2);
+			o = q_u8(o, 0x23, 0);
+			u16v[0] = 32;
+			o = q_put(o, 0x24, u16v, 2);
+			o = q_u8(o, 0x25, 1);
+			o = q_put(o, 0x26, ci, sizeof(ci));
+			say("icepcie: 46cn2e HOST_CAP + MLO fields (0x21-0x26: capable 1, chip 0, group 0, 32 MLO peers, 1 chip, 2 links), as Linux\n");
+		}
+		o = q_u64(o, 0x27, 0x50);       /* feature_list: CNSS_PCIE_PERST_NO_PULL (4) | CNSS_AUX_UC_SUPPORT (6) */
+		if (cn_qodm) {
+			/* scan138 (icecn_qodm=1): dynamic_mem_support = 1 (TLV 0x33), as UniXNU's patch sends it whatever PHY_CAP says
+			 * (Linux sends it only when PHY_CAP has TLV 0x17 = 1; ours has no 0x17) */
+			o = q_u8(o, 0x33, 1);
+			say("icepcie: 46cn2e HOST_CAP + dynamic_mem_support (TLV 0x33) = 1\n");
+		}
+		q_req(0x34, o - 7, "HOST_CAP");
+		qw.st = 3;
+		break;
+	case 3:
+		qw.st = 4;
+		qw.wt = e4_now;
+		break;
+	case 4:
+		qw.ind_mem = false;
+		q_respond_mem();
+		if (!qw.stopped) {
+			qw.st = 5;
+		}
+		break;
+	case 5:
+		qw.st = qw.delayed ? 4 : 6;
+		qw.wt = e4_now;
+		break;
+	case 6:
+		if (qw.ind_mem) {
+			qw.st = 4;               /* asked again (smaller chunks) */
+			break;
+		}
+		qw.ind_memready = false;
+		say("icepcie: 46qm1 FW_MEM_READY indication received at +%d ms\n", e4_now);
+		q_req(0x24, 0, "CAP");
+		qw.st = 7;
+		break;
+	case 7:
+		q_capdecode();
+		qw.st = q_file_start(0, 0x25, 4) ? 8 : 14;
+		break;
+	case 8:
+	case 9:
+	case 12:
+		if (qw.foff < qw.flen) {
+			q_seg();
+			break;
+		}
+		if (qw.st == 8) {
+			qw.st = q_file_start(1, 0x25, -1) ? 9 : 14;
+		} else if (qw.st == 9) {
+			qw.st = q_blob(2, 0x3c, "M3_INFO") ? 10 : 14;
+		} else {
+			qw.st = 13;
+			qw.wt = e4_now;
+			say("icepcie: 46qm1 all downloads done: waiting for FW_READY\n");
+		}
+		break;
+	case 10:
+		qw.st = q_blob(3, 0x5a, "AUX_UC_INFO") ? 11 : 14;
+		break;
+	case 11:
+		qw.st = q_file_start(4, 0x44, 0) ? 12 : 14;
+		break;
+	case 13:
+		say("icepcie: 46qm1 DONE: FW_READY at +%d ms - %u requests, %u QMI messages received, %u RESUME_TX; chip %#x board %#x "
+		    "soc %#x fw %#x; arena used %u KB. Stopped before WLAN_CFG / WLAN_MODE (no radio)\n", e4_now, qw.sent, qw.rcvd,
+		    qw.resumes, qw.chip_id, qw.board_id, qw.soc_id, qw.fw_ver, q_used >> 10);
+		qw.st = 14;
+		if (q_on >= 2) {
+			/* scan82 46qm2: ath12k_qmi_firmware_start's order - WLAN_INI (fw log on), WLAN_CFG, WLAN_MODE */
+			o = q_u8(o, 0x10, 1);           /* enable_fwlog */
+			q_req(0x2f, o - 7, "WLAN_INI");
+			qw.st = 15;
+		}
+		break;
+	case 15:
+	{
+		/*
+		 * WLAN_CFG: host_version "WIN" (a top-level QMI string: no length byte), the target's CE pipes and the HTC service
+		 * map as ath12k's WCN7850-class tables (wifi7/ce.c; values only): pipe {num, dir 1 IN / 2 OUT / 3 INOUT / 4
+		 * INOUT_H2H, nentries, nbytes_max, flags 0 / 8 = DIS_INTR}; service {id, dir, pipe}: WMI data VO / BK / BE / VI
+		 * (0x104 / 0x102 / 0x101 / 0x103) and WMI control (0x100) out 3 / in 2, RSVD control (0x001) out 0 / in 2, HTT data
+		 * (0x300) out 4 / in 1. NO shadow_reg_v3 list in this stage: the host's SRNG / CE rings are not set up yet (46wm1).
+		 */
+		static const uint32_t ce[9][5] = { { 0, 2, 32, 2048, 0 }, { 1, 1, 32, 2048, 0 }, { 2, 1, 32, 2048, 0 },
+			{ 3, 2, 32, 2048, 0 }, { 4, 2, 256, 256, 8 }, { 5, 1, 32, 2048, 0 }, { 6, 3, 32, 16384, 0 }, { 7, 4, 0, 0, 8 },
+			{ 8, 3, 32, 16384, 0 } };
+		static const uint32_t svc[14][3] = { { 0x104, 2, 3 }, { 0x104, 1, 2 }, { 0x102, 2, 3 }, { 0x102, 1, 2 },
+			{ 0x101, 2, 3 }, { 0x101, 1, 2 }, { 0x103, 2, 3 }, { 0x103, 1, 2 }, { 0x100, 2, 3 }, { 0x100, 1, 2 },
+			{ 0x001, 2, 0 }, { 0x001, 1, 2 }, { 0x300, 2, 4 }, { 0x300, 1, 1 } };
+		uint8_t v[1 + 9 * 20];
+		uint32_t k = 0;
+		o = q_put(o, 0x10, "WIN", 3);
+		v[k++] = 9;
+		for (int i = 0; i < 9; i++) {
+			for (int j = 0; j < 5; j++, k += 4) {
+				v[k] = (uint8_t)ce[i][j];
+				v[k + 1] = (uint8_t)(ce[i][j] >> 8);
+				v[k + 2] = (uint8_t)(ce[i][j] >> 16);
+				v[k + 3] = (uint8_t)(ce[i][j] >> 24);
+			}
+		}
+		o = q_put(o, 0x11, v, k);
+		k = 0;
+		{
+			uint8_t s[1 + 14 * 12];
+			s[k++] = 14;
+			for (int i = 0; i < 14; i++) {
+				for (int j = 0; j < 3; j++, k += 4) {
+					s[k] = (uint8_t)svc[i][j];
+					s[k + 1] = (uint8_t)(svc[i][j] >> 8);
+					s[k + 2] = (uint8_t)(svc[i][j] >> 16);
+					s[k + 3] = (uint8_t)(svc[i][j] >> 24);
+				}
+			}
+			o = q_put(o, 0x12, s, k);
+		}
+		if (q_on >= 3) {
+			/*
+			 * scan83 46wm1: shadow_reg_v3 - one target register per host-updated CE ring pointer, in ath12k's CE order
+			 * (src HP; dst HP + dst status TP): shadow index i is then BAR0 + 0x8fc + 4 i (HAL_SHADOW_REG)
+			 */
+			uint8_t sh[1 + W_NSH * 4];
+			k = 0;
+			sh[k++] = W_NSH;
+			for (int i = 0; i < W_NSH; i++, k += 4) {
+				uint32_t a = w_shadow_target(i);
+				sh[k] = (uint8_t)a;
+				sh[k + 1] = (uint8_t)(a >> 8);
+				sh[k + 2] = (uint8_t)(a >> 16);
+				sh[k + 3] = (uint8_t)(a >> 24);
+			}
+			o = q_put(o, 0x17, sh, k);
+		}
+		q_req(0x23, o - 7, "WLAN_CFG");
+		qw.st = 16;
+		break;
+	}
+	case 16:
+		o = q_u32(o, 0x01, 0);          /* mode: MISSION (ATH12K_FIRMWARE_MODE_NORMAL 0) */
+		o = q_u8(o, 0x10, 0);           /* hw_debug */
+		q_req(0x22, o - 7, "WLAN_MODE");
+		qw.st = 17;
+		break;
+	case 17:
+		say("icepcie: 46qm2 WLAN_MODE MISSION accepted at +%d ms: the firmware's WLAN side is starting.%s\n", e4_now, q_on >= 3 ?
+		    " 46wm1: the host copy engines, HTC and WMI follow" : " No host copy engine, HTC or WMI in this kit (46wm1 next): "
+		    "everything the firmware does from here (QMI indications, MHI state, bank 9 faults, RDDM) is logged by the watch");
+		qw.st = 19;
+		if (q_on >= 3) {
+			qw.st = w_ce_setup() ? 20 : 19;
+			qw.wt = e4_now;
+		}
+		break;
+	}
+	if (qw.stopped) {
+		say("icepcie: 46qm1 handshake stopped in state %d (%u requests sent, %u messages received)\n", qw.st, qw.sent, qw.rcvd);
+	}
+}
+
+static void
+e4_run(vm_offset_t bar, vm_offset_t buf, vm_offset_t cb, uint32_t bhi)
+{
+	uint32_t ee = 0, ms = 0, ctl = 0, err = 0, r0 = 0, r1 = 0, rc = 0, msi = 0, fsr = 0;
+	uint32_t lee = ~0u, lms = ~0u, lctl = ~0u, lerr = ~0u, lr0 = ~0u, lr1 = ~0u, lrc = ~0u, lmsi = ~0u, lfsr = ~0u;
+	int t, end = 20000, e5_rddm_t = -1, now = 0, brk = -1;
+	const char *why = "20 s";
+	char whyb[24];
+	bool ext = false, amss_all = true;
+	uint32_t m0n = 0, rd = 0, mchg = 0, syserr = 0, eechg = 0, lsys = 0;
+	uint64_t w0 = mach_absolute_time(), wns;
+
+	bzero(&e4, sizeof(e4));
+	qw.bar = bar;                   /* scan80 46qm1 */
+	qw.buf = buf;
+	if (e6_watch > 0) {
+		/* 23e6: wall-time watch of icepcie_watch s (the fix kits: 60), every change and packet with +N ms */
+		end = e6_watch * 1000;
+		e4_logmax = 2000;
+		snprintf(whyb, sizeof(whyb), "%d s", e6_watch);
+		why = whyb;
+	}
+	e4.chdb = io_rd(bar, 0x18);
+	e4.erdb = io_rd(bar, 0x20);
+	for (uint32_t r = 0; r < 2; r++) {
+		uint64_t base = E2A_IOVA + e4_ring[r], w = e4_r64(buf + 0x82000 + 44 * r + 36);
+		e4.wp[r] = (w >= base && w < base + e4_rlen[r] && !(w & 15)) ? (uint32_t)(w - base) : e4_rlen[r] - 16;
+	}
+	e4.cmd_wp = (uint32_t)((e4_r64(buf + 0x83000 + 36) - (E2A_IOVA + E4_CMDR)) % (128 * 16)) & ~15u;
+	say("icepcie: 23e4 START (icepcie_mmw=%d icepcie_ipcr=%d): EXECENV %08x (%s) MHISTATUS %08x (%s) MHICTRL %08x CHDBOFF %08x "
+	    "ERDBOFF %08x; event ctxt 0 rp %08x wp %08x, 1 rp %08x wp %08x; command ctxt rp %08x wp %08x; MSI sink %08x\n",
+	    e4_watch, e4_ipcr, io_rd(bar, bhi + 0x28), e3_ee(io_rd(bar, bhi + 0x28)), io_rd(bar, 0x48), e3_state(io_rd(bar, 0x48)),
+	    io_rd(bar, 0x38), e4.chdb, e4.erdb, *(volatile uint32_t *)(buf + 0x82000 + 28), *(volatile uint32_t *)(buf + 0x82000 + 36),
+	    *(volatile uint32_t *)(buf + 0x82000 + 44 + 28), *(volatile uint32_t *)(buf + 0x82000 + 44 + 36),
+	    *(volatile uint32_t *)(buf + 0x83000 + 28), *(volatile uint32_t *)(buf + 0x83000 + 36), *(volatile uint32_t *)(buf + 0xf0000));
+	e5_diag_all("at mission mode", e2_cfg, bar, bhi, buf, cb);
+	e4_poll(bar, buf);              /* what was posted since 23e3m's M0 (ring base on) */
+	if (e4_ipcr != 0) {
+		e4_ipcr_start(bar, buf, bhi);
+	}
+	for (t = 0;; t++) {
+		if (e6_watch > 0) {
+			absolutetime_to_nanoseconds(mach_absolute_time() - w0, &wns);
+			now = (int)(wns / 1000000);
+		} else {
+			now = t;
+		}
+		e4_now = now;
+		if (now > end) {
+			break;
+		}
+		if (e5_diag) {
+			/* 23e5: the BHIe receive status and BHI STATUS at every change (reads only) */
+			uint32_t bhie = io_rd(bar, 0x2c), rx = 0, bs = io_rd(bar, bhi + 0x2c);
+			if (bhie != 0 && bhie != 0xffffffffu && !(bhie & 3) && bhie + 0x80 <= 0x1000) {
+				rx = io_rd(bar, bhie + 0x78);
+			}
+			if (rx != e5_lrx || bs != e5_lbs) {
+				E4SAY("icepcie: 23e5 +%d ms: BHIe RXVECSTATUS %08x BHI STATUS %08x\n", now, rx, bs);
+				e5_lrx = rx;
+				e5_lbs = bs;
+			}
+		}
+		ee = io_rd(bar, bhi + 0x28);
+		ms = io_rd(bar, 0x48);
+		ctl = io_rd(bar, 0x38);
+		err = io_rd(bar, bhi + 0x30);
+		r0 = *(volatile uint32_t *)(buf + 0x82000 + 28);
+		r1 = *(volatile uint32_t *)(buf + 0x82000 + 44 + 28);
+		rc = *(volatile uint32_t *)(buf + 0x83000 + 28);
+		msi = *(volatile uint32_t *)(buf + 0xf0000);
+		fsr = io_rd(cb, 0x58);
+		if (u1_live) {
+			u1_tick();              /* 34ux1: every 2 ms of wall time until 200 ms after AMSS (reads only) */
+		}
+		/* 23e6: the stability counts (every read) */
+		rd++;
+		if (ee == 2 && ((ms >> 8) & 0xff) == 2) {
+			m0n++;
+		}
+		if (ee != 2 && amss_all) {
+			amss_all = false;
+			brk = now;
+		}
+		if (lms != ~0u && ((ms >> 8) & 0xff) != ((lms >> 8) & 0xff)) {
+			mchg++;
+		}
+		if (lee != ~0u && ee != lee) {
+			eechg++;
+		}
+		if ((((ms >> 2) & 1) || ((ms >> 8) & 0xff) == 0xff) && !lsys) {
+			syserr++;
+		}
+		lsys = ms != 0xffffffffu && (((ms >> 2) & 1) || ((ms >> 8) & 0xff) == 0xff);
+		if (ee != lee || ms != lms || ctl != lctl || err != lerr || r0 != lr0 || r1 != lr1 || rc != lrc || msi != lmsi ||
+		    fsr != lfsr) {
+			E4SAY("icepcie: 23e4 +%d ms: EXECENV %08x (%s) MHISTATUS %08x (%s, ready %u, syserr %u) MHICTRL %08x ERRCODE %08x; "
+			    "event ctxt rp %08x %08x; command ctxt rp %08x; MSI sink %08x; bank FSR %08x\n", now, ee, e3_ee(ee), ms, e3_state(ms),
+			    ms & 1, (ms >> 2) & 1, ctl, err, r0, r1, rc, msi, fsr);
+			lee = ee;
+			lms = ms;
+			lctl = ctl;
+			lerr = err;
+			lr0 = r0;
+			lr1 = r1;
+			lrc = rc;
+			lmsi = msi;
+			lfsr = fsr;
+		}
+		e4_poll(bar, buf);
+		if (e4_ipcr == 2 && e4.hello_seen && !e4.hello_sent && ee == 2 && ((ms >> 8) & 0xff) == 2) {
+			e4_hello(bar, buf);
+		}
+		if (q_on && e4_ipcr == 2 && ee == 2 && ((ms >> 8) & 0xff) == 2) {
+			q_step();               /* scan80 46qm1: the QMI WLFW handshake */
+		}
+		if (ms == 0xffffffffu) {
+			why = "the chip stopped answering";
+			break;
+		}
+		if (!ext && (ee == 3 || ((ms >> 8) & 0xff) == 0xff || ((ms >> 2) & 1))) {
+			E4SAY("icepcie: 23e4 +%d ms: %s (EXECENV %08x MHISTATUS %08x ERRCODE %08x ERRDBG1 %08x ERRDBG2 %08x ERRDBG3 %08x): 1 s "
+			    "more of reads\n", now, ee == 3 ? "RDDM (the firmware crashed)" : "SYS_ERR", ee, ms, err, io_rd(bar, bhi + 0x34),
+			    io_rd(bar, bhi + 0x38), io_rd(bar, bhi + 0x3c));
+			ext = true;
+			end = now + 1000;
+			why = ee == 3 ? "RDDM" : "SYS_ERR";
+			e5_diag_all(ee == 3 ? "at RDDM" : "at SYS_ERR", e2_cfg, bar, bhi, buf, cb);
+		}
+		if (ee == 3 && e5_rddm_t < 0) {
+			e5_rddm_t = now;
+		}
+		/*
+		 * 23e5d: the dump once the device is in RDDM and has raised SYS_ERR (or 50 ms after RDDM). 34ux1: not before
+		 * the census window ends (200 ms after AMSS): the upload reuses the image's slots, and the device holds RDDM.
+		 */
+		if (e5_rddm && !e5_rddm_done && ee == 3 && (((ms >> 2) & 1) || now >= e5_rddm_t + 50) && !u1_live) {
+			e5_rddm_dump(bar, bhi);
+			e5_diag_all("after the RDDM upload", e2_cfg, bar, bhi, buf, cb);
+			if (e6_watch > 0) {
+				/* 23e6: the dump takes ~20 s of wall time: still 1 s of reads after it, as 23e5d had */
+				absolutetime_to_nanoseconds(mach_absolute_time() - w0, &wns);
+				end = (int)(wns / 1000000) + 1000;
+			}
+		}
+		if (u1_endlate && (!e5_rddm || e5_rddm_done)) {
+			u1_finish("scan52: stopped silently at the first crash sample; this line waited for the RDDM upload");
+		}
+		IOSleep(1);
+	}
+	if (u1_endlate) {
+		u1_finish("scan52: stopped silently at the first crash sample; the watch ended before an RDDM upload");
+	}
+	w_release(bar, "device wake = 0 (45wf2h: released at the end of the watch)");
+	if (q_on >= 15 && brk >= 0) {
+		/* scan136 46cn2b: after a crash the paging store vs amss.bin (counts), the last ring pointers, the summary */
+		qm_page_check("after the crash");
+		if (q_on >= 17) {
+			/* scan139 46cn2p: with icepcie_rddm_sep=1 the dump went to its own arena, so the image's crash page is still ours */
+			qm_probe(r6_va != 0 ? "after the crash (dump in its own arena)" : "after the crash (dump over the image)");
+			qm_smmu("after the crash");
+		}
+		if (cn_dp >= 2) {
+			/* host-memory shadows only: no device register reads after a crash */
+			say("icepcie: 46cn2b ring pointers after the crash (shadows): SW2TCL1 HP %u TP %u, WBM2SW0 HP %u TP %u; tx %u, "
+			    "completions %u\n", nx.tx_hp, *(volatile uint32_t *)(dp.pg + 4 * 24), *(volatile uint32_t *)(dp.pg + 4 * 128),
+			    dp.tp[5], nx.tx_n, nx.txc);
+			if (!nx.summarized) {
+				nx_summary();
+			}
+		}
+	}
+	e5_diag_all("at the end of the watch", e2_cfg, bar, bhi, buf, cb);
+	say("icepcie: 23e4 END (%s) after ~%d ms: EXECENV %08x (%s) MHISTATUS %08x (%s) MHICTRL %08x ERRCODE %08x; %u events "
+	    "decoded, %u QRTR packets, HELLO %s / %s, WLFW (service 0x45) NEW_SERVER %s; %u doorbell writes; %u log lines "
+	    "suppressed; bank FSR %08x\n", why, now, io_rd(bar, bhi + 0x28), e3_ee(io_rd(bar, bhi + 0x28)), io_rd(bar, 0x48),
+	    e3_state(io_rd(bar, 0x48)), io_rd(bar, 0x38), io_rd(bar, bhi + 0x30), e4.events, e4.pkts, e4.hello_seen ? "received" :
+	    "not received", e4.hello_sent ? "answered" : "not answered", e4.wlfw_seen ? "SEEN" : "not seen", e4.dbs, e4.suppressed,
+	    io_rd(cb, 0x58));
+	if (e6_watch > 0) {
+		/* 23e6: the one-line verdict of the run */
+		if (amss_all && syserr == 0 && now >= e6_watch * 1000) {
+			say("icepcie: 23e6 STABILITY: AMSS + M0 HELD %d s (EXECENV 2 at all %u reads, M0 at %u = %u%%), %u QRTR packets, %u "
+			    "events, 0 SYS_ERR, %u MHI state changes; WLFW (0x45) NEW_SERVER %s\n", now / 1000, rd, m0n,
+			    rd ? (uint32_t)((uint64_t)m0n * 100 / rd) : 0, e4.pkts, e4.events, mchg, e4.wlfw_seen ? "SEEN" : "not seen");
+		} else {
+			say("icepcie: 23e6 STABILITY: NOT HELD - AMSS left at +%d ms (EXECENV now %08x), %u SYS_ERR, %u EXECENV changes, %u MHI "
+			    "state changes, M0 at %u of %u reads; %u QRTR packets, %u events; watch ended at +%d ms (%s); WLFW (0x45) "
+			    "NEW_SERVER %s\n", brk, io_rd(bar, bhi + 0x28), syserr, eechg, mchg, m0n, rd, e4.pkts, e4.events, now, why,
+			    e4.wlfw_seen ? "SEEN" : "not seen");
+		}
+	}
+}
+
+static void
+pcie_e2_bhi(vm_offset_t cfg, vm_offset_t bar, vm_offset_t buf, vm_offset_t cb)
+{
+	uint64_t size = 0;
+	int disk = -1;
+	const uint8_t *fw = redwood_image_file("fw", "ath12k_amss.bin", &size, &disk);
+	uint8_t digest[32];
+	SHA256_CTX c;
+	uint32_t bhi = io_rd(bar, 0x28), st = 0, last = ~0u, sid, ctxsum = 0;
+	int i, bm = 0, ctx = 0;
+
+#define BW(name, o, val) do { *(volatile uint32_t *)(bar + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: bhi %s +%#x <- %08x (read back %08x)\n", name, (uint32_t)(o), (uint32_t)(val), io_rd(bar, o)); } while (0)
+	if (fw == NULL || size < 0x80000) {
+		say("icepcie: 23e2 REFUSED: no fw/ath12k_amss.bin (512 KB or more) in md1 / md0\n");
+		return;
+	}
+	SHA256_Init(&c);
+	SHA256_Update(&c, fw, (size_t)size);
+	SHA256_Final(digest, &c);
+	if (memcmp(digest, e2_amss_sha, 32) != 0) {
+		say("icepcie: 23e2 REFUSED: ath12k_amss.bin (%llu bytes, md%d) sha256 is not iceland-firmware's %02x%02x%02x%02x...\n",
+		    size, disk, digest[0], digest[1], digest[2], digest[3]);
+		return;
+	}
+	/*
+	 * 23e2e: icepcie_bm=1 (kit 23e2f) = Linux's order: ath12k_pci_claim's pci_set_master comes before
+	 * ath12k_pci_power_up's sw reset, so the chip's PBL runs its MHI reset with bus mastering on (bank 9 is routed: any
+	 * DMA outside the 1 MB buffer faults there and is logged). Default 0: bus master only right before BHI, as 23e2d.
+	 */
+	e2_cfg = cfg;
+	/* (B) route (icepcie_lx=1): hand off to the Linux ath12k driver. Its own MHI does the sw reset + BHI + QMI on the
+	 * board layer's thread (started by hakios_iceland_ath12k_init), so leave the chip powered and the link up, bus
+	 * mastering off, and stop this bring-up here. */
+	{
+		int lx = 0;
+
+		PE_parse_boot_argn("icepcie_lx", &lx, sizeof(lx));
+		if (lx) {
+			iceland_ath12k_link();
+			return;
+		}
+	}
+	/* 23e5: icepcie_diag5=1 (reads only), icepcie_l1ss=1|2 (23e5f), icepcie_rddm=1 (23e5d); both of the latter log as diag5 */
+	PE_parse_boot_argn("icepcie_diag5", &e5_diag, sizeof(e5_diag));
+	PE_parse_boot_argn("icepcie_l1ss", &e5_l1ss, sizeof(e5_l1ss));
+	PE_parse_boot_argn("icepcie_rddm", &e5_rddm, sizeof(e5_rddm));
+	PE_parse_boot_argn("icepcie_watch", &e6_watch, sizeof(e6_watch));
+	if (e6_watch < 0 || e6_watch > 240) {          /* scan114: up to 240 s (the connect kits wait for the hotspot) */
+		say("icepcie: 23e6 icepcie_watch=%d out of 0..240: 23e4's 20 s\n", e6_watch);
+		e6_watch = 0;
+	}
+	PE_parse_boot_argn("icepcie_ux1", &u1_on, sizeof(u1_on));
+	if (u1_on) {
+		say("icepcie: 34ux1 icepcie_ux1=%d: read-only census from the BHIe doorbell to 200 ms after AMSS, every 2 ms "
+		    "(WCN bucks + sleep-clock pin over the SPMI observer, the BHIe image in host memory, LnkSta / AER); scan52: ends "
+		    "silently at the first crash sample (no reads, no line before the RDDM doorbell), the RDDM poll takes only our "
+		    "sequence\n", u1_on);
+	}
+	if (e5_l1ss != 0 || e5_rddm != 0) {
+		e5_diag = 1;
+	}
+	if (e5_rddm >= 2) {
+		/* 23e6: 15 segments (rddm_size 0x780000), and the pack + deflate memory now, while 4 MB contiguous is easy to get */
+		e6_segs = E6_RDDM_SEGS;
+		for (vm_size_t sz = E6_PACK_MAX; sz >= (1u << 20) && e6_pack == 0; sz >>= 1) {
+			if (kmem_alloc_contig(kernel_map, &e6_pack, sz, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+			    VM_KERN_MEMORY_IOKIT) == KERN_SUCCESS) {
+				e6_packsz = sz;
+			} else {
+				e6_pack = 0;
+			}
+		}
+		if (kmem_alloc(kernel_map, &e6_zheap, E6_ZHEAP, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			e6_zheap = 0;
+		}
+		say("icepcie: 23e6 dump memory: pack %llu KB at PA %#llx, deflate %u KB %s; %u segments of 512 KB\n",
+		    (uint64_t)e6_packsz >> 10, e6_pack ? kvtophys(e6_pack) : 0ull, E6_ZHEAP >> 10, e6_zheap ? "taken" : "NOT taken",
+		    e6_segs);
+	}
+	e5_fw = fw;
+	e5_fwsize = size;
+	if (e5_diag) {
+		say("icepcie: 23e5 (icepcie_diag5=%d icepcie_l1ss=%d icepcie_rddm=%d): diagnostics before BHI, at mission mode, at RDDM "
+		    "and at the end%s%s\n", e5_diag, e5_l1ss, e5_rddm, e5_l1ss ? "; L1SS timing fields before BHI (23e5f)" : "",
+		    e5_rddm ? "; RDDM upload at the crash (23e5d)" : "");
+	}
+	PE_parse_boot_argn("icepcie_bm", &bm, sizeof(bm));
+	if (bm) {
+		e2_bm_on(cfg, "23e2e icepcie_bm=1: BEFORE the sw reset, as Linux");
+	}
+	if (!e2_sw_reset()) {
+		say("icepcie: 23e2b REFUSED: the chip's reset did not complete; bank FSR %08x\n", io_rd(cb, 0x58));
+		e2_bm_off(cfg);
+		return;
+	}
+	bhi = io_rd(bar, 0x28);
+	if (bhi == 0 || bhi >= 0x1f00 || (bhi & 3)) {
+		say("icepcie: 23e2 REFUSED: BHIOFF %08x not plausible\n", bhi);
+		e2_bm_off(cfg);
+		return;
+	}
+	say("icepcie: 23e2: amss.bin %llu bytes from md%d, sha256 matches; BHI at +%#x: EXECENV %08x STATUS %08x\n", size, disk,
+	    bhi, io_rd(bar, bhi + 0x28), io_rd(bar, bhi + 0x2c));
+	if (io_rd(bar, bhi + 0x28) != 0 || (io_rd(bar, bhi + 0x2c) >> 30) == 3) {
+		say("icepcie: 23e2 REFUSED: not in PBL (EXECENV %08x) or BHI already in error (STATUS %08x)\n",
+		    io_rd(bar, bhi + 0x28), io_rd(bar, bhi + 0x2c));
+		e2_bm_off(cfg);
+		return;
+	}
+	memcpy((void *)buf, fw, 0x80000);
+	e2a_clean(buf, 0x80000);
+	PE_parse_boot_argn("icepcie_ctx", &ctx, sizeof(ctx));
+	if (ctx) {
+		/* 23e2k: settle 200 ms, contexts, 200 ms, then BHI (covers both orders reported for UniXNU) */
+		IOSleep(200);
+		if (!e2k_contexts(bar, buf)) {
+			e2_bm_off(cfg);
+			return;
+		}
+		ctxsum = e2k_sum(buf);
+		IOSleep(200);
+	}
+	{
+		int msi = 0;
+		PE_parse_boot_argn("icepcie_msi", &msi, sizeof(msi));
+		if (msi) {
+			*(volatile uint32_t *)(buf + 0xf0000) = 0xdeadbeefu;
+			e2a_clean(buf + 0xf0000, 64);
+			e2_msi(cfg, true);
+		}
+	}
+	if (e5_l1ss != 0) {
+		/* 23e5f: the L1SS timing fields Linux has written by now (enumeration), before the firmware's _pcielp_init reads them */
+		e5_l1ss_set(cfg);
+		if (e6_link_lost) {
+			/* 23e6c: the retrain lost the link - no BHI; registers back, then the usual end */
+			e5_l1ss_back(cfg);
+			if (e2m_on) {
+				e2_msi(cfg, false);
+			}
+			e2_bm_off(cfg);
+			return;
+		}
+	}
+	PE_parse_boot_argn("icepcie_rddm_pre", &w3_pre, sizeof(w3_pre));
+	if ((w3_pre == 1 || w3_pre == 2) && e5_rddm >= 2) {
+		w3_rddm_pre(bar, bhi);  /* scan79 45wf3 / scan80 45wf3a: the RDDM RX table in PBL, before BHI */
+	}
+	if (w3_pre != 0) {
+		say("icepcie: scan80 icepcie_rddm_pre=%d: %s\n", w3_pre, w3_pre == 1 ? "RDDM table before BHI + limit high words 0xF (45wf3)" :
+		    w3_pre == 2 ? "RDDM table before BHI ONLY, limit high words 0 (45wf3a)" : w3_pre == 3 ?
+		    "limit high words 0xF ONLY, no early RDDM table (45wf3b)" : "unknown value: nothing");
+	}
+	e5_diag_all("before BHI", cfg, bar, bhi, buf, cb);
+	e2_bm_on(cfg, "before BHI");
+	e2_linkdiag("before BHI", cfg, bar, bhi);
+	e2_dmadiag("before BHI", cfg);
+	BW("INTVEC", bhi + 0x20, 0);
+	BW("STATUS", bhi + 0x2c, 0);
+	BW("IMGADDR_HIGH", bhi + 0x0c, 0);
+	BW("IMGADDR_LOW", bhi + 0x08, (uint32_t)E2A_IOVA);
+	BW("IMGSIZE", bhi + 0x10, 0x80000);
+	sid = ((uint32_t)mach_absolute_time() & 0x3fffffffu) | 1u;
+	BW("IMGTXDB", bhi + 0x18, sid);
+	/* 23e2i: 1 ms steps for 2 s (23e2g/h: 10 ms steps, STATUS changed between +30 and +40 ms) */
+	for (i = 0; i < 2000; i++) {
+		st = io_rd(bar, bhi + 0x2c);
+		if (st != last) {
+			say("icepcie: +%d ms: BHI STATUS %08x ERRCODE %08x EXECENV %08x MHISTATUS %08x; bank FSR %08x\n", i, st,
+			    io_rd(bar, bhi + 0x30), io_rd(bar, bhi + 0x28), io_rd(bar, 0x48), io_rd(cb, 0x58));
+			last = st;
+		}
+		if ((st >> 30) == 2 || (st >> 30) == 3) {
+			break;
+		}
+		IOSleep(1);
+	}
+	/*
+	 * 23e2i: ath12k's mhi read_reg is a plain readl (no PCI_INVALID_READ check: that is mhi pci_generic's), so
+	 * mhi_fw_load_bhi masks STATUS with BHI_STATUS_MASK (bits 31:30) and 0xffffffff gives 3 = BHI_STATUS_ERROR ->
+	 * "Image transfer failed". 23e2h's reading ("Linux: not an error") was wrong: all ones is the PBL's ERROR, with
+	 * ERRCODE / ERRDBG1-3 valid (they echo our address and size).
+	 */
+	say("icepcie: 23e2 BHI %s after ~%d ms: STATUS %08x ERRCODE %08x EXECENV %08x; bank FSR %08x FAR %08x_%08x\n",
+	    (st >> 30) == 2 ? "SUCCESS (the SBL is running)" : (st >> 30) == 3 ? "ERROR (bits 31:30 = 3; ath12k: Image transfer "
+	    "failed)" : "no answer", i, st,
+	    io_rd(bar, bhi + 0x30), io_rd(bar, bhi + 0x28), io_rd(cb, 0x58), io_rd(cb, 0x64), io_rd(cb, 0x60));
+	e2_linkdiag("right after BHI", cfg, bar, bhi);
+	e2_dmadiag("right after BHI", cfg);
+	say("icepcie: 23e2i buffer after BHI: first 512 KB %s the file (a device write into it would show here)\n",
+	    memcmp((const void *)buf, fw, 0x80000) == 0 ? "still equal to" : "DIFFERS from");
+	if (ctx) {
+		say("icepcie: 23e2k after BHI: context area checksum %08x (%s); event ctxt 0 rp %08x wp %08x; MHICFG %08x CCABAP %08x "
+		    "ECABAP %08x CRCBAP %08x\n", e2k_sum(buf), e2k_sum(buf) == ctxsum ? "unchanged" : "CHANGED: the device wrote it",
+		    *(volatile uint32_t *)(buf + 0x82000 + 28), *(volatile uint32_t *)(buf + 0x82000 + 36), io_rd(bar, 0x10),
+		    io_rd(bar, 0x58), io_rd(bar, 0x60), io_rd(bar, 0x68));
+	}
+	/*
+	 * 23e2h (23e2g: STATUS read 0xffffffff after ~40 ms while ERRCODE / MHISTATUS / the link read normally, and the
+	 * undo's MHI reset came 0.5 s later): Linux does not take BHI_STATUS 0xffffffff as an error - mhi_read_reg returns
+	 * -EIO for an all-ones read (PCI_INVALID_READ), which ENDS mhi_fw_load_bhi's wait with tx_status still 0, so
+	 * mhi_fw_load_handler goes on as after a success: the BHIe table is prepared and mhi_ready_state_transition waits
+	 * (timeout_ms, 90 s for ath12k) for MHICTRL RESET 0 and MHISTATUS READY. dada's hakios_mhi_boot.c likewise reads
+	 * 0xffffffff as "the device does not answer while its boot loader starts", not a status. Only STATUS bits 31:30 = 3
+	 * with a readable register (not all ones) is an error now. Then, with bus master kept on and NO write, up to 15 s:
+	 * EXECENV / MHISTATUS / MHICTRL / BHI STATUS / ERRCODE / the endpoint ID logged at every change; stop at READY with
+	 * EXECENV past PBL (the SBL waits for its BHIe image: 23e3), at SYS_ERR, or after 15 s.
+	 */
+	if ((st >> 30) == 2) {
+		uint32_t ee = 0, ms = 0, ctl = 0, bs = 0, id = 0, lee = ~0u, lms = ~0u, lctl = ~0u, lbs = ~0u, lid = ~0u;
+		int t;
+		say("icepcie: 23e2h: BHI STATUS %08x: taken as Linux does (transfer accepted / device in transition); waiting up to "
+		    "15 s for READY, nothing written\n", st);
+		for (t = 0; t <= 15000; t += 25) {
+			id = io_rd(cfg, 0);
+			ee = io_rd(bar, bhi + 0x28);
+			ms = io_rd(bar, 0x48);
+			ctl = io_rd(bar, 0x38);
+			bs = io_rd(bar, bhi + 0x2c);
+			if (ee != lee || ms != lms || ctl != lctl || bs != lbs || id != lid) {
+				say("icepcie: 23e2h +%d ms: EXECENV %08x MHISTATUS %08x (ready %u, syserr %u, state %#x) MHICTRL %08x BHI STATUS "
+				    "%08x ERRCODE %08x ep id %08x; bank FSR %08x\n", t, ee, ms, ms & 1, (ms >> 2) & 1, (ms >> 8) & 0xff, ctl, bs,
+				    io_rd(bar, bhi + 0x30), id, io_rd(cb, 0x58));
+				lee = ee;
+				lms = ms;
+				lctl = ctl;
+				lbs = bs;
+				lid = id;
+			}
+			if (ms != 0xffffffffu && (ms & 1) && !(ctl & 2u) && ee != 0 && ee != 0xffffffffu) {
+				say("icepcie: 23e2h SBL UP: MHI READY with EXECENV %08x after ~%d ms (23e3 next: BHIe of the rest of amss.bin)\n",
+				    ee, t);
+				if (e3_mode != 0) {
+					/* 23e3: the BHIe load, then reads only; the undo below is 23e2q2's */
+					e3_bhie(bar, buf, cb, fw, size, bhi);
+					if (e4_watch != 0) {
+						/* 23e4: after 23e3m's MISSION MODE only - 20 s watch (+ 23e4q: the IPCR channels) */
+						if (e3_mission) {
+							e4_run(bar, buf, cb, bhi);
+						} else {
+							say("icepcie: 23e4 not started: 23e3 did not reach MISSION MODE\n");
+						}
+					}
+					if (u1_live) {
+						u1_finish("the BHIe loop / watch ended first");
+					}
+				}
+				break;
+			}
+			if (ms != 0xffffffffu && ((ms >> 8) & 0xff) == 0xff) {
+				say("icepcie: 23e2h: SYS_ERR after ~%d ms\n", t);
+				break;
+			}
+			IOSleep(25);
+		}
+		if (t > 15000) {
+			say("icepcie: 23e2h: no READY in 15 s (EXECENV %08x MHISTATUS %08x)\n", ee, ms);
+		}
+	} else {
+		/* 23e2i: after an ERROR, 2 s of reads only (any later change: EXECENV / MHISTATUS / STATUS), then the undo */
+		uint32_t l0 = io_rd(bar, bhi + 0x28), l1 = io_rd(bar, 0x48), l2 = io_rd(bar, bhi + 0x2c);
+		for (i = 0; i < 2000; i += 10) {
+			if (io_rd(bar, bhi + 0x28) != l0 || io_rd(bar, 0x48) != l1 || io_rd(bar, bhi + 0x2c) != l2) {
+				l0 = io_rd(bar, bhi + 0x28);
+				l1 = io_rd(bar, 0x48);
+				l2 = io_rd(bar, bhi + 0x2c);
+				say("icepcie: 23e2i +%d ms after the end of the wait: EXECENV %08x MHISTATUS %08x STATUS %08x ERRCODE %08x\n", i,
+				    l0, l1, l2, io_rd(bar, bhi + 0x30));
+			}
+			IOSleep(10);
+		}
+	}
+	say("icepcie: +end: EXECENV %08x MHISTATUS %08x BHI STATUS %08x\n", io_rd(bar, bhi + 0x28), io_rd(bar, 0x48),
+	    io_rd(bar, bhi + 0x2c));
+	e2_linkdiag("at the end", cfg, bar, bhi);
+	/* undo: bus master off first (endpoint, root port), then MHI reset */
+	e2_bm_off(cfg);
+	if (e2m_on) {
+		__asm__ volatile ("dc civac, %0" :: "r"(buf + 0xf0000) : "memory");
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: 23dd2 MSI sink word after BHI: %08x (deadbeef = no MSI written)\n",
+		    *(volatile uint32_t *)(buf + 0xf0000));
+		e2_msi(cfg, false);
+	}
+	e5_l1ss_back(cfg);              /* 23e5f: as found (nothing when 23e5f wrote nothing) */
+	if (e3_ran && (io_rd(bar, bhi + 0x28) == 3 || io_rd(bar, 0x48) == 0xffffffffu)) {
+		/*
+		 * 23e4: Linux mhi_pm_disable_transition skips the MHI reset when the device is in RDDM (it never clears there:
+		 * 23e3 waited 2.1 s with MHICTRL RESET set and MHISTATUS 0000ff05). No write, no wait: the bus master is already
+		 * off, and the chip's power-off below (PERST#, GPIOs, GDSCs, votes) is what stops it, as ath12k's power-down.
+		 */
+		say("icepcie: 23e4 MHI reset SKIPPED (EXECENV %08x MHISTATUS %08x: RDDM or no answer - Linux skips it in RDDM); the "
+		    "chip's power-off follows\n", io_rd(bar, bhi + 0x28), io_rd(bar, 0x48));
+		return;
+	}
+	BW("MHICTRL (reset)", 0x38, io_rd(bar, 0x38) | 2u);
+	for (i = 0; i < 100 && (io_rd(bar, 0x38) & 2u); i++) {
+		IOSleep(1);
+	}
+	say("icepcie: MHI reset %s (MHICTRL %08x MHISTATUS %08x)\n", (io_rd(bar, 0x38) & 2u) ? "NOT cleared in 100 ms" : "done",
+	    io_rd(bar, 0x38), io_rd(bar, 0x48));
+	if (e3_ran && (io_rd(bar, 0x38) & 2u)) {
+		/* 23e3: the AMSS may take longer than the SBL to take the reset - reads only, up to 2 s more */
+		for (i = 0; i < 2000 && (io_rd(bar, 0x38) & 2u); i += 10) {
+			IOSleep(10);
+		}
+		say("icepcie: 23e3 MHI reset %s after a further ~%d ms (MHICTRL %08x MHISTATUS %08x EXECENV %08x)\n",
+		    (io_rd(bar, 0x38) & 2u) ? "still NOT cleared" : "cleared", i, io_rd(bar, 0x38), io_rd(bar, 0x48),
+		    io_rd(bar, bhi + 0x28));
+	}
+#undef BW
+}
+
+static void
+pcie_e2a(vm_offset_t cfg, vm_offset_t bar)
+{
+	vm_offset_t gr0 = ml_io_map_unmappable(0x15000000u, PAGE_SIZE, VM_WIMG_IO), gr1, cb, tables = 0, buf = 0;
+	uint32_t id0, id1, nsmr, ncb, page, numpage, smr0, s2cr0, cbar0, sctlr0;
+	uint64_t *l1, *l2, *l3, pa1;
+
+#define SW(base, name, o, val) do { *(volatile uint32_t *)((base) + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: smmu %s +%#x <- %08x (read back %08x)\n", name, (uint32_t)(o), (uint32_t)(val), io_rd(base, o)); } while (0)
+	if (gr0 == 0) {
+		say("icepcie: 23e2a: SMMU not mapped: refused\n");
+		return;
+	}
+	id0 = io_rd(gr0, 0x20);
+	id1 = io_rd(gr0, 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	numpage = 1u << (((id1 >> 28) & 7) + 1);
+	gr1 = ml_io_map_unmappable(0x15000000u + page, PAGE_SIZE, VM_WIMG_IO);
+	cb = ml_io_map_unmappable(0x15000000u + numpage * page + E2A_BANK * page, PAGE_SIZE, VM_WIMG_IO);
+	if (gr1 == 0 || cb == 0 || E2A_SMR >= nsmr || E2A_BANK >= ncb) {
+		say("icepcie: 23e2a: SMR %u / bank %u out of range (%u SMRs, %u banks) or not mapped: refused\n", E2A_SMR, E2A_BANK,
+		    nsmr, ncb);
+		return;
+	}
+	e5_gr0 = gr0;                   /* 23e5: for the diagnostics' reads of the global fault registers */
+	e5_gr1 = gr1;
+	e5_cb = cb;
+	/* the context banks' whole register region, so the crash reader can sweep every bank's CFSR: a fault that is
+	 * routed to a bank other than 9 (or unmatched, which lands in GFSR) must not be invisible (46cn2m21) */
+	{
+		uint32_t banks = ncb < 32u ? ncb : 32u;
+
+		e5_cbs = ml_io_map_unmappable(0x15000000u + numpage * page, page * banks, VM_WIMG_IO);
+		e5_cbs_stride = page;
+		e5_cbs_count = e5_cbs ? banks : 0;
+	}
+	smr0 = io_rd(gr0, 0x800 + 4 * E2A_SMR);
+	s2cr0 = io_rd(gr0, 0xc00 + 4 * E2A_SMR);
+	cbar0 = io_rd(gr1, 4 * E2A_BANK);
+	sctlr0 = io_rd(cb, 0);
+	say("icepcie: 23e2a as found: SMR %u %08x S2CR %08x; bank %u CBAR %08x SCTLR %08x (%u SMRs, %u banks, page %#x)\n",
+	    E2A_SMR, smr0, s2cr0, E2A_BANK, cbar0, sctlr0, nsmr, ncb, page);
+	if ((smr0 >> 31) || (sctlr0 & 1) || (cbar0 != 0 && cbar0 != E2A_CBAR)) {
+		say("icepcie: 23e2a REFUSED: SMR %u or bank %u not free\n", E2A_SMR, E2A_BANK);
+		return;
+	}
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = io_rd(gr0, 0x800 + 4 * i), s2cr = io_rd(gr0, 0xc00 + 4 * i);
+		if (!(smr >> 31)) {
+			continue;
+		}
+		if ((((0x1400u ^ smr) & ~(smr >> 16) & 0x7fff) == 0) || (((0x1401u ^ smr) & ~(smr >> 16) & 0x7fff) == 0)) {
+			say("icepcie: 23e2a REFUSED: SMR %u (%08x) already matches PCIe0's streams\n", i, smr);
+			return;
+		}
+		if (((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == E2A_BANK) {
+			say("icepcie: 23e2a REFUSED: bank %u routed by SMR %u\n", E2A_BANK, i);
+			return;
+		}
+	}
+	{
+		int lowdma = 0;
+		uint64_t low = 0, mb = 0;
+		PE_parse_boot_argn("icepcie_lowdma", &lowdma, sizeof(lowdma));
+		if (lowdma) {
+			if (!PE_parse_boot_argn("lowdma", &low, sizeof(low)) || !PE_parse_boot_argn("lowdma_mb", &mb, sizeof(mb)) ||
+			    low == 0 || mb < 8 || low + (mb << 20) > 0x100000000ULL) {
+				say("icepcie: 23dd1 REFUSED: no lowdma= / lowdma_mb= below 4 GB from the loader\n");
+				return;
+			}
+			e2_buf_pa = (low + (4ull << 20) + (E2A_BUF - 1)) & ~(uint64_t)(E2A_BUF - 1);
+			if (e2_buf_pa + E2A_BUF > low + (mb << 20)) {
+				say("icepcie: 23dd1 REFUSED: lowdma too small\n");
+				e2_buf_pa = 0;
+				return;
+			}
+			hakios_normal_nc_lo = e2_buf_pa;
+			hakios_normal_nc_hi = e2_buf_pa + E2A_BUF;
+			PE_parse_boot_argn("icepcie_bhie", &e3_mode, sizeof(e3_mode));
+			PE_parse_boot_argn("icepcie_bhie_m0", &e3_m0, sizeof(e3_m0));
+			PE_parse_boot_argn("icepcie_mmw", &e4_watch, sizeof(e4_watch));
+			PE_parse_boot_argn("icepcie_ipcr", &e4_ipcr, sizeof(e4_ipcr));
+			if (e4_ipcr != 0) {
+				e4_watch = 1;           /* 23e4q: the channels come with the watch */
+			}
+			if (e3_mode != 0) {
+				/* 23e3: the BHIe arena, 8 MB at lowdma + 8 MB (2 MB aligned); the NC range then covers both arenas */
+				e3_pa = (low + (8ull << 20) + 0x1fffffull) & ~0x1fffffull;
+				if (e3_pa < e2_buf_pa + E2A_BUF || e3_pa + E3_ARENA > low + (mb << 20) ||
+				    (e3_pa >> 30) != (e2_buf_pa >> 30) || ((e3_pa + E3_ARENA - 1) >> 30) != (e2_buf_pa >> 30) ||
+				    ((e3_pa >> 21) & 0x1ff) <= ((e2_buf_pa >> 21) & 0x1ff) || PAGE_SIZE < 0x4000) {
+					say("icepcie: 23e3: BHIe arena %#llx does not fit lowdma %#llx + %llu MB (or another 1 GB slot): no BHIe\n",
+					    e3_pa, low, mb);
+					e3_pa = 0;
+				} else {
+					hakios_normal_nc_hi = e3_pa + E3_ARENA;
+				}
+			}
+			PE_parse_boot_argn("icepcie_qmi", &q_on, sizeof(q_on));
+			/* scan108 46cn1a: the test network's SSID as FNV-1a hashes + lengths only (two spellings) */
+			PE_parse_boot_argn("icecn_h1", &cn_h[0], sizeof(cn_h[0]));
+			PE_parse_boot_argn("icecn_l1", &cn_l[0], sizeof(cn_l[0]));
+			PE_parse_boot_argn("icecn_h2", &cn_h[1], sizeof(cn_h[1]));
+			PE_parse_boot_argn("icecn_l2", &cn_l[1], sizeof(cn_l[1]));
+			PE_parse_boot_argn("icecn_dp", &cn_dp, sizeof(cn_dp));
+			PE_parse_boot_argn("icecn_cc", cn_cc, sizeof(cn_cc));
+			PE_parse_boot_argn("icecn_qmlo", &cn_qmlo, sizeof(cn_qmlo));
+			PE_parse_boot_argn("icecn_qodm", &cn_qodm, sizeof(cn_qodm));
+			if (cn_qmlo || cn_qodm) {
+				say("icepcie: 46cn2e HOST_CAP additions: MLO fields %s (icecn_qmlo), dynamic_mem_support TLV 0x33 %s (icecn_qodm)\n",
+				    cn_qmlo ? "ON" : "off", cn_qodm ? "ON" : "off");
+			}
+			if ((q_on || icepcie_lx) && e3_pa != 0) {
+				/* scan80: the QMI arena, 32 MB at lowdma + 24 MB (2 MB aligned), same 1 GB slot; the NC range covers it too.
+				 * (B) route (icepcie_lx=1): the same arena becomes the Linux driver's DMA heap, so set it up even with
+				 * q_on == 0. */
+				q_pa = (low + (24ull << 20) + 0x1fffffull) & ~0x1fffffull;
+				if (q_pa < e3_pa + E3_ARENA || q_pa + Q_ARENA > low + (mb << 20) || (q_pa >> 30) != (e2_buf_pa >> 30) ||
+				    ((q_pa + Q_ARENA - 1) >> 30) != (e2_buf_pa >> 30)) {
+					say("icepcie: 46qm1: QMI arena %#llx does not fit lowdma %#llx + %llu MB (or another 1 GB slot): no QMI\n",
+					    q_pa, low, mb);
+					q_pa = 0;
+				} else {
+					hakios_normal_nc_hi = q_pa + Q_ARENA;
+				}
+				/* scan139 46cn2p, icepcie_rddm_sep=1: the RDDM arena, 8 MB right after the QMI arena, same 1 GB slot, NC */
+				r6_sep = q_on >= 18 ? 1 : 0;    /* scan190 46cn2q: option A is the default from icepcie_qmi=18 on */
+				PE_parse_boot_argn("icepcie_rddm_sep", &r6_sep, sizeof(r6_sep));
+				if (r6_sep && q_pa != 0) {
+					r6_pa = q_pa + Q_ARENA;
+					if (r6_pa + E3_ARENA > low + (mb << 20) || (r6_pa >> 30) != (e2_buf_pa >> 30) ||
+					    ((r6_pa + E3_ARENA - 1) >> 30) != (e2_buf_pa >> 30)) {
+						say("icepcie: 46cn2p RDDM arena %#llx does not fit lowdma %#llx + %llu MB: the dump stays in the BHIe arena\n",
+						    r6_pa, low, mb);
+						r6_pa = 0;
+					} else {
+						hakios_normal_nc_hi = r6_pa + E3_ARENA;
+					}
+				}
+			} else if (q_on) {
+				say("icepcie: 46qm1: no BHIe arena: no QMI arena\n");
+			}
+			buf = ml_io_map_wcomb((vm_offset_t)e2_buf_pa, E2A_BUF);
+			if (buf == 0) {
+				say("icepcie: 23dd1 REFUSED: arena not mapped\n");
+				e2_buf_pa = 0;
+				return;
+			}
+			bzero((void *)buf, E2A_BUF);
+			e2_iova = e2_buf_pa;
+			say("icepcie: 23dd1 arena: PA %#llx (lowdma %#llx + 4 MB, %llu MB), 1 MB, write-combined / Normal NC, IOVA == PA\n",
+			    e2_buf_pa, low, mb);
+			if (e3_pa != 0) {
+				e3_va = ml_io_map_wcomb((vm_offset_t)e3_pa, E3_ARENA);
+				if (e3_va == 0 || kmem_alloc(kernel_map, &e3_tables, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+				    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+					say("icepcie: 23e3: BHIe arena or its tables not mapped: no BHIe\n");
+					e3_va = 0;
+					e3_tables = 0;
+				} else {
+					bzero((void *)e3_va, E3_ARENA);
+					say("icepcie: 23e3 BHIe arena: PA %#llx, 8 MB, write-combined / Normal NC, IOVA == PA (icepcie_bhie=%d%s)\n",
+					    e3_pa, e3_mode, e3_m0 ? ", icepcie_bhie_m0=1" : "");
+				}
+			}
+			if (q_pa != 0 && e3_va != 0) {
+				q_va = ml_io_map_wcomb((vm_offset_t)q_pa, Q_ARENA);
+				if (q_va == 0 || kmem_alloc(kernel_map, &q_tables, 26 * 0x1000, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+				    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+					say("icepcie: 46qm1: QMI arena or its tables not mapped: no QMI\n");
+					q_va = 0;
+					q_tables = 0;
+				} else {
+					bzero((void *)q_va, Q_ARENA);
+					say("icepcie: 46qm1 QMI arena: PA %#llx, 64 MB, write-combined / Normal NC, IOVA == PA (host memory for the "
+					    "firmware's REQUEST_MEM segments, m3.bin, aux_ucode.bin)\n", q_pa);
+				}
+			}
+			if (r6_pa != 0 && q_va != 0) {
+				vm_offset_t rv = ml_io_map_wcomb((vm_offset_t)r6_pa, E3_ARENA);
+				if (rv == 0 || kmem_alloc(kernel_map, &r6_tables, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+				    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+					say("icepcie: 46cn2p RDDM arena or its tables not mapped: the dump stays in the BHIe arena\n");
+					r6_tables = 0;
+				} else {
+					bzero((void *)rv, E3_ARENA);
+					r6_va = rv;
+					say("icepcie: 46cn2p RDDM arena: PA %#llx, 8 MB, Normal NC, IOVA == PA - the crash-dump table and segments "
+					    "move off the BHIe image (as Linux's separate rddm_image)\n", r6_pa);
+				}
+			}
+		}
+	}
+	if (kmem_alloc(kernel_map, &tables, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    (e2_buf_pa == 0 &&
+	    kmem_alloc(kernel_map, &buf, E2A_BUF, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)) {
+		say("icepcie: 23e2a: no memory: refused\n");
+		return;
+	}
+	l1 = (uint64_t *)tables;
+	l2 = (uint64_t *)(tables + 0x1000);
+	l3 = (uint64_t *)(tables + 0x2000);
+	pa1 = kvtophys(tables);
+	l1[(E2A_IOVA >> 30) & 0x1ff] = kvtophys(tables + 0x1000) | 3;
+	l2[(E2A_IOVA >> 21) & 0x1ff] = kvtophys(tables + 0x2000) | 3;
+	/*
+	 * 23e2n0, icepcie_afprobe=1 (diagnostic): the image's FIRST page mapped WITHOUT the access flag (bank SCTLR AFE 1,
+	 * AFFD 0): if the chip's BHI read really goes through bank 9 it takes an access-flag fault there (FSR AFF, FAR
+	 * 0x10000000) - the proof that its stream reaches our context; no fault = its reads land somewhere else (the
+	 * BDF -> SID path, 23e2n). BHI fails by design in this kit.
+	 */
+	PE_parse_boot_argn("icepcie_afprobe", &e2n_afprobe, sizeof(e2n_afprobe));
+	for (uint32_t i = 0; i < E2A_BUF / 0x1000; i++) {
+		uint64_t pa = e2_buf_pa ? e2_buf_pa + i * 0x1000ull : kvtophys(buf + i * 0x1000);
+		/* WB inner shareable (AttrIndx 1, SH 3), or for the 23dd1 arena Normal non-cacheable (AttrIndx 0, SH 2) */
+		l3[((E2A_IOVA >> 12) & 0x1ff) + i] = (pa & 0xfffffffff000ull) | 3 |
+		    (e2n_afprobe && i == 0 ? 0 : 1ull << 10) | (e2_buf_pa ? 2ull << 8 : 3ull << 8) | 1ull << 6 |
+		    (e2_buf_pa ? 0 : 1ull << 2) | 1ull << 11 | 3ull << 53;
+	}
+	if (e2n_afprobe) {
+		say("icepcie: 23e2n0 AF probe: IOVA %#llx mapped without the access flag\n", E2A_IOVA);
+	}
+	if (e3_va != 0 && e3_tables != 0) {
+		/* 23e3: the BHIe arena, same page attributes as 23dd1's (Normal NC, outer shareable), its own 4 level-3 tables */
+		for (uint32_t k = 0; k < E3_ARENA >> 21; k++) {
+			l2[((e3_pa >> 21) & 0x1ff) + k] = kvtophys(e3_tables + k * 0x1000) | 3;
+		}
+		for (uint32_t i = 0; i < E3_ARENA / 0x1000; i++) {
+			uint64_t pa = e3_pa + i * 0x1000ull;
+			((uint64_t *)e3_tables)[i] = (pa & 0xfffffffff000ull) | 3 | 1ull << 10 | 2ull << 8 | 1ull << 6 | 1ull << 11 |
+			    3ull << 53;
+		}
+		e2a_clean(e3_tables, PAGE_SIZE);
+		say("icepcie: 23e3 BHIe arena in bank 9: IOVA %#llx..%#llx, level-3 tables at %#llx\n", e3_pa, e3_pa + E3_ARENA - 1,
+		    (uint64_t)kvtophys(e3_tables));
+	}
+	if (q_va != 0 && q_tables != 0) {
+		/* scan80: the QMI arena, same page attributes as the BHIe arena's, thirty-two level-3 tables of its own */
+		for (uint32_t k = 0; k < Q_ARENA >> 21; k++) {
+			l2[((q_pa >> 21) & 0x1ff) + k] = kvtophys(q_tables + k * 0x1000) | 3;
+		}
+		for (uint32_t i = 0; i < Q_ARENA / 0x1000; i++) {
+			uint64_t pa = q_pa + i * 0x1000ull;
+			((uint64_t *)q_tables)[i] = (pa & 0xfffffffff000ull) | 3 | 1ull << 10 | 2ull << 8 | 1ull << 6 | 1ull << 11 |
+			    3ull << 53;
+		}
+		e2a_clean(q_tables, 26 * 0x1000);
+		say("icepcie: 46qm1 QMI arena in bank 9: IOVA %#llx..%#llx, level-3 tables at %#llx..\n", q_pa, q_pa + Q_ARENA - 1,
+		    (uint64_t)kvtophys(q_tables));
+	}
+	if (r6_va != 0 && r6_tables != 0) {
+		/* scan139 46cn2p: the RDDM arena, same page attributes as the BHIe arena's, four level-3 tables of its own */
+		for (uint32_t k = 0; k < E3_ARENA >> 21; k++) {
+			l2[((r6_pa >> 21) & 0x1ff) + k] = kvtophys(r6_tables + k * 0x1000) | 3;
+		}
+		for (uint32_t i = 0; i < E3_ARENA / 0x1000; i++) {
+			uint64_t pa = r6_pa + i * 0x1000ull;
+			((uint64_t *)r6_tables)[i] = (pa & 0xfffffffff000ull) | 3 | 1ull << 10 | 2ull << 8 | 1ull << 6 | 1ull << 11 |
+			    3ull << 53;
+		}
+		e2a_clean(r6_tables, PAGE_SIZE);
+		say("icepcie: 46cn2p RDDM arena in bank 9: IOVA %#llx..%#llx, level-3 tables at %#llx\n", r6_pa, r6_pa + E3_ARENA - 1,
+		    (uint64_t)kvtophys(r6_tables));
+	} else if (r6_va != 0) {
+		r6_va = 0;              /* not mapped in the IOMMU: keep the dump in the BHIe arena */
+	}
+	e2a_clean(tables, PAGE_SIZE);
+	say("icepcie: 23e2a tables at %#llx, 1 MB at IOVA %#llx (first page %#llx)\n", pa1, E2A_IOVA,
+	    e2_buf_pa ? e2_buf_pa : kvtophys(buf));
+	SW(gr1, "CBA2R", 0x800 + 4 * E2A_BANK, 1);
+	SW(gr1, "CBAR", 4 * E2A_BANK, E2A_CBAR);
+	SW(cb, "TCR2", 0x10, 2u | 7u << 15);
+	SW(cb, "TTBR0 lo", 0x20, (uint32_t)pa1);
+	SW(cb, "TTBR0 hi", 0x24, (uint32_t)(pa1 >> 32) | E2A_ASID << 16);
+	SW(cb, "TCR", 0x30, 1u << 23 | 3u << 12 | 1u << 10 | 1u << 8 | 32u);
+	SW(cb, "MAIR0", 0x38, 0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24);
+	SW(cb, "MAIR1", 0x3c, 0);
+	SW(cb, "TLBIASID", 0x610, E2A_ASID);
+	SW(cb, "TLBSYNC", 0x7f0, 0);
+	for (int i = 0; i < 1000 && (io_rd(cb, 0x7f4) & 1); i++) {
+		delay(10);
+	}
+	SW(cb, "FSR (clear)", 0x58, io_rd(cb, 0x58));
+	SW(cb, "SCTLR", 0x0, 1u << 5 | 1u << 2 | 1u << 1 | 1u << 0 | 1u << 12);
+	SW(gr0, "S2CR", 0xc00 + 4 * E2A_SMR, E2A_BANK);
+	SW(gr0, "SMR", 0x800 + 4 * E2A_SMR, 1u << 31 | 1u << 16 | 0x1400u);
+	IOSleep(1000);
+	/* FSR bits 10:9 are FORMAT (2 = AArch64, the audio banks read 0x400 too), not a fault: only the fault bits count */
+	say("icepcie: 23e2a held 1 s: bank %u FSR %08x (fault bits %08x) FAR %08x_%08x FSYNR0 %08x (no bus master: no fault "
+	    "expected)\n", E2A_BANK, io_rd(cb, 0x58), io_rd(cb, 0x58) & ~0x600u, io_rd(cb, 0x64), io_rd(cb, 0x60), io_rd(cb, 0x68));
+	if ((io_rd(cb, 0x58) & ~0x600u) == 0) {
+		say("icepcie: 23e2a PASS: SMR %u -> bank %u set for SIDs 0x1400/0x1401, no fault in 1 s\n", E2A_SMR, E2A_BANK);
+	} else {
+		say("icepcie: 23e2a FAULT bits set on bank %u: FSR %08x\n", E2A_BANK, io_rd(cb, 0x58));
+	}
+	if (icepcie >= 5) {
+		int sn4 = 0;
+		PE_parse_boot_argn("icepcie_sn4", &sn4, sizeof(sn4));
+		/*
+		 * 23e2i, icepcie_sn4=1: the PCIe0 -> DDR path's bus vote. Linux's qcom-pcie votes the DT interconnect "pcie-mem"
+		 * (pcie_noc MASTER_PCIE_0 -> mc_virt SLAVE_EBI1, TAG_ALWAYS) before the link comes up (qcom_pcie_icc_init) and
+		 * after it (qcom_pcie_icc_opp_update). On that path (kaanapali.c icc-rpmh: xm_pcie -> qns_pcie_gemnoc ->
+		 * qnm_pcie -> qns_llcc -> llcc_mc -> ebi) BCM "SN4" (qns_pcie_gemnoc) is the one that is not keep-alive; SH0 /
+		 * MC0 are keep-alive and already held for the display. Without SN4 the endpoint's reads of our buffer pass the
+		 * SMMU (no fault) and die in the unclocked NoC -> the PBL's transfer fails. Same kind of command as the ADSP
+		 * kit's CE0 / LP0 votes (BCM peak max, released at the end).
+		 */
+		if (sn4 && hakios_iceland_rpmh_bcm("SN4", true) != 0) {
+			say("icepcie: 23e2i REFUSED: the SN4 vote was not taken: BHI not started\n");
+		} else if ((io_rd(cb, 0x58) & ~0x600u) == 0 && bar != 0) {
+			if (sn4) {
+				say("icepcie: 23e2i SN4 (PCIe0 -> DDR NoC) voted for the BHI step\n");
+			}
+			pcie_e2_bhi(cfg, bar, buf, cb);
+			if (sn4 && icepcie_lx && iceland_ath12k_bar != 0) {
+				/* 46cn3y: the chip now belongs to the Linux driver and DMAs to DDR through this NoC path (Linux holds
+				 * its pcie-mem interconnect vote for the device's lifetime): the vote stays */
+				say("icepcie: 46cn3y harvest after handoff: SN4 (PCIe0 -> DDR NoC) vote KEPT for the Linux driver (route B; "
+				    "was released here before scan236)\n");
+			} else if (sn4) {
+				say("icepcie: 23e2i SN4 released -> %d (bus master already off)\n", hakios_iceland_rpmh_bcm("SN4", false));
+			}
+			/* 23e2g: an unmatched stream would show as a GLOBAL fault, not in bank 9 (reads only) */
+			say("icepcie: 23e2g smmu sCR0 %08x GFSR %08x GFSYNR0 %08x GFSYNR1 %08x; bank 9 FSR %08x FSYNR0 %08x\n",
+			    io_rd(gr0, 0x0), io_rd(gr0, 0x48), io_rd(gr0, 0x50), io_rd(gr0, 0x54), io_rd(cb, 0x58), io_rd(cb, 0x68));
+			if (e2n_afprobe) {
+				uint32_t fsr = io_rd(cb, 0x58);
+				say("icepcie: 23e2n0 AF probe verdict: bank 9 FSR %08x (fault bits %08x) FAR %08x_%08x FSYNR0 %08x FSYNR1 %08x "
+				    "CBFRSYNRA %08x -> %s\n", fsr, fsr & ~0x600u, io_rd(cb, 0x64), io_rd(cb, 0x60), io_rd(cb, 0x68),
+				    io_rd(cb, 0x6c), io_rd(gr1, 0x400 + 4 * E2A_BANK),
+				    (fsr & ~0x600u) ? "the chip's DMA DOES reach bank 9 (our stream / context)" :
+				    "NO fault: the chip's reads did not go through bank 9");
+			}
+		} else {
+			say("icepcie: 23e2 REFUSED: 23e2a's bank shows a fault (FSR %08x) or BAR0 not mapped\n", io_rd(cb, 0x58));
+			if (sn4) {
+				say("icepcie: 23e2i SN4 released -> %d\n", hakios_iceland_rpmh_bcm("SN4", false));
+			}
+		}
+	}
+	if (icepcie_lx) {
+		return;  /* (B) route: leave the SMMU bank 9 + its tables in place for the Linux ath12k driver */
+	}
+	/* teardown, as c2_teardown */
+	SW(gr0, "SMR (as found)", 0x800 + 4 * E2A_SMR, smr0);
+	SW(gr0, "S2CR (as found)", 0xc00 + 4 * E2A_SMR, s2cr0);
+	SW(cb, "SCTLR (M off)", 0x0, 0);
+	SW(cb, "TLBIASID", 0x610, E2A_ASID);
+	SW(cb, "TLBSYNC", 0x7f0, 0);
+	for (int i = 0; i < 1000 && (io_rd(cb, 0x7f4) & 1); i++) {
+		delay(10);
+	}
+	SW(cb, "FSR (clear)", 0x58, io_rd(cb, 0x58));
+	SW(cb, "TTBR0 lo", 0x20, 0);
+	SW(cb, "TTBR0 hi", 0x24, 0);
+	SW(cb, "TCR", 0x30, 0);
+	SW(cb, "TCR2", 0x10, 0);
+	SW(cb, "MAIR0", 0x38, 0);
+	say("icepcie: 23e2a put back: SMR %u %08x S2CR %08x, bank %u SCTLR %08x; CBAR %08x CBA2R %08x left as set (unrouted, "
+	    "M off)\n", E2A_SMR, io_rd(gr0, 0x800 + 4 * E2A_SMR), io_rd(gr0, 0xc00 + 4 * E2A_SMR), E2A_BANK, io_rd(cb, 0),
+	    io_rd(gr1, 4 * E2A_BANK), io_rd(gr1, 0x800 + 4 * E2A_BANK));
+#undef SW
+}
+
+static void
+pcie_e1(vm_offset_t dbi, vm_offset_t atu, vm_offset_t cfg)
+{
+	uint32_t bar0 = io_rd(cfg, 0x10), bar1 = io_rd(cfg, 0x14), cmd = io_rd(cfg, 0x04) & 0xffff;
+	uint32_t rp_cmd = io_rd(dbi, 0x04), rp_win = io_rd(dbi, 0x20), size;
+	vm_offset_t bar;
+
+#define CW(base, name, o, val) do { *(volatile uint32_t *)((base) + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: %s +%03x <- %08x (read back %08x)\n", name, (uint32_t)(o), (uint32_t)(val), io_rd(base, o)); } while (0)
+	say("icepcie: 23e1 as found: ep command %04x bar0 %08x bar1 %08x; root port command %08x window %08x\n", cmd, bar0,
+	    bar1, rp_cmd, rp_win);
+	CW(cfg, "ep cfg", 0x10, 0xffffffffu);
+	size = io_rd(cfg, 0x10);
+	CW(cfg, "ep cfg", 0x10, bar0);
+	say("icepcie: BAR0 sizing read %08x: %s, %s, %u KB\n", size, (size & 6) == 4 ? "64-bit" : "32-bit",
+	    (size & 1) ? "I/O" : "memory", (~(size & ~0xfu) + 1) >> 10);
+	if ((size & 1) || (~(size & ~0xfu) + 1) > 0x200000u) {
+		say("icepcie: 23e1 REFUSED: BAR0 is not a memory BAR of at most 2 MB\n");
+		return;
+	}
+	CW(cfg, "ep cfg", 0x10, 0x40400000u | (bar0 & 0xfu));
+	if ((size & 6) == 4) {
+		CW(cfg, "ep cfg", 0x14, 0);
+	}
+	CW(dbi, "rp dbi", 0x20, 0x405f4040u);
+	CW(dbi, "rp dbi", 0x04, rp_cmd | 2u);
+	CW(atu, "atu", 0x208, 0x40400000u);
+	CW(atu, "atu", 0x20c, 0);
+	CW(atu, "atu", 0x210, 0x405fffffu);
+	CW(atu, "atu", 0x214, 0x40400000u);
+	CW(atu, "atu", 0x218, 0);
+	CW(atu, "atu", 0x200, 0);
+	CW(atu, "atu", 0x204, 1u << 31);
+	CW(cfg, "ep cfg", 0x04, (io_rd(cfg, 0x04) & 0xffff0000u) | cmd | 2u);
+	bar = ml_io_map_unmappable(0x40400000u, 0x2000, VM_WIMG_IO);
+	if (bar != 0) {
+		uint32_t bhi = io_rd(bar, 0x28);
+		say("icepcie: MHI: REGLEN %08x VER %08x CFG %08x CHDBOFF %08x ERDBOFF %08x BHIOFF %08x BHIEOFF %08x CTRL %08x "
+		    "STATUS %08x\n", io_rd(bar, 0x0), io_rd(bar, 0x8), io_rd(bar, 0x10), io_rd(bar, 0x18), io_rd(bar, 0x20), bhi,
+		    io_rd(bar, 0x2c), io_rd(bar, 0x38), io_rd(bar, 0x48));
+		if (bhi != 0 && bhi < 0x1f00 && !(bhi & 3)) {
+			say("icepcie: BHI at +%x: version %u.%u EXECENV %08x STATUS %08x ERRCODE %08x SERIALNU %08x MSMHWID %08x\n",
+			    bhi, io_rd(bar, bhi + 0x4), io_rd(bar, bhi + 0x0), io_rd(bar, bhi + 0x28), io_rd(bar, bhi + 0x2c),
+			    io_rd(bar, bhi + 0x30), io_rd(bar, bhi + 0x40), io_rd(bar, bhi + 0x4c));
+		} else {
+			say("icepcie: BHI offset %08x not plausible: not read\n", bhi);
+		}
+	}
+	if (icepcie >= 4) {
+		e2_dbi = dbi;           /* 23e2g: the root port's COMMAND (bus master) and status for 23e2's BHI */
+		pcie_e2a(cfg, bar);     /* bus mastering off, except inside 23e2's BHI load (icepcie=5) */
+	}
+	if (icepcie_lx) {
+		return;  /* (B) route: leave the iATU + config space in place for the Linux ath12k driver */
+	}
+	IOSleep(500);
+	/* undo, in reverse */
+	CW(cfg, "ep cfg", 0x04, (io_rd(cfg, 0x04) & 0xffff0000u) | cmd);
+	CW(atu, "atu", 0x204, 0);
+	CW(dbi, "rp dbi", 0x04, rp_cmd);
+	CW(dbi, "rp dbi", 0x20, rp_win);
+	if ((size & 6) == 4) {
+		CW(cfg, "ep cfg", 0x14, bar1);
+	}
+	CW(cfg, "ep cfg", 0x10, bar0);
+	say("icepcie: 23e1 done, put back (ep command %04x bar0 %08x)\n", io_rd(cfg, 0x04) & 0xffff, io_rd(cfg, 0x10));
+#undef CW
+}
+
+/*
+ * 23e2n, icepcie_sid=1: the controller's BDF -> SMMU stream-ID table as Linux's qcom_pcie_config_sid_1_9_0 programs it
+ * (kaanapali = cfg_1_9_0) - we never did. PARF_BDF_TO_SID_CFG 0x2c00 bit 0 BYPASS cleared, the 256-entry hash table
+ * PARF_BDF_TO_SID_TABLE_N 0x2000 zeroed, then one entry per DT iommu-map line (RID 0 -> 0x1400, RID 0x100 -> 0x1401,
+ * SID base 0x1400): at index crc8(poly 0x07, MSB first, over the big-endian RID) the value RID << 16 | (SID - base)
+ * << 8 | next 0. Same kind of write as 23d2's PARF writes; table and CFG put back as found at 23d2's undo. Every run of
+ * this kernel logs the CFG and the non-zero entries as found (read only).
+ */
+static uint32_t e2n_tbl0[256], e2n_cfg0;
+static bool e2n_done;
+
+static uint8_t
+e2n_crc8(uint16_t rid)
+{
+	uint8_t p[2] = { (uint8_t)(rid >> 8), (uint8_t)rid }, c = 0;
+
+	for (int i = 0; i < 2; i++) {
+		c ^= p[i];
+		for (int k = 0; k < 8; k++) {
+			c = (c & 0x80) ? (uint8_t)((c << 1) ^ 0x07) : (uint8_t)(c << 1);
+		}
+	}
+	return c;
+}
+
+static void
+e2n_sid(vm_offset_t p2, bool on)
+{
+	static const uint16_t rid[2] = { 0x0000, 0x0100 };
+	static const uint16_t sid[2] = { 0x1400, 0x1401 };
+	int used = 0;
+
+	if (!on) {
+		if (!e2n_done) {
+			return;
+		}
+		for (int i = 0; i < 256; i++) {
+			*(volatile uint32_t *)(p2 + 4 * i) = e2n_tbl0[i];
+		}
+		*(volatile uint32_t *)(p2 + 0xc00) = e2n_cfg0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: 23e2n BDF_TO_SID put back: CFG %08x (found %08x), table as found\n", io_rd(p2, 0xc00), e2n_cfg0);
+		e2n_done = false;
+		return;
+	}
+	e2n_cfg0 = io_rd(p2, 0xc00);
+	for (int i = 0; i < 256; i++) {
+		e2n_tbl0[i] = io_rd(p2, 4 * i);
+		if (e2n_tbl0[i] != 0 && used++ < 8) {
+			say("icepcie: 23e2n BDF_TO_SID as found [%d] = %08x\n", i, e2n_tbl0[i]);
+		}
+	}
+	say("icepcie: 23e2n BDF_TO_SID_CFG as found %08x (bypass %u), %d non-zero table entries\n", e2n_cfg0, e2n_cfg0 & 1, used);
+	*(volatile uint32_t *)(p2 + 0xc00) = e2n_cfg0 & ~1u;
+	for (int i = 0; i < 256; i++) {
+		*(volatile uint32_t *)(p2 + 4 * i) = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int j = 0; j < 2; j++) {
+		uint8_t h = e2n_crc8(rid[j]);
+		uint32_t v = io_rd(p2, 4 * h);
+		while (v != 0) {
+			uint8_t cur = h++;
+			if (!(v & 0xff)) {
+				*(volatile uint32_t *)(p2 + 4 * cur) = v | h;
+			}
+			v = io_rd(p2, 4 * h);
+		}
+		*(volatile uint32_t *)(p2 + 4 * h) = (uint32_t)rid[j] << 16 | (uint32_t)(sid[j] - sid[0]) << 8;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: 23e2n BDF_TO_SID RID %04x -> SID %04x: entry [%u] = %08x\n", rid[j], sid[j], h, io_rd(p2, 4 * h));
+	}
+	say("icepcie: 23e2n BDF_TO_SID_CFG <- %08x (bypass off; read back %08x)\n", e2n_cfg0 & ~1u, io_rd(p2, 0xc00));
+	e2n_done = true;
+}
+
+static void
+pcie_d2(vm_offset_t gcc)
+{
+	vm_offset_t parf = ml_io_map_unmappable(0x01c00000u, 0x3000, VM_WIMG_IO);  /* DT parf size 0x3000 */
+	vm_offset_t phy = ml_io_map_unmappable(0x01c06000u, 0x2000, VM_WIMG_IO);
+	vm_offset_t dbi = ml_io_map_unmappable(0x40000000u, 0x2000, VM_WIMG_IO);   /* DBI 0x40000000 + ATU 0x40001000 */
+	vm_offset_t p102 = ml_io_map_unmappable(TLMM_PA + 0x1000u * 102, PAGE_SIZE, VM_WIMG_IO);
+	vm_offset_t cfg = 0;
+	static const uint32_t blk[5][2] = { { 0x1000, 0x1000 }, { 0x0000, 0x0800 }, { 0x0200, 0x0a00 }, { 0x1400, 0x1400 },
+		                            { 0x1800, 0x1800 } };
+	uint32_t ctl102, io102, rcg_cfg, pd0, mux0, v, link = 0, ltssm = 0, x1cap = 0, x1_710 = 0, x1_80c = 0, x1_lnkcap = 0;
+	bool phy_ok = false, rcg_ok = false, x1done = false;
+	int i, x1 = 0;
+
+#define WR(base, name, o, val) do { *(volatile uint32_t *)((base) + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: %s +%04x <- %08x (read back %08x)\n", name, (uint32_t)(o), (uint32_t)(val), io_rd(base, o)); } while (0)
+	if (parf == 0 || phy == 0 || dbi == 0 || p102 == 0) {
+		say("icepcie: 23d2: PARF / PHY / DBI / TLMM not mapped: refused\n");
+		return;
+	}
+	ctl102 = io_rd(p102, 0);
+	io102 = io_rd(p102, 4);
+	rcg_cfg = GCC_RD(0x6b07c);
+	mux0 = GCC_RD(0x6b090);
+	pd0 = io_rd(phy, 0x1440);
+	say("icepcie: 23d2 as found: gpio102 ctl %08x io %08x, rchng cmd %08x cfg %08x, pipe mux %08x, phy pwrdn %08x "
+	    "status %08x, parf ltssm %08x\n", ctl102, io102, GCC_RD(0x6b078), rcg_cfg, mux0, pd0, io_rd(phy, 0x1414),
+	    io_rd(parf, 0x1b0));
+	/* a. PERST# asserted */
+	WR(p102, "gpio102 io", 4, io102 & ~2u);
+	WR(p102, "gpio102 ctl", 0, (ctl102 & ~(0xfu << 2)) | (1u << 9));
+	/* b. rchng 100 MHz */
+	GCC_WR(0x6b07c, (rcg_cfg & ~0x7ffu) | 0x605u);
+	GCC_WR(0x6b078, GCC_RD(0x6b078) | 1u);
+	for (i = 0; i < 100 && (GCC_RD(0x6b078) & 1u); i++) {
+		delay(100);
+	}
+	rcg_ok = !(GCC_RD(0x6b078) & 1u);
+	say("icepcie: rchng update %s (cmd %08x)\n", rcg_ok ? "done" : "NOT DONE in 10 ms", GCC_RD(0x6b078));
+	if (!rcg_ok) {
+		goto undo;
+	}
+	/* c. PHY resets */
+	GCC_WR(0x6c01c, 1);
+	GCC_WR(0x6c028, 1);
+	delay(1000);
+	GCC_WR(0x6c01c, 0);
+	/* d. controller reset and PARF */
+	GCC_WR(0x6b000, 1);
+	delay(1000);
+	GCC_WR(0x6b000, 0);
+	delay(1000);
+	WR(parf, "parf", 0x1000, 4);
+	WR(parf, "parf", 0x40, io_rd(parf, 0x40) & ~1u);
+	WR(parf, "parf", 0x350, 0x40000000u);
+	WR(parf, "parf", 0x354, 0);
+	WR(parf, "parf", 0x634, 0x40001000u);
+	WR(parf, "parf", 0x638, 0);
+	WR(parf, "parf", 0x358, 0);
+	WR(parf, "parf", 0x35c, 0x80000000u);
+	WR(parf, "parf", 0x0, io_rd(parf, 0x0) & ~(1u << 29));
+	WR(parf, "parf", 0x174, io_rd(parf, 0x174) | (1u << 4));
+	WR(parf, "parf", 0x20, io_rd(parf, 0x20) & ~(1u << 5));
+	WR(parf, "parf", 0x1a8, io_rd(parf, 0x1a8) | (1u << 31));
+	/*
+	 * (23e2n / 23e2n1 touched PARF_BDF_TO_SID HERE - before the PHY was powered and its pipe clock ran; six runs hung the
+	 * SoC. Linux (qcom_pcie_host_init: after phy_power_on + post_init) and dada (after link-up) touch it only with the
+	 * PHY up. 23e2q does it the dada way, after link-up: see below.)
+	 */
+	/* e. the PHY */
+	WR(phy, "phy", 0x1440, io_rd(phy, 0x1440) | 3u);
+	for (unsigned t = 0; t < sizeof(pcie0_phy_tbl) / sizeof(pcie0_phy_tbl[0]); t++) {
+		unsigned b = pcie0_phy_tbl[t].block, lanes = (b == QB_TX || b == QB_RX) ? 2 : 1;
+		for (unsigned l = 0; l < lanes; l++) {
+			if (pcie0_phy_tbl[t].lane != 0 && pcie0_phy_tbl[t].lane != l + 1) {
+				continue;
+			}
+			WR(phy, "phy tbl", blk[b][l] + pcie0_phy_tbl[t].off, pcie0_phy_tbl[t].val);
+		}
+	}
+	GCC_WR(0x6b090, 0);
+	GCC_WR(0x52008, GCC_RD(0x52008) | (1u << 4));
+	GCC_WR(0x6c028, 0);
+	WR(phy, "phy", 0x1400, io_rd(phy, 0x1400) & ~1u);
+	WR(phy, "phy", 0x1444, io_rd(phy, 0x1444) | 3u);
+	delay(1000);
+	for (i = 0; i < 100 && (io_rd(phy, 0x1414) & 0x80u); i++) {
+		delay(100);
+	}
+	phy_ok = !(io_rd(phy, 0x1414) & 0x80u);
+	say("icepcie: PHY %s (pcs status1 %08x, pipe cbcr %08x)\n", phy_ok ? "READY" : "NOT ready in 10 ms",
+	    io_rd(phy, 0x1414), GCC_RD(0x6b064));
+	if (!phy_ok) {
+		goto undo;
+	}
+	/* f. bus numbers */
+	WR(dbi, "dbi", 0x18, 0x00ff0100u);
+	/*
+	 * 23e2m: gpio103 = PCIe0 CLKREQ# (DT pinctrl default "pcie0_clk_req_n"): read only, logged with its function.
+	 * icepcie_x1=1 (NEW KIND of write, owner's yes first): cap the root port to x1 before the LTSSM starts, as Linux's
+	 * dw_pcie_link_set_max_link_width() would for num-lanes 1: PORT_LINK_CONTROL 0x710 LINK_CAPABLE (21:16) = 1,
+	 * GEN2_CTRL 0x80c NUM_OF_LANES (12:8) = 1, LnkCap MLW (9:4) = 1 under MISC_CONTROL_1 0x8bc DBI_RO_WR_EN (bit 0).
+	 * Linux on this tablet trains 8 GT/s x1; ours trained x2 with LnkSta LBMS (bit 15) set. All three put back at the
+	 * undo.
+	 */
+	x1cap = io_rd(dbi, 0x34) & 0xfc;
+	for (int n = 0; x1cap != 0 && n < 16 && (io_rd(dbi, x1cap) & 0xff) != 0x10; n++) {
+		x1cap = (io_rd(dbi, x1cap) >> 8) & 0xfc;
+	}
+	{
+		vm_offset_t p103 = ml_io_map_unmappable(TLMM_PA + 0x1000u * 103, PAGE_SIZE, VM_WIMG_IO);
+		if (p103 != 0) {
+			say("icepcie: 23e2m gpio103 (CLKREQ#) ctl %08x (function %u, oe %u, pull %u, drive %u) io %08x (in %u)\n",
+			    io_rd(p103, 0), (io_rd(p103, 0) >> 2) & 0xf, (io_rd(p103, 0) >> 9) & 1, io_rd(p103, 0) & 3,
+			    (io_rd(p103, 0) >> 6) & 7, io_rd(p103, 4), io_rd(p103, 4) & 1);
+		}
+	}
+	x1_710 = io_rd(dbi, 0x710);
+	x1_80c = io_rd(dbi, 0x80c);
+	x1_lnkcap = x1cap ? io_rd(dbi, x1cap + 0xc) : 0;
+	say("icepcie: 23e2m root port as found: PORT_LINK_CONTROL %08x (link capable %#x) GEN2_CTRL %08x (lanes %u) LnkCap %08x "
+	    "(max width x%u, speed %u)\n", x1_710, (x1_710 >> 16) & 0x3f, x1_80c, (x1_80c >> 8) & 0x1f, x1_lnkcap,
+	    (x1_lnkcap >> 4) & 0x3f, x1_lnkcap & 0xf);
+	PE_parse_boot_argn("icepcie_x1", &x1, sizeof(x1));
+	if (x1 && x1cap != 0) {
+		WR(dbi, "dbi MISC_CONTROL_1 (DBI_RO_WR_EN on)", 0x8bc, io_rd(dbi, 0x8bc) | 1u);
+		WR(dbi, "dbi LnkCap (MLW x1)", x1cap + 0xc, (x1_lnkcap & ~(0x3fu << 4)) | (1u << 4));
+		WR(dbi, "dbi MISC_CONTROL_1 (DBI_RO_WR_EN off)", 0x8bc, io_rd(dbi, 0x8bc) & ~1u);
+		WR(dbi, "dbi PORT_LINK_CONTROL (link capable x1)", 0x710, (x1_710 & ~(0x3fu << 16)) | (1u << 16));
+		WR(dbi, "dbi GEN2_CTRL (lanes 1)", 0x80c, (x1_80c & ~(0x1fu << 8)) | (1u << 8));
+		x1done = true;
+	} else if (x1) {
+		say("icepcie: 23e2m icepcie_x1: no express capability found: not capped\n");
+	}
+	if (!x1 && hakios_iceland_omni(0x400)) {
+		/*
+		 * 46cn4b G7 (owner's yes 7 Nov): x1 as Peach forces it (pandora_wifi.c:432-433, before its link training):
+		 * DBI 0x714 |= bit 5, then GEN2_CTRL 0x80c NUM_OF_LANES (12:8) = 1. Fedora trains x1 on this tablet. The link
+		 * wait below is 1 s (as with icepcie_x1); LnkSta logged by the "link UP" line. Under icepcie_lx kept (no undo).
+		 */
+		say("icepcie: 46cn4b G7 before: dbi +714 %08x +80c %08x\n", io_rd(dbi, 0x714), io_rd(dbi, 0x80c));
+		WR(dbi, "dbi +714 (46cn4b G7: bit 5, as Peach)", 0x714, io_rd(dbi, 0x714) | (1u << 5));
+		WR(dbi, "dbi GEN2_CTRL (46cn4b G7: lanes 1, as Peach)", 0x80c, (io_rd(dbi, 0x80c) & ~(0x1fu << 8)) | (1u << 8));
+		x1done = true;
+	}
+	/* g. PERST# released after 100 ms, LTSSM on */
+	IOSleep(100);
+	WR(p102, "gpio102 io", 4, io_rd(p102, 4) | 2u);
+	WR(parf, "parf", 0x1b0, io_rd(parf, 0x1b0) | (1u << 8));
+	/* h. link up? */
+	{
+		uint32_t cap = io_rd(dbi, 0x34) & 0xfc;
+		for (int n = 0; cap != 0 && n < 16 && (io_rd(dbi, cap) & 0xff) != 0x10; n++) {
+			cap = (io_rd(dbi, cap) >> 8) & 0xfc;
+		}
+		/* 23e2m (x1 cap) did not come up in 100 ms (LTSSM 0x4, Polling.Configuration): 1 s with the cap */
+		for (i = 0; i < (x1done ? 1000 : 100); i++) {
+			link = cap ? io_rd(dbi, cap + 0x10) >> 16 : 0;
+			ltssm = io_rd(parf, 0x1b0) & 0x3f;
+			if (link & (1u << 13)) {
+				break;
+			}
+			delay(1000);
+		}
+		say("icepcie: link %s after %d ms: lnksta %04x (speed %u, width x%u), ltssm state %#x, express cap at %#x\n",
+		    (link & (1u << 13)) ? "UP" : "NOT up", i, link, link & 0xf, (link >> 4) & 0x3f, ltssm, cap);
+	}
+	if (link & (1u << 13)) {
+		int sidarg = 0;
+		PE_parse_boot_argn("icepcie_sid", &sidarg, sizeof(sidarg));
+		if (sidarg > 0) {
+			/*
+			 * 23e2q: the BDF -> SID table the dada way (hakios-arm64e-dada hakios_dada_wifi.c link_up, same chip
+			 * 17cb:110e, same PCIe0 addresses; APSL, approach): right after the link is UP, before the iATU - the PHY
+			 * powered and its pipe clock running -, through the PARF mapping itself (0x3000: PARF + 0x2000 / + 0x2c00).
+			 * dada: "left in its default bypass the controller tags the chip's DMA with a stream nobody let through".
+			 * Values as Linux qcom_pcie_config_sid_1_9_0. Put back before the LTSSM goes off at the undo.
+			 */
+			say("icepcie: 23e2q BDF_TO_SID after link-up (PHY up): CFG %08x\n", io_rd(parf, 0x2c00));
+			e2n_sid(parf + 0x2000, true);
+		}
+		vm_offset_t atu = dbi + 0x1000;
+		WR(atu, "atu", 0x08, 0x40100000u);
+		WR(atu, "atu", 0x0c, 0);
+		WR(atu, "atu", 0x10, 0x401fffffu);
+		WR(atu, "atu", 0x14, 0x01000000u);
+		WR(atu, "atu", 0x18, 0);
+		WR(atu, "atu", 0x00, 4);
+		WR(atu, "atu", 0x04, 1u << 31);
+		cfg = ml_io_map_unmappable(0x40100000u, PAGE_SIZE, VM_WIMG_IO);
+		if (cfg != 0) {
+			v = io_rd(cfg, 0);
+			say("icepcie: config space of bus 1 dev 0: %08x (vendor %04x device %04x)%s; class %08x\n", v, v & 0xffff,
+			    v >> 16, v == 0x110e17cbu ? " = THE WCN7860 (17cb:110e)" : " (not 17cb:110e)", io_rd(cfg, 8));
+			if (v == 0x110e17cbu) {
+				/* 23e2m: both ends' link capability / status and AER (correctable included) right at link-up */
+				e2_capdiag("endpoint at link-up", cfg);
+				e2_capdiag("root port at link-up", dbi);
+			}
+			if (icepcie >= 3 && v == 0x110e17cbu) {
+				pcie_e1(dbi, atu, cfg);
+			} else if (icepcie >= 3) {
+				say("icepcie: 23e1 REFUSED: bus 1 dev 0 is not 17cb:110e\n");
+			}
+		}
+		if (icepcie_lx) {
+			/* 46cn3y: 46cn3t's config reads went all-ones from here (44.507 s): the driver keeps its config access */
+			say("icepcie: 46cn3y: config window kept (route B): iATU region 0 ctrl2 %08x not disabled\n",
+			    io_rd(atu, 0x04));
+		} else {
+			IOSleep(1000);
+			WR(atu, "atu", 0x04, 0);
+		}
+	}
+	if (icepcie_lx) {
+		return;  /* (B) route: leave the PCIe link up for the Linux ath12k driver */
+	}
+undo:
+	say("icepcie: 23d2: undoing\n");
+	if (e2n_done) {
+		e2n_sid(parf + 0x2000, false);  /* 23e2q: before the LTSSM goes off, PHY still up */
+	}
+	WR(parf, "parf", 0x1b0, io_rd(parf, 0x1b0) & ~(1u << 8));
+	if (x1done) {
+		WR(dbi, "dbi GEN2_CTRL (as found)", 0x80c, x1_80c);
+		WR(dbi, "dbi PORT_LINK_CONTROL (as found)", 0x710, x1_710);
+		WR(dbi, "dbi MISC_CONTROL_1 (DBI_RO_WR_EN on)", 0x8bc, io_rd(dbi, 0x8bc) | 1u);
+		WR(dbi, "dbi LnkCap (as found)", x1cap + 0xc, x1_lnkcap);
+		WR(dbi, "dbi MISC_CONTROL_1 (DBI_RO_WR_EN off)", 0x8bc, io_rd(dbi, 0x8bc) & ~1u);
+	}
+	WR(p102, "gpio102 io", 4, io_rd(p102, 4) & ~2u);
+	if (rcg_ok) {
+		WR(phy, "phy", 0x1444, 0);
+		WR(phy, "phy", 0x1400, io_rd(phy, 0x1400) | 1u);
+		WR(phy, "phy", 0x1440, pd0);
+		GCC_WR(0x6c028, 1);
+		GCC_WR(0x6c01c, 1);
+		delay(100);
+		GCC_WR(0x6c01c, 0);
+		GCC_WR(0x6c028, 0);
+		GCC_WR(0x6b090, mux0);
+	}
+	GCC_WR(0x6b07c, rcg_cfg);
+	GCC_WR(0x6b078, GCC_RD(0x6b078) | 1u);
+	WR(p102, "gpio102 ctl", 0, ctl102);
+	WR(p102, "gpio102 io", 4, io102);
+	say("icepcie: 23d2 %s; put back: gpio102 %08x/%08x, pipe mux %08x, rchng cfg %08x\n",
+	    (link & (1u << 13)) ? "PASS (link up)" : phy_ok ? "PHY ready, link NOT up" : "FAILED / refused", io_rd(p102, 0),
+	    io_rd(p102, 4), GCC_RD(0x6b090), GCC_RD(0x6b07c));
+#undef WR
+}
