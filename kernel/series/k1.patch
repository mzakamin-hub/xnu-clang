+static int
+ramfs_pathconf(struct vnop_pathconf_args *ap)
+{
+	switch (ap->a_name) {
+	case _PC_LINK_MAX:
+		*ap->a_retval = 32767;
+		return 0;
+	case _PC_NAME_MAX:
+		*ap->a_retval = RAMFS_MAX_NAME;
+		return 0;
+	case _PC_PATH_MAX:
+		*ap->a_retval = MAXPATHLEN;
+		return 0;
+	case _PC_PIPE_BUF:
+		*ap->a_retval = PIPE_BUF;
+		return 0;
+	case _PC_CHOWN_RESTRICTED:
+	case _PC_NO_TRUNC:
+		*ap->a_retval = 200112;
+		return 0;
+	case _PC_CASE_SENSITIVE:
+	case _PC_CASE_PRESERVING:
+		*ap->a_retval = 1;
+		return 0;
+	case _PC_FILESIZEBITS:
+		*ap->a_retval = 64;
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
