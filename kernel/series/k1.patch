+	       !video.v_rotate && video.v_width <= 16384 && video.v_height <= 16384 && video.v_rowBytes >= video.v_width * 4 &&
+	       video.v_rowBytes <= UINT64_MAX / video.v_height;
+}
+
+// Every 10 s while anything changes, for 20 minutes: the swaps the compositor submitted, accepted and refused, the frames copied.
+void report(void *, wait_result_t)
+{
+	char last[256] = "", lastPace[240] = "", lastLock[240] = "";
+	uint64_t phaseBefore[6] = {};
+	for (unsigned round = 1; round <= 120; round++) {
+		IOSleep(10 * 1000);
+		char line[320], pace[240];
+		// The pace of the newest swaps, from the display's event ring (event 1: validated, 6: retired): the gaps between validations
+		// tell a clocked compositor (even gaps) from one that presents as fast as it renders; hold is validation to retirement.
+		uint64_t gapMin = 0, gapMax = 0, gapSum = 0, holdSum = 0, before = 0, validated = 0;
+		unsigned gaps = 0, holds = 0;
+		if (native_legacy_ring_cap) {
+			const uint32_t end = native_legacy_ring_count, mask = native_legacy_ring_cap - 1;
+			for (uint32_t i = end > 512 ? end - 512 : 0; i != end; i++) {
+				const uint64_t at = native_legacy_ring[i & mask][0], event = native_legacy_ring[i & mask][1] >> 56;
+				if (event == 1) {
+					if (before && at > before) {
+						const uint64_t gap = at - before;
+						gapMin = (!gaps || gap < gapMin) ? gap : gapMin;
+						gapMax = gap > gapMax ? gap : gapMax;
+						gapSum += gap;
+						gaps++;
+					}
+					before = validated = at;
+				} else if (event == 6 && validated && at >= validated) {
+					holdSum += at - validated;
+					holds++;
+					validated = 0;
+				}
+			}
+		}
+		const volatile uint32_t *f = native_legacy_formats;
+		const volatile uint32_t *s = native_legacy_swapstat;
+		// kicks: the family's kickSwapQueue calls, refused (not ready / no validated head); vsync: timer started, armed, sent (on
+		// macOS: ticks), idle
+		snprintf(line, sizeof(line), "%u swaps accepted (bgra %u, half %u), %u refused (last reason %u, format %08x), %u copied "
+		    "(%llu us mean, %llu us max), %u retired, %u clients (%u refused), kicks %u (not ready %u, no head %u), "
+		    "vsync start %u armed %u sent %u idle %u",
+		    gAccepted, f[0] + f[1], f[2], gRefused, gLastReason, f[4], gCopies,
+		    gCopies ? ticksToUs(gCopyTicks) / gCopies : 0ULL, ticksToUs(gCopyMax), gRetired, gClients, gClientFails,
+		    s[1], s[3], s[4], gVsync[4], gVsync[0], gVsync[1], gVsync[2]);
+		if (strcmp(line, last)) {
+			IOLog("disp: %u s: %s\n", round * 10, line);
+			strlcpy(last, line, sizeof(last));
+		}
+		// A line of its own (the first one stays as the runs' tools know it; their evidence keeps 240 columns of a line): the late
+		// ticks; notify: the notification types with a client, one bit a type (bit 5: vsync); gap: min/mean/max between the
+		// newest validations; hold: validation to retirement
+		// phases: this round's copied swaps, their mean time from validation to the kick, for the surface's view, its cleaning
+		// before the copy and its release, in us; views: the kept views mapped this round (fb-view=1; 0 once each surface has one)
+		uint64_t ph[6];
+		for (unsigned i = 0; i < 6; i++) {
+			const uint64_t total = native_legacy_phase[i];
+			ph[i] = total - phaseBefore[i];
+			phaseBefore[i] = total;
+		}
+		const uint64_t n = ph[0] ? ph[0] : 1;
+		snprintf(pace, sizeof(pace), "vsync late %u, notify %#x, gap %llu/%llu/%llu us of %u, hold %llu us, phases "
+		    "%llu/%llu/%llu/%llu us of %llu, views %llu", gVsync[3],
+		    native_legacy_notify_types(gDisplay), gapMin, gaps ? gapSum / gaps : 0ULL, gapMax, gaps, holds ? holdSum / holds : 0ULL,
+		    ph[1] / n, ticksToUs(ph[2]) / n, ticksToUs(ph[3]) / n, ticksToUs(ph[4]) / n, ph[0], ph[5]);
+		if (strcmp(pace, lastPace)) {
+			IOLog("disp: %u s: pace: %s\n", round * 10, pace);
+			strlcpy(lastPace, pace, sizeof(lastPace));
+		}
+		// fb-view=1's kept views, every round once one was mapped (a leak would show as live views or mapped bytes growing):
+		// live now and the bytes they map; mapped and dropped in all (dropped because their surface was freed elsewhere / idle);
+		// the kernel's wired pages (vm_page_wire_count) beside them
+		// dpu-direct=1: flips, surfaces mapped / failed, latch mean / longest, fallbacks to the copy, GPU fence waits (mean, cut at 50 ms)
+		const volatile uint32_t *x = native_legacy_direct;
+		if (x[0] || x[2]) {
+			IOLog("disp: %u s: direct: %u flips, %u mapped (%u failed, %u let go), latch %u/%u us, %u copied instead, "
+			    "fence waits %u (%u us mean, %u cut)\n", round * 10, x[0], x[1], x[2], x[6], x[0] ? x[5] / x[0] : 0, x[4], x[7],
+			    x[9], x[9] ? x[10] / x[9] : 0, x[12]);
+		}
+		// vsync-lock=1 (w6-perf), since the start: ticks placed by the panel's phase / by its period only / by the tick's own clock;
+		// stops when idle and starts after; the panel's measured period (and rate); refreshes a tick; the mean distance of a refresh
+		// start from the earlier ones' grid; the mean time since the refresh began at a tick; late ticks; whether the phase was dropped
+		const volatile uint64_t *k = native_legacy_lock;
+		if (k[0] || k[1] || k[2] || k[3]) {
+			char lock[240];
+			const uint64_t ps = k[5], centiHz = ps ? 100000000000000ull / ps : 0;
+			snprintf(lock, sizeof(lock), "lock: ticks %llu phase, %llu period, %llu own; %llu stops, %llu starts; period %llu.%03llu us "
+			    "(%llu.%02llu Hz) x%llu; phase error %llu us mean of %llu; %llu us after the refresh; %llu late%s", k[0], k[1], k[2],
+			    k[3], k[4], ps / 1000000, (ps / 1000) % 1000, centiHz / 100, centiHz % 100, k[6], k[8] ? k[7] / k[8] : 0ULL, k[8],
+			    k[0] ? k[9] / k[0] : 0ULL, k[10], k[11] ? "; phase dropped" : "");
+			if (strcmp(lock, lastLock)) {
+				IOLog("disp: %u s: %s\n", round * 10, lock);
+				strlcpy(lastLock, lock, sizeof(lastLock));
+			}
+		}
+		// gpu: the copies that waited for the GPU's fence, their mean wait, the waits cut at 50 ms (all since the start)
+		const volatile uint64_t *v = native_legacy_views, *g = native_legacy_gpuwait;
+		if (v[2]) {
+			IOLog("disp: %u s: views %llu live, %llu MB mapped; %llu mapped, %llu dropped (%llu freed, %llu idle); wired %llu MB; "
+			    "gpu waits %llu (%llu us mean, %llu cut)\n", round * 10, v[0], v[1] >> 20, v[2], v[3], v[4], v[5],
+			    ((uint64_t)vm_page_wire_count * PAGE_SIZE) >> 20, g[0], g[0] ? g[1] / g[0] : 0ULL, g[2]);
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+__attribute__((noreturn)) void fail(int step, const char *why)
+{
+	gStage = -step;
+	IOLog("disp: not started (step %d: %s)\n", step, why);
+	thread_terminate(current_thread());
+	__builtin_unreachable();
+}
+
+bool loadKext(const char *id)
+{
+	const OSReturn r = OSKextLoadKextWithIdentifier(id);
+	if (r != kOSReturnSuccess && r != kOSKextReturnStartStopError) {
+		IOLog("disp: %s not loaded (%#x)\n", id, r);
+		return false;
+	}
+	return true;
+}
+
+// The class registration and the family kext loads wait on libkern's load lock, and they made the SystemOS container come up late:
+// QEMU bars 1 and 2 panicked "offline owner SystemOS mount failed: 80" (the raw disk was selected before its APFS container was
+// published). The display is needed by WindowServer, a minute or more after launchd: start once pid 1 is launchd, i.e. once
+// load_init_program has mounted the SystemOS cryptex (kern_exec.c native_owner_cache_prepare), at most 180 s after IOBSD.
+}  // namespace
+extern "C" void native_wait_for_launchd(const char *who)
+{
+	for (unsigned tick = 0; tick < 360; tick++) {
+		proc_t init = proc_find(1);
+		char name[20] = {};
+		if (init != nullptr) {
+			proc_name(1, name, sizeof(name));
+			proc_rele(init);
+		}
+		if (!strcmp(name, "launchd")) {
+			IOLog("%s: launchd runs (%u ms after IOBSD): starting\n", who, tick * 500);
+			IOSleep(2000);
+			return;
+		}
+		IOSleep(500);
+	}
+	IOLog("%s: no launchd after 180 s: starting anyway\n", who);
+}
+namespace {
+
+// iceland w4-scale: the OnePlus Pad 4's panel, 3392 x 2400 on a 13.2 inch diagonal: 4155 / 13.2 = 315 dots per inch
+const uint32_t kIcelandPanelDpi = 315;
+uint32_t gScaleAsked, gScaleDpi;
+
+void worker(void *, wait_result_t)
+{
+	native_wait_for_launchd("disp");
+	PE_Video video = {};
+	if (!videoUsable(video)) {
+		fail(1, "no usable boot framebuffer (PE_current_console)");
+	}
+	IOLog("disp: boot framebuffer %llx %lux%lu, %lu B a row, depth %lu, display %lu\n", (unsigned long long)video.v_baseAddr,
+	    video.v_width, video.v_height, video.v_rowBytes, video.v_depth, video.v_display);
+	// the parent class, the surfaces and the timing elements: their kexts first (no personality on this board)
+	if (!loadKext("com.apple.iokit.IOMobileGraphicsFamily") || !loadKext("com.apple.iokit.IOSurface") ||
+	    !loadKext("com.apple.iokit.IOAVFamily")) {
+		fail(2, "a family kext");
+	}
+	void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+	if (!handle) {
+		fail(3, "preModLoad");
+	}
+	native_legacy_display_static_init();
+	OSReturn meta = OSMetaClass::postModLoad(handle);
+	if (meta) {
+		IOLog("disp: postModLoad %#x\n", meta);
+		fail(4, "the metaclass");
+	}
+	IOService *display = native_legacy_display_allocate();
+	if (!display || !display->metaCast("IOMobileFramebufferLegacy") || !display->metaCast("IOMobileFramebuffer") || !display->init()) {
+		OSSafeReleaseNULL(display);
+		fail(5, "the display object");
+	}
+	// sheng :643-655: the IOSurface root (macOS leaves it unnamed: its class name)
+	OSDictionary *matching = IOService::nameMatching("IOSurfaceRoot");
+	IOService *surface = matching ? IOService::waitForMatchingService(matching, 10 * NSEC_PER_SEC) : nullptr;
+	const bool surfaceFound = surface != nullptr;
+	OSSafeReleaseNULL(surface);
+	OSSafeReleaseNULL(matching);
+	if (!surfaceFound) {
+		display->release();
+		fail(6, "no IOSurfaceRoot in 10 s");
+	}
+	// sheng :666-736: the nub on the boot framebuffer's memory, under the resources; the display-subsystem node for phase 4
+	IOService *nub = new IOService;
+	IODeviceMemory *memory = IODeviceMemory::withRange(video.v_baseAddr, video.v_rowBytes * video.v_height);
+	OSArray *ranges = OSArray::withCapacity(1);
+	IOService *parent = IOService::getResourceService();
+	bool nubAttached = false, nubStarted = false, dtAttached = false, attached = false, started = false;
+	IORegistryEntry *dtParent = nullptr;
+	unsigned phase = 0;
+	PE_parse_boot_argn("offline-legacy-phase", &phase, sizeof(phase));
+	if (nub && memory && ranges && parent && nub->init()) {
+		ranges->setObject(memory);
+		nub->setDeviceMemory(ranges);
+		nub->setName("NativeGOPFramebuffer");
+		// the panel's density in dots per inch (gop-dpi=N), which the display turns into its physical size and WindowServer into its
+		// default scale (sheng :674-681 hard-codes its own panel's 294); without it no size is published
+		uint32_t dpi = 0;
+		if (!PE_parse_boot_argn("gop-dpi", &dpi, sizeof(dpi))) {
+			dpi = 0;
+		}
+		// iceland w4-scale, icedisp_scale=2: the desktop at two pixels a point, a Mac's built-in Retina display. It is the
+		// default since the owner made 2x macOS's default: pexpert/arm/pe_builtin_args.c builds it in and the line wins,
+		// so icedisp_scale=1 (or 0) asks for the display of no density again. The mode list stays the one panel-size mode
+		// and the compositor's surface stays panel size; what changes is that the display now has a density (this panel's:
+		// 3392 x 2400 on 13.2 inches is 315 dots per inch, icedisp_dpi=<50..1000> for another), so DisplayAttributes and
+		// the EDID carry a physical size and selector 28 answers. WindowServer makes the 2x mode the default for a panel
+		// that dense and the 1x mode for one of no size (UniXNU-sheng LegacyDisplayProbe.cpp:674-681, its macOS run40).
+		// gop-dpi=N, when given, is the density as before; on a QEMU run the density is the bochs panel's and nothing else.
+		uint32_t scale = 0;
+		PE_parse_boot_argn("icedisp_scale", &scale, sizeof(scale));
+		gScaleAsked = scale;
+		if (scale == 2 && !dpi) {
+			uint32_t own = 0;
+			dpi = (PE_parse_boot_argn("icedisp_dpi", &own, sizeof(own)) && own >= 50 && own <= 1000) ? own : kIcelandPanelDpi;
+		}
+		gScaleDpi = dpi;
+		if (dpi) {
+			if (OSData *pitch = OSData::withBytes(&dpi, sizeof(dpi))) {
+				nub->setProperty("dot-pitch", pitch);
+				pitch->release();
+			}
+		}
+		nubAttached = nub->attach(parent);
+		nubStarted = nubAttached && nub->start(parent);
+		if (nubStarted && phase == 4) {
+			dtParent = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+			const char type[] = "display-subsystem";
+			OSData *data = OSData::withBytes(type, sizeof(type));
+			if (dtParent && data && nub->setProperty("device_type", data)) {
+				nub->setName("gop-display", gIODTPlane);
+				dtAttached = nub->attachToParent(dtParent, gIODTPlane);
+			}
+			OSSafeReleaseNULL(data);
+		}
+		if (nubStarted && (phase != 4 || dtAttached)) {
+			SInt32 score = 0;
+			gStage = 7;
+			if (display->probe(nub, &score) == display && (attached = display->attach(nub))) {
+				gStage = 8;
+				started = display->start(nub);
+			}
+		}
+	}
+	if (!started) {
+		// Nothing is taken apart: a display whose start failed has already been stopped by its own start (startDisplay), and
+		// freeing it runs the family's teardown on a half-made object (disp-1 bar 1: a panic seconds after a failed start). The
+		// objects stay, unregistered; the nub too. One line says why.
+		IOLog("disp: display not started: nub %d/%d, /arm-io %d, attach %d, phase %u, boot display %lu (the display needs 1)\n",
+		    nubAttached, nubStarted, dtAttached, attached, phase, video.v_display);
+		finishUnitScalePolicy(false);
+		OSSafeReleaseNULL(dtParent);
+		fail(9, "the display's start");
+	}
+	finishUnitScalePolicy(true);
+	OSSafeReleaseNULL(dtParent);
+	OSSafeReleaseNULL(ranges);
+	OSSafeReleaseNULL(memory);
+	gDisplay = display;
+	gNub = nub;
+	gStage = 10;
+	OSObject *uuid = display->getProperty("IOMFBUUID");
+	OSString *uuidText = OSDynamicCast(OSString, uuid);
+	IOLog("disp: NativeLegacyDisplay started on %s (%lux%lu at %llx): IOMFBUUID %s, registered %u\n", nub->getName(),
+	    video.v_width, video.v_height, (unsigned long long)video.v_baseAddr, uuidText ? uuidText->getCStringNoCopy() : "-",
+	    gRegistrations);
+	// iceland w4-scale: what the display tells WindowServer about its density, one line (the scale itself is WindowServer's choice)
+	if (gScaleAsked && gScaleAsked != 2) {
+		IOLog("disp: scale: icedisp_scale=%u is not a scale of this display (2 only): no density from it\n", gScaleAsked);
+	}
+	if (gScaleDpi) {
+		IOLog("disp: scale: icedisp_scale=%u: %u dots per inch, a %lu x %lu mm panel (%lu x %lu cm in DisplayAttributes); "
+		    "2 pixels a point looks like %lux%lu\n", gScaleAsked, gScaleDpi, video.v_width * 254 / gScaleDpi / 10,
+		    video.v_height * 254 / gScaleDpi / 10, (video.v_width * 254 / gScaleDpi + 50) / 100,
+		    (video.v_height * 254 / gScaleDpi + 50) / 100, video.v_width / 2, video.v_height / 2);
+	} else {
+		IOLog("disp: scale: no density (icedisp_scale is not 2 and no gop-dpi): the display has no physical size, as before\n");
+	}
+	thread_t thread = nullptr;
+	if (kernel_thread_start(report, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	thread_terminate(current_thread());
