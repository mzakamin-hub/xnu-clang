+static void
+heartbeat(uint32_t s)
+{
+	uint32_t unused = 0;
+
+	say("hold %u s: init %#x hfi %#x rpmh state %#x busy %#x pwr/clk %#x rscc %#x ao %#x\n", s,
+	    G(G8_GMU_CM3_FW_INIT_RESULT), G(G8_GMU_HFI_CTRL_STATUS), G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+	    G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS), G(G8_GMU_PWR_CLK_STATUS), RSCC(G8_GPU_RSCC_RSC_STATUS0_DRV0),
+	    G(G8_GMU_ALWAYS_ON_COUNTER_L));
+	(void)hfi_receive(2, ~0u, &unused);
+	(void)smmu_faulted("hold");
+}
