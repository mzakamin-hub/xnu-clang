+/*
+ * icetb24 (w4-timebase): a 24 MHz Mach timebase over the hardware counter.
+ *
+ * Every Apple arm64 SoC's timebase is 24 MHz (mach_timebase_info 125/3), and macOS user space leans on it: CoreAudio's
+ * host clock frequency is one constant, 24000000. This board's counter runs at 19.2 MHz (QEMU's at 62.5 MHz). With
+ * boot-arg icetb24=1 the kernel's timebase is the counter scaled by num/den (5/4 on the tablet, 48/125 in QEMU):
+ * every kernel read of the counter goes through counter_to_timebase() (speculative_timebase/nonspeculative_timebase
+ * below: ml_get_hwclock, ml_get_timebase, mach_absolute_time, mach_continuous_time and all they feed), a decrementer
+ * value is turned back into counter ticks (ml_set_decrementer), and gPEClockFrequencyInfo.timebase_frequency_hz is
+ * 24000000, so rtclock's constants, hw.tbfrequency and the CPU nodes' timebase-frequency say 24 MHz.
+ * User space cannot be given the counter as its timebase any more: user_timebase_type() answers USER_TIMEBASE_NONE and
+ * libsystem's mach_absolute_time takes its kernel trap (libsyscall/wrappers/mach_absolute_time.s). EL0 keeps its
+ * access to CNTVCT_EL0/CNTFRQ_EL0: code that reads the counter with its own frequency stays right in itself.
+ * The way is UniXNU's (macOS profile, timebase-hz, from macOS-DroidVM 0042; BSD-2-Clause-Patent); the code is ours.
+ * icetb24=<Hz> (1000000 or more) asks for another rate: a lab switch, for the scale-up case in QEMU.
+ * Set once by pexpert (pe_identify_machine.c), on the boot processor before any other runs, and never changed.
+ */
+uint32_t ml_tb_num = 1, ml_tb_den = 1;          /* timebase ticks = counter ticks * num / den */
+uint64_t ml_tb_counter_hz;                      /* the counter's own rate; 0: the timebase is the counter */
+static uint32_t ml_tb_den_shift = 64;           /* log2(den) when den is a power of two, else 64 */
+uint64_t ml_tb_trap_counts[MAX_CPUS][8];        /* [cpu][0] mach_absolute_time traps, [1] mach_continuous_time traps */
+
+void
+ml_timebase_set_scale(uint32_t num, uint32_t den, uint64_t counter_hz)
+{
+	ml_tb_den_shift = (den & (den - 1)) == 0 ? (uint32_t)__builtin_ctz(den) : 64;
+	ml_tb_counter_hz = counter_hz;
+	ml_tb_den = den;
+	ml_tb_num = num;
+}
+
+static inline bool
+ml_tb_scaled(void)
+{
+	return ml_tb_num != ml_tb_den;
+}
