+    assert struct.unpack_from('<I', d, 0)[0] == 0xfeedfacf, 'not a 64-bit Mach-O'
+    ncmds = struct.unpack_from('<I', d, 16)[0]
+    p, sections, segments, symtab = 32, [], [], None
+    for _ in range(ncmds):
+        cmd, size = struct.unpack_from('<II', d, p)
+        if cmd == 0x19:
+            vmaddr, vmsize, fileoff, filesize = struct.unpack_from('<4Q', d, p + 24)
+            segments.append((vmaddr, vmsize, fileoff, filesize))
+            for i in range(struct.unpack_from('<I', d, p + 64)[0]):
+                s = p + 72 + i * 80
+                sections.append(dict(addr=struct.unpack_from('<Q', d, s + 32)[0], size=struct.unpack_from('<Q', d, s + 40)[0],
+                                     offset=struct.unpack_from('<I', d, s + 48)[0], reloff=struct.unpack_from('<I', d, s + 56)[0],
+                                     nreloc=struct.unpack_from('<I', d, s + 60)[0]))
+        elif cmd == 0x2:
+            symtab = struct.unpack_from('<4I', d, p + 8)
+        p += size
+    return sections, segments, symtab
+
+
+def check_kernelcache(abi, kc_path):
+    kc = open(kc_path, 'rb').read()
+    assert hashlib.sha256(kc).hexdigest() == abi['kernelcache_sha256'], 'the fixture describes another kernelcache'
+    _, segments, _ = macho_sections(kc)
+    for va_text, hexbytes in abi['checks']:
+        va = int(va_text, 16)
+        want = bytes.fromhex(hexbytes)
+        off = next((fo + va - vm for vm, vs, fo, fs in segments if vm <= va < vm + min(vs, fs)), None)
+        assert off is not None and kc[off:off + len(want)] == want, f'check at {va:#x}: the bound accessor is not what the fixture recorded'
+    return len(abi['checks'])
+
+
+def bindings(abi, obj_path, out_stubs, out_addresses, kc_path, provenance):
+    checked = check_kernelcache(abi, kc_path)
+    d = open(obj_path, 'rb').read()
+    sections, _, symtab = macho_sections(d)
+    symoff, nsyms, stroff, _ = symtab
+    syms = []
+    for i in range(nsyms):
+        strx, ntype, nsect, _, value = struct.unpack_from('<IBBHQ', d, symoff + i * 16)
+        syms.append((d[stroff + strx:d.index(b'\0', stroff + strx)].decode(), ntype, nsect, value))
+    by_name = {n: (t, s, v) for n, t, s, v in syms}
+    cls = 'NativeLegacyDisplay'
+    vt_name = f'__ZTV{len(cls)}{cls}'
+    own = (f'__ZN{len(cls)}{cls}', f'__ZNK{len(cls)}{cls}')
+    _, vt_sect, vt_addr = by_name[vt_name]
+    sect = sections[vt_sect - 1]
+    relocs = {}
+    for i in range(sect['nreloc']):
+        address, info = struct.unpack_from('<iI', d, sect['reloff'] + i * 8)
+        relocs[sect['addr'] + address] = (info & 0xffffff, info >> 27 & 1, info >> 28)
+
+    def entry(i):
+        at = vt_addr + 16 + 8 * i
+        if at + 8 > sect['addr'] + sect['size'] or at not in relocs:
+            return None
+        index, extern, kind = relocs[at]
+        word = struct.unpack_from('<Q', d, sect['offset'] + at - sect['addr'])[0]
+        name = syms[index][0] if extern else next(n for n, t, s, v in syms if s == index and v == word & 0xffffffff)
+        return name, word, kind
+
+    slots = [(int(t, 16), int(dv, 16)) for t, dv in abi['slots']]
+    n = len(slots)
+    entries = [entry(i) for i in range(n + 1)]
+    assert all(entries[:n]) and entries[n] is None, f'{vt_name}: not exactly the {n} IOMobileFramebufferLegacy entries'
+    slide = int(abi['collection_slide'], 16)
+    pure_target = int(abi['pure_target'], 16)
+    pure = {i for i, (t, _) in enumerate(slots) if t == pure_target}
+    family = range(*(int(x, 16) for x in abi['family_text']))
+    binds = {k: int(v, 16) for k, v in abi['bindings'].items()}
+    owned, native = [], []
+    for i, (name, word, kind) in enumerate(entries[:n]):
+        target, diversity = slots[i]
+        assert kind == 11 and word >> 63 and word >> 48 & 1 and word >> 49 & 3 == 0 and (word >> 32) & 0xffff == diversity, \
+            f'{vt_name} slot {i} ({name}) is not signed IA, address-diverse, with the original diversity {diversity:#x}'
+        if name.startswith(own):
+            owned.append(i)
+        elif '25IOMobileFramebufferLegacy' in name:
+            assert i not in pure, f'slot {i}: an abstract original slot is not implemented'
+            assert binds.setdefault(name, target) == target, f'slot {i} ({name}): one original address per name'
+        else:
+            assert i < abi['base_slots'] and target not in family, f'slot {i} ({name}) is inherited unchanged by the original family'
+            native.append(i)
+    assert pure <= set(owned), 'every original abstract slot is implemented by the owned backend'
+    undefined = {nm for nm, t, s, v in syms if t & 0x0e == 0 and t & 1}
+    used = {nm for nm in undefined if 'IOMobileFramebufferLegacy' in nm or nm in abi['bindings']}
+    # the fixture's C entries, all of them: the probe's default surface factory (NativeGopDisplayProbe.cpp) also calls the
+    # IOSurface ones the display does not (native_legacy_surface_create, native_legacy_surface_allocate)
+    used |= {nm for nm in abi['bindings'] if nm.startswith('_native_legacy_')}
+    used |= {e[0] for e in entries[:n] if '25IOMobileFramebufferLegacy' in e[0]}
+    # a qualified call of a base method (IOMobileFramebufferLegacy::start) is the original entry of the slot our class
+    # overrides with the same method (NullEthernet's gen_bindings.py:89-92)
+    override_slot = {entries[i][0][len(own[0]) if entries[i][0].startswith(own[0]) else len(own[1]):]: i for i in owned}
+    for name in sorted(used - set(binds)):
+        tail = next((name[len(q):] for q in ('__ZN25IOMobileFramebufferLegacy', '__ZNK25IOMobileFramebufferLegacy') if name.startswith(q)), None)
+        if tail in override_slot:
+            binds[name] = slots[override_slot[tail]][0]
+    assert used <= set(binds), 'unbound original symbols: ' + ', '.join(sorted(used - set(binds)))
+    data = {'__ZN25IOMobileFramebufferLegacy10gMetaClassE', '__ZTV25IOMobileFramebufferLegacy'}
+    stubs = [f'/* {provenance} */', '\t.text', '\t.p2align 2']
+    addresses = [f'/* {provenance} */']
+    for name in sorted(used):
+        va = binds[name] + slide
+        if name in data:
+            addresses += [f'\t.globl {name}', f'\t.set {name}, {va:#x}']
+        else:
+            addresses += [f'\t.globl {name}.original', f'\t.set {name}.original, {va:#x}']
+            stubs += [f'\t.globl {name}', f'{name}:', '\t.long 0xd503245f\t/* bti c */', f'\tb {name}.original']
+    open(out_stubs, 'w').write('\n'.join(stubs) + '\n')
+    open(out_addresses, 'w').write('\n'.join(addresses) + '\n')
+    nd = sum(1 for u in used if u in data)
+    print(f'{vt_name}: {n} slots, each with the original diversity ({len(owned)} ours, {len(native)} the kernel\'s IOService, '
+          f'{n - len(owned) - len(native)} the family\'s); {len(used)} original symbols bound ({nd} data, {len(used) - nd} stubs); '
+          f'{checked} accessor checks equal; slide {slide:#x}')
+
+
+if __name__ == '__main__':
+    mode = sys.argv[1]
+    abi = load(sys.argv[2])
+    if mode == 'header':
+        open(sys.argv[3], 'w').write(header(abi, sys.argv[2].rsplit('/', 1)[-1]))
+        print(f'{sys.argv[3]}: {len(abi["slots"])} slots, {len(abi["names"])} reviewed names checked')
+    elif mode == 'bindings':
+        bindings(abi, *sys.argv[3:8])
+    else:
+        raise SystemExit('gen_abi.py header|bindings ...')
