+#define UFSHC_PHYS              0x01d84000UL
+#define UFSHC_SIZE              0x3000UL
+#define REG_CAP                 0x00
+#define REG_VER                 0x08
+#define REG_IS                  0x20
+#define REG_IE                  0x24
+#define REG_HCS                 0x30
+#define REG_HCE                 0x34
+#define REG_UTRLBA              0x50
+#define REG_UTRLBAU             0x54
+#define REG_UTRLDBR             0x58
+#define REG_UTRLRSR             0x60
+#define REG_MEM_CFG             0x300
+#define IS_UTRCS                (1u << 0)
+#define HCS_UTRLRDY             (1u << 1)
+/* the wake path (iceufs_wake): UFSHCI's UIC registers and bits, as Linux's include/ufs/ufshci.h names them */
+#define REG_AHIT                0x18    /* REG_AUTO_HIBERNATE_IDLE_TIMER (logged only) */
+#define REG_UICCMD              0x90
+#define REG_UCMDARG1            0x94
+#define REG_UCMDARG2            0x98
+#define REG_UCMDARG3            0x9c
+#define IS_UE                   (1u << 2)       /* UIC_ERROR */
+#define IS_UPMS                 (1u << 4)       /* UIC_POWER_MODE */
+#define IS_UHXS                 (1u << 5)       /* UIC_HIBERNATE_EXIT */
+#define IS_UHES                 (1u << 6)       /* UIC_HIBERNATE_ENTER */
+#define IS_ULLS                 (1u << 7)       /* UIC_LINK_LOST */
+#define IS_UCCS                 (1u << 10)      /* UIC_COMMAND_COMPL */
+#define HCS_DP                  (1u << 0)       /* DEVICE_PRESENT */
+#define HCS_UCRDY               (1u << 3)       /* UIC_COMMAND_READY */
+#define HCS_UPMCRS(h)           (((h) >> 8) & 7)        /* UIC_POWER_MODE_CHANGE_REQ_STATUS: 1 = PWR_LOCAL */
+#define UPMCRS_PWR_LOCAL        1
+#define UIC_DME_HIBER_ENTER     0x17
+#define UIC_DME_HIBER_EXIT      0x18
+#define WLUN_UFS_DEVICE         0xd0            /* UFS_UPIU_UFS_DEVICE_WLUN */
