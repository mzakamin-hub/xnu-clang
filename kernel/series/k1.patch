+
+/* (lock held) the slot of a prefix, made if new (the smallest entry gives its place), and the vnode cached against it */
+static int32_t
+ice_wl_insert(struct ice_wl_state *w, vnode_t vp, uint32_t vid, const char *prefix)
+{
+	int32_t slot = -1;
+
+	for (int i = 0; i < ICE_WL_PATHS; i++) {
+		if (w->paths[i].bytes != 0 && strncmp(w->paths[i].prefix, prefix, ICE_WL_PREFIX - 1) == 0) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		slot = 0;
+		for (int i = 1; i < ICE_WL_PATHS; i++) {
+			if (w->paths[i].bytes < w->paths[slot].bytes) {
+				slot = i;
+			}
+		}
+		if (w->paths[slot].bytes != 0) {
+			w->evicted++;
+		}
+		w->paths[slot].bytes = w->paths[slot].last = 0;
+		w->paths[slot].ops = 0;
+		strlcpy(w->paths[slot].prefix, prefix, ICE_WL_PREFIX);
+		for (int i = 0; i < ICE_WL_VCACHE; i++) {
+			if (w->vcache[i].path == slot) {
+				w->vcache[i].vp = NULL;     /* (the slot now names another prefix) */
+			}
+		}
+	}
