+static inline uint32_t scaleBlend(uint32_t near,uint32_t far,uint32_t weight) {
+    const uint32_t rb=(((near&0xff00ff)*(256-weight)+(far&0xff00ff)*weight)>>8)&0xff00ffu;
+    const uint32_t ga=((((near>>8)&0xff00ff)*(256-weight)+((far>>8)&0xff00ff)*weight))&0xff00ff00u;
