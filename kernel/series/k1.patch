+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-2-Clause-Patent
+"""iceland S7 item 9: bind NativeNullEthernet to the 26C5035r collection's own IONetworkingFamily.
+
+UniXNU-sheng 1108068 scripts/build-gop-legacy-display-27.py:767-827 (family_vtable and the bindings it writes for
+ShengEthernet), here on its own and for one class:
+  - the compiled object's __ZTV18NativeNullEthernet has exactly the fixture's IOEthernetController slots (400 for 26C5035r),
+    each signed with the original diversity (IA key, address diversity);
+  - a slot that is not ours and names a family class is the original entry, never the abstract one; any other slot is a
+    kernel IOService method (slot < base_slots);
+  - a qualified call of a base method the family class does not define itself (IOEthernetController::start is
+    IONetworkController's) is bound to the original entry of the slot our class overrides with the same method;
+  - every family symbol the object imports or its vtable names is bound: a metaclass or vtable as an absolute address, a
+    function through a "bti c; b <name>.original" stub (XnuPrelink re-aims the branch after it moves our code).
+The fixture is sheng's scripts/net-ether-<build>.json: original kernelcache addresses; the collection's are those plus
+collection_slide.
+
+  gen_bindings.py FIXTURE.json NativeNullEthernet.cpo OUT_STUBS.s OUT_ADDRESSES.s "provenance line"
+"""
+import json, struct, sys
+
+fixture_path, obj_path, out_stubs, out_addresses, provenance = sys.argv[1:6]
+fx = json.load(open(fixture_path))
+d = open(obj_path, 'rb').read()
+assert struct.unpack_from('<I', d, 0)[0] == 0xfeedfacf, 'not a 64-bit Mach-O object'
+ncmds = struct.unpack_from('<I', d, 16)[0]
+p, sections, symtab = 32, [], None
+for _ in range(ncmds):
+    cmd, size = struct.unpack_from('<II', d, p)
+    if cmd == 0x19:
+        for i in range(struct.unpack_from('<I', d, p + 64)[0]):
+            s = p + 72 + i * 80
+            sections.append(dict(addr=struct.unpack_from('<Q', d, s + 32)[0], size=struct.unpack_from('<Q', d, s + 40)[0],
+                                 offset=struct.unpack_from('<I', d, s + 48)[0], reloff=struct.unpack_from('<I', d, s + 56)[0],
+                                 nreloc=struct.unpack_from('<I', d, s + 60)[0]))
+    elif cmd == 0x2:
+        symtab = struct.unpack_from('<4I', d, p + 8)
+    p += size
+symoff, nsyms, stroff, _ = symtab
+syms = []
+for i in range(nsyms):
+    strx, ntype, nsect, _, value = struct.unpack_from('<IBBHQ', d, symoff + i * 16)
+    syms.append((d[stroff + strx:d.index(b'\0', stroff + strx)].decode(), ntype, nsect, value))
+by_name = {n: (t, s, v) for n, t, s, v in syms}
+cls, base = 'NativeNullEthernet', 'IOEthernetController'
+vt_name = f'__ZTV{len(cls)}{cls}'
+own = (f'__ZN{len(cls)}{cls}', f'__ZNK{len(cls)}{cls}')
+family = tuple(f'{len(c)}{c}' for c in ('IONetworkController', 'IOEthernetController', 'IONetworkMedium', 'IONetworkInterface',
+                                       'IOEthernetInterface', 'IOOutputQueue'))
+_, vt_sect, vt_addr = by_name[vt_name]
+sect = sections[vt_sect - 1]
+relocs = {}
+for i in range(sect['nreloc']):
+    address, info = struct.unpack_from('<iI', d, sect['reloff'] + i * 8)
+    relocs[sect['addr'] + address] = (info & 0xffffff, info >> 27 & 1, info >> 28)
+
+
+def entry(i):
+    at = vt_addr + 16 + 8 * i
+    if at + 8 > sect['addr'] + sect['size'] or at not in relocs:
+        return None
+    index, extern, kind = relocs[at]
+    word = struct.unpack_from('<Q', d, sect['offset'] + at - sect['addr'])[0]
+    name = syms[index][0] if extern else next(n for n, t, s, v in syms if s == index and v == word & 0xffffffff)
+    return name, word, kind
+
+
+slots = [(int(t, 16), int(dv, 16)) for t, dv in fx['slots']]
+n = len(slots)
+entries = [entry(i) for i in range(n + 1)]
+assert all(entries[:n]) and entries[n] is None, f'{vt_name}: not exactly the {n} {base} entries'
+slide = int(fx['collection_slide'], 16)
+pure = int(fx['pure_target'], 16)
+bindings = {k: int(v, 16) for k, v in fx['bindings'].items()}
+used = {name for name, t, s, v in syms if t & 0x0e == 0 and t & 1 and any(c in name for c in family)}
+override_slot = {}
+for i, (name, word, kind) in enumerate(entries[:n]):
+    target, diversity = slots[i]
+    assert kind == 11 and word >> 63 and word >> 48 & 1 and word >> 49 & 3 == 0 and (word >> 32) & 0xffff == diversity, \
+        f'{vt_name} slot {i} ({name}) is not signed IA, address-diverse, with the original diversity {diversity:#x}'
+    if name.startswith(own):
+        override_slot[name[len(own[0]) if name.startswith(own[0]) else len(own[1]):]] = i
+    elif any(c in name for c in family):
+        assert target != pure, f'slot {i}: the abstract original slot is implemented'
+        assert bindings.setdefault(name, target) == target, f'slot {i} ({name}) is not the original entry'
+        used.add(name)
+    else:
+        assert i < fx['base_slots'], f'slot {i} ({name}) is a kernel method beyond the IOService slots'
+for name in sorted(used - set(bindings)):
+    tail = next((name[len(q):] for q in (f'__ZN{len(base)}{base}', f'__ZNK{len(base)}{base}') if name.startswith(q)), None)
+    if tail in override_slot:
+        bindings[name] = slots[override_slot[tail]][0]
+assert not used - set(bindings), f'unbound family symbols: {sorted(used - set(bindings))}'
+data = ('10gMetaClassE', '9metaClassE', '10superClassE')
+stubs = [f'/* {provenance} */', '\t.text', '\t.p2align 2']
+addresses = [f'/* {provenance} */']
+for name in sorted(used):
+    va = bindings[name] + slide
+    if name.startswith('__ZTV') or name.endswith(data):
+        addresses += [f'\t.globl {name}', f'\t.set {name}, {va:#x}']
+    else:
+        addresses += [f'\t.globl {name}.original', f'\t.set {name}.original, {va:#x}']
+        stubs += [f'\t.globl {name}', f'{name}:', '\t.long 0xd503245f\t/* bti c */', f'\tb {name}.original']
+open(out_stubs, 'w').write('\n'.join(stubs) + '\n')
+open(out_addresses, 'w').write('\n'.join(addresses) + '\n')
+nd = sum(1 for u in used if u.startswith('__ZTV') or u.endswith(data))
+print(f'{vt_name}: {n} slots, each with the original diversity; {len(used)} family symbols bound ({nd} data, '
+      f'{len(used) - nd} stubs); slide {slide:#x}')
