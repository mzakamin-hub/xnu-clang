+/* ---- iceidle=1/2 ------------------------------------------------------------------------------------------------ */
+
+extern void hakios_iceland_idle_probe(void);
+extern void hakios_iceland_idle_start(void);
+extern void hakios_iceland_idle_log(void);
+
+/* ---- the thread ------------------------------------------------------------------------------------------------- */
+
+static int icedpu, iceidle, icehw, icewifi, icedsi, icespmi;
+
+static void
+harvest_thread(void *parameter, __unused wait_result_t result)
+{
+	(void)parameter;
+	if (icehw || icewifi) {
+		hw_probe();
+	}
+	if (icegeni == 1) {
+		uint32_t v = 0;
+		say("icegeni: 23h0 (reads + the S5 branch vote, put back)\n");
+		h0_probe(false, &v);
+	} else if (icegeni == 4) {
+		say("icegeni: 23h0b (internal loopback at 115200 and 3.2 Mbaud; bt-enable and pads untouched)\n");
+		h_loop();
+	}
+	if (icespmi) {
+		spmi_probe(icespmi);
+	}
+	if (icewifi) {
+		wifi_power(icewifi);
+	}
+	IOSleep(20 * 1000);
+	say("iceh: 20 s step (icedpu=%d iceidle=%d)\n", icedpu, iceidle);
+	if (icedpu) {
+		dpu_probe("at 20 s");
+	}
+	if (icedsi) {
+		dsi_probe("at 20 s");
+	}
+	if (iceidle >= 1) {
+		hakios_iceland_idle_probe();
+	}
+	if (iceidle >= 2) {
+		hakios_iceland_idle_start();
+	}
+	if (icedpu || icedsi) {
+		IOSleep(40 * 1000);
+		if (icedpu) {
+			dpu_probe("at 60 s");
+		}
+		if (icedsi) {
+			dsi_probe("at 60 s");
+		}
+	}
+	while (iceidle >= 2) {
+		IOSleep(15 * 1000);
+		hakios_iceland_idle_log();
+	}
+}
