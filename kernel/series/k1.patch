+    const void *c __unused, const void *d __unused, const void *e __unused, const void *f __unused)
+{
+	return -1;
+}
diff --git a/osfmk/arm64/gic_v3_irq.c b/osfmk/arm64/gic_v3_irq.c
new file mode 100644
index 0000000000000000000000000000000000000000..3962ab4a3507d9d3c14eafb636a3162715a4ac6d
--- /dev/null
+++ b/osfmk/arm64/gic_v3_irq.c
@@ -0,0 +1,557 @@
+/*
+ * Minimal GICv3 support for generic (non-Apple) ARMv8 boards.
+ *
+ * Open-source XNU has no interrupt controller driver: on Apple hardware that
+ * is a kext (AppleInterruptController), and the timer arrives as FIQ. Here
+ * everything is a Group 1 IRQ, which is what an EL1 guest gets from a stock
+ * hypervisor or from QEMU's virt machine:
+ *
+ *   - the CPU interface is driven through the ICC_*_EL1 system registers
+ *   - the EL1 virtual timer PPI is routed to the kernel's rtclock
+ *   - with more than one processor (psci_smp.c), two software-generated
+ *     interrupts carry the kernel's signals between them: cpu_signal() and
+ *     the order to stop when the system goes back to the boot loader
+ *   - a shared peripheral interrupt (SPI, numbers 32 to 1019) is a driver's once it
+ *     is attached (gic_v3_spi_attach()): configured, routed to the processor that
+ *     attaches it, enabled, and its handler called in interrupt context for each
+ *     one that arrives, before it is ended
+ *   - any other interrupt that fires is masked and counted, until a real
+ *     driver registers a handler for it
+ *
+ * Every processor has its own CPU interface, redistributor frame and timer,
+ * and sets them up for itself (gic_v3_irq_cpu_init(), from PE_init_cpu()).
+ *
+ * Registers come from the device tree node /arm-io/gic:
+ *   reg = <distributor offset, size, redistributor offset, size>
+ */
+#include <mach/mach_types.h>
+#include <kern/debug.h>
+#include <kern/simple_lock.h>
+#include <os/atomic_private.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/cpu_internal.h>
+#include <arm/machine_cpu.h>
+#include <arm/machine_routines.h>
+#include <arm/rtclock.h>
+#include <arm64/psci_smp.h>
+#include <arm64/proc_reg.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm64/board_config.h>
+
+#if defined(GENERIC_GIC_V3_IRQ)
+
+#define GICD_CTLR               0x0000
+#define GICD_CTLR_ENABLE_G1NS   (1u << 1)
+#define GICD_CTLR_ARE_NS        (1u << 4)
+#define GICD_CTLR_RWP           (1u << 31)
+#define GICD_IGROUPR(n)         (0x0080 + 4 * (n))
+#define GICD_ISENABLER(n)       (0x0100 + 4 * (n))
+#define GICD_ICENABLER(n)       (0x0180 + 4 * (n))
+#define GICD_ICPENDR(n)         (0x0280 + 4 * (n))
+#define GICD_ICACTIVER(n)       (0x0380 + 4 * (n))
+#define GICD_IPRIORITYR(n)      (0x0400 + (n))
+#define GICD_ICFGR(n)           (0x0c00 + 4 * (n))
+#define GICD_IGRPMODR(n)        (0x0d00 + 4 * (n))
+#define GICD_IROUTER(n)         (0x6000 + 8 * (n))
+
+#define GICR_FRAME_SIZE         0x20000     /* RD_base + SGI_base per CPU */
+#define GICR_TYPER              0x0008
+#define GICR_TYPER_LAST         (1u << 4)
+#define GICR_TYPER_VLPIS        (1u << 1)   /* GICv4: two more 64 KB frames (VLPI_base, reserved) */
+#define GICR_WAKER              0x0014
+#define GICR_WAKER_PROCSLEEP    (1u << 1)
+#define GICR_WAKER_CHILDASLEEP  (1u << 2)
+#define GICR_SGI_BASE           0x10000
+#define GICR_IGROUPR0           (GICR_SGI_BASE + 0x0080)
+#define GICR_ISENABLER0         (GICR_SGI_BASE + 0x0100)
+#define GICR_ICENABLER0         (GICR_SGI_BASE + 0x0180)
+#define GICR_ICPENDR0           (GICR_SGI_BASE + 0x0280)
+#define GICR_ICACTIVER0         (GICR_SGI_BASE + 0x0380)
+#define GICR_IPRIORITYR(n)      (GICR_SGI_BASE + 0x0400 + (n))
+#define GICR_IGRPMODR0          (GICR_SGI_BASE + 0x0d00)
+
+#define GIC_SGI_SIGNAL          0           /* cpu_signal(): another processor wants this one's attention */
+#define GIC_SGI_STOP            1           /* psci_smp_stop_here(): the system is going back to the boot loader */
+#define GIC_INTID_VTIMER        27          /* EL1 virtual timer PPI */
+#define GIC_INTID_SPI_MIN       32
+#define GIC_INTID_SPURIOUS_MIN  1020
+#define GIC_SPI_MOST            48          /* attached at a time */
+#define GIC_PRIORITY_DEFAULT    0xa0
+
+static vm_offset_t gicd_base, gicr_base;
+static vm_size_t   gicr_size;
+static vm_offset_t gicr_cpu_base[MAX_CPUS]; /* each processor's redistributor frame */
+
+/*
+ * Acknowledged, not yet EOI'd; 0: none. The signal between processors is interrupt 0 and reads
+ * as 0 from ICC_IAR1_EL1, hence the mark: without it a core switched off in the middle of that
+ * signal (which is where every core but one is during a panic) kept it active, and with the
+ * active priority still set in its CPU interface the next kernel on that core saw no interrupt
+ * at all.
+ */
+#define GIC_IAR_TAKEN           (1ULL << 63)
+static uint64_t gic_active_iar[MAX_CPUS];
+uint64_t        gic_unhandled_count;
+uint32_t        gic_last_unhandled;
+
+/*
+ * The attached SPIs. A slot is filled before its interrupt is enabled and emptied after it has
+ * been disabled and no handler of it runs any more (busy), so the handler path reads the table
+ * without a lock.
+ */
+struct gic_spi {
+	uint32_t intid;                     /* 0: a free slot */
+	void   (*handler)(void *context, uint32_t intid);
+	void    *context;
+	uint32_t busy;                      /* handlers of it running now */
+	uint64_t count;
+};
+static struct gic_spi gic_spi[GIC_SPI_MOST];
+static decl_simple_lock_data(, gic_spi_lock);
+
+void gic_v3_irq_cpu_init(void);
+void gic_v3_irq_quiesce(void);
+kern_return_t gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint32_t intid), void *context);
+void gic_v3_spi_mask(uint32_t intid);
+void gic_v3_spi_unmask(uint32_t intid);
+void gic_v3_spi_detach(uint32_t intid);
+uint64_t gic_v3_spi_count(uint32_t intid);
+void gic_v3_irq_cpu_shutdown(void);
+void gic_v3_irq_signal(uint32_t phys_id);
+void gic_v3_irq_signal_stop(uint32_t phys_id);
+
+/*
+ * kit1 (25 Nov): every GIC register access is ONE plain ldr/str with the address in a register, never a form the
+ * compiler may pick for a volatile dereference (a pre- or post-indexed load or store, a pair). Under Gunyah the GICD
+ * and GICR frames are emulated: an indexed access traps without a valid instruction syndrome (ESR ISV = 0), so the
+ * hypervisor cannot emulate it and injects a synchronous external abort. Sheng met exactly that on a sleep's first GICD
+ * read (ESR 0x96000010 at GICD_ISENABLER1); ArmCpu a2c5dd3 (zus12873, "fix(gic): emulatable single-register MMIO
+ * accesses", in UniXNU ArmCpu #7, ArmCpu.cpp:166-200) made read8/16/32/64 and write* one instruction each. Written
+ * here the same way (inline asm, "memory" clobber so the compiler keeps the order).
+ */
+static inline uint32_t
+gic_read32(vm_offset_t addr)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (addr) : "memory");
+	return value;
+}
+
+static inline void
+gic_write32(vm_offset_t addr, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (addr) : "memory");
+}
+
+static inline uint64_t
+gic_read64(vm_offset_t addr)
+{
+	uint64_t value;
+
+	__asm__ volatile ("ldr %0, [%1]" : "=r" (value) : "r" (addr) : "memory");
+	return value;
+}
+
+static inline void
+gic_write64(vm_offset_t addr, uint64_t value)
+{
+	__asm__ volatile ("str %0, [%1]" : : "r" (value), "r" (addr) : "memory");
+}
+
+static inline void
+gic_write8(vm_offset_t addr, uint8_t value)
+{
+	__asm__ volatile ("strb %w0, [%1]" : : "r" ((uint32_t)value), "r" (addr) : "memory");
+}
+
+static void
+gic_mask(uint32_t intid)
+{
+	if (intid < 32) {
+		gic_write32(gicr_cpu_base[cpu_number()] + GICR_ICENABLER0, 1u << intid);
+	} else {
+		gic_write32(gicd_base + GICD_ICENABLER(intid / 32), 1u << (intid % 32));
+	}
+}
+
+/*
+ * A software-generated interrupt for the processor with that MPIDR (its two
+ * low affinity fields, as in the device tree's "reg").
+ * ICC_SGI1R_EL1: Aff1 in [23:16], the interrupt in [27:24], and in [15:0] a
+ * bit for every Aff0 addressed -- which is why Aff0 has to be below 16.
+ */
+static void
+gic_send_sgi(uint32_t phys_id, uint32_t sgi)
+{
+	uint64_t aff0 = phys_id & 0xff, aff1 = (phys_id >> 8) & 0xff, aff2 = (phys_id >> 16) & 0xff;
+
+	/*
+	 * S7 item C: the stores this SGI announces (the SIGP word cpu_signal sets, run queues) must be visible to the
+	 * target before the interrupt can be, and a system-register write is not ordered after them by itself: a DSB
+	 * ISHST first, as the owner's mainline Linux GICv3 driver does before it writes ICC_SGI1R_EL1 (facts only).
+	 */
+	__builtin_arm_dsb(DSB_ISHST);
+	/* (Aff2 in [39:32]: dada's prime cores are a cluster of their own, 0x10000 and 0x10100) */
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", ((uint64_t)sgi << 24) | (aff2 << 32) | (aff1 << 16) | (1ULL << (aff0 & 15)));
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* The platform's half of cpu_signal(): interrupt that processor (GenericARMCPU::signalCPU()). */
+void
+gic_v3_irq_signal(uint32_t phys_id)
+{
+	gic_send_sgi(phys_id, GIC_SGI_SIGNAL);
+}
+
+void
+gic_v3_irq_signal_stop(uint32_t phys_id)
+{
+	gic_send_sgi(phys_id, GIC_SGI_STOP);
+}
+
+/* An SPI that a driver has attached: its handler called. false: nobody has it. */
+static bool
+gic_spi_handle(uint32_t intid)
+{
+	for (unsigned i = 0; i < GIC_SPI_MOST; i++) {
+		struct gic_spi *spi = &gic_spi[i];
+
+		if (os_atomic_load(&spi->intid, acquire) == intid) {
+			os_atomic_inc(&spi->busy, acquire);
+			if (os_atomic_load(&spi->intid, relaxed) == intid) {
+				spi->count++;
+				spi->handler(spi->context, intid);
+			}
+			os_atomic_dec(&spi->busy, release);
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+gic_distributor_settle(void)
+{
+	while (gic_read32(gicd_base + GICD_CTLR) & GICD_CTLR_RWP) {
+		/* wait for the change to take effect */
+	}
+}
+
+void
+gic_v3_spi_mask(uint32_t intid)
+{
+	if (gicd_base != 0 && intid >= GIC_INTID_SPI_MIN && intid < GIC_INTID_SPURIOUS_MIN) {
+		gic_write32(gicd_base + GICD_ICENABLER(intid / 32), 1u << (intid % 32));
+		gic_distributor_settle();
+	}
+}
+
+void
+gic_v3_spi_unmask(uint32_t intid)
+{
+	if (gicd_base != 0 && intid >= GIC_INTID_SPI_MIN && intid < GIC_INTID_SPURIOUS_MIN) {
+		gic_write32(gicd_base + GICD_ISENABLER(intid / 32), 1u << (intid % 32));
+	}
+}
+
+/*
+ * A driver takes an SPI: edge- or level-triggered, Group 1, the default priority, routed to the
+ * processor this runs on, and enabled. The handler runs in interrupt context, with interrupts off,
+ * before the interrupt is ended; for a level-triggered one it has to quiet the source or mask the
+ * interrupt (gic_v3_spi_mask()). Thread context.
+ */
+kern_return_t
+gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint32_t intid), void *context)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	struct gic_spi *slot = NULL;
+	uint32_t config;
+
+	if (gicd_base == 0 || intid < GIC_INTID_SPI_MIN || intid >= GIC_INTID_SPURIOUS_MIN || handler == NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	simple_lock(&gic_spi_lock, LCK_GRP_NULL);
+	for (unsigned i = 0; i < GIC_SPI_MOST; i++) {
+		if (gic_spi[i].intid == intid) {
+			simple_unlock(&gic_spi_lock);
+			return KERN_NAME_EXISTS;
+		}
+		if (slot == NULL && gic_spi[i].intid == 0 && gic_spi[i].busy == 0) {
+			slot = &gic_spi[i];
+		}
+	}
+	if (slot == NULL) {
+		simple_unlock(&gic_spi_lock);
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	slot->handler = handler;
+	slot->context = context;
+	slot->count = 0;
+	os_atomic_store(&slot->intid, intid, release);
+	simple_unlock(&gic_spi_lock);
+
+	gic_v3_spi_mask(intid);
+	gic_write32(gicd_base + GICD_ICPENDR(intid / 32), 1u << (intid % 32));
+	gic_write32(gicd_base + GICD_ICACTIVER(intid / 32), 1u << (intid % 32));
+	gic_write32(gicd_base + GICD_IGROUPR(intid / 32), gic_read32(gicd_base + GICD_IGROUPR(intid / 32)) | 1u << (intid % 32));
+	gic_write32(gicd_base + GICD_IGRPMODR(intid / 32), gic_read32(gicd_base + GICD_IGRPMODR(intid / 32)) & ~(1u << (intid % 32)));
+	gic_write8(gicd_base + GICD_IPRIORITYR(intid), GIC_PRIORITY_DEFAULT);
+	config = gic_read32(gicd_base + GICD_ICFGR(intid / 16)) & ~(3u << (intid % 16 * 2));
+	gic_write32(gicd_base + GICD_ICFGR(intid / 16), config | (edge ? 2u : 0u) << (intid % 16 * 2));
+	/* GICD_IROUTER: Aff3 in [39:32], Aff2.Aff1.Aff0 in [23:0]; bit 31 (any processor) clear */
+	gic_write64(gicd_base + GICD_IROUTER(intid), (mpidr & 0xff00000000ull) | (mpidr & 0xffffff));
+	gic_distributor_settle();
+	gic_v3_spi_unmask(intid);
+	return KERN_SUCCESS;
+}
+
+/* ... and gives it back: disabled, nothing pending, and no handler of it running when this returns. */
+void
+gic_v3_spi_detach(uint32_t intid)
+{
+	gic_v3_spi_mask(intid);
+	if (gicd_base != 0 && intid >= GIC_INTID_SPI_MIN && intid < GIC_INTID_SPURIOUS_MIN) {
+		gic_write32(gicd_base + GICD_ICPENDR(intid / 32), 1u << (intid % 32));
+	}
+	for (unsigned i = 0; i < GIC_SPI_MOST; i++) {
+		if (gic_spi[i].intid == intid) {
+			os_atomic_store(&gic_spi[i].intid, 0, release);
+			while (os_atomic_load(&gic_spi[i].busy, acquire) != 0) {
+				/* a handler of it on another processor is finishing */
+			}
+		}
+	}
+}
+
+/* How many have arrived since it was attached. */
+uint64_t
+gic_v3_spi_count(uint32_t intid)
+{
+	for (unsigned i = 0; i < GIC_SPI_MOST; i++) {
+		if (gic_spi[i].intid == intid) {
+			return gic_spi[i].count;
+		}
+	}
+	return 0;
+}
+
+static void
+gic_irq_handler(__unused void *target, __unused void *refCon, __unused void *nub, __unused int source)
+{
+	int cpu = cpu_number();
+
+	for (;;) {
+		uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+		uint32_t intid = (uint32_t)(iar & 0xffffff);
+
+		if (intid >= GIC_INTID_SPURIOUS_MIN) {
+			break;
+		}
+		gic_active_iar[cpu] = iar | GIC_IAR_TAKEN;
+
+		if (intid == GIC_INTID_VTIMER) {
+			/* same sequence as the FIQ path in sleh_fiq() */
+			getCpuDatap()->cpu_decrementer = -1; /* Large */
+			rtclock_intr(TRUE);
+		} else if (intid == GIC_SGI_SIGNAL) {
+			cpu_signal_handler();
+		} else if (intid == GIC_SGI_STOP) {
+			/* comes back only if nobody has in fact asked for that */
+			psci_smp_stop_here();
+		} else if (intid >= GIC_INTID_SPI_MIN && gic_spi_handle(intid)) {
+			/* a driver's */
+		} else {
+			/* nobody owns this interrupt yet: keep it from storming */
+			gic_mask(intid);
+			gic_unhandled_count++;
+			gic_last_unhandled = intid;
+		}
+
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		__builtin_arm_isb(ISB_SY);
+		gic_active_iar[cpu] = 0;
+	}
+}
+
+/*
+ * Leave the controller in a state another environment can take over from:
+ * finish any interrupt that this processor acknowledged but did not complete.
+ * Used when control goes back to the boot loader (see loader_return.c), and
+ * by a processor that is about to be switched off for that (psci_smp.c).
+ */
+void
+gic_v3_irq_quiesce(void)
+{
+	int cpu;
+
+	if (gicd_base == 0) {
+		return;         /* as early as this there is no interrupt, nor a cpu number to ask for */
+	}
+	cpu = cpu_number();
+	/* (what drivers had of the shared interrupts goes with this kernel: none of them may fire under the loader) */
+	for (unsigned i = 0; i < GIC_SPI_MOST; i++) {
+		uint32_t intid = gic_spi[i].intid;
+
+		if (intid != 0) {
+			gic_write32(gicd_base + GICD_ICENABLER(intid / 32), 1u << (intid % 32));
+		}
+	}
+	if (gic_active_iar[cpu] != 0) {
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", gic_active_iar[cpu] & ~GIC_IAR_TAKEN);
+		__builtin_arm_isb(ISB_SY);
+		gic_active_iar[cpu] = 0;
+	}
+}
+
+/*
+ * This processor is leaving for good: the firmware is about to be asked to switch it off
+ * (psci_smp_cpu_off(), and the boot processor in the loader's stub when the kernel has a core of
+ * its own). Nothing may be left that could interrupt it. The redistributor outlives the core, and
+ * so does what is pending in it: the "stop" signal that reached a core whose interrupts were off
+ * (every core is in that state while another one panics), or its timer. A core asked to go with
+ * an interrupt pending and the CPU interface still passing it on does not go cleanly, and the
+ * next kernel that is started on it hangs.
+ */
+void
+gic_v3_irq_cpu_shutdown(void)
+{
+	vm_offset_t gicr;
+
+	if (gicd_base == 0) {
+		return;
+	}
+	gic_v3_irq_quiesce();
+	gicr = gicr_cpu_base[cpu_number()];
+	if (gicr != 0) {
+		gic_write32(gicr + GICR_ICENABLER0, 0xffffffffu);
+		gic_write32(gicr + GICR_ICPENDR0, 0xffffffffu);
+		gic_write32(gicr + GICR_ICACTIVER0, 0xffffffffu);
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 0);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* the distance between redistributors when the device tree gives one (redistributor-stride), else 0 */
+static uint64_t gicr_stride;
+
+static vm_offset_t
+gic_find_redistributor(void)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	/* GICR_TYPER[63:32] packs Aff3.Aff2.Aff1.Aff0 */
+	uint32_t affinity = (uint32_t)(((mpidr >> 32) & 0xff) << 24 | (mpidr & 0xffffff));
+
+	for (vm_offset_t frame = gicr_base; frame + GICR_FRAME_SIZE <= gicr_base + gicr_size;) {
+		uint64_t typer = gic_read64(frame + GICR_TYPER);
+
+		if ((uint32_t)(typer >> 32) == affinity) {
+			return frame;
+		}
+		if (typer & GICR_TYPER_LAST) {
+			break;
+		}
+		frame += gicr_stride ? gicr_stride : (typer & GICR_TYPER_VLPIS) ? 2 * GICR_FRAME_SIZE : GICR_FRAME_SIZE;
+	}
+	panic("gic: no redistributor for MPIDR 0x%llx", mpidr);
+}
+
+/* Per-CPU bring-up: every processor calls this for itself, the boot processor first. */
+void
+gic_v3_irq_cpu_init(void)
+{
+	int cpu = cpu_number();
+	vm_offset_t gicr;
+	uint32_t mine = 1u << GIC_INTID_VTIMER;
+
+	if (gicd_base == 0) {
+		DTEntry entry;
+		void const *prop;
+		unsigned int prop_size;
+
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess ||
+		    SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess ||
+		    prop_size < 4 * sizeof(uint64_t)) {
+			panic("gic: no usable /arm-io/gic node in the device tree");
+		}
+		uint64_t const *reg = prop;
+		vm_offset_t soc_base = pe_arm_get_soc_base_phys();
+
+		simple_lock_init(&gic_spi_lock, 0);
+		gicd_base = ml_io_map(soc_base + reg[0], reg[1]);
+		gicr_base = ml_io_map(soc_base + reg[2], reg[3]);
+		gicr_size = reg[3];
+		if (SecureDTGetProperty(entry, "redistributor-stride", &prop, &prop_size) == kSuccess &&
+		    prop_size >= sizeof(uint64_t)) {
+			gicr_stride = *(uint64_t const *)prop;
+		}
+		if (gicd_base == 0 || gicr_base == 0) {
+			panic("gic: cannot map the distributor/redistributor");
+		}
+	} else if (gicr_cpu_base[cpu] != 0) {
+		return;
+	}
+
+	/* System-register CPU interface */
+	__builtin_arm_wsr64("ICC_SRE_EL1", __builtin_arm_rsr64("ICC_SRE_EL1") | 1);
+	__builtin_arm_isb(ISB_SY);
+
+	gicr = gicr_cpu_base[cpu] = gic_find_redistributor();
+
+	uint32_t waker = gic_read32(gicr + GICR_WAKER);
+	if (waker & (GICR_WAKER_PROCSLEEP | GICR_WAKER_CHILDASLEEP)) {
+		gic_write32(gicr + GICR_WAKER, waker & ~GICR_WAKER_PROCSLEEP);
+		while (gic_read32(gicr + GICR_WAKER) & GICR_WAKER_CHILDASLEEP) {
+			/* spin until the redistributor is awake */
+		}
+	}
+
+	/*
+	 * The interrupts between processors, where there is more than one. A core that an earlier
+	 * kernel switched off in the middle of one (a return to the boot loader, started again
+	 * since) may still have it marked active, and would then never see another.
+	 */
+	if (ml_get_cpu_count() > 1) {
+		uint32_t sgis = (1u << GIC_SGI_SIGNAL) | (1u << GIC_SGI_STOP);
+
+		gic_write32(gicr + GICR_ICACTIVER0, sgis);
+		gic_write32(gicr + GICR_ICPENDR0, sgis);        /* ... or one that it never took */
+		gic_write8(gicr + GICR_IPRIORITYR(GIC_SGI_SIGNAL), GIC_PRIORITY_DEFAULT);
+		gic_write8(gicr + GICR_IPRIORITYR(GIC_SGI_STOP), GIC_PRIORITY_DEFAULT);
+		mine |= sgis;
+	}
+
+	/* Virtual timer PPI (and those): Group 1 (IRQ), default priority, enabled */
+	gic_write32(gicr + GICR_IGROUPR0, gic_read32(gicr + GICR_IGROUPR0) | mine);
+	gic_write32(gicr + GICR_IGRPMODR0, gic_read32(gicr + GICR_IGRPMODR0) & ~mine);
+	gic_write8(gicr + GICR_IPRIORITYR(GIC_INTID_VTIMER), GIC_PRIORITY_DEFAULT);
+	gic_write32(gicr + GICR_ISENABLER0, mine);
+
+	/* Distributor: affinity routing, Group 1 enabled (normally already so) */
+	uint32_t ctlr = gic_read32(gicd_base + GICD_CTLR);
+	if ((ctlr & (GICD_CTLR_ENABLE_G1NS | GICD_CTLR_ARE_NS)) != (GICD_CTLR_ENABLE_G1NS | GICD_CTLR_ARE_NS)) {
+		gic_write32(gicd_base + GICD_CTLR, ctlr | GICD_CTLR_ENABLE_G1NS | GICD_CTLR_ARE_NS);
+		while (gic_read32(gicd_base + GICD_CTLR) & GICD_CTLR_RWP) {
+			/* wait for the write to take effect */
+		}
+	}
+
+	/*
+	 * CPU interface: accept all priorities, no preemption grouping, Group 1 on. And no priority
+	 * active: a core that the firmware switches off and on again need not lose that, and a
+	 * kernel that left in the middle of an interrupt without ending it would leave this one
+	 * waiting for an end that never comes.
+	 */
+	__builtin_arm_wsr64("ICC_AP1R0_EL1", 0);
+	__builtin_arm_wsr64("ICC_PMR_EL1", 0xff);
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+
+	ml_install_interrupt_handler(NULL, 0, NULL, gic_irq_handler, NULL);
+	kprintf("gic: v3, distributor %p, cpu %d's redistributor %p, virtual timer on PPI %d\n",
+	    (void *)gicd_base, cpu, (void *)gicr, GIC_INTID_VTIMER);
+}
+
+#endif /* GENERIC_GIC_V3_IRQ */
diff --git a/osfmk/arm64/hakios_cpu_idle.c b/osfmk/arm64/hakios_cpu_idle.c
new file mode 100644
index 0000000000000000000000000000000000000000..543a08ad5535fd4191f1408d02f1d09462368b04
--- /dev/null
+++ b/osfmk/arm64/hakios_cpu_idle.c
@@ -0,0 +1,217 @@
+/*
+ * For the dada CPU governor (bsd/dev/hakios_dada_cpu.c), which cannot see a processor from BSD: how long each CPU
+ * has been idle, from the scheduler's own bookkeeping (recount: every idle entry and exit is stamped), and which
+ * cluster a CPU is in (MPIDR Aff2: dada's two prime cores are cluster 1, the rest cluster 0).
+ */
+#include <kern/processor.h>
+#include <kern/recount.h>
+#include <machine/machine_routines.h>
+
+uint64_t hakios_cpu_idle_mach(int cpu);
+uint64_t
+hakios_cpu_idle_mach(int cpu)
+{
+	processor_t p;
+	struct recount_usage usage;
+	uint64_t idle = 0;
+
+	/* a CPU that was never started (cpus=N below the SoC's count): cpu_to_processor asserts (data-a-live 0312) */
+	if (cpu < 0 || cpu > ml_get_max_cpu_number()) {
+		return 0;
+	}
+	p = cpu_to_processor(cpu);
+	if (p == PROCESSOR_NULL) {
+		return 0;
+	}
+	recount_processor_usage(&p->pr_recount, &usage, &idle);
+	return idle;
+}
+
+int hakios_cpu_cluster(int cpu);
+int
+hakios_cpu_cluster(int cpu)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+
+	if (topology == NULL || cpu < 0 || (unsigned)cpu >= topology->num_cpus) {
+		return -1;
+	}
+	return (int)((topology->cpus[cpu].phys_id >> 16) & 0xff);
+}
+
+/*
+ * iceland (harvest kit 19, boot-arg iceidle, bsd/dev/hakios_iceland_harvest.c): the cores' idle state. The Pad's DT
+ * (kaanapali-oneplus-iceland, idle-states, entry-method "psci") gives every core one state, "retention":
+ * arm,psci-suspend-param 0x4 (the firmware uses PSCI's extended state-ID format -- PSCI_FEATURES(CPU_SUSPEND) = 0x3, bit 1
+ * set; tablet runs w5-thermal-r3-ceil and p4-1 -- where bit 30 is the state type: clear in 0x4, so still a retention
+ * (standby) state, the core keeps its context), no
+ * local-timer-stop, min-residency 560 us (cpu 0-5) / 686 us (cpu 6-7, MPIDR Aff2 1). cpu_idle (osfmk/arm64/cpu.c)
+ * calls hakios_iceland_idle_wfi in place of WFI: CPU_SUSPEND(0x4) when the CPU's next timer pop is at least that far
+ * off, WFI otherwise; an interrupt ends either. Until hakios_iceland_idle_start (iceidle=2) every idle is WFI, as
+ * before. The cluster / system states (0x1000054, 0x200c354) need OS-initiated mode: not used. After
+ * ShueiTsuki/data-a-live wsl/pandora_cpu_idle.c (patch 0215, the same SoC and the same DT values).
+ */
+#include <kern/clock.h>
+#include <kern/misc_protos.h>
+
+#define ICEIDLE_CPUS      8
+#define ICEIDLE_STATE_RET 0x4u
+
+static uint64_t iceidle_res[2];
+static int iceidle_mode;               /* 0 = WFI, 1 = core retention */
+static int32_t iceidle_error;
+static uint64_t iceidle_ret[ICEIDLE_CPUS], iceidle_ret_time[ICEIDLE_CPUS], iceidle_wfi[ICEIDLE_CPUS], iceidle_fail[ICEIDLE_CPUS];
+
+static int32_t
+iceidle_smc(uint64_t fn, uint64_t arg)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = arg;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+                 "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+/* iceidle=1: what the firmware's PSCI offers (Linux psci_probe's questions); nothing is changed */
+void hakios_iceland_idle_probe(void);
+void
+hakios_iceland_idle_probe(void)
+{
+	const uint32_t version = (uint32_t)iceidle_smc(0x84000000u, 0);              /* PSCI_VERSION */
+	const int32_t suspend = iceidle_smc(0x8400000au, 0xc4000001u);              /* PSCI_FEATURES(CPU_SUSPEND) */
+	const int32_t set_mode = iceidle_smc(0x8400000au, 0x8400000fu);             /* PSCI_FEATURES(SET_SUSPEND_MODE) */
+	const int32_t residency = iceidle_smc(0x8400000au, 0xc4000010u);            /* PSCI_FEATURES(STAT_RESIDENCY) */
+
+	printf("iceidle: PSCI %u.%u; CPU_SUSPEND features %#x (OS-initiated mode %s, extended state ids %s); "
+	    "SET_SUSPEND_MODE %d, STAT_RESIDENCY %d\n", version >> 16, version & 0xffff, (uint32_t)suspend,
+	    /* PSCI DEN0022, PSCI_FEATURES(CPU_SUSPEND): bit 0 = OS-initiated mode, bit 1 = the extended state-ID format */
+	    suspend >= 0 && (suspend & 1) ? "yes" : "no", suspend >= 0 && (suspend & 2) ? "yes" : "no", set_mode, residency);
+	/*
+	 * w3-power: what a system sleep could use, asked the same way (PSCI_FEATURES only: nothing is entered or changed).
+	 * 0 or a positive value = implemented, -1 = NOT_SUPPORTED. SYSTEM_SUSPEND (64-bit id), CPU_OFF, CPU_ON (64), SYSTEM_OFF,
+	 * SYSTEM_RESET2 (64), STAT_COUNT (64), CPU_FREEZE, CPU_DEFAULT_SUSPEND (64).
+	 */
+	printf("iceidle: PSCI_FEATURES: SYSTEM_SUSPEND %d, CPU_OFF %d, CPU_ON %d, SYSTEM_OFF %d, SYSTEM_RESET2 %d, STAT_COUNT %d, "
+	    "CPU_FREEZE %d, CPU_DEFAULT_SUSPEND %d\n", iceidle_smc(0x8400000au, 0xc400000eu), iceidle_smc(0x8400000au, 0x84000002u),
+	    iceidle_smc(0x8400000au, 0xc4000003u), iceidle_smc(0x8400000au, 0x84000008u), iceidle_smc(0x8400000au, 0xc4000012u),
+	    iceidle_smc(0x8400000au, 0xc4000011u), iceidle_smc(0x8400000au, 0x8400000bu), iceidle_smc(0x8400000au, 0xc400000cu));
+}
+
+/* iceidle=2 */
+void hakios_iceland_idle_start(void);
+void
+hakios_iceland_idle_start(void)
+{
+	nanoseconds_to_absolutetime(560 * 1000ull, &iceidle_res[0]);
+	nanoseconds_to_absolutetime(686 * 1000ull, &iceidle_res[1]);
+	__atomic_store_n(&iceidle_mode, 1, __ATOMIC_RELEASE);
+	printf("iceidle: core retention on (PSCI CPU_SUSPEND 0x%x when the next timer is >= 560 us / 686 us away)\n",
+	    ICEIDLE_STATE_RET);
+}
+
+/* in place of WFI, interrupts masked; POP = the CPU's next timer pop (mach time) */
+void hakios_iceland_idle_wfi(unsigned cpu, uint64_t pop);
+void
+hakios_iceland_idle_wfi(unsigned cpu, uint64_t pop)
+{
+	if (cpu < ICEIDLE_CPUS && __atomic_load_n(&iceidle_mode, __ATOMIC_ACQUIRE) == 1) {
+		const uint64_t now = mach_absolute_time();
+		const unsigned big = ((__builtin_arm_rsr64("MPIDR_EL1") >> 16) & 0xff) != 0;
+
+		if (pop > now && pop - now >= iceidle_res[big]) {
+			const int32_t r = iceidle_smc(0xc4000001u, ICEIDLE_STATE_RET);   /* CPU_SUSPEND, entry point 0 */
+
+			if (r == 0) {
+				iceidle_ret[cpu]++;
+				iceidle_ret_time[cpu] += mach_absolute_time() - now;
+				return;
+			}
+			iceidle_error = r;
+			if (++iceidle_fail[cpu] >= 8) {
+				__atomic_store_n(&iceidle_mode, 0, __ATOMIC_RELAXED);   /* refused: WFI from now on */
+			}
+		}
+	}
+	if (cpu < ICEIDLE_CPUS) {
+		iceidle_wfi[cpu]++;
+	}
+	__builtin_arm_wfi();
+}
+
+/* since the last call, per CPU: retention entries x average length / WFIs; refusals */
+void hakios_iceland_idle_log(void);
+void
+hakios_iceland_idle_log(void)
+{
+	static uint64_t shown_ret[ICEIDLE_CPUS], shown_time[ICEIDLE_CPUS], shown_wfi[ICEIDLE_CPUS];
+	char line[400];
+	int at = 0;
+
+	for (unsigned c = 0; c < ICEIDLE_CPUS && at < (int)sizeof(line); c++) {
+		const uint64_t ret = iceidle_ret[c] - shown_ret[c], wfi = iceidle_wfi[c] - shown_wfi[c];
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(iceidle_ret_time[c] - shown_time[c], &ns);
+		shown_ret[c] += ret;
+		shown_wfi[c] += wfi;
+		shown_time[c] = iceidle_ret_time[c];
+		at += snprintf(line + at, sizeof(line) - at, " %u: %llu x %llu us / %llu", c, ret, ret ? ns / 1000 / ret : 0, wfi);
+	}
+	printf("iceidle: %s; retention x avg / wfi:%s; refusals %llu %llu %llu %llu %llu %llu %llu %llu, last error %d\n",
+	    iceidle_mode ? "on" : "OFF (refused)", line, iceidle_fail[0], iceidle_fail[1], iceidle_fail[2], iceidle_fail[3],
+	    iceidle_fail[4], iceidle_fail[5], iceidle_fail[6], iceidle_fail[7], iceidle_error);
+}
+
+#if defined(XNU_TARGET_OS_OSX)
+/*
+ * hw1: iceidle on the macOS target. The parse and the start are in the harvest file's thread, which is built for the
+ * iOS target only (bsd/dev/hakios_iceland_harvest.c, its block from line 42), so on macOS the boot-arg did nothing.
+ * Here: iceidle=1 asks PSCI its questions at 20 s; iceidle=2 also turns core retention on then and says the counts
+ * every 30 s. The calls here are SMCs, the Pad's conduit. Where the firmware's PSCI is over HVC (psci_smp_hvc,
+ * osfmk/arm64/psci_smp.c: QEMU's virt machine) an SMC is an undefined instruction, so nothing is called there and WFI
+ * stays (the smoke run 20261115-003757-hw1-97e7734-smoke-cpus8 panicked at the probe: a RAM test did not tell QEMU).
+ */
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern uint32_t psci_smp_hvc;       /* osfmk/arm64/psci_smp.c: 1 = the firmware's PSCI is called over HVC */
+
+static void
+iceidle_thread(void *parameter, __unused wait_result_t result)
+{
+	const int mode = (int)(intptr_t)parameter;
+
+	delay_for_interval(20 * 1000, NSEC_PER_MSEC);
+	if (psci_smp_hvc) {
+		printf("iceidle: PSCI is over hvc here: not the Pad, no call, WFI stays\n");
+		return;
+	}
+	hakios_iceland_idle_probe();
+	if (mode < 2) {
+		return;
+	}
+	hakios_iceland_idle_start();
+	for (;;) {
+		delay_for_interval(30 * 1000, NSEC_PER_MSEC);
+		hakios_iceland_idle_log();
+	}
+}
+
+void hakios_iceland_idle_init(void);
+void
+hakios_iceland_idle_init(void)
+{
+	int mode = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("iceidle", &mode, sizeof(mode)) || mode <= 0) {
+		return;
+	}
+	printf("iceidle: iceidle=%d (macOS): starts at 20 s\n", mode);
+	if (kernel_thread_start(iceidle_thread, (void *)(intptr_t)mode, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/osfmk/arm64/hakios_memtel.c b/osfmk/arm64/hakios_memtel.c
new file mode 100644
index 0000000000000000000000000000000000000000..c6dc18a61c0ac19fadc0532024bd6c41d038fcc1
--- /dev/null
+++ b/osfmk/arm64/hakios_memtel.c
@@ -0,0 +1,617 @@
+/*
+ * iceland macOS port, gains1 (21 Nov): the memory telemetry for the login-burst spike (STATE 0z132: wired 1.2 GB ->
+ * 6.0 GB for about a minute after the login, the compressor left holding 1.7 GB, kernel_task 4.26 GB -- the owner of
+ * the wired pages unknown, kernel side).
+ *
+ *   icemem=<s>      every s seconds (built in as icemem=5 for the gains kit; icemem=0 on a line turns it off), from
+ *                   redwood_input_init until icemem_for seconds after boot
+ *   icemem_for=<s>  how long, in seconds since boot (default 900: the whole of a kit's 840-s window, the login and
+ *                   the autofix restart's double session start included)
+ *
+ * Each round prints three lines, prefixed "icemem:":
+ *   t=<s> pages: wired, free, active, inactive, speculative (MB); the compressor (MB resident, MB of data, pages in);
+ *         zones (wired MB, allocated MB); kalloc large (MB); IOKit (IOMalloc incl. aligned + contiguous MB, pageable
+ *         MB, containers MB, OSObject MB: Apple's IOALLOCDEBUG counters, iokit/Kernel/IOKitDebug.cpp); the GPU driver
+ *         (spaces, page-table KB, mapped MB = the valid 4 KB entries of every client's window; the icegpu device's
+ *         kernel KB / wired-import KB: bsd/dev/hakios_iceland_gpu.c hakios_iceland_gpu_mem_row)
+ *   t=<s> zones: the five largest zones by wired MB
+ *   t=<s> wired by: the five largest wired allocation sites (a VM tag, a kext's bundle id, a named site or a kernel
+ *         site), MB -- the line that names the spike's owner
+ * and at the end one line with the peak wired and when it was seen.
+ *
+ * No state outside the thread: the record is on its stack (osfmk/arm64/hakios_memtel.h; filled by vm_resident.c's
+ * iceland_memsnap_take), so __DATA does not grow by a byte. Reads only; the GPU row holds the GPU's submit lock for
+ * the length of its table walk (the valid-entry count of the windows in use).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/misc_protos.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <arm64/hakios_memtel.h>
+
+/* iokit/Kernel/IOKitDebug.cpp (IOALLOCDEBUG=1 in every iokit build: iokit/conf/Makefile.template) */
+extern size_t debug_malloc_size, debug_iomalloc_size, debug_container_malloc_size;
+extern vm_size_t debug_iomallocpageable_size;
+/* bsd/dev/hakios_iceland_gpu.c */
+extern void hakios_iceland_gpu_mem_row(uint32_t *spaces_used, uint64_t *table_bytes, uint64_t *mapped_pages,
+    uint64_t *dev_kernel, uint64_t *dev_wired);
+/* iokit/Kernel/AGXAccelerator.cpp (gains1 P6): one line of the GPU clients' buffers by process */
+extern void agx_mem_row(uint64_t t);
+
+void hakios_memtel_init(void);
+
+#define MB(bytes)       ((unsigned)((bytes) >> 20))
+#define PMB(pages)      ((unsigned)(((uint64_t)(pages) * PAGE_SIZE) >> 20))
+
+static uint64_t
+memtel_uptime_s(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_SEC;
+}
+
+static void
+memtel_thread(void *arg, wait_result_t wr __unused)
+{
+	const uint32_t every = (uint32_t)(uintptr_t)arg;
+	uint32_t until = 900;
+	uint64_t peak = 0, peak_at = 0, rounds = 0;
+	struct iceland_memsnap m;
+
+	(void)PE_parse_boot_argn("icemem_for", &until, sizeof(until));
+	printf("icemem: every %u s until %u s after boot: pages, compressor, zones, kalloc large, IOKit, the GPU; the five "
+	    "largest zones and wired sites\n", every, until);
+	for (;;) {
+		const uint64_t t = memtel_uptime_s();
+		uint32_t spaces = 0;
+		uint64_t tables = 0, mapped = 0, dev_kernel = 0, dev_wired = 0;
+
+		if (t > until) {
+			break;
+		}
+		iceland_memsnap_take(&m);
+		hakios_iceland_gpu_mem_row(&spaces, &tables, &mapped, &dev_kernel, &dev_wired);
+		rounds++;
+		if (m.wired > peak) {
+			peak = m.wired;
+			peak_at = t;
+		}
+		printf("icemem: t=%llu pages MB: wired %u free %u active %u inactive %u spec %u; compressor %u MB for %u MB "
+		    "(%llu pages in); zones %u MB wired %u alloc; kalloc.large %u; iokit malloc %u pageable %u containers %u "
+		    "osobject %u; gpu %u spaces, tables %u KB, mapped %u MB, dev %u KB + wired %u KB\n", t, PMB(m.wired),
+		    PMB(m.free), PMB(m.active), PMB(m.inactive), PMB(m.speculative), PMB(m.cmp_resident), MB(m.cmp_bytes),
+		    m.cmp_pages_in, MB(m.zones_wired), MB(m.zones_alloc), MB(m.kalloc_large), MB(debug_iomalloc_size),
+		    MB(debug_iomallocpageable_size), MB(debug_container_malloc_size), MB(debug_malloc_size), spaces,
+		    (unsigned)(tables >> 10), MB(mapped * 4096), (unsigned)(dev_kernel >> 10), (unsigned)(dev_wired >> 10));
+		printf("icemem: t=%llu zones MB: %s %u, %s %u, %s %u, %s %u, %s %u\n", t, m.zone_name[0], MB(m.zone_bytes[0]),
+		    m.zone_name[1], MB(m.zone_bytes[1]), m.zone_name[2], MB(m.zone_bytes[2]), m.zone_name[3],
+		    MB(m.zone_bytes[3]), m.zone_name[4], MB(m.zone_bytes[4]));
+		printf("icemem: t=%llu wired by MB: %s %u, %s %u, %s %u, %s %u, %s %u\n", t, m.tag_name[0], MB(m.tag_bytes[0]),
+		    m.tag_name[1], MB(m.tag_bytes[1]), m.tag_name[2], MB(m.tag_bytes[2]), m.tag_name[3], MB(m.tag_bytes[3]),
+		    m.tag_name[4], MB(m.tag_bytes[4]));
+		agx_mem_row(t);         /* gains1 P6: the GPU clients by process (silent without a client) */
+		delay_for_interval(every * 1000, NSEC_PER_MSEC);
+	}
+	printf("icemem: done after %llu rounds: the peak wired %u MB at t=%llu s\n", rounds, PMB(peak), peak_at);
+	thread_terminate_self();
+}
+
+/*
+ * render1 (21 Nov), icerender=<s> (default off; from icerender_from=<s> after boot, default 300; thread rows only for a
+ * process with >= 5 % of a CPU): every s seconds, where the CPU and the GPU clients' kernel time go,
+ * for the owner's "any movement is glitchy" and the RAM/CPU utilisation question (runs/render1/REPORT.md):
+ *   icerender: t=<s> cpu busy %: each CPU's busy share (cpu0-5 = SCMI domain 0, cpu6-7 = domain 1, the 4.6 GHz pair),
+ *              the last SwapEnd and the last finger down (ms ago), the GPU interrupts and fence waits (woken / polled)
+ *   icerender: t=<s> top: the six processes with the most CPU over the window (share of one CPU, user/system)
+ *   icerender: t=<s> <name>[pid] threads over <ms>: the top three processes' four busiest threads each, measured over
+ *              a 1-s sub-window right after the window: name or tid, user/system ms, the CPU it last ran on, priority
+ *   icerender: agx ...: AGXAccelerator.cpp agx_render_rows (submissions, the page-attribute walk, fence waits, buffers)
+ * Reads only; the tasks list lock is held for one pass over the tasks (no thread walk under it), each of the top three
+ * tasks is referenced, then walked under its own lock. Every byte of state is the thread's heap block: __DATA does not
+ * grow. Its own cost is printed in the cpu line ("self").
+ */
+#include <kern/kalloc.h>
+#include <machine/machine_routines.h>
+#include <kern/processor.h>
+#include <kern/task.h>
+#include <kern/recount.h>
+
+extern void agx_render_rows(void);
+extern void hakios_iceland_gpu_waitstat(uint32_t *irqs, uint32_t *masked, uint32_t *woken, uint32_t *polled);
+extern uint64_t hakios_cpu_idle_mach(int cpu);
+extern volatile uint64_t hakios_ui_swap_at, hakios_ui_touch_at;
+struct proc;
+extern void *get_bsdtask_info(task_t);
+extern int proc_pid(struct proc *);
+extern void proc_name_kdp(struct proc *, char *, int);
+
+#define RENDER_PROCS    1024u
+#define RENDER_THREADS  512u
+#define RENDER_TOP      6
+#define RENDER_DEEP     3
+struct render_proc {
+	task_t task;                    /* valid only while tasks_threads_lock is held (the pass), or referenced (deep) */
+	int pid;
+	uint64_t total, user, sys, delta, dsys;
+	char name[20];                  /* proc_name_kdp's copy, taken in the pass */
+};
+struct render_thr {
+	uint64_t tid, user, sys;
+};
+struct render_state {
+	struct render_proc prev[RENDER_PROCS], now[RENDER_PROCS];
+	uint32_t prev_n, now_n;
+	struct render_thr tprev[RENDER_THREADS];      /* the sub-window's first look */
+	uint32_t tprev_n;
+	uint64_t idle_last[8];
+	uint32_t gpu_last[4];
+	char line[400];
+};
+
+static uint64_t
+render_ms(uint64_t abs)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* append to s->line at AT (snprintf's would-be length clamped to the line, so a full line stays full and terminated) */
+static size_t
+render_clamp(const struct render_state *s, size_t at, int n)
+{
+	if (n < 0) {
+		return at;
+	}
+	at += (size_t)n;
+	return at < sizeof(s->line) ? at : sizeof(s->line);
+}
+#define render_add(s, at, ...) render_clamp((s), (at), snprintf((s)->line + (at), sizeof((s)->line) - (at), __VA_ARGS__))
+
+/*
+ * The four busiest threads of one referenced task over a 1-s sub-window (its lock held for each walk): SNAP takes the
+ * first look (each thread's totals into s->tprev), the second call (SNAP false, SPAN the sub-window) compares and prints.
+ */
+static void
+render_threads(struct render_state *s, task_t task, int pid, const char *pname, bool snap, uint64_t span, uint64_t t)
+{
+	struct {
+		uint64_t tid, d, du, ds, ev;
+		int cpu, pri;
+		char name[20];
+	} best[4];
+	thread_t th;
+	uint32_t n = 0;
+	size_t at;
+
+	bzero(best, sizeof(best));
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		const struct recount_times_mach tm = recount_thread_times(th);
+		const uint64_t tid = thread_tid(th);
+		uint64_t pu = 0, ps = 0;
+		bool seen = false;
+
+		if (th->state & TH_IDLE) {
+			continue;               /* a core's idle thread (kernel_task's rows in r1 were all "idle #n") */
+		}
+		n++;
+		if (snap) {
+			/* the first look of the 1-s sub-window: each thread's totals now */
+			if (s->tprev_n < RENDER_THREADS) {
+				s->tprev[s->tprev_n].tid = tid;
+				s->tprev[s->tprev_n].user = tm.rtm_user;
+				s->tprev[s->tprev_n].sys = tm.rtm_system;
+				s->tprev_n++;
+			}
+			continue;
+		}
+		for (uint32_t i = 0; i < s->tprev_n; i++) {
+			if (s->tprev[i].tid == tid) {
+				pu = s->tprev[i].user;
+				ps = s->tprev[i].sys;
+				seen = true;
+				break;
+			}
+		}
+		if (!seen || tm.rtm_user < pu || tm.rtm_system < ps) {
+			continue;               /* born inside the sub-window: not counted */
+		}
+		const uint64_t du = tm.rtm_user - pu, ds = tm.rtm_system - ps, d = du + ds;
+		for (int k = 0; k < 4; k++) {
+			if (d > best[k].d) {
+				memmove(&best[k + 1], &best[k], (size_t)(3 - k) * sizeof(best[0]));
+				best[k].tid = tid;
+				best[k].d = d;
+				best[k].du = du;
+				best[k].ds = ds;
+				best[k].cpu = th->last_processor != PROCESSOR_NULL ? th->last_processor->cpu_id : -1;
+				best[k].pri = th->sched_pri;
+				/*
+				 * r4: what an unnamed thread waits on (kernel_task's tid 261/266 in r2/r3): the wait event, unslid when it is
+				 * a kernel image address (a driver's static: llvm-nm the unstripped kernel), 0 when heap or not waiting
+				 */
+				best[k].ev = (uint64_t)VM_KERNEL_UNSLIDE((vm_offset_t)th->wait_event);
+				{
+					char full[64];  /* MAXTHREADNAMESIZE: bsd_getthreadname copies that much */
+
+					thread_get_thread_name(th, full);
+					full[sizeof(full) - 1] = 0;
+					strlcpy(best[k].name, full, sizeof(best[k].name));
+				}
+				break;
+			}
+		}
+	}
+	task_unlock(task);
+	if (snap) {
+		return;
+	}
+	at = render_add(s, 0, "icerender: t=%llu %s[%d] %u threads over %llu ms:", t, pname, pid, n, render_ms(span));
+	for (int k = 0; k < 4 && best[k].d != 0; k++) {
+		const uint64_t share = span ? best[k].d * 1000 / span : 0;
+
+		if (best[k].name[0] != 0) {
+			at = render_add(s, at, " %s", best[k].name);
+		} else if (best[k].ev != 0) {
+			at = render_add(s, at, " tid %llu ev %#llx", best[k].tid, best[k].ev);
+		} else {
+			at = render_add(s, at, " tid %llu", best[k].tid);
+		}
+		at = render_add(s, at, " %llu.%llu%% (%llu/%llu ms) cpu%d pri %d;", share / 10, share % 10,
+		    render_ms(best[k].du), render_ms(best[k].ds), best[k].cpu, best[k].pri);
+	}
+	printf("%s\n", s->line);
+}
+
+static void
+render_thread(void *arg, wait_result_t wr __unused)
+{
+	const uint32_t every = (uint32_t)(uintptr_t)arg;
+	struct render_state *s = kalloc_data(sizeof(*s), Z_WAITOK | Z_ZERO);
+	const int cpus = (int)ml_get_cpu_count() < 8 ? (int)ml_get_cpu_count() : 8;
+	uint64_t at_abs, self_abs = 0;
+
+	uint32_t from = 300;
+
+	if (s == NULL) {
+		printf("icerender: no memory: off\n");
+		thread_terminate_self();
+	}
+	/*
+	 * From icerender_from seconds after boot (default 300: after the login burst and on the tablet just before the
+	 * autofix restart; earlier from the line). The 1-MB message buffer is what the QEMU bar reads from one snapshot: the
+	 * rows from boot on pushed its 149-s loginwindow line out of it (render1 bar of 435c461, 21 Nov).
+	 */
+	(void)PE_parse_boot_argn("icerender_from", &from, sizeof(from));
+	printf("icerender: every %u s from %u s after boot: CPU busy per core, the top processes and their busiest threads, "
+	    "the GPU clients' submissions, page walks, fence waits and buffers (render1)\n", every, from);
+	while (memtel_uptime_s() < from) {
+		delay_for_interval(1000, NSEC_PER_MSEC);
+	}
+	for (int c = 0; c < cpus; c++) {
+		s->idle_last[c] = hakios_cpu_idle_mach(c);
+	}
+	hakios_iceland_gpu_waitstat(&s->gpu_last[0], &s->gpu_last[1], &s->gpu_last[2], &s->gpu_last[3]);
+	at_abs = mach_absolute_time();
+	for (;;) {
+		struct render_proc deep[RENDER_DEEP];
+		int top[RENDER_TOP];
+		uint32_t g[4];
+		size_t at;
+		task_t task;
+
+		delay_for_interval(every * 1000, NSEC_PER_MSEC);
+		const uint64_t began = mach_absolute_time(), span = began - at_abs, t = memtel_uptime_s();
+		at_abs = began;
+
+		/* 1. each CPU's busy share, the UI's last swap / touch, the GPU's interrupts and waits */
+		at = render_add(s, 0, "icerender: t=%llu cpu busy %%:", t);
+		for (int c = 0; c < cpus; c++) {
+			const uint64_t idle = hakios_cpu_idle_mach(c), di = idle - s->idle_last[c];
+
+			s->idle_last[c] = idle;
+			at = render_add(s, at, " %llu", span > di ? (span - di) * 100 / span : 0);
+		}
+		hakios_iceland_gpu_waitstat(&g[0], &g[1], &g[2], &g[3]);
+		at = render_add(s, at, "; swap %llu ms ago, touch %llu ms ago; gpu irqs %u%s, waits woken %u polled %u; self %llu ms",
+		    began > hakios_ui_swap_at ? render_ms(began - hakios_ui_swap_at) : 0, began > hakios_ui_touch_at ?
+		    render_ms(began - hakios_ui_touch_at) : 0, g[0] - s->gpu_last[0], g[1] ? " (masked)" : "", g[2] - s->gpu_last[2],
+		    g[3] - s->gpu_last[3], render_ms(self_abs));
+		memcpy(s->gpu_last, g, sizeof(g));
+		printf("%s\n", s->line);
+
+		/* 2. one pass over the tasks: each one's CPU time against the last window's */
+		s->now_n = 0;
+		for (int k = 0; k < RENDER_TOP; k++) {
+			top[k] = -1;
+		}
+		bzero(deep, sizeof(deep));
+		lck_mtx_lock(&tasks_threads_lock);
+		queue_iterate(&tasks, task, task_t, tasks) {
+			struct proc *p = get_bsdtask_info(task);
+			struct render_proc *r;
+
+			if (s->now_n >= RENDER_PROCS) {
+				break;
+			}
+			const struct recount_times_mach tm = recount_task_times(task);
+			r = &s->now[s->now_n];
+			r->task = task;
+			r->pid = p != NULL ? proc_pid(p) : -1;
+			strlcpy(r->name, "?", sizeof(r->name));
+			if (p != NULL) {
+				proc_name_kdp(p, r->name, sizeof(r->name));
+			}
+			r->user = tm.rtm_user;
+			r->sys = tm.rtm_system;
+			r->total = tm.rtm_user + tm.rtm_system;
+			r->delta = r->dsys = 0;
+			for (uint32_t i = 0; i < s->prev_n; i++) {
+				if (s->prev[i].pid == r->pid && s->prev[i].total <= r->total) {
+					r->delta = r->total - s->prev[i].total;
+					r->dsys = r->sys >= s->prev[i].sys ? r->sys - s->prev[i].sys : 0;
+					break;
+				}
+			}
+			for (int k = 0; k < RENDER_TOP; k++) {
+				if (top[k] < 0 || r->delta > s->now[top[k]].delta) {
+					memmove(&top[k + 1], &top[k], (size_t)(RENDER_TOP - 1 - k) * sizeof(top[0]));
+					top[k] = (int)s->now_n;
+					break;
+				}
+			}
+			s->now_n++;
+		}
+		for (int k = 0; k < RENDER_DEEP; k++) {
+			/* thread rows only for a process with 5 % of a CPU or more over the window */
+			if (top[k] >= 0 && s->now[top[k]].delta != 0 && s->now[top[k]].delta * 20 >= span) {
+				deep[k] = s->now[top[k]];
+				task_reference(deep[k].task);
+			}
+		}
+		lck_mtx_unlock(&tasks_threads_lock);
+		at = render_add(s, 0, "icerender: t=%llu top over %llu ms (share of one CPU, of it system):", t, render_ms(span));
+		for (int k = 0; k < RENDER_TOP && top[k] >= 0 && s->now[top[k]].delta != 0; k++) {
+			const struct render_proc *r = &s->now[top[k]];
+			const uint64_t share = span ? r->delta * 1000 / span : 0, sys = span ? r->dsys * 1000 / span : 0;
+
+			at = render_add(s, at, " %s[%d] %llu.%llu%% (%llu.%llu);", r->name, r->pid, share / 10, share % 10, sys / 10,
+			    sys % 10);
+		}
+		printf("%s\n", s->line);
+		memcpy(s->prev, s->now, sizeof(s->now[0]) * s->now_n);
+		s->prev_n = s->now_n;
+
+		/* 3. the busiest threads of the top three over a 1-s sub-window (each task referenced: it may end meanwhile) */
+		s->tprev_n = 0;
+		for (int k = 0; k < RENDER_DEEP; k++) {
+			if (deep[k].task != TASK_NULL) {
+				render_threads(s, deep[k].task, deep[k].pid, deep[k].name, true, 0, t);
+			}
+		}
+		uint64_t sub = 0;
+		{
+			const uint64_t sub0 = mach_absolute_time();
+
+			delay_for_interval(1000, NSEC_PER_MSEC);
+			sub = mach_absolute_time() - sub0;
+
+			for (int k = 0; k < RENDER_DEEP; k++) {
+				if (deep[k].task == TASK_NULL) {
+					continue;
+				}
+				render_threads(s, deep[k].task, deep[k].pid, deep[k].name, false, sub, t);
+				task_deallocate(deep[k].task);
+			}
+		}
+
+		/* 4. the GPU clients (AGXAccelerator.cpp) */
+		agx_render_rows();
+		self_abs = mach_absolute_time() - began - sub;  /* (the 1-s sub-window's sleep is not its cost) */
+	}
+}
+
+static void
+render_start(void)
+{
+	uint32_t every = 0;
+	thread_t th;
+
+	if (!PE_parse_boot_argn("icerender", &every, sizeof(every)) || every == 0) {
+		return;
+	}
+	if (every < 2) {
+		every = 2;
+	}
+	if (kernel_thread_start(render_thread, (void *)(uintptr_t)every, &th) != KERN_SUCCESS) {
+		printf("icerender: no thread: off\n");
+		return;
+	}
+	thread_deallocate(th);
+}
+
+/*
+ * render1 (21 Nov), icesched=1|2 (default off): which idle core a woken thread gets. The 8 cores are one processor set
+ * with no performance controller (GenericARMPE: "8 cores, 1 cluster, 1 processor set", Clutch), so
+ * perfcontrol_cpu_preferred_bitmask stays 0 (processor.c pset_init) and choose_processor() falls back to
+ * lsb_first(idle_map) (sched_prim.c, "Fall back to any remaining idle cores"): the LOWEST-numbered idle core. cpu6-7 --
+ * SCMI domain 1, 768-4608 MHz, the fast pair -- get work only once cpu0-5 are all busy: the gains2 consoles' d1 at
+ * 768 MHz and 0 % while d0's busiest core is at 100 %.
+ * The r1 tablet run (render1 efaf0a7, 21 Nov) showed that "preferred" alone does nothing: a woken thread whose last core
+ * is idle gets that core back (choose_processor's hint path, sched_prim.c "Hint is for an idle processor") before the
+ * preferred map is ever read, so the load stayed on cpu0-3 (t=904: 30 35 30 28 7 4 0 0). So now:
+ *   icesched=1  cpu6-7 preferred AND cpu0-5 "to be avoided" (perfcontrol_cpu_migration_bitmask): a thread waking on an
+ *               idle cpu0-5 is moved to an idle cpu6-7 (the hint path's migration test), new placements take cpu6-7
+ *               first, and the realtime chooser reads both masks too (sched_rt.c)
+ *   icesched=2  preferred only (the efaf0a7 behaviour, for an A/B)
+ * The masks are written straight into the processor set under its lock (sched_masks below). r1, r2 and the 7ead31a /
+ * 9ceeaba bars went through the perfcontrol hook sched_perfcontrol_edge_cpu_rotation_bitmasks_set, which on this
+ * kernel (no CONFIG_SCHED_EDGE) is the empty stub of thread_group.c's #else branch (`ret` in thread_group.o): nothing
+ * was ever set, hence 9ceeaba's test B with cpu6/7 idle at every sleep and 0 rounds on them. Only with exactly 8
+ * cores in one set; nothing stored.
+ * icesched_test=1 (QEMU proof, any icesched): right here, synchronously before launchd, two kernel threads run 150
+ * rounds of 1 ms busy + 4 ms asleep with the masks cleared, then with icesched=1's, twice (A, B, A2, B2); the cores each
+ * round ran on, how often cpu6/7 were idle when a worker went to sleep, and the set's cpu / recommended / idle maps
+ * are printed ("icesched: test ..."); then the configured masks are put back. Heap only.
+ */
+/* the two masks choose_processor / the realtime chooser read, written under the set's lock (the hook is a stub here) */
+static void
+sched_masks(processor_set_t ps, uint64_t preferred, uint64_t avoided)
+{
+	spl_t s = splsched();
+
+	pset_lock(ps);
+	ps->perfcontrol_cpu_preferred_bitmask = preferred;
+	ps->perfcontrol_cpu_migration_bitmask = avoided;
+	pset_unlock(ps);
+	splx(s);
+}
+
+struct sched_test {
+	volatile uint32_t hist[8];
+	volatile uint32_t done;
+	volatile uint32_t fast_idle;    /* rounds where cpu6 or cpu7 was idle and recommended as the worker went to sleep */
+};
+
+static void
+sched_test_worker(void *arg, wait_result_t wr __unused)
+{
+	struct sched_test *st = arg;
+
+	for (int i = 0; i < 150; i++) {
+		uint64_t until = 0;
+
+		clock_interval_to_deadline(1, NSEC_PER_MSEC, &until);
+		while (mach_absolute_time() < until) {
+			;                               /* 1 ms busy */
+		}
+		disable_preemption();
+		const int c = cpu_number();
+		enable_preemption();
+		if (c >= 0 && c < 8) {
+			OSIncrementAtomic((volatile SInt32 *)&st->hist[c]);
+		}
+		{
+			const processor_set_t ps = processor_array[0]->processor_set;
+
+			if ((ps->cpu_state_map[PROCESSOR_IDLE] & ps->recommended_bitmask & 0xc0) != 0) {
+				OSIncrementAtomic((volatile SInt32 *)&st->fast_idle);
+			}
+		}
+		assert_wait_timeout((event_t)st, THREAD_UNINT, 4, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+	OSIncrementAtomic((volatile SInt32 *)&st->done);
+	thread_terminate_self();
+}
+
+static void
+sched_test_phase(processor_set_t pset, uint64_t preferred, uint64_t avoided, const char *what)
+{
+	struct sched_test *st = kalloc_data(sizeof(*st), Z_WAITOK | Z_ZERO);
+	thread_t th;
+	int started = 0;
+
+	if (st == NULL) {
+		return;
+	}
+	sched_masks(pset, preferred, avoided);
+	for (int k = 0; k < 2; k++) {
+		if (kernel_thread_start(sched_test_worker, st, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+			started++;
+		}
+	}
+	for (int ms = 0; ms < 10000 && (int)st->done < started; ms += 50) {
+		delay_for_interval(50, NSEC_PER_MSEC);
+	}
+	{
+		const processor_set_t ps = processor_array[0]->processor_set;
+
+		printf("icesched: test %s (preferred %#llx avoided %#llx, read back %#llx %#llx): rounds by core cpu0..7: %u %u %u "
+		    "%u %u %u %u %u (%u of %d threads done); cpu6/7 idle at %u sleeps; set cpus %#llx recommended %#llx\n", what,
+		    preferred, avoided, (unsigned long long)ps->perfcontrol_cpu_preferred_bitmask,
+		    (unsigned long long)ps->perfcontrol_cpu_migration_bitmask, st->hist[0], st->hist[1], st->hist[2], st->hist[3],
+		    st->hist[4], st->hist[5], st->hist[6], st->hist[7], st->done, started, st->fast_idle,
+		    (unsigned long long)ps->cpu_bitmask, (unsigned long long)ps->recommended_bitmask);
+	}
+	if ((int)st->done == started) {
+		kfree_data(st, sizeof(*st));    /* (a worker still running keeps its block: never freed under it) */
+	}
+}
+
+/* the configured masks (icesched=0|1|2), said */
+/*
+ * icesched=3 (R2, render1): the QoS table in choose_processor (osfmk/kern/sched_prim.c iceland_qos_masks): bit 63 of
+ * the migration mask turns it on, the preferred mask names the fast cores. FIXPRI / FG / IN prefer cpu6-7, UT / BG
+ * prefer cpu0-5, DF as stock.
+ */
+static void
+sched_apply(processor_set_t pset, uint32_t mode)
+{
+	const uint64_t avoided = mode == 1 ? 0x3f : mode == 3 ? (1ULL << 63) : 0, preferred = mode != 0 ? 0xc0 : 0;
+
+	sched_masks(pset, preferred, avoided);
+	if (mode == 3) {
+		printf("icesched=3: by QoS: FIXPRI/FG/IN prefer idle cpu6-7 (cpu0-5 avoided while one is idle), UT/BG prefer "
+		    "idle cpu0-5 (cpu6-7 avoided while one of them is idle), DF as stock\n");
+	} else if (mode != 0) {
+		printf("icesched=%u: idle cpu6-7 (domain 1) preferred%s\n", mode, mode == 1 ? ", cpu0-5 avoided while cpu6-7 are idle" :
+		    " (only: the hint path keeps a woken thread on its idle last core)");
+	}
+}
+
+static void
+render_sched(void)
+{
+	uint32_t mode = 0, test = 0;
+	processor_t p0 = processor_array[0];
+
+	(void)PE_parse_boot_argn("icesched", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("icesched_test", &test, sizeof(test));
+	if (mode == 0 && test == 0) {
+		return;
+	}
+	if (ml_get_cpu_count() != 8 || p0 == PROCESSOR_NULL || p0->processor_set == PROCESSOR_SET_NULL) {
+		printf("icesched=%u: not 8 cores in one set: left alone\n", mode);
+		return;
+	}
+	if (test) {
+		/*
+		 * Here, synchronously (~2 s of the boot, test word only): the 7ead31a bar ran it on a thread of its own and
+		 * phase B overlapped launchd's start, when no core is idle and no placement policy applies.
+		 */
+		processor_set_t ps = p0->processor_set;
+
+		sched_test_phase(ps, 0, 0, "A, as stock");
+		sched_test_phase(ps, 0xc0, 0x3f, "B, icesched=1");
+		sched_test_phase(ps, 0, 0, "A2, as stock");
+		sched_test_phase(ps, 0xc0, 0x3f, "B2, icesched=1");
+		sched_test_phase(ps, 0xc0, 1ULL << 63, "C, icesched=3 (kernel threads: FIXPRI)");
+	}
+	sched_apply(p0->processor_set, mode);
+}
+
+/* from redwood_input_init (bsd/dev/redwood_input.c), as the other iceland drivers start */
+void
+hakios_memtel_init(void)
+{
+	uint32_t every = 0;
+	thread_t th;
+
+	render_sched();         /* render1: icesched= */
+	render_start();         /* render1: icerender= (its own word, with or without icemem) */
+	if (!PE_parse_boot_argn("icemem", &every, sizeof(every)) || every == 0) {
+		return;
+	}
+	if (kernel_thread_start(memtel_thread, (void *)(uintptr_t)every, &th) != KERN_SUCCESS) {
+		printf("icemem: no thread: no telemetry\n");
+		return;
+	}
+	thread_deallocate(th);
+}
diff --git a/osfmk/arm64/hakios_memtel.h b/osfmk/arm64/hakios_memtel.h
new file mode 100644
index 0000000000000000000000000000000000000000..6cd3c6c6b7b01798210ca9d4857c83a96d7dc49f
--- /dev/null
+++ b/osfmk/arm64/hakios_memtel.h
@@ -0,0 +1,31 @@
+/*
+ * iceland macOS port, gains1 (21 Nov): the memory telemetry's snapshot record (osfmk/arm64/hakios_memtel.c, icemem=).
+ * The kernel half is filled in osfmk/vm/vm_resident.c (iceland_memsnap_take), where the VM counters, the allocation
+ * sites and the zones are in reach; the record lives on the telemetry thread's stack (no __DATA).
+ */
+#ifndef _ARM64_HAKIOS_MEMTEL_H_
+#define _ARM64_HAKIOS_MEMTEL_H_
+
+#include <stdint.h>
+
+#define ICEMEM_TOP      5
+#define ICEMEM_NAME     40
+
+struct iceland_memsnap {
+	/* pages */
+	uint64_t wired, free, active, inactive, speculative;
+	uint64_t cmp_resident;          /* pages holding compressed data (VM_PAGE_COMPRESSOR_COUNT) */
+	uint64_t cmp_pages_in;          /* pages compressed into them (c_segment_pages_compressed) */
+	/* bytes */
+	uint64_t cmp_bytes;             /* compressor_bytes_used */
+	uint64_t zones_wired, zones_alloc, kalloc_large;
+	uint64_t zone_bytes[ICEMEM_TOP];
+	char zone_name[ICEMEM_TOP][ICEMEM_NAME];
+	uint64_t tag_bytes[ICEMEM_TOP];         /* the wired allocation sites' totals (VM_TAG_ACTIVE_UPDATE) */
+	uint16_t tag[ICEMEM_TOP];
+	char tag_name[ICEMEM_TOP][ICEMEM_NAME];
+};
+
+void iceland_memsnap_take(struct iceland_memsnap *m);
+
+#endif /* _ARM64_HAKIOS_MEMTEL_H_ */
diff --git a/osfmk/arm64/hakios_prof.c b/osfmk/arm64/hakios_prof.c
new file mode 100644
index 0000000000000000000000000000000000000000..3e4e8ea820643ae0b6d9a7ea491fa56793ec3130
--- /dev/null
+++ b/osfmk/arm64/hakios_prof.c
@@ -0,0 +1,1050 @@
+/*
+ * A sampling profiler for one process (boot-arg dadaprof=NAME, e.g. SpringBoard): about 1000 times a second every CPU is
+ * looked at, and a thread of that process running there is sampled from its saved user state (machine.upcb: the user PC,
+ * LR, FP and SP of its last entry into the kernel -- a timer interrupt for a thread busy in user code, the call site for
+ * one in a system call), with its user call stack walked along the frame pointers. Nothing is printed per sample: the
+ * counts are kept per thread, per stack, per leaf PC and per frame PC (inclusive) for a window of dadaprof_secs (default
+ * 20) and printed once at its end: the top threads, the top 30 stacks, the top 30 leaf PCs and the top 30 inclusive PCs,
+ * every address as "IMAGE+OFFSET" against the process's dyld image list, and then those images (load address, the shared
+ * cache's UUID or the image's own, path), so the PC side (scratchpad symb20ac.py: ipsw dyld a2s / ipsw macho a2s) names
+ * them. After Data A Live's pandora_prof.c (ShueiTsuki/data-a-live).
+ *
+ * 34 (kit 20ac5): why 20ac, 20ac2, 20ac3 and 20ac4 "stalled". They did not: their "dprof: " lines reached the loader's log
+ * only while its 256 KB head lasted (the head of 20ac4 ends at 16:30:00, after "sample 3 done"); everything later went to
+ * the 1.5 MB ring, which the last second of the run's console traffic overwrote (20ac4's ring holds 16:32:15-16:32:16 only),
+ * and "dprof: " is neither a kept prefix (loader_return.c: loader_keep_wanted) nor in keep_words. The heartbeats, the
+ * reports and 20ac2's cross-call samples were all lost the same way. Every line now begins "iceprof: ", which the keep rule
+ * for "ice" lines copies to the kept part of the log, and ends ";;" (the joined log has no line ends to split on).
+ * Also: the LR / return addresses are now stripped of their PAC bits with the user VA size (39 bits, T0SZ 25: 20ac4's
+ * "lr=0x1949ec0100003d00" is 0x100003d00), not with a 48-bit mask that left PAC bits in.
+ *
+ * Boot-args: dadaprof=NAME, dadaprof_secs=S (window, default 20), dadaprof_at=T (window start, seconds after the profiler
+ * starts; default touch_swipe + 3 when touch_swipe= is set -- the kits' scripted unlock swipe, armed at the same point of
+ * the boot (redwood_input_init) -- else at once), dadaprof_reports=N (windows one after the other, default 2),
+ * dadaprof_vabits=B (default 39). dadaprof=all: who is on the CPUs, as before.
+ */
+/* macOS: iPadOS-only diagnostic, out of the prelinked kernel (its __TEXT is full); iOS unchanged. */
+#if !defined(XNU_TARGET_OS_OSX)
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/misc_protos.h>
+#include <kern/kalloc.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/machine_routines.h>
+#include <mach/arm/thread_status.h>
+#include <arm64/proc_reg.h>
+#include <kdp/kdp_dyld.h>
+#include <vm/vm_map.h>
+#include <vm/vm_map_xnu.h>
+#include <pexpert/pexpert.h>
+#include <string.h>
+#include <kern/recount.h>               /* (36: icetmr) */
+#include <os/atomic_private.h>
+
+extern char *proc_name_address(void *p);
+extern lck_mtx_t tasks_threads_lock;
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern void bsd_getthreadname(void *uth, char *buffer);
+
+#define PROF_CPUS       8
+#define PROF_DEPTH      16              /* frames kept of a stack (leaf PC, LR, then the frame records) */
+#define PROF_STACKS     2048u           /* distinct stacks a window; a power of two */
+#define PROF_PCS        4096u           /* distinct PCs a window, leaf and inclusive tables each; a power of two */
+#define PROF_THREADS    64
+#define PROF_TOP        30
+#define PROF_MAX_IMAGES 4096u
+#define PROF_WALKS      4               /* stack walks a round at most (each frame is a vm_map_read_user) */
+#define PROF_LINE       176             /* text of a line before ";;\n" (redwood_tl cuts at 191) */
+
+struct prof_stack {
+	uint64_t f[PROF_DEPTH];
+	uint32_t count;
+	uint16_t slot;
+	uint8_t  depth;
+	uint8_t  used;
+};
+struct prof_pc {
+	uint64_t pc;
+	uint32_t count;
+	uint32_t pad;
+};
+struct prof_thr {
+	uint64_t tid;
+	uint64_t last_pc, last_lr, last_fp, last_sp;
+	int32_t  last_stack;            /* its last stack's slot in prof_stacks, -1: none */
+	uint32_t count, svc;
+	char     name[64];
+};
+
+static struct prof_stack *prof_stacks;
+static struct prof_pc *prof_self, *prof_incl;
+static struct prof_thr prof_thr[PROF_THREADS];
+static task_t prof_task;
+static vm_map_t prof_map;
+static char prof_name[17];
+static uint64_t prof_vamask = (1ULL << 39) - 1;
+static struct {
+	uint64_t rounds, samples, walks, reused, shallow, faults, clipped;
+	uint64_t lost_stacks, lost_pcs, lost_threads;
+} ps;
+
+#define PROF_VA(x)      ((uint64_t)(x) & prof_vamask)
+
+/* ---- the tables (only the profiler's own thread touches them: no lock) */
+
+static void
+prof_pc_add(struct prof_pc *t, uint64_t pc, uint32_t n)
+{
+	uint32_t h = (uint32_t)((pc >> 2) * 2654435761u);
+
+	if (pc == 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < 32; i++) {
+		struct prof_pc *e = &t[(h + i) & (PROF_PCS - 1)];
+
+		if (e->pc == pc || e->pc == 0) {
+			e->pc = pc;
+			e->count += n;
+			return;
+		}
+	}
+	ps.lost_pcs++;
+}
+
+static void
+prof_incl_add(const uint64_t *f, unsigned depth)
+{
+	for (unsigned i = 0; i < depth; i++) {
+		unsigned j = 0;
+
+		while (j < i && f[j] != f[i]) {
+			j++;
+		}
+		if (j == i) {                   /* (each PC once a sample: recursion not counted twice) */
+			prof_pc_add(prof_incl, f[i], 1);
+		}
+	}
+}
+
+static int32_t
+prof_stack_add(unsigned slot, const uint64_t *f, unsigned depth)
+{
+	uint64_t h = 1469598103934665603ULL ^ slot;
+
+	for (unsigned i = 0; i < depth; i++) {
+		h = (h ^ f[i]) * 1099511628211ULL;
+	}
+	for (uint32_t i = 0; i < 64; i++) {
+		uint32_t k = (uint32_t)(h + i) & (PROF_STACKS - 1);
+		struct prof_stack *e = &prof_stacks[k];
+
+		if (!e->used) {
+			memcpy(e->f, f, depth * sizeof(f[0]));
+			e->depth = (uint8_t)depth;
+			e->slot = (uint16_t)slot;
+			e->count = 1;
+			e->used = 1;
+			return (int32_t)k;
+		}
+		if (e->slot == slot && e->depth == depth && memcmp(e->f, f, depth * sizeof(f[0])) == 0) {
+			e->count++;
+			return (int32_t)k;
+		}
+	}
+	ps.lost_stacks++;
+	return -1;
+}
+
+static int
+prof_thr_slot(uint64_t tid, thread_t t)
+{
+	for (unsigned i = 0; i < PROF_THREADS; i++) {
+		if (prof_thr[i].tid == tid) {
+			return (int)i;
+		}
+		if (prof_thr[i].tid == 0) {
+			void *uth = get_bsdthread_info(t);
+
+			prof_thr[i].tid = tid;
+			prof_thr[i].last_stack = -1;
+			prof_thr[i].name[0] = 0;
+			if (uth != NULL) {
+				bsd_getthreadname(uth, prof_thr[i].name);
+				prof_thr[i].name[sizeof(prof_thr[i].name) - 1] = 0;
+			}
+			return (int)i;
+		}
+	}
+	ps.lost_threads++;
+	return -1;
+}
+
+/*
+ * The user stack from a saved state: PC, LR, then the frame records ([fp] = the caller's fp, [fp + 8] = the return address,
+ * PAC-signed on arm64e: stripped). Each record is read with vm_map_read_user (a fault ends the walk, nothing more); the
+ * chain must go up the stack (fp grows, stays 8-aligned, within 16 MB of the saved SP).
+ */
+static unsigned
+prof_walk(uint64_t pc, uint64_t lr, uint64_t fp, uint64_t sp, uint64_t *f)
+{
+	uint64_t lo = sp, hi = sp + (16ULL << 20);
+	unsigned d = 0;
+	bool first = true;
+
+	f[d++] = pc;
+	if (lr >= 0x1000) {
+		f[d++] = lr;
+	}
+	while (d < PROF_DEPTH && fp != 0) {
+		uint64_t rec[2], ret;
+
+		if ((fp & 7) != 0 || fp < lo || fp >= hi) {
+			break;
+		}
+		if (vm_map_read_user(prof_map, fp, rec, sizeof(rec)) != KERN_SUCCESS) {
+			ps.faults++;
+			break;
+		}
+		ret = PROF_VA(rec[1]);
+		if (ret < 0x1000) {
+			break;
+		}
+		if (!(first && d == 2 && ret == f[1])) {        /* (a function with a frame: its saved LR is the LR) */
+			f[d++] = ret;
+		}
+		first = false;
+		if (rec[0] <= fp) {
+			break;
+		}
+		lo = fp + 16;
+		fp = rec[0];
+	}
+	return d;
+}
+
+static void
+prof_sample(thread_t t, unsigned *walks)
+{
+	const arm_saved_state_t *st = t->machine.upcb;
+	uint64_t pc, lr, fp, sp, tid = thread_tid(t);
+	struct prof_thr *th;
+	int slot;
+
+	if (st == NULL || !PSR64_IS_USER(get_saved_state_cpsr(st))) {
+		return;
+	}
+	pc = (uint64_t)get_saved_state_pc(st);
+	lr = PROF_VA(get_saved_state_lr(st));
+	fp = (uint64_t)get_saved_state_fp(st);
+	sp = (uint64_t)get_saved_state_sp(st);
+	if (pc == 0) {
+		return;
+	}
+	if (PROF_VA(pc) != pc) {
+		ps.clipped++;                   /* (an unsigned PC above the VA mask: dadaprof_vabits too small) */
+		pc = PROF_VA(pc);
+	}
+	ps.samples++;
+	slot = prof_thr_slot(tid, t);
+	th = slot >= 0 ? &prof_thr[slot] : NULL;
+	if (th != NULL) {
+		th->count++;
+		if (ESR_EC(get_saved_state_esr(st)) == ESR_EC_SVC_64) {
+			th->svc++;
+		}
+	}
+	prof_pc_add(prof_self, pc, 1);
+	/* the same saved state as last time: the thread has not entered the kernel since; its stack counted again */
+	if (th != NULL && th->last_pc == pc && th->last_lr == lr && th->last_fp == fp && th->last_sp == sp) {
+		ps.reused++;
+		if (th->last_stack >= 0) {
+			struct prof_stack *e = &prof_stacks[th->last_stack];
+
+			e->count++;
+			prof_incl_add(e->f, e->depth);
+		} else {
+			prof_pc_add(prof_incl, pc, 1);
+		}
+		return;
+	}
+	{
+		uint64_t f[PROF_DEPTH];
+		unsigned depth;
+
+		if (*walks < PROF_WALKS && prof_map != VM_MAP_NULL) {
+			(*walks)++;
+			ps.walks++;
+			depth = prof_walk(pc, lr, fp, sp, f);
+		} else {
+			ps.shallow++;
+			f[0] = pc;
+			depth = 1;
+			if (lr >= 0x1000) {
+				f[depth++] = lr;
+			}
+		}
+		prof_incl_add(f, depth);
+		if (th != NULL) {
+			th->last_stack = prof_stack_add((unsigned)slot, f, depth);
+			th->last_pc = pc;
+			th->last_lr = lr;
+			th->last_fp = fp;
+			th->last_sp = sp;
+		}
+	}
+}
+
+/* ---- the report: images, then lines */
+
+static struct user64_dyld_image_info *prof_imgs;        /* the process's image list, read at the report */
+static uint16_t prof_iord[PROF_MAX_IMAGES];             /* its indexes sorted by load address */
+static uint8_t prof_iref[PROF_MAX_IMAGES / 8];          /* images named in the report */
+static uint32_t prof_nimg;
+static struct user64_dyld_all_image_infos prof_infos;
+
+static void
+prof_img_load(void)
+{
+	prof_nimg = 0;
+	bzero(prof_iref, sizeof(prof_iref));
+	if (prof_task->all_image_info_addr == 0 || prof_imgs == NULL) {
+		return;
+	}
+	for (int tries = 0; tries < 5; tries++) {       /* (infoArray is NULL while dyld changes the list) */
+		uint32_t n;
+
+		if (vm_map_read_user(prof_map, prof_task->all_image_info_addr, &prof_infos, sizeof(prof_infos)) != KERN_SUCCESS) {
+			return;
+		}
+		n = prof_infos.infoArrayCount < PROF_MAX_IMAGES ? prof_infos.infoArrayCount : PROF_MAX_IMAGES;
+		if (prof_infos.infoArray != 0 && n != 0 &&
+		    vm_map_read_user(prof_map, prof_infos.infoArray, prof_imgs, n * sizeof(prof_imgs[0])) == KERN_SUCCESS) {
+			prof_nimg = n;
+			break;
+		}
+		delay(2000);
+	}
+	for (uint32_t i = 0; i < prof_nimg; i++) {
+		prof_iord[i] = (uint16_t)i;
+	}
+	/* shell sort of the indexes by load address */
+	for (uint32_t gap = prof_nimg / 2; gap > 0; gap /= 2) {
+		for (uint32_t i = gap; i < prof_nimg; i++) {
+			uint16_t v = prof_iord[i];
+			uint32_t j = i;
+
+			while (j >= gap && prof_imgs[prof_iord[j - gap]].imageLoadAddress > prof_imgs[v].imageLoadAddress) {
+				prof_iord[j] = prof_iord[j - gap];
+				j -= gap;
+			}
+			prof_iord[j] = v;
+		}
+	}
+}
+
+/* "IDX+OFF" (the image with the highest load address at or below a, within 256 MB of it), or "@ADDR" */
+static void
+prof_tok(uint64_t a, char *buf, size_t len)
+{
+	uint32_t lo = 0, hi = prof_nimg;
+
+	while (lo < hi) {
+		uint32_t mid = (lo + hi) / 2;
+
+		if (prof_imgs[prof_iord[mid]].imageLoadAddress <= a) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	if (lo > 0) {
+		uint16_t idx = prof_iord[lo - 1];
+		uint64_t off = a - prof_imgs[idx].imageLoadAddress;
+
+		if (off < (256ULL << 20)) {
+			prof_iref[idx / 8] |= (uint8_t)(1u << (idx % 8));
+			snprintf(buf, len, "%u+%llx", (unsigned)idx, off);
+			return;
+		}
+	}
+	snprintf(buf, len, "@%llx", a);
+}
+
+/* a line built token by token: continued on a new "iceprof: HEAD+" line when the next token would pass PROF_LINE */
+static char prof_lb[PROF_LINE + 8];
+static size_t prof_ll;
+static char prof_lhead[24];
+
+static void
+prof_line_start(const char *head)
+{
+	strlcpy(prof_lhead, head, sizeof(prof_lhead));
+	prof_ll = (size_t)snprintf(prof_lb, sizeof(prof_lb), "iceprof: %s", head);
+}
+
+static void
+prof_line_end(void)
+{
+	redwood_tl("%s;;\n", prof_lb);
+	prof_ll = 0;
+}
+
+static void
+prof_line_add(const char *tok)
+{
+	size_t n = strlen(tok);
+
+	if (prof_ll + 1 + n > PROF_LINE) {
+		prof_line_end();
+		prof_ll = (size_t)snprintf(prof_lb, sizeof(prof_lb), "iceprof: %s+", prof_lhead);
+	}
+	prof_ll += (size_t)snprintf(prof_lb + prof_ll, sizeof(prof_lb) - prof_ll, " %s", tok);
+	if (prof_ll > PROF_LINE) {
+		prof_ll = PROF_LINE;
+	}
+}
+
+static void
+prof_hex16(const uint8_t *u, char *out)
+{
+	static const char hx[] = "0123456789abcdef";
+
+	for (int i = 0; i < 16; i++) {
+		out[2 * i] = hx[u[i] >> 4];
+		out[2 * i + 1] = hx[u[i] & 15];
+	}
+	out[32] = 0;
+}
+
+static void
+prof_top_pcs(const char *what, struct prof_pc *t)
+{
+	for (unsigned r = 1; r <= PROF_TOP; r++) {
+		uint32_t best = PROF_PCS;
+		char tok[40], head[24];
+
+		for (uint32_t k = 0; k < PROF_PCS; k++) {
+			if (t[k].count != 0 && (best == PROF_PCS || t[k].count > t[best].count)) {
+				best = k;
+			}
+		}
+		if (best == PROF_PCS) {
+			break;
+		}
+		prof_tok(t[best].pc, tok, sizeof(tok));
+		snprintf(head, sizeof(head), "%s %u", what, r);
+		prof_line_start(head);
+		snprintf(head, sizeof(head), "n %u", t[best].count);
+		prof_line_add(head);
+		prof_line_add(tok);
+		prof_line_end();
+		t[best].count = 0;
+	}
+}
+
+static void
+prof_report(unsigned nr, uint64_t ms)
+{
+	uint64_t total = ps.samples ? ps.samples : 1;
+
+	prof_img_load();
+	redwood_tl("iceprof: report %u begin: %s pid %d, %llu ms, %llu rounds, %llu samples;;\n", nr, prof_name,
+	    task_pid(prof_task), ms, ps.rounds, ps.samples);
+	redwood_tl("iceprof: stats %u: walks %llu reused %llu shallow %llu faults %llu clipped %llu lost s%llu p%llu t%llu;;\n",
+	    nr, ps.walks, ps.reused, ps.shallow, ps.faults, ps.clipped, ps.lost_stacks, ps.lost_pcs, ps.lost_threads);
+	{
+		char u[33];
+
+		prof_hex16(prof_infos.sharedCacheUUID, u);
+		redwood_tl("iceprof: cache %u: uuid %s base %llx slide %llx images %u of %u dyldv %u vabits %u;;\n", nr, u,
+		    prof_nimg ? prof_infos.sharedCacheBaseAddress : 0ULL, prof_nimg ? prof_infos.sharedCacheSlide : 0ULL,
+		    prof_nimg, prof_infos.infoArrayCount, prof_infos.version, (unsigned)__builtin_popcountll(prof_vamask));
+	}
+	/* the threads: share of the samples, and of one CPU (samples / rounds) */
+	for (unsigned n = 0; n < 12; n++) {
+		unsigned best = PROF_THREADS;
+
+		for (unsigned i = 0; i < PROF_THREADS; i++) {
+			if (prof_thr[i].count != 0 && (best == PROF_THREADS || prof_thr[i].count > prof_thr[best].count)) {
+				best = i;
+			}
+		}
+		if (best == PROF_THREADS) {
+			break;
+		}
+		redwood_tl("iceprof: thr %u: t%u tid %llu n %u = %llu%% cpu %llu%% svc %u '%.40s';;\n", nr, best, prof_thr[best].tid,
+		    prof_thr[best].count, (uint64_t)prof_thr[best].count * 100 / total,
+		    ps.rounds ? (uint64_t)prof_thr[best].count * 100 / ps.rounds : 0ULL, prof_thr[best].svc, prof_thr[best].name);
+		prof_thr[best].count = 0;
+	}
+	/* the stacks, commonest first, leaf first */
+	for (unsigned r = 1; r <= PROF_TOP; r++) {
+		uint32_t best = PROF_STACKS;
+		char tok[40], head[24];
+
+		for (uint32_t k = 0; k < PROF_STACKS; k++) {
+			if (prof_stacks[k].used && prof_stacks[k].count != 0 &&
+			    (best == PROF_STACKS || prof_stacks[k].count > prof_stacks[best].count)) {
+				best = k;
+			}
+		}
+		if (best == PROF_STACKS) {
+			break;
+		}
+		snprintf(head, sizeof(head), "stk %u", r);
+		prof_line_start(head);
+		snprintf(tok, sizeof(tok), "n %u t%u d%u", prof_stacks[best].count, prof_stacks[best].slot, prof_stacks[best].depth);
+		prof_line_add(tok);
+		for (unsigned i = 0; i < prof_stacks[best].depth; i++) {
+			prof_tok(prof_stacks[best].f[i], tok, sizeof(tok));
+			prof_line_add(tok);
+		}
+		prof_line_end();
+		prof_stacks[best].count = 0;
+	}
+	prof_top_pcs("self", prof_self);
+	prof_top_pcs("incl", prof_incl);
+	/* the images named above */
+	for (uint32_t i = 0; i < prof_nimg; i++) {
+		struct user64_dyld_uuid_info uu;
+		char path[160], u[33], *tail;
+		bool own = false;
+
+		bzero(&uu, sizeof(uu));
+		if (!(prof_iref[i / 8] & (1u << (i % 8)))) {
+			continue;
+		}
+		/* (dyld's uuidArray lists the images outside the shared cache only) */
+		for (uint64_t k = 0; prof_infos.uuidArray != 0 && k < prof_infos.uuidArrayCount && k < 1024; k++) {
+			if (vm_map_read_user(prof_map, prof_infos.uuidArray + k * sizeof(uu), &uu, sizeof(uu)) != KERN_SUCCESS) {
+				break;
+			}
+			if (uu.imageLoadAddress == prof_imgs[i].imageLoadAddress) {
+				own = true;
+				break;
+			}
+		}
+		bzero(path, sizeof(path));
+		(void)vm_map_read_user(prof_map, prof_imgs[i].imageFilePath, path, sizeof(path) - 1);
+		tail = path;
+		if (strlen(tail) > 100) {
+			tail += strlen(tail) - 100;
+		}
+		if (own) {
+			prof_hex16(uu.imageUUID, u);
+			redwood_tl("iceprof: img %u: %u %llx u %s %s;;\n", nr, i, prof_imgs[i].imageLoadAddress, u, tail);
+		} else {
+			redwood_tl("iceprof: img %u: %u %llx c %s;;\n", nr, i, prof_imgs[i].imageLoadAddress, tail);
+		}
+	}
+	redwood_tl("iceprof: report %u end;;\n", nr);
+}
+
+static void
+prof_clear(void)
+{
+	bzero(prof_stacks, PROF_STACKS * sizeof(prof_stacks[0]));
+	bzero(prof_self, PROF_PCS * sizeof(prof_self[0]));
+	bzero(prof_incl, PROF_PCS * sizeof(prof_incl[0]));
+	bzero(prof_thr, sizeof(prof_thr));
+	bzero(&ps, sizeof(ps));
+}
+
+static task_t
+prof_find(void)
+{
+	task_t found = TASK_NULL, task;
+
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&tasks, task, task_t, tasks) {
+		void *p = get_bsdtask_info(task);
+
+		if (p != NULL && strncmp(proc_name_address(p), prof_name, 16) == 0) {
+			task_reference(task);
+			found = task;
+			break;
+		}
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	return found;
+}
+
+static void
+prof_drop_task(void)
+{
+	if (prof_map != VM_MAP_NULL) {
+		vm_map_deallocate(prof_map);
+		prof_map = VM_MAP_NULL;
+	}
+	if (prof_task != TASK_NULL) {
+		task_deallocate(prof_task);
+		prof_task = TASK_NULL;
+	}
+}
+
+static void
+prof_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t secs = 20, at = 0, swipe = 0, reports = 2, vabits = 39, nr = 0;
+	uint64_t t0, second, start, period, end = 0, next_find = 0, next_beat = 0, opened = 0;
+
+	PE_parse_boot_argn("dadaprof_secs", &secs, sizeof(secs));
+	PE_parse_boot_argn("dadaprof_reports", &reports, sizeof(reports));
+	PE_parse_boot_argn("dadaprof_vabits", &vabits, sizeof(vabits));
+	if (PE_parse_boot_argn("touch_swipe", &swipe, sizeof(swipe)) && swipe != 0) {
+		at = swipe + 3;                 /* (the unlock swipe takes ~0.4 s; its animation another ~0.5 s) */
+	}
+	PE_parse_boot_argn("dadaprof_at", &at, sizeof(at));
+	if (secs == 0) {
+		secs = 20;
+	}
+	if (vabits >= 32 && vabits <= 48) {
+		prof_vamask = (1ULL << vabits) - 1;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	nanoseconds_to_absolutetime((uint64_t)secs * NSEC_PER_SEC, &period);
+	t0 = mach_absolute_time();
+	start = t0 + at * second;
+	redwood_tl("iceprof: started: %s, window %u s from %u s after start (touch_swipe %u), %u reports, va %u bits;;\n",
+	    prof_name, secs, at, swipe, reports, vabits);
+	for (;;) {
+		uint64_t now = mach_absolute_time();
+
+		if (prof_task != TASK_NULL && !prof_task->active) {
+			redwood_tl("iceprof: %s gone;;\n", prof_name);
+			prof_drop_task();
+			opened = 0;
+			prof_clear();
+		}
+		if (prof_task == TASK_NULL) {
+			if (now >= next_find) {
+				next_find = now + second;
+				prof_task = prof_find();
+				if (prof_task != TASK_NULL) {
+					prof_map = get_task_map_reference(prof_task);
+					redwood_tl("iceprof: %s found, pid %d, %llu ms after start;;\n", prof_name, task_pid(prof_task),
+					    (now - t0) * 1000 / second);
+				}
+			}
+			delay(100 * 1000);
+			continue;
+		}
+		if (now < start) {
+			delay(100 * 1000);
+			continue;
+		}
+		if (opened == 0) {
+			prof_clear();
+			opened = now;
+			end = now + period;
+			next_beat = now + 5 * second;
+			redwood_tl("iceprof: window %u open, %llu ms after start;;\n", nr + 1, (now - t0) * 1000 / second);
+		}
+		{
+			unsigned walks = 0;
+			int me = cpu_number();
+
+			ps.rounds++;
+			for (int cpu = 0; cpu < PROF_CPUS && cpu <= ml_get_max_cpu_number(); cpu++) {
+				cpu_data_t *cd = cpu_datap(cpu);
+				thread_t t = cd != NULL ? cd->cpu_active_thread : THREAD_NULL;
+
+				if (cpu == me || t == THREAD_NULL || get_threadtask(t) != prof_task) {
+					continue;
+				}
+				prof_sample(t, &walks);
+			}
+		}
+		now = mach_absolute_time();
+		if (now >= next_beat && now < end) {
+			next_beat = now + 5 * second;
+			redwood_tl("iceprof: beat %u: %llu rounds %llu samples %llu walks %llu faults;;\n", nr + 1, ps.rounds, ps.samples,
+			    ps.walks, ps.faults);
+		}
+		if (now >= end) {
+			nr++;
+			prof_report(nr, (now - opened) * 1000 / second);
+			opened = 0;
+			start = now;            /* the next window right after */
+			if (nr >= reports) {
+				redwood_tl("iceprof: done after %u reports;;\n", nr);
+				prof_drop_task();
+				for (;;) {
+					delay(60 * 1000 * 1000);
+				}
+			}
+			continue;
+		}
+		delay(1000);
+	}
+}
+
+/*
+ * dadaprof=all: no PCs, only who is on each CPU, a thousand times a second -- the process each CPU's active thread
+ * belongs to (the idle thread counted as "idle") -- and every dadaprof_secs the processes that had the most of them:
+ * which process keeps the cores busy, before asking what in it does. (34: "iceprof: " lines, kept.)
+ */
+#define ALL_SLOTS       64
+
+static void
+prof_all_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static struct {
+		char name[17];
+		uint32_t count;
+	} seen[ALL_SLOTS];
+	uint32_t secs = 10, total = 0;
+	uint64_t period, next_report;
+
+	PE_parse_boot_argn("dadaprof_secs", &secs, sizeof(secs));
+	nanoseconds_to_absolutetime((uint64_t)secs * NSEC_PER_SEC, &period);
+	next_report = mach_absolute_time() + period;
+	for (;;) {
+		delay(1000);
+		for (int cpu = 0; cpu < PROF_CPUS && cpu <= ml_get_max_cpu_number(); cpu++) {
+			cpu_data_t *cd = cpu_datap(cpu);
+			thread_t t = cd != NULL ? cd->cpu_active_thread : THREAD_NULL;
+			const char *name = "?";
+			char own[17];
+
+			if (cpu == cpu_number() || t == THREAD_NULL) {
+				continue;
+			}
+			if (cpu_to_processor(cpu) != PROCESSOR_NULL && t == cpu_to_processor(cpu)->idle_thread) {
+				name = "idle";
+			} else {
+				task_t task = get_threadtask(t);
+				void *p = task != TASK_NULL ? get_bsdtask_info(task) : NULL;
+
+				if (task == kernel_task) {
+					name = "kernel_task";
+				} else if (p != NULL) {
+					strlcpy(own, proc_name_address(p), sizeof(own));
+					name = own;
+				}
+			}
+			total++;
+			for (unsigned i = 0; i < ALL_SLOTS; i++) {
+				if (seen[i].count == 0 || strncmp(seen[i].name, name, 16) == 0) {
+					if (seen[i].count == 0) {
+						strlcpy(seen[i].name, name, sizeof(seen[i].name));
+					}
+					seen[i].count++;
+					break;
+				}
+			}
+		}
+		if (mach_absolute_time() >= next_report && total != 0) {
+			char line[PROF_LINE + 8];
+			int at = 0;
+
+			line[0] = 0;
+			next_report = mach_absolute_time() + period;
+			for (unsigned n = 0; n < 12 && at < PROF_LINE - 60; n++) {
+				unsigned best = ALL_SLOTS;
+
+				for (unsigned i = 0; i < ALL_SLOTS; i++) {
+					if (seen[i].count != 0 && (best == ALL_SLOTS || seen[i].count > seen[best].count)) {
+						best = i;
+					}
+				}
+				if (best == ALL_SLOTS) {
+					break;
+				}
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %s %u%%", seen[best].name,
+				    seen[best].count * 100 / total);
+				seen[best].count = 0;
+			}
+			redwood_tl("iceprof: on the CPUs (%u samples):%s;;\n", total, line);
+			bzero(seen, sizeof(seen));
+			total = 0;
+		}
+	}
+}
+
+/*
+ * 36 (kit 20ac6), boot-arg icetmr=NAME (e.g. SpringBoard): that process's mk_timer calls, counted in the traps
+ * (osfmk/kern/mk_timer.c -> hakios_tmr_note): arms (mk_timer_arm, "arm": CFRunLoop's timers), arms with leeway
+ * (mk_timer_arm_leeway, "lw": QuartzCore's display_timer_callback, UpdateCycle) and cancels, each arm's deadline against
+ * the time it was armed (mach_absolute_time, or mach_continuous_time with MK_TIMER_CONTINUOUS) in buckets
+ * <=0 (already due: the timer fires at once) / 0-100 us / 100-1000 us / 1-8.3 ms / 8.3-17 ms / more, its smallest and
+ * largest, the largest leeway, the flags seen; and per caller (the user LR at the trap, unslid against the process's
+ * shared cache: "ipsw dyld a2s" names it) how many arms, how many already due, how many under 1 ms. Every icetmr_secs
+ * (default 5) from icetmr_at seconds after this start (default touch_swipe - 5: one window before the scripted unlock),
+ * icetmr_n windows (default 36), lines "icetmr: ...;;", plus the process's CPU time in the window (recount: user+system
+ * over the window = its CPU share, 100 % = one core) and the framebuffer's "icefbt: " lines (hakios_fb_timing). Logging
+ * only: nothing is changed for the process.
+ */
+#define TMR_B           6
+#define TMR_LRS         12
+volatile uint32_t hakios_tmr_on;
+static char tmr_name[17];
+static int tmr_pid;
+static struct tmr_kind {
+	uint64_t n, b[TMR_B], lwmax, flags;
+	int64_t dmin, dmax;                     /* us */
+} tmr_k[2];
+static uint64_t tmr_cancels;
+static struct tmr_lr {
+	uint64_t lr;
+	uint32_t n, due, lt1ms, kind;
+} tmr_lr[TMR_LRS];
+static uint64_t tmr_lr_full;
+extern uint64_t mach_continuous_time(void);
+extern void hakios_fb_timing(uint64_t now);
+
+void hakios_tmr_note(unsigned kind, uint64_t expire_time, uint64_t leeway, uint64_t flags);
+
+void
+hakios_tmr_note(unsigned kind, uint64_t expire_time, uint64_t leeway, uint64_t flags)
+{
+	task_t task = current_task();
+	void *p = get_bsdtask_info(task);
+	const arm_saved_state_t *st;
+	struct tmr_kind *k;
+	uint64_t now, ns, lr = 0;
+	int64_t us;
+	unsigned b;
+
+	if (p == NULL || strncmp(proc_name_address(p), tmr_name, 16) != 0) {
+		return;
+	}
+	tmr_pid = task_pid(task);
+	if (kind >= 2) {
+		os_atomic_inc(&tmr_cancels, relaxed);
+		return;
+	}
+	now = (flags & 0x2) ? mach_continuous_time() : mach_absolute_time();     /* (0x2: MK_TIMER_CONTINUOUS) */
+	if (expire_time <= now) {
+		absolutetime_to_nanoseconds(now - expire_time, &ns);
+		us = -(int64_t)(ns / 1000);
+		b = 0;
+	} else {
+		absolutetime_to_nanoseconds(expire_time - now, &ns);
+		us = ns / 1000 > 0x7fffffffffffffffULL ? 0x7fffffffffffffffLL : (int64_t)(ns / 1000);
+		b = ns < 100000 ? 1 : ns < 1000000 ? 2 : ns < 8333334 ? 3 : ns < 17000000 ? 4 : 5;
+	}
+	k = &tmr_k[kind];
+	os_atomic_inc(&k->n, relaxed);
+	os_atomic_inc(&k->b[b], relaxed);
+	if (us < k->dmin || k->n == 1) {        /* (min / max racy between threads: near enough for a log) */
+		k->dmin = us;
+	}
+	if (us > k->dmax || k->n == 1) {
+		k->dmax = us;
+	}
+	if (leeway > k->lwmax) {
+		k->lwmax = leeway;
+	}
+	os_atomic_or(&k->flags, flags, relaxed);
+	st = current_thread()->machine.upcb;
+	if (st != NULL) {
+		lr = PROF_VA(get_saved_state_lr(st));
+	}
+	if (lr == 0) {
+		lr = 1;                         /* (0 marks a free slot) */
+	}
+	for (unsigned i = 0; i < TMR_LRS; i++) {
+		struct tmr_lr *e = &tmr_lr[i];
+
+		if (e->lr == lr || (e->lr == 0 && os_atomic_cmpxchg(&e->lr, 0, lr, relaxed)) || e->lr == lr) {
+			os_atomic_inc(&e->n, relaxed);
+			e->kind = kind;
+			if (b == 0) {
+				os_atomic_inc(&e->due, relaxed);
+			}
+			if (b <= 2) {
+				os_atomic_inc(&e->lt1ms, relaxed);
+			}
+			return;
+		}
+	}
+	os_atomic_inc(&tmr_lr_full, relaxed);
+}
+
+static task_t
+tmr_find(void)
+{
+	task_t found = TASK_NULL, task;
+
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&tasks, task, task_t, tasks) {
+		void *p = get_bsdtask_info(task);
+
+		if (p != NULL && task->active && strncmp(proc_name_address(p), tmr_name, 16) == 0) {
+			task_reference(task);
+			found = task;
+			break;
+		}
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	return found;
+}
+
+static void
+tmr_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t secs = 5, at = 0, swipe = 0, windows = 36;
+	uint64_t t0, second, period, next, last, cpu_last = 0;
+	int cpu_pid = -1;
+
+	PE_parse_boot_argn("icetmr_secs", &secs, sizeof(secs));
+	PE_parse_boot_argn("icetmr_n", &windows, sizeof(windows));
+	if (PE_parse_boot_argn("touch_swipe", &swipe, sizeof(swipe)) && swipe > 5) {
+		at = swipe - 5;
+	}
+	PE_parse_boot_argn("icetmr_at", &at, sizeof(at));
+	if (secs == 0 || secs > 60) {
+		secs = 5;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	period = secs * second;
+	t0 = mach_absolute_time();
+	next = t0 + at * second;
+	redwood_tl("icetmr: started: %s, every %u s from %u s after start (touch_swipe %u), %u windows;;\n", tmr_name, secs, at,
+	    swipe, windows);
+	while (mach_absolute_time() < next) {
+		delay(100 * 1000);
+	}
+	/* the window opens: counters from zero */
+	bzero(tmr_k, sizeof(tmr_k));
+	bzero(tmr_lr, sizeof(tmr_lr));
+	tmr_cancels = tmr_lr_full = 0;
+	last = mach_absolute_time();
+	next = last + period;
+	for (uint32_t w = 1; w <= windows; w++) {
+		struct tmr_kind k[2];
+		struct tmr_lr e[TMR_LRS];
+		uint64_t now, dt_ms, cancels, full, cpu_ms = 0, slide = 0;
+		task_t task;
+		int have_slide = 0, pid;
+
+		while (mach_absolute_time() < next) {
+			delay(50 * 1000);
+		}
+		now = mach_absolute_time();
+		next += period;
+		/* take the window's counts (a call between copy and clear is lost: a log, not a ledger) */
+		memcpy(k, tmr_k, sizeof(k));
+		memcpy(e, tmr_lr, sizeof(e));
+		bzero(tmr_k, sizeof(tmr_k));
+		bzero(tmr_lr, sizeof(tmr_lr));
+		cancels = os_atomic_xchg(&tmr_cancels, 0, relaxed);
+		full = os_atomic_xchg(&tmr_lr_full, 0, relaxed);
+		dt_ms = (now - last) * 1000 / second;
+		last = now;
+		if (dt_ms == 0) {
+			dt_ms = 1;
+		}
+		pid = -1;
+		task = tmr_find();
+		if (task != TASK_NULL) {
+			struct recount_times_mach tm = recount_task_times(task);
+			uint64_t cpu = tm.rtm_user + tm.rtm_system;
+			vm_map_t map;
+			struct user64_dyld_all_image_infos inf;
+
+			pid = task_pid(task);
+			if (pid == cpu_pid && cpu >= cpu_last) {
+				cpu_ms = (cpu - cpu_last) * 1000 / second;
+			}
+			cpu_pid = pid;
+			cpu_last = cpu;
+			if (task->all_image_info_addr != 0 && (map = get_task_map_reference(task)) != VM_MAP_NULL) {
+				if (vm_map_read_user(map, task->all_image_info_addr, &inf, sizeof(inf)) == KERN_SUCCESS) {
+					slide = inf.sharedCacheSlide;
+					have_slide = 1;
+				}
+				vm_map_deallocate(map);
+			}
+			task_deallocate(task);
+		}
+		redwood_tl("icetmr: %llu ms w%u pid %d(%d) %llu ms: arm %llu/s lw %llu/s cancel %llu/s cpu %llu%% slide %llx%s;;\n",
+		    (now - t0) * 1000 / second, w, pid, tmr_pid, dt_ms, k[0].n * 1000 / dt_ms, k[1].n * 1000 / dt_ms,
+		    cancels * 1000 / dt_ms, cpu_ms * 100 / dt_ms, slide, have_slide ? "" : " (none)");
+		for (unsigned j = 0; j < 2; j++) {
+			uint64_t lw_ns;
+
+			if (k[j].n == 0) {
+				continue;
+			}
+			absolutetime_to_nanoseconds(k[j].lwmax, &lw_ns);
+			/* b = due/0-.1ms/.1-1ms/1-8.3ms/8.3-17ms/more; min, max, lw (largest leeway) in us */
+			redwood_tl("icetmr: w%u %s n %llu b %llu/%llu/%llu/%llu/%llu/%llu min %lld max %lld lw %llu fl %llx;;\n", w,
+			    j ? "lw" : "arm", k[j].n, k[j].b[0], k[j].b[1], k[j].b[2], k[j].b[3], k[j].b[4], k[j].b[5], k[j].dmin, k[j].dmax,
+			    lw_ns / 1000, k[j].flags);
+		}
+		/* the callers, most arms first, two to a line */
+		for (unsigned line = 0; line < 3; line++) {
+			char buf[160];
+			int len = 0;
+
+			buf[0] = 0;
+			for (unsigned m = 0; m < 2; m++) {
+				unsigned best = TMR_LRS;
+
+				for (unsigned i = 0; i < TMR_LRS; i++) {
+					if (e[i].n != 0 && (best == TMR_LRS || e[i].n > e[best].n)) {
+						best = i;
+					}
+				}
+				if (best == TMR_LRS) {
+					break;
+				}
+				len += snprintf(buf + len, sizeof(buf) - (size_t)len, " %s %llx n %u due %u lt1ms %u;", e[best].kind ? "lw" : "arm",
+				    have_slide && e[best].lr > slide ? e[best].lr - slide : e[best].lr, e[best].n, e[best].due, e[best].lt1ms);
+				e[best].n = 0;
+			}
+			if (len == 0) {
+				break;
+			}
+			redwood_tl("icetmr: w%u lr%s%s;;\n", w, buf, line == 0 && full != 0 ? " (callers past the table)" : "");
+		}
+		hakios_fb_timing(now);
+	}
+	redwood_tl("icetmr: done after %u windows;;\n", windows);
+	hakios_tmr_on = 0;
+	for (;;) {
+		delay(60 * 1000 * 1000);
+	}
+}
+
+void hakios_prof_start(void);
+
+void
+hakios_prof_start(void)
+{
+	thread_t thread;
+
+	if (PE_parse_boot_arg_str("icetmr", tmr_name, sizeof(tmr_name)) && tmr_name[0] != 0) {
+		if (kernel_thread_start_priority(tmr_thread, NULL, BASEPRI_KERNEL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			hakios_tmr_on = 1;
+		}
+	}
+	if (!PE_parse_boot_arg_str("dadaprof", prof_name, sizeof(prof_name)) || prof_name[0] == 0) {
+		return;
+	}
+	if (strcmp(prof_name, "all") == 0) {
+		if (kernel_thread_start_priority(prof_all_thread, NULL, BASEPRI_KERNEL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+		return;
+	}
+	prof_stacks = kalloc_data(PROF_STACKS * sizeof(prof_stacks[0]), Z_WAITOK | Z_ZERO);
+	prof_self = kalloc_data(PROF_PCS * sizeof(prof_self[0]), Z_WAITOK | Z_ZERO);
+	prof_incl = kalloc_data(PROF_PCS * sizeof(prof_incl[0]), Z_WAITOK | Z_ZERO);
+	prof_imgs = kalloc_data(PROF_MAX_IMAGES * sizeof(prof_imgs[0]), Z_WAITOK | Z_ZERO);
+	if (prof_stacks == NULL || prof_self == NULL || prof_incl == NULL || prof_imgs == NULL) {
+		redwood_tl("iceprof: no memory for the tables;;\n");
+		return;
+	}
+	if (kernel_thread_start_priority(prof_thread, NULL, BASEPRI_KERNEL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* !defined(XNU_TARGET_OS_OSX) */
