+	for (int pass = 0; pass < 2; pass++) {
+		__block int hits = 0;
+		void (^stk)(void) = ^{ hits++; };
+		struct Block_layout *lit = (struct Block_layout *)(void *)stk;
+		void *plain = (void *)lit->descriptor;
+		if (pass) {
+			lit->descriptor = (struct Block_descriptor_1 *)ptrauth_sign_unauthenticated(plain,
+			    ptrauth_key_asda, ptrauth_blend_discriminator(&lit->descriptor,
+			    _Block_descriptor_ptrauth_discriminator));
+		}
+		int sig = _Block_descriptor_is_signed((void *)lit->descriptor);
+		size_t ssz = Block_size(lit);
+		void (^h)(void) = (void (^)(void))_Block_copy((const void *)stk);
+		struct Block_layout *hl = (struct Block_layout *)(void *)h;
+		int moved = (void *)hl != (void *)lit;
+		int hsig = _Block_descriptor_is_signed((void *)hl->descriptor);
+		int same = _Block_get_descriptor(hl) == plain && Block_size(hl) == ssz;
+		h();
+		h();
+		int n = hits;
+		_Block_release((const void *)h);
+		printf("iceblk: %s descriptor: signed %d/%d, copy %d, same descriptor and size %d, invoked %d of 2, released: %s\n",
+		    pass ? "Apple-signed" : "plain", sig, hsig, moved, same, n,
+		    (sig == pass && hsig == pass && moved && same && n == 2) ? "PASS" : "FAIL");
+	}
+#endif
+}
+#endif
diff --git a/libkern/libkern/Block_private.h b/libkern/libkern/Block_private.h
index d1f1a3686b91fdea9b3e0153857428f4a9df940c..9678965b3821b4f0ad7ad7690543cc98af400137 100644
--- a/libkern/libkern/Block_private.h
+++ b/libkern/libkern/Block_private.h
@@ -433,6 +433,27 @@ _Block_set_invoke_fn(struct Block_layout *block, void (*fn)(void *, ...))
 	_Block_set_function_pointer(block->invoke, fn);
 }
 
+/*
+ * iceland (i67hid): this kernel is built by upstream clang, which does not
+ * sign block descriptors (no ptrauth_signed_block_descriptors), while the
+ * Apple kexts of the boot collection (Apple clang, arm64e) do: DA key,
+ * discriminator blend(&block->descriptor, 0xC0BB), as Apple's own
+ * _Block_copy authenticates it. A stack block made by IOHIDFamily reached
+ * this kernel's _Block_copy through OSAction::SetAbortedHandler and its
+ * signed descriptor was dereferenced as is (l7bt2 data abort). So: a
+ * descriptor that carries PAC bits is authenticated (and a forged one still
+ * faults); an unsigned one, from this kernel's own blocks, is used as is,
+ * as before. _Block_descriptor_is_signed() tells the two apart.
+ */
+#if !__has_feature(ptrauth_signed_block_descriptors) && __has_feature(ptrauth_calls)
+#define BLOCK_MIXED_DESCRIPTOR_SIGNING 1
+static inline int
+_Block_descriptor_is_signed(void *desc)
+{
+	return desc != ptrauth_strip(desc, ptrauth_key_asda);
+}
+#endif
+
