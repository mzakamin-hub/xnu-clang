+unsigned long long
+hakios_iceland_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000ull;
+}
+
+/*
+ * The HOST_CAP DDR range (W1.1) and the W1.4 guard: the loader's whole low-DMA window (lowdma= / lowdma_mb=, the same
+ * boot args harvest.c's arenas are carved from; else 0xf4800000 + 128 MB, ending at the framebuffer 0xfc800000), as
+ * Peach declares one window covering all its DMA. 46cn3h declared only the 52 MB arena: the firmware accepted HOST_CAP
+ * and faulted 152 ms after RESPOND_MEM; the arena alone leaves out the MSI sink (0xf4cf0000), the BHIe arena
+ * (0xf5000000) and the RDDM arena (0xf9400000+), all of which the chip is told about. (46cn3i)
+ */
+void
+hakios_iceland_ddr(unsigned long long *start, unsigned long long *size)
+{
+	static uint64_t lo, n;
+
+	if (n == 0) {
+		uint64_t low = 0, mb = 0;
+		const char *from = "lowdma= / lowdma_mb=";
+
+		if (!PE_parse_boot_argn("lowdma", &low, sizeof(low)) || !PE_parse_boot_argn("lowdma_mb", &mb, sizeof(mb)) ||
+		    low == 0 || mb < 64 || low + (mb << 20) > 0x100000000ULL) {
+			low = 0xf4800000ull;
+			mb = 128;
+			from = "fallback constants";
+		}
+		lo = low;
+		n = mb << 20;
+		printf("icepcie: ath12k: 46cn3i DDR range (HOST_CAP 0x1F, W1.4 guard): %#llx + %#llx (%llu MB, %s); arena %#llx + %#x\n",
+		    lo, n, n >> 20, from, iceland_ath12k_dma_pa, iceland_ath12k_dma_size);
+	}
+	*start = lo;
+	*size = n;
+}
+
+/*
+ * 46cn3j..m (scan231): what W1.1's HOST_CAP carries, so one kernel separates the causes. 46cn3h / 46cn3i (W1.1 on,
+ * range = arena / low-DMA window) faulted 152 ms after RESPOND_MEM, where the first-boot calibration starts; with W1.1
+ * off (46cn3g) the calibration passed.
+ *   dadawifi_ddr=N (default 2): the DDR range TLV 0x1F: 0 none, 1 the 52 MB arena, 2 the low-DMA window (as scan230),
+ *                               3 0 + 4 GB, 4 0xf0000000 + 256 MB
+ *   dadawifi_hc=MASK (default 0): W1.1 fields back to Linux's: 1 MLO fields, 2 on-demand, 4 nm_modem/cstate,
+ *                                 8 mem_cfg_mode, 16 M3 cache
+ * Returns the hc mask; *size 0 = no 0x1F TLV. The W1.4 guard keeps the low-DMA window (hakios_iceland_ddr).
+ */
+unsigned int hakios_iceland_hostcap(unsigned long long *start, unsigned long long *size);
+
+unsigned int
+hakios_iceland_hostcap(unsigned long long *start, unsigned long long *size)
+{
+	static uint32_t ddr = 0xffffffffu, hc;
+	static unsigned long long s, n;
+
+	if (ddr == 0xffffffffu) {
+		uint32_t d = 2;
+
+		(void)PE_parse_boot_argn("dadawifi_ddr", &d, sizeof(d));
+		(void)PE_parse_boot_argn("dadawifi_hc", &hc, sizeof(hc));
+		hc &= 0x1f;
+		ddr = d;
+		switch (d) {
+		case 0:
+			s = 0; n = 0;
+			break;
+		case 1:
+			s = iceland_ath12k_dma_pa; n = iceland_ath12k_dma_size;
+			break;
+		case 3:
+			s = 0; n = 0x100000000ull;
+			break;
+		case 4:
+			s = 0xf0000000ull; n = 0x10000000ull;
+			break;
+		default:
+			ddr = 2;
+			hakios_iceland_ddr(&s, &n);
+			break;
+		}
+		printf("icepcie: ath12k: 46cn3j HOST_CAP: dadawifi_ddr %u (0x1F %s %#llx + %#llx), dadawifi_hc %#x (as Linux: mlo %u, "
+		    "on-demand %u, nm_modem %u, mem_cfg_mode %u, m3 cache %u)\n", ddr, n ? "range" : "NOT SENT", s, n, hc, hc & 1,
+		    (hc >> 1) & 1, (hc >> 2) & 1, (hc >> 3) & 1, (hc >> 4) & 1);
+	}
+	*start = s;
+	*size = n;
+	return hc;
+}
+
+/* ---- the DMA heap: a first-fit free-list over the exported arena. dma_free returns blocks, so the ath12k
+ * calibration power-down/up (which frees the image + QMI segments and re-allocates them) does not run the 32 MB
+ * arena out the way the bump-only first version did ("MHI did not load image over BHI, ret: -12"). ---- */
+#define LX_DMA_FREE_MAX 2048       /* 46cn4e: 128-byte blocks fragment more than 4 KB pages */
+static uint32_t lx_dma_used;
+static uint64_t om_dma_out_first;      /* 46cn4e: the first DMA out (ms) */
+
+/* 46cn4f: the alignment (and length step) of blocks under 64 KB; default 4096 as Linux's coherent allocations */
+static uint32_t
+om_small_align(void)
+{
+	static uint32_t a;
+
+	if (a == 0) {
+		uint32_t v = 4096;
+
+		(void)PE_parse_boot_argn("dadawifi_small_align", &v, sizeof(v));
+		if (v < 128 || v > 4096 || (v & (v - 1))) {
+			v = 4096;
+		}
+		a = v;
+		printf("icepcie: ath12k: 46cn4f DMA blocks under 64 KB aligned to %u B (dadawifi_small_align; 4096 = Linux "
+		    "coherent pages)\n", a);
+	}
+	return a;
+}
+static uint32_t om_dma_lost;
+static struct {
+	uint32_t off, len;
+} lx_freelist[LX_DMA_FREE_MAX];
+static int lx_dma_free_n;
+
+static void *
+lx_dma_alloc0(size_t n, uint64_t *bus)
+{
+	uint32_t a = 0x1000, off, len;
+	int i;
+	static uint32_t align_mode = 0xffffffffu;
+
+	/*
+	 * 46cn3n: dadawifi_align=1 (default) aligns every block to its size rounded up to a power of two, with no cap, as
+	 * Linux's dma_alloc_coherent does (Fedora's capture: the 7405568 B segment at 0xfa000000, the 4145152 B one at
+	 * 0xf9c00000) and as Peach does (the Q6 maps host memory with large pages). dadawifi_align=0: the old 2 MB cap.
+	 */
+	if (align_mode == 0xffffffffu) {
+		align_mode = 1;
+		(void)PE_parse_boot_argn("dadawifi_align", &align_mode, sizeof(align_mode));
+		printf("icepcie: ath12k: 46cn3n DMA alignment: %s (dadawifi_align=%u)\n",
+		    align_mode ? "size rounded up to a power of two, no cap (as Linux)" : "capped at 2 MB", align_mode);
+	}
+	if (n < 0x10000) {
+		/* 46cn4f: small blocks page aligned by default (46cn4e's 128 B broke the DP SPT pages) */
+		a = om_small_align();
+		len = (uint32_t)((n + a - 1) & ~(size_t)(a - 1));
+	} else {
+		while (a < n && (align_mode || a < (2u << 20)) && a < (1u << 30)) {
+			a <<= 1;
+		}
+		len = (uint32_t)((n + 0xfffu) & ~0xfffu);
+	}
+	if (iceland_ath12k_dma_va == 0 || n == 0) {
+		return NULL;
+	}
+	for (i = 0; i < lx_dma_free_n; i++) {
+		uint32_t foff = (lx_freelist[i].off + a - 1) & ~(a - 1);
+		uint32_t fend = lx_freelist[i].off + lx_freelist[i].len;
+
+		if (foff + len > fend) {
+			continue;
+		}
+		off = foff;
+		if (foff + len == fend) {
+			lx_freelist[i] = lx_freelist[--lx_dma_free_n];
+		} else if (foff == lx_freelist[i].off) {
+			lx_freelist[i].off += len;
+			lx_freelist[i].len -= len;
+		} else {
+			lx_freelist[i].len = foff - lx_freelist[i].off;
+			if (lx_dma_free_n < LX_DMA_FREE_MAX) {
+				lx_freelist[lx_dma_free_n].off = foff + len;
+				lx_freelist[lx_dma_free_n].len = fend - (foff + len);
+				lx_dma_free_n++;
+			}
+		}
+		bzero((void *)(iceland_ath12k_dma_va + off), n);
+		if (bus != NULL) {
+			*bus = iceland_ath12k_dma_pa + off;
+		}
+		if (n >= (1u << 20)) {
+			printf("icepcie: ath12k: 46cn3n DMA %zu B (align %#x) at %#llx from the free list\n", n, a,
+			    iceland_ath12k_dma_pa + off);
+		}
+		return (void *)(iceland_ath12k_dma_va + off);
+	}
+	off = (lx_dma_used + a - 1) & ~(a - 1);
+	if (off > iceland_ath12k_dma_size || len > iceland_ath12k_dma_size - off) {
+		uint32_t freeb = 0;
+		for (i = 0; i < lx_dma_free_n; i++) {
+			freeb += lx_freelist[i].len;
+		}
+		{
+			/* 46cn4e: at most one line a second, with the count; the first one asks for the live map */
+			static uint64_t last_ms;
+			static uint32_t since;
+			uint64_t t = lx_now_ms();
+
+			since++;
+			if (om_dma_out_first == 0) {
+				om_dma_out_first = t ? t : 1;
+			}
+			if (t - last_ms >= 1000) {
+				printf("icepcie: ath12k: DMA out: want %zu (align %#x), used %u of %u, free-list %d blocks / %u B (%u refusals "
+				    "since the last line)\n", n, a, lx_dma_used, iceland_ath12k_dma_size, lx_dma_free_n, freeb, since);
+				last_ms = t;
+				since = 0;
+			}
+		}
+		return NULL;
+	}
+	if (off > lx_dma_used && off <= iceland_ath12k_dma_size && lx_dma_free_n < LX_DMA_FREE_MAX) {
+		/* 46cn3n: the alignment gap is not lost: smaller blocks take it from the free list */
+		lx_freelist[lx_dma_free_n].off = lx_dma_used;
+		lx_freelist[lx_dma_free_n].len = off - lx_dma_used;
+		lx_dma_free_n++;
+	}
+	lx_dma_used = off + len;
+	if (n >= (1u << 20)) {
+		printf("icepcie: ath12k: 46cn3n DMA %zu B (align %#x) at %#llx; arena used %u of %u\n", n, a,
+		    iceland_ath12k_dma_pa + off, lx_dma_used, iceland_ath12k_dma_size);
+	}
+	bzero((void *)(iceland_ath12k_dma_va + off), n);
+	if (bus != NULL) {
+		*bus = iceland_ath12k_dma_pa + off;
+	}
+	return (void *)(iceland_ath12k_dma_va + off);
+}
+
+static void
+lx_dma_free0(size_t n, void *p, uint64_t bus)
+{
+	uint32_t off, len;
+	int i, j;
+
+	(void)bus;
+	if (p == NULL || iceland_ath12k_dma_va == 0 || n == 0) {
+		return;
+	}
+	off = (uint32_t)((vm_offset_t)p - iceland_ath12k_dma_va);
+	len = (uint32_t)n;      /* 46cn4e: the exact block length, from the live table (lx_dma_free) */
+	if (off >= iceland_ath12k_dma_size || off + len > iceland_ath12k_dma_size) {
+		return;
+	}
+	for (i = 0; i < lx_dma_free_n; i++) {
+		if (lx_freelist[i].off + lx_freelist[i].len == off) {  /* merge with the block before */
+			lx_freelist[i].len += len;
+			for (j = 0; j < lx_dma_free_n; j++) {
+				if (j != i && lx_freelist[j].off == lx_freelist[i].off + lx_freelist[i].len) {
+					lx_freelist[i].len += lx_freelist[j].len;  /* and the block after */
+					lx_freelist[j] = lx_freelist[--lx_dma_free_n];
+					break;
+				}
+			}
+			return;
+		}
+		if (off + len == lx_freelist[i].off) {  /* merge with the block after */
+			lx_freelist[i].off = off;
+			lx_freelist[i].len += len;
+			return;
+		}
+	}
+	if (lx_dma_free_n < LX_DMA_FREE_MAX) {
+		lx_freelist[lx_dma_free_n].off = off;
+		lx_freelist[lx_dma_free_n].len = len;
+		lx_dma_free_n++;
+	} else {
+		om_dma_lost += len;     /* 46cn4e: a full free list loses the block (counted) */
+	}
+}
+
+/*
+ * 46cn4a G2 / 46cn4e: the live blocks in an open-addressed table (offset -> exact length, caller tag). THE LEAK (46cn4a:
+ * "DMA out" from 162 s): the runtime frees skb data and QRTR buffers with a size of 0 (nw_net.c kfree_skb, lx_dma_kfree,
+ * nw_qrtr_mhi.c) and lx_dma_free0 returned early on n == 0, so every received frame's buffer stayed allocated. The size
+ * now comes from this table.
+ */
+#define OM_H 32768u
+#if defined(XNU_TARGET_OS_OSX)
+/* (macOS: the collection's __DATA has no room; allocated when the driver starts, iceland_ath12k_driver()) */
+static struct om_ent { uint32_t key, len; uint16_t tag; } *om_h;
+#else
+static struct { uint32_t key, len; uint16_t tag; } om_h[OM_H];        /* key = offset + 1; 0 = empty */
+#endif
+static uint32_t om_live_n, om_untracked, om_free_unknown, om_allocs, om_frees;
+static uintptr_t om_tag_pc[16];
+static uint32_t om_tag_allocs[16];
+
+static uint32_t
+om_hix(uint32_t off)
+{
+	return ((off >> 7) * 2654435761u) >> 17;
+}
+
+static void
+om_put(uint32_t off, uint32_t len, uint16_t tag)
+{
+	uint32_t i = om_hix(off);
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (om_h == NULL) {
+		om_untracked++;
+		return;
+	}
+#endif
+
+	if (om_live_n >= OM_H - OM_H / 8) {
+		om_untracked++;
+		return;
+	}
+	while (om_h[i].key) {
+		i = (i + 1) & (OM_H - 1);
+	}
+	om_h[i].key = off + 1;
+	om_h[i].len = len;
+	om_h[i].tag = tag;
+	om_live_n++;
+}
+
+static bool
+om_take(uint32_t off, uint32_t *len)
+{
+	uint32_t i = om_hix(off), j, k;
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (om_h == NULL) {
+		return false;
+	}
+#endif
+
+	while (om_h[i].key) {
+		if (om_h[i].key == off + 1) {
+			*len = om_h[i].len;
+			om_h[i].key = 0;
+			om_live_n--;
+			/* backward-shift deletion (linear probing) */
+			for (j = (i + 1) & (OM_H - 1); om_h[j].key; j = (j + 1) & (OM_H - 1)) {
+				k = om_hix(om_h[j].key - 1);
+				if ((j > i && (k <= i || k > j)) || (j < i && (k <= i && k > j))) {
+					om_h[i] = om_h[j];
+					om_h[j].key = 0;
+					i = j;
+				}
+			}
+			return true;
+		}
+		i = (i + 1) & (OM_H - 1);
+	}
+	return false;
+}
+
+static uint16_t
+om_tag(uintptr_t pc)
+{
+	for (uint16_t t = 0; t < 15; t++) {
+		if (om_tag_pc[t] == pc || om_tag_pc[t] == 0) {
+			om_tag_pc[t] = pc;
+			om_tag_allocs[t]++;
+			return t;
+		}
+	}
+	om_tag_allocs[15]++;
+	return 15;
+}
+
+static void *
+lx_dma_alloc(size_t n, uint64_t *bus)
+{
+	void *p = lx_dma_alloc0(n, bus);
+
+	if (p != NULL) {
+		uint32_t sa = om_small_align();
+		uint32_t len = n < 0x10000 ? (uint32_t)((n + sa - 1) & ~(size_t)(sa - 1)) : (uint32_t)((n + 0xfffu) & ~0xfffu);
+
+		om_put((uint32_t)((vm_offset_t)p - iceland_ath12k_dma_va), len, om_tag((uintptr_t)__builtin_return_address(0)));
+		om_allocs++;
+	}
+	return p;
+}
+
+static void
+lx_dma_free(size_t n, void *p, uint64_t bus)
+{
+	uint32_t len = 0;
+
+	if (p == NULL || iceland_ath12k_dma_va == 0) {
+		return;
+	}
+	if (!om_take((uint32_t)((vm_offset_t)p - iceland_ath12k_dma_va), &len)) {
+		om_free_unknown++;      /* not a block of ours (or untracked): left alone */
+		return;
+	}
+	(void)n;
+	om_frees++;
+	lx_dma_free0(len, p, bus);
+}
+
+/* the live blocks sorted and merged (adjacent runs), at most 80 lines + the overlap check */
+#if defined(XNU_TARGET_OS_OSX)
+static struct om_srt { uint32_t off, len; } *om_sorted;
+#else
+static struct { uint32_t off, len; } om_sorted[OM_H];
+#endif
+
+static void
+om_arena_map_why(const char *why)
+{
+	uint32_t n = 0, runs = 0, overlaps = 0, shown = 0;
+	uint64_t total = 0;
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (om_h == NULL || om_sorted == NULL) {
+		return;
+	}
+#endif
+	for (uint32_t i = 0; i < OM_H; i++) {
+		if (om_h[i].key) {
+			om_sorted[n].off = om_h[i].key - 1;
+			om_sorted[n].len = om_h[i].len;
+			n++;
+		}
+	}
+	for (uint32_t gap = n / 2; gap > 0; gap /= 2) {       /* shell sort by offset */
+		for (uint32_t i = gap; i < n; i++) {
+			uint32_t o = om_sorted[i].off, l = om_sorted[i].len, j = i;
+
+			for (; j >= gap && om_sorted[j - gap].off > o; j -= gap) {
+				om_sorted[j] = om_sorted[j - gap];
+			}
+			om_sorted[j].off = o;
+			om_sorted[j].len = l;
+		}
+	}
+	for (uint32_t i = 0; i < n;) {
+		uint32_t o = om_sorted[i].off, e = o + om_sorted[i].len, cnt = 1;
+
+		for (i++; i < n && om_sorted[i].off <= e; i++) {
+			if (om_sorted[i].off < e) {
+				overlaps++;
+			}
+			if (om_sorted[i].off + om_sorted[i].len > e) {
+				e = om_sorted[i].off + om_sorted[i].len;
+			}
+			cnt++;
+		}
+		total += e - o;
+		runs++;
+		if (shown < 80) {
+			printf("icepcie: ath12k: 46cn4e DMA map (%s): %#llx + %#x (%u blocks)\n", why, iceland_ath12k_dma_pa + o, e - o, cnt);
+			shown++;
+		}
+	}
+	printf("icepcie: ath12k: 46cn4e DMA map (%s): %u live blocks in %u runs (%u shown), %llu B, %u OVERLAPS; high-water %u of "
+	    "%u B; free list %d blocks; lost %u B; untracked %u, unknown frees %u\n", why, n, runs, shown, total, overlaps,
+	    lx_dma_used, iceland_ath12k_dma_size, lx_dma_free_n, om_dma_lost, om_untracked, om_free_unknown);
+}
+
+static void
+om_arena_map(void)
+{
+	om_arena_map_why("after WMI READY");
+}
+
+/* every 10 s: live blocks by size class and by caller, allocs / frees since the last line */
+static void
+om_dma_stats(void)
+{
+	static uint32_t la, lf, ltag[16];
+	uint32_t cls[4] = { 0 }, tl[16] = { 0 };
+	uint64_t live = 0, freeb = 0;
+	char b[400];
+	int o;
+
+	for (uint32_t i = 0; i < OM_H; i++) {
+		if (om_h[i].key) {
+			uint32_t l = om_h[i].len;
+
+			live += l;
+			cls[l <= 4096 ? 0 : l <= 65536 ? 1 : l <= (1u << 20) ? 2 : 3]++;
+			tl[om_h[i].tag]++;
+		}
+	}
+	for (int i = 0; i < lx_dma_free_n; i++) {
+		freeb += lx_freelist[i].len;
+	}
+	printf("icepcie: ath12k: 46cn4e 10s DMA: live %u blocks / %llu B (<=4K %u, <=64K %u, <=1M %u, >1M %u); high-water %u of %u; "
+	    "free list %d / %llu B; allocs %u frees %u since the last line; lost %u B, untracked %u, unknown frees %u\n", om_live_n,
+	    live, cls[0], cls[1], cls[2], cls[3], lx_dma_used, iceland_ath12k_dma_size, lx_dma_free_n, freeb, om_allocs - la,
+	    om_frees - lf, om_dma_lost, om_untracked, om_free_unknown);
+	la = om_allocs;
+	lf = om_frees;
+	o = snprintf(b, sizeof(b), "live blocks by caller (pc - &nw_wifi_step, live / allocs since):");
+	for (int t = 0; t < 16 && o < (int)sizeof(b) - 40; t++) {
+		if (om_tag_pc[t] || (t == 15 && om_tag_allocs[15])) {
+			o += snprintf(b + o, sizeof(b) - o, " %s%#lx %u/%u", t == 15 ? "other " : "",
+			    t == 15 ? 0ul : (unsigned long)(om_tag_pc[t] - (uintptr_t)nw_wifi_step), tl[t], om_tag_allocs[t] - ltag[t]);
+			ltag[t] = om_tag_allocs[t];
+		}
+	}
+	printf("icepcie: ath12k: 46cn4e 10s DMA %s\n", b);
+}
+
+static uint64_t
+lx_dma_map(void *p, size_t n __unused, int dir __unused)
+{
+	if ((vm_offset_t)p < iceland_ath12k_dma_va ||
+	    (vm_offset_t)p >= iceland_ath12k_dma_va + iceland_ath12k_dma_size) {
+		static uint32_t refused;
+
+		if (refused++ < 8) {    /* 46cn3a W1.4: an address outside the arena is refused, and now said */
+			printf("icepcie: ath12k: 46cn3a W1.4 dma_map refused %p (+%zu B): outside the DMA arena (%u so far)\n",
+			    p, n, refused);
+		}
+		return 0;               /* only memory already in the window is reachable */
+	}
+	return iceland_ath12k_dma_pa + (uint64_t)((vm_offset_t)p - iceland_ath12k_dma_va);
+}
+
+static void
+lx_dma_sync(uint64_t bus __unused, size_t n __unused, int dir __unused)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * ---- 46cn3p (kernel scan233, 7 Nov 2026): dadawifi_pcie=MASK - Fedora's PCIe link settings, one bit each ----
+ * 46cn3n: QMI HOST_CAP / WLAN_CFG / IND_REGISTER byte-identical to Fedora's, yet the firmware still faults (MHI SYS_ERR,
+ * EE 3) ~55 ms after the first HTC CONNECT on CE0. Below QMI only the PCIe settings still differ from Fedora (lspci on
+ * this tablet, wifi-k1/fedcap/wificap-20261106-230312): Fedora has on BOTH ends LnkCtl ASPM L0s+L1 + CommClk, DevCtl
+ * MRRS 512 + the four error-reporting enables, DevCtl2 LTR, the L1SS enables with LTR_L1.2_THRESHOLD 156672 ns and
+ * T_PwrOn 80 us, and runs x1 (the device narrowed the link itself). Default 0 = as before (nothing written).
+ * Applied at link-up (in iceland_ath12k_driver before nw_wifi_start: Linux sets them at enumeration, before ath12k
+ * probes), in Linux's enumeration order 4, 2, 1, 16, 32; bit 8 when the driver restores ASPM (ath12k_pci_start ->
+ * ath12k_pci_aspm_restore = the driver's 2nd LnkCtl write, right before the HTC connects):
+ *   0x01 Common Clock Configuration (LnkCtl bit 6), endpoint then root port (pcie_aspm_configure_common_clock), then a
+ *        link retrain (root port LnkCtl bit 5; Link Training clear awaited up to 1 s before and after, DLLLA, LnkSta
+ *        logged). Link not back -> the driver is NOT started.
+ *   0x02 the endpoint's LTR max snoop / no-snoop latency = Fedora's (LTR cap +4 = 0x00000000), then DevCtl2 LTR
+ *        Mechanism Enable (bit 10) root port, then endpoint (pci_configure_ltr); refused unless both DevCap2 say LTR.
+ *   0x04 DevCtl as Fedora: MRRS 512 (bits 14:12 = 2) + CorrErr / NonFatal / Fatal / UnsupReq reporting (bits 3:0),
+ *        root port then endpoint; MPS (bits 7:5) and every other bit as found.
+ *   0x08 ASPM L0s + L1 (LnkCtl bits 1:0 = 3) at the driver's ASPM restore: the root port first, then the endpoint (the
+ *        driver's own write with the two bits added) - Linux enables upstream first.
+ *   0x10 L1 PM substates as Fedora: any enable set is cleared first (endpoint, root port); T_POWER_ON ctl2 0x41 (80 us)
+ *        root port then endpoint; root port ctl1 CM restore 70 us + LTR_L1.2_THRESHOLD 0x4099 (156672 ns), endpoint
+ *        ctl1 the threshold; then the four enables root port then endpoint (final rp 0x4099460f, ep 0x4099000f).
+ *   0x20 LnkCtl Hardware Autonomous Width Disable (bit 9) cleared on both ends if set, and both LnkSta logged every 5 s
+ *        for 60 s from link-up (does the link narrow to x1 as on Fedora?).
+ * Every write is logged with the value before and its read-back, and both ends' state before / after. No undo: the
+ * loader's reset at ~300 s and Fedora's enumeration rewrite all of it.
+ */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+#define ICE_RP_DBI_PA   0x40000000u     /* the root port's DBI = its config space (harvest.c's e2_dbi mapping) */
+#define ICE_EP_ID       0x110e17cbu
+#define ICE_L1SS_CTL2   0x00000041u     /* T_POWER_ON 80 us: scale 1 (10 us), value 8 */
+#define ICE_L1SS_THR    0x40990000u     /* LTR_L1.2_THRESHOLD 156672 ns: scale 2 (1024 ns), value 153 */
+#define ICE_L1SS_CM     70u             /* the root port's Common_Mode_Restore_Time, us */
+#define ICE_LTR_FEDORA  0x00000000u     /* Fedora's endpoint LTR cap +4 (max snoop 0 ns, max no-snoop 0 ns) */
+static uint32_t ice_pcie;
+static vm_offset_t ice_rp;
+static uint32_t ice_xe, ice_xr, ice_l1e, ice_l1r, ice_ltre, ice_lnk_writes;
+
+static inline uint32_t
+ice_rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static void
+ice_wr(vm_offset_t b, const char *who, const char *what, uint32_t o, uint32_t v)
+{
+	uint32_t was = ice_rd(b, o);
+
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("icepcie: ath12k: 46cn3p pcie write %s %s +%#x: %08x -> %08x, read back %08x\n", who, what, o, was, v,
+	    ice_rd(b, o));
+}
+
+/* standard capability (0 = none), bounded to the 256-byte header and aligned (device memory) */
+static uint32_t
+ice_cap(vm_offset_t b, uint32_t id)
+{
+	uint32_t p = ice_rd(b, 0x34) & 0xfc;
+
+	for (int i = 0; p >= 0x40 && p <= 0xfc && i < 48; i++) {
+		uint32_t h = ice_rd(b, p);
+
+		if (h == 0xffffffffu) {
+			return 0;
+		}
+		if ((h & 0xff) == id) {
+			return p;
+		}
+		p = (h >> 8) & 0xfc;
+	}
+	return 0;
+}
+
+/* extended capability (0x100 on, below 0x1000) */
+static uint32_t
+ice_extcap(vm_offset_t b, uint32_t id)
+{
+	uint32_t x = 0x100;
+
+	for (int i = 0; x >= 0x100 && x <= 0xffc && i < 64; i++) {
+		uint32_t h = ice_rd(b, x);
+
+		if (h == 0 || h == 0xffffffffu) {
+			return 0;
+		}
+		if ((h & 0xffff) == id) {
+			return x;
+		}
+		x = (h >> 20) & 0xffc;
+	}
+	return 0;
+}
+
+static void
+ice_pcie_end(const char *when, const char *who, vm_offset_t b, uint32_t x, uint32_t l1, uint32_t ltr)
+{
+	uint32_t l = x ? ice_rd(b, x + 0x10) : 0;
+
+	printf("icepcie: ath12k: 46cn3p pcie %s %s: DevCtl/Sta %08x LnkCtl %04x (ASPM %u CCC %u HAWD %u) LnkSta %04x (speed %u "
+	    "width x%u training %u DLLLA %u ABWMgmt %u) DevCtl2 %08x L1SS ctl1 %08x ctl2 %08x LTR %08x\n", when, who,
+	    x ? ice_rd(b, x + 8) : 0, l & 0xffff, l & 3, (l >> 6) & 1, (l >> 9) & 1, l >> 16, (l >> 16) & 0xf, (l >> 20) & 0x3f,
+	    (l >> 27) & 1, (l >> 29) & 1, (l >> 31) & 1, x ? ice_rd(b, x + 0x28) : 0, l1 ? ice_rd(b, l1 + 8) : 0,
+	    l1 ? ice_rd(b, l1 + 0xc) : 0, ltr ? ice_rd(b, ltr + 4) : 0);
+}
+
+static void
+ice_pcie_state(const char *when)
+{
+	ice_pcie_end(when, "endpoint", iceland_ath12k_conf, ice_xe, ice_l1e, ice_ltre);
+	ice_pcie_end(when, "root port", ice_rp, ice_xr, ice_l1r, 0);
+}
+
+/* 0x20: both ends' link width every 5 s for 60 s (reads only; an all-ones endpoint = its config access dropped) */
+static void
+ice_pcie_watch(void)
+{
+	for (int i = 1; i <= 12; i++) {
+		uint32_t r, e;
+
+		IOSleep(5000);
+		r = ice_rd(ice_rp, ice_xr + 0x10) >> 16;
+		e = ice_rd(iceland_ath12k_conf, ice_xe + 0x10);
+		printf("icepcie: ath12k: 46cn3p pcie width watch +%d s: root port LnkSta %04x (speed %u width x%u DLLLA %u ABWMgmt "
+		    "%u) LTSSM %02x; endpoint LnkSta %04x (width x%u)%s\n", 5 * i, r, r & 0xf, (r >> 4) & 0x3f, (r >> 13) & 1,
+		    (r >> 15) & 1, ice_rd(ice_rp, 0x728) & 0x3f, e >> 16, (e >> 20) & 0x3f,
+		    e == 0xffffffffu ? " (endpoint config space all-ones)" : "");
+	}
+}
+
+/* at link-up, before nw_wifi_start; false = the link did not come back from 0x01's retrain (driver not started) */
+static bool
+ice_pcie_linkup(void)
+{
+	vm_offset_t ep = iceland_ath12k_conf, rp;
+	uint32_t a, b;
+	int i;
+
+#if defined(XNU_TARGET_OS_OSX)
+	ice_pcie = 0x27;        /* macOS: the default is the last scan-reaching run's dadawifi_pcie=39 (runs/p4-1) */
+#endif
+	(void)PE_parse_boot_argn("dadawifi_pcie", &ice_pcie, sizeof(ice_pcie));
+	ice_pcie &= 0x3fu;
+	if (ice_pcie == 0) {
+		printf("icepcie: ath12k: 46cn3p dadawifi_pcie 0: PCIe link settings as before (nothing written)\n");
+		return true;
+	}
+	rp = ice_rp = ml_io_map_unmappable(ICE_RP_DBI_PA, 0x2000, VM_WIMG_IO);
+	ice_xe = ice_cap(ep, 0x10);
+	ice_l1e = ice_extcap(ep, 0x1e);
+	ice_ltre = ice_extcap(ep, 0x18);
+	if (rp != 0) {
+		ice_xr = ice_cap(rp, 0x10);
+		ice_l1r = ice_extcap(rp, 0x1e);
+	}
+	printf("icepcie: ath12k: 46cn3p dadawifi_pcie %#x: 1 common clock + retrain %u, 2 LTR %u, 4 DevCtl %u, 8 ASPM at hif start "
+	    "%u, 16 L1SS %u, 32 width %u; endpoint %08x express +%#x L1SS +%#x LTR +%#x; root port %08x class %08x express "
+	    "+%#x L1SS +%#x\n", ice_pcie, ice_pcie & 1, (ice_pcie >> 1) & 1, (ice_pcie >> 2) & 1, (ice_pcie >> 3) & 1,
+	    (ice_pcie >> 4) & 1, (ice_pcie >> 5) & 1, ice_rd(ep, 0), ice_xe, ice_l1e, ice_ltre, rp ? ice_rd(rp, 0) : 0,
+	    rp ? ice_rd(rp, 8) : 0, ice_xr, ice_l1r);
+	/*
+	 * 46cn3t (scan234): the Qualcomm DWC root port's class reads 0xff00 under XNU (46cn3p: class ff000000) - Linux's
+	 * qcom PCIe driver reprograms it to 0x0604 at init, we never do (and do not write it here): accept either
+	 */
+	if (rp == 0 || (ice_rd(rp, 0) & 0xffff) != 0x17cb ||
+	    ((ice_rd(rp, 8) >> 16) != 0x0604 && (ice_rd(rp, 8) >> 16) != 0xff00) || ice_rd(ep, 0) != ICE_EP_ID ||
+	    ice_xe == 0 || ice_xr == 0) {
+		printf("icepcie: ath12k: 46cn3p pcie REFUSED: root port mapping / ids (class 0x0604 or 0xff00) / express "
+		    "capabilities not as expected: nothing written\n");
+		ice_pcie = 0;
+		return true;
+	}
+	ice_pcie_state("before (link-up)");
+	if (ice_pcie & 4) {
+		a = ice_rd(rp, ice_xr + 8) & 0xffff;
+		ice_wr(rp, "root port", "DevCtl (MRRS 512 + error reporting)", ice_xr + 8, (a & ~0x7000u) | 0x2000u | 0xfu);
+		b = ice_rd(ep, ice_xe + 8) & 0xffff;
+		ice_wr(ep, "endpoint", "DevCtl (MRRS 512 + error reporting)", ice_xe + 8, (b & ~0x7000u) | 0x2000u | 0xfu);
+	}
+	if (ice_pcie & 2) {
+		if (!((ice_rd(ep, ice_xe + 0x24) >> 11) & 1) || !((ice_rd(rp, ice_xr + 0x24) >> 11) & 1)) {
+			printf("icepcie: ath12k: 46cn3p pcie 0x02 REFUSED: DevCap2 LTR not supported on both (endpoint %08x root port "
+			    "%08x)\n", ice_rd(ep, ice_xe + 0x24), ice_rd(rp, ice_xr + 0x24));
+		} else {
+			if (ice_ltre != 0) {
+				ice_wr(ep, "endpoint", "LTR max snoop / no-snoop latency (Fedora's)", ice_ltre + 4, ICE_LTR_FEDORA);
+			}
+			ice_wr(rp, "root port", "DevCtl2 (LTR enable)", ice_xr + 0x28, (ice_rd(rp, ice_xr + 0x28) & 0xffff) | 1u << 10);
+			ice_wr(ep, "endpoint", "DevCtl2 (LTR enable)", ice_xe + 0x28, (ice_rd(ep, ice_xe + 0x28) & 0xffff) | 1u << 10);
+		}
+	}
+	if (ice_pcie & 1) {
+		uint32_t st = 0;
+
+		a = ice_rd(ep, ice_xe + 0x10) & 0xffff;
+		b = ice_rd(rp, ice_xr + 0x10) & 0xffff;
+		ice_wr(ep, "endpoint", "LnkCtl (Common Clock Configuration)", ice_xe + 0x10, a | 1u << 6);
+		ice_wr(rp, "root port", "LnkCtl (Common Clock Configuration)", ice_xr + 0x10, b | 1u << 6);
+		for (i = 0; i < 1000 && ((ice_rd(rp, ice_xr + 0x10) >> 27) & 1); i++) {
+			IOSleep(1);
+		}
+		ice_wr(rp, "root port", "LnkCtl (Retrain Link)", ice_xr + 0x10, b | 1u << 6 | 1u << 5);
+		for (i = 0; i < 1000; i++) {
+			IOSleep(1);
+			st = ice_rd(rp, ice_xr + 0x10) >> 16;
+			if (!((st >> 11) & 1) && ((st >> 13) & 1)) {
+				break;
+			}
+		}
+		printf("icepcie: ath12k: 46cn3p pcie retrain: root port LnkSta %04x after ~%d ms (speed %u, width x%u, training %u, "
+		    "DLLLA %u); endpoint id %08x\n", st, i, st & 0xf, (st >> 4) & 0x3f, (st >> 11) & 1, (st >> 13) & 1,
+		    ice_rd(ep, 0));
+		if (i >= 1000 || ice_rd(ep, 0) != ICE_EP_ID) {
+			printf("icepcie: ath12k: 46cn3p pcie LINK NOT BACK after the retrain: the driver is not started\n");
+			ice_pcie_state("link lost");
+			return false;
+		}
+	}
+	if (ice_pcie & 0x10) {
+		uint32_t ecap = ice_l1e ? ice_rd(ep, ice_l1e + 4) : 0, rcap = ice_l1r ? ice_rd(rp, ice_l1r + 4) : 0;
+
+		if (ice_l1e == 0 || ice_l1r == 0 || (ecap & rcap & 0x1f) != 0x1f) {
+			printf("icepcie: ath12k: 46cn3p pcie 0x10 REFUSED: L1SS endpoint +%#x cap %08x, root port +%#x cap %08x (need "
+			    "all four substates on both)\n", ice_l1e, ecap, ice_l1r, rcap);
+		} else {
+			a = ice_rd(ep, ice_l1e + 8);
+			b = ice_rd(rp, ice_l1r + 8);
+			if ((a | b) & 0xf) {
+				/* pcie_config_aspm_l1ss: enables off downstream first, then upstream, before reprogramming */
+				ice_wr(ep, "endpoint", "L1SS ctl1 (enables off first)", ice_l1e + 8, a & ~0xfu);
+				ice_wr(rp, "root port", "L1SS ctl1 (enables off first)", ice_l1r + 8, b & ~0xfu);
+			}
+			ice_wr(rp, "root port", "L1SS ctl2 (T_POWER_ON 80 us)", ice_l1r + 0xc,
+			    (ice_rd(rp, ice_l1r + 0xc) & ~0xfbu) | ICE_L1SS_CTL2);
+			ice_wr(ep, "endpoint", "L1SS ctl2 (T_POWER_ON 80 us)", ice_l1e + 0xc,
+			    (ice_rd(ep, ice_l1e + 0xc) & ~0xfbu) | ICE_L1SS_CTL2);
+			ice_wr(rp, "root port", "L1SS ctl1 (CM restore 70 us + LTR_L1.2_THRESHOLD 156672 ns)", ice_l1r + 8,
+			    (ice_rd(rp, ice_l1r + 8) & ~(0xfu | 0xffu << 8 | 0x3ffu << 16 | 7u << 29)) | ICE_L1SS_CM << 8 | ICE_L1SS_THR);
+			ice_wr(ep, "endpoint", "L1SS ctl1 (LTR_L1.2_THRESHOLD 156672 ns)", ice_l1e + 8,
+			    (ice_rd(ep, ice_l1e + 8) & ~(0xfu | 0x3ffu << 16 | 7u << 29)) | ICE_L1SS_THR);
+			ice_wr(rp, "root port", "L1SS ctl1 (enables PCI-PM L1.2 / L1.1, ASPM L1.2 / L1.1)", ice_l1r + 8,
+			    ice_rd(rp, ice_l1r + 8) | 0xfu);
+			ice_wr(ep, "endpoint", "L1SS ctl1 (enables PCI-PM L1.2 / L1.1, ASPM L1.2 / L1.1)", ice_l1e + 8,
+			    ice_rd(ep, ice_l1e + 8) | 0xfu);
+		}
+	}
+	if (ice_pcie & 0x20) {
+		thread_t t;
+
+		a = ice_rd(rp, ice_xr + 0x10) & 0xffff;
+		b = ice_rd(ep, ice_xe + 0x10) & 0xffff;
+		if (a & 1u << 9) {
+			ice_wr(rp, "root port", "LnkCtl (Hardware Autonomous Width Disable off)", ice_xr + 0x10, a & ~(1u << 9));
+		}
+		if (b & 1u << 9) {
+			ice_wr(ep, "endpoint", "LnkCtl (Hardware Autonomous Width Disable off)", ice_xe + 0x10, b & ~(1u << 9));
+		}
+		printf("icepcie: ath12k: 46cn3p pcie HAWD: root port LnkCtl %04x, endpoint LnkCtl %04x as found (bit 9 %s); width "
+		    "watch every 5 s for 60 s\n", a, b, ((a | b) >> 9) & 1 ? "was set: cleared" : "already clear on both");
+		if (kernel_thread_start((thread_continue_t)ice_pcie_watch, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+		}
+	}
+	ice_pcie_state("after (link-up)");
+	return true;
+}
+
+/*
+ * ---- 46cn3x (kernel scan235, 7 Nov 2026): dadawifi_cfgprobe=1 - READ-ONLY probe of the endpoint's config access ----
+ * 46cn3t: at hif start the endpoint's config space reads all-ones while the root port reads fine; at the driver's
+ * aspm_disable (power-up) it still read. Default 0 = nothing. With 1, reads only:
+ *  1. a sampler thread from link-up until 2 s after the first MHI SYS_ERR (MHISTATUS bit 2; at most until 280 s), every
+ *     ~1 ms (IOSleep(1), its own thread, so the driver's pump is not touched): EP config dword 0 (the normal config
+ *     path), RP DevSta, RP Type-1 status (0x04 high), RP secondary status (0x1c high), RP LnkSta, RP 0x728 (LTSSM),
+ *     RP AER uncorrectable / correctable / root error status, iATU region 0 CTRL1 / CTRL2 (the config window), EP
+ *     MHISTATUS + EXECENV via BAR0. A line on every change (us timestamp) + a heartbeat every 100 ms; the driver's own
+ *     lines (QMIDUMP ids, MHI state changes) interleave with the same kernel timestamps.
+ *  2. all 8 unrolled iATU regions (ATU = DBI + 0x1000, PARF ATU base 0x40001000; per region outbound +0x0..+0x20,
+ *     inbound +0x100..+0x120) at link-up, on every EXECENV change (mission mode), at hif start, at the first SYS_ERR and
+ *     at the end.
+ *  3. once: the config path (the mapping VA, PA 0x40100000, iATU region 0 as found).
+ */
+#define ICE_ATU         0x1000u         /* the unrolled iATU inside the DBI mapping (harvest.c: atu = dbi + 0x1000) */
+static uint32_t ice_cfgprobe;
+static volatile int ice_probe_hif_seen;
+
+static void
+ice_probe_iatu(const char *when)
+{
+	for (uint32_t r = 0; r < 8; r++) {
+		vm_offset_t o = ice_rp + ICE_ATU + r * 0x200, in = o + 0x100;
+
+		printf("icepcie: ath12k: 46cn3x iatu %s region %u: out ctrl1 %08x ctrl2 %08x base %08x_%08x limit %08x_%08x target "
+		    "%08x_%08x | in ctrl1 %08x ctrl2 %08x base %08x_%08x limit %08x target %08x_%08x\n", when, r, ice_rd(o, 0),
+		    ice_rd(o, 4), ice_rd(o, 0xc), ice_rd(o, 8), ice_rd(o, 0x20), ice_rd(o, 0x10), ice_rd(o, 0x18), ice_rd(o, 0x14),
+		    ice_rd(in, 0), ice_rd(in, 4), ice_rd(in, 0xc), ice_rd(in, 8), ice_rd(in, 0x10), ice_rd(in, 0x18),
+		    ice_rd(in, 0x14));
+	}
+}
+
+struct ice_smp {
+	uint32_t ep0, rdevsta, rsts, rsec, rlnksta, ltssm, aer_unc, aer_cor, aer_root, atu1, atu2, mhist, ee;
+};
+
+static void
+ice_probe_sample(struct ice_smp *s, uint32_t xr, uint32_t aer)
+{
+	vm_offset_t bar = iceland_ath12k_bar;
+	uint32_t bhi = *(volatile uint32_t *)(bar + 0x28);
+
+	s->ep0 = ice_rd(iceland_ath12k_conf, 0);
+	s->rdevsta = ice_rd(ice_rp, xr + 8) >> 16;
+	s->rsts = ice_rd(ice_rp, 0x04) >> 16;
+	s->rsec = ice_rd(ice_rp, 0x1c) >> 16;
+	s->rlnksta = ice_rd(ice_rp, xr + 0x10) >> 16;
+	s->ltssm = ice_rd(ice_rp, 0x728);
+	s->aer_unc = aer ? ice_rd(ice_rp, aer + 4) : 0;
+	s->aer_cor = aer ? ice_rd(ice_rp, aer + 0x10) : 0;
+	s->aer_root = aer ? ice_rd(ice_rp, aer + 0x30) : 0;
+	s->atu1 = ice_rd(ice_rp, ICE_ATU);
+	s->atu2 = ice_rd(ice_rp, ICE_ATU + 4);
+	s->mhist = *(volatile uint32_t *)(bar + 0x48);
+	s->ee = (bhi != 0 && bhi < 0x1000 && !(bhi & 3)) ? *(volatile uint32_t *)(bar + bhi + 0x28) : 0xdeadu;
+}
+
+static void
+ice_probe_thread(void)
+{
+	uint32_t xr = ice_cap(ice_rp, 0x10), aer = ice_extcap(ice_rp, 0x0001), lines = 0;
+	unsigned long long t0 = hakios_iceland_us(), last = 0, now, syserr = 0;
+	struct ice_smp p, c;
+	int first = 1;
+
+	memset(&p, 0, sizeof(p));
+	printf("icepcie: ath12k: 46cn3x probe sampler start: root port express +%#x AER +%#x; fields ep0 rp-devsta rp-status "
+	    "rp-secsta rp-lnksta rp-0x728 aer-unc aer-cor aer-root atu0-ctrl1 atu0-ctrl2 mhistatus execenv\n", xr, aer);
+	for (;;) {
+		ice_probe_sample(&c, xr, aer);
+		now = hakios_iceland_us();
+		if (first || memcmp(&c, &p, sizeof(c)) != 0) {        /* 46cn4a G3: no heartbeat */
+			bool chg = first || memcmp(&c, &p, sizeof(c)) != 0;
+
+			if (lines < 300) {
+				printf("icepcie: ath12k: 46cn3x probe +%llu us %s: ep0 %08x rp devsta %04x status %04x secsta %04x lnksta %04x "
+				    "728 %08x aer unc %08x cor %08x root %08x atu0 %08x %08x mhistatus %08x ee %08x%s\n", now - t0,
+				    chg ? "CHANGE" : "beat", c.ep0, c.rdevsta, c.rsts, c.rsec, c.rlnksta, c.ltssm, c.aer_unc, c.aer_cor,
+				    c.aer_root, c.atu1, c.atu2, c.mhist, c.ee, c.ep0 == 0xffffffffu && p.ep0 != 0xffffffffu && !first ?
+				    " <- FIRST all-ones config read" : "");
+				lines += chg;
+			}
+			last = now;
+		}
+		if (!first && c.ee != p.ee) {
+			ice_probe_iatu("at EXECENV change");
+		}
+		if (syserr == 0 && (c.mhist & 4u) && c.mhist != 0xffffffffu) {
+			syserr = now;
+			printf("icepcie: ath12k: 46cn3x probe first SYS_ERR at +%llu us (mhistatus %08x ee %08x)\n", now - t0, c.mhist,
+			    c.ee);
+			ice_probe_iatu("at the first SYS_ERR");
+		}
+		p = c;
+		first = 0;
+		if ((syserr != 0 && now - syserr >= 2000000) || hakios_iceland_us() >= 280000000ull ||
+		    (syserr == 0 && &nw_wifi_om_ready_us != NULL && nw_wifi_om_ready_us != 0 &&
+		    hakios_iceland_us() >= nw_wifi_om_ready_us + 5000000ull)) {
+			break;
+		}
+		IOSleep(1);
+	}
+	ice_probe_iatu("at the end");
+	printf("icepcie: ath12k: 46cn3x probe sampler end at +%llu us (%u change lines)\n", hakios_iceland_us() - t0, lines);
+}
+
+/* at link-up, after ice_pcie_linkup; reads only */
+static void
+ice_probe_start(void)
+{
+	thread_t t;
+
+	(void)PE_parse_boot_argn("dadawifi_cfgprobe", &ice_cfgprobe, sizeof(ice_cfgprobe));
+	if (ice_cfgprobe == 0) {
+		return;
+	}
+	if (ice_rp == 0) {
+		ice_rp = ml_io_map_unmappable(ICE_RP_DBI_PA, 0x2000, VM_WIMG_IO);
+	}
+	if (ice_rp == 0 || iceland_ath12k_bar == 0) {
+		printf("icepcie: ath12k: 46cn3x probe: no root port / BAR mapping: off\n");
+		ice_cfgprobe = 0;
+		return;
+	}
+	printf("icepcie: ath12k: 46cn3x probe config path: endpoint config space = mapping %#lx of PA 0x40100000 (harvest.c "
+	    "e2_cfg, iATU region 0 CFG0 -> bus 1 dev 0), read 32-bit; root port = DBI PA %#x mapped at %#lx, iATU at DBI + %#x; "
+	    "region 0 now ctrl1 %08x ctrl2 %08x base %08x limit %08x target %08x\n", iceland_ath12k_conf, ICE_RP_DBI_PA, ice_rp,
+	    ICE_ATU, ice_rd(ice_rp, ICE_ATU), ice_rd(ice_rp, ICE_ATU + 4), ice_rd(ice_rp, ICE_ATU + 8),
+	    ice_rd(ice_rp, ICE_ATU + 0x10), ice_rd(ice_rp, ICE_ATU + 0x14));
+	ice_probe_iatu("at link-up");
+	if (kernel_thread_start((thread_continue_t)ice_probe_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
+/* 0x08: the driver's 2nd LnkCtl write is ath12k_pci_aspm_restore (ath12k_pci_start = hif start, before the HTC
+ * connects); the root port gets ASPM L0s + L1 first, then the driver's own endpoint write carries the two bits */
+static uint32_t
+ice_pcie_hifstart(uint32_t v)
+{
+	uint32_t a;
+
+	if (ice_cfgprobe != 0 && ice_lnk_writes == 2) {
+		printf("icepcie: ath12k: 46cn3x probe hif start (the driver's ASPM restore write), endpoint dword 0 %08x\n",
+		    ice_rd(iceland_ath12k_conf, 0));
+		ice_probe_iatu("at hif start");
+		ice_probe_hif_seen = 1;
+	}
+	if (ice_pcie == 0 || ice_lnk_writes != 2) {
+		return v;
+	}
+	ice_pcie_state("at hif start (before the driver's ASPM restore)");
+	if (!(ice_pcie & 8)) {
+		return v;
+	}
+	a = ice_rd(ice_rp, ice_xr + 0x10) & 0xffff;
+	ice_wr(ice_rp, "root port", "LnkCtl (ASPM L0s + L1, at hif start)", ice_xr + 0x10, a | 3u);
+	printf("icepcie: ath12k: 46cn3p pcie endpoint LnkCtl: the driver's ASPM restore %04x -> %04x (ASPM L0s + L1)\n",
+	    v & 0xffff, (v | 3u) & 0xffff);
+	return v | 3u;
+}
+
+/* ---- config space ---- */
+static uint16_t lx_cfg_pcie;
+
+static int
+lx_cfg_read(int off, int size, uint32_t *v)
+{
+	uint32_t real = (off & 0x80000000u) ? (uint32_t)lx_cfg_pcie + (off & 0xffff) : (uint32_t)off;
+	uint32_t word;
+
+	if (iceland_ath12k_conf == 0 || real + 4 > 0x1000) {
+		return 1;
+	}
+	word = *(volatile uint32_t *)(iceland_ath12k_conf + (real & ~3u));
+	*v = size >= 4 ? word : (word >> ((real & 3) * 8)) & ((1u << (size * 8)) - 1);
+	return 0;
+}
+
+static int
+lx_cfg_write(int off, int size, uint32_t v)
+{
+	uint32_t real = (off & 0x80000000u) ? (uint32_t)lx_cfg_pcie + (off & 0xffff) : (uint32_t)off;
+	volatile uint32_t *w;
+	bool lnk = (uint32_t)off == (0x80000000u | 0x10u) && size == 2;   /* PCI_EXP_LNKCTL (46cn3p) */
+
+	if (iceland_ath12k_conf == 0 || real + 4 > 0x1000) {
+		return 1;
+	}
+	if (lnk) {
+		ice_lnk_writes++;
+		v = ice_pcie_hifstart(v);
+	}
+	w = (volatile uint32_t *)(iceland_ath12k_conf + (real & ~3u));
+	if (size < 4 && *w == 0xffffffffu && hakios_iceland_omni(0x80)) {
+		/* 46cn4a G4: a dead config window reads all-ones; its read-modify-write would write ~0 back */
+		printf("icepcie: ath12k: 46cn4a G4 config write +%#x (%d B, value %#x) NOT written: the word reads all-ones\n", real,
+		    size, v);
+		return 1;
+	}
+	if ((uint32_t)off == (0x80000000u | 0x08u) && size == 2 && (ice_pcie & 4) && hakios_iceland_omni(0x100)) {
+		/* 46cn4a G5: the runtime asks for MRRS 128 (nw_pci.c); dadawifi_pcie bit 4 set 512 at link-up and keeps it */
+		printf("icepcie: ath12k: 46cn4a G5 DevCtl write %04x -> %04x (MRRS 512 kept)\n", v & 0xffff, (v & ~0x7000u) | 0x2000u);
+		v = (v & ~0x7000u) | 0x2000u;
+	}
+	if (size >= 4) {
+		*w = v;
+	} else {
+		uint32_t shift = (real & 3) * 8, mask = ((1u << (size * 8)) - 1) << shift;
+		*w = (*w & ~mask) | ((v << shift) & mask);
+	}
+	if (lnk && ice_pcie != 0) {
+		printf("icepcie: ath12k: 46cn3p pcie driver LnkCtl write #%u (%s): %04x, endpoint LnkCtl/Sta read back %08x\n",
+		    ice_lnk_writes, ice_lnk_writes == 1 ? "aspm_disable" : ice_lnk_writes == 2 ? "aspm_restore = hif start" : "later",
+		    v & 0xffff, *(volatile uint32_t *)(iceland_ath12k_conf + (real & ~3u)));
+		if (ice_lnk_writes == 2) {
+			ice_pcie_state("at hif start (after)");
+		}
+	}
+	return 0;
+}
+
+static int
+lx_msi_target(uint32_t *lo, uint32_t *hi, uint32_t *data)
+{
+	if (iceland_ath12k_msi == 0) {
+		return 1;
+	}
+	*lo = (uint32_t)iceland_ath12k_msi;
+	*hi = (uint32_t)(iceland_ath12k_msi >> 32);
+	*data = 0;
+	return 0;
+}
+
+static void *
+lx_map_phys(uint64_t pa, size_t n)
+{
+	return (void *)ml_io_map((vm_offset_t)pa, (vm_size_t)n);
+}
+
+/* ---- firmware ---- */
+static int
+lx_fw_get(const char *name, const uint8_t **data, size_t *size)
+{
+	const char *base = name, *p;
+	uint32_t len = 0;
+	const uint8_t *d;
+
+	for (p = name; *p; p++) {
+		if (*p == '/') {
+			base = p + 1;
+		}
+	}
+	/* the names Linux asks for -> the files in md1 fw/ (iceland-firmware's ath12k set) */
+	if (strcmp(base, "amss.bin") == 0) {
+		d = iceland_ath12k_fw("ath12k_amss.bin", &len);
+	} else if (strcmp(base, "m3.bin") == 0) {
+		d = iceland_ath12k_fw("ath12k_m3.bin", &len);
+	} else if (strcmp(base, "aux_ucode.bin") == 0) {
+		d = iceland_ath12k_fw("ath12k_aux_ucode.bin", &len);
+	} else if (strcmp(base, "board.bin") == 0 || strcmp(base, "board-2.bin") == 0) {
+		d = iceland_ath12k_fw("ath12k_board.bin", &len);
+	} else if (strcmp(base, "regdb.bin") == 0) {
+		d = iceland_ath12k_fw("ath12k_regdb.bin", &len);
+	} else if (strcmp(base, "qdss.cfg") == 0 || strcmp(base, "qdss_trace_config.cfg") == 0) {
+		d = iceland_ath12k_fw("ath12k_qdss.cfg", &len);
+	} else if (strcmp(base, "wlan_mac.bin") == 0 && hakios_iceland_wlan_fw_mac(data, size)) {
+		return 0;       /* K2: the address en0 was made with; the radio takes it (mk-ath12k.sh 13) */
+	} else {
+		/* wlan_mac.bin / anything else: not present; the driver falls back */
+		return 2;
+	}
+	if (d == NULL) {
+		return 2;
+	}
+	*data = d;
+	*size = len;
+	return 0;
+}
