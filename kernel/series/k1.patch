index f4d148bd1b449f3c93716fe4d50aa56ed49988df..c170ab7e9c52ccd204dc3f7bfa88e89c065f7243 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -80,6 +80,20 @@
 #include <pexpert/arm/board_config.h>
