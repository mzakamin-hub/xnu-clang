+/*
+ * ---- 17r1c (icemic_cmd=3, only after 17r1b's up list passed in the same run; ADC1 / MICBIAS1 stay up) -------------
+ * The SoundWire capture stream of ADC1 on both ends and the TX macro's decimator 0, as Linux does it on this board (UCM
+ * OnePlus-Pad4 HiFi.conf "Mic": ADC1 MUX CH1_AMIC1, ADC1 Switch 1, ADC1 Volume 14, TX DEC0 MUX SWR_MIC, TX SMIC MUX0
+ * SWR_MIC0, TX_AIF1_CAP Mixer DEC0, TX_DEC0 Volume 84 = 0 dB; DT kaanapali-oneplus-iceland.dts wcd-capture-dai-link =
+ * q6apmbedai TX_CODEC_DMA_TX_3 <-> wcd939x 1 + swr2 + lpass_txmacro 0; &swr2 wcd_tx qcom,tx-port-mapping <2 2 3 4>: the
+ * WCD's TX port 1 (ADC1-4) is swr2's port 2; kaanapali.dtsi swr2: din-ports 4, dout-ports 0, for port 2 sinterval-low
+ * 0x01, offset1 0, offset2 0, hstart / hstop / word-length / block-pack-mode / block-group-count 0xff (not given),
+ * lane-control 0x02). Only ADC1 / DEC0 (AMIC1, the bottom mic), one channel; the second mic (ADC2 / DEC1) is not used.
+ *   a. codec, wcd939x.c: "ADC1 Volume" 14 = ANA_TX_CH1 0x300e [4:0] (SOC_SINGLE_TLV max 20); "ADC1 Switch" =
+ *      wcd939x_set_swr_port: the slave's port 1, channel mask 0x1 (no register: wcd939x_sdw_hw_params ->
+ *      sdw_stream_add_slave); ADC1_MIXER PRE_PMU = wcd939x_tx_swr_ctrl -> wcd939x_set_swr_clk_rate(9.6 MHz, ADC mode
+ *      NORMAL) for the current and the other bank = DIGITAL_SWR_TX_CLK_RATE 0x3405 [3:0] = 0, [7:4] = 0 (POST_PMD: the same);
+ *   b. the TX macro's mux kcontrols (lpass-tx-macro.c, LPASS above v9.0.0 = the v9_2 widgets): "TX DEC0 MUX" SWR_MIC =
+ *      ADC_MUX0_CFG1 0x104 [1:0] = 1; "TX SMIC MUX0" SWR_MIC0 = tx_macro_put_dec_enum -> tx_macro_update_smic_sel_v9_2
+ *      (widget shift 0): TX0_TX_PATH_CFG0 0x404 ADC_DMIC_SEL [7] = 0, then ADC_MUX0_CFG0 0x100 [3:0] = 1; "TX_DEC0
+ *      Volume" 84 = TX0_TX_VOL_CTL 0x40c = 0x00 (s8 dB: 84 - 84); tx_macro_hw_params: TX0_TX_PATH_CTL 0x400 PCM_RATE
+ *      [3:0] = 4 (48 kHz);
+ *   c. the stream, soundwire/stream.c with qcom.c's own compute_params (qcom_snd_sdw_prepare = sdw_prepare_stream +
+ *      sdw_enable_stream); the bus starts in the bank MCP_STATUS shows (qcom_swrm_probe: params->curr_bank);
+ *      sdw_program_params into the next bank b: slave DP1 (sdw_program_slave_port_params; wcd939x_tx_dpn_prop: type
+ *      SIMPLE, simple_ch_prep_sm; prop.lane_control_support): PortCtrl 0x102 [3:0] = 0 (sdw_update_no_pm), BlockCtrl1
+ *      0x103 = bps - 1: Linux's never-filled port_params give 0xff, which the WCD does not take (reads 0, 17r1c);
+ *      since 17r1d the stream's bps 1 (wcd939x_sdw_hw_params) -> 0, the value the device holds either way, SampleCtrl1_Bb 0x122/0x132 = sample_interval - 1 = si = 1, OffsetCtrl1_Bb 0x124/0x134 = 0,
+ *      LaneCtrl_Bb 0x128/0x138 = 2 (no BlockCtrl2: blk_grp_ctrl_valid is never set; a SIMPLE port gets no OffsetCtrl2 /
+ *      BlockCtrl3 / SampleCtrl2 / HCtrl); master port 2, qcom_swrm_transport_params: DP_PORT_CTRL_BANK(2, b)
+ *      0x1224/0x1264 = off1 << 8 | off2 << 16 | si = 0x1, DP_PORT_CTRL_2_BANK 0x1228/0x1268 = lane 2, DP_PORT_HCTRL_BANK
+ *      0x1234/0x1274 = 0xf0 (no hstart / hstop: SWR_HSTOP_MAX_VAL << 4 | SWR_HSTART_MIN_VAL), then qcom_swrm_port_params:
+ *      SWRM_DPn_BLOCK_CTRL_1(0x112c, p_params->num) = p_params->bps - 1 with the never-filled port_params (num 0, bps
+ *      0): 0x102c <- 0xffffffff -- Linux's write exactly as it happens on this board (icemic_bc1=0 leaves it out);
+ *      sdw_notify_config -> wcd_bus_config: slave SCP_HOST_CLK_DIV2_CTL_Bb 0xe0/0xf0 = 0x01;
+ *      do_bank_switch: qcom_swrm_pre_bank_switch: MCP_FRAME_CTRL_BANK(b) 0x101c/0x105c [7:0] = rows 50 / cols 16
+ *      (0x0f); sdw_bank_switch: SCP_FrameCtrl_Bb 0x60/0x70 = 0x0f BROADCAST (device 15, command id 15,
+ *      qcom_swrm_cmd_fifo_wr_cmd), swrm_wait_for_wr_fifo_done, the broadcast's end (SWRM_INTERRUPT_STATUS_
+ *      SPECIAL_CMD_ID_FINISHED; polled, cleared if seen) and MCP_STATUS's bank awaited (TIMEOUT_MS 100);
+ *      prepare = program(b) + switch (no PrepareCtrl: simple_ch_prep_sm; wcd939x has no port_prep op); enable =
+ *      program(b) + sdw_enable_disable_ports(b): slave ChannelEn_Bb 0x120/0x130 = 0x1, master DP_PORT_CTRL_BANK(2, b) |=
+ *      0x1 << 24 (qcom_swrm_port_enable), switch;
+ *   d. the decimator (DAPM, the mux group powers before the codec's mixers): tx_macro_enable_dec PRE_PMU: CFG0 ADC_MODE
+ *      [2:1] = dec_mode 0, TX_PATH_CTL PGA_MUTE [4] = 1; POST_PMU: TX0 ADPT_CTRL 0x800 = 0 only for LPASS codec >= 2.8
+ *      (the VA macro's CORE_ID_0..2 read as va_macro_set_lpass_codec_version; needs icemic_fsgen=1), CLK_EN [5] = 1, (AMIC:
+ *      no SEC2 gate clear), CFG0 HPF_CUT [6:5] = 2 (150 Hz) unless already, SEC2 0x418 [1:0] = 2 then 1, 6 ms, TX_VOL_CTL
+ *      rewritten (gain after enable); then a's tx_swr_ctrl; tx_macro_digital_mute(0): PGA_MUTE 0;
+ *      tx_macro_tx_hpf_corner_freq_callback at 300 ms: HPF_CUT back as found, SEC2 [1:0] = 2 then 1;
+ *   e. held icemic_hold (1000) ms from the enable: swr2 LINK_STATUS / MCP_STATUS / INT_STATUS / CMD_FIFO_STATUS, port 2's
+ *      bank registers, the slave's DP1 interrupt / prepare / channel-enable and SCP frame registers, the decimator's
+ *      registers read; [icemic_cmd=4: 17r2 runs here, the path running];
+ *   f. down: tx_macro_digital_mute(1); sdw_disable_stream (ports off in the next bank, program, switch, ports off in the
+ *      other bank) + sdw_deprepare_stream (program, switch) -- 4 bank switches in all, the bus ends in the bank it
+ *      started in; tx_swr_ctrl POST_PMD; tx_macro_enable_dec PRE_PMD / POST_PMD (CLK_EN 0, ADC_MODE 0, PGA_MUTE 0); then
+ *      every register written here back as found (TX macro mux / path / volume / SEC2 / ADPT, ANA_TX_CH1, swr2's port 2
+ *      bank registers, 0x102c, MCP_FRAME_CTRL_BANK of the other bank); then 17r1b's down list and gpio161 as before.
+ * Not done (Linux does it, the stream does not need it): sdw_initialize_slave's SCP / DPn interrupt masks and the
+ * interrupt handling (INTERRUPT_CPU_EN stays as found; status polled). Lines "mic: r1c: ...", result "mic: r1c PASS/FAIL".
+ */
+#define SWR_DP_PORT_CTRL(n, b)          (0x1124u + 0x100u * ((n) - 1u) + 0x40u * (b))
+#define SWR_DP_PORT_CTRL_2(n, b)        (0x1128u + 0x100u * ((n) - 1u) + 0x40u * (b))
+#define SWR_DP_HCTRL(n, b)              (0x1134u + 0x100u * ((n) - 1u) + 0x40u * (b))
+#define SWR_DP_BLOCK_CTRL_1_NUM0        0x102cu         /* SWRM_DPn_BLOCK_CTRL_1(0x112c, 0) */
+#define SWR_FRAME_CTRL_BANK(b)          (0x101Cu + 0x40u * (b))
+#define SWR_INT_SPECIAL_CMD_DONE        (1u << 10)
+#define MIC_M_PORT                      2u              /* swr2's port for the WCD's TX port 1 */
+#define MIC_S_PORT                      1u              /* WCD939X_ADC_1_4_PORT */
+#define MIC_CH_MASK                     0x1u            /* WCD939X_ADC1: BIT(0) */
+#define MIC_SI                          1u              /* qcom,ports-sinterval-low of port 2 */
+#define MIC_LANE                        2u              /* qcom,ports-lane-control of port 2 */
+#define MIC_FRAMECTRL                   0x0fu           /* col index 7 (16) | row index 1 (50) << 3 */
+#define SDW_DP1(r)                      (0x100u * MIC_S_PORT + (r))
+#define SDW_SCP_FRAMECTRL(b)            (0x60u + 0x10u * (b))
+#define SDW_SCP_HOST_CLK_DIV2(b)        (0xe0u + 0x10u * (b))
+#define TXM_ADC_MUX0_CFG0               0x100u
+#define TXM_ADC_MUX0_CFG1               0x104u
+#define TXM_TX0_PATH_CTL                0x400u
+#define TXM_TX0_PATH_CFG0               0x404u
+#define TXM_TX0_VOL_CTL                 0x40cu
+#define TXM_TX0_PATH_SEC2               0x418u
+#define TXM_TX0_ADPT_CTRL               0x800u
+
+/* sdw_write_no_pm over swr2's FIFO (always written, as the SoundWire core does), read back under `check` */
+static bool
+mic_sdw_w(const struct mic_blk *swr, unsigned dev, uint16_t reg, const char *name, uint8_t val, uint8_t check)
+{
+	int32_t was = mic_cmd_read(swr, dev, reg), now;
+	bool ok;
+
+	(void)mic_cmd_write(swr, dev, reg, val);
+	mic_cdc_writes++;
+	now = mic_cmd_read(swr, dev, reg);
+	ok = now >= 0 && ((uint32_t)now & check) == ((uint32_t)val & check);
+	mic_cdc_bad += !ok;
+	mic("%s: W slave %s %#x = %#x: found %#x%s, read back %#x [mask %#x] (%s)\n", mic_tag, name, reg, val,
+	    was < 0 ? 0 : (uint32_t)was, was < 0 ? " (NOT READ)" : "", now < 0 ? 0 : (uint32_t)now, check, ok ? "ok" :
+	    now < 0 ? "NOT READ" : "NOT AS WANTED");
+	return ok;
+}
+
+static struct {
+	uint32_t curr, start;           /* the bus's bank now / at the start */
+	uint32_t f_pc[2], f_pc2[2], f_hc[2], f_bc1, f_frame[2];
+	bool bc1, prepared, enabled;
+	unsigned switches, switch_bad;
+} mr;
+
+/* do_bank_switch for our one master: qcom_swrm_pre_bank_switch + sdw_bank_switch (the broadcast) */
+static bool
+mic_bank_switch(const struct mic_blk *swr, unsigned dev, const char *why)
+{
+	uint32_t next = mr.curr ^ 1u, st = 0, bank = mr.curr, v, st0 = mic_rd(swr, SWR_INT_STATUS);
+	uint64_t t0;
+	char n[64];
+	bool ok;
+
+	v = mic_rd(swr, SWR_FRAME_CTRL_BANK(next));
+	snprintf(n, sizeof(n), "MCP_FRAME_CTRL_BANK(%u) rows 50 / cols 16", next);
+	(void)mic_wr(swr, SWR_FRAME_CTRL_BANK(next), n, (v & ~0xffu) | MIC_FRAMECTRL, 0xff);
+	mic("%s: bank switch (%s): W BROADCAST SCP_FrameCtrl_B%u %#x = %#x (device 15, command id 15) via CMD_FIFO_WR_CMD\n",
+	    mic_tag, why, next, SDW_SCP_FRAMECTRL(next), MIC_FRAMECTRL);
+	wr(swr->va + SWR_CMD_FIFO_WR_CMD, SDW_SCP_FRAMECTRL(next) | 0xfu << 16 | 15u << 20 | (uint32_t)MIC_FRAMECTRL << 24);
+	mic_cdc_writes++;
+	for (int i = 0; i < 30 && ((mic_rd(swr, SWR_CMD_FIFO_STATUS) >> 8) & 0x1f); i++) {     /* swrm_wait_for_wr_fifo_done */
+		delay_for_interval(500, NSEC_PER_USEC);
+	}
+	t0 = now_us();
+	while (now_us() - t0 < 100000ull) {                     /* the broadcast completion, TIMEOUT_MS 100 */
+		st = mic_rd(swr, SWR_INT_STATUS);
+		bank = mic_rd(swr, SWR_MCP_STATUS) & 1;
+		if ((st & SWR_INT_SPECIAL_CMD_DONE) || bank == next) {
+			break;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	delay_for_interval(200, NSEC_PER_USEC);
+	st = mic_rd(swr, SWR_INT_STATUS);
+	bank = mic_rd(swr, SWR_MCP_STATUS) & 1;
+	if (st & SWR_INT_SPECIAL_CMD_DONE) {
+		(void)mic_wr(swr, SWR_INT_CLEAR, "INTERRUPT_CLEAR SPECIAL_CMD_ID_FINISHED", SWR_INT_SPECIAL_CMD_DONE, 0);
+	}
+	/*
+	 * 17r2c: no read-back of the slave's SCP_FrameCtrl any more (Linux never reads it): on this WCD that read is not
+	 * acknowledged -- it returned 0 and latched INT_STATUS bit 19 (CMD_IGNORED_AND_EXEC_CONTINUED, CMD_FIFO_CFG's
+	 * continue-on-ignore), seen from the second switch on in 17r1c / 17r1d / 17r2b. INT_STATUS is logged before the
+	 * broadcast and after it, so a new ignored command shows where it came from.
+	 */
+	(void)dev;
+	ok = bank == next;
+	mr.switches++;
+	mr.switch_bad += !ok;
+	mic("%s: bank switch (%s) %s after %llu us: MCP_STATUS bank %u (wanted %u), INT_STATUS before %#x after %#x "
+	    "(special command %s%s)\n", mic_tag, why, ok ? "DONE" : "NOT DONE", now_us() - t0, bank, next, st0, st,
+	    (st & SWR_INT_SPECIAL_CMD_DONE) ? "finished" : "bit not seen", ((st & ~st0) & (1u << 19)) ?
+	    "; NEW bit 19: a command since the last read was IGNORED" : "");
+	mr.curr = bank;                 /* (Linux flips its record; here the bank the hardware shows) */
+	return ok;
+}
+
+/* sdw_program_params for our stream into bank b: the slave's DP1, swr2's port 2, then wcd_bus_config */
+static bool
+mic_sdw_program(const struct mic_blk *swr, unsigned dev, uint32_t b)
+{
+	char n[96];
+	bool ok = true;
+
+	ok &= mic_cdc_field(swr, dev, SDW_DP1(0x02), "slave DP1 PortCtrl data / flow mode 0", 0x0f, 0);
+	/*
+	 * BlockCtrl1 = bps - 1. On this tree p_rt->port_params is never filled (qcom_swrm_compute_params only with
+	 * ports-word-length), so Linux sends (u8)(0 - 1) = 0xff -- 17r1c (31 Oct) wrote that and the WCD read back 0 (the
+	 * 6-bit word length rejected / ignored it). 17r1d writes the stream's word length instead: wcd939x_sdw_hw_params
+	 * sconfig.bps = 1 (PDM, 1 bit per sample) -> 1 - 1 = 0, which is also what the device holds after Linux's write.
+	 * (Not 0x0f: the SoundWire stream's bps here is the codec's 1, not the PCM sample width.)
+	 */
+	ok &= mic_sdw_w(swr, dev, SDW_DP1(0x03), "DP1 BlockCtrl1 = stream bps 1 - 1 (wcd939x_sdw_hw_params)", 0x00, 0x3f);
+	snprintf(n, sizeof(n), "DP1 SampleCtrl1_B%u = sample_interval - 1", b);
+	ok &= mic_sdw_w(swr, dev, SDW_DP1(b ? 0x32 : 0x22), n, MIC_SI, 0xff);
+	snprintf(n, sizeof(n), "DP1 OffsetCtrl1_B%u = offset1", b);
+	ok &= mic_sdw_w(swr, dev, SDW_DP1(b ? 0x34 : 0x24), n, 0, 0xff);
+	snprintf(n, sizeof(n), "DP1 LaneCtrl_B%u = lane", b);
+	ok &= mic_sdw_w(swr, dev, SDW_DP1(b ? 0x38 : 0x28), n, MIC_LANE, 0x07);
+	snprintf(n, sizeof(n), "DP2 PORT_CTRL_BANK(%u) = si 1, offset1 0, offset2 0", b);
+	ok &= mic_wr(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, b), n, MIC_SI, 0xffffffffu);
+	snprintf(n, sizeof(n), "DP2 PORT_CTRL_2_BANK(%u) = lane 2", b);
+	ok &= mic_wr(swr, SWR_DP_PORT_CTRL_2(MIC_M_PORT, b), n, MIC_LANE, 0xff);
+	snprintf(n, sizeof(n), "DP2 PORT_HCTRL_BANK(%u) = hstop 0xf, hstart 0", b);
+	ok &= mic_wr(swr, SWR_DP_HCTRL(MIC_M_PORT, b), n, 0xf0, 0xff);
+	if (mr.bc1) {
+		(void)mic_wr(swr, SWR_DP_BLOCK_CTRL_1_NUM0, "BLOCK_CTRL_1 of port num 0 = bps - 1 (qcom_swrm_port_params, Linux as is)",
+		    0xffffffffu, 0);
+		mic("%s:   swr2 %#x reads %#x after Linux's write\n", mic_tag, (uint32_t)(MIC_SWR_PHYS + SWR_DP_BLOCK_CTRL_1_NUM0),
+		    mic_rd(swr, SWR_DP_BLOCK_CTRL_1_NUM0));
+	}
+	snprintf(n, sizeof(n), "SCP_HOST_CLK_DIV2_CTL_B%u = 1 (wcd_bus_config)", b);
+	ok &= mic_sdw_w(swr, dev, SDW_SCP_HOST_CLK_DIV2(b), n, 0x01, 0xff);
+	return ok;
+}
+
+/* sdw_enable_disable_ports into bank b: the slave's ChannelEn, then qcom_swrm_port_enable */
+static bool
+mic_sdw_ports(const struct mic_blk *swr, unsigned dev, uint32_t b, bool en)
+{
+	uint32_t v = mic_rd(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, b));
+	char n[80];
+	bool ok;
+
+	snprintf(n, sizeof(n), "DP1 ChannelEn_B%u %s", b, en ? "= ADC1" : "= 0");
+	ok = mic_sdw_w(swr, dev, SDW_DP1(b ? 0x30 : 0x20), n, en ? MIC_CH_MASK : 0, 0xff);
+	v = en ? v | MIC_CH_MASK << 24 : v & ~(0xffu << 24);
+	snprintf(n, sizeof(n), "DP2 PORT_CTRL_BANK(%u) channel enable %s", b, en ? "0x1" : "0");
+	ok &= mic_wr(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, b), n, v, 0xffffffffu);
+	return ok;
+}
+
+/* sdw_prepare_stream + sdw_enable_stream */
+static bool
+mic_swr_up(const struct mic_blk *swr, unsigned dev)
+{
+	bool ok, sw;
+
+	mr.prepared = mr.enabled = false;
+	mic("%s: sdw_prepare_stream: program bank %u, bank switch\n", mic_tag, mr.curr ^ 1u);
+	ok = mic_sdw_program(swr, dev, mr.curr ^ 1u);
+	sw = mic_bank_switch(swr, dev, "prepare");
+	mr.prepared = sw;               /* the switch was made: the stream's state is PREPARED */
+	if (!ok || !sw) {
+		return false;
+	}
+	mic("%s: sdw_enable_stream: program bank %u, ports on in it, bank switch\n", mic_tag, mr.curr ^ 1u);
+	ok = mic_sdw_program(swr, dev, mr.curr ^ 1u);
+	ok &= mic_sdw_ports(swr, dev, mr.curr ^ 1u, true);
+	sw = mic_bank_switch(swr, dev, "enable");
+	mr.enabled = sw;                /* ports may be on in the active bank: the down path must disable them */
+	return ok && sw;
+}
+
+/*
+ * The down path for the state reached (17r1c 31 Oct: prepare's switch done, enable not reached, and the old full
+ * disable + deprepare left the bus one bank off): sdw_disable_stream only if the enable's switch was made (Linux:
+ * state ENABLED), sdw_deprepare_stream if the prepare's was (qcom_snd_sdw_prepare deprepares after a failed enable;
+ * hw_free disables, then deprepares). Each switch flips the bank, so the bus ends in the bank it started in.
+ */
+static bool
+mic_swr_down(const struct mic_blk *swr, unsigned dev)
+{
+	bool ok = true;
+
+	if (mr.enabled) {
+		mic("%s: sdw_disable_stream: ports off in bank %u, program it, bank switch, ports off in bank %u\n", mic_tag,
+		    mr.curr ^ 1u, mr.curr);
+		ok &= mic_sdw_ports(swr, dev, mr.curr ^ 1u, false);
+		ok &= mic_sdw_program(swr, dev, mr.curr ^ 1u);
+		ok &= mic_bank_switch(swr, dev, "disable");
+		ok &= mic_sdw_ports(swr, dev, mr.curr ^ 1u, false);
+		mr.enabled = false;
+	}
+	if (mr.prepared) {
+		mic("%s: sdw_deprepare_stream: program bank %u, bank switch\n", mic_tag, mr.curr ^ 1u);
+		ok &= mic_sdw_program(swr, dev, mr.curr ^ 1u);
+		ok &= mic_bank_switch(swr, dev, "deprepare");
+		mr.prepared = false;
+	}
+	return ok;
+}
+
+static struct {
+	uint32_t f_mux0, f_mux1, f_ctl, f_cfg0, f_vol, f_sec2, f_adpt, hpf_found;
+	bool adpt;
+} md;
+
+/*
+ * w4-audio round 6: icerec=1, one word for a combined run (the tablet's line has no room for six): the sound service
+ * FIRST (the self-test's ladder, macOS's own sounds), for icerec_snd s (215), then, once it has put everything back,
+ * the microphone's capture service from icemic_at s of uptime (255) for icemic_secs s (150) as the source of macOS's
+ * "Mic" -- never both at once (they share bank 7 / SMR 9-10), the order of icemic_then_snd=1 turned round. It stands for
+ * icemic=1, and the DSP's thread listens until 14 s before reset-after. Each of icemic_at, icemic_secs, icemic_decvol
+ * and icedsp_glink_s on the line still wins. Without icerec nothing changes.
+ */
+static bool
+ice_rec(void)
+{
+	static int rec = -1;
+
+	if (rec < 0) {
+		uint32_t wanted = 0;
+
+		rec = PE_parse_boot_argn("icerec", &wanted, sizeof(wanted)) && wanted == 1;
+	}
+	return rec == 1;
+}
+
+/*
+ * 17u: the capture gain. Reference = the repo's UCM (gh/iceland-mainline audio/ucm/OnePlus-Pad4/HiFi.conf "Mic"):
+ * ADC1 Volume 14 (wcd939x.c analog_gain TLV: 1.5 dB a step -> +21 dB; 14 = stock's maximum for this mic), TX_DEC0
+ * Volume 84 (lpass-tx-macro.c digital_gain, S8: TX0_VOL_CTL = Volume - 84 dB -> 0 dB = stock's register value),
+ * MICBIAS1 2.7 V (DT qcom,micbias1-microvolt; AMIC1 <- MIC BIAS1); the Pad's capture graph has no gain module. 17t3 had
+ * exactly these. Stock adds ~14 dB after the codec in its DSP chain; Linux 0.27r6 - 0.28-3 put those 14 dB into the
+ * decimator (TX_DEC0 Volume 98) and 0.28-4 moved them to WebRTC's gain control after the echo canceller. Boot-args:
+ * icemic_adcvol=N (ADC1 Volume, default 14, capped at 14) and icemic_decvol=N (TX_DEC0 gain in dB, default 0, capped
+ * at +14 = stock's total): never above stock.
+ */
+static uint32_t mic_adcvol = 14, mic_decvol;
+static char mic_adcvol_name[64], mic_decvol_name[64];
+
+static void
+mic_gain_args(void)
+{
+	uint32_t a = 14, d = 0;
+
+	/*
+	 * round 6: a recording run (icerec=1) takes stock's total by default, +14 dB in the decimator (TX_DEC0 98), what
+	 * Linux 0.27r6 - 0.28-3 had there and what Fedora's default source ("voice processing", 61-iceland-mic-gain.conf)
+	 * adds after its canceller: the raw path's ADC1 14 / TX_DEC0 84, read on the tablet's Fedora 16 Nov, are this
+	 * kernel's defaults already. Never above it (the cap below); icemic_decvol on the line still says otherwise.
+	 */
+	if (ice_rec()) {
+		d = 14;
+	}
+	PE_parse_boot_argn("icemic_adcvol", &a, sizeof(a));
+	PE_parse_boot_argn("icemic_decvol", &d, sizeof(d));
+	if (a > 14) {
+		mic("gain: icemic_adcvol %u above stock's 14: capped at 14\n", a);
+		a = 14;
+	}
+	if (d > 14) {
+		mic("gain: icemic_decvol %u dB above stock's +14 dB (DSP gain): capped at 14\n", d);
+		d = 14;
+	}
+	mic_adcvol = a;
+	mic_decvol = d;
+	snprintf(mic_adcvol_name, sizeof(mic_adcvol_name), "ANA_TX_CH1 ADC1 Volume = %u (+%u.%u dB)", a, a * 15 / 10,
+	    a * 15 % 10);
+	snprintf(mic_decvol_name, sizeof(mic_decvol_name), "TX0_VOL_CTL TX_DEC0 Volume %u = +%u dB", 84 + d, d);
+}
+
+/* one line: the gain registers now (codec over the command FIFO, TX macro MMIO) against the wanted values */
+static void
+mic_gain_log(const struct mic_blk *swr, const struct mic_blk *txm, unsigned dev, const char *when)
+{
+	int32_t ch1 = mic_cmd_read(swr, dev, 0x300e), mb1 = mic_cmd_read(swr, dev, 0x3022);
+	uint32_t vol = mic_rd(txm, TXM_TX0_VOL_CTL), ctl = mic_rd(txm, TXM_TX0_PATH_CTL), g = ch1 < 0 ? 0 : (uint32_t)ch1 & 0x1f;
+	int32_t db = (int32_t)(int8_t)(uint8_t)vol, t = (int32_t)(g * 15) + db * 10;
+	bool ok = ch1 >= 0 && g == mic_adcvol && (vol & 0xff) == mic_decvol;
+
+	/* (round 6: the look before the writes is the codec's reset state, not a verdict: it says "written next") */
+	mic("gain: %s: ANA_TX_CH1 0x300e %#x (ADC1 Volume %u = +%u.%u dB analog), ANA_MICB1 0x3022 %#x (VOUT %u = %u mV, "
+	    "enable %u), TX0_VOL_CTL %#x (TX_DEC0 Volume %d = %+d dB), PGA_MUTE %u; total %+d.%d dB; wanted ADC1 %u, "
+	    "TX_DEC0 %u: %s\n", when, ch1 < 0 ? 0 : (uint32_t)ch1, g, g * 15 / 10, g * 15 % 10, mb1 < 0 ? 0 : (uint32_t)mb1,
+	    mb1 < 0 ? 0 : (uint32_t)mb1 & 0x3f, mb1 < 0 ? 0 : 1000 + 50 * ((uint32_t)mb1 & 0x3f),
+	    mb1 < 0 ? 0 : ((uint32_t)mb1 >> 6) & 3, vol, 84 + db, db, (ctl >> 4) & 1,
+	    t / 10, t < 0 ? -(t % 10) : t % 10, mic_adcvol,
+	    84 + mic_decvol, ok ? "as wanted" : strcmp(when, "found") == 0 ? "before the writes (written next)" :
+	    "NOT AS WANTED");
+}
+
+/* b: the mux kcontrols, the volume, hw_params */
+static bool
+mic_dec_mux(const struct mic_blk *txm)
+{
+	bool ok = true;
+
+	md.f_mux0 = mic_rd(txm, TXM_ADC_MUX0_CFG0);
+	md.f_mux1 = mic_rd(txm, TXM_ADC_MUX0_CFG1);
+	md.f_ctl = mic_rd(txm, TXM_TX0_PATH_CTL);
+	md.f_cfg0 = mic_rd(txm, TXM_TX0_PATH_CFG0);
+	md.f_vol = mic_rd(txm, TXM_TX0_VOL_CTL);
+	md.f_sec2 = mic_rd(txm, TXM_TX0_PATH_SEC2);
+	md.f_adpt = mic_rd(txm, TXM_TX0_ADPT_CTRL);
+	mic("r1c: txmacro DEC0 found: ADC_MUX0_CFG0 %#x, ADC_MUX0_CFG1 %#x, TX0_PATH_CTL %#x, TX0_PATH_CFG0 %#x, TX0_VOL_CTL "
+	    "%#x, TX0_PATH_SEC2 %#x, TX0_ADPT_CTRL %#x\n", md.f_mux0, md.f_mux1, md.f_ctl, md.f_cfg0, md.f_vol, md.f_sec2,
+	    md.f_adpt);
+	ok &= mic_upd(txm, TXM_ADC_MUX0_CFG1, "ADC_MUX0_CFG1 TX DEC0 MUX = SWR_MIC", 0x3, 1);
+	ok &= mic_upd(txm, TXM_TX0_PATH_CFG0, "TX0_PATH_CFG0 ADC_DMIC_SEL 0 (smic_sel_v9_2)", 0x80, 0);
+	ok &= mic_upd(txm, TXM_ADC_MUX0_CFG0, "ADC_MUX0_CFG0 TX SMIC MUX0 = SWR_MIC0", 0xf, 1);
+	ok &= mic_upd(txm, TXM_TX0_VOL_CTL, mic_decvol_name, 0xff, mic_decvol);
+	ok &= mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL PCM_RATE 48 kHz (tx_macro_hw_params)", 0xf, 4);
+	return ok;
+}
+
+/* d: tx_macro_enable_dec PRE_PMU + POST_PMU for DEC0 (an AMIC: SWR_MIC) */
+static bool
+mic_dec_up(const struct mic_blk *txm, const struct mic_blk *va)
+{
+	uint32_t vol;
+	bool ok = true;
+
+	md.adpt = false;
+	if (va != NULL && va->va != 0) {
+		uint32_t id0 = mic_rd(va, 0xc0), id1 = mic_rd(va, 0xc4), id2 = mic_rd(va, 0xc8), maj = id0 & 0xff,
+		    min = (id2 >> 4) & 0xf;
+
+		md.adpt = ((id1 >> 3) & 1) && maj == 2 && min >= 8 && min <= 9;
+		mic("r1c: vamacro CORE_ID_0 %#x, _1 %#x, _2 %#x: LPASS codec v%u.%u.%u%s -> ADPT_CTRL %s\n", id0, id1, id2, maj,
+		    min, id2 & 0xf, ((id1 >> 3) & 1) ? "" : " (NO VA macro bit)", md.adpt ? "written 0 (>= 2.8)" :
+		    "left alone (< 2.8 or unknown)");
+	} else {
+		mic("r1c: the VA macro is not mapped (icemic_fsgen=0): codec version unknown, ADPT_CTRL left alone\n");
+	}
+	ok &= mic_upd(txm, TXM_TX0_PATH_CFG0, "TX0_PATH_CFG0 ADC_MODE = dec_mode 0 (PRE_PMU)", 0x6, 0);
+	ok &= mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL PGA_MUTE 1 (PRE_PMU)", 0x10, 0x10);
+	if (md.adpt) {
+		ok &= mic_wr(txm, TXM_TX0_ADPT_CTRL, "TX0_ADPT_CTRL 0 (POST_PMU, codec >= 2.8)", 0, 0xff);
+	}
+	ok &= mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL CLK_EN 1 (POST_PMU: the decimator runs)", 0x20, 0x20);
+	md.hpf_found = (mic_rd(txm, TXM_TX0_PATH_CFG0) >> 5) & 3;
+	if (md.hpf_found != 2) {
+		ok &= mic_upd(txm, TXM_TX0_PATH_CFG0, "TX0_PATH_CFG0 HPF_CUT 150 Hz", 0x60, 2u << 5);
+		ok &= mic_upd(txm, TXM_TX0_PATH_SEC2, "TX0_PATH_SEC2 HPF F_CHANGE 1 ZERO_GATE 0", 0x3, 0x2);
+		ok &= mic_upd(txm, TXM_TX0_PATH_SEC2, "TX0_PATH_SEC2 HPF F_CHANGE 0 ZERO_GATE 1", 0x3, 0x1);
+		delay_for_interval(6, NSEC_PER_MSEC);
+	}
+	vol = mic_rd(txm, TXM_TX0_VOL_CTL);
+	ok &= mic_wr(txm, TXM_TX0_VOL_CTL, "TX0_VOL_CTL rewritten (gain after the enable)", vol, 0xff);
+	return ok;
+}
+
+/* tx_macro_tx_hpf_corner_freq_callback (300 ms after the enable; an AMIC) */
+static bool
+mic_dec_hpf_work(const struct mic_blk *txm)
+{
+	bool ok = true;
+
+	if (md.hpf_found == 2) {
+		return true;
+	}
+	ok &= mic_upd(txm, TXM_TX0_PATH_CFG0, "TX0_PATH_CFG0 HPF_CUT back as found (hpf work)", 0x60, md.hpf_found << 5);
+	ok &= mic_upd(txm, TXM_TX0_PATH_SEC2, "TX0_PATH_SEC2 F_CHANGE 1 ZERO_GATE 0 (hpf work)", 0x3, 0x2);
+	ok &= mic_upd(txm, TXM_TX0_PATH_SEC2, "TX0_PATH_SEC2 F_CHANGE 0 ZERO_GATE 1 (hpf work)", 0x3, 0x1);
+	return ok;
+}
+
+/* f: PRE_PMD / POST_PMD, then every DEC0 register as found */
+static void
+mic_dec_down(const struct mic_blk *txm, bool pmd)
+{
+	if (pmd) {
+		(void)mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL PGA_MUTE 1 (PRE_PMD)", 0x10, 0x10);
+		(void)mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL CLK_EN 0 (POST_PMD)", 0x20, 0);
+		(void)mic_upd(txm, TXM_TX0_PATH_CFG0, "TX0_PATH_CFG0 ADC_MODE 0 (POST_PMD)", 0x6, 0);
+		(void)mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL PGA_MUTE 0 (POST_PMD)", 0x10, 0);
+	}
+	(void)mic_upd(txm, TXM_TX0_PATH_SEC2, "TX0_PATH_SEC2 back", 0xff, md.f_sec2);
+	(void)mic_upd(txm, TXM_TX0_VOL_CTL, "TX0_VOL_CTL back", 0xff, md.f_vol);
+	(void)mic_upd(txm, TXM_TX0_PATH_CFG0, "TX0_PATH_CFG0 back", 0xff, md.f_cfg0);
+	(void)mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL back", 0xff, md.f_ctl);
+	(void)mic_upd(txm, TXM_ADC_MUX0_CFG0, "ADC_MUX0_CFG0 back", 0xff, md.f_mux0);
+	(void)mic_upd(txm, TXM_ADC_MUX0_CFG1, "ADC_MUX0_CFG1 back", 0xff, md.f_mux1);
+	if (md.adpt) {
+		(void)mic_wr(txm, TXM_TX0_ADPT_CTRL, "TX0_ADPT_CTRL back", md.f_adpt, 0xff);
+	}
+}
+
+static void
+mic_r1c_status(const struct mic_blk *swr, const struct mic_blk *txm, unsigned dev, const char *when)
+{
+	mic("r1c: %s: swr2 LINK_STATUS %#x, MCP_STATUS %#x (bank %u), INT_STATUS %#x, CMD_FIFO_STATUS %#x, MCP_SLV_STATUS "
+	    "%#x; DP2 PORT_CTRL b0 %#x b1 %#x, PORT_CTRL_2 b0 %#x b1 %#x, HCTRL b0 %#x b1 %#x\n", when,
+	    mic_rd(swr, SWR_LINK_STATUS), mic_rd(swr, SWR_MCP_STATUS), mic_rd(swr, SWR_MCP_STATUS) & 1,
+	    mic_rd(swr, SWR_INT_STATUS), mic_rd(swr, SWR_CMD_FIFO_STATUS), mic_rd(swr, SWR_MCP_SLV_STATUS),
+	    mic_rd(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, 0)), mic_rd(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, 1)),
+	    mic_rd(swr, SWR_DP_PORT_CTRL_2(MIC_M_PORT, 0)), mic_rd(swr, SWR_DP_PORT_CTRL_2(MIC_M_PORT, 1)),
+	    mic_rd(swr, SWR_DP_HCTRL(MIC_M_PORT, 0)), mic_rd(swr, SWR_DP_HCTRL(MIC_M_PORT, 1)));
+	/* (17r2c: no SCP_FrameCtrl reads here either: not acknowledged on this WCD, they set INT_STATUS bit 19) */
+	mic("r1c: %s: slave DP1 Int %#x, PrepareStatus %#x, ChannelEn_B0 %#x _B1 %#x; swr2 INT_STATUS now %#x\n", when,
+	    mic_cmd_read(swr, dev, SDW_DP1(0x00)), mic_cmd_read(swr, dev, SDW_DP1(0x04)),
+	    mic_cmd_read(swr, dev, SDW_DP1(0x20)), mic_cmd_read(swr, dev, SDW_DP1(0x30)), mic_rd(swr, SWR_INT_STATUS));
+	mic("r1c: %s: txmacro TX0_PATH_CTL %#x, TX0_PATH_CFG0 %#x, TX0_VOL_CTL %#x, TX0_PATH_SEC2 %#x, ADC_MUX0_CFG0 %#x "
+	    "CFG1 %#x\n", when, mic_rd(txm, TXM_TX0_PATH_CTL), mic_rd(txm, TXM_TX0_PATH_CFG0), mic_rd(txm, TXM_TX0_VOL_CTL),
+	    mic_rd(txm, TXM_TX0_PATH_SEC2), mic_rd(txm, TXM_ADC_MUX0_CFG0), mic_rd(txm, TXM_ADC_MUX0_CFG1));
+}
