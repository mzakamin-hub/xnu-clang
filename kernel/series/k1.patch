+	return no == 0;
+}
+
+/* the hw mode sent at start (tools/mk-ath12k.sh 18): boot-arg dadawifi_hwmode=N, 255 = none (as cld3), default 1 = DBS */
+int hakios_dada_wifi_hw_mode(void);
