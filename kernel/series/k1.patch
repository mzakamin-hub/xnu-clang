-$(OBJPATH)/version.c: $(SRCROOT)/config/version.c.template $(NEWVERS) $(XNU_VERSION)
+# (P4-1, ours) version.c had three inputs - the template, newvers.pl and xnuVersion - so a build after a commit
+# kept the previous build's date and git describe: the 12 Nov build's version line still said
+# "Wed Nov 11 11:36:56 EET 2026 ... xnu-12377.121.6-71-gf97f17a-dirty" while HEAD was 7820d6a, and a log's version
+# line did not name the build it came from. This stamp is the fourth input: HEAD, and a checksum of the tree's own
+# changes (BUILD/ is tracked in our worktree and always dirty, so it is left out). It is recomputed on every make
+# and rewritten only when its text changes, so an unchanged tree keeps the stamp's mtime and nothing relinks;
+# where git is missing or this is not a repository it is a fixed line and the build goes on.
+VERSION_STAMP = $(OBJPATH)/version.stamp
