+		    "STATUS %08x ERRCODE %08x ERRDBG1 %08x ERRDBG2 %08x ERRDBG3 %08x SBLANTIROLLVER %08x NUMSEG %08x (SERIALNU / MSMHWID / "
+		    "OEMPKHASH not read)\n", when, io_rd(bar, bhi + 4), io_rd(bar, bhi), io_rd(bar, bhi + 0xc), io_rd(bar, bhi + 8),
+		    io_rd(bar, bhi + 0x10), io_rd(bar, bhi + 0x18), io_rd(bar, bhi + 0x20), io_rd(bar, bhi + 0x28),
+		    e3_ee(io_rd(bar, bhi + 0x28)), io_rd(bar, bhi + 0x2c), io_rd(bar, bhi + 0x30), io_rd(bar, bhi + 0x34),
+		    io_rd(bar, bhi + 0x38), io_rd(bar, bhi + 0x3c), io_rd(bar, bhi + 0x44), io_rd(bar, bhi + 0x48));
+	}
+	if (bhie != 0 && bhie != 0xffffffffu && !(bhie & 3) && bhie + 0x80 <= 0x1000 && (chdb == 0 || bhie + 0x7c < chdb)) {
+		say("icepcie: 23e5 %s BHIe: MSMSOCID %08x TXVECADDR %08x_%08x TXVECSIZE %08x TXVECDB %08x TXVECSTATUS %08x; RXVECADDR "
+		    "%08x_%08x RXVECSIZE %08x RXVECDB %08x RXVECSTATUS %08x (status %u)\n", when, io_rd(bar, bhie), io_rd(bar, bhie + 0x30),
+		    io_rd(bar, bhie + 0x2c), io_rd(bar, bhie + 0x34), io_rd(bar, bhie + 0x3c), io_rd(bar, bhie + 0x44),
+		    io_rd(bar, bhie + 0x64), io_rd(bar, bhie + 0x60), io_rd(bar, bhie + 0x68), io_rd(bar, bhie + 0x70),
+		    io_rd(bar, bhie + 0x78), io_rd(bar, bhie + 0x78) >> 30);
+	}
+	if (dbg >= 0x100 && dbg <= 0xfc0 && !(dbg & 3)) {
+		say("icepcie: 23e5 %s MHI DEBUGOFF +%#x: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    when, dbg, io_rd(bar, dbg), io_rd(bar, dbg + 4), io_rd(bar, dbg + 8), io_rd(bar, dbg + 0xc), io_rd(bar, dbg + 0x10),
