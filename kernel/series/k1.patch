+static inline void
+amp_wait(void)
+{
+	uint64_t until;
+
+	if (__improbable(amp_half_ticks == 0)) {
+		amp_set_khz(amp_khz);
+	}
+	until = mach_absolute_time() + amp_half_ticks;
+	while (mach_absolute_time() < until) {
+	}
+}
