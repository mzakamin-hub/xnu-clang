--- /dev/null
+++ b/bsd/dev/hakios_iceland_sensors.c
@@ -0,0 +1,928 @@
+/*
+ * The OnePlus Pad 4's (iceland) sensors for macOS: a client of the ADSP service (hakios_iceland_adsp.h, iceadsp=1).
+ *
+ * Every sensor of the Pad sits behind the audio DSP's sensor hub (accelerometer + gyroscope BMI3x0, light + proximity
+ * STK36C01, magnetometer AK09919, the cover's hall sensor BU52053NVX); none is on a bus the application processor
+ * owns. The hub speaks the "SNS client" QMI service 400 over QRTR, and its sensors PD reads its registry and configs
+ * over FastRPC from the delivery's pack (sensors.tar; iceadsp_frpc_serve). The messages are protobuf; the interface
+ * facts (field numbers, message numbers) are those of hakios_iceland_adsp.c's level 11, which read them from libssc's
+ * .proto files (no libssc code, it is GPL-3.0).
+ *
+ *   icesns=1        (with iceadsp=1) the accelerometer, streaming at icesns_rate Hz (default 5), and the light sensor,
+ *                   reporting on change; gyro, proximity, hall and mag are looked up only (found or not)
+ *   icesns=2        also for information: proximity and hall enabled on change, gyro and mag streamed for
+ *                   icesns_info s (default 6), their first samples in the log
+ *   icesns_at=S     the client starts S s after this init (default 15)
+ *   icesns_secs=S   the client stops its sensors and releases the DSP after S s of running (default 0: never; the
+ *                   run's end stops them through the service)
+ *   icesns_fake_orient=N   nobody holds the Pad: icesns_fake_at s after the start (default 150) made-up accelerometer
+ *                   samples step the orientation through the edges 0, 1, 2, 3, 0, N s each, through the same path
+ *                   as the hub's (the sysctls, the HID reports); the real samples are left out meanwhile. No DSP
+ *                   is needed for it.
+ *   icesns_test=1   without any DSP (QEMU): made-up indications through the receive path and the orientation rule;
+ *                   one PASS / FAIL line. Nothing is sent, no register is touched.
+ * Results:
+ *   kern.iceaccel_x/_y/_z/_seq (mm/s2) and kern.icelux/_acc/_seq (milli-lux): hakios_iceland_adsp.c's sysctls
+ *   kern.iceorient      which edge of the Pad is up: -1 not known yet, 0 the sensor's +X (the stand's landscape, the
+ *                       panel's native picture upright), 1 its +Y, 2 its -X (upside down), 3 its -Y; lying flat or
+ *                       on a diagonal keeps the last answer. kern.iceorient_seq counts the changes.
+ * This file writes no register: its only effects are QMI messages to the hub (lookups, enable, disable).
+ * Lines go to the kernel log, prefixed "icesns:".
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include "hakios_iceland_adsp.h"
+
+void hakios_iceland_sensors_init(void);
+#if defined(XNU_TARGET_OS_OSX)
+/*
+ * macOS: each accelerometer sample as the HID motion sensor's report (iokit/Native/IcelandHid/IcelandHidProbe.cpp;
+ * returns at once without icehid_sns=1): mm/s2 on the three axes, and the edge that is up (kern.iceorient).
+ */
+extern void iceland_hid_sensor(int ax_mm, int ay_mm, int az_mm, int orient);
+#endif
+
+#define SNS_QMI_SERVICE         400
+#define QMI_REQUEST             0
+#define QMI_RESPONSE            2
+#define QMI_INDICATION          4
+#define SNS_MSG_CONTROL         0x20
+#define SNS_IND_SMALL           0x21
+#define SNS_IND_LARGE           0x22
+#define SNS_SUID_UID            0xababababababababull
+#define SNS_REQ_SUID            512
+#define SNS_REQ_STREAM          513             /* enable, continuous: {1 float sample_rate} */
+#define SNS_REQ_ON_CHANGE       514             /* enable, reports on change: no body */
+#define SNS_REQ_DISABLE         10
+#define SNS_EVENT_CONFIG        768             /* (also the SUID sensor's answer) */
+#define SNS_MEASUREMENT         1025
+
+enum { S_ACCEL, S_LIGHT, S_GYRO, S_PROX, S_HALL, S_MAG, S_COUNT };
+static const struct {
+	const char *type;
+	uint8_t stream;         /* 1: SNS_REQ_STREAM, 0: SNS_REQ_ON_CHANGE */
+	uint8_t level;          /* enabled from this icesns= on */
+} sns_kind[S_COUNT] = {
+	{ "accel", 1, 1 }, { "ambient_light", 0, 1 }, { "gyro", 1, 2 }, { "proximity", 0, 2 }, { "hall", 0, 2 }, { "mag", 1, 2 },
+};
+
+struct sns_one {
+	uint64_t low, high;
+	uint32_t samples, others;
+	bool answered, found, on, acked;
+};
+
+struct sns_state {
+	struct iceadsp_client client;
+	struct sns_one s[S_COUNT];
+	uint64_t at, ready_at, run_at, status_at;
+	uint32_t port, node, sport, txn, level, rate, info_s, hold;
+	uint32_t responses, bad_results, indications, unknown;
+	unsigned step, idx, tries;
+	int cand, cand_n;
+	bool server, info_off, want_stop, stopped;
+	volatile bool fake_active;     /* icesns_fake_orient: the made-up samples own the orientation */
+};
+static struct sns_state *sns;           /* (from kalloc: the kernel's __DATA is at its limit) */
+
+static int ice_orient = -1, ice_orient_seq;
+SYSCTL_INT(_kern, OID_AUTO, iceorient, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_orient, 0, "iceland: the edge that is up");
+SYSCTL_INT(_kern, OID_AUTO, iceorient_seq, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_orient_seq, 0, "iceland: its changes");
+
+static void say(const char *fmt, ...) __printflike(1, 2);
+
+static void
+say(const char *fmt, ...)
+{
+	char line[320];
+	va_list ap;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("icesns: %s", line);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static inline uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return le16(p) | (le16(p + 2) << 16);
+}
+
+static uint8_t *
+pb_varint(uint8_t *o, uint64_t v)
+{
+	do {
+		*o++ = (uint8_t)((v & 0x7f) | (v > 0x7f ? 0x80 : 0));
+		v >>= 7;
+	} while (v != 0);
+	return o;
+}
+
+static uint8_t *
+pb_fixed(uint8_t *o, uint64_t v, unsigned bytes)
+{
+	for (unsigned i = 0; i < bytes; i++) {
+		*o++ = (uint8_t)(v >> (8 * i));
+	}
+	return o;
+}
+
+/* one protobuf field: *field, *wire, the value (varint / fixed) or the bytes; NULL at the end or on an error */
+static const uint8_t *
+pb_next(const uint8_t *p, const uint8_t *end, uint32_t *field, uint32_t *wire, uint64_t *v, const uint8_t **b,
+    uint32_t *blen)
+{
+	uint64_t key = 0, x = 0;
+	unsigned s = 0;
+
+	if (p >= end) {
+		return NULL;
+	}
+	while (p < end && s < 64) {
+		key |= (uint64_t)(*p & 0x7f) << s;
+		s += 7;
+		if (!(*p++ & 0x80)) {
+			break;
+		}
+	}
+	*field = (uint32_t)(key >> 3);
+	*wire = (uint32_t)(key & 7);
+	*v = 0;
+	*b = NULL;
+	*blen = 0;
+	if (*wire == 0 || *wire == 2) {
+		for (s = 0; p < end && s < 64;) {
+			x |= (uint64_t)(*p & 0x7f) << s;
+			s += 7;
+			if (!(*p++ & 0x80)) {
+				break;
+			}
+		}
+		if (*wire == 0) {
+			*v = x;
+			return p;
+		}
+		if (x > (uint64_t)(end - p)) {
+			return NULL;
+		}
+		*b = p;
+		*blen = (uint32_t)x;
+		return p + x;
+	}
+	if (*wire == 1 || *wire == 5) {
+		unsigned n = *wire == 1 ? 8 : 4;
+
+		if ((uint64_t)(end - p) < n) {
+			return NULL;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			x |= (uint64_t)p[i] << (8 * i);
+		}
+		*v = x;
+		return p + n;
+	}
+	return NULL;
+}
+
+/* a float's bits as milli-units (the kernel's printf has no %f) */
+static int32_t
+milli(uint32_t bits)
+{
+	int exp = (int)((bits >> 23) & 0xff) - 127, sign = (bits >> 31) ? -1 : 1;
+	uint64_t m = ((uint64_t)(bits & 0x7fffff) | 0x800000) * 1000;
+
+	if (((bits >> 23) & 0xff) == 0 || exp < -20) {
+		return 0;
+	}
+	if (exp > 20) {
+		return sign * 2000000000;
+	}
+	m = exp >= 23 ? m << (exp - 23) : m >> (23 - exp);
+	return sign * (int32_t)m;
+}
+
+/* a small whole number as a float's bits */
+static uint32_t
+float_bits(uint32_t n)
+{
+	int top = 31;
+
+	if (n == 0) {
+		return 0;
+	}
+	while (!(n & (1u << top))) {
+		top--;
+	}
+	n = top > 23 ? n >> (top - 23) : n << (23 - top);
+	return ((uint32_t)(top + 127) << 23) | (n & 0x7fffff);
+}
+
+/* one SscClientRequest in a QMI control request (report type large); only from the service's callbacks */
+static bool
+sns_request(uint64_t low, uint64_t high, uint32_t msg_id, const uint8_t *msg, uint32_t msg_len, const char *what)
+{
+	uint8_t pb[120], qmi[160], *o = pb, *q = qmi;
+	uint32_t pb_len;
+
+	if (msg_len > 60) {
+		return false;
+	}
+	*o++ = 0x0a; *o++ = 18;                                         /* 1 uid */
+	*o++ = 0x09; o = pb_fixed(o, low, 8);
+	*o++ = 0x11; o = pb_fixed(o, high, 8);
+	*o++ = 0x15; o = pb_fixed(o, msg_id, 4);                        /* 2 msg_id */
+	*o++ = 0x1a; *o++ = 4; *o++ = 0x08; *o++ = 1; *o++ = 0x10; *o++ = 0;   /* 3 config: APPS, wakeup */
+	*o++ = 0x22;                                                    /* 4 request */
+	if (msg_len != 0) {
+		o = pb_varint(o, 2 + msg_len);
+		*o++ = 0x12;
+		o = pb_varint(o, msg_len);
+		memcpy(o, msg, msg_len);
+		o += msg_len;
+	} else {
+		*o++ = 0;
+	}
+	pb_len = (uint32_t)(o - pb);
+	*q++ = QMI_REQUEST;
+	q = pb_fixed(q, sns->txn, 2);
+	q = pb_fixed(q, SNS_MSG_CONTROL, 2);
+	q = pb_fixed(q, 3 + 2 + pb_len + 3 + 1, 2);
+	*q++ = 0x01; q = pb_fixed(q, 2 + pb_len, 2); q = pb_fixed(q, pb_len, 2);
+	memcpy(q, pb, pb_len);
+	q += pb_len;
+	*q++ = 0x10; q = pb_fixed(q, 1, 2); *q++ = 1;                   /* report type large */
+	if (!iceadsp_qrtr_send(sns->port, sns->node, sns->sport, qmi, (uint32_t)(q - qmi))) {
+		say("> %s NOT SENT\n", what);
+		return false;
+	}
+	say("> %s (txn %u, msg %u)\n", what, sns->txn, msg_id);
+	sns->txn = (sns->txn + 1) & 0xffff;
+	return true;
+}
+
+static bool
+sns_suid(unsigned i)
+{
+	uint8_t m[40], *o = m;
+	uint32_t n = (uint32_t)strlen(sns_kind[i].type);
+
+	*o++ = 0x0a; *o++ = (uint8_t)n;
+	memcpy(o, sns_kind[i].type, n);
+	o += n;
+	*o++ = 0x10; *o++ = 0;                  /* enable_updates false */
+	*o++ = 0x18; *o++ = 1;                  /* only_default_values true */
+	sns->s[i].answered = false;
+	return sns_request(SNS_SUID_UID, SNS_SUID_UID, SNS_REQ_SUID, m, (uint32_t)(o - m), sns_kind[i].type);
+}
+
+static void
+sns_enable(unsigned i, bool on)
+{
+	struct sns_one *s = &sns->s[i];
+	char what[48];
+	uint8_t m[8], *o = m;
+
+	snprintf(what, sizeof(what), "%s %s", sns_kind[i].type, on ? (sns_kind[i].stream ? "stream" : "on change") : "off");
+	if (on && sns_kind[i].stream) {
+		*o++ = 0x0d;
+		o = pb_fixed(o, float_bits(sns->rate), 4);
+	}
+	if (sns_request(s->low, s->high, !on ? SNS_REQ_DISABLE : sns_kind[i].stream ? SNS_REQ_STREAM : SNS_REQ_ON_CHANGE, m,
+	    (uint32_t)(o - m), what)) {
+		s->on = on;
+	}
+}
+
+/*
+ * Which edge is up, from one sample (mm/s2; the accelerometer reads +g on the axis that points up). An edge counts
+ * when its axis holds more than twice the other in-plane axis and the Pad is not near flat; it becomes the answer
+ * after sns->hold samples in a row. Flat and diagonal samples change nothing.
+ */
+static void
+sns_orient(int x, int y, int z)
+{
+	int ax = x < 0 ? -x : x, ay = y < 0 ? -y : y, az = z < 0 ? -z : z, cand = -1;
+
+	if (az < 8500 && (ax > 4000 || ay > 4000)) {
+		if (ax >= 2 * ay) {
+			cand = x > 0 ? 0 : 2;
+		} else if (ay >= 2 * ax) {
+			cand = y > 0 ? 1 : 3;
+		}
+	}
+	if (cand < 0) {
+		sns->cand_n = 0;
+		return;
+	}
+	sns->cand_n = cand == sns->cand ? sns->cand_n + 1 : 1;
+	sns->cand = cand;
+	if (cand != ice_orient && sns->cand_n >= (int)sns->hold) {
+		static const char *const edge[4] = { "+X (the stand's landscape)", "+Y", "-X (upside down)", "-Y" };
+
+		ice_orient = cand;
+		ice_orient_seq++;
+		say("ORIENT %d: the sensor's %s edge is up (x %d y %d z %d mm/s2), change %d\n", cand, edge[cand], x, y, z,
+		    ice_orient_seq);
+	}
+}
+
+/* one accelerometer sample to everything that reads it: the sysctls, the orientation, the HID motion sensor */
+static void
+sns_feed_accel(int x, int y, int z)
+{
+	iceadsp_sns_accel(x, y, z);
+	sns_orient(x, y, z);
+#if defined(XNU_TARGET_OS_OSX)
+	iceland_hid_sensor(x, y, z, ice_orient);
+#endif
+}
+
+/* up to three floats of a measurement's field 1 (plain or packed), its accuracy (field 2) */
+static unsigned
+sns_floats(const uint8_t *m, uint32_t len, uint32_t out[3], uint32_t *accuracy)
+{
+	const uint8_t *p = m, *end = m + len, *b;
+	uint32_t f, w, bl;
+	uint64_t v;
+	unsigned n = 0;
+
+	while ((p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL) {
+		if (f == 1 && w == 5 && n < 3) {
+			out[n++] = (uint32_t)v;
+		} else if (f == 1 && w == 2) {
+			for (uint32_t i = 0; i + 4 <= bl && n < 3; i += 4) {
+				out[n++] = le32(b + i);
+			}
+		} else if (f == 2 && w == 0) {
+			*accuracy = (uint32_t)v;
+		}
+	}
+	return n;
+}
+
+/* a message nobody decodes here: its number and first fields, a few times per sensor */
+static void
+sns_other(const char *type, struct sns_one *s, uint32_t msg_id, const uint8_t *m, uint32_t len)
+{
+	const uint8_t *p = m, *end = m + len, *b;
+	char text[120];
+	uint32_t f, w, bl;
+	uint64_t v;
+	int t = 0;
+
+	if (s != NULL && s->others++ >= 8) {
+		return;
+	}
+	if (s == NULL && sns->unknown++ >= 12) {
+		return;
+	}
+	text[0] = 0;
+	for (int k = 0; k < 4 && t < (int)sizeof(text) - 40 && (p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL; k++) {
+		if (w == 2) {
+			t += snprintf(text + t, sizeof(text) - (size_t)t, " f%u=[%u B]", f, bl);
+		} else {
+			t += snprintf(text + t, sizeof(text) - (size_t)t, " f%u=%#llx", f, v);
+		}
+	}
+	say("< %s: msg %u, %u bytes:%s\n", type, msg_id, len, text);
+}
+
+/* one SscClientResponse body */
+static void
+sns_body(uint64_t low, uint64_t high, uint32_t msg_id, const uint8_t *m, uint32_t len)
+{
+	const uint8_t *p = m, *end = m + len, *b;
+	uint32_t f, w, bl, val[3] = { 0, 0, 0 }, accuracy = 0;
+	uint64_t v;
+	unsigned i, n;
+
+	if (low == SNS_SUID_UID && high == SNS_SUID_UID && msg_id == SNS_EVENT_CONFIG) {
+		char type[24] = { 0 };
+		uint64_t ul = 0, uh = 0;
+		unsigned uids = 0;
+
+		while ((p = pb_next(p, end, &f, &w, &v, &b, &bl)) != NULL) {
+			if (f == 1 && w == 2) {
+				memcpy(type, b, bl < sizeof(type) - 1 ? bl : sizeof(type) - 1);
+			} else if (f == 2 && w == 2) {
+				const uint8_t *r = b, *re = b + bl, *bb;
+				uint32_t ff, ww, bbl;
+				uint64_t vv;
+
+				while ((r = pb_next(r, re, &ff, &ww, &vv, &bb, &bbl)) != NULL) {
+					if (ff == 1 && uids == 0) {
+						ul = vv;
+					} else if (ff == 2 && uids == 0) {
+						uh = vv;
+					}
+				}
+				uids++;
+			}
+		}
+		say("< SUID \"%s\": %u sensor(s)%s\n", type, uids, uids ? "" : " -- NONE");
+		for (i = 0; i < S_COUNT; i++) {
+			if (strcmp(type, sns_kind[i].type) == 0) {
+				sns->s[i].answered = true;
+				sns->s[i].found = uids != 0;
+				sns->s[i].low = ul;
+				sns->s[i].high = uh;
+			}
+		}
+		return;
+	}
+	for (i = 0; i < S_COUNT; i++) {
+		if (sns->s[i].found && sns->s[i].low == low && sns->s[i].high == high) {
+			break;
+		}
+	}
+	if (i == S_COUNT) {
+		sns_other("an unknown sensor", NULL, msg_id, m, len);
+		return;
+	}
+	if (msg_id == SNS_EVENT_CONFIG) {
+		if (!sns->s[i].acked) {
+			say("< %s: its configuration came (%u bytes): enabled\n", sns_kind[i].type, len);
+		}
+		sns->s[i].acked = true;
+		return;
+	}
+	if (msg_id != SNS_MEASUREMENT || (i != S_ACCEL && i != S_LIGHT && i != S_GYRO && i != S_MAG)) {
+		sns->s[i].samples += msg_id > SNS_EVENT_CONFIG;
+		sns_other(sns_kind[i].type, &sns->s[i], msg_id, m, len);
+		return;
+	}
+	n = sns_floats(m, len, val, &accuracy);
+	if (n == 0) {
+		sns_other(sns_kind[i].type, &sns->s[i], msg_id, m, len);
+		return;
+	}
+	sns->s[i].samples++;
+	if (i == S_LIGHT) {
+		int mlux = milli(val[0]);
+
+		mlux = mlux < 0 ? 0 : mlux;
+		iceadsp_sns_lux(mlux, (int)accuracy);
+		if (sns->s[i].samples <= 10 || sns->s[i].samples % 250 == 0) {
+			say("< LIGHT %u: %d.%03d lux (accuracy %u)\n", sns->s[i].samples, mlux / 1000, mlux % 1000, accuracy);
+		}
+		return;
+	}
+	{
+		int x = milli(val[0]), y = milli(val[1]), z = milli(val[2]);
+
+		if (i == S_ACCEL && !sns->fake_active) {
+			sns_feed_accel(x, y, z);
+		}
+		if (sns->s[i].samples <= (i == S_ACCEL ? 10u : 5u) || (i == S_ACCEL && sns->s[i].samples % 1500 == 0)) {
+			say("< %s %u: x %d y %d z %d (milli-units, accuracy %u)\n", i == S_ACCEL ? "ACCEL" : sns_kind[i].type,
+			    sns->s[i].samples, x, y, z, accuracy);
+		}
+	}
+}
+
+/* a QMI packet from the service: the control response, or an indication with an SscClientResponse */
+static void
+sns_qmi(const uint8_t *p, uint32_t len)
+{
+	uint32_t type, msg, mlen, at, data_len = 0, result = ~0u, error = ~0u;
+	const uint8_t *data = NULL;
+
+	if (len < 7) {
+		return;
+	}
+	type = p[0];
+	msg = le16(p + 3);
+	mlen = le16(p + 5);
+	if (mlen > len - 7) {
+		return;
+	}
+	for (at = 7; at + 3 <= 7 + mlen;) {
+		uint32_t t = p[at], l = le16(p + at + 1);
+
+		if (at + 3 + l > 7 + mlen) {
+			break;
+		}
+		if (t == 0x02 && type == QMI_RESPONSE && l >= 4) {
+			result = le16(p + at + 3);
+			error = le16(p + at + 5);
+		} else if (t == 0x02 && type == QMI_INDICATION && l >= 2) {
+			data_len = le16(p + at + 3) < l - 2 ? le16(p + at + 3) : l - 2;
+			data = p + at + 5;
+		}
+		at += 3 + l;
+	}
+	if (type == QMI_RESPONSE) {
+		sns->responses++;
+		if (result != 0) {
+			sns->bad_results++;
+			say("< response txn %u: result %u error %u\n", le16(p + 1), result, error);
+		}
+		return;
+	}
+	if (type != QMI_INDICATION || (msg != SNS_IND_SMALL && msg != SNS_IND_LARGE) || data == NULL) {
+		return;
+	}
+	sns->indications++;
+	{
+		const uint8_t *q = data, *end = data + data_len, *b;
+		uint32_t f, w, bl;
+		uint64_t v, low = 0, high = 0;
+
+		while ((q = pb_next(q, end, &f, &w, &v, &b, &bl)) != NULL) {
+			const uint8_t *r = b, *re = b + bl, *bb, *m = NULL;
+			uint32_t ff, ww, bbl, ml = 0, mid = 0;
+			uint64_t vv;
+
+			if (w != 2) {
+				continue;
+			}
+			while ((r = pb_next(r, re, &ff, &ww, &vv, &bb, &bbl)) != NULL) {
+				if (f == 1 && ff == 1) {
+					low = vv;
+				} else if (f == 1 && ff == 2) {
+					high = vv;
+				} else if (f == 2 && ff == 1) {
+					mid = (uint32_t)vv;
+				} else if (f == 2 && ff == 3 && ww == 2) {
+					m = bb;
+					ml = bbl;
+				}
+			}
+			if (f == 2) {
+				sns_body(low, high, mid, m != NULL ? m : b, ml);
+			}
+		}
+	}
+}
+
+static void
+sns_status(const char *why)
+{
+	say("%s: accel %u samples, light %u, gyro %u, proximity %u, hall %u, mag %u; orient %d (%d changes); %u indications, "
+	    "%u responses (%u refused)\n", why, sns->s[S_ACCEL].samples, sns->s[S_LIGHT].samples, sns->s[S_GYRO].samples,
+	    sns->s[S_PROX].samples, sns->s[S_HALL].samples, sns->s[S_MAG].samples, ice_orient, ice_orient_seq,
+	    sns->indications, sns->responses, sns->bad_results);
+}
+
+/* ---- the service's callbacks (its pump thread) ---- */
+static void
+sns_ready(__unused struct iceadsp_client *c)
+{
+	for (unsigned i = 0; i < S_COUNT; i++) {
+		sns->s[i].answered = sns->s[i].found = sns->s[i].on = sns->s[i].acked = false;
+	}
+	sns->step = 0;
+	sns->idx = sns->tries = 0;
+	sns->info_off = sns->stopped = false;
+	sns->ready_at = now_us();
+	say("the DSP is ready; the hub's service %s\n", sns->server ? "is known" : "is not announced yet");
+}
+
+static void
+sns_server(__unused struct iceadsp_client *c, __unused uint32_t service, uint32_t instance, uint32_t node, uint32_t port,
+    bool gone)
+{
+	say("the hub's service 400 (instance %#x) at %u:%u %s\n", instance, node, port, gone ? "is GONE" : "is there");
+	sns->server = !gone;
+	if (!gone) {
+		sns->node = node;
+		sns->sport = port;
+	}
+}
+
+static void
+sns_packet(__unused struct iceadsp_client *c, __unused uint32_t node, __unused uint32_t port, const uint8_t *data,
+    uint32_t len)
+{
+	sns_qmi(data, len);
+}
+
+static void
+sns_all_off(void)
+{
+	for (unsigned i = 0; i < S_COUNT; i++) {
+		if (sns->s[i].on) {
+			sns_enable(i, false);
+		}
+	}
+}
+
+static void
+sns_tick(__unused struct iceadsp_client *c)
+{
+	uint64_t now = now_us();
+	struct sns_one *s;
+
+	switch (sns->step) {
+	case 0:         /* the service known, and 2 s for the hub after the file server's turn */
+		if (sns->server && now - sns->ready_at > 2000000ull) {
+			sns->step = 1;
+			sns->idx = sns->tries = 0;
+			(void)sns_suid(0);
+			sns->at = now;
+		}
+		break;
+	case 1:         /* the lookups, one at a time; the accelerometer's again while the hub still lists none */
+		s = &sns->s[sns->idx];
+		if (now - sns->at < (s->answered && (s->found || sns->idx != S_ACCEL) ? 100000ull : 2000000ull)) {
+			break;
+		}
+		if (sns->idx == S_ACCEL && !s->found && sns->tries < 15) {
+			sns->tries++;
+		} else if (++sns->idx == S_COUNT) {
+			sns->step = 2;
+			break;
+		}
+		(void)sns_suid(sns->idx);
+		sns->at = now;
+		break;
+	case 2:
+		for (unsigned i = 0; i < S_COUNT; i++) {
+			if (sns->s[i].found && sns->level >= sns_kind[i].level) {
+				sns_enable(i, true);
+			}
+		}
+		say("lookups done: accel %s, light %s, gyro %s, proximity %s, hall %s, mag %s%s\n", sns->s[S_ACCEL].found ?
+		    "found" : "NOT FOUND", sns->s[S_LIGHT].found ? "found" : "NOT FOUND", sns->s[S_GYRO].found ? "found" : "none",
+		    sns->s[S_PROX].found ? "found" : "none", sns->s[S_HALL].found ? "found" : "none", sns->s[S_MAG].found ?
+		    "found" : "none", sns->s[S_ACCEL].found || sns->s[S_LIGHT].found ? "" : " -- NOTHING TO READ");
+		sns->run_at = sns->status_at = now;
+		sns->step = 3;
+		break;
+	case 3:
+		if (!sns->info_off && now - sns->run_at > (uint64_t)sns->info_s * 1000000ull) {
+			sns->info_off = true;   /* the two streams that are only information end here */
+			if (sns->s[S_GYRO].on) {
+				sns_enable(S_GYRO, false);
+			}
+			if (sns->s[S_MAG].on) {
+				sns_enable(S_MAG, false);
+			}
+			sns_status("first look");
+		}
+		if (now - sns->status_at > 60000000ull) {
+			sns->status_at = now;
+			sns_status("status");
+		}
+		if (sns->want_stop) {
+			sns_all_off();
+			sns_status("stopped (icesns_secs)");
+			sns->step = 4;
+			sns->at = now;
+		}
+		break;
+	case 4:         /* 300 ms for the answers, then the thread releases */
+		if (now - sns->at > 300000ull) {
+			sns->stopped = true;
+		}
+		break;
+	}
+}
+
+static void
+sns_stop(__unused struct iceadsp_client *c)
+{
+	sns_all_off();
+	sns_status("the run ends");
+	sns->stopped = true;
+}
+
+static void
+sns_crashed(__unused struct iceadsp_client *c)
+{
+	say("the DSP went down: the sensors are looked up again when it is back\n");
+	sns->server = false;
+	sns->step = 0;
+}
+
+/* ---- icesns_test=1: the receive path and the orientation rule on made-up indications (no DSP) ---- */
+static void
+sns_test_ind(uint64_t low, uint64_t high, uint32_t msg_id, const uint8_t *msg, uint32_t msg_len)
+{
+	uint8_t body[80], pb[120], qmi[160], *o = body, *q = qmi;
+	uint32_t body_len, pb_len;
+
+	*o++ = 0x0d; o = pb_fixed(o, msg_id, 4);
+	*o++ = 0x11; o = pb_fixed(o, 19200000, 8);
+	*o++ = 0x1a; *o++ = (uint8_t)msg_len;
+	memcpy(o, msg, msg_len);
+	body_len = (uint32_t)(o - body) + msg_len;
+	o = pb;
+	*o++ = 0x0a; *o++ = 18;
+	*o++ = 0x09; o = pb_fixed(o, low, 8);
+	*o++ = 0x11; o = pb_fixed(o, high, 8);
+	*o++ = 0x12; *o++ = (uint8_t)body_len;
+	memcpy(o, body, body_len);
+	pb_len = (uint32_t)(o - pb) + body_len;
+	*q++ = QMI_INDICATION;
+	q = pb_fixed(q, 0, 2);
+	q = pb_fixed(q, SNS_IND_LARGE, 2);
+	q = pb_fixed(q, 3 + 8 + 3 + 2 + pb_len, 2);
+	*q++ = 0x01; q = pb_fixed(q, 8, 2); q = pb_fixed(q, 1, 8);
+	*q++ = 0x02; q = pb_fixed(q, 2 + pb_len, 2); q = pb_fixed(q, pb_len, 2);
+	memcpy(q, pb, pb_len);
+	sns_qmi(qmi, (uint32_t)(q - qmi) + pb_len);
+}
+
+static void
+sns_test_suid(const char *type, uint64_t low, uint64_t high)
+{
+	uint8_t m[60], *o = m;
+	uint32_t n = (uint32_t)strlen(type);
+
+	*o++ = 0x0a; *o++ = (uint8_t)n;
+	memcpy(o, type, n);
+	o += n;
+	*o++ = 0x12; *o++ = 18;
+	*o++ = 0x09; o = pb_fixed(o, low, 8);
+	*o++ = 0x11; o = pb_fixed(o, high, 8);
+	sns_test_ind(SNS_SUID_UID, SNS_SUID_UID, SNS_EVENT_CONFIG, m, (uint32_t)(o - m));
+}
+
+static void
+sns_test_xyz(uint64_t low, uint32_t x, uint32_t y, uint32_t z, bool packed)
+{
+	uint8_t m[24], *o = m;
+
+	if (packed) {
+		*o++ = 0x0a; *o++ = 12; o = pb_fixed(o, x, 4); o = pb_fixed(o, y, 4); o = pb_fixed(o, z, 4);
+	} else {
+		*o++ = 0x0d; o = pb_fixed(o, x, 4); *o++ = 0x0d; o = pb_fixed(o, y, 4); *o++ = 0x0d; o = pb_fixed(o, z, 4);
+	}
+	*o++ = 0x10; *o++ = 3;
+	sns_test_ind(low, 0x5555666677778888ull, SNS_MEASUREMENT, m, (uint32_t)(o - m));
+}
+
+static void
+sns_selftest(void)
+{
+	static const uint8_t lux[] = { 0x0d, 0x00, 0x00, 0xd0, 0x40, 0x0d, 0x00, 0x00, 0xc8, 0x42, 0x10, 0x03 };  /* 6.5 */
+	int o1, o2, o3, z, mlux;
+	bool ok;
+
+	sns->hold = 3;
+	sns_test_suid("accel", 0x1111, 0x5555666677778888ull);
+	sns_test_suid("ambient_light", 0x2222, 0x5555666677778888ull);
+	for (int i = 0; i < 4; i++) {
+		sns_test_xyz(0x1111, 0x41028f5c, 0x3ca3d70a, 0x40beb852, false);       /* 8.16 0.02 5.96: the stand */
+	}
+	o1 = ice_orient;
+	for (int i = 0; i < 4; i++) {
+		sns_test_xyz(0x1111, 0x3dcccccd, 0xc1100000, 0x40000000, true);        /* 0.1 -9.0 2.0: the -Y edge up */
+	}
+	o2 = ice_orient;
+	for (int i = 0; i < 4; i++) {
+		sns_test_xyz(0x1111, 0, 0, 0x411ccccd, false);                         /* 0 0 9.8: flat */
+	}
+	o3 = ice_orient;
+	sns_test_ind(0x2222, 0x5555666677778888ull, SNS_MEASUREMENT, lux, sizeof(lux));
+	z = iceadsp_sns_test_read(0);
+	mlux = iceadsp_sns_test_read(1);
+	ok = o1 == 0 && o2 == 3 && o3 == 3 && ice_orient_seq == 2 && z >= 9799 && z <= 9801 && mlux == 6500 &&
+	    sns->s[S_ACCEL].samples == 12 && sns->s[S_LIGHT].samples == 1 && sns->s[S_ACCEL].found && sns->s[S_LIGHT].found;
+	say("selftest %s: orient %d, %d, %d (wanted 0, 3, 3), %d changes (2), accel z %d mm/s2 (9800), light %d milli-lux "
+	    "(6500), %u + %u samples (12 + 1); the values stay in the sysctls\n", ok ? "PASS" : "FAIL", o1, o2, o3,
+	    ice_orient_seq, z, mlux, sns->s[S_ACCEL].samples, sns->s[S_LIGHT].samples);
+}
+
+static void
+sns_main(void *parameter, __unused wait_result_t result)
+{
+	uint32_t at_s = (uint32_t)(uintptr_t)parameter, secs = 0;
+	int r;
+
+	PE_parse_boot_argn("icesns_secs", &secs, sizeof(secs));
+	delay_for_interval(at_s * 1000, NSEC_PER_MSEC);
+	sns->client.name = "icesns";
+	sns->client.ready = sns_ready;
+	sns->client.tick = sns_tick;
+	sns->client.stop = sns_stop;
+	sns->client.crashed = sns_crashed;
+	r = iceadsp_acquire(&sns->client);
+	if (r != 0) {
+		say("REFUSED: the ADSP service did not take us (%d; iceadsp=1 is needed): nothing sent\n", r);
+		return;
+	}
+	if (iceadsp_qrtr_register(&sns->client, SNS_QMI_SERVICE, sns_server, sns_packet, &sns->port) != 0) {
+		iceadsp_release(&sns->client);
+		return;
+	}
+	(void)iceadsp_frpc_serve(&sns->client, NULL);
+	say("level %u: accel at %u Hz + light on change%s; waiting for the DSP\n", sns->level, sns->rate, sns->level >= 2 ?
+	    "; gyro, proximity, hall and mag for information" : "");
+	if (secs == 0) {
+		return;         /* (the run's end stops the sensors through the service) */
+	}
+	for (uint32_t s = 0; s < secs + 120 && sns->step < 3 && !sns->stopped; s++) {
+		delay_for_interval(1000, NSEC_PER_MSEC);
+	}
+	for (uint32_t s = 0; s < secs && !sns->stopped; s++) {
+		delay_for_interval(1000, NSEC_PER_MSEC);
+	}
+	if (!sns->stopped) {
+		sns->want_stop = true;
+		for (int i = 0; i < 300 && !sns->stopped; i++) {
+			delay_for_interval(10, NSEC_PER_MSEC);
+		}
+		iceadsp_release(&sns->client);
+	}
+}
+
+/*
+ * icesns_fake_orient=N: the four edges in turn, with nobody holding the Pad (the rotation's unattended tests). 9 m/s2
+ * on the edge's axis and 3.9 on z, as on a stand; 5 Hz, so an edge is taken after a second (sns->hold).
+ */
+static void
+sns_fake_main(void *parameter, __unused wait_result_t result)
+{
+	static const int8_t ex[5] = { 1, 0, -1, 0, 1 }, ey[5] = { 0, 1, 0, -1, 0 };
+	uint32_t secs = (uint32_t)(uintptr_t)parameter, at_s = 150;
+
+	PE_parse_boot_argn("icesns_fake_at", &at_s, sizeof(at_s));
+	delay_for_interval((at_s > 3600 ? 3600 : at_s) * 1000, NSEC_PER_MSEC);
+	sns->fake_active = true;
+	for (unsigned k = 0; k < 5; k++) {
+		say("FAKE orient step %u of 5: edge %u for %u s (made-up samples; the real accelerometer is left out)\n", k + 1,
+		    k & 3, secs);
+		for (uint32_t i = 0; i < secs * 5; i++) {
+			sns_feed_accel(ex[k] * 9000, ey[k] * 9000, 3900);
+			delay_for_interval(200, NSEC_PER_MSEC);
+		}
+	}
+	sns->fake_active = false;
+	say("FAKE orient over: orient %d, %d changes in all; the real accelerometer counts again\n", ice_orient,
+	    ice_orient_seq);
+}
+
+void
+hakios_iceland_sensors_init(void)
+{
+	uint32_t level = 0, test = 0, at_s = 15, svc = 0, fake = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icesns", &level, sizeof(level)) && iceadsp_share_on()) {
+		level = 1;                      /* laneD: the share brings the client (accel + light) with it */
+	}
+	PE_parse_boot_argn("icesns_test", &test, sizeof(test));
+	PE_parse_boot_argn("icesns_fake_orient", &fake, sizeof(fake));
+	if (level == 0 && test == 0 && fake == 0) {
+		return;
+	}
+	sns = kalloc_data(sizeof(*sns), Z_WAITOK | Z_ZERO);
+	if (sns == NULL) {
+		return;
+	}
+	sns->level = level;
+	sns->rate = 5;
+	sns->info_s = 6;
+	sns->txn = 1;
+	sns->cand = -1;
+	PE_parse_boot_argn("icesns_rate", &sns->rate, sizeof(sns->rate));
+	PE_parse_boot_argn("icesns_info", &sns->info_s, sizeof(sns->info_s));
+	sns->rate = sns->rate < 1 ? 1 : sns->rate > 50 ? 50 : sns->rate;
+	sns->hold = sns->rate;          /* an edge must hold for about a second */
+	if (test != 0) {
+		sns_selftest();
+		sns->hold = sns->rate;
+	}
+	if (fake != 0) {
+		fake = fake > 600 ? 600 : fake;
+		if (kernel_thread_start(sns_fake_main, (void *)(uintptr_t)fake, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	if (level == 0) {
+		return;
+	}
+	if ((!PE_parse_boot_argn("iceadsp", &svc, sizeof(svc)) || svc == 0) && !iceadsp_share_on()) {
+		say("REFUSED: icesns=%u needs iceadsp=1 or iceadsp_share=1 (the ADSP service): nothing started\n", level);
+		return;
+	}
+	PE_parse_boot_argn("icesns_at", &at_s, sizeof(at_s));
+	at_s = at_s > 600 ? 600 : at_s;
+	if (kernel_thread_start(sns_main, (void *)(uintptr_t)at_s, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_touch.c b/bsd/dev/hakios_iceland_touch.c
new file mode 100644
index 0000000000000000000000000000000000000000..3d35d2c8b2942b3f6ea188c1dd07734f7b178e00
--- /dev/null
+++ b/bsd/dev/hakios_iceland_touch.c
@@ -0,0 +1,1365 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") touch screen: the touch half of the Novatek NT36536 TDDI (the
+ * display driver IC with touch), on SPI, as a source of touches for /dev/redwood-touch (sys/redwood_input.h). Only
+ * with boot-arg icetouch=N; without it nothing here touches the hardware.
+ *
+ * Every value is the Pad's own, from its mainline Linux (the tree that runs on this tablet in Fedora):
+ *   kaanapali-oneplus-iceland.dts  &spi19 { touchscreen@0 { compatible = "novatek,NVT-ts-spi"; spi-max-frequency =
+ *                                  12 MHz; irq-gpios = <&tlmm 158 ..>; novatek,pen-support; firmware-name =
+ *                                  "novatek/novatek_nt36536_fw.bin" } }: no reset line and no supplies of its own --
+ *                                  the touch half is powered and reset with the panel, which ABL has left on
+ *   kaanapali.dtsi                 spi19: spi@1a80000 (QUP4 SE0), pins qup_spi19_data_clk = gpio48 MISO, gpio49 MOSI,
+ *                                  gpio50 CLK, qup_spi19_cs = gpio51, function "qup4_se0", 6 mA, no bias;
+ *                                  tlmm: pinctrl@f100000; gpio-reserved-ranges <36 8>, <74 1>, <119 2>, <144 4> (none
+ *                                  of ours)
+ *   pinctrl-kaanapali.c            a pin's registers at 0x1000 * n: ctl (+0: [1:0] pull, [5:2] function, [8:6] drive,
+ *                                  [9] output enable, [11] egpio present, [12] egpio enable = "ours"), io (+4: [0] in,
+ *                                  [1] out), intr_cfg (+8: [0] enable, [1] polarity, [3:2] detection, [4] raw status),
+ *                                  intr_status (+0xc: [0], cleared by writing 0); function 0 = gpio, 1 = qup4_se0
+ *   drivers/input/touchscreen/nt36536/nt36xxx.c, nt36xxx_fw_update.c, nt36xxx_mem_map.h: the chip's protocol, its
+ *                                  identification (trim id 0x14/0x15 .. 0x23 0x65 0x03 = NT36536, NT36532_hw_info: CRC
+ *                                  banks of 3 bytes, auto copy checked by TX_AUTO_COPY_EN), the firmware download into
+ *                                  its SRAM (there is no flash: Linux downloads it at every panel enable), the report
+ *                                  layout and the coordinate mapping (x = bytes 3-4, y = abs_y_max - 1 - bytes 1-2)
+ *   Linux's log on this tablet:    "Cascade Chip", fw_ver 0x15, abs_x_max 33920, abs_y_max 24000
+ *
+ * The bus: on another SM8850 device the same serial engine (QUP4 SE0, 0x1a80000) has its FIFO interface disabled (GPI
+ * DMA only, behind the SMMU), and Linux here declares GPI DMA channels for it. Reading the engine's own registers needs
+ * its clocks and interconnect votes first; instead, until a GPI DMA driver exists, the four pins are driven by hand, as the HakiOS dada port does for the Xiaomi 15's touch screen
+ * (hakios_dada_touch.c, the method only): SPI mode 0, MSB first, every pin write ordered by a read back. That is far
+ * below the chip's 12 MHz, which a clocked serial slave does not mind; it costs a few seconds for the 252 KB firmware
+ * and ~1-2 ms for a report.
+ *
+ * The interrupt line (gpio158, a rising edge for each new report) is not wired to an interrupt: its TLMM edge detector
+ * latches (raw status on, interrupt enable off, so nothing reaches the GIC) and the thread looks at the latch every
+ * icetouch_poll_us; besides, it reads the report every 25 ms while a finger is down and every 200 ms otherwise.
+ *
+ * Coordinates follow the display the kernel gives user space (fbrotate, iokit/Kernel/MiniIOMobileFramebuffer.cpp):
+ * Linux's x runs along the panel's 3392-pixel side, its y along the 2400 -- turned 180 degrees against the boot
+ * framebuffer the kernel draws into (measured, run ipad4): framebuffer column c = 1 - x, row r = 1 - y. With fbrotate=270
+ * the upright picture's row y is framebuffer column y and its x goes up from the bottom row, so a touch at column c, row
+ * r is at upright x = 1 - r, y = c (as fractions); with 90, x = r, y = 1 - c.
+ *
+ *   icetouch=1  pins as found, then the chip identified (bootloader reset + trim id; the pins as GPIOs meanwhile and
+ *               put back after); nothing else
+ *   icetouch=2  ... and the firmware downloaded (fw/novatek_nt36536_fw.bin of the small image, md1, or md0), its CRC
+ *               state, the chip's own info (fw version, axes); then stop
+ *   icetouch=3  ... and the touches: every report read, fingers posted to /dev/redwood-touch
+ * macOS (27.3 has no touch screen interface): the firmware is the image linked into a private build (below; such a kernel
+ * has no small image), looked for before any pin is touched, so a kernel without it says so and stops there; and at
+ * icetouch=3 the first finger down is the pointer of iokit/Native/IcelandHid's absolute pointer device (icehid=1): its
+ * position, and button 1 while it touches. Other fingers are left to /dev/redwood-touch alone until it lifts.
+ *   icetouch_dig=1     macOS (w4-touch; 27.3 has a touch screen interface after all): no pointer; after every report the
+ *                      whole finger set goes to IcelandHid's digitizer device instead (iceland_hid_touch(): slot n down at
+ *                      x, y in 0..32767), which is then the only touch device there is
+ *   icetouch_dry=1     macOS: stop after the firmware check, before any pin (QEMU has no such chip)
+ *   icetouch_delay=S  seconds before the first look (default 4)
+ *   icetouch_poll_us=N how often the interrupt latch is looked at (default 2000)
+ *   icetouch_int=0     no interrupt latch (no write to gpio158's interrupt configuration): reports read on time only
+ *   icetouch_half_ns=N a wait of N ns in each half clock period (default 0: the pin writes' own pace)
+ *   icetouch_pen=1     the pen too, posted as finger 9 while its tip is down
+ *   icetouch_flip=B    a correction on the display coordinates: 1 mirror x, 2 mirror y, 4 swap x and y (after 1/2)
+ *   icetouch_trace=N   the first N reports dumped (default 4)
+ *   icetouch_doze=S    after S seconds with no finger down the chip is asked back into its doze mode (default 0:
+ *                      never), the host command the download path's family knows (our own Linux tree's nt36xxx.h
+ *                      declares nvt_set_custom_cmd/nvt_set_doze_delay; ShengNovatekTouch's NvtProtocol.c runs the
+ *                      same five-byte custom command, and its thread - device-verified - sends the doze command again
+ *                      once three seconds pass without a finger: the controller leaves doze at a touch and then
+ *                      streams every scan for good, ~0.38 s/s of CPU, until the host asks it back, after which the
+ *                      thread has no CPU time again). While the chip is asked into doze the latch poll slows to
+ *                      100 ms (the edge latch keeps any arriving touch; the 200-ms idle read cadence is unchanged,
+ *                      so no touch is missed). The requests, the refused ones and the wakes after the last request
+ *                      are counted and said every 30 s. The command on THIS chip's running firmware is the w8-gains
+ *                      class of UNVERIFIED: a refusal is only counted (touch keeps working), and icetouch_doze=0
+ *                      on a line turns the whole thing off.
+ * Lines go to the kernel log, prefixed "icetouch:".
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/zlib.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+#define say(...) printf("icetouch: " __VA_ARGS__)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern const uint8_t *redwood_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+void hakios_iceland_touch_init(void);
+#if defined(XNU_TARGET_OS_OSX)
+/* macOS: the first finger as the HID pointer (iokit/Native/IcelandHid/IcelandHidProbe.cpp; returns at once without one) */
+extern void iceland_hid_pointer(uint32_t buttons, uint32_t x, uint32_t y);
+/* ... or, with icetouch_dig=1, every finger as a contact of the HID digitizer (the same file; returns at once without one) */
+extern void iceland_hid_touch(uint32_t mask, const uint16_t *xs, const uint16_t *ys);
+static uint32_t dig_on;                 /* icetouch_dig=1 */
+static uint32_t dig_last_mask;          /* the finger set last handed to the digitizer */
+#define TOUCH_SINK              (dig_on ? "the HID digitizer (pointer off)" : "the HID pointer")
+#else
+#define TOUCH_SINK              "/dev/redwood-touch"
+#endif
+
+/*
+ * The firmware as symbols linked into the kernel, the way of the GPU's images (hakios_iceland_gpu.c: weak empty
+ * defaults, hidden so that ld64 binds them inside the image; a private object's strong definitions take their place).
+ * A zero size means none is linked. The bytes are the owner's iceland-firmware package's and are never committed.
+ * Packed (a zlib stream, unpacked once into a buffer that stays): the file's 258,048 bytes fit none of the rooms the
+ * macOS collection leaves this kernel (__DATA_CONST 60,008 B, __DATA 32,768 B, __TEXT 243,536 B: build/private/
+ * merge1-gpu/build-053926d-strong/text.txt and runs/integ/scripts/dataroom.py, dcroom.py on it); packed they are about
+ * 110 KB, which the private object puts into __TEXT. inflate() checks the stream's Adler-32.
+ */
+__attribute__((weak, visibility("hidden"))) const uint8_t iceland_touch_firmware_z[1] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t iceland_touch_firmware_z_size = 0;
+__attribute__((weak, visibility("hidden"))) const uint64_t iceland_touch_firmware_size = 0;   /* unpacked */
+
+static vm_offset_t tlmm;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+/* ---- pins (TLMM, pinctrl-kaanapali.c) ------------------------------------------------------------------------ */
+
+#define TLMM_PHYS               0x0f100000UL            /* tlmm: pinctrl@f100000 */
+#define TLMM_SIZE               0xa0000UL               /* up to gpio159: ours are 48-51 and 158 */
+#define PIN_CTL(n)              (tlmm + 0x1000UL * (n))
+#define PIN_IO(n)               (tlmm + 0x1000UL * (n) + 0x4)
+#define PIN_INTR_CFG(n)         (tlmm + 0x1000UL * (n) + 0x8)
+#define PIN_INTR_STATUS(n)      (tlmm + 0x1000UL * (n) + 0xc)
+#define CTL_EGPIO_PRESENT       (1u << 11)
+#define CTL_EGPIO_ENABLE        (1u << 12)
+#define INTR_ENABLE             (1u << 0)
+#define INTR_POL_HIGH           (1u << 1)
+#define INTR_DETECT_MASK        (3u << 2)
+#define INTR_DETECT_RISING      (1u << 2)               /* detection width 2: 1 = positive edge */
+#define INTR_RAW_STATUS_EN      (1u << 4)
+
+#define PIN_MISO                48
+#define PIN_MOSI                49
+#define PIN_CLK                 50
+#define PIN_CS                  51
+#define PIN_INT                 158
+#define FUNC_GPIO               0
+#define FUNC_QUP4_SE0           1
+#define PULL_NONE               0
+
+static const unsigned our_pins[] = { PIN_MISO, PIN_MOSI, PIN_CLK, PIN_CS, PIN_INT };
+static uint32_t found_ctl[5], found_intr_cfg;
+
+static void
+pin_config(unsigned pin, unsigned function, unsigned pull, unsigned ma, bool output)
+{
+	uint32_t v = rd(PIN_CTL(pin)) & ~0x3ffu;
+
+	v |= pull | function << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0);
+	if (v & CTL_EGPIO_PRESENT) {
+		v |= CTL_EGPIO_ENABLE;          /* the pin is the application processor's, as msm_pinmux_set_mux claims it */
+	}
+	wr(PIN_CTL(pin), v);
+}
+
+static inline void
+pin_set(unsigned pin, bool high)
+{
+	wr(PIN_IO(pin), high ? 2 : 0);
+}
+
+static inline uint32_t
+pin_get(unsigned pin)
+{
+	return rd(PIN_IO(pin)) & 1;
+}
+
+static void
+pins_report(const char *when)
+{
+	say("%s: gpio48 %#x/%u, gpio49 %#x/%u, gpio50 %#x/%u, gpio51 %#x/%u, gpio158 %#x/%u intr %#x status %u\n", when,
+	    rd(PIN_CTL(48)), rd(PIN_IO(48)) & 3, rd(PIN_CTL(49)), rd(PIN_IO(49)) & 3, rd(PIN_CTL(50)), rd(PIN_IO(50)) & 3,
+	    rd(PIN_CTL(51)), rd(PIN_IO(51)) & 3, rd(PIN_CTL(158)), rd(PIN_IO(158)) & 3, rd(PIN_INTR_CFG(158)),
+	    rd(PIN_INTR_STATUS(158)) & 1);
+}
+
+/* the SPI pins as GPIOs, the bus idle: chip select high, clock low */
+static void
+pins_to_gpio(void)
+{
+	pin_set(PIN_CS, true);
+	pin_set(PIN_CLK, false);
+	pin_set(PIN_MOSI, false);
+	pin_config(PIN_CS, FUNC_GPIO, PULL_NONE, 6, true);
+	pin_config(PIN_CLK, FUNC_GPIO, PULL_NONE, 6, true);
+	pin_config(PIN_MOSI, FUNC_GPIO, PULL_NONE, 6, true);
+	pin_config(PIN_MISO, FUNC_GPIO, PULL_NONE, 6, false);
+	/* the interrupt line: a GPIO input, its pull and drive as found */
+	wr(PIN_CTL(PIN_INT), found_ctl[4] & ~(0xfu << 2 | 1u << 9));
+	(void)rd(PIN_IO(PIN_CS));
+}
+
+/* the pins back as they were found (the SPI pins the serial engine's); gpio158's interrupt configuration too */
+static void
+pins_restore(void)
+{
+	for (unsigned i = 0; i < 5; i++) {
+		wr(PIN_CTL(our_pins[i]), found_ctl[i]);
+	}
+	wr(PIN_INTR_CFG(PIN_INT), found_intr_cfg);
+}
+
+/* ---- SPI by hand: mode 0, MSB first ---------------------------------------------------------------------------- */
+
+static uint32_t half_ticks;             /* icetouch_half_ns in timebase ticks, rounded up */
+
+static inline void
+half_wait(void)
+{
+	if (half_ticks) {
+		uint64_t until = mach_absolute_time() + half_ticks;
+
+		while (mach_absolute_time() < until) {
+		}
+	}
+}
+
+static void
+spi_select(bool on)
+{
+	if (on) {
+		pin_set(PIN_CS, false);
+		(void)rd(PIN_IO(PIN_CS));
+		half_wait();
+	} else {
+		half_wait();
+		pin_set(PIN_CS, true);
+		(void)rd(PIN_IO(PIN_CS));
+	}
+}
+
+/*
+ * One byte out (and in): data changed while the clock is low, the clock raised, the input sampled, the clock lowered.
+ * Each write is read back before the next edge so that the posted writes reach the pins in order.
+ */
+static uint8_t
+spi_byte(uint8_t out, bool want)
+{
+	uint8_t in = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		pin_set(PIN_MOSI, (out >> bit) & 1);
+		(void)rd(PIN_IO(PIN_MOSI));
+		half_wait();
+		pin_set(PIN_CLK, true);
+		(void)rd(PIN_IO(PIN_CLK));
+		half_wait();
+		if (want) {
+			in = (uint8_t)(in << 1 | pin_get(PIN_MISO));
+		}
+		pin_set(PIN_CLK, false);
+		(void)rd(PIN_IO(PIN_CLK));
+	}
+	return in;
+}
+
+/* ---- the chip's SPI protocol (nt36xxx.c) ----------------------------------------------------------------------- */
+
+/*
+ * CTP_SPI_WRITE: buf[0] | 0x80, then buf[1..len-1]. CTP_SPI_READ: buf[0] & 0x7f, a dummy byte, and len - 1 bytes
+ * into buf[1..] (Linux's transfer is len + 1 bytes, the data from rbuf[2]).
+ */
+static void
+ctp_write(const uint8_t *buf, uint32_t len)
+{
+	spi_select(true);
+	spi_byte(buf[0] | 0x80, false);
+	for (uint32_t i = 1; i < len; i++) {
+		spi_byte(buf[i], false);
+	}
+	spi_select(false);
+}
+
+static void
+ctp_read(uint8_t *buf, uint32_t len)
+{
+	spi_select(true);
+	spi_byte(buf[0] & 0x7f, false);
+	spi_byte(0, false);
+	for (uint32_t i = 1; i < len; i++) {
+		buf[i] = spi_byte(0, true);
+	}
+	spi_select(false);
+}
+
+static void
+nvt_set_page(uint32_t addr)
+{
+	uint8_t buf[3] = { 0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+
+	ctp_write(buf, 3);
+}
+
+static void
+nvt_write_addr(uint32_t addr, uint8_t data)
+{
+	uint8_t buf[2] = { (uint8_t)(addr & 0x7f), data };
+
+	nvt_set_page(addr);
+	ctp_write(buf, 2);
+}
+
+/* nt36xxx_mem_map.h: NT36536 (single and cascade maps agree on all of these), hw_reg_addr_info, NT36532_hw_info */
+#define ENG_RST_ADDR            0x7fff80
+#define CHIP_VER_TRIM_ADDR      0x1fb104
+#define SWRST_SIF_ADDR          0x1fb43e
+#define ENB_CASC_ADDR           0x1fb12c        /* bit 0: single chip */
+#define EVENT_BUF_ADDR          0x130900
+#define BOOT_RDY_ADDR           0x1fb50d
+#define TX_AUTO_COPY_EN         0x1fc825
+#define ILM_DES_ADDR            0x1fcc30
+#define ILM_LENGTH_ADDR         0x1fcc34
+#define G_ILM_CHECKSUM_ADDR     0x1fcc38
+#define DLM_DES_ADDR            0x1fcc40
+#define DLM_LENGTH_ADDR         0x1fcc44
+#define G_DLM_CHECKSUM_ADDR     0x1fcc48
+#define R_ILM_CHECKSUM_ADDR     0x1fcc7c
+#define R_DLM_CHECKSUM_ADDR     0x1fcc80
+#define BLD_ILM_DLM_CRC_ADDR    0x1fb532
+#define HISTORY_SINGLE          0x12cb2c
+#define HISTORY_CASCADE         0x124d7c
+
+#define EVENT_MAP_HOST_CMD      0x50
+#define EVENT_MAP_HANDSHAKING   0x51
+#define EVENT_MAP_RESET_COMPLETE 0x60
+#define EVENT_MAP_FWINFO        0x78
+#define RESET_STATE_INIT        0xa0
+#define RESET_STATE_REK         0xa1
+#define RESET_STATE_MAX         0xaf
+
+#define TOUCH_MAX_FINGER_NUM    10
+#define NVT_TRANSFER_LEN        (63 * 1024)
+#define FW_NAME                 "novatek_nt36536_fw.bin"
+
+static bool cascade;
+static uint16_t abs_x_max = 33920, abs_y_max = 24000;  /* TOUCH_DEFAULT_MAX_WIDTH / _HEIGHT, until the chip says */
+
+static void
+nvt_bootloader_reset(void)
+{
+	nvt_write_addr(SWRST_SIF_ADDR, 0x69);
+	sleep_ms(5);
+}
+
+/* nvt_ts_check_chip_ver_trim with hw_reg_addr_info; only the NT36536 entries of trim_id_table are this tablet's */
+static bool
+nvt_identify(void)
+{
+	static const struct {
+		uint8_t id[6], mask[6];
+	} nt36536[] = {
+		{ { 0x14, 0xff, 0xff, 0x23, 0x65, 0x03 }, { 1, 0, 0, 1, 1, 1 } },
+		{ { 0x15, 0x0e, 0xff, 0x23, 0x65, 0x03 }, { 1, 1, 0, 1, 1, 1 } },
+	};
+	uint8_t buf[8];
+
+	for (int retry = 0; retry < 5; retry++) {
+		nvt_bootloader_reset();
+		nvt_set_page(CHIP_VER_TRIM_ADDR);
+		bzero(buf, sizeof(buf));
+		buf[0] = CHIP_VER_TRIM_ADDR & 0x7f;
+		ctp_write(buf, 7);
+		bzero(buf, sizeof(buf));
+		buf[0] = CHIP_VER_TRIM_ADDR & 0x7f;
+		ctp_read(buf, 7);
+		say("trim id (try %d): %02x %02x %02x %02x %02x %02x\n", retry, buf[1], buf[2], buf[3], buf[4], buf[5], buf[6]);
+		for (unsigned t = 0; t < sizeof(nt36536) / sizeof(nt36536[0]); t++) {
+			unsigned i;
+
+			for (i = 0; i < 6; i++) {
+				if (nt36536[t].mask[i] && buf[i + 1] != nt36536[t].id[i]) {
+					break;
+				}
+			}
+			if (i == 6) {
+				uint8_t casc[2] = { ENB_CASC_ADDR & 0x7f, 0 };
+
+				nvt_set_page(ENB_CASC_ADDR);
+				ctp_read(casc, 2);
+				cascade = !(casc[1] & 1);
+				say("NT36536 (table entry %u), %s chip (ENB_CASC %#x)\n", t, cascade ? "cascade" : "single", casc[1]);
+				return true;
+			}
+		}
+		sleep_ms(10);
+	}
+	return false;
+}
+
+/* ---- the firmware download (nt36xxx_fw_update.c, the hw_crc path) ----------------------------------------------- */
+
+#define FLASH_SECTOR_SIZE       4096
+#define MAX_PARTITIONS          32
+
+static const uint8_t *fw;
+static uint64_t fw_size;
+static uint32_t fw_need_write_size;
+static struct {
+	uint32_t bin, sram, size, crc;
+} part[MAX_PARTITIONS];
+static uint32_t partitions;
+static bool cascade_2nd_header;
+
+static uint32_t
+word_at(uint64_t at)
+{
+	if (at + 4 > fw_size) {
+		return 0;
+	}
+	return fw[at] | fw[at + 1] << 8 | fw[at + 2] << 16 | (uint32_t)fw[at + 3] << 24;
+}
+
+/* Crc32 of nt36xxx_fw_update.c: (len + 4) / 4 little-endian words, polynomial 0x04c11db7, MSB first */
+static uint32_t
+crc32_words(uint64_t at, uint32_t len)
+{
+	uint32_t c = 0xffffffff;
+
+	len = (len + 4) / 4;
+	for (uint32_t i = 0; i < len; i++) {
+		c ^= word_at(at + 4ull * i);
+		for (int j = 0; j < 32; j++) {
+			c = (c & 0x80000000u) ? (c << 1) ^ 0x04c11db7u : c << 1;
+		}
+	}
+	return c;
+}
+
+static bool
+fw_check_and_parse(void)
+{
+	uint32_t pos, end, info_sec_num = 0, ovly_sec_num, ilm_dlm_num = 2;
+	bool find_bin_header = false;
+
+	/* nvt_get_fw_need_write_size: the last 4 KB sector ending in "NVT" or "MOD" */
+	fw_need_write_size = 0;
+	for (uint64_t i = fw_size / FLASH_SECTOR_SIZE; i > 0; i--) {
+		const uint8_t *flag = fw + i * FLASH_SECTOR_SIZE - 3;
+
+		if (memcmp(flag, "NVT", 3) == 0 || memcmp(flag, "MOD", 3) == 0) {
+			fw_need_write_size = (uint32_t)(i * FLASH_SECTOR_SIZE);
+			break;
+		}
+	}
+	if (fw_need_write_size == 0) {
+		say("firmware: no end flag NVT / MOD\n");
+		return false;
+	}
+	if ((uint8_t)(fw[fw_need_write_size - FLASH_SECTOR_SIZE] + fw[fw_need_write_size - FLASH_SECTOR_SIZE + 1]) != 0xff) {
+		say("firmware: FW_VER %#x + FW_VER_BAR %#x is not 0xff\n", fw[fw_need_write_size - FLASH_SECTOR_SIZE],
+		    fw[fw_need_write_size - FLASH_SECTOR_SIZE + 1]);
+		return false;
+	}
+
+	/* nvt_bin_header_parser */
+	end = word_at(0);
+	for (pos = 0x30; pos < end; pos += 0x10) {
+		if (word_at(pos + 4) != 0 && word_at(pos + 8) == 0) {
+			end = pos + 0x10;
+			break;
+		}
+	}
+	for (pos = 0x30; pos < end; pos += 0x10) {
+		info_sec_num++;
+	}
+	cascade_2nd_header = (fw[0x20] & 0x02) != 0;
+	if (cascade_2nd_header) {
+		info_sec_num++;
+		end *= 2;
+	}
+	ovly_sec_num = (fw[0x28] & 0x10) ? (fw[0x28] & 0x0f) : 0;
+	partitions = ilm_dlm_num + ovly_sec_num + info_sec_num;
+	if (partitions > MAX_PARTITIONS) {
+		say("firmware: %u partitions: too many\n", partitions);
+		return false;
+	}
+	for (uint32_t list = 0; list < partitions; list++) {
+		if (list < ilm_dlm_num) {
+			part[list].bin = word_at(0 + list * 12);
+			part[list].sram = word_at(4 + list * 12);
+			part[list].size = word_at(8 + list * 12);
+			part[list].crc = crc32_words(part[list].bin, part[list].size);
+		} else {
+			if (list < ilm_dlm_num + info_sec_num) {
+				if (!find_bin_header) {
+					pos = 0x30 + 0x10 * (list - ilm_dlm_num);
+				} else if (cascade_2nd_header) {
+					pos = end - 0x10;
+				}
+			} else {
+				pos = part[1].bin + 0x10 * (list - ilm_dlm_num - info_sec_num);
+			}
+			part[list].sram = word_at(pos);
+			part[list].size = word_at(pos + 4);
+			part[list].bin = word_at(pos + 8);
+			part[list].crc = word_at(pos + 12);
+			if (list < ilm_dlm_num + info_sec_num && part[list].bin < end && part[list].size != 0) {
+				find_bin_header = true;
+			}
+		}
+		if ((uint64_t)part[list].bin + part[list].size > fw_size) {
+			say("firmware: partition %u (%#x + %#x) beyond the file's %llu bytes\n", list, part[list].bin,
+			    part[list].size, fw_size);
+			return false;
+		}
+	}
+	say("firmware: %llu bytes, write size %#x, version %#x, %u partitions (%u info, %u overlay), cascade header %u; "
+	    "ILM %#x+%#x -> %#x crc %#x, DLM %#x+%#x -> %#x crc %#x\n", fw_size, fw_need_write_size,
+	    fw[fw_need_write_size - FLASH_SECTOR_SIZE], partitions, info_sec_num, ovly_sec_num, cascade_2nd_header,
+	    part[0].bin, part[0].size, part[0].sram, part[0].crc, part[1].bin, part[1].size, part[1].sram, part[1].crc);
+	return true;
+}
+
+/* nvt_set_bld_crc_bank, CRC banks of 3 bytes (HWCRC_LEN_3Bytes) */
+static void
+set_crc_bank(uint32_t des, uint32_t sram, uint32_t length_addr, uint32_t size, uint32_t g_checksum, uint32_t crc)
+{
+	uint8_t b[5];
+
+	nvt_set_page(des);
+	b[0] = des & 0x7f; b[1] = (uint8_t)sram; b[2] = (uint8_t)(sram >> 8); b[3] = (uint8_t)(sram >> 16);
+	ctp_write(b, 4);
+	b[0] = length_addr & 0x7f; b[1] = (uint8_t)size; b[2] = (uint8_t)(size >> 8); b[3] = (uint8_t)(size >> 16);
+	ctp_write(b, 4);
+	b[0] = g_checksum & 0x7f; b[1] = (uint8_t)crc; b[2] = (uint8_t)(crc >> 8); b[3] = (uint8_t)(crc >> 16);
+	b[4] = (uint8_t)(crc >> 24);
+	ctp_write(b, 5);
+}
+
+/* nvt_write_sram: chunks of NVT_TRANSFER_LEN, each "set page" and then offset byte + data in one selection */
+static void
+write_sram(uint32_t sram, uint32_t size, uint32_t bin)
+{
+	while (size > 0) {
+		uint32_t len = size < NVT_TRANSFER_LEN ? size : NVT_TRANSFER_LEN;
+
+		nvt_set_page(sram);
+		spi_select(true);
+		spi_byte((sram & 0x7f) | 0x80, false);
+		for (uint32_t i = 0; i < len; i++) {
+			spi_byte(bin + i < fw_size ? fw[bin + i] : 0, false);
+		}
+		spi_select(false);
+		sram += len;
+		bin += len;
+		size -= len;
+	}
+}
+
+static int
+check_reset_state(uint8_t state, int retries, uint8_t *seen)
+{
+	uint8_t buf[6];
+
+	nvt_set_page(EVENT_BUF_ADDR);
+	for (int i = 0;; i++) {
+		bzero(buf, sizeof(buf));
+		buf[0] = EVENT_MAP_RESET_COMPLETE;
+		ctp_read(buf, 6);
+		*seen = buf[1];
+		if (buf[1] >= state && buf[1] <= RESET_STATE_MAX) {
+			return i;
+		}
+		if (i >= retries) {
+			return -1;
+		}
+		sleep_ms(10);
+	}
+}
+
+static void
+read_bld_crc(void)
+{
+	uint8_t b[5] = { BLD_ILM_DLM_CRC_ADDR & 0x7f };
+	uint32_t g[2], r[2];
+	static const uint32_t ga[2] = { G_ILM_CHECKSUM_ADDR, G_DLM_CHECKSUM_ADDR }, ra[2] = { R_ILM_CHECKSUM_ADDR,
+		                                                                              R_DLM_CHECKSUM_ADDR };
+
+	nvt_set_page(BLD_ILM_DLM_CRC_ADDR);
+	ctp_read(b, 2);
+	say("CRC flags %#x (done %u, ilm %u, dlm %u)\n", b[1], (b[1] >> 2) & 1, b[1] & 1, (b[1] >> 1) & 1);
+	for (int k = 0; k < 2; k++) {
+		nvt_set_page(ga[k]);
+		bzero(b, sizeof(b)); b[0] = ga[k] & 0x7f;
+		ctp_read(b, 5);
+		g[k] = b[1] | b[2] << 8 | b[3] << 16 | (uint32_t)b[4] << 24;
+		nvt_set_page(ra[k]);
+		bzero(b, sizeof(b)); b[0] = ra[k] & 0x7f;
+		ctp_read(b, 5);
+		r[k] = b[1] | b[2] << 8 | b[3] << 16 | (uint32_t)b[4] << 24;
+	}
+	say("CRC: ILM bin %#x golden %#x result %#x; DLM bin %#x golden %#x result %#x\n", part[0].crc, g[0], r[0],
+	    part[1].crc, g[1], r[1]);
+}
+
+static void
+read_history(void)
+{
+	uint32_t addr = cascade ? HISTORY_CASCADE : HISTORY_SINGLE;
+	uint8_t b[65] = { (uint8_t)(addr & 0x7f) };
+
+	nvt_set_page(addr);
+	ctp_read(b, 65);
+	say("fw history %#x: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n", addr,
+	    b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15], b[16]);
+	nvt_set_page(EVENT_BUF_ADDR);
+}
+
+/* nvt_download_firmware_hw_crc, then nvt_get_fw_info and (as nvt_ts_resume) the wait for the baseline */
+static bool
+nvt_download(void)
+{
+	for (int retry = 0; retry < 3; retry++) {
+		uint64_t t0 = now_us(), t1;
+		uint64_t bytes = 0;
+		uint8_t state = 0;
+		int tries;
+
+		nvt_bootloader_reset();
+		set_crc_bank(ILM_DES_ADDR, part[0].sram, ILM_LENGTH_ADDR, part[0].size, G_ILM_CHECKSUM_ADDR, part[0].crc);
+		set_crc_bank(DLM_DES_ADDR, part[1].sram, DLM_LENGTH_ADDR, part[1].size, G_DLM_CHECKSUM_ADDR, part[1].crc);
+		if (cascade_2nd_header) {
+			nvt_write_addr(TX_AUTO_COPY_EN, 0x56);  /* nvt_tx_auto_copy_mode, CHECK_TX_AUTO_COPY_EN */
+		}
+		for (uint32_t list = 0; list < partitions; list++) {
+			if (part[list].size == 0) {
+				continue;
+			}
+			write_sram(part[list].sram, part[list].size + 1, part[list].bin);   /* (size + 1, as Linux) */
+			bytes += part[list].size + 1;
+		}
+		t1 = now_us();
+		say("download %d: %llu bytes in %llu ms (%llu KB/s)\n", retry, bytes, (t1 - t0) / 1000,
+		    t1 > t0 ? bytes * 1000 / (t1 - t0) : 0);
+		if (cascade_2nd_header) {
+			uint8_t b[2];
+			int i;
+
+			for (i = 0; i < 200; i++) {
+				nvt_set_page(TX_AUTO_COPY_EN);
+				b[0] = TX_AUTO_COPY_EN & 0x7f;
+				b[1] = 0xff;
+				ctp_read(b, 2);
+				if (b[1] == 0) {
+					break;
+				}
+				sleep_ms(1);
+			}
+			if (i == 200) {
+				say("auto copy does not finish (%#x)\n", b[1]);
+				continue;
+			}
+		}
+		/* nvt_fw_crc_enable: clear the reset status, host command 0xae */
+		{
+			uint8_t clear[7] = { EVENT_MAP_RESET_COMPLETE, 0, 0, 0, 0, 0, 0 }, crc_on[3] = { EVENT_MAP_HOST_CMD, 0xae, 0 };
+
+			nvt_set_page(EVENT_BUF_ADDR);
+			ctp_write(clear, 7);
+			ctp_write(crc_on, 3);
+		}
+		nvt_write_addr(BOOT_RDY_ADDR, 1);       /* nvt_boot_ready */
+		sleep_ms(5);
+		tries = check_reset_state(RESET_STATE_INIT, 10, &state);
+		if (tries < 0) {
+			say("download %d: the firmware does not start (reset state %#x)\n", retry, state);
+			read_bld_crc();
+			continue;
+		}
+		say("download %d: the firmware runs (reset state %#x after %d looks)\n", retry, state, tries);
+		tries = check_reset_state(RESET_STATE_REK, 50, &state);
+		say("baseline %s (reset state %#x)\n", tries >= 0 ? "ready" : "NOT ready after 500 ms", state);
+		return true;
+	}
+	return false;
+}
+
+static bool
+nvt_fw_info(void)
+{
+	uint8_t b[39];
+
+	for (int retry = 0; retry < 4; retry++) {
+		nvt_set_page(EVENT_BUF_ADDR);
+		bzero(b, sizeof(b));
+		b[0] = EVENT_MAP_FWINFO;
+		ctp_read(b, 39);
+		if ((uint8_t)(b[1] + b[2]) == 0xff) {
+			abs_x_max = (uint16_t)(b[5] << 8 | b[6]);
+			abs_y_max = (uint16_t)(b[7] << 8 | b[8]);
+			say("fw info: version %#x, type %#x, PID %#06x, %u x %u sensors, axes %u x %u\n", b[1], b[14],
+			    b[36] << 8 | b[35], b[3], b[4], abs_x_max, abs_y_max);
+			if (abs_x_max == 0 || abs_y_max == 0) {
+				abs_x_max = 33920;
+				abs_y_max = 24000;
+			}
+			return true;
+		}
+		say("fw info broken: version %#x, ~version %#x\n", b[1], b[2]);
+	}
+	return false;
+}
+
+/*
+ * The custom host command of the doze class (NvtProtocol.c:330-340, the same protocol our own Linux tree's nt36xxx.h
+ * declares as nvt_set_custom_cmd): five bytes {0xbf, cmd, 0x00, value lo, value hi} written at the event page's
+ * host-command offset, then the status byte there read back until it is 0 (five tries, 20 ms apart). The doze mode
+ * is cmd 0x01, value 0x02 - ShengNovatekTouch sends exactly that pair after the download and again after three
+ * seconds without a finger, and on their hardware the thread then has no CPU time.
+ */
+static int
+nvt_custom_cmd(uint8_t cmd, uint16_t value)
+{
+	uint8_t b[6] = { EVENT_MAP_HOST_CMD, 0xbf, cmd, 0x00, (uint8_t)value, (uint8_t)(value >> 8) };
+	int i;
+
+	sleep_ms(35);
+	for (i = 0; i < 5; i++) {
+		nvt_set_page(EVENT_BUF_ADDR);
+		ctp_write(b, 6);
+		sleep_ms(20);
+		b[0] = EVENT_MAP_HOST_CMD;
+		bzero(b + 1, 5);
+		nvt_set_page(EVENT_BUF_ADDR);
+		ctp_read(b, 2);
+		if (b[1] == 0) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* ---- reports --------------------------------------------------------------------------------------------------- */
+
+static uint32_t rotate, flip, pen_on, trace = 4;
+static bool down[TOUCH_MAX_FINGER_NUM + 1];
+static uint32_t last_x[TOUCH_MAX_FINGER_NUM + 1], last_y[TOUCH_MAX_FINGER_NUM + 1];
+static struct {
+	unsigned reads, reports, edges, handshakes, wdt, recoveries, bad, posted, downs, ups, pointer, frames;
+	unsigned rebases;              /* icetouch_rebase: idle baseline looks (w8-gains) */
+	uint32_t lx, ly, dx, dy;
+} seen;
+#if defined(XNU_TARGET_OS_OSX)
+static int pointer_slot = -1;           /* the finger that is the HID pointer, from its landing to its lift */
+#endif
+
+/*
+ * Linux's position -> the display's, 0..65535 each. Linux's frame (x along the panel's 3392-pixel side, y along its
+ * 2400) is the boot framebuffer's that MiniIOMobileFramebuffer draws into (ABL's scan-out): framebuffer column = x,
+ * row = y. Measured in run ipad6 (30 Oct): swipes up from the bottom middle of the upright fbrotate=270 picture began
+ * at chip x ~33700, y ~12200 and went to smaller x; with the 180-degree turn that run ipad4's single tap had suggested
+ * (taken with the tablet held another way than assumed) unlocking took a swipe down. Then rotateRow's turn is undone
+ * (270: column = upright y, row = 1 - upright x; 180: both reversed).
+ */
+static void
+to_display(uint32_t lx, uint32_t ly, uint32_t *x, uint32_t *y)
+{
+	uint64_t c = (uint64_t)lx * 65535 / (abs_x_max - 1), r = (uint64_t)ly * 65535 / (abs_y_max - 1);
+	uint64_t ux, uy;
+
+	if (c > 65535) {
+		c = 65535;
+	}
+	if (r > 65535) {
+		r = 65535;
+	}
+	/* (c: framebuffer column, 0 = its left edge; r: its row, 0 = its top) */
+	if (rotate == 270) {
+		ux = 65535 - r;
+		uy = c;
+	} else if (rotate == 90) {
+		ux = r;
+		uy = 65535 - c;
+	} else if (rotate == 180) {
+		ux = 65535 - c;
+		uy = 65535 - r;
+	} else {
+		ux = c;
+		uy = r;
+	}
+	if (flip & 1) {
+		ux = 65535 - ux;
+	}
+	if (flip & 2) {
+		uy = 65535 - uy;
+	}
+	if (flip & 4) {
+		uint64_t t = ux;
+
+		ux = uy;
+		uy = t;
+	}
+	*x = (uint32_t)ux;
+	*y = (uint32_t)uy;
+}
+
+static void
+post(unsigned slot, bool touching, uint32_t lx, uint32_t ly)
+{
+	if (touching) {
+		uint32_t x, y;
+
+		to_display(lx, ly, &x, &y);
+		/* every touch-down (up to 400), and the first 12 events of any kind */
+		if ((!down[slot] && seen.downs++ < 400) || seen.posted < 12) {
+			say("%s %u %s at %u, %u (chip %u, %u)\n", slot == 9 && pen_on ? "pen" : "finger", slot,
+			    down[slot] ? "moves" : "down", x, y, lx, ly);
+		}
+		seen.posted++;
+		seen.lx = lx; seen.ly = ly; seen.dx = x; seen.dy = y;
+#if defined(XNU_TARGET_OS_OSX)
+		/* the pointer's range is 0..32767; a landing first moves the pointer there, then presses button 1 */
+		if (!dig_on && pointer_slot < 0 && !down[slot]) {
+			pointer_slot = (int)slot;
+			iceland_hid_pointer(0, x >> 1, y >> 1);
+		}
+		if (!dig_on && pointer_slot == (int)slot) {
+			iceland_hid_pointer(1, x >> 1, y >> 1);
+			seen.pointer++;
+		}
+#endif
+		redwood_touch_post(down[slot] ? REDWOOD_TOUCH_MOVE : REDWOOD_TOUCH_DOWN, slot, x, y);
+		last_x[slot] = x;
+		last_y[slot] = y;
+		down[slot] = true;
+	} else if (down[slot]) {
+		if (seen.ups++ < 400) {
+			say("finger %u up at %u, %u\n", slot, last_x[slot], last_y[slot]);
+		}
+#if defined(XNU_TARGET_OS_OSX)
+		if (pointer_slot == (int)slot) {
+			iceland_hid_pointer(0, last_x[slot] >> 1, last_y[slot] >> 1);
+			pointer_slot = -1;
+		}
+#endif
+		redwood_touch_post(REDWOOD_TOUCH_UP, slot, last_x[slot], last_y[slot]);
+		down[slot] = false;
+	}
+}
+
+/*
+ * icetouch_dig=1: the finger set as post() left it after a report (slots 0..9; the pen, when on, is slot 9), to the HID
+ * digitizer. The display coordinates are 0..65535, the digitizer's 0..32767. An empty set is handed over once.
+ */
+static void
+touch_frame(void)
+{
+#if defined(XNU_TARGET_OS_OSX)
+	uint16_t xs[TOUCH_MAX_FINGER_NUM], ys[TOUCH_MAX_FINGER_NUM];
+	uint32_t mask = 0;
+
+	if (!dig_on) {
+		return;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX_FINGER_NUM; i++) {
+		xs[i] = (uint16_t)(last_x[i] >> 1);
+		ys[i] = (uint16_t)(last_y[i] >> 1);
+		if (down[i]) {
+			mask |= 1u << i;
+		}
+	}
+	if (mask == 0 && dig_last_mask == 0) {
+		return;
+	}
+	dig_last_mask = mask;
+	seen.frames++;
+	iceland_hid_touch(mask, xs, ys);
+#endif
+}
+
+static void
+release_all(void)
+{
+	for (unsigned i = 0; i <= TOUCH_MAX_FINGER_NUM; i++) {
+		post(i, false, 0, 0);
+	}
+	touch_frame();
+}
+
+#define READ_LEN_FINGERS        (1 + 6 * TOUCH_MAX_FINGER_NUM)  /* the fingers: point_data[1..60] */
+#define READ_LEN_PEN            80                              /* ... and the pen: point_data[66..78] */
+static unsigned wdt_count;
+/* 20u: when a finger was last down on the screen (read by hakios_iceland_cpu.c / hakios_iceland_gpu.c for the touch floors) */
+volatile uint64_t hakios_ui_touch_at;
+
+/* nvt_ts_work_func, one report; false when it asks for the firmware to be downloaded again */
+static bool
+read_report(void)
+{
+	uint8_t p[READ_LEN_PEN];
+	bool pressed[TOUCH_MAX_FINGER_NUM] = { false };
+	uint32_t len = pen_on ? READ_LEN_PEN : READ_LEN_FINGERS;
+	unsigned fd = 0, hs = 0;
+
+	bzero(p, sizeof(p));
+	p[0] = 0x00;
+	ctp_read(p, len);
+	seen.reads++;
+	for (int i = 1; i < 7; i++) {
+		fd += p[i] == 0xfd || p[i] == 0xfe;
+		hs += p[i] == 0x77;
+	}
+	/* ESD protection by the firmware's watchdog: 0xfd / 0xfe for more than ten reports in a row */
+	if (fd == 6) {
+		if (++wdt_count > 10) {
+			wdt_count = 0;
+			seen.wdt++;
+			say("the firmware has reset (%02x): history, then a new download\n", p[1]);
+			if (p[1] == 0xfe) {
+				nvt_write_addr(SWRST_SIF_ADDR, 0xaa);   /* nvt_sw_reset_idle */
+				sleep_ms(15);
+			}
+			read_history();
+			release_all();
+			return false;
+		}
+	} else {
+		wdt_count = 0;
+	}
+	if (hs == 6) {
+		seen.handshakes++;              /* ESD protection by handshake: not a report */
+		return true;
+	}
+	seen.reports++;
+	if (seen.reports <= trace) {
+		say("report %u: %02x | %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x | pen %02x %02x %02x %02x %02x\n",
+		    seen.reports, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11], p[12], p[66], p[67],
+		    p[68], p[69], p[70]);
+	}
+	for (unsigned i = 0; i < TOUCH_MAX_FINGER_NUM; i++) {
+		unsigned pos = 1 + 6 * i, id = p[pos] >> 3, status = p[pos] & 7;
+		uint32_t lx, ly;
+
+		if (id == 0 || id > TOUCH_MAX_FINGER_NUM || (status != 1 && status != 2)) {
+			continue;
+		}
+		lx = (uint32_t)p[pos + 3] << 8 | p[pos + 4];
+		ly = (uint32_t)p[pos + 1] << 8 | p[pos + 2];
+		if (ly > (uint32_t)abs_y_max - 1) {
+			seen.bad++;
+			continue;
+		}
+		ly = (uint32_t)abs_y_max - 1 - ly;
+		if (lx > abs_x_max) {
+			seen.bad++;
+			continue;
+		}
+		pressed[id - 1] = true;
+		hakios_ui_touch_at = mach_absolute_time();      /* 20u: a finger is down (the CPU / GPU touch floors) */
+		{
+			extern void hakios_user_active(const char *why);
+
+			hakios_user_active("icetouch");         /* gains1 (P1): only while the display is dark, once per 2 s */
+		}
+		post(id - 1, true, lx, ly);
+	}
+	for (unsigned i = 0; i < TOUCH_MAX_FINGER_NUM; i++) {
+		if (!pressed[i] && !(pen_on && i == 9)) {
+			post(i, false, 0, 0);
+		}
+	}
+	if (pen_on) {
+		/* format 0x01: x 67-68, y 69-70, pressure 71-72, as Linux's pen device (no swap, no mirror) */
+		if (p[66] == 0x01) {
+			uint32_t px = (uint32_t)p[67] << 8 | p[68], py = (uint32_t)p[69] << 8 | p[70];
+			uint32_t pressure = (uint32_t)p[71] << 8 | p[72];
+
+			post(9, pressure != 0 && px < abs_x_max && py < abs_y_max, px, py);
+		} else if (!pressed[9]) {
+			post(9, false, 0, 0);
+		}
+	}
+	touch_frame();
+	return true;
+}
+
+/* ---- all of it together ----------------------------------------------------------------------------------------- */
+
+/* zlib's memory: the size in front of each block, for kfree_data */
+static void *
+fw_zalloc(__unused void *opaque, u_int items, u_int size)
+{
+	uint64_t total = (uint64_t)items * size + 16;
+	uint64_t *p = kalloc_data(total, Z_WAITOK);
+
+	if (p == NULL) {
+		return NULL;
+	}
+	p[0] = total;
+	return p + 2;
+}
+
+static void
+fw_zfree(__unused void *opaque, void *ptr)
+{
+	uint64_t *p = (uint64_t *)ptr - 2;
+
+	kfree_data(p, p[0]);
+}
+
+/* the firmware: the Data addon's firmware/ copy with icefw_addon=1 (w7-fw, sheng's route: the installer stages it
+ * at /private/var/ngpu/firmware and this kernel no longer has to carry it; the addon reader waits for the addon
+ * install itself, so a first look while it is still pending just waits there), else the image linked into this
+ * kernel, else fw/novatek_nt36536_fw.bin of the small image (md1) or md0 */
+static bool
+fw_find(void)
+{
+	uint64_t size = 0;
+	int disk = -1;
+
+	{
+		extern const uint8_t *redwood_addon_file(const char *dir, const char *name, uint64_t *size);
+
+		uint64_t addon_size = 0;
+		const uint8_t *addon = redwood_addon_file("firmware", FW_NAME, &addon_size);
+
+		if (addon != NULL) {
+			fw = addon;
+			fw_size = addon_size;
+			say("firmware fw/%s: %llu bytes from the Data addon (icefw_addon=1)\n", FW_NAME, fw_size);
+			return true;
+		}
+	}
+	if (iceland_touch_firmware_z_size != 0) {
+		uint64_t raw = iceland_touch_firmware_size;
+		uint8_t *buf = raw >= 2 * FLASH_SECTOR_SIZE && raw <= 4u << 20 ? kalloc_data(raw, Z_WAITOK) : NULL;
+		z_stream zs;
+		int rc = Z_MEM_ERROR;
+
+		bzero(&zs, sizeof(zs));
+		if (buf != NULL) {
+			zs.zalloc = fw_zalloc;
+			zs.zfree = fw_zfree;
+			zs.next_in = (Bytef *)(uintptr_t)iceland_touch_firmware_z;
+			zs.avail_in = (uInt)iceland_touch_firmware_z_size;
+			zs.next_out = buf;
+			zs.avail_out = (uInt)raw;
+			rc = inflateInit(&zs);
+			if (rc == Z_OK) {
+				rc = inflate(&zs, Z_FINISH);
+				inflateEnd(&zs);
+			}
+		}
+		if (rc != Z_STREAM_END || zs.total_out != raw) {
+			say("no firmware: the linked image does not unpack (%d, %llu of %llu bytes)\n", rc, (uint64_t)zs.total_out, raw);
+			if (buf != NULL) {
+				kfree_data(buf, raw);
+			}
+			return false;
+		}
+		fw = buf;                       /* kept: a watchdog reset downloads it again */
+		fw_size = raw;
+		say("firmware: %llu bytes linked in (%llu packed)\n", fw_size, iceland_touch_firmware_z_size);
+		return true;
+	}
+	fw = redwood_image_file("fw", FW_NAME, &size, &disk);
+	if (fw == NULL) {
+		say("no firmware: none linked in, no fw/%s in the small image (md1) or md0\n", FW_NAME);
+		return false;
+	}
+	fw_size = size;
+	say("firmware fw/%s: %llu bytes from md%d\n", FW_NAME, fw_size, disk);
+	return true;
+}
+
+static bool
+bring_up(uint32_t stage)
+{
+	uint64_t t0;
+
+	pins_to_gpio();
+	pins_report("pins as GPIOs");
+	/* nvt_ts_probe: eng reset before anything, 10 ms after it */
+	nvt_write_addr(ENG_RST_ADDR, 0x5a);
+	sleep_ms(11);
+	t0 = now_us();
+	if (!nvt_identify()) {
+		say("no NT36536 answers (the bus by hand, %llu us for the looks)\n", now_us() - t0);
+		return false;
+	}
+	if (stage < 2) {
+		say("icetouch=1: identified; stopping here\n");
+		return false;
+	}
+	if (fw == NULL && !fw_find()) {
+		return false;
+	}
+	if (partitions == 0 && (fw_size < 2 * FLASH_SECTOR_SIZE || !fw_check_and_parse())) {
+		return false;
+	}
+	if (!nvt_download()) {
+		say("the firmware download failed three times\n");
+		return false;
+	}
+	if (!nvt_fw_info()) {
+		say("no firmware info: default axes %u x %u\n", abs_x_max, abs_y_max);
+	}
+	nvt_set_page(EVENT_BUF_ADDR);           /* reports are read at offset 0 of this page */
+	return true;
+}
+
+static void
+icetouch_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)parameter, delay_s = 4, poll_us = 2000, use_int = 1, half_ns = 0;
+	uint64_t next_status, last_read = 0, idle_since;
+	unsigned downloads = 1;
+	uint32_t rebase_s = 0;
+	/* icetouch_doze: all state on the thread's stack, so the driver adds no __DATA */
+	uint32_t doze_s = 0, doze_reqs = 0, doze_refused = 0;
+	uint64_t doze_wakes = 0;
+	bool doze_asked = false;
+
+	PE_parse_boot_argn("icetouch_delay", &delay_s, sizeof(delay_s));
+	PE_parse_boot_argn("icetouch_poll_us", &poll_us, sizeof(poll_us));
+	PE_parse_boot_argn("icetouch_int", &use_int, sizeof(use_int));
+	PE_parse_boot_argn("icetouch_half_ns", &half_ns, sizeof(half_ns));
+	PE_parse_boot_argn("icetouch_pen", &pen_on, sizeof(pen_on));
+	PE_parse_boot_argn("icetouch_flip", &flip, sizeof(flip));
+	PE_parse_boot_argn("icetouch_trace", &trace, sizeof(trace));
+	PE_parse_boot_argn("fbrotate", &rotate, sizeof(rotate));
+	PE_parse_boot_argn("icetouch_rebase", &rebase_s, sizeof(rebase_s));
+	if (rebase_s > 3600) {
+		rebase_s = 3600;
+	}
+	PE_parse_boot_argn("icetouch_doze", &doze_s, sizeof(doze_s));
+	if (doze_s > 3600) {
+		doze_s = 3600;
+	}
+#if defined(XNU_TARGET_OS_OSX)
+	PE_parse_boot_argn("icetouch_dig", &dig_on, sizeof(dig_on));
+	dig_on = dig_on == 1;
+#endif
+	if (poll_us < 250 || poll_us > 100000) {
+		poll_us = 2000;
+	}
+	half_ticks = 0;
+	if (half_ns != 0 && half_ns <= 100000) {
+		/* whatever a tick is (19.2 MHz: 52 ns; icetb24: 41.7 ns): the first tick count that is not shorter */
+		uint64_t t = 0, back = 0;
+
+		nanoseconds_to_absolutetime(half_ns, &t);
+		absolutetime_to_nanoseconds(t, &back);
+		half_ticks = (uint32_t)(back < half_ns ? t + 1 : t);
+	}
+	say("stage %u; first look in %u s (fbrotate %u, flip %u, pen %u, poll %u us, interrupt latch %u, half %u ns%s)\n",
+	    stage, delay_s, rotate, flip, pen_on, poll_us, use_int, half_ns, rebase_s ? ", rebase at idle" : "");
+	if (rebase_s) {
+		say("icetouch_rebase=%u: after %u s with no finger down the chip's baseline state is read (G8, "
+		    "ShengNovatekTouch a88c26d1's idle-gated idea; nothing else is written)\n", rebase_s, rebase_s);
+	}
+	if (doze_s) {
+		say("icetouch_doze=%u: after %u s with no finger down the chip is asked back into doze (ShengNovatekTouch's "
+		    "device-verified return, ~0.38 s/s of CPU to none; a refusal is only counted, and the idle read cadence "
+		    "is kept so no touch is missed)\n", doze_s, doze_s);
+	}
+	sleep_ms(delay_s * 1000);
+
+#if defined(XNU_TARGET_OS_OSX)
+	/*
+	 * macOS: no firmware, no download: say so before any pin is touched (a kernel built without the private object).
+	 * icetouch_dry=1 stops after that check (a machine without the chip: QEMU).
+	 */
+	if (stage >= 2) {
+		uint32_t dry = 0;
+
+		PE_parse_boot_argn("icetouch_dry", &dry, sizeof(dry));
+		if (!fw_find() || fw_size < 2 * FLASH_SECTOR_SIZE || !fw_check_and_parse()) {
+			say("icetouch=%u needs the firmware: nothing touched\n", stage);
+			return;
+		}
+		if (dry) {
+			say("icetouch_dry: the firmware is good; nothing touched\n");
+			return;
+		}
+	}
+#endif
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	if (tlmm == 0) {
+		say("cannot map the TLMM\n");
+		return;
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		found_ctl[i] = rd(PIN_CTL(our_pins[i]));
+	}
+	found_intr_cfg = rd(PIN_INTR_CFG(PIN_INT));
+	pins_report("as found");
+	if (!bring_up(stage)) {
+		pins_restore();
+		pins_report("put back");
+		say("no touch screen\n");
+		return;
+	}
+	if (stage < 3) {
+		pins_restore();
+		say("icetouch=2: the firmware runs; stopping here (pins put back)\n");
+		return;
+	}
+	if (use_int) {
+		/* the edge detector latches the line's rising edges; the interrupt itself stays off (nothing to the GIC) */
+		wr(PIN_INTR_CFG(PIN_INT), (found_intr_cfg & ~(INTR_ENABLE | INTR_DETECT_MASK)) | INTR_POL_HIGH |
+		    INTR_DETECT_RISING | INTR_RAW_STATUS_EN);
+		wr(PIN_INTR_STATUS(PIN_INT), 0);
+	}
+	pins_report("touch screen ready");
+	say("touch screen ready: axes %u x %u, %s chip; reports to %s\n", abs_x_max, abs_y_max,
+	    cascade ? "cascade" : "single", TOUCH_SINK);
+	clock_interval_to_deadline(30, NSEC_PER_SEC, &next_status);
+	idle_since = now_us();
+	for (;;) {
+		uint64_t now = now_us();
+		bool any_down = false, edge = false, due;
+
+		for (unsigned i = 0; i <= TOUCH_MAX_FINGER_NUM; i++) {
+			any_down |= down[i];
+		}
+		if (use_int && (rd(PIN_INTR_STATUS(PIN_INT)) & 1)) {
+			wr(PIN_INTR_STATUS(PIN_INT), 0);
+			seen.edges++;
+			edge = true;
+		}
+		due = edge || now - last_read >= (any_down ? 25000u : 200000u);
+		if (due) {
+			last_read = now;
+			if (!read_report()) {
+				if (downloads >= 4) {
+					say("four downloads: giving up\n");
+					release_all();
+					pins_restore();
+					pins_report("put back");
+					return;
+				}
+				downloads++;
+				seen.recoveries++;
+				if (!nvt_download()) {
+					say("the new download failed: giving up\n");
+					pins_restore();
+					pins_report("put back");
+					return;
+				}
+				nvt_fw_info();
+				nvt_set_page(EVENT_BUF_ADDR);
+				doze_asked = false;            /* the re-downloaded firmware starts active: the doze is asked again */
+			}
+		}
+		/*
+		 * icetouch_rebase (w8-gains, G8 of survey/GAINS-DEEP-SCAN-2026-11-19.md): the idea read out of
+		 * ShengNovatekTouch@a88c26d1 - a reference that only follows the panel while nothing touches it. Our
+		 * NT36536 keeps its own baseline in its firmware and this driver reads processed reports, so the
+		 * applicable part is the observation: after N idle seconds the chip's reset state (the byte the boot
+		 * baseline wait checked, RESET_STATE_REK 0xa1) is read and said once; below it the wait is re-issued as
+		 * at bring-up and the outcome said. Nothing else is written - the running-firmware re-reference
+		 * command is UNVERIFIED for this chip (sheng probes its host commands on the NT36532), so this first
+		 * logs the drift, and the watchdog/re-download recovery paths stay what they are.
+		 */
+		if (rebase_s != 0) {
+			if (any_down) {
+				idle_since = now;
+			} else if (now - idle_since >= (uint64_t)rebase_s * 1000000u) {
+				uint8_t state = 0;
+				int looks = check_reset_state(RESET_STATE_REK, 1, &state);
+
+				idle_since = now;
+				seen.rebases++;
+				if (looks >= 0) {
+					say("icetouch_rebase: after %u s idle the baseline state is %#x: ready\n", rebase_s, state);
+				} else {
+					looks = check_reset_state(RESET_STATE_REK, 50, &state);
+					say("icetouch_rebase: after %u s idle the state fell to %#x: %s after the wait (%u so far)\n",
+					    rebase_s, state, looks >= 0 ? "ready again" : "still not ready", seen.rebases);
+				}
+			}
+		}
+		/*
+		 * icetouch_doze (install6, the ShengNovatekTouch doze return): a touch controller that has left doze streams
+		 * every scan for good and only the host can put it back - their thread sends the doze host command again
+		 * once three seconds pass without a finger, and on their hardware the touch thread then has no CPU time.
+		 * The ask is sent once per idle stretch (doze_asked stays set until a finger is seen, so the frames a wake
+		 * announces before the finger's first one do not send the chip straight back); a new download resets it, a
+		 * refusal is only counted. While the chip is asked into doze and nothing touches, the latch poll stretches
+		 * to 100 ms: the edge latch keeps any arriving touch, and the 200-ms idle read cadence above is unchanged,
+		 * so the first touch is still caught as today.
+		 */
+		if (doze_s != 0) {
+			if (any_down) {
+				idle_since = now;
+				doze_asked = false;
+			} else if (!doze_asked && now - idle_since >= (uint64_t)doze_s * 1000000u) {
+				doze_asked = true;
+				doze_reqs++;
+				if (nvt_custom_cmd(0x01, 0x02) == 0) {
+					say("icetouch_doze: after %llu s idle the chip is asked back into doze (request %u)\n",
+					    (now - idle_since) / 1000000u, doze_reqs);
+				} else {
+					doze_refused++;
+					say("icetouch_doze: request %u was not taken (touch continues; the chip may not know doze)\n",
+					    doze_reqs);
+				}
+			} else if (doze_asked) {
+				doze_wakes++;
+			}
+		}
+		if (mach_absolute_time() >= next_status) {
+			clock_interval_to_deadline(30, NSEC_PER_SEC, &next_status);
+			say("so far %u reads, %u reports, %u edges, %u handshakes, %u watchdog resets, %u bad positions, "
+			    "%u posted, %u pointer, %u digitizer frames%s; last chip %u, %u -> display %u, %u\n", seen.reads, seen.reports,
+			    seen.edges, seen.handshakes, seen.wdt, seen.bad, seen.posted, seen.pointer, seen.frames,
+			    rebase_s ? ", %u rebase looks" : "", rebase_s ? seen.rebases : 0, seen.lx, seen.ly,
+			    seen.dx, seen.dy);
+			if (doze_s) {
+				say("doze: %u requests, %u refused, %llu wakes after the last, idle %llu s\n", doze_reqs,
+				    doze_refused, doze_wakes, (now - idle_since) / 1000000u);
+			}
+		}
+		delay_for_interval(doze_asked && !any_down ? 100000u : poll_us, NSEC_PER_USEC);
+	}
+}
+
+void
+hakios_iceland_touch_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icetouch", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	if (stage > 3) {
+		stage = 3;
+	}
+	if (kernel_thread_start(icetouch_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_tsens.c b/bsd/dev/hakios_iceland_tsens.c
new file mode 100644
index 0000000000000000000000000000000000000000..8f27e8de451f66f372ddd80d718274e299aa3750
--- /dev/null
+++ b/bsd/dev/hakios_iceland_tsens.c
@@ -0,0 +1,350 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") temperature sensors, read only: seven TSENS controllers (TM blocks of
+ * one 4 KB page each), 55 sensors, as the Pad's own device tree has them. Nothing here writes a register: every access is
+ * a 32-bit read of a temperature, a threshold or a mask.
+ *
+ * Where the facts come from: the Pad's mainline device tree (kaanapali.dtsi tsens0-6 (reg[0] = the TM block,
+ * #qcom,sensors) and its thermal-zones, which name every sensor's zone); the register layout is Linux's tsens-v2
+ * (drivers/thermal/qcom/tsens-v2.c, tsens.c: TM = reg[0], the status of sensor n at TM + 0xa0 + 4n), facts only, written
+ * here.
+ *   tsens0 @ 0x0c229000, 5 sensors: cpullc-0-0/1 (cluster 0's cache), qmx-0-0..2
+ *   tsens1 @ 0x0c22a000, 12: cpu-0-0-0 .. cpu-0-5-1 (cpu0-5, two sensors each)
+ *   tsens2 @ 0x0c22b000, 7: cpullc-1-0/1, qmx-1-0..4
+ *   tsens3 @ 0x0c22c000, 4: cpu-1-0-0 .. cpu-1-1-1 (cpu6-7, the prime pair)
+ *   tsens4 @ 0x0c22d000, 8: nsphvx-0..3, nsphmx-0..3
+ *   tsens5 @ 0x0c22e000, 12: gpuss-0..10, ddr
+ *   tsens6 @ 0x0c22f000, 7: mdmss-0..3, camera-0/1, video
+ * In a TM block: INT_EN at 0x04; UPPER_LOWER_INT_MASK at 0x10; CRITICAL_INT_MASK at 0x1c; sensor n's upper / lower
+ * threshold at 0x20 + 4n (lower = bits 0-11, upper = bits 12-23, each a signed 12-bit count of tenths of a degree C);
+ * sensor n's critical threshold at 0x60 + 4n (bits 0-11, signed tenths); sensor n's status at 0xa0 + 4n: bits 0-11 = the
+ * last temperature (signed 12-bit tenths of a degree C), bit 21 = valid. A sensor without the valid bit has no reading and
+ * is skipped.
+ *
+ * Linux's trips on this tablet, for reference (its device tree's thermal-zones; they are Linux's policy, not registers:
+ * what the firmware itself left in the threshold registers is what icetsens=N's second line shows):
+ *   every SoC zone: hot at 120 C, critical at 125 C (Linux powers the tablet off there);
+ *   gpuss-0..10: passive at 105 C (hysteresis 5) with the GPU as cooling device -- what icegpu_thermal=1 follows;
+ *   the board's CPU, cache and QMX zones: passive at 95 C (a backstop), the CPU and cache zones also 105 C, 112 C
+ *     (cooling state 14) and 114 C (the lowest clock) -- what icecpu_trips=1 follows, under this kernel's own 90 C.
+ *
+ * Boot-args, all off unless given (without any of them nothing is mapped and no register is read):
+ *   icetsens=N  map the seven pages 2 s into the run and say what they hold: once, each controller's INT_EN and its two
+ *               masks, every sensor's temperature (a line a controller) and the thresholds the firmware set (a second
+ *               line a controller, lower/upper/critical in whole degrees C); then every N s one line with the hottest
+ *               sensor of each group (N == 1 means 10 s; N > 1 is clamped to 2..60). The mappings stay for the run, so
+ *               icecpu_trips / icegpu_thermal / thermal-level read them; N is the amount of talking, not the reading.
+ *   icecpu_trips=1, icegpu_thermal=1, thermal-level=1  no lines of this file's own: only the mapping and the groups, for
+ *               the CPU governor, the GPU's DCVS and the thermal level (each parses its own boot-arg; this file starts
+ *               when any of the four is given).
+ *   icethermal=1|2  the bundle (hakios_iceland_thermal_arg): 1 = icecpu_trips, icegpu_thermal, icegpu_caps,
+ *               ice_floor_yield, thermal-level; 2 = those and the CPU governor's icecpu_tstat, icecpu_ceil and
+ *               icecpu_gears. A consumer's own boot-arg still wins (name=0 turns it off); this file starts for the
+ *               bundle as it does for any of the four.
+ * On QEMU (the firmware's PSCI over HVC, psci_smp_hvc) the Pad's addresses do not exist: nothing is mapped and nothing
+ * is read, one line says so. Lines go to the kernel log, prefixed "icetsens:".
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+#include "hakios_iceland_tsens.h"
+
+#define say(...) printf("icetsens: " __VA_ARGS__)
+
+extern uint32_t psci_smp_hvc;           /* osfmk/arm64/psci_smp.c: 1 = the firmware's PSCI is called over HVC (QEMU) */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define TSENS_CONTROLLERS       7u
+#define TSENS_PAGE              0x1000u
+
+#define TM_INT_EN               0x04u
+#define TM_UPPER_LOWER_MASK     0x10u
+#define TM_CRITICAL_MASK        0x1cu
+#define TM_UPPER_LOWER          0x20u  /* sensor n's lower (bits 0-11) and upper (bits 12-23) threshold, tenths C */
+#define TM_CRITICAL             0x60u  /* sensor n's critical threshold, bits 0-11, tenths C */
+#define TM_STATUS               0xa0u  /* sensor n's last temperature, bits 0-11, bit 21 valid, tenths C */
+
+/* the controllers, in the device tree's order; a group's tables below index this array */
+static const struct {
+	uint32_t tm;
+	uint32_t count;
+} ice_tsens[TSENS_CONTROLLERS] = {
+	{ 0x0c229000u, 5 },             /* tsens0: cpullc-0-0/1, qmx-0-0..2 */
+	{ 0x0c22a000u, 12 },            /* tsens1: cpu-0-0-0 .. cpu-0-5-1 */
+	{ 0x0c22b000u, 7 },             /* tsens2: cpullc-1-0/1, qmx-1-0..4 */
+	{ 0x0c22c000u, 4 },             /* tsens3: cpu-1-0-0 .. cpu-1-1-1 */
+	{ 0x0c22d000u, 8 },             /* tsens4: nsphvx-0..3, nsphmx-0..3 */
+	{ 0x0c22e000u, 12 },            /* tsens5: gpuss-0..10, ddr */
+	{ 0x0c22f000u, 7 },             /* tsens6: mdmss-0..3, camera-0/1, video */
+};
+
+/*
+ * The groups in hakios_iceland_tsens.h's enum order: the controller, the first sensor of the group in it and how many
+ * sensors. (tsens0: 0,1 = cpullc-0-0/1, 2..4 = qmx-0-0..2; tsens1: 0..11 = cpu-0-0-0 .. cpu-0-5-1; tsens2: 0,1 =
+ * cpullc-1-0/1, 2..6 = qmx-1-0..4; tsens3: 0..3 = cpu-1-0-0 .. cpu-1-1-1; tsens4: 0..3 = nsphvx-0..3, 4..7 =
+ * nsphmx-0..3; tsens5: 0..10 = gpuss-0..10, 11 = ddr; tsens6: 0..3 = mdmss-0..3, 4,5 = camera-0/1, 6 = video.)
+ */
+static const struct {
+	uint8_t ctrl, first, count;
+} ice_group[ICETSENS_GROUPS] = {
+	{ 1, 0, 12 },                   /* ICETSENS_CPU0 */
+	{ 3, 0, 4 },                    /* ICETSENS_CPU1 */
+	{ 0, 0, 2 },                    /* ICETSENS_LLC0 */
+	{ 0, 2, 3 },                    /* ICETSENS_QMX0 */
+	{ 2, 0, 2 },                    /* ICETSENS_LLC1 */
+	{ 2, 2, 5 },                    /* ICETSENS_QMX1 */
+	{ 4, 0, 8 },                    /* ICETSENS_NSP */
+	{ 5, 0, 11 },                   /* ICETSENS_GPU */
+	{ 5, 11, 1 },                   /* ICETSENS_DDR */
+	{ 6, 0, 4 },                    /* ICETSENS_MODEM */
+	{ 6, 4, 2 },                    /* ICETSENS_CAMERA */
+	{ 6, 6, 1 },                    /* ICETSENS_VIDEO */
+};
+
+static vm_offset_t tsens_tm[TSENS_CONTROLLERS];
+static volatile uint32_t tsens_ready;   /* set last, after every page is mapped: the readers below take it first */
+
+/* the groups' short names, as the thermal-zones' zones name them (tsens_zones' line and the governor's hot trace) */
+static const char *tsens_names[ICETSENS_GROUPS] = {
+	"cpu0", "cpu1", "llc0", "qmx0", "llc1", "qmx1", "nsp", "gpu", "ddr", "modem", "cam", "video",
+};
+
+static inline uint32_t
+tsens_rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+/* bits 0-11 of v as a signed 12-bit number (as bsd/dev/hakios_iceland_cpu.c's domain_temp does it) */
+static inline int32_t
+tsens_deci(uint32_t v)
+{
+	return (int32_t)((v & 0xfff) << 20) >> 20;
+}
+
+/* a temperature in tenths of a degree C as "61.2" (the sign once, the fraction absolute); "-" when there is no reading */
+static const char *
+deci_str(char *buf, size_t size, int32_t deci)
+{
+	const int32_t a = deci < 0 ? -deci : deci;       /* the sign is printed once, the fraction is absolute */
+
+	if (deci <= -1000) {
+		return "-";
+	}
+	snprintf(buf, size, "%s%d.%d", deci < 0 ? "-" : "", a / 10, a % 10);
+	return buf;
+}
+
+/*
+ * The bundle boot-arg, icethermal=N (bundle 1 = the proven set, 2 = that and the CPU governor's tstat / ceil / gears):
+ * name's own boot-arg wins if it is on the line (name=0 turns that one off), otherwise 1 when icethermal >= bundle, else 0.
+ * Asked once by each consumer as it parses; nothing is cached, so a name=0 on the line needs no ordering.
+ */
+uint32_t
+hakios_iceland_thermal_arg(const char *name, uint32_t bundle)
+{
+	uint32_t v = 0, level = 0;
+
+	if (name != NULL && PE_parse_boot_argn(name, &v, sizeof(v))) {
+		return v;
+	}
+	if (PE_parse_boot_argn("icethermal", &level, sizeof(level)) && level >= bundle) {
+		return 1;
+	}
+	return 0;
+}
+
+/* icetsens=N, line a controller: the masks and every sensor's last temperature */
+static void
+tsens_show(unsigned c)
+{
+	char line[400], val[16];
+	int at;
+
+	at = snprintf(line, sizeof(line), "tsens%u: int_en %#x, upper/lower mask %#x, critical mask %#x; C:", c,
+	    tsens_rd(tsens_tm[c] + TM_INT_EN), tsens_rd(tsens_tm[c] + TM_UPPER_LOWER_MASK),
+	    tsens_rd(tsens_tm[c] + TM_CRITICAL_MASK));
+	for (uint32_t i = 0; i < ice_tsens[c].count && at > 0 && (size_t)at < sizeof(line); i++) {
+		const uint32_t v = tsens_rd(tsens_tm[c] + TM_STATUS + 4 * i);
+
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %s",
+		    (v & (1u << 21)) ? deci_str(val, sizeof(val), tsens_deci(v)) : "-");
+	}
+	say("%s\n", line);
+}
+
+/* icetsens=N, line a controller: the firmware's own thresholds in whole degrees C (tenths, divided by 10) */
+static void
+tsens_thresholds(unsigned c)
+{
+	char line[400];
+	int at;
+
+	at = snprintf(line, sizeof(line), "tsens%u: the firmware's thresholds, lower/upper/critical C:", c);
+	for (uint32_t i = 0; i < ice_tsens[c].count && at > 0 && (size_t)at < sizeof(line); i++) {
+		const uint32_t ul = tsens_rd(tsens_tm[c] + TM_UPPER_LOWER + 4 * i);
+		const uint32_t cr = tsens_rd(tsens_tm[c] + TM_CRITICAL + 4 * i);
+		const int32_t lower = tsens_deci(ul);
+		const int32_t upper = (int32_t)(((ul >> 12) & 0xfff) << 20) >> 20;
+		const int32_t critical = tsens_deci(cr);
+
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %d/%d/%d", lower / 10, upper / 10, critical / 10);
+	}
+	say("%s\n", line);
+}
+
+/* icetsens=N, the periodic line: the hottest sensor of each group (its name, as the thermal-zones' zones name them) */
+static void
+tsens_zones(void)
+{
+	char line[400], val[16];
+	int at;
+
+	at = snprintf(line, sizeof(line), "zones:");
+	for (unsigned g = 0; g < ICETSENS_GROUPS && at > 0 && (size_t)at < sizeof(line); g++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %s %s", tsens_names[g],
+		    deci_str(val, sizeof(val), hakios_iceland_tsens_group_deci(g)));
+	}
+	say("%s C (the hottest sensor of each)\n", line);
+}
+
+/*
+ * 2 s into the run: the Pad or not, the pages, then (icetsens=N only) the dump and the periodic line. The 2 s only keep
+ * these lines out of the first seconds' log.
+ */
+static void
+tsens_thread(void *arg, wait_result_t w __unused)
+{
+	const uint32_t n = (uint32_t)(uintptr_t)arg;
+	uint32_t trips = 0, gpu = 0, level = 0, every;
+
+	delay_for_interval(2000, NSEC_PER_MSEC);
+	if (psci_smp_hvc) {
+		say("PSCI is over hvc here: not the Pad, nothing mapped or read\n");
+		return;
+	}
+	for (uint32_t c = 0; c < TSENS_CONTROLLERS; c++) {
+		tsens_tm[c] = ml_io_map(ice_tsens[c].tm, TSENS_PAGE);
+		if (tsens_tm[c] == 0) {
+			say("tsens%u at %#x: ml_io_map gave nothing: no sensor is read\n", c, ice_tsens[c].tm);
+			return;                 /* (tsens_ready stays 0: the readers keep their -1000) */
+		}
+	}
+	/* (read here again: this file starts for any of the four, and the line says which one asked) */
+	trips = hakios_iceland_thermal_arg("icecpu_trips", 1);
+	gpu = hakios_iceland_thermal_arg("icegpu_thermal", 1);
+	level = hakios_iceland_thermal_arg("thermal-level", 1);
+	__atomic_store_n(&tsens_ready, 1, __ATOMIC_RELEASE);
+	say("mapped: 7 controllers, 55 sensors; read only, no register is written (icetsens=%u icecpu_trips=%u icegpu_thermal=%u "
+	    "thermal-level=%u)\n", n, trips, gpu, level);
+	if (n == 0) {
+		return;                         /* (the other three only read the groups) */
+	}
+	for (uint32_t c = 0; c < TSENS_CONTROLLERS; c++) {
+		tsens_show(c);
+		tsens_thresholds(c);
+	}
+	every = n == 1 ? 10 : n < 2 ? 2 : n > 60 ? 60 : n;
+	say("every %u s: the hottest sensor of each group (tenths of a degree C, \"-\" = no valid reading)\n", every);
+	for (;;) {
+		delay_for_interval(every * 1000, NSEC_PER_MSEC);
+		tsens_zones();
+	}
+}
+
+void
+hakios_iceland_tsens_init(void)
+{
+	static bool started;
+	uint32_t n = 0, trips = 0, gpu = 0, level = 0;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	(void)PE_parse_boot_argn("icetsens", &n, sizeof(n));
+	trips = hakios_iceland_thermal_arg("icecpu_trips", 1);
+	gpu = hakios_iceland_thermal_arg("icegpu_thermal", 1);
+	level = hakios_iceland_thermal_arg("thermal-level", 1);
+	if (n == 0 && trips == 0 && gpu == 0 && level == 0 &&
+	    hakios_iceland_thermal_arg("icecpu_tstat", 2) == 0 && hakios_iceland_thermal_arg("icecpu_ceil", 2) == 0) {
+		return;                         /* nothing asked: no thread, no mapping, no read */
+	}
+	started = true;
+	if (kernel_thread_start(tsens_thread, (void *)(uintptr_t)n, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * A group's hottest sensor with a valid reading, tenths of a degree C. Safe from any thread: the mappings are made once,
+ * before tsens_ready, and the pages are never given back.
+ */
+int32_t
+hakios_iceland_tsens_group_deci(unsigned group)
+{
+	int32_t hottest = -1000;
+
+	if (__atomic_load_n(&tsens_ready, __ATOMIC_ACQUIRE) == 0 || group >= ICETSENS_GROUPS) {
+		return -1000;
+	}
+	const vm_offset_t tm = tsens_tm[ice_group[group].ctrl];
+
+	for (uint32_t i = 0; i < ice_group[group].count; i++) {
+		const uint32_t v = tsens_rd(tm + TM_STATUS + 4 * (ice_group[group].first + i));
+		const int32_t deci = tsens_deci(v);
+
+		if ((v & (1u << 21)) && deci > hottest) {
+			hottest = deci;
+		}
+	}
+	return hottest;
+}
+
+/* the hottest of everything but the cores (the cache, QMX, NSP, GPU, DDR, modem, camera and video zones) */
+int32_t
+hakios_iceland_tsens_soc_deci(void)
+{
+	int32_t hottest = -1000;
+
+	for (unsigned g = ICETSENS_LLC0; g < ICETSENS_GROUPS; g++) {
+		const int32_t t = hakios_iceland_tsens_group_deci(g);
+
+		if (t > hottest) {
+			hottest = t;
+		}
+	}
+	return hottest;
+}
+
+/* the hottest sensor of the whole SoC and the group it is in (the governor's 20 ms instrument, icecpu_tstat=1) */
+int32_t
+hakios_iceland_tsens_hottest(unsigned *group)
+{
+	int32_t hottest = -1000;
+	unsigned which = 0;
+
+	for (unsigned g = 0; g < ICETSENS_GROUPS; g++) {
+		const int32_t t = hakios_iceland_tsens_group_deci(g);
+
+		if (t > hottest) {
+			hottest = t;
+			which = g;
+		}
+	}
+	if (group != NULL) {
+		*group = which;
+	}
+	return hottest;
+}
+
+/* a group's short name, the one tsens_zones' line uses; "?" for anything else */
+const char *
+hakios_iceland_tsens_group_name(unsigned group)
+{
+	return group < ICETSENS_GROUPS ? tsens_names[group] : "?";
+}
diff --git a/bsd/dev/hakios_iceland_tsens.h b/bsd/dev/hakios_iceland_tsens.h
new file mode 100644
index 0000000000000000000000000000000000000000..913f5886c3047b540dcf6dde5506e8f93c29e118
--- /dev/null
+++ b/bsd/dev/hakios_iceland_tsens.h
@@ -0,0 +1,63 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") temperature sensors as a shared platform layer: seven TSENS
+ * controllers, 55 sensors, read only. For the CPU governor (bsd/dev/hakios_iceland_cpu.c, boot-arg icecpu_trips=1), the
+ * GPU's DCVS (bsd/dev/hakios_iceland_gpu.c, icegpu_thermal=1) and macOS's thermal pressure level
+ * (iokit/Kernel/HakiosIcelandThermalLevel.cpp, thermal-level=1). The register layout that is read, the boot-args that
+ * start the layer and why nothing in it writes a register are in bsd/dev/hakios_iceland_tsens.c.
+ */
+#ifndef _HAKIOS_ICELAND_TSENS_H_
+#define _HAKIOS_ICELAND_TSENS_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * The groups: a controller of the seven and the sensors of it that belong to the group. CPU0 / CPU1 are the cores
+ * themselves (tsens1 / tsens3, the governor's own); every other group is the rest of the SoC, whose zones the CPU side and
+ * the GPU still share thermals with.
+ */
+enum {
+	ICETSENS_CPU0 = 0,      /* tsens1 0-11: cpu-0-0-0 .. cpu-0-5-1 (cpu0-5, two sensors each) */
+	ICETSENS_CPU1,          /* tsens3 0-3: cpu-1-0-0 .. cpu-1-1-1 (cpu6-7) */
+	ICETSENS_LLC0,          /* tsens0 0-1: cpullc-0-0/1, cluster 0's cache */
+	ICETSENS_QMX0,          /* tsens0 2-4: qmx-0-0..2 */
+	ICETSENS_LLC1,          /* tsens2 0-1: cpullc-1-0/1 */
+	ICETSENS_QMX1,          /* tsens2 2-6: qmx-1-0..4 */
+	ICETSENS_NSP,           /* tsens4 0-7: nsphvx-0..3, nsphmx-0..3 */
+	ICETSENS_GPU,           /* tsens5 0-10: gpuss-0..10 */
+	ICETSENS_DDR,           /* tsens5 11: ddr */
+	ICETSENS_MODEM,         /* tsens6 0-3: mdmss-0..3 */
+	ICETSENS_CAMERA,        /* tsens6 4-5: camera-0/1 */
+	ICETSENS_VIDEO,         /* tsens6 6: video */
+	ICETSENS_GROUPS
+};
+
+/* once, from hakios_iceland_cpu_init: a thread that maps the pages 2 s later (nothing at all without a boot-arg) */
+void hakios_iceland_tsens_init(void);
+
+/* the hottest sensor of the group with a valid reading, in tenths of a degree C; -1000: none, not ready, not mapped */
+int32_t hakios_iceland_tsens_group_deci(unsigned group);
+
+/* the hottest sensor of everything but the cores (ICETSENS_LLC0 on), tenths of a degree C; -1000: none */
+int32_t hakios_iceland_tsens_soc_deci(void);
+
+/*
+ * w5-thermal, boot-arg icethermal=N (1 = the proven set, 2 = that and the CPU governor's icecpu_tstat / icecpu_ceil /
+ * icecpu_gears): name's own boot-arg if it is on the line (name=0 turns it off), else 1 when icethermal >= bundle, else 0.
+ */
+uint32_t hakios_iceland_thermal_arg(const char *name, uint32_t bundle);
+
+/* the hottest valid sensor of all the groups, tenths of a degree C, and (through group) its group index; -1000 and 0: none */
+int32_t hakios_iceland_tsens_hottest(unsigned *group);
+
+/* a group's short name, the one tsens_zones' line uses: "cpu0" .. "video"; "?" out of range */
+const char *hakios_iceland_tsens_group_name(unsigned group);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _HAKIOS_ICELAND_TSENS_H_ */
diff --git a/bsd/dev/hakios_iceland_ucsi.h b/bsd/dev/hakios_iceland_ucsi.h
new file mode 100644
index 0000000000000000000000000000000000000000..78b02c027be46a203801c59c3e047e1081e3c941
--- /dev/null
+++ b/bsd/dev/hakios_iceland_ucsi.h
@@ -0,0 +1,292 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * lane E (24 Nov 2026): the UCSI connector state machine of UniXNU/QcomDwc3 QcomUcsi.h (Copyright (c) 2026, UniXNU
+ * contributors, BSD-2-Clause-Patent; read at d4e96f3 / 45f5ed4, research/refs/qcomdwc3-2026-11-16b), re-written in C for
+ * xnu's bsd/dev (no C++ enum bases), with two changes: a read answer is handed in as its first bytes plus its length
+ * (bsd/dev/hakios_iceland_battery.c keeps only those), and the SET_UOR data-host request is left out (PD charger
+ * authentication is sheng's, not ours). "UCSI over Qualcomm PMIC GLINK, one connector: what the port manager says is on
+ * the other end of the cable. The order of commands and the message layout follow Linux drivers/usb/typec/ucsi/ucsi.c
+ * and ucsi_glink.c. No I/O and no waits: the owner hands in each message and tick, and sends what comes back in out."
+ * Linux facts (GPL-2.0, facts only; linux a2e1ea44d3c3 drivers/usb/typec/ucsi/ucsi.h:51-60, 113-158, 345-375): CCI
+ * connector [7:1], length [15:8], not supported 25, reset complete 27, busy 28, ack complete 29, error 30, command
+ * complete 31; connector status: power operation mode [18:16], connected 19, power direction 20 (1 = we source), partner
+ * flags [28:21] (USB 21, alt mode 22), partner type [31:29] (1 DFP, 2 UFP, 3 powered cable, 4 cable + UFP, 5 debug,
+ * 6 audio); the RDO [63:32]; orientation bit 86 (UCSI 2.0).
+ * Pure: compiled by the kernel and by the host test runs/laneE/tests/t-ucsi.c alike.
+ */
+#ifndef HAKIOS_ICELAND_UCSI_H
+#define HAKIOS_ICELAND_UCSI_H
+
+#define UCSI_OWNER              32779u
+#define UCSI_V1_BUFFER          48u
+#define UCSI_V2_BUFFER          528u
+#define UCSI_MAX_MESSAGE        (12u + UCSI_V2_BUFFER + 4u)
+#define UCSI_KEEP               64u     /* the bytes of a read answer the machine looks at: header 12 + 48 */
+#define UCSI_OP_READ            0x11u
+#define UCSI_OP_WRITE           0x12u
+#define UCSI_OP_NOTIFY          0x13u
+#define UCSI_OFF_VERSION        0u
+#define UCSI_OFF_CCI            4u
+#define UCSI_OFF_CONTROL        8u
+#define UCSI_OFF_MESSAGE_IN     16u
+#define UCSI_CCI_RESET          (1u << 27)
+#define UCSI_CCI_BUSY           (1u << 28)
+#define UCSI_CCI_ACK            (1u << 29)
+#define UCSI_CCI_ERROR          (1u << 30)
+#define UCSI_CCI_DONE           (1u << 31)
+#define UCSI_CMD_RESET          0x01ull
+#define UCSI_CMD_CLEAR_RESET    0x05ull                         /* SET_NOTIFICATION_ENABLE, nothing enabled */
+#define UCSI_CMD_ENABLE_ALL     (0x05ull | 0xdbe70000ull)
+#define UCSI_CMD_STATUS         (0x12ull | 1ull << 16)          /* GET_CONNECTOR_STATUS, connector 1 */
+#define UCSI_CMD_ACK_COMMAND    (0x04ull | 1ull << 17)
+#define UCSI_CMD_ACK_CHANGE     (0x04ull | 1ull << 16)
+#define UCSI_PARTNER_DFP        1
+#define UCSI_PARTNER_UFP        2
+#define UCSI_PARTNER_CABLE      3
+#define UCSI_PARTNER_CABLE_UFP  4
+#define UCSI_POLLS              250     /* polls of 20 ms for one command: 5 s, as QcomDwc3 */
+
+enum {
+	UCSI_IDLE, UCSI_FIRST_READ, UCSI_CLEARING, UCSI_RESETTING, UCSI_ENABLING, UCSI_ACK_ENABLE, UCSI_ASK_STATUS,
+	UCSI_ACK_STATUS, UCSI_ACK_CHANGE_SENT, UCSI_READY, UCSI_FAILED
+};
+
+struct iceland_ucsi {
+	int state;
+	uint32_t buffer_bytes, version, cci, status, rdo, polls, polling, changes, errors, generation;
+	int change_pending, change_read;
+	int connected, partner, usb, source, opmode, status_valid;
+	int connect_change_latched;
+};
+
+static inline void
+ucsi_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+static inline uint32_t
+ucsi_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint32_t
+ucsi_read_request(uint8_t *out)
+{
+	ucsi_put32(out, UCSI_OWNER); ucsi_put32(out + 4, 1); ucsi_put32(out + 8, UCSI_OP_READ);
+	return 12;
+}
+
+/* out must hold UCSI_MAX_MESSAGE bytes */
+static inline uint32_t
+ucsi_write_request(const struct iceland_ucsi *u, uint8_t *out, uint64_t control)
+{
+	uint32_t n = 12 + u->buffer_bytes + 4;
+
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = 0;
+	}
+	ucsi_put32(out, UCSI_OWNER); ucsi_put32(out + 4, 1); ucsi_put32(out + 8, UCSI_OP_WRITE);
+	ucsi_put32(out + 12 + UCSI_OFF_CONTROL, (uint32_t)control);
+	ucsi_put32(out + 12 + UCSI_OFF_CONTROL + 4, (uint32_t)(control >> 32));
+	return n;
+}
+
+/* the channel came up: ask for the buffer */
+static inline uint32_t
+ucsi_start(struct iceland_ucsi *u, uint8_t *out)
+{
+	uint8_t *z = (uint8_t *)u;
+
+	for (uint32_t i = 0; i < sizeof(*u); i++) {
+		z[i] = 0;
+	}
+	u->state = UCSI_FIRST_READ;
+	u->buffer_bytes = UCSI_V1_BUFFER;
+	return ucsi_read_request(out);
+}
+
+static inline uint32_t
+ucsi_command(struct iceland_ucsi *u, int state, uint8_t *out, uint64_t control)
+{
+	u->state = state;
+	u->polls = 0;
+	u->polling = 0;
+	return ucsi_write_request(u, out, control);
+}
+
+/* a complete read answer's UCSI buffer (version, CCI, control, message in: its first 48 bytes) */
+static inline uint32_t
+ucsi_advance(struct iceland_ucsi *u, uint8_t *out, const uint8_t *buffer)
+{
+	const uint32_t cci = ucsi_get32(buffer + UCSI_OFF_CCI);
+
+	u->cci = cci;
+	if (!u->version) {
+		u->version = ucsi_get32(buffer + UCSI_OFF_VERSION) & 0xffffu;
+	}
+	/* ucsi_notify_common: busy makes the rest of the CCI bogus; a connector number reports a change */
+	if (cci & UCSI_CCI_BUSY) {
+		u->polling = u->state != UCSI_READY;
+		return 0;
+	}
+	if (((cci >> 1) & 0x7fu) && !u->change_read && u->state >= UCSI_ASK_STATUS) {
+		u->change_pending = 1;
+	}
+	switch (u->state) {
+	case UCSI_FIRST_READ:
+		/* ucsi_reset_ppm: a latched reset completion is cleared first */
+		if (cci & UCSI_CCI_RESET) {
+			return ucsi_command(u, UCSI_CLEARING, out, UCSI_CMD_CLEAR_RESET);
+		}
+		return ucsi_command(u, UCSI_RESETTING, out, UCSI_CMD_RESET);
+	case UCSI_CLEARING:
+		if (cci & UCSI_CCI_DONE) {
+			return ucsi_command(u, UCSI_RESETTING, out, UCSI_CMD_RESET);
+		}
+		break;
+	case UCSI_RESETTING:
+		if (cci & UCSI_CCI_RESET) {
+			return ucsi_command(u, UCSI_ENABLING, out, UCSI_CMD_ENABLE_ALL);
+		}
+		break;
+	case UCSI_ENABLING:
+		if (cci & (UCSI_CCI_DONE | UCSI_CCI_ERROR)) {
+			return ucsi_command(u, UCSI_ACK_ENABLE, out, UCSI_CMD_ACK_COMMAND);
+		}
+		break;
+	case UCSI_ACK_ENABLE:
+		if (cci & UCSI_CCI_ACK) {
+			return ucsi_command(u, UCSI_ASK_STATUS, out, UCSI_CMD_STATUS);
+		}
+		break;
+	case UCSI_ASK_STATUS:
+		if (cci & UCSI_CCI_ERROR) {
+			u->errors++;
+			return ucsi_command(u, UCSI_ACK_STATUS, out, UCSI_CMD_ACK_COMMAND);
+		}
+		if (cci & UCSI_CCI_DONE) {
+			const uint32_t status = ucsi_get32(buffer + UCSI_OFF_MESSAGE_IN);
+			const int connected = (status >> 19) & 1;
+			const int connect_change = (status >> 14) & 1;
+
+			if (!u->status_valid || connected != u->connected || (connect_change && !u->connect_change_latched)) {
+				u->generation++;
+			}
+			if (connect_change) {
+				u->connect_change_latched = 1;
+			}
+			u->status = status;
+			u->rdo = ucsi_get32(buffer + UCSI_OFF_MESSAGE_IN + 4);
+			u->connected = connected;
+			u->usb = (status >> 21) & 1;
+			u->source = (status >> 20) & 1;
+			u->opmode = (status >> 16) & 7;
+			u->partner = (int)(status >> 29);
+			u->status_valid = 1;
+			return ucsi_command(u, UCSI_ACK_STATUS, out, UCSI_CMD_ACK_COMMAND);
+		}
+		break;
+	case UCSI_ACK_STATUS:
+		if (cci & UCSI_CCI_ACK) {
+			/* ucsi_handle_connector_change: the status first, then the acknowledge of the change */
+			if (u->change_read) {
+				u->change_read = 0;
+				u->changes++;
+				return ucsi_command(u, UCSI_ACK_CHANGE_SENT, out, UCSI_CMD_ACK_CHANGE);
+			}
+			if (u->change_pending) {
+				u->change_pending = 0;
+				u->change_read = 1;
+				return ucsi_command(u, UCSI_ASK_STATUS, out, UCSI_CMD_STATUS);
+			}
+			u->state = UCSI_READY;
+			u->polling = 0;
+			return 0;
+		}
+		break;
+	case UCSI_ACK_CHANGE_SENT:
+		if (cci & UCSI_CCI_ACK) {
+			u->connect_change_latched = 0;
+			if (u->change_pending) {
+				u->change_pending = 0;
+				u->change_read = 1;
+				return ucsi_command(u, UCSI_ASK_STATUS, out, UCSI_CMD_STATUS);
+			}
+			u->state = UCSI_READY;
+			u->polling = 0;
+			return 0;
+		}
+		break;
+	case UCSI_READY:
+		if (u->change_pending) {
+			u->change_pending = 0;
+			u->change_read = 1;
+			return ucsi_command(u, UCSI_ASK_STATUS, out, UCSI_CMD_STATUS);
+		}
+		return 0;
+	default:
+		return 0;
+	}
+	u->polling = 1;         /* the state did not move: the tick reads again */
+	return 0;
+}
+
+/*
+ * A message of the USB-C owner: `data` holds its first `kept` bytes (at least the header, at most UCSI_KEEP), `length`
+ * is its whole length. Returns the bytes to send (in out).
+ */
+static inline uint32_t
+ucsi_receive(struct iceland_ucsi *u, const uint8_t *data, uint32_t kept, uint32_t length, uint8_t *out)
+{
+	uint32_t opcode, bytes;
+
+	if (kept < 12 || ucsi_get32(data) != UCSI_OWNER || u->state == UCSI_IDLE || u->state == UCSI_FAILED) {
+		return 0;
+	}
+	opcode = ucsi_get32(data + 8);
+	if (opcode == UCSI_OP_NOTIFY || opcode == UCSI_OP_WRITE) {
+		return ucsi_read_request(out);  /* the indication says only to read the CCI; a write: read how it went */
+	}
+	if (opcode != UCSI_OP_READ || length < 16 + UCSI_V1_BUFFER || kept < 12 + 28) {
+		return 0;
+	}
+	bytes = length - 16;
+	if (bytes != UCSI_V1_BUFFER && bytes != UCSI_V2_BUFFER) {
+		return 0;
+	}
+	u->buffer_bytes = bytes;
+	return ucsi_advance(u, out, data + 12);
+}
+
+/* every 20 ms while polling is set */
+static inline uint32_t
+ucsi_tick(struct iceland_ucsi *u, uint8_t *out)
+{
+	if (!u->polling) {
+		return 0;
+	}
+	if (++u->polls > UCSI_POLLS) {
+		u->state = UCSI_FAILED;
+		u->polling = 0;
+		return 0;
+	}
+	u->polling = 0;
+	return ucsi_read_request(out);
+}
+
+/* the role the cable asks of us: 1 host (a peripheral), 0 device (a computer, or nothing), -1 not known yet */
+static inline int
+ucsi_wants_host(const struct iceland_ucsi *u)
+{
+	if (!u->status_valid || u->state == UCSI_FAILED) {
+		return -1;
+	}
+	if (!u->connected) {
+		return 0;
+	}
+	return u->partner == UCSI_PARTNER_UFP || u->partner == UCSI_PARTNER_CABLE_UFP;
+}
+
+#endif /* HAKIOS_ICELAND_UCSI_H */
diff --git a/bsd/dev/hakios_iceland_ufs.c b/bsd/dev/hakios_iceland_ufs.c
new file mode 100644
index 0000000000000000000000000000000000000000..d992b3979c02f67157ca2593dda6eeb4b0ce50d5
--- /dev/null
+++ b/bsd/dev/hakios_iceland_ufs.c
@@ -0,0 +1,4230 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") UFS 4 storage, READ ONLY, through the host controller as U-Boot
+ * left it. Only with boot-arg iceufs=N; without it nothing here is touched.
+ *
+ * U-Boot (v8, qcom-ufshcd) brings the controller and the link up (gear 5, 2 lanes, legacy doorbell mode) and keeps
+ * one transfer request slot (tag 0) with one command descriptor of its own (drivers/ufs/ufs-uclass.c: utrdl, ucdl;
+ * ufshci.h: 512-byte command and response UPIUs, 128 PRDT entries), rebuilt for every command it sends. This driver
+ * borrows that slot for one command at a time: its 32-byte descriptor and the parts of the command descriptor used are
+ * saved, the command is put in, the doorbell rung and polled, then everything saved is written back -- so the
+ * controller and U-Boot's memory are as U-Boot left them when the loader returns. Nothing else is changed: no reset,
+ * no UIC command (but the wake path's HIBERN8 exit when the link is found asleep: iceufs_wake, by wake_if_asleep), no
+ * list base (but with iceufs_ownlist=1, below), no interrupt enable, no clock or power setting, no task management;
+ * IS's completion bit is written back to clear only if this command set it.
+ *
+ * Read only by construction: commands are built here only as TEST UNIT READY, INQUIRY, READ CAPACITY(10/16) and
+ * READ(10/16), all to LUN 0, data direction "device to host" or none, UPIU flags R or none; each is checked against
+ * that list (ufs_permitted) after it is written into the slot and before the doorbell is rung. The one exception is
+ * the wake path's START STOP UNIT (POWER CONDITION ACTIVE, no data) to the UFS device W-LU 0xd0, let through only
+ * while wake() runs: a power-state command, not a storage write.
+ *
+ * Every value is the Pad's own: kaanapali.dtsi ufs_mem_hc: ufs@1d84000 ("std", 0x3000; "mcq" 0x1da0000 never
+ * touched); UFSHCI register layout (U-Boot's ufshci.h, Linux's ufshci.h); U-Boot's log on this tablet: LUN 0 of the
+ * SAMSUNG KLUEG4RHKF, 61853696 blocks of 4096 bytes.
+ *
+ *   iceufs=1  read only: the controller's registers (capabilities, version, status, enable, interrupts, list base,
+ *             doorbell, run-stop, MCQ config) and U-Boot's slot 0 descriptor
+ *   iceufs=2  ... and TEST UNIT READY, INQUIRY, READ CAPACITY(10/16) on LUN 0
+ *   iceufs=3  ... and READ: blocks 0-1 (the GPT header at block 1: "EFI PART"), then iceufs_mb (64) MB from block 0
+ *             in 512 KB reads: speed and a checksum
+ *   iceufs=4  ... and a READ-ONLY BLOCK DEVICE for iOS: the GPT of LUN 0 (header and table CRCs checked) and
+ *             /dev/iceufs0 (the whole LUN), /dev/iceufs0sN (GPT entry N, numbered from 1 as on macOS), their
+ *             character twins /dev/riceufs0, /dev/riceufs0sN; then a self-test through those nodes (below)
+ *             iceufs_name=PFX  the nodes' prefix instead of "iceufs" (letters and digits; e.g. "disk" for
+ *                              /dev/disk0sN -- iOS daemons know /dev/disk0 as the system disk: not the default)
+ *             iceufs_part=NAME the partition the self-test reads (default "userdata"; else entry 1)
+ *
+ * The block device never writes: open for writing gives EROFS, the strategy routine refuses any buffer that is not a
+ * read (EROFS), the character device's write gives EROFS, DKIOCISWRITABLE says 0 -- and under all that the SCSI
+ * whitelist still refuses anything but the five reads above. Reads go through one 512 KB buffer of this kernel's,
+ * one command at a time (a mutex), and are copied out of it (normal memory); unaligned byte ranges are read as whole
+ * 4 KB blocks. The self-test (iceufs=4) logs, prefixed "iceufs:": the partition list (names, first block, size --
+ * never a GUID or a serial), the test partition's first block read through /dev/riceufs0sN and /dev/iceufs0sN and
+ * compared with a direct read, "EFI PART" through /dev/riceufs0, three refused writes, and "SELF-TEST PASS"/"FAIL".
+ *
+ * The macOS root (plan S8-1, MACOS-REPLACES-BLISSROM.md): with iceufs=2 or more, once the unit is up (TEST UNIT READY,
+ * INQUIRY and READ CAPACITY passed) and no icevar fence is set, hakios_iceland_ufs_root_read() hands LUN 0's blocks to
+ * the kernel's UFS root transport (hakios-macos base/storage/NativeIcelandUfs.cpp, native-ufs-root=1), which finds
+ * userdata in LUN 0's GPT and publishes its verified root windows. Those reads are READ(16) like every read here, through
+ * the same slot, buffer and whitelist, one command at a time; nothing on this path can write. The root needs LUN 0
+ * before there is a root, so its wait (hakios_iceland_ufs_root_wait) starts the probe thread if redwood_input_init, which
+ * runs only after the root is mounted, has not yet: the thread runs once either way.
+ *
+ *   iceufs_ownlist=1  U-Boot's list is not borrowed: the list moves into a page of the kernel's (the list stopped while
+ *                  its base changes; U-Boot's base back at the run's end), for when U-Boot's memory may have become
+ *                  the kernel's (the A3 route: "U-Boot's list ... is inside the kernel's memory"). Host registers
+ *                  only; the commands, the whitelist and the one slot are as without it.
+ *   iceufs=4 started before the root (by the root's wait) keeps the self-test, which opens /dev nodes by path, until
+ *                  redwood_input_init has run (the root and /dev mounted); the GPT list and the nodes come at once.
+ *   iceufs_sha=FIRST:COUNT[,...]  with the root reader open: the SHA-256 of up to 12 ranges of LUN 0 (4096-byte blocks)
+ *                  as read here, to compare with Fedora's read of the same blocks or with mk-userdata.py's manifest
+ *   iceufs_hc=PA   the controller's physical address instead of the Pad's 0x1d84000: QEMU's UFS (-device ufs, a PCI
+ *                  function), at the BAR U-Boot's ufs_pci gave it. MEM_CFG (MCQ, UFSHCI 4.0) is read only from a
+ *                  controller of version 4.0 or later; earlier ones have no such register.
+ *   iceufs_smmu=1  (the Pad's controller only) a read-only census of the apps SMMU's Global Register Space 0 for the
+ *                  UFS's stream 0x60: its stream match registers and their S2CRs (dma_census). The DMA targets (the
+ *                  data buffer's physical runs, U-Boot's descriptors) are said at every stage >= 2 without it.
+ *   iceufs_native=1  (lane B, OFF by default) the native path: our own 32-slot list, the root's reads and the windows'
+ *                  writes on up to iceufs_qd (8) queued tags, completions by GIC SPI 265 (iceufs_irq=0: polled), UTRLCLR
+ *                  recovery, auto-hibern8 (iceufs_ah8=0: none); iceufs_native=2 the same and a read-only bench. Every
+ *                  command is judged by the same whitelist. See "the native path" below. Without it nothing of it runs.
+ *
+ * At loader return (osfmk/arm64/loader_return.c) hakios_iceland_ufs_close() lets a command in flight finish and
+ * U-Boot's slot be put back before the other processors are stopped; nothing is borrowed after that.
+ *
+ * icevar (only with iceufs=2 and icevar=1|2; plan section 9.28): ONE image file on Fedora's btrfs
+ * (/var/lib/iceland-xnu/var.img, NOCOW, uncompressed, not shared), placed by Fedora's arm step (icevar-prep): it writes
+ * a header into the file's first 4 KB block -- magic, the partition's name / first block / size, the file's extents
+ * as partition blocks, a write window in file blocks, a random tag made at that arm, the SHA-256 of the file's other
+ * blocks, a CRC -- checks every extent by reading the raw partition, and gives the header's partition block and the tag
+ * as boot-args (icevar_at=, icevar_tag=; all zero = not armed: nothing is done). This driver reads that block, checks
+ * all of it against the GPT and the boot-args, and from then on READS ONLY INSIDE THE FILE (a fence in read_blocks).
+ *   icevar=1  read only: the header, the extent list (logged), the file's blocks 1..N-1 read through the extents and
+ *             hashed (must match the header's SHA-256), reads outside the file and a WRITE(16) inside the window refused
+ *   icevar=2  ... and the WRITE TEST: exactly one 4 KB block (the window's first) written with WRITE(16) FUA, the cache
+ *             synchronised, read back with FUA and compared; the neighbours and the header read again (unchanged).
+ *             The whitelist lets a WRITE(16) through only in this mode, after the header was accepted, to LUN 0, flags
+ *             W only, direction host to device, length = count x 4 KB, inside the window (never the header block),
+ *             inside one extent, and within the boot's budget of one block; SYNCHRONIZE CACHE(10) only in this mode.
+ *             Everything else is refused before the doorbell (self-tests: header, before / after the window, LUN 0
+ *             block 0, two blocks, WRITE(10), LUN 1, and a second write once the budget is spent).
+ *
+ * S8-5, the data and log windows (MACOS-REPLACES-BLISSROM.md section 4: the owner's standing yes for exactly these two):
+ *   iceufs_write=1  the kernel may write LUN 0 blocks 45587712..61591039 (userdata's inner GPT entry "data") and
+ *                   61591040..61853183 ("log"), 4096 bytes each, and nothing else; see "the data and log windows" below.
+ *                   Without it (the default) nothing is armed and the whitelist refuses every WRITE, as before S8-5.
+ */
