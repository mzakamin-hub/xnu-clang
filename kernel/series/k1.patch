+/*
+ * 23h0's reads; the S5 branch vote is left ON when keep (23h) - *vote0 gets the vote register as found. Returns the SE's
+ * protocol (2 = UART), -1 if the registers were not read.
+ */
+static int
+h0_probe(bool keep, uint32_t *vote0)
+{
+	vm_offset_t gcc = ml_io_map_unmappable(GCC_PA, 0xb0000, VM_WIMG_IO);
+	vm_offset_t qup = ml_io_map_unmappable(QUP3_PA, PAGE_SIZE, VM_WIMG_IO);
+	vm_offset_t se = ml_io_map_unmappable(SE5_PA, 0x4000, VM_WIMG_IO);
+	static const uint32_t cbcr[] = { 0x233f0, 0x233f4, 0x233f8, 0x2340c, 0xa8630 };
+	static const char *const cn[] = { "m_ahb", "s_ahb", "core", "core2x", "s5" };
+	uint32_t v18;
+	bool on = true;
+	int proto;
+
+	if (gcc == 0 || qup == 0 || se == 0) {
+		say("icegeni: not mapped\n");
+		return -1;
+	}
+	h_gcc = gcc;
+	v18 = io_rd(gcc, 0x52018);
+	*vote0 = v18;
+	say("icegeni: 23h0 wrap3 votes 0x52018 %08x (m_ahb %u s_ahb %u core %u core2x %u s5 %u)\n", v18, (v18 >> 8) & 1,
+	    (v18 >> 9) & 1, (v18 >> 10) & 1, (v18 >> 11) & 1, (v18 >> 17) & 1);
+	h_dfs_read(gcc);
+	if (!((v18 >> 17) & 1)) {
+		*(volatile uint32_t *)(gcc + 0x52018) = v18 | (1u << 17);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (int i = 0; i < 100 && (io_rd(gcc, 0xa8630) >> 31); i++) {
+			delay(10);
+		}
+		say("icegeni: gcc 0x52018 <- %08x (s5 branch vote, as Linux's se clock; read back %08x)\n", v18 | (1u << 17),
+		    io_rd(gcc, 0x52018));
+	}
+	for (int i = 0; i < 5; i++) {
+		say("icegeni: CBCR %s +%#x = %08x (%s)\n", cn[i], cbcr[i], io_rd(gcc, cbcr[i]), io_rd(gcc, cbcr[i]) >> 31 ? "OFF" : "on");
+		on = on && !(io_rd(gcc, cbcr[i]) >> 31);
+	}
+	if (!on) {
+		say("icegeni: 23h0 a wrap3 clock is OFF: the wrapper / SE registers are NOT read\n");
+		proto = -1;
+	} else {
+		uint32_t fw = io_rd(se, 0x68), p0 = io_rd(se, 0xe24), p1 = io_rd(se, 0xe28);
+		proto = (int)((fw >> 8) & 0xff);
+		say("icegeni: 23h0 QUP_HW_VER %08x; SE5 GENI_FW_REVISION_RO %08x (protocol %d: %s, version %#x) S_FW_REVISION %08x "
+		    "IF_DISABLE %08x\n", io_rd(qup, 4), fw, proto, proto == 2 ? "UART" : proto == 0 ? "NONE (no firmware)" :
+		    proto == 1 ? "SPI" : proto == 3 ? "I2C" : "other", fw & 0xff, io_rd(se, 0x6c), io_rd(se, 0x64));
+		say("icegeni: 23h0 SE5 STATUS %08x HW_PARAM_0 %08x (tx depth %u width %u) HW_PARAM_1 %08x (rx depth %u) CLK_SEL %08x "
+		    "M_CLK_CFG %08x S_CLK_CFG %08x CLK_CTRL_RO %08x IOS %08x (CTS in %u)\n", io_rd(se, 0x40), p0, (p0 >> 16) & 0xff,
+		    (p0 >> 24) & 0x3f, p1, (p1 >> 16) & 0xff, io_rd(se, 0x7c), io_rd(se, 0x48), io_rd(se, 0x4c), io_rd(se, 0x60),
+		    io_rd(se, 0x908), (io_rd(se, 0x908) >> 1) & 1);
+		say("icegeni: 23h0 SE5 CGC %08x OUTPUT_CTRL %08x DMA_MODE %08x SE_IRQ_EN %08x M_IRQ_EN %08x S_IRQ_EN %08x M_IRQ %08x "
+		    "S_IRQ %08x TX_FIFO %08x RX_FIFO %08x; UART TX_TRANS %08x RX_TRANS %08x TX_WORD %08x RX_WORD %08x STOP %08x "
+		    "STALE %08x MANUAL_RFR %08x PACK TX %08x/%08x RX %08x/%08x\n", io_rd(se, 0x28), io_rd(se, 0x24), io_rd(se, 0x258),
+		    io_rd(se, 0xe1c), io_rd(se, 0x614), io_rd(se, 0x644), io_rd(se, 0x610), io_rd(se, 0x640), io_rd(se, 0x800),
+		    io_rd(se, 0x804), io_rd(se, 0x25c), io_rd(se, 0x280), io_rd(se, 0x268), io_rd(se, 0x28c), io_rd(se, 0x26c),
+		    io_rd(se, 0x294), io_rd(se, 0x2ac), io_rd(se, 0x260), io_rd(se, 0x264), io_rd(se, 0x284), io_rd(se, 0x288));
+		h_txdepth = (p0 >> 16) & 0x3f;
+		h_rxdepth = (p1 >> 16) & 0x3f;
+		h_os = io_rd(qup, 4) >= 0x20050000u ? 16 : 32;
+	}
+	if (!keep && !((v18 >> 17) & 1)) {
+		*(volatile uint32_t *)(gcc + 0x52018) = v18;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icegeni: gcc 0x52018 put back %08x (read back %08x)\n", v18, io_rd(gcc, 0x52018));
+	}
+	h_se = se;
+	return proto;
+}
+
+/*
+ * 23h3: 23h0 read CMD_DFSR 0x8020 = DFS OFF and the S5 RCG at XO (cfg 0x00100000, 19.2 MHz): no rate divides 115200 x 16,
+ * so 23h0b / 23h stopped before any byte. With DFS off Linux sets the rate through the RCG itself (clk_rcg2 set_rate
+ * from ftbl_gcc_qupv3_wrap3_s5_clk_src): M / N / D and CFG (pre_div 2h-1, source, dual-edge mode for M/N), then
+ * CMD UPDATE. Entries used (all h = 1): 7.3728 MHz = GPLL0 even (300 MHz, source 6) x 384 / 15625 -> 115200 x 16 x 4;
+ * 51.2 MHz = 300 MHz x 64 / 375 -> 3.2 Mbaud x 16 x 1; 19.2 MHz XO. CFG bit 20 (HW_CLK_CTRL) kept as found (the boot
+ * chain's: the branch vote turns the root on). Same kind of write as 23d2's rchng RCG; CFG / M / N / D put back as
+ * found + UPDATE at the end.
+ */
+static bool h_rcg_saved;
+static uint32_t h_rcg0[4];              /* CFG, M, N, D as found */
+
+static bool
+h_rcg_set(uint32_t src, uint32_t m, uint32_t n)
+{
+	uint32_t cfg, d;
+
+	if (h_gcc == 0) {
+		return false;
+	}
+	if (!h_rcg_saved) {
+		for (int i = 0; i < 4; i++) {
+			h_rcg0[i] = io_rd(h_gcc, S5_RCG + 4 + 4 * i);
+		}
+		h_rcg_saved = true;
+	}
+	cfg = (h_rcg0[0] & ~(0x1fu | 7u << 8 | 3u << 12)) | 1u | src << 8 | (n != 0 && m != n ? 2u << 12 : 0);
+	if (n != 0) {
+		d = n;
+		if (d < m) {
+			d = m;
+		}
+		if (d > 2 * (n - m)) {
+			d = 2 * (n - m);
+		}
+		*(volatile uint32_t *)(h_gcc + S5_RCG + 8) = m & 0xffff;
+		*(volatile uint32_t *)(h_gcc + S5_RCG + 0xc) = ~(n - m) & 0xffff;
+		*(volatile uint32_t *)(h_gcc + S5_RCG + 0x10) = ~d & 0xffff;
+	}
+	*(volatile uint32_t *)(h_gcc + S5_RCG + 4) = cfg;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(h_gcc + S5_RCG) = io_rd(h_gcc, S5_RCG) | 1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 500 && (io_rd(h_gcc, S5_RCG) & 1u); i++) {
+		delay(2);
+	}
+	say("icegeni: 23h3 S5 RCG <- src %u m %u n %u: cfg %08x m %08x n %08x d %08x cmd %08x (%s)\n", src, m, n,
+	    io_rd(h_gcc, S5_RCG + 4), io_rd(h_gcc, S5_RCG + 8), io_rd(h_gcc, S5_RCG + 0xc), io_rd(h_gcc, S5_RCG + 0x10),
+	    io_rd(h_gcc, S5_RCG), (io_rd(h_gcc, S5_RCG) & 1u) ? "UPDATE NOT taken" : "updated");
+	return !(io_rd(h_gcc, S5_RCG) & 1u);
+}
+
+static void
+h_rcg_restore(void)
+{
+	if (!h_rcg_saved || h_gcc == 0) {
+		return;
+	}
+	*(volatile uint32_t *)(h_gcc + S5_RCG + 8) = h_rcg0[1];
+	*(volatile uint32_t *)(h_gcc + S5_RCG + 0xc) = h_rcg0[2];
+	*(volatile uint32_t *)(h_gcc + S5_RCG + 0x10) = h_rcg0[3];
+	*(volatile uint32_t *)(h_gcc + S5_RCG + 4) = h_rcg0[0];
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(h_gcc + S5_RCG) = io_rd(h_gcc, S5_RCG) | 1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 500 && (io_rd(h_gcc, S5_RCG) & 1u); i++) {
+		delay(2);
+	}
+	say("icegeni: S5 RCG put back: cfg %08x m %08x n %08x d %08x (found %08x %08x %08x %08x) cmd %08x\n",
+	    io_rd(h_gcc, S5_RCG + 4), io_rd(h_gcc, S5_RCG + 8), io_rd(h_gcc, S5_RCG + 0xc), io_rd(h_gcc, S5_RCG + 0x10),
+	    h_rcg0[0], h_rcg0[1], h_rcg0[2], h_rcg0[3], io_rd(h_gcc, S5_RCG));
+	h_rcg_saved = false;
+}
+
+/* the DFS level (or, with DFS off, the RCG rate) and divider for baud; false if none fits */
+static bool
+h_baud(uint32_t baud)
+{
+	uint64_t want = (uint64_t)baud * h_os;
+
+	if (!h_dfs_en) {
+		static const struct {
+			uint32_t hz, src, m, n;
+		} f[] = { { 7372800, 6, 384, 15625 }, { 14745600, 6, 768, 15625 }, { 19200000, 0, 0, 0 },
+			  { 29491200, 6, 1536, 15625 }, { 32000000, 6, 8, 75 }, { 48000000, 6, 4, 25 }, { 51200000, 6, 64, 375 },
+			  { 64000000, 6, 16, 75 }, { 96000000, 6, 8, 25 } };
+		for (unsigned i = 0; i < sizeof(f) / sizeof(f[0]); i++) {
+			if (f[i].hz % want == 0) {
+				uint32_t div = (uint32_t)(f[i].hz / want);
+				if (!h_rcg_set(f[i].src, f[i].m, f[i].n)) {
+					return false;
+				}
+				h_w(0x7c, 0);
+				h_w(0x48, div << 4 | 1);
+				h_w(0x4c, div << 4 | 1);
+				say("icegeni: %u baud: RCG %u Hz / %u / oversampling %u (M_CLK_CFG %08x)\n", baud, f[i].hz, div, h_os,
+				    io_rd(h_se, 0x48));
+				return true;
+			}
+		}
+		say("icegeni: no RCG table rate is a multiple of %u x %u\n", baud, h_os);
+		return false;
+	}
+	for (int l = 0; l < 8; l++) {
+		if (h_dfs[l] != 0 && h_dfs[l] % want == 0 && (!h_dfs_en ? l == 0 : true)) {
+			uint32_t div = (uint32_t)(h_dfs[l] / want);
+			h_w(0x7c, (uint32_t)l);
+			h_w(0x48, div << 4 | 1);
+			h_w(0x4c, div << 4 | 1);
+			say("icegeni: %u baud: DFS level %d (%u Hz) / %u / oversampling %u (CLK_SEL %08x M_CLK_CFG %08x)\n", baud, l, h_dfs[l],
+			    div, h_os, io_rd(h_se, 0x7c), io_rd(h_se, 0x48));
+			return true;
+		}
+	}
+	say("icegeni: no DFS level is a multiple of %u x %u\n", baud, h_os);
+	return false;
+}
+
+/* TX of b then b2 over the M sequencer (FIFO mode, one byte per word); false on a timeout (command cancelled) */
+static bool
+h_tx(const uint8_t *b, int n, const uint8_t *b2, int n2)
+{
+	int total = n + n2;
+	uint64_t dl, t0;
+
+	h_w(0x618, 0xffffffffu);
+	h_w(0x270, (uint32_t)total);
+	h_w(0x600, 1u << 27);                   /* UART_START_TX */
+	nanoseconds_to_absolutetime(50000000ull + (uint64_t)total * 100000ull, &dl);
+	t0 = mach_absolute_time();
+	for (int i = 0; i < total; i++) {
+		while ((io_rd(h_se, 0x800) & 0x0fffffffu) >= h_txdepth) {
+			if (mach_absolute_time() - t0 > dl) {
+				goto stuck;
+			}
+		}
+		h_w(0x700, i < n ? b[i] : b2[i - n]);
+	}
+	while (!(io_rd(h_se, 0x610) & 1u)) {
+		if (mach_absolute_time() - t0 > dl) {
+			goto stuck;
+		}
+	}
+	h_w(0x618, 1u);
+	return true;
+stuck:
+	say("icegeni: TX stuck (%d bytes; TX_FIFO %08x M_IRQ %08x STATUS %08x IOS %08x): cancelled\n", total, io_rd(h_se, 0x800),
+	    io_rd(h_se, 0x610), io_rd(h_se, 0x40), io_rd(h_se, 0x908));
+	h_w(0x604, 1u << 2);                    /* M_GENI_CMD_CANCEL */
+	delay(1000);
+	if (!(io_rd(h_se, 0x610) & (1u << 4))) {
+		h_w(0x604, 1u << 1);                /* M_GENI_CMD_ABORT */
+		delay(1000);
+	}
+	h_w(0x618, 0xffffffffu);
+	return false;
+}
+
+/* RX for cap_us (or until one whole H4 event is in r); bytes beyond rmax are counted and dropped */
+static int
+h_rx(uint32_t cap_us, uint8_t *r, int rmax)
+{
+	uint64_t dl, t0 = mach_absolute_time();
+	int m = 0, drop = 0;
+
+	nanoseconds_to_absolutetime((uint64_t)cap_us * 1000ull, &dl);
+	do {
+		while (io_rd(h_se, 0x804) & 0x1ffffffu) {
+			uint32_t v = io_rd(h_se, 0x780);
+			if (m < rmax) {
+				r[m++] = (uint8_t)v;
+			} else {
+				drop++;
+			}
+		}
+		if (m >= 3 && r[0] == 0x04 && m >= 3 + r[2]) {
+			break;
+		}
+	} while (mach_absolute_time() - t0 < dl);
+	if (drop) {
+		say("icegeni: RX: %d bytes beyond the %d-byte buffer dropped\n", drop, rmax);
+	}
+	return m;
+}
+
+/*
+ * TX with interrupts already masked by the caller: b (n bytes), then b2 (n2 bytes, may be NULL) on one bit clock.
+ * 23f4b: the TLV segment goes out as its 6-byte H4 header + the data read straight from the file buffer (23f4 copied
+ * header + 243 data bytes into a 248-byte packet: 249 needed -> "string operation caused an overflow" panic).
+ */
+/*
+ * 23f4c (icespmi=7): RTS/CTS flow control honoured. 23f4b's rampatch ran clean to segment 817, then the chip's RTS
+ * (gpio24, our CTS; active low: 0 = send) went high more and more often while we kept sending: bytes lost, replies
+ * misaligned, the last segment unanswered. Now, before every byte's start bit, gpio24 is read; while it is 1 the
+ * line stays idle (stop bit level) for up to F4_CTS_MAX_US, then the bit clock restarts from that byte. A byte that
+ * would wait longer ends the transfer (f4_cts_timeout) instead of sending blind.
+ */
+/*
+ * 23f4d: 23f4c (40 ms hold limit, spun with interrupts off) stopped at segment 184: the chip holds RTS off far longer
+ * while it processes. Linux's hci_uart just waits on CTS. Now a pause longer than 200 us ends the interrupts-off TX
+ * burst at that byte (f4_tx_raw2 returns the next index); f4_xfer2 then waits with interrupts ON (IOSleep 1 ms steps)
+ * up to F4_CTS_PAUSE_MS per pause and F4_CTS_TOTAL_MS over the whole download, and resumes from that byte. Longest
+ * pause, count and total are logged.
+ */
+#define F4_CTS_SPIN_US          200u
+#define F4_CTS_PAUSE_MS         2000u
+#define F4_CTS_TOTAL_MS         60000u
+static vm_offset_t f4_cts;              /* gpio24 (the chip's RTS = our CTS) */
+static bool f4_honour;                  /* icespmi >= 7 */
+static uint32_t f4_cts_waits, f4_cts_maxwait_us, f4_cts_total_ms;
+static bool f4_cts_timeout;
+
+/* sends bytes [from, n + n2); returns the index of the first byte not sent (n + n2 when all went out) */
+static int
+f4_tx_raw2(vm_offset_t tx, uint32_t io_idle, const uint8_t *b, int n, const uint8_t *b2, int n2, int from)
+{
+	uint64_t t0, dl, bit = 0, spin;
+
+	nanoseconds_to_absolutetime(F4_CTS_SPIN_US * 1000ull, &spin);
+	t0 = mach_absolute_time();
+	for (int i = from; i < n + n2; i++) {
+		uint8_t c = i < n ? b[i] : b2[i - n];
+		if (f4_honour && f4_cts != 0) {
+			/* finish the previous byte's stop bit first, then look at CTS */
+			nanoseconds_to_absolutetime((bit * 1000000000ull) / 115200, &dl);
+			while (mach_absolute_time() - t0 < dl) {
+			}
+			if (io_rd(f4_cts, 4) & 1) {
+				uint64_t w0 = mach_absolute_time();
+				while ((io_rd(f4_cts, 4) & 1) && mach_absolute_time() - w0 < spin) {
+				}
+				if (io_rd(f4_cts, 4) & 1) {
+					return i;           /* a long pause: the caller waits with interrupts on */
+				}
+				t0 = mach_absolute_time();
+				bit = 0;
+			}
+		}
+		for (int k = 0; k < 10; k++) {
+			uint32_t level = k == 0 ? 0 : k == 9 ? 1 : (c >> (k - 1)) & 1;
+			nanoseconds_to_absolutetime((bit * 1000000000ull) / 115200, &dl);
+			while (mach_absolute_time() - t0 < dl) {
+			}
+			*(volatile uint32_t *)(tx + 4) = level ? (io_idle | 2u) : (io_idle & ~2u);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			bit++;
+		}
+	}
+	nanoseconds_to_absolutetime((bit * 1000000000ull) / 115200, &dl);
+	while (mach_absolute_time() - t0 < dl) {
+	}
+	return n + n2;
+}
+
+/*
+ * RX for total_us in 20 ms interrupts-off windows; edges into f3_et / f3_ev on one time base; returns the edge count.
+ * premasked >= 0: the caller has interrupts masked already (right after its TX, so no reply byte is missed between the
+ * two); the first window is then 4 ms and ends by restoring premasked.
+ */
+static int
+f4_rx(vm_offset_t rx, uint32_t total_us, uint32_t *maxgap_ns, int premasked)
+{
+	uint64_t t0, end, win, win1, now, last_s, ws, maxgap = 0;
+	uint32_t lv;
+	int edges = 0;
+	bool first = premasked >= 0;
+
+	nanoseconds_to_absolutetime(total_us * 1000ull, &end);
+	nanoseconds_to_absolutetime(20000000ull, &win);
+	nanoseconds_to_absolutetime(4000000ull, &win1);
+	t0 = last_s = mach_absolute_time();
+	lv = io_rd(rx, 4) & 1;
+	while (mach_absolute_time() - t0 < end) {
+		boolean_t ie = first ? (boolean_t)premasked : ml_set_interrupts_enabled(FALSE);
+		uint64_t w = first ? win1 : win;
+		first = false;
+		ws = mach_absolute_time();
+		while ((now = mach_absolute_time()) - ws < w && now - t0 < end) {
+			uint32_t v = io_rd(rx, 4) & 1;
+			if (now - last_s > maxgap) {
+				maxgap = now - last_s;
+			}
+			last_s = now;
+			if (v != lv) {
+				if (edges < F3_MAXEDGE) {
+					f3_et[edges] = (uint32_t)(now - t0);
+					f3_ev[edges] = (uint8_t)v;
+				}
+				edges++;
+				lv = v;
+			}
+		}
+		ml_set_interrupts_enabled(ie);
+	}
+	absolutetime_to_nanoseconds(maxgap, &maxgap);
+	*maxgap_ns = (uint32_t)maxgap;
+	return edges;
+}
+
+/* one H4 command (b, then b2 if not NULL) and its reply: bytes into r, count returned */
+static int
+f4_xfer2(vm_offset_t tx, vm_offset_t rx, uint32_t io, const uint8_t *b, int n, const uint8_t *b2, int n2, uint32_t cap_us,
+    uint8_t *r, int rmax, int *framing, uint32_t *gap)
+{
+	int edges;
+	boolean_t ie;
+
+	if (f4_geni) {
+		*gap = 0;
+		*framing = 0;
+		if (!h_tx(b, n, b2, b2 != NULL ? n2 : 0)) {
+			*framing = -1;
+			return 0;
+		}
+		return h_rx(cap_us, r, rmax);
+	}
+	ie = ml_set_interrupts_enabled(FALSE);
+	f4_cts_timeout = false;
+	{
+		int total = n + (b2 != NULL ? n2 : 0), idx = 0;
+		for (;;) {
+			uint64_t p0, pw;
+			uint32_t ms = 0;
+			idx = f4_tx_raw2(tx, io, b, n, b2, b2 != NULL ? n2 : 0, idx);
+			if (idx >= total) {
+				break;
+			}
+			/* 23f4d: a long CTS pause - wait with interrupts on, then resume from byte idx */
+			ml_set_interrupts_enabled(ie);
+			p0 = mach_absolute_time();
+			while ((io_rd(f4_cts, 4) & 1) && ms < F4_CTS_PAUSE_MS) {
+				IOSleep(1);
+				ms++;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - p0, &pw);
+			f4_cts_waits++;
+			f4_cts_total_ms += (uint32_t)(pw / 1000000);
+			if (pw / 1000 > f4_cts_maxwait_us) {
+				f4_cts_maxwait_us = (uint32_t)(pw / 1000);
+			}
+			if ((io_rd(f4_cts, 4) & 1) || f4_cts_total_ms > F4_CTS_TOTAL_MS) {
+				f4_cts_timeout = true;
+				*gap = 0;
+				*framing = -2;
+				return 0;
+			}
+			ie = ml_set_interrupts_enabled(FALSE);
+		}
+	}
+	edges = f4_rx(rx, cap_us, gap, (int)ie);
+	return f3_decode(edges, r, rmax, framing);
+}
+
+static int
+f4_xfer(vm_offset_t tx, vm_offset_t rx, uint32_t io, const uint8_t *b, int n, uint32_t cap_us, uint8_t *r, int rmax,
+    int *framing, uint32_t *gap)
+{
+	return f4_xfer2(tx, rx, io, b, n, NULL, 0, cap_us, r, rmax, framing, gap);
+}
+
+
+/* the status of a command complete for opcode (and EDL rtype if >= 0) in r, -1 if none */
+static int
+f4_cc(const uint8_t *r, int m, uint16_t opcode, int rtype)
+{
+	for (int i = 0; i + 6 < m; i++) {
+		if (r[i] == 0x04 && r[i + 1] == 0x0e && r[i + 4] == (opcode & 0xff) && r[i + 5] == (opcode >> 8)) {
+			if (rtype >= 0 && (i + 7 >= m || r[i + 7] != rtype)) {
+				continue;
+			}
+			return r[i + 6];
+		}
+	}
+	return -1;
+}
+
+static void
+f4_hex(char *hex, const uint8_t *r, int m, int maxb)
+{
+	int k = m < maxb ? m : maxb;
+
+	for (int i = 0; i < k; i++) {
+		snprintf(hex + 3 * i, 4, "%02x ", r[i]);
+	}
+	hex[k ? 3 * k - 1 : 0] = 0;
+}
+
+/*
+ * 23f4c: frame the reply as H4 events (04, event code, length, payload), skipping stray bytes until a 04 that starts a
+ * complete event; each event logged (when log) with its code and first bytes. Returns the number of error events: a
+ * command complete / status with a nonzero status, a hardware error (0x10) or a vendor event (0xff, which QCA sends
+ * for TLV download errors when it does not skip them). *stray gets the bytes that belonged to no event.
+ */
+static int
+f4_events(const uint8_t *r, int m, bool log, const char *what, uint32_t seg, int *stray)
+{
+	int i = 0, errs = 0;
+
+	*stray = 0;
+	while (i < m) {
+		if (r[i] == 0x04 && i + 2 < m && i + 3 + r[i + 2] <= m) {
+			uint8_t ev = r[i + 1], len = r[i + 2];
+			int status = ev == 0x0e && len >= 4 ? r[i + 6] : ev == 0x0f && len >= 1 ? r[i + 3] : -1;
+			bool err = (status > 0) || ev == 0x10 || ev == 0xff;
+			if (log) {
+				char hex[16 * 3 + 1];
+				f4_hex(hex, r + i + 3, len, 16);
+				say("icespmi: 23f4c %s segment %u: event %02x len %u status %d%s [%s]\n", what, seg, ev, len, status,
+				    err ? " ERROR" : "", hex);
+			}
+			errs += err;
+			i += 3 + len;
+		} else {
+			(*stray)++;
+			i++;
+		}
+	}
+	return errs;
+}
+
+/* segments of 243 as qca_download_firmware; ack_each: every segment answered (NVM), else only the last (ELF patch) */
+static bool
+f4_send_file(const char *what, vm_offset_t tx, vm_offset_t rx, uint32_t io, const uint8_t *d, uint32_t size, bool ack_each)
+{
+	/* H4 command header (01, opcode fc00, plen n + 2), EDL_PATCH_TLV_REQ_CMD 0x1e, n; the n data bytes follow from d */
+	uint8_t hdr[6], r[96];
+	char hex[96 * 3 + 1];
+	uint32_t off = 0, gap = 0, maxgap = 0, seg = 0, noisy = 0, cts0 = f4_cts ? io_rd(f4_cts, 4) & 1 : 2, ctsdiff = 0;
+	uint32_t ctsfirst = ~0u;
+	int framing = 0, m, st;
+	uint64_t t0 = mach_absolute_time(), el;
+
+	say("icespmi: 23f4b %s: %u bytes, %u segments of <= 243 sent from the file buffer (no copy); CTS gpio24 at start %u\n",
+	    what, size, (size + 242) / 243, cts0);
+	while (off < size) {
+		uint32_t n = size - off < 243 ? size - off : 243;
+		bool last = off + n >= size || n < 243;
+		hdr[0] = 0x01;
+		hdr[1] = 0x00;
+		hdr[2] = 0xfc;
+		hdr[3] = (uint8_t)(n + 2);
+		hdr[4] = 0x1e;
+		hdr[5] = (uint8_t)n;
+		if (f4_cts && (io_rd(f4_cts, 4) & 1) != cts0) {
+			if (ctsdiff++ == 0) {
+				ctsfirst = seg;
+			}
+		}
+		if (ack_each || last) {
+			m = f4_xfer2(tx, rx, io, hdr, 6, d + off, (int)n, last ? 1000000 : 60000, r, (int)sizeof(r), &framing, &gap);
+			st = f4_cc(r, m, 0xfc00, 0x1e);
+			if (gap > maxgap) {
+				maxgap = gap;
+			}
+			f4_hex(hex, r, m, 24);
+			if (st != 0) {
+				int stray = 0;
+				say("icespmi: 23f4 %s segment %u (%u bytes at %u%s): no good command complete (status %d): %d bytes [%s] "
+				    "framing %d\n", what, seg, n, off, last ? ", last" : "", st, m, hex, framing);
+				(void)f4_events(r, m, true, what, seg, &stray);
+				return false;
+			}
+			say("icespmi: 23f4b %s segment %u (%u bytes at %u%s): event status %d [%s]\n", what, seg, n, off,
+			    last ? ", last" : "", st, hex);
+		} else {
+			m = f4_xfer2(tx, rx, io, hdr, 6, d + off, (int)n, f4_geni ? 100 : 1500, r, (int)sizeof(r), &framing, &gap);
+			if (framing < 0) {
+				say("icespmi: 23f4 %s segment %u: TX %s\n", what, seg, framing == -2 ?
+				    "stopped: the chip held CTS off longer than 2 s, or 60 s in all (23f4d)" : "over the engine failed");
+				return false;
+			}
+			if (seg % 128 == 0) {
+				absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+				say("icespmi: 23f4b %s progress: segment %u at %u (%llu ms), unexpected replies %u, CTS differed %u, CTS pauses "
+				    "%u (longest %u us, %u ms in all)\n", what, seg, off, el / 1000000, noisy, ctsdiff, f4_cts_waits,
+				    f4_cts_maxwait_us, f4_cts_total_ms);
+			}
+			if (gap > maxgap) {
+				maxgap = gap;
+			}
+			if (m > 0) {
+				int stray = 0, errs = f4_events(r, m, f4_honour && noisy < 8, what, seg, &stray);
+				if (noisy++ < 5) {
+					f4_hex(hex, r, m, 16);
+					say("icespmi: 23f4 %s segment %u: unexpected %d bytes [%s...] (%d error events, %d stray bytes)\n", what,
+					    seg, m, hex, errs, stray);
+				}
+				if (f4_cc(r, m, 0xfc00, -1) > 0 || (f4_honour && errs > 0)) {
+					say("icespmi: 23f4 %s segment %u: the chip reported an error: stopping instead of sending on blind\n",
+					    what, seg);
+					return false;
+				}
+			}
+		}
+		off += n;
+		seg++;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+	say("icespmi: 23f4 %s: %u bytes in %u segments acknowledged (%llu ms; largest sample gap %u ns, %u unexpected replies)\n",
+	    what, size, seg, el / 1000000, maxgap, noisy);
+	say("icespmi: 23f4b %s: CTS gpio24 read other than %u before %u segments (first: segment %d); 23f4d CTS pauses %u "
+	    "(longest %u us, %u ms in all, honoured %d)\n", what, cts0, ctsdiff, ctsdiff ? (int)ctsfirst : -1, f4_cts_waits,
+	    f4_cts_maxwait_us, f4_cts_total_ms, f4_honour);
+	return true;
+}
+
+static bool
+f4_sha(const uint8_t *d, uint64_t n, const uint8_t *want)
+{
+	uint8_t dg[32];
+	SHA256_CTX c;
+
+	SHA256_Init(&c);
+	SHA256_Update(&c, d, (size_t)n);
+	SHA256_Final(dg, &c);
+	return memcmp(dg, want, 32) == 0;
+}
+
+static bool f4_ok;                      /* 23bt: the last f4_download ended with its PASS line */
+
+static void
+f4_download(vm_offset_t tx, vm_offset_t rx, uint32_t io)
+{
+	static const uint8_t bid_cmd[] = { 0x01, 0x00, 0xfc, 0x01, 0x23 };
+	static const uint8_t nolog[] = { 0x01, 0x17, 0xfc, 0x02, 0x14, 0x00 };
+	static const uint8_t reset[] = { 0x01, 0x03, 0x0c, 0x00 };
+	static const uint8_t build[] = { 0x01, 0x00, 0xfc, 0x01, 0x20 };
+	static const uint8_t lver[] = { 0x01, 0x01, 0x10, 0x00 };
+	uint8_t r[96];
+	char hex[96 * 3 + 1], name[32];
+	uint64_t fsz = 0, nsz = 0;
+	uint32_t gap = 0, bid = 0, idx, len, type;
+	int disk = -1, framing = 0, m, st, which = -1;
+	bool patched = false;
+	const uint8_t *fw = redwood_image_file("fw", "brhbtfw20.mbn", &fsz, &disk), *nv;
+
+	f4_ok = false;
+	if (fw == NULL || !f4_sha(fw, fsz, f4_fw_sha)) {
+		say("icespmi: 23f4 REFUSED: fw/brhbtfw20.mbn %s\n", fw == NULL ? "not in md1 / md0" : "sha256 is not iceland-firmware's");
+		return;
+	}
+	say("icespmi: 23f4 rampatch brhbtfw20.mbn %llu bytes (md%d), sha256 matches iceland-firmware\n", fsz, disk);
+	f4_cts = ml_io_map_unmappable(TLMM_PA + 0x1000u * 24, PAGE_SIZE, VM_WIMG_IO);
+	f4_honour = f3_level_arg >= 7 && !f4_geni;
+	f4_cts_waits = f4_cts_maxwait_us = f4_cts_total_ms = 0;
+	say("icespmi: 23f4c RTS/CTS flow control %s (gpio24 %u now)\n", f4_honour ? "HONOURED (icespmi=7)" : "not honoured",
+	    f4_cts ? io_rd(f4_cts, 4) & 1 : 9);
+	if (!f4_send_file("rampatch", tx, rx, io, fw, (uint32_t)fsz, false)) {
+		say("icespmi: 23f4 FAILED in the rampatch\n");
+		return;
+	}
+	IOSleep(10);
+	m = f4_xfer(tx, rx, io, bid_cmd, (int)sizeof(bid_cmd), 60000, r, (int)sizeof(r), &framing, &gap);
+	st = f4_cc(r, m, 0xfc00, 0x23);
+	f4_hex(hex, r, m, 32);
+	if (st == 0) {
+		for (int i = 0; i + 10 < m; i++) {
+			if (r[i] == 0x04 && r[i + 1] == 0x0e && r[i + 7] == 0x23) {
+				bid = (uint32_t)r[i + 9] << 8 | r[i + 10];
+				break;
+			}
+		}
+	}
+	say("icespmi: 23f4 board id: status %d, bid %#x [%s]\n", st, bid, hex);
+	if (bid == 0 || bid == 0xffff) {
+		snprintf(name, sizeof(name), "brhbtnv20.bin");
+	} else {
+		snprintf(name, sizeof(name), "brhbtnv20.b%02x", bid);
+	}
+	nv = redwood_image_file("fw", name, &nsz, &disk);
+	if (nv == NULL) {
+		say("icespmi: 23f4 fw/%s not in the image: brhbtnv20.bin (qca_get_alt_nvm_file)\n", name);
+		snprintf(name, sizeof(name), "brhbtnv20.bin");
+		nv = redwood_image_file("fw", name, &nsz, &disk);
+	}
+	for (int i = 0; nv != NULL && i < 4; i++) {
+		if (f4_sha(nv, nsz, f4_nvm_sha[i])) {
+			which = i;
+		}
+	}
+	if (nv == NULL || which < 0 || nsz < 8 || nsz > sizeof(f4_nvm)) {
+		say("icespmi: 23f4 REFUSED: NVM %s %s\n", name, nv == NULL ? "missing" : "not one of iceland-firmware's");
+		return;
+	}
+	memcpy(f4_nvm, nv, (size_t)nsz);
+	/* the tags, as qca_tlv_check_data walks them (type 4 = an enclosing header) */
+	idx = 4;
+	type = f4_nvm[0];
+	len = (uint32_t)f4_nvm[1] | (uint32_t)f4_nvm[2] << 8 | (uint32_t)f4_nvm[3] << 16;
+	if (type == 4) {
+		type = f4_nvm[4];
+		len = (uint32_t)f4_nvm[5] | (uint32_t)f4_nvm[6] << 8 | (uint32_t)f4_nvm[7] << 16;
+		idx = 8;
+	}
+	if (type == 2 && idx + len <= nsz) {
+		uint32_t p = 0;
+		while (p + 12 <= len) {
+			uint8_t *t = f4_nvm + idx + p;
+			uint32_t tid = (uint32_t)t[0] | (uint32_t)t[1] << 8, tlen = (uint32_t)t[2] | (uint32_t)t[3] << 8;
+			if (p + 12 + tlen > len) {
+				break;
+			}
+			if (tid == 17 && tlen >= 3) {
+				say("icespmi: 23f4 NVM tag 17 (HCI): data[0] %02x -> %02x (in-band sleep off), data[1] %02x -> %02x (%s)\n",
+				    t[12], t[12] & 0x7f, t[13], f4_nvm_keepbaud ? t[13] : 0,
+				    f4_nvm_keepbaud ? "kept: the engine runs at 3.2 Mbaud" : "115200");
+				t[12] &= 0x7f;
+				if (!f4_nvm_keepbaud) {
+					t[13] = 0;
+				}
+			} else if (tid == 27 && tlen >= 1) {
+				say("icespmi: 23f4 NVM tag 27 (deep sleep): data[0] %02x -> %02x (off)\n", t[12], t[12] & ~1u);
+				t[12] &= (uint8_t)~1u;
+			}
+			p += 12 + tlen;
+		}
+	}
+	say("icespmi: 23f4 NVM %s %llu bytes (md%d), sha256 = iceland-firmware's (set %d)\n", name, nsz, disk, which);
+	if (!f4_send_file("NVM", tx, rx, io, f4_nvm, (uint32_t)nsz, true)) {
+		say("icespmi: 23f4 FAILED in the NVM\n");
+		return;
+	}
+	m = f4_xfer(tx, rx, io, nolog, (int)sizeof(nolog), 60000, r, (int)sizeof(r), &framing, &gap);
+	f4_hex(hex, r, m, 32);
+	say("icespmi: 23f4 disable SoC logging: status %d [%s]\n", f4_cc(r, m, 0xfc17, -1), hex);
+	m = f4_xfer(tx, rx, io, reset, (int)sizeof(reset), 200000, r, (int)sizeof(r), &framing, &gap);
+	f4_hex(hex, r, m, 32);
+	say("icespmi: 23f4 HCI_Reset: status %d [%s]\n", f4_cc(r, m, 0x0c03, -1), hex);
+	m = f4_xfer(tx, rx, io, build, (int)sizeof(build), 60000, r, (int)sizeof(r), &framing, &gap);
+	f4_hex(hex, r, m, 96);
+	say("icespmi: 23f4 build info: status %d [%s]\n", f4_cc(r, m, 0xfc00, -1), hex);
+	{
+		/*
+		 * 23f4b PASS test (Linux on this tablet, 1 Nov): the patch version reads 0x6d58 BEFORE and after the download,
+		 * so it proves nothing; the build string does: ROM "BTFW.GANGES.2.0-01584-ROM-1" (23f3) -> after the rampatch
+		 * Linux reads "BTFW.BRAHMA.2.0.1-00204-PATCHZ-...". EDL 0x20 reply: 04 0e plen 01 00 fc cresp 20 len string.
+		 */
+		char txt[97];
+		int k = 0, at = -1;
+		for (int i = 0; i + 9 < m; i++) {
+			if (r[i] == 0x04 && r[i + 1] == 0x0e && r[i + 7] == 0x20) {
+				at = i + 9;
+				break;
+			}
+		}
+		for (int i = at; at >= 0 && i < m && k < 96; i++) {
+			txt[k++] = (r[i] >= 0x20 && r[i] < 0x7f) ? (char)r[i] : '.';
+		}
+		txt[k] = 0;
+		patched = strnstr(txt, "BRAHMA", sizeof(txt)) != NULL;
+		say("icespmi: 23f4b build string \"%s\" -> %s\n", txt, patched ? "PATCHED (BTFW.BRAHMA, as Linux after the download)" :
+		    "NOT the patched build (ROM string or none)");
+	}
+	{
+		/* 23f4b: the version again after the download (23f3 before it: product 0x21, patch 0x6d58, ROM 0x0200) */
+		static const uint8_t ver[] = { 0x01, 0x00, 0xfc, 0x01, 0x19 };
+		m = f4_xfer(tx, rx, io, ver, (int)sizeof(ver), 60000, r, (int)sizeof(r), &framing, &gap);
+		st = f4_cc(r, m, 0xfc00, 0x19);
+		f4_hex(hex, r, m, 32);
+		for (int i = 0; st == 0 && i + 20 < m; i++) {
+			if (r[i] == 0x04 && r[i + 1] == 0x0e && r[i + 7] == 0x19) {
+				say("icespmi: 23f4b version after the download: product %#x patch %#x ROM %#x SoC %#x (before: 0x21 / 0x6d58 / "
+				    "0x200 / 0x40210200)\n", (uint32_t)r[i + 9] | (uint32_t)r[i + 10] << 8 | (uint32_t)r[i + 11] << 16 |
+				    (uint32_t)r[i + 12] << 24, (uint32_t)r[i + 13] | (uint32_t)r[i + 14] << 8,
+				    (uint32_t)r[i + 15] | (uint32_t)r[i + 16] << 8, (uint32_t)r[i + 17] | (uint32_t)r[i + 18] << 8 |
+				    (uint32_t)r[i + 19] << 16 | (uint32_t)r[i + 20] << 24);
+				break;
+			}
+		}
+		say("icespmi: 23f4b QCA version (EDL 0x19) after the download: status %d [%s]\n", st, hex);
+	}
+	m = f4_xfer(tx, rx, io, lver, (int)sizeof(lver), 60000, r, (int)sizeof(r), &framing, &gap);
+	st = f4_cc(r, m, 0x1001, -1);
+	f4_hex(hex, r, m, 32);
+	say("icespmi: 23f4 Read_Local_Version: status %d [%s]\n", st, hex);
+	f4_ok = st == 0 && patched;
+	say("icespmi: 23f4 %s\n", st == 0 && patched ? "PASS (rampatch + NVM taken: build BTFW.BRAHMA, the controller answers HCI)" :
+	    st == 0 ? "NOT PASSED: HCI answers but the build string is not the patched one" : "ended (see above)");
+}
+
+/* 23h: one command over the engine, its reply logged; the status of a command complete for opcode (rtype if >= 0) */
+static int
+h_cmd(const char *name, const uint8_t *b, int n, uint32_t cap_us, int opcode, int rtype)
+{
+	uint8_t r[96];
+	char hex[96 * 3 + 1];
+	int m, st, framing = 0;
+	uint32_t gap = 0;
+
+	m = f4_xfer2(0, 0, 0, b, n, NULL, 0, cap_us, r, (int)sizeof(r), &framing, &gap);
+	st = opcode >= 0 ? f4_cc(r, m, (uint16_t)opcode, rtype) : -1;
+	f4_hex(hex, r, m, 40);
+	say("icegeni: 23h %s: %s, %d bytes [%s] status %d\n", name, framing < 0 ? "TX FAILED" : "sent", m, hex, st);
+	return st;
+}
+
+/* the SE registers 23h / 23h0b write, saved first and put back as found */
+static const uint32_t h_regs[] = { 0x28, 0xe30, 0x24, 0xe1c, 0x258, 0xe18, 0x810, 0x814, 0x614, 0x644, 0x260, 0x264, 0x284,
+	                           0x288, 0x25c, 0x2a4, 0x280, 0x2a8, 0x268, 0x28c, 0x26c, 0x294, 0x22c, 0x7c, 0x48, 0x4c, 0x2ac };
+#define H_NREGS         (sizeof(h_regs) / sizeof(h_regs[0]))
+
+/* geni_se_init + FIFO mode + 8N1 UART at 115200, CTS ignored, RFR automatic, loopback = SE_UART_LOOPBACK_CFG */
+static bool
+h_setup(uint32_t *saved, uint32_t loopback)
+{
+	for (unsigned i = 0; i < H_NREGS; i++) {
+		saved[i] = io_rd(h_se, h_regs[i]);
+	}
+	h_w(0x634, 1u << 1);                    /* S_GENI_CMD_ABORT: no read left running */
+	delay(1000);
+	h_w(0xe18, 0);
+	h_w(0x618, 0xffffffffu);
+	h_w(0x648, 0xffffffffu);
+	h_w(0xc44, 0xffffffffu);
+	h_w(0xd44, 0xffffffffu);
+	h_w(0x28, io_rd(h_se, 0x28) | 0x7fu);
+	h_w(0xe30, io_rd(h_se, 0xe30) | 0xfu);
+	h_w(0x24, 0x7fu);
+	h_w(0x20, 1u);                          /* FORCE_DEFAULT */
+	h_w(0xe1c, io_rd(h_se, 0xe1c) | 0xfu);
+	h_w(0x258, io_rd(h_se, 0x258) & ~1u);   /* FIFO mode */
+	h_w(0x810, 2);
+	h_w(0x814, h_rxdepth - 2);
+	h_w(0x614, io_rd(h_se, 0x614) | 0x31u);
+	h_w(0x644, io_rd(h_se, 0x644) | 0x21u);
+	h_w(0x260, 0xf);
+	h_w(0x264, 0);
+	h_w(0x284, 0xf);
+	h_w(0x288, 0);
+	h_w(0x25c, 1u << 1);
+	h_w(0x2a4, 0);
+	h_w(0x280, 0);
+	h_w(0x2a8, 0);
+	h_w(0x268, 8);
+	h_w(0x28c, 8);
+	h_w(0x26c, 0);
+	h_w(0x294, 16 * 10);
+	h_w(0x22c, loopback);
+	h_w(0x2ac, 0);                          /* RFR automatic */
+	if (!h_baud(115200)) {
+		return false;
+	}
+	h_w(0x630, 1u << 27);                   /* S: UART_START_READ */
+	return true;
+}
+
+static void
+h_restore(const uint32_t *saved)
+{
+	h_w(0x634, 1u << 1);                    /* S abort */
+	h_w(0x604, 1u << 2);                    /* M cancel */
+	delay(1000);
+	h_w(0x618, 0xffffffffu);
+	h_w(0x648, 0xffffffffu);
+	for (unsigned i = 0; i < H_NREGS; i++) {
+		h_w(h_regs[i], saved[i]);
+	}
+	h_rcg_restore();
+}
+
+/*
+ * 23h0b (icegeni=4): SE5 in internal loopback (SE_UART_LOOPBACK_CFG = RX_TX_SORTED | CTS_RTS_SORTED, Linux's TIOCM_LOOP
+ * value), bt-enable untouched, pads NOT muxed (they stay plain GPIOs): 16 bytes at 115200 and again at 3.2 Mbaud must
+ * come back equal; every SE register put back as found, the s5 vote as found. The staged bring-up of the ios-v60
+ * notes (read-only -> loopback -> one command); approach only.
+ */
+static void
+h_loop(void)
+{
+	static const uint8_t pat[16] = { 0x01, 0x03, 0x0c, 0x00, 0x55, 0xaa, 0x00, 0xff, 0x0f, 0xf0, 0x31, 0x48, 0xfc, 0x7e, 0x80, 0x11 };
+	uint32_t saved[H_NREGS], vote0 = 0;
+	vm_offset_t gcc = ml_io_map_unmappable(GCC_PA, 0xb0000, VM_WIMG_IO);
+	int proto = h0_probe(true, &vote0);
+	uint8_t r[64];
+
+	if (proto != 2 || gcc == 0 || h_txdepth == 0 || h_rxdepth < 4) {
+		say("icegeni: 23h0b REFUSED: protocol %d (UART = 2), depths %u / %u: nothing written to the SE\n", proto, h_txdepth,
+		    h_rxdepth);
+	} else {
+		bool ok = h_setup(saved, 3);
+		static const uint32_t bauds[2] = { 115200, 3200000 };
+		for (int k = 0; ok && k < 2; k++) {
+			int m;
+			char hex[64 * 3 + 1];
+			if (k == 1 && !h_baud(bauds[k])) {
+				break;
+			}
+			m = h_rx(2000, r, (int)sizeof(r));     /* drain */
+			if (!h_tx(pat, (int)sizeof(pat), NULL, 0)) {
+				say("icegeni: 23h0b %u baud: TX failed\n", bauds[k]);
+				continue;
+			}
+			m = 0;
+			{
+				uint64_t dl, t0 = mach_absolute_time();
+				nanoseconds_to_absolutetime(20000000ull, &dl);
+				while (m < (int)sizeof(pat) && mach_absolute_time() - t0 < dl) {
+					while (m < (int)sizeof(r) && (io_rd(h_se, 0x804) & 0x1ffffffu)) {
+						r[m++] = (uint8_t)io_rd(h_se, 0x780);
+					}
+				}
+			}
+			f4_hex(hex, r, m, 64);
+			say("icegeni: 23h0b %u baud loopback: sent 16, got %d [%s] -> %s\n", bauds[k], m, hex,
+			    m == (int)sizeof(pat) && memcmp(r, pat, sizeof(pat)) == 0 ? "PASS" : "FAIL");
+		}
+		h_restore(saved);
+		say("icegeni: 23h0b SE5 registers put back as found (%u); LOOPBACK_CFG %08x\n", (unsigned)H_NREGS, io_rd(h_se, 0x22c));
+	}
+	if (gcc != 0 && !((vote0 >> 17) & 1)) {
+		*(volatile uint32_t *)(gcc + 0x52018) = vote0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icegeni: gcc 0x52018 put back %08x (read back %08x)\n", vote0, io_rd(gcc, 0x52018));
+	}
+}
+
+/*
+ * 23rp2a (icegeni_hci=1): the first step of the bluetoothd transport (23rp2 / ios-apollo 23ap4 shims): after the
+ * firmware is in (23h3), the standard HCI init reads a host stack does, over the engine at 3.2 Mbaud, each reply
+ * logged in full - the facts the shim must answer or patch (Supported Commands bitmap, LMP / LE features, buffer
+ * sizes, LE data length). Reads only (HCI informational / LE read commands). Read_BD_ADDR: status and "set / zero"
+ * only - the address itself (unit data) is never logged.
+ */
+static void
+h_hci_probe(void)
+{
+	static const struct {
+		const char *name;
+		uint8_t cmd[5];
+		int len;
+		uint16_t op;
+	} c[] = {
+		{ "Read_Local_Version", { 0x01, 0x01, 0x10, 0x00 }, 4, 0x1001 },
+		{ "Read_Local_Supported_Commands", { 0x01, 0x02, 0x10, 0x00 }, 4, 0x1002 },
+		{ "Read_Local_Supported_Features", { 0x01, 0x03, 0x10, 0x00 }, 4, 0x1003 },
+		{ "Read_Local_Extended_Features p1", { 0x01, 0x04, 0x10, 0x01, 0x01 }, 5, 0x1004 },
+		{ "Read_Buffer_Size", { 0x01, 0x05, 0x10, 0x00 }, 4, 0x1005 },
+		{ "LE_Read_Buffer_Size", { 0x01, 0x02, 0x20, 0x00 }, 4, 0x2002 },
+		{ "LE_Read_Local_Supported_Features", { 0x01, 0x03, 0x20, 0x00 }, 4, 0x2003 },
+		{ "LE_Read_Maximum_Data_Length", { 0x01, 0x2f, 0x20, 0x00 }, 4, 0x202f },
+		{ "LE_Read_Number_of_Supported_Advertising_Sets", { 0x01, 0x3b, 0x20, 0x00 }, 4, 0x203b },
+	};
+	static const uint8_t bdaddr[] = { 0x01, 0x09, 0x10, 0x00 };
+	uint8_t r[96];
+	char hex[96 * 3 + 1];
+	int m, st, framing = 0;
+	uint32_t gap = 0;
+
+	for (unsigned i = 0; i < sizeof(c) / sizeof(c[0]); i++) {
+		m = f4_xfer2(0, 0, 0, c[i].cmd, c[i].len, NULL, 0, 100000, r, (int)sizeof(r), &framing, &gap);
+		st = f4_cc(r, m, c[i].op, -1);
+		f4_hex(hex, r, m, 96);
+		say("icegeni: 23rp2a %s: status %d, %d bytes [%s]\n", c[i].name, st, m, hex);
+	}
+	m = f4_xfer2(0, 0, 0, bdaddr, (int)sizeof(bdaddr), NULL, 0, 100000, r, (int)sizeof(r), &framing, &gap);
+	st = f4_cc(r, m, 0x1009, -1);
+	{
+		bool set = false;
+		for (int i = 0; i + 12 < m; i++) {
+			if (r[i] == 0x04 && r[i + 1] == 0x0e && r[i + 4] == 0x09 && r[i + 5] == 0x10) {
+				for (int k = 0; k < 6; k++) {
+					set = set || r[i + 7 + k] != 0;
+				}
+				break;
+			}
+		}
+		say("icegeni: 23rp2a Read_BD_ADDR: status %d, address %s (not logged)\n", st, set ? "set" : "zero / none");
+	}
+}
+
+/*
+ * ---- 23bt1 / 23bt2 (icegeni_bt=1 / 2, with icegeni=3 icewifi=2 icespmi=3): the controller fully up after 23h3's
+ * firmware load, HCI only, over the engine at 3.2 Mbaud (CTS as 23h3 set it). Order as a host stack's init (BlueZ
+ * hci_init1-4 subset; Bluetooth Core spec Vol 4 Part E for the opcodes / parameters, nothing copied):
+ *   HCI_Reset; Set_Event_Mask (the common default ff ff fb ff 07 f8 bf 3d, LE Meta bit 61 on); LE_Set_Event_Mask (spec
+ *   default 0x1f, LE Advertising Report on); Read_BD_ADDR (only the last two bytes logged, the rest masked);
+ *   Read_Local_Version; Read_Local_Supported_Features; LE_Read_Local_Supported_Features; Read_Buffer_Size;
+ *   LE_Read_Buffer_Size; Write_Scan_Enable 0 (no inquiry / page scan); LE_Set_Scan_Parameters PASSIVE (type 0,
+ *   interval = window = 60 ms, public own address, accept all); LE_Set_Scan_Enable 1 (duplicates not filtered).
+ * NO command here makes the radio transmit: a passive scan sends no SCAN_REQ; no advertising, inquiry, page,
+ * connection or test-mode command is sent. Advertising reports are only COUNTED: reports, distinct addresses (64-bit
+ * hashes kept in memory, never logged), event / address types, an RSSI histogram. Never an address, a name or AD data.
+ *   23bt1: one 10 s passive scan, LE_Set_Scan_Enable 0, HCI_Reset.
+ *   23bt2: soak, 120 s: one read every 100 ms (5 informational reads in turn) and in every 20 s a passive scan window
+ *   from 5 s to 15 s. Counted: UART errors (S_IRQ RX overrun / GP0 parity / GP1 rx error / GP2-3 break / FIFO read
+ *   error, M_IRQ TX errors), CTS stalls (TX longer than 1 ms; TX stuck = h_tx cancelled), timeouts (no Command
+ *   Complete / Status in 100 ms), lost or damaged events (stray bytes, malformed events, unexpected or late Command
+ *   Complete, Data Buffer Overflow, Hardware Error) -> STABLE / MARGINAL / UNSTABLE.
+ * RX: the FIFO is drained while bytes come; after 300 us without a byte the thread sleeps 1 ms. RFR is automatic
+ * (watermark depth - 2), so the chip is held off meanwhile and no byte is lost on our side; the largest FIFO fill is
+ * logged. The S / M error interrupt-enable bits are set (registers 0x644 / 0x614 are in h_regs: put back as found).
+ */
+#define HB_S_ERR        ((1u << 9) | (1u << 10) | (1u << 11) | (1u << 12) | (1u << 24) | (1u << 25))
+#define HB_M_ERR        ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 26) | (1u << 27))
+
+static struct {
+	uint32_t ev, cc, cs, nop, stray, malformed, unexpected, hwerr, bufovf, vendor, other, le_other;
+	uint32_t adv, adv_et[6], adv_pub, adv_rand, rssi[8];
+	uint32_t s_ovr, s_par, s_rxerr, s_brk, s_rderr, m_err, tx_fail, tx_slow, tx_max_us, fifo_max, cts_holds;
+	uint32_t sent, ok, bad_status, timeout, lat[5], lat_max_us;
+} hb;
+static uint64_t hb_seen[1024];
+static uint32_t hb_distinct;
+static bool hb_full, hb_cts_was_off;
+static uint8_t hb_buf[260];
+static int hb_n;
+static uint16_t hb_want;                /* the opcode waited for, 0 = none */
+static int hb_st;                       /* its status, -1 = not yet */
+static uint8_t hb_reply[64];            /* its return parameters (Num_HCI_Command_Packets, opcode, status, ...) */
+static int hb_rlen;
+
+static void
+hb_seen_add(uint8_t at, const uint8_t *a)
+{
+	uint64_t h = 1469598103934665603ull;
+
+	h = (h ^ at) * 1099511628211ull;
+	for (int i = 0; i < 6; i++) {
+		h = (h ^ a[i]) * 1099511628211ull;
+	}
+	if (h == 0) {
+		h = 1;
+	}
+	for (unsigned i = 0, s = (unsigned)(h & 1023u); i < 1024; i++, s = (s + 1) & 1023u) {
+		if (hb_seen[s] == h) {
+			return;
+		}
+		if (hb_seen[s] == 0) {
+			hb_seen[s] = h;
+			hb_distinct++;
+			return;
+		}
+	}
+	hb_full = true;
+}
+
+/* one whole H4 event in e (04, code, length, parameters) */
+static void
+hb_event(const uint8_t *e)
+{
+	uint8_t ev = e[1], plen = e[2];
+	const uint8_t *p = e + 3;
+
+	hb.ev++;
+	if (ev == 0x0e || ev == 0x0f) {
+		uint16_t op;
+		int st;
+		if ((ev == 0x0e && plen < 3) || (ev == 0x0f && plen < 4)) {
+			hb.malformed++;
+			return;
+		}
+		if (ev == 0x0e) {
+			hb.cc++;
+			op = (uint16_t)(p[1] | p[2] << 8);
+			st = plen >= 4 ? p[3] : 0;
+		} else {
+			hb.cs++;
+			op = (uint16_t)(p[2] | p[3] << 8);
+			st = p[0];
+		}
+		if (op == 0) {
+			hb.nop++;                           /* command credits only */
+			return;
+		}
+		if (hb_want != 0 && op == hb_want && hb_st < 0) {
+			hb_st = st;
+			hb_rlen = (int)plen < (int)sizeof(hb_reply) ? (int)plen : (int)sizeof(hb_reply);
+			memcpy(hb_reply, p, (size_t)hb_rlen);
+		} else {
+			hb.unexpected++;
+		}
+		return;
+	}
+	if (ev == 0x3e) {
+		int num, off = 2;
+		if (plen < 2 || p[0] != 0x02) {
+			hb.le_other++;
+			return;
+		}
+		num = p[1];
+		for (int k = 0; k < num; k++) {
+			uint8_t et, at, dl;
+			int8_t rssi;
+			if (off + 9 > plen) {
+				hb.malformed++;
+				break;
+			}
+			et = p[off];
+			at = p[off + 1];
+			dl = p[off + 8];
+			if (off + 9 + dl + 1 > plen) {
+				hb.malformed++;
+				break;
+			}
+			rssi = (int8_t)p[off + 9 + dl];
+			hb.adv++;
+			hb.adv_et[et < 5 ? et : 5]++;
+			if (at & 1) {
+				hb.adv_rand++;
+			} else {
+				hb.adv_pub++;
+			}
+			hb.rssi[rssi == 127 ? 7 : rssi >= -40 ? 0 : rssi >= -50 ? 1 : rssi >= -60 ? 2 : rssi >= -70 ? 3 :
+			    rssi >= -80 ? 4 : rssi >= -90 ? 5 : 6]++;
+			hb_seen_add(at, p + off + 2);
+			off += 10 + dl;
+		}
+		return;
+	}
+	if (ev == 0x10) {
+		if (hb.hwerr++ < 3) {
+			say("icegeni: 23bt HARDWARE ERROR event, code %#x\n", plen >= 1 ? p[0] : 0xffu);
+		}
+		return;
+	}
+	if (ev == 0x1a) {
+		hb.bufovf++;
+		return;
+	}
+	if (ev == 0xff) {
+		if (hb.vendor++ < 3) {
+			say("icegeni: 23bt vendor event, %u bytes, first %02x\n", plen, plen >= 1 ? p[0] : 0);
+		}
+		return;
+	}
+	if (hb.other++ < 5) {
+		say("icegeni: 23bt event %#x, %u bytes (not expected)\n", ev, plen);
+	}
+}
+
+static void
+hb_byte(uint8_t b)
+{
+	if (hb_n == 0 && b != 0x04) {
+		hb.stray++;
+		return;
+	}
+	hb_buf[hb_n++] = b;
+	if (hb_n == 2 && (b == 0 || (b > 0x58 && b != 0xff))) {
+		/* not an event code: the 04 was a stray byte (resync) */
+		hb.stray++;
+		hb_n = 0;
+		if (b == 0x04) {
+			hb_buf[hb_n++] = b;
+		}
+		return;
+	}
+	if (hb_n >= 3 && hb_n == 3 + hb_buf[2]) {
+		hb_event(hb_buf);
+		hb_n = 0;
+	}
+}
+
+/* drain RX for up to us microseconds (to the first reply for hb_want when stop), counting the engine's errors */
+static void
+hb_pump(uint32_t us, bool stop)
+{
+	uint64_t dl, idle, t0 = mach_absolute_time(), last = t0, now;
+
+	nanoseconds_to_absolutetime((uint64_t)us * 1000ull, &dl);
+	nanoseconds_to_absolutetime(300000ull, &idle);
+	for (;;) {
+		uint32_t fill = io_rd(h_se, 0x804) & 0x1ffffffu, s;
+		bool got = fill != 0, off;
+		if (fill > hb.fifo_max) {
+			hb.fifo_max = fill;
+		}
+		while (io_rd(h_se, 0x804) & 0x1ffffffu) {
+			hb_byte((uint8_t)io_rd(h_se, 0x780));
+		}
+		s = io_rd(h_se, 0x640) & HB_S_ERR;
+		if (s) {
+			hb.s_par += (s >> 9) & 1;
+			hb.s_rxerr += (s >> 10) & 1;
+			hb.s_brk += ((s >> 11) | (s >> 12)) & 1;
+			hb.s_rderr += (s >> 24) & 1;
+			hb.s_ovr += (s >> 25) & 1;
+			h_w(0x648, s);
+		}
+		off = (io_rd(h_se, 0x908) >> 1) & 1;
+		if (off && !hb_cts_was_off) {
+			hb.cts_holds++;
+		}
+		hb_cts_was_off = off;
+		if (stop && hb_st >= 0) {
+			return;
+		}
+		now = mach_absolute_time();
+		if (now - t0 >= dl) {
+			return;
+		}
+		if (got) {
+			last = now;
+		} else if (now - last > idle) {
+			IOSleep(1);
+		}
+	}
+}
+
+/* one command; its status (-1 no reply within cap_us, -2 TX failed); the return parameters in hb_reply */
+static int
+hb_cmd(const uint8_t *b, int n, uint32_t cap_us)
+{
+	uint64_t t0, el;
+	uint32_t me;
+
+	hb_want = (uint16_t)(b[1] | b[2] << 8);
+	hb_st = -1;
+	hb_rlen = 0;
+	hb.sent++;
+	t0 = mach_absolute_time();
+	if (!h_tx(b, n, NULL, 0)) {
+		hb.tx_fail++;
+		hb_want = 0;
+		return -2;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+	if (el / 1000 > hb.tx_max_us) {
+		hb.tx_max_us = (uint32_t)(el / 1000);
+	}
+	if (el > 1000000ull) {
+		hb.tx_slow++;
+	}
+	me = io_rd(h_se, 0x610) & HB_M_ERR;
+	if (me) {
+		hb.m_err++;
+		h_w(0x618, me);
+	}
+	hb_pump(cap_us, true);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+	hb_want = 0;
+	if (hb_st < 0) {
+		hb.timeout++;
+		return -1;
+	}
+	if (el / 1000 > hb.lat_max_us) {
+		hb.lat_max_us = (uint32_t)(el / 1000);
+	}
+	hb.lat[el < 1000000ull ? 0 : el < 2000000ull ? 1 : el < 5000000ull ? 2 : el < 10000000ull ? 3 : 4]++;
+	if (hb_st != 0) {
+		hb.bad_status++;
+	} else {
+		hb.ok++;
+	}
+	return hb_st;
+}
+
+/* a bring-up step, logged: status and the first logb return bytes (0: none) */
+static int
+hb_step(const char *name, const uint8_t *b, int n, int logb)
+{
+	char hex[24 * 3 + 1];
+	int st = hb_cmd(b, n, 200000);
+
+	f4_hex(hex, hb_reply, logb && hb_rlen > 0 ? hb_rlen : 0, logb < 24 ? logb : 24);
+	say("icegeni: 23bt %s: status %d%s [%s]\n", name, st, st == -1 ? " (TIMEOUT)" : st == -2 ? " (TX FAILED)" : "", hex);
+	return st;
+}
+
+static const uint8_t hb_c_reset[] = { 0x01, 0x03, 0x0c, 0x00 };
+static const uint8_t hb_c_lver[] = { 0x01, 0x01, 0x10, 0x00 };
+static const uint8_t hb_c_feat[] = { 0x01, 0x03, 0x10, 0x00 };
+static const uint8_t hb_c_lefeat[] = { 0x01, 0x03, 0x20, 0x00 };
+static const uint8_t hb_c_buf[] = { 0x01, 0x05, 0x10, 0x00 };
+static const uint8_t hb_c_lebuf[] = { 0x01, 0x02, 0x20, 0x00 };
+static const uint8_t hb_c_scan_on[] = { 0x01, 0x0c, 0x20, 0x02, 0x01, 0x00 };
+static const uint8_t hb_c_scan_off[] = { 0x01, 0x0c, 0x20, 0x02, 0x00, 0x00 };
+
+static void
+hb_scan_log(const char *what)
+{
+	say("icegeni: 23bt %s: %u advertising reports, %u distinct addresses%s (%u public-type / %u random-type reports; random "
+	    "addresses rotate, so not a device count); types ADV_IND %u DIRECT %u SCAN_IND %u NONCONN %u SCAN_RSP %u other %u\n",
+	    what, hb.adv, hb_distinct, hb_full ? "+ (table full)" : "", hb.adv_pub, hb.adv_rand, hb.adv_et[0], hb.adv_et[1],
+	    hb.adv_et[2], hb.adv_et[3], hb.adv_et[4], hb.adv_et[5]);
+	say("icegeni: 23bt %s RSSI dBm: >=-40 %u, -41..-50 %u, -51..-60 %u, -61..-70 %u, -71..-80 %u, -81..-90 %u, <-90 %u, "
+	    "n/a %u\n", what, hb.rssi[0], hb.rssi[1], hb.rssi[2], hb.rssi[3], hb.rssi[4], hb.rssi[5], hb.rssi[6], hb.rssi[7]);
+}
+
+static void
+hb_link_log(const char *what)
+{
+	say("icegeni: 23bt %s link: commands %u ok %u bad status %u TIMEOUTS %u; events %u (CC %u CS %u credits %u LE other %u "
+	    "vendor %u other %u); stray bytes %u, malformed %u, unexpected / late CC %u, HW error %u, buffer overflow %u\n", what,
+	    hb.sent, hb.ok, hb.bad_status, hb.timeout, hb.ev, hb.cc, hb.cs, hb.nop, hb.le_other, hb.vendor, hb.other, hb.stray,
+	    hb.malformed, hb.unexpected, hb.hwerr, hb.bufovf);
+	say("icegeni: 23bt %s UART: RX overrun %u, parity %u, rx error %u, break %u, FIFO read error %u, M TX errors %u; TX "
+	    "failed (stuck) %u, CTS stalls (TX > 1 ms) %u, longest TX %u us, CTS holds seen %u; RX FIFO max fill %u of %u; "
+	    "reply latency <1 ms %u, <2 %u, <5 %u, <10 %u, >=10 %u, max %u us\n", what, hb.s_ovr, hb.s_par, hb.s_rxerr, hb.s_brk,
+	    hb.s_rderr, hb.m_err, hb.tx_fail, hb.tx_slow, hb.tx_max_us, hb.cts_holds, hb.fifo_max, h_rxdepth, hb.lat[0],
+	    hb.lat[1], hb.lat[2], hb.lat[3], hb.lat[4], hb.lat_max_us);
+}
+
+/* the bring-up of 23bt1 / 23bt2; true when every step answered status 0 */
+static bool
+hb_bringup(void)
+{
+	static const uint8_t evmask[] = { 0x01, 0x01, 0x0c, 0x08, 0xff, 0xff, 0xfb, 0xff, 0x07, 0xf8, 0xbf, 0x3d };
+	static const uint8_t leevmask[] = { 0x01, 0x01, 0x20, 0x08, 0x1f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
+	static const uint8_t bdaddr[] = { 0x01, 0x09, 0x10, 0x00 };
+	static const uint8_t wscan0[] = { 0x01, 0x1a, 0x0c, 0x01, 0x00 };
+	static const uint8_t scanpar[] = { 0x01, 0x0b, 0x20, 0x07, 0x00, 0x60, 0x00, 0x60, 0x00, 0x00, 0x00 };
+	int bad = 0, st;
+
+	bad += hb_step("HCI_Reset", hb_c_reset, (int)sizeof(hb_c_reset), 0) != 0;
+	bad += hb_step("Set_Event_Mask (LE Meta on)", evmask, (int)sizeof(evmask), 0) != 0;
+	bad += hb_step("LE_Set_Event_Mask 0x1f", leevmask, (int)sizeof(leevmask), 0) != 0;
+	st = hb_cmd(bdaddr, (int)sizeof(bdaddr), 200000);
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 10) {
+		say("icegeni: 23bt Read_BD_ADDR: status 0, address **:**:**:**:%02x:%02x (masked)\n", hb_reply[5], hb_reply[4]);
+	} else {
+		say("icegeni: 23bt Read_BD_ADDR: status %d, %d bytes\n", st, hb_rlen);
+	}
+	st = hb_cmd(hb_c_lver, (int)sizeof(hb_c_lver), 200000);
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 12) {
+		say("icegeni: 23bt Read_Local_Version: HCI %#x rev %#x, LMP %#x subversion %#x, manufacturer %#x\n", hb_reply[4],
+		    hb_reply[5] | hb_reply[6] << 8, hb_reply[7], hb_reply[10] | hb_reply[11] << 8, hb_reply[8] | hb_reply[9] << 8);
+	} else {
+		say("icegeni: 23bt Read_Local_Version: status %d\n", st);
+	}
+	st = hb_step("Read_Local_Supported_Features", hb_c_feat, (int)sizeof(hb_c_feat), 12);
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 12) {
+		say("icegeni: 23bt LMP features: LE supported (controller) %u, BR/EDR not supported %u, simultaneous LE + BR/EDR %u\n",
+		    (hb_reply[8] >> 6) & 1, (hb_reply[8] >> 5) & 1, (hb_reply[10] >> 1) & 1);
+	}
+	bad += hb_step("LE_Read_Local_Supported_Features", hb_c_lefeat, (int)sizeof(hb_c_lefeat), 12) != 0;
+	st = hb_cmd(hb_c_buf, (int)sizeof(hb_c_buf), 200000);
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 11) {
+		say("icegeni: 23bt Read_Buffer_Size: ACL %u bytes x %u, SCO %u bytes x %u\n", hb_reply[4] | hb_reply[5] << 8,
+		    hb_reply[7] | hb_reply[8] << 8, hb_reply[6], hb_reply[9] | hb_reply[10] << 8);
+	} else {
+		say("icegeni: 23bt Read_Buffer_Size: status %d\n", st);
+	}
+	st = hb_cmd(hb_c_lebuf, (int)sizeof(hb_c_lebuf), 200000);
+	bad += st != 0;
+	if (st == 0 && hb_rlen >= 7) {
+		say("icegeni: 23bt LE_Read_Buffer_Size: LE ACL %u bytes x %u%s\n", hb_reply[4] | hb_reply[5] << 8, hb_reply[6],
+		    hb_reply[4] == 0 && hb_reply[5] == 0 ? " (shared with BR/EDR)" : "");
+	} else {
+		say("icegeni: 23bt LE_Read_Buffer_Size: status %d\n", st);
+	}
+	bad += hb_step("Write_Scan_Enable 0 (no inquiry / page scan)", wscan0, (int)sizeof(wscan0), 0) != 0;
+	bad += hb_step("LE_Set_Scan_Parameters PASSIVE 60/60 ms", scanpar, (int)sizeof(scanpar), 0) != 0;
+	say("icegeni: 23bt bring-up %s (%d steps not status 0)\n", bad ? "INCOMPLETE" : "complete", bad);
+	return bad == 0;
+}
+
+static void
+hb_soak(void)
+{
+	static const uint8_t *const rd[5] = { hb_c_lver, hb_c_buf, hb_c_lebuf, hb_c_feat, hb_c_lefeat };
+	uint64_t t0, tick, now, el;
+	uint32_t windows = 0, scan_bad = 0;
+	bool scanning = false;
+	int k = 0, st;
+
+	nanoseconds_to_absolutetime(100000000ull, &tick);
+	say("icegeni: 23bt2 soak: 120 s, one read every 100 ms, passive scan from 5 to 15 s of every 20 s\n");
+	t0 = mach_absolute_time();
+	for (uint32_t i = 0; i < 1200; i++) {
+		if (i % 200 == 50) {
+			st = hb_cmd(hb_c_scan_on, (int)sizeof(hb_c_scan_on), 100000);
+			scanning = st == 0;
+			scan_bad += st != 0;
+			windows++;
+		} else if (i % 200 == 150 && scanning) {
+			st = hb_cmd(hb_c_scan_off, (int)sizeof(hb_c_scan_off), 100000);
+			if (st == 0) {
+				scanning = false;
+			}
+			scan_bad += st != 0;
+		} else {
+			(void)hb_cmd(rd[k], 4, 100000);
+			k = (k + 1) % 5;
+		}
+		now = mach_absolute_time();
+		if (now < t0 + (uint64_t)(i + 1) * tick) {
+			absolutetime_to_nanoseconds(t0 + (uint64_t)(i + 1) * tick - now, &el);
+			hb_pump((uint32_t)(el / 1000), false);
+		}
+		if (i % 200 == 199) {
+			say("icegeni: 23bt2 at %u s: commands %u ok %u timeouts %u TX failed %u CTS stalls %u, UART errors %u, stray %u, "
+			    "malformed %u, unexpected %u, reports %u\n", (i + 1) / 10, hb.sent, hb.ok, hb.timeout, hb.tx_fail, hb.tx_slow,
+			    hb.s_ovr + hb.s_par + hb.s_rxerr + hb.s_brk + hb.s_rderr + hb.m_err, hb.stray, hb.malformed, hb.unexpected,
+			    hb.adv);
+		}
+		if (hb.tx_fail >= 5) {
+			say("icegeni: 23bt2 soak STOPPED at %u s: 5 TX failures (the chip holds CTS)\n", i / 10);
+			break;
+		}
+	}
+	if (scanning) {
+		(void)hb_cmd(hb_c_scan_off, (int)sizeof(hb_c_scan_off), 200000);
+	}
+	hb_pump(50000, false);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+	say("icegeni: 23bt2 soak took %llu ms, %u scan windows (%u scan on / off not status 0)\n", el / 1000000, windows,
+	    scan_bad);
+	hb_scan_log("23bt2 scans");
+	hb_link_log("23bt2");
+	{
+		uint32_t uart = hb.s_ovr + hb.s_par + hb.s_rxerr + hb.s_brk + hb.s_rderr + hb.m_err;
+		uint32_t dmg = hb.timeout + hb.bad_status + hb.stray + hb.malformed + hb.unexpected + hb.bufovf + uart + scan_bad;
+		const char *v = hb.hwerr == 0 && hb.tx_fail == 0 && dmg == 0 ? "STABLE" :
+		    hb.hwerr == 0 && hb.tx_fail == 0 && dmg <= 3 ? "MARGINAL" : "UNSTABLE";
+		say("icegeni: 23bt2 VERDICT %s: %u commands, lost replies (timeouts) %u, UART errors %u, CTS stalls %u, TX stuck %u, "
+		    "damaged / unexpected events %u, HW errors %u\n", v, hb.sent, hb.timeout, uart, hb.tx_slow, hb.tx_fail,
+		    hb.stray + hb.malformed + hb.unexpected + hb.bufovf, hb.hwerr);
+	}
+}
+
+static void
+h_bt_up(int level)
+{
+	bool up;
+	int st;
+
+	memset(&hb, 0, sizeof(hb));
+	memset(hb_seen, 0, sizeof(hb_seen));
+	hb_distinct = 0;
+	hb_full = hb_cts_was_off = false;
+	hb_n = 0;
+	h_w(0x644, io_rd(h_se, 0x644) | HB_S_ERR);
+	h_w(0x614, io_rd(h_se, 0x614) | HB_M_ERR);
+	h_w(0x648, HB_S_ERR);
+	h_w(0x618, HB_M_ERR);
+	hb_pump(20000, false);
+	say("icegeni: 23bt%d start (HCI only, passive scan, no transmit command); %u bytes left over from the download\n", level,
+	    hb.stray + hb.ev);
+	memset(&hb, 0, sizeof(hb));
+	up = hb_bringup();
+	if (!up) {
+		say("icegeni: 23bt%d no scan: the bring-up was not clean\n", level);
+	} else if (level == 1) {
+		st = hb_cmd(hb_c_scan_on, (int)sizeof(hb_c_scan_on), 200000);
+		say("icegeni: 23bt1 LE_Set_Scan_Enable 1 (passive): status %d\n", st);
+		if (st == 0) {
+			hb_pump(10000000, false);
+			st = hb_cmd(hb_c_scan_off, (int)sizeof(hb_c_scan_off), 500000);
+			say("icegeni: 23bt1 LE_Set_Scan_Enable 0: status %d\n", st);
+			hb_pump(50000, false);
+			up = st == 0;
+		} else {
+			up = false;
+		}
+		hb_scan_log("23bt1 10 s scan");
+	} else {
+		memset(&hb, 0, sizeof(hb));
+		hb_soak();
+	}
+	st = hb_cmd(hb_c_reset, (int)sizeof(hb_c_reset), 500000);
+	say("icegeni: 23bt%d final HCI_Reset: status %d\n", level, st);
+	if (level == 1) {
+		hb_link_log("23bt1");
+		say("icegeni: 23bt1 %s\n", up && st == 0 && hb.adv > 0 ? "PASS (controller up; the passive scan heard advertisers; "
+		    "nothing transmitted)" : up && st == 0 ? "PARTIAL (every command status 0, but no advertising report: the radio "
+		    "receive path is unproven)" : "FAIL (see above)");
+	}
+}
+
+/*
+ * ---- 23bt3 / 23bt3s (scan40; icegeni_bt=3 / 4, with icegeni=3 icewifi=2 icespmi=3): the controller RESIDENT for iOS's
+ * bluetoothd. After 23h3's firmware load (f4_ok) the bring-up is NOT put back: bt-enable stays high (f2_bt), gpio16 and
+ * the rail / clock votes stay (wifi_power), the pads stay on qup3_se5, SE5 stays a 3.2 Mbaud UART with CTS / RFR flow
+ * control, the S5 RCG and the S5 branch vote stay. Then: HCI_Reset, Read_BD_ADDR -> RedwoodBT's local-mac-address
+ * (the 'bluetooth' service bluetoothd's FindLocalMacAddress reads; display order; only the last two bytes are ever
+ * logged), and the Xiaomi port's transport (hakios_dada_wifi.c: /dev/uart.bluetooth + cu.bluetooth, the kernel control
+ * com.apple.uart.sk.bluetooth, the Skywalk nexus of hakios_dada_btsk.c, the Broadcom vendor-command answers, the
+ * Supported Commands patch) is bound to this engine: hakios_bt_bind_uart(hr_tx), and our pump thread feeds the chip's
+ * bytes in with hakios_bt_rx_push. Nothing here makes the radio transmit: no command of ours after the bind; what
+ * bluetoothd sends goes to the chip as it is (its vendor commands are answered in hakios_dada_wifi.c and never sent).
+ * Monitor, never a parameter byte or an address: every distinct opcode bluetoothd sends (first time), its HCI_Resets
+ * and their answers, the radio-relevant commands (scan enable values, LE scan type, advertising / scan enables,
+ * inquiry / paging / connection attempts), refusals, commands left without Command Complete / Status for 2 s, the
+ * chip's Hardware Error / Data Buffer Overflow events, UART errors (S / M error interrupts), TX stalls, stray bytes,
+ * in-band sleep bytes (QCA IBS 0xfd / 0xfe / 0xfc at packet boundaries: answered / honoured, never passed up),
+ * advertising reports (counted only) and connection events (counted). 23bt3: a summary every 30 s for 10 min after
+ * the bind, then every 5 min. 23bt3s (=4): + a 120 s watch from bluetoothd's first byte, a summary every 10 s and a
+ * VERDICT (STABLE / MARGINAL / UNSTABLE).
+ * RX: as 23bt2's pump (proven STABLE for 1200 commands): the FIFO drained while bytes come, 1 ms sleeps after 300 us
+ * without a byte (2 ms after 1 s quiet); RFR is automatic, so the chip waits meanwhile. The UART read command is
+ * restarted only if the S sequencer stopped (GENI_STATUS bit 12 clear).
+ */
+#include <kern/locks.h>
+
+extern void hakios_bt_bind_uart(bool (*tx)(const uint8_t *p, uint32_t n));
+extern void hakios_bt_rx_push(const uint8_t *p, uint32_t n);
+extern uint32_t hakios_bt_rx_lost(void);
+extern uint32_t hakios_bt_connects(void);
+extern void hakios_dada_bt_make_node(void);
+extern void RedwoodBTSetAddress(const uint8_t *address);
+
+static int hr_level;                    /* 3 / 4 */
+static lck_mtx_t *hr_txlock, *hr_stlock;
+static volatile int hr_asleep, hr_acked, hr_wake_req;
+static uint64_t hr_t0, hr_first_tx, hr_last_cmd;
+static struct {
+	uint32_t h_bytes, h_cmd, h_acl, h_sco, h_iso, h_bad, h_reset, tx_fail, tx_slow, tx_max_us, m_err, wakes, wake_noack;
+	uint32_t c_bytes, c_ev, c_acl, c_sco, c_iso, stray, ev_odd, ibs_wake, ibs_sleep, ibs_ack, cc, cs, refused, hwerr;
+	uint32_t bufovf, vendor, le_adv, le_conn, conn, conn_req, disc, inq_res, ev_other, unanswered, rx_restart, fifo_max;
+	uint32_t s_ovr, s_par, s_rxerr, s_brk, s_rderr;
+	uint32_t inquiry, create_conn, le_create_conn, name_req, radio_lines, first_reset_st;
+	int scan_en, le_scan_type, le_scan_on, le_adv_on, ext_adv_on;
+} hr;
+static struct {
+	uint16_t op;
+	uint32_t n;
+} hr_ops[128];
+static uint32_t hr_nops;
+static struct {
+	uint16_t op;
+	uint64_t t;
+} hr_out[8];
+
+static uint32_t
+hr_sec(uint64_t abs)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / 1000000000ull);
+}
+
+static const char *
+hr_name(uint16_t op)
+{
+	static const struct {
+		uint16_t op;
+		const char *name;
+	} t[] = {
+		{ 0x0c03, "HCI_Reset" }, { 0x0c01, "Set_Event_Mask" }, { 0x0c63, "Set_Event_Mask_Page_2" },
+		{ 0x0c13, "Write_Local_Name" }, { 0x0c14, "Read_Local_Name" }, { 0x0c18, "Write_Page_Timeout" },
+		{ 0x0c1a, "Write_Scan_Enable" }, { 0x0c1c, "Write_Page_Scan_Activity" }, { 0x0c1e, "Write_Inquiry_Scan_Activity" },
+		{ 0x0c24, "Write_Class_Of_Device" }, { 0x0c33, "Host_Buffer_Size" }, { 0x0c45, "Write_Inquiry_Mode" },
+		{ 0x0c52, "Write_Extended_Inquiry_Response" }, { 0x0c56, "Write_Simple_Pairing_Mode" },
+		{ 0x0c5a, "Read_Default_Erroneous_Data_Reporting" }, { 0x0c5b, "Write_Default_Erroneous_Data_Reporting" },
+		{ 0x0c6d, "Write_LE_Host_Support" }, { 0x0c7a, "Write_Secure_Connections_Host_Support" },
+		{ 0x1001, "Read_Local_Version" }, { 0x1002, "Read_Local_Supported_Commands" }, { 0x1003, "Read_Local_Features" },
+		{ 0x1004, "Read_Local_Extended_Features" }, { 0x1005, "Read_Buffer_Size" }, { 0x1009, "Read_BD_ADDR" },
+		{ 0x0401, "Inquiry" }, { 0x0402, "Inquiry_Cancel" }, { 0x0403, "Periodic_Inquiry" }, { 0x0405, "Create_Connection" },
+		{ 0x0419, "Remote_Name_Request" }, { 0x2001, "LE_Set_Event_Mask" }, { 0x2002, "LE_Read_Buffer_Size" },
+		{ 0x2003, "LE_Read_Local_Features" }, { 0x2005, "LE_Set_Random_Address" }, { 0x2006, "LE_Set_Adv_Parameters" },
+		{ 0x2008, "LE_Set_Adv_Data" }, { 0x2009, "LE_Set_Scan_Response_Data" }, { 0x200a, "LE_Set_Adv_Enable" },
+		{ 0x200b, "LE_Set_Scan_Parameters" }, { 0x200c, "LE_Set_Scan_Enable" }, { 0x200d, "LE_Create_Connection" },
+		{ 0x200f, "LE_Read_Accept_List_Size" }, { 0x2010, "LE_Clear_Accept_List" }, { 0x201c, "LE_Read_Supported_States" },
+		{ 0x202f, "LE_Read_Max_Data_Length" }, { 0x2024, "LE_Write_Default_Data_Length" }, { 0x2031, "LE_Set_Default_PHY" },
+		{ 0x2036, "LE_Set_Ext_Adv_Parameters" }, { 0x2039, "LE_Set_Ext_Adv_Enable" }, { 0x203b, "LE_Read_Num_Adv_Sets" },
+		{ 0x2040, "LE_Set_Periodic_Adv_Enable" }, { 0x2041, "LE_Set_Ext_Scan_Parameters" },
+		{ 0x2042, "LE_Set_Ext_Scan_Enable" }, { 0x2043, "LE_Ext_Create_Connection" }, { 0x204e, "LE_Set_Privacy_Mode" },
+		{ 0x2027, "LE_Add_Device_To_Resolving_List" }, { 0x202d, "LE_Set_Address_Resolution_Enable" },
+	};
+
+	for (unsigned i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		if (t[i].op == op) {
+			return t[i].name;
+		}
+	}
+	return (op & 0xfc00) == 0xfc00 ? "(vendor)" : "";
+}
+
+/* a Command Complete / Status for op: the oldest outstanding one of that opcode is answered */
+static void
+hr_answered(uint16_t op)
+{
+	lck_mtx_lock(hr_stlock);
+	for (unsigned i = 0; i < 8; i++) {
+		if (hr_out[i].t != 0 && hr_out[i].op == op) {
+			hr_out[i].t = 0;
+			break;
+		}
+	}
+	lck_mtx_unlock(hr_stlock);
+}
+
+/* one of the chip's events, whole: counted (an advertising report only counted, never its address or data) */
+static void
+hr_event(uint8_t code, uint8_t plen, const uint8_t *p, uint32_t have)
+{
+	hr.c_ev++;
+	if (code == 0x0e || code == 0x0f) {
+		uint16_t op;
+		int st;
+
+		if ((code == 0x0e && have < 3) || (code == 0x0f && have < 4)) {
+			hr.ev_odd++;
+			return;
+		}
+		if (code == 0x0e) {
+			hr.cc++;
+			op = (uint16_t)(p[1] | p[2] << 8);
+			st = have >= 4 && plen >= 4 ? p[3] : 0;
+		} else {
+			hr.cs++;
+			op = (uint16_t)(p[2] | p[3] << 8);
+			st = p[0];
+		}
+		if (op == 0) {
+			return;
+		}
+		hr_answered(op);
+		if (st != 0) {
+			hr.refused++;
+		}
+		if (op == 0x0c03 && hr.h_reset <= 12) {
+			if (hr.h_reset == 1) {
+				hr.first_reset_st = (uint32_t)st;
+			}
+			say("icebt: the chip answers bluetoothd's HCI_Reset #%u: status %d\n", hr.h_reset, st);
+		}
+		return;
+	}
+	switch (code) {
+	case 0x10:
+		if (hr.hwerr++ < 5) {
+			say("icebt: HARDWARE ERROR event from the chip, code %#x\n", have >= 1 ? p[0] : 0xffu);
+		}
+		break;
+	case 0x1a:
+		hr.bufovf++;
+		break;
+	case 0xff:
+		hr.vendor++;
+		break;
+	case 0x3e:
+		if (have >= 1 && (p[0] == 0x02 || p[0] == 0x0d || p[0] == 0x0b)) {
+			hr.le_adv += have >= 2 ? p[1] : 1;
+		} else if (have >= 2 && (p[0] == 0x01 || p[0] == 0x0a)) {
+			if (hr.le_conn++ < 5) {
+				say("icebt: LE Connection Complete event (status %#x)\n", p[1]);
+			}
+		} else {
+			hr.ev_other++;
+		}
+		break;
+	case 0x03:
+		if (hr.conn++ < 5) {
+			say("icebt: Connection Complete event (status %#x)\n", have >= 1 ? p[0] : 0xffu);
+		}
+		break;
+	case 0x04:
+		hr.conn_req++;
+		break;
+	case 0x05:
+		hr.disc++;
+		break;
+	case 0x02:
+	case 0x22:
+	case 0x2f:
+		hr.inq_res++;
+		break;
+	default:
+		hr.ev_other++;
+		break;
+	}
+}
+
+/* the H4 framing of the chip's bytes; false for a byte not passed up (in-band sleep byte, stray byte) */
+static uint8_t hr_rh[6], hr_rev[16];
+static uint32_t hr_rn, hr_rneed, hr_rleft, hr_revn;
+
+static void
+hr_rx_done(void)
+{
+	switch (hr_rh[0]) {
+	case 0x04:
+		hr_event(hr_rh[1], hr_rh[2], hr_rev, hr_revn);
+		break;
+	case 0x02:
+		hr.c_acl++;
+		break;
+	case 0x03:
+		hr.c_sco++;
+		break;
+	default:
+		hr.c_iso++;
+		break;
+	}
+	hr_rn = 0;
+	hr_rleft = 0;
+	hr_revn = 0;
+}
+
+static bool
+hr_rx_byte(uint8_t b)
+{
+	if (hr_rn == 0) {
+		switch (b) {
+		case 0x04:
+			hr_rneed = 3;
+			break;
+		case 0x02:
+		case 0x05:
+			hr_rneed = 5;
+			break;
+		case 0x03:
+			hr_rneed = 4;
+			break;
+		case 0xfd:                      /* the chip wakes us: answered with 0xfc */
+			hr.ibs_wake++;
+			hr_asleep = 0;
+			hr_wake_req = 1;
+			return false;
+		case 0xfe:                      /* the chip goes to sleep: the next TX wakes it first */
+			hr.ibs_sleep++;
+			hr_asleep = 1;
+			return false;
+		case 0xfc:                      /* our wake is acknowledged */
+			hr.ibs_ack++;
+			hr_acked = 1;
+			hr_asleep = 0;
+			return false;
+		default:
+			hr.stray++;
+			return false;
+		}
+		hr_rh[0] = b;
+		hr_rn = 1;
+		return true;
+	}
+	if (hr_rn < hr_rneed) {
+		hr_rh[hr_rn++] = b;
+		if (hr_rn == hr_rneed) {
+			if (hr_rh[0] == 0x04) {
+				hr_rleft = hr_rh[2];
+				if (hr_rh[1] == 0 || (hr_rh[1] > 0x58 && hr_rh[1] != 0xff)) {
+					hr.ev_odd++;
+				}
+			} else if (hr_rh[0] == 0x03) {
+				hr_rleft = hr_rh[3];
+			} else if (hr_rh[0] == 0x02) {
+				hr_rleft = (uint32_t)(hr_rh[3] | hr_rh[4] << 8);
+			} else {
+				hr_rleft = (uint32_t)(hr_rh[3] | hr_rh[4] << 8) & 0x3fffu;
+			}
+			hr_revn = 0;
+			if (hr_rleft == 0) {
+				hr_rx_done();
+			}
+		}
+		return true;
+	}
+	if (hr_rh[0] == 0x04 && hr_revn < sizeof(hr_rev)) {
+		hr_rev[hr_revn++] = b;
+	}
+	if (--hr_rleft == 0) {
+		hr_rx_done();
+	}
+	return true;
+}
+
+/* one of bluetoothd's commands, whole (at most its first 8 parameter bytes in p, used only for the radio flags) */
+static void
+hr_cmd(uint16_t op, uint8_t plen, const uint8_t *p, uint32_t have)
+{
+	uint64_t now = mach_absolute_time();
+	uint32_t t = hr_sec(now);
+	bool known = false;
+
+	hr.h_cmd++;
+	hr_last_cmd = now;
+	for (uint32_t i = 0; i < hr_nops; i++) {
+		if (hr_ops[i].op == op) {
+			hr_ops[i].n++;
+			known = true;
+			break;
+		}
+	}
+	if (!known && hr_nops < 128) {
+		hr_ops[hr_nops].op = op;
+		hr_ops[hr_nops].n = 1;
+		hr_nops++;
+		say("icebt: bluetoothd sends %#06x %s (first time, %u parameter bytes) at %u s\n", op, hr_name(op), plen, t);
+	}
+	if (op != 0x0c35) {                 /* (Host_Number_Of_Completed_Packets has no answer) */
+		uint64_t oldest = ~0ull;
+		unsigned slot = 0;
+
+		lck_mtx_lock(hr_stlock);
+		for (unsigned i = 0; i < 8; i++) {
+			if (hr_out[i].t == 0) {
+				slot = i;
+				oldest = 0;
+				break;
+			}
+			if (hr_out[i].t < oldest) {
+				oldest = hr_out[i].t;
+				slot = i;
+			}
+		}
+		hr_out[slot].op = op;
+		hr_out[slot].t = now;
+		lck_mtx_unlock(hr_stlock);
+	}
+#define HR_RADIO(...) do { if (hr.radio_lines++ < 60) say(__VA_ARGS__); } while (0)
+	switch (op) {
+	case 0x0c03:
+		hr.h_reset++;
+		if (hr.h_reset <= 12) {
+			say("icebt: bluetoothd sends HCI_Reset #%u at %u s\n", hr.h_reset, t);
+		}
+		break;
+	case 0x0c1a:
+		if (have >= 1) {
+			hr.scan_en = p[0];
+			HR_RADIO("icebt: radio: Write_Scan_Enable %u (inquiry scan %s, page scan %s) at %u s\n", p[0],
+			    (p[0] & 1) ? "ON" : "off", (p[0] & 2) ? "ON" : "off", t);
+		}
+		break;
+	case 0x200b:
+		if (have >= 1) {
+			hr.le_scan_type = p[0];
+			HR_RADIO("icebt: radio: LE_Set_Scan_Parameters type %u (%s) at %u s\n", p[0], p[0] ? "ACTIVE: scan requests" :
+			    "passive", t);
+		}
+		break;
+	case 0x2041:
+		if (have >= 4) {
+			hr.le_scan_type = p[3];
+			HR_RADIO("icebt: radio: LE_Set_Ext_Scan_Parameters phys %#x, first type %u (%s) at %u s\n", p[2], p[3],
+			    p[3] ? "ACTIVE: scan requests" : "passive", t);
+		}
+		break;
+	case 0x200c:
+	case 0x2042:
+		if (have >= 1) {
+			hr.le_scan_on = p[0];
+			HR_RADIO("icebt: radio: %s %u at %u s\n", hr_name(op), p[0], t);
+		}
+		break;
+	case 0x200a:
+		if (have >= 1) {
+			hr.le_adv_on = p[0];
+			HR_RADIO("icebt: radio: LE_Set_Adv_Enable %u (%s) at %u s\n", p[0], p[0] ? "ADVERTISING" : "off", t);
+		}
+		break;
+	case 0x2039:
+		if (have >= 2) {
+			hr.ext_adv_on = p[0];
+			HR_RADIO("icebt: radio: LE_Set_Ext_Adv_Enable %u (%u sets; %s) at %u s\n", p[0], p[1], p[0] ? "ADVERTISING" :
+			    "off", t);
+		}
+		break;
+	case 0x2040:
+		HR_RADIO("icebt: radio: LE_Set_Periodic_Adv_Enable %u at %u s\n", have >= 1 ? p[0] : 0xffu, t);
+		break;
+	case 0x0401:
+	case 0x0403:
+		hr.inquiry++;
+		HR_RADIO("icebt: radio: %s (TRANSMITS inquiry packets) at %u s\n", hr_name(op), t);
+		break;
+	case 0x0405:
+		hr.create_conn++;
+		HR_RADIO("icebt: radio: Create_Connection (TRANSMITS pages) at %u s\n", t);
+		break;
+	case 0x0419:
+		hr.name_req++;
+		HR_RADIO("icebt: radio: Remote_Name_Request (TRANSMITS pages) at %u s\n", t);
+		break;
+	case 0x200d:
+	case 0x2043:
+		hr.le_create_conn++;
+		HR_RADIO("icebt: radio: %s (initiates: TRANSMITS when the peer advertises) at %u s\n", hr_name(op), t);
+		break;
+	default:
+		break;
+	}
+#undef HR_RADIO
+}
+
+/* the H4 framing of bluetoothd's bytes (called under hr_txlock) */
+static uint8_t hr_hh[5], hr_hp[8];
+static uint32_t hr_hn, hr_hneed, hr_hleft, hr_hpn;
+
+static void
+hr_host_done(void)
+{
+	switch (hr_hh[0]) {
+	case 0x01:
+		hr_cmd((uint16_t)(hr_hh[1] | hr_hh[2] << 8), hr_hh[3], hr_hp, hr_hpn);
+		break;
+	case 0x02:
+		hr.h_acl++;
+		break;
+	case 0x03:
+		hr.h_sco++;
+		break;
+	default:
+		hr.h_iso++;
+		break;
+	}
+	hr_hn = 0;
+	hr_hleft = 0;
+	hr_hpn = 0;
+}
+
+static void
+hr_host_bytes(const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		uint8_t b = p[i];
+
+		hr.h_bytes++;
+		if (hr_hn == 0) {
+			hr_hneed = b == 0x01 ? 4 : b == 0x03 ? 4 : (b == 0x02 || b == 0x05) ? 5 : 0;
+			if (hr_hneed == 0) {
+				hr.h_bad++;             /* (not H4: passed on as it is) */
+				continue;
+			}
+			hr_hh[0] = b;
+			hr_hn = 1;
+			continue;
+		}
+		if (hr_hn < hr_hneed) {
+			hr_hh[hr_hn++] = b;
+			if (hr_hn == hr_hneed) {
+				hr_hleft = hr_hh[0] == 0x01 ? hr_hh[3] : hr_hh[0] == 0x03 ? hr_hh[3] :
+				    hr_hh[0] == 0x02 ? (uint32_t)(hr_hh[3] | hr_hh[4] << 8) : (uint32_t)(hr_hh[3] | hr_hh[4] << 8) & 0x3fffu;
+				hr_hpn = 0;
+				if (hr_hleft == 0) {
+					hr_host_done();
+				}
+			}
+			continue;
+		}
+		if (hr_hh[0] == 0x01 && hr_hpn < sizeof(hr_hp)) {
+			hr_hp[hr_hpn++] = b;
+		}
+		if (--hr_hleft == 0) {
+			hr_host_done();
+		}
+	}
+}
+
+/* bluetoothd's bytes to the chip (hakios_dada_wifi.c bt_send); false when the UART did not take them */
+static bool
+hr_tx(const uint8_t *p, uint32_t n)
+{
+	static const uint8_t ibs_wake = 0xfd, ibs_ack = 0xfc;
+	uint64_t t0, el;
+	uint32_t me;
+	bool ok;
+
+	if (n == 0) {
+		return true;
+	}
+	lck_mtx_lock(hr_txlock);
+	if (hr_first_tx == 0) {
+		hr_first_tx = mach_absolute_time();
+		say("icebt: 23bt%s transport OPEN: bluetoothd's first bytes reach the chip at %u s (bound at %u s)\n",
+		    hr_level == 4 ? "3s" : "3", hr_sec(hr_first_tx), hr_sec(hr_t0));
+	}
+	if (hr_wake_req) {
+		hr_wake_req = 0;
+		(void)h_tx(&ibs_ack, 1, NULL, 0);
+	}
+	if (hr_asleep) {
+		hr_acked = 0;
+		hr.wakes++;
+		if (h_tx(&ibs_wake, 1, NULL, 0)) {
+			for (int i = 0; i < 20 && !hr_acked; i++) {
+				IOSleep(1);
+			}
+		}
+		if (!hr_acked) {
+			hr.wake_noack++;
+		}
+		hr_asleep = 0;
+	}
+	hr_host_bytes(p, n);
+	t0 = mach_absolute_time();
+	ok = h_tx(p, (int)n, NULL, 0);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+	if (!ok) {
+		hr.tx_fail++;
+	}
+	if (el / 1000 > hr.tx_max_us) {
+		hr.tx_max_us = (uint32_t)(el / 1000);
+	}
+	if (el > 1000000ull + (uint64_t)n * 4000ull) {      /* > 1 ms beyond the wire time: CTS held us */
+		hr.tx_slow++;
+	}
+	me = io_rd(h_se, 0x610) & HB_M_ERR;
+	if (me) {
+		hr.m_err++;
+		h_w(0x618, me);
+	}
+	lck_mtx_unlock(hr_txlock);
+	return ok;
+}
+
+static uint32_t
+hr_uart_errors(void)
+{
+	return hr.s_ovr + hr.s_par + hr.s_rxerr + hr.s_brk + hr.s_rderr + hr.m_err;
+}
+
+static void
+hr_summary(const char *tag)
+{
+	say("icebt: %s host: %u bytes, commands %u (HCI_Reset %u), ACL %u, SCO %u, ISO %u, not H4 %u; chip: %u bytes, events %u "
+	    "(CC %u CS %u refused %u, vendor %u, other %u, odd %u), ACL %u; unanswered %u; ring lost %u; connects %u\n", tag,
+	    hr.h_bytes, hr.h_cmd, hr.h_reset, hr.h_acl, hr.h_sco, hr.h_iso, hr.h_bad, hr.c_bytes, hr.c_ev, hr.cc, hr.cs,
+	    hr.refused, hr.vendor, hr.ev_other, hr.ev_odd, hr.c_acl, hr.unanswered, hakios_bt_rx_lost(), hakios_bt_connects());
+	say("icebt: %s link: UART errors %u (overrun %u parity %u rx %u break %u FIFO read %u, M TX %u), TX failed %u, CTS stalls "
+	    "%u, longest TX %u us, RX FIFO max %u of %u, read restarts %u; stray %u; IBS wake / sleep / ack %u / %u / %u, our "
+	    "wakes %u (no ack %u); HW errors %u, buffer overflow %u\n", tag, hr_uart_errors(), hr.s_ovr, hr.s_par, hr.s_rxerr,
+	    hr.s_brk, hr.s_rderr, hr.m_err, hr.tx_fail, hr.tx_slow, hr.tx_max_us, hr.fifo_max, h_rxdepth, hr.rx_restart,
+	    hr.stray, hr.ibs_wake, hr.ibs_sleep, hr.ibs_ack, hr.wakes, hr.wake_noack, hr.hwerr, hr.bufovf);
+	say("icebt: %s radio as bluetoothd set it: Write_Scan_Enable %d (inquiry scan %s, page scan %s), LE scan %s (type %d), "
+	    "LE adv %s, ext adv %s; inquiries %u, pages %u + name requests %u, LE connects %u; heard: LE adv reports %u, "
+	    "inquiry results %u, connection requests %u; connections %u / LE %u, disconnections %u\n", tag, hr.scan_en,
+	    hr.scan_en < 0 ? "-" : (hr.scan_en & 1) ? "ON" : "off", hr.scan_en < 0 ? "-" : (hr.scan_en & 2) ? "ON" : "off",
+	    hr.le_scan_on < 0 ? "never set" : hr.le_scan_on ? "ON" : "off", hr.le_scan_type,
+	    hr.le_adv_on < 0 ? "never set" : hr.le_adv_on ? "ON" : "off", hr.ext_adv_on < 0 ? "never set" : hr.ext_adv_on ? "ON" : "off",
+	    hr.inquiry, hr.create_conn, hr.name_req, hr.le_create_conn, hr.le_adv, hr.inq_res, hr.conn_req, hr.conn, hr.le_conn,
+	    hr.disc);
+}
+
+static void
+hr_result(const char *tag)
+{
+	say("icebt: %s RESULT: transport %s, HCI_Reset from bluetoothd %u (the first answered status %d), %u distinct "
+	    "commands, %u refused, %u unanswered, bluetoothd connects %u\n", tag, hr_first_tx ? "OPENED" : "NOT opened",
+	    hr.h_reset, hr.h_reset ? (int)hr.first_reset_st : -1, hr_nops, hr.refused, hr.unanswered, hakios_bt_connects());
+}
+
+static void
+hr_pump(void *arg __unused, wait_result_t w __unused)
+{
+	static const uint8_t ibs_ack = 0xfc;
+	uint8_t out[512];
+	uint64_t last = mach_absolute_time(), idle, quiet1s, quiet3s, two_s, next_sum = 0;
+	uint32_t watch_next = 0, sums = 0, quiet_said = 0, said_out = 0;
+	bool verdict = false, quiet = true;
+
+	nanoseconds_to_absolutetime(300000ull, &idle);
+	nanoseconds_to_absolutetime(1000000000ull, &quiet1s);
+	nanoseconds_to_absolutetime(3000000000ull, &quiet3s);
+	nanoseconds_to_absolutetime(2000000000ull, &two_s);
+	for (;;) {
+		uint32_t on = 0, fill = io_rd(h_se, 0x804) & 0x1ffffffu, s;
+		uint64_t now;
+		bool got = fill != 0;
+
+		if (fill > hr.fifo_max) {
+			hr.fifo_max = fill;
+		}
+		while (io_rd(h_se, 0x804) & 0x1ffffffu) {
+			uint8_t b = (uint8_t)io_rd(h_se, 0x780);
+
+			hr.c_bytes++;
+			if (hr_rx_byte(b)) {
+				out[on++] = b;
+				if (on == sizeof(out)) {
+					hakios_bt_rx_push(out, on);
+					on = 0;
+				}
+			}
+		}
+		if (on != 0) {
+			hakios_bt_rx_push(out, on);
+		}
+		s = io_rd(h_se, 0x640);
+		if (s & HB_S_ERR) {
+			hr.s_par += (s >> 9) & 1;
+			hr.s_rxerr += (s >> 10) & 1;
+			hr.s_brk += ((s >> 11) | (s >> 12)) & 1;
+			hr.s_rderr += (s >> 24) & 1;
+			hr.s_ovr += (s >> 25) & 1;
+			h_w(0x648, s & HB_S_ERR);
+		}
+		if (s & 1u) {                   /* S_CMD_DONE: restart the read only if the S sequencer really stopped */
+			h_w(0x648, 1u);
+			if (!(io_rd(h_se, 0x40) & (1u << 12))) {
+				h_w(0x630, 1u << 27);
+				hr.rx_restart++;
+			}
+		}
+		if (hr_wake_req && lck_mtx_try_lock(hr_txlock)) {
+			if (hr_wake_req) {
+				hr_wake_req = 0;
+				(void)h_tx(&ibs_ack, 1, NULL, 0);
+			}
+			lck_mtx_unlock(hr_txlock);
+		}
+		now = mach_absolute_time();
+		/* commands without an answer for 2 s */
+		lck_mtx_lock(hr_stlock);
+		for (unsigned i = 0; i < 8; i++) {
+			if (hr_out[i].t != 0 && now - hr_out[i].t > two_s) {
+				hr.unanswered++;
+				if (said_out++ < 10) {
+					say("icebt: no Command Complete / Status for %#06x %s within 2 s\n", hr_out[i].op, hr_name(hr_out[i].op));
+				}
+				hr_out[i].t = 0;
+			}
+		}
+		lck_mtx_unlock(hr_stlock);
+		/* bluetoothd's command stream went quiet for 3 s (its init done, or waiting): said with the radio state */
+		if (hr_last_cmd != 0 && now - hr_last_cmd > quiet3s) {
+			if (!quiet && quiet_said < 12) {
+				quiet_said++;
+				say("icebt: bluetoothd's commands quiet since %u s: %u commands so far, %u refused, %u unanswered\n",
+				    hr_sec(hr_last_cmd), hr.h_cmd, hr.refused, hr.unanswered);
+				hr_summary("quiet");
+			}
+			quiet = true;
+		} else if (hr_last_cmd != 0) {
+			quiet = false;
+		}
+		/* summaries: 23bt3 every 30 s for 10 min after the bind, then every 5 min */
+		if (now >= next_sum) {
+			uint64_t step;
+
+			if (next_sum != 0) {
+				char tag[40];
+
+				snprintf(tag, sizeof(tag), "23bt%s +%u s", hr_level == 4 ? "3s" : "3", hr_sec(now - hr_t0));
+				hr_summary(tag);
+				hr_result(tag);
+				sums++;
+			}
+			nanoseconds_to_absolutetime(sums < 20 ? 30000000000ull : 300000000000ull, &step);
+			next_sum = now + step;
+		}
+		/* 23bt3s: the 120 s watch from bluetoothd's first byte */
+		if (hr_level == 4 && hr_first_tx != 0 && !verdict) {
+			uint32_t ws = hr_sec(now - hr_first_tx);
+
+			if (ws >= watch_next) {
+				char tag[40];
+
+				snprintf(tag, sizeof(tag), "23bt3s watch +%u s", ws);
+				hr_summary(tag);
+				watch_next = ws + 10;
+			}
+			if (ws >= 120) {
+				uint32_t uart = hr_uart_errors(), dmg = hr.stray + hr.ev_odd + hr.bufovf + hakios_bt_rx_lost();
+				uint32_t resets = hr.h_reset > 1 ? hr.h_reset - 1 : 0, recon = hakios_bt_connects() > 1 ?
+				    hakios_bt_connects() - 1 : 0;
+				const char *v = hr.hwerr == 0 && hr.tx_fail == 0 && uart == 0 && dmg == 0 && hr.unanswered == 0 &&
+				    resets == 0 && recon == 0 ? "STABLE" : hr.hwerr == 0 && hr.tx_fail == 0 &&
+				    uart + dmg + hr.unanswered + resets + recon <= 3 ? "MARGINAL" : "UNSTABLE";
+
+				verdict = true;
+				hr_result("23bt3s watch end");
+				say("icebt: 23bt3s VERDICT %s: 120 s from bluetoothd's first byte: UART errors %u, TX failed %u, CTS stalls "
+				    "%u, unanswered commands %u, HW errors %u, damaged / lost (stray, odd events, buffer overflow, ring lost) "
+				    "%u, extra HCI_Resets by bluetoothd %u, extra bluetoothd connects %u; %u commands, %u events\n", v, uart,
+				    hr.tx_fail, hr.tx_slow, hr.unanswered, hr.hwerr, dmg, resets, recon, hr.h_cmd, hr.c_ev);
+			}
+		}
+		if (got) {
+			last = now;
+		} else if (now - last > idle) {
+			IOSleep(now - last > quiet1s ? 2 : 1);
+		}
+	}
+}
+
+/* the resident start, at the end of 23h3's bring-up (f4_ok): true = bound (nothing is put back from here on) */
+static bool
+hr_start(int level)
+{
+	static const uint8_t bdaddr[] = { 0x01, 0x09, 0x10, 0x00 };
+	static const uint8_t qca_default[6] = { 0x00, 0x00, 0x00, 0x00, 0x5a, 0xad };   /* display order (btqca.c) */
+	uint8_t a[6];
+	thread_t th;
+	bool zero = true;
+	int st;
+
+	memset(&hb, 0, sizeof(hb));
+	hb_n = 0;
+	h_w(0x644, io_rd(h_se, 0x644) | HB_S_ERR);
+	h_w(0x614, io_rd(h_se, 0x614) | HB_M_ERR);
+	h_w(0x648, HB_S_ERR);
+	h_w(0x618, HB_M_ERR);
+	hb_pump(20000, false);
+	say("icegeni: 23bt%s resident start; %u bytes left over from the download\n", level == 4 ? "3s" : "3", hb.stray + hb.ev);
+	memset(&hb, 0, sizeof(hb));
+	st = hb_step("HCI_Reset", hb_c_reset, (int)sizeof(hb_c_reset), 0);
+	if (st != 0) {
+		return false;
+	}
+	st = hb_cmd(bdaddr, (int)sizeof(bdaddr), 200000);
+	if (st != 0 || hb_rlen < 10) {
+		say("icegeni: 23bt3 Read_BD_ADDR: status %d, %d bytes: not resident\n", st, hb_rlen);
+		return false;
+	}
+	for (int i = 0; i < 6; i++) {
+		a[i] = hb_reply[9 - i];         /* (LSB first on the wire -> display order) */
+		zero = zero && a[i] == 0;
+	}
+	say("icegeni: 23bt3 Read_BD_ADDR: status 0, address **:**:**:**:%02x:%02x (masked)%s\n", a[4], a[5],
+	    zero ? " ALL ZERO" : memcmp(a, qca_default, 6) == 0 ? " = the QCA NVM default (not unit-specific)" : "");
+	if (zero) {
+		return false;                   /* bluetoothd quits on an all-00s address */
+	}
+	{
+		lck_grp_t *grp = lck_grp_alloc_init("icebt", LCK_GRP_ATTR_NULL);
+
+		hr_txlock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+		hr_stlock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+		if (hr_txlock == NULL || hr_stlock == NULL) {
+			return false;
+		}
+	}
+	memset(&hr, 0, sizeof(hr));
+	hr.scan_en = hr.le_scan_type = hr.le_scan_on = hr.le_adv_on = hr.ext_adv_on = -1;
+	hr_level = level;
+	hakios_dada_bt_make_node();             /* (made at kernel start already: a no-op then) */
+	RedwoodBTSetAddress(a);
+	hr_t0 = mach_absolute_time();
+	hakios_bt_bind_uart(hr_tx);
+	if (kernel_thread_start(hr_pump, NULL, &th) != KERN_SUCCESS) {
+		say("icegeni: 23bt3 the pump thread did not start: the transport is bound but deaf\n");
+		return true;                    /* (bound: the engine must stay as it is) */
+	}
+	thread_set_thread_name(th, "icebt-se5-pump");
+	thread_deallocate(th);
+	say("icegeni: 23bt%s RESIDENT at %u s: controller up, address on RedwoodBT, com.apple.uart.sk.bluetooth bound to SE5; "
+	    "nothing put back from here on (bt-enable, gpio16, votes, pads, SE5, S5 RCG stay)\n", level == 4 ? "3s" : "3",
+	    hr_sec(hr_t0));
+	return true;
+}
+
+static void
+h_bt(void)
+{
+	static const uint8_t hci_reset[] = { 0x01, 0x03, 0x0c, 0x00 };
+	static const uint8_t ver[] = { 0x01, 0x00, 0xfc, 0x01, 0x19 };
+	static const uint8_t bid[] = { 0x01, 0x00, 0xfc, 0x01, 0x23 };
+	static const uint8_t ibs_wake[] = { 0xfd };
+	static const uint8_t peri[] = { 0x31, 0x00, 0xf1, 0xff, 0x02, 0x02, 0x11 };
+	static const uint8_t hbaud[] = { 0x01, 0x48, 0xfc, 0x01, 0x11 };
+	uint32_t saved[H_NREGS], vote0 = 0, pad0[4], pull[4] = { 1, 1, 3, 3 };
+	vm_offset_t pad[4], gcc = ml_io_map_unmappable(GCC_PA, 0xb0000, VM_WIMG_IO);
+	int proto, st;
+	bool high = false, ok = true;
+
+	proto = h0_probe(true, &vote0);
+	for (int i = 0; i < 4; i++) {
+		pad[i] = ml_io_map_unmappable(TLMM_PA + 0x1000u * (24 + i), PAGE_SIZE, VM_WIMG_IO);
+		pad0[i] = pad[i] ? io_rd(pad[i], 0) : 0xffffffffu;
+	}
+	if (proto != 2 || gcc == 0 || pad[0] == 0 || pad[1] == 0 || pad[2] == 0 || pad[3] == 0 || h_txdepth == 0 || h_rxdepth < 4 ||
+	    ((pad0[0] | pad0[1] | pad0[2] | pad0[3]) >> 2 & 0xf) != 0) {
+		say("icegeni: 23h REFUSED: protocol %d (UART = 2), pads gpio24-27 ctl %08x %08x %08x %08x (must be function 0), "
+		    "depths %u / %u: nothing written to the SE or the pads\n", proto, pad0[0], pad0[1], pad0[2], pad0[3], h_txdepth,
+		    h_rxdepth);
+		ok = false;
+		goto votes;
+	}
+	/* geni_se_init + FIFO mode (Linux's order), 1 byte per FIFO word, 8N1, CTS ignored, no loopback, 115200 */
+	if (!h_setup(saved, 0)) {
+		ok = false;
+		goto restore;
+	}
+	/* pads to qup3_se5 (function 1), DT bias: 24 CTS / 25 RTS pull-down, 26 TX / 27 RX pull-up, 2 mA */
+	for (int i = 0; i < 4; i++) {
+		*(volatile uint32_t *)pad[i] = (pad0[i] & ~(0xfu << 2) & ~3u & ~(7u << 6) & ~(1u << 9)) | (1u << 2) | pull[i];
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	say("icegeni: 23h SE5 in UART mode at 115200; pads gpio24-27 -> qup3_se5: ctl %08x %08x %08x %08x (found %08x %08x %08x "
+	    "%08x); IOS %08x (CTS in %u)\n", io_rd(pad[0], 0), io_rd(pad[1], 0), io_rd(pad[2], 0), io_rd(pad[3], 0), pad0[0], pad0[1],
+	    pad0[2], pad0[3], io_rd(h_se, 0x908), (io_rd(h_se, 0x908) >> 1) & 1);
+	IOSleep(5);
+	{
+		uint8_t junk[96];
+		int j = h_rx(5000, junk, (int)sizeof(junk));
+		say("icegeni: 23h quiet 5 ms after the mux: %d bytes\n", j);
+	}
+	f4_geni = 1;
+	st = h_cmd("HCI_Reset at 115200", hci_reset, (int)sizeof(hci_reset), 100000, 0x0c03, -1);
+	if (st != 0) {
+		say("icegeni: 23h no HCI_Reset answer over the engine: stopping (the GPIO UART kits remain the route)\n");
+		ok = false;
+		goto restore;
+	}
+	h_cmd("QCA version at 115200", ver, (int)sizeof(ver), 100000, 0xfc00, 0x19);
+	h_cmd("QCA board id at 115200", bid, (int)sizeof(bid), 100000, 0xfc00, 0x23);
+	if (icegeni >= 3) {
+		uint8_t junk[96];
+		int j;
+		/* hci_qca qca_setup for WCN7860: peri_set_baudrate, then qca_set_speed(OPER) */
+		h_cmd("IBS wake 0xfd", ibs_wake, 1, 10000, -1, -1);
+		h_cmd("peripheral baud 3.2M (31 00 f1 ff 02 02 11)", peri, (int)sizeof(peri), 100000, -1, -1);
+		h_w(0x2ac, (1u << 31) | (1u << 1));     /* RFR not ready (flow off while both sides change speed) */
+		if (!h_tx(hbaud, (int)sizeof(hbaud), NULL, 0)) {
+			ok = false;
+			goto restore;
+		}
+		say("icegeni: 23h HCI baud 01 48 fc 01 11 sent\n");
+		IOSleep(5);
+		if (!h_baud(3200000)) {
+			ok = false;
+			goto restore;
+		}
+		h_w(0x2ac, 0);                           /* RFR automatic again */
+		j = h_rx(20000, junk, (int)sizeof(junk));
+		say("icegeni: 23h 20 ms after the switch: %d bytes discarded (hci_qca QCA_DISCARD_RX); IOS %08x (CTS in %u)\n", j,
+		    io_rd(h_se, 0x908), (io_rd(h_se, 0x908) >> 1) & 1);
+		if (!((io_rd(h_se, 0x908) >> 1) & 1)) {
+			h_w(0x25c, 0);                       /* the chip asserts CTS (IO2 low): honour it, as Linux's CRTSCTS */
+			say("icegeni: 23h CTS asserted by the chip: flow control on\n");
+		}
+		st = h_cmd("QCA version at 3.2 Mbaud", ver, (int)sizeof(ver), 100000, 0xfc00, 0x19);
+		if (st != 0) {
+			say("icegeni: 23h no answer at 3.2 Mbaud: stopping\n");
+			ok = false;
+			goto restore;
+		}
+		high = true;
+	}
+	f4_nvm_keepbaud = high;
+	say("icegeni: 23h firmware download over the engine at %s\n", high ? "3.2 Mbaud" : "115200");
+	{
+		uint64_t t0 = mach_absolute_time(), el;
+		f4_download(0, 0, 0);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &el);
+		say("icegeni: 23h download + checks took %llu ms\n", el / 1000000);
+	}
+	{
+		int hci = 0, bt = 0;
+		PE_parse_boot_argn("icegeni_hci", &hci, sizeof(hci));
+		PE_parse_boot_argn("icegeni_bt", &bt, sizeof(bt));
+		if (hci) {
+			h_hci_probe();
+		}
+		if ((bt == 1 || bt == 2) && f4_ok) {
+			h_bt_up(bt);
+		} else if ((bt == 3 || bt == 4) && f4_ok) {
+			/* scan40: resident - on success NOTHING below is done (no put-back of pads, SE5, RCG or the S5 vote) */
+			if (hr_start(bt)) {
+				hr_on = true;
+				f4_geni = 0;
+				f4_nvm_keepbaud = 0;
+				return;
+			}
+			say("icegeni: 23bt%s resident start FAILED: everything put back as 23h\n", bt == 4 ? "3s" : "3");
+		} else if (bt) {
+			say("icegeni: 23bt%d not run: %s\n", bt, f4_ok ? "icegeni_bt must be 1 to 4" :
+			    "the firmware download did not end with its PASS line");
+		}
+	}
+restore:
+	f4_geni = 0;
+	f4_nvm_keepbaud = 0;
+	for (int i = 0; i < 4; i++) {
+		*(volatile uint32_t *)pad[i] = pad0[i];
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	h_restore(saved);
+	say("icegeni: 23h put back: pads %08x %08x %08x %08x, SE5 registers as found (%u)\n", io_rd(pad[0], 0), io_rd(pad[1], 0),
+	    io_rd(pad[2], 0), io_rd(pad[3], 0), (unsigned)H_NREGS);
+votes:
+	if (gcc != 0 && !((vote0 >> 17) & 1)) {
+		*(volatile uint32_t *)(gcc + 0x52018) = vote0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icegeni: gcc 0x52018 put back %08x (read back %08x)\n", vote0, io_rd(gcc, 0x52018));
+	}
+	say("icegeni: 23h %s\n", ok ? "ended (see the 23f4 PASS line)" : "stopped (see above)");
+}
+
+static void
+f3_uart(void)
+{
+	static const uint8_t hci_reset[] = { 0x01, 0x03, 0x0c, 0x00 };
+	static const uint8_t qca_ver[] = { 0x01, 0x00, 0xfc, 0x01, 0x19 };
+	vm_offset_t gcc = ml_io_map_unmappable(GCC_PA, 0xb0000, VM_WIMG_IO);
+	vm_offset_t tx = ml_io_map_unmappable(TLMM_PA + 0x1000u * F3_TX, PAGE_SIZE, VM_WIMG_IO);
+	vm_offset_t rx = ml_io_map_unmappable(TLMM_PA + 0x1000u * F3_RX, PAGE_SIZE, VM_WIMG_IO);
+	uint32_t ctl0, io0, v18, gap = 0;
+	bool on = true;
+
+	if (gcc != 0) {
+		static const uint32_t cbcr[] = { 0x233f0, 0x233f4, 0x233f8, 0x2340c, 0xa8630 };
+		v18 = io_rd(gcc, 0x52018);
+		for (int i = 0; i < 5; i++) {
+			on = on && !(io_rd(gcc, cbcr[i]) >> 31);
+		}
+		say("icespmi: 23f3 QUP wrap3 (reads): vote 0x52018 %08x (m_ahb %u s_ahb %u core %u core2x %u s5 %u); CBCR m_ahb %08x "
+		    "s_ahb %08x core %08x core2x %08x s5 %08x\n", v18, (v18 >> 8) & 1, (v18 >> 9) & 1, (v18 >> 10) & 1, (v18 >> 11) & 1,
+		    (v18 >> 17) & 1, io_rd(gcc, 0x233f0), io_rd(gcc, 0x233f4), io_rd(gcc, 0x233f8), io_rd(gcc, 0x2340c),
+		    io_rd(gcc, 0xa8630));
+		if (on) {
+			vm_offset_t se = ml_io_map_unmappable(0x01994000u, PAGE_SIZE, VM_WIMG_IO);
+			if (se != 0) {
+				say("icespmi: 23f3 SE5 clocks all on: GENI_FW_REVISION_RO %08x (protocol %u; 2 = UART) GENI_STATUS %08x\n",
+				    io_rd(se, 0x68), (io_rd(se, 0x68) >> 8) & 0xff, io_rd(se, 0x40));
+			}
+		} else {
+			say("icespmi: 23f3 SE5 clocks not all on: the serial engine's registers are not read\n");
+		}
+	}
+	if (tx == 0 || rx == 0) {
+		say("icespmi: 23f3 REFUSED: TLMM not mapped\n");
+		return;
+	}
+	ctl0 = io_rd(tx, 0);
+	io0 = io_rd(tx, 4);
+	if (((ctl0 >> 2) & 0xf) != 0 || ((io_rd(rx, 0) >> 2) & 0xf) != 0 || !(io_rd(rx, 4) & 1)) {
+		say("icespmi: 23f3 REFUSED: gpio26 ctl %08x / gpio27 ctl %08x io %08x: not plain GPIOs or the chip's TX not idle "
+		    "high\n", ctl0, io_rd(rx, 0), io_rd(rx, 4));
+		return;
+	}
+	gap = 0;
+	say("icespmi: 23f3 quiet capture: %d edges on RX in 5 ms\n", f3_txrx(tx, rx, io0 | 2u, NULL, 0, 5000, &gap));
+	*(volatile uint32_t *)(tx + 4) = io0 | 2u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(tx + 0) = (ctl0 & ~(0xfu << 2) & ~3u & ~(7u << 6)) | (1u << 9);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icespmi: 23f3 gpio26 (TX) idle high: wrote io %08x ctl %08x, read back ctl %08x io %08x\n", io0 | 2u,
+	    (ctl0 & ~(0xfu << 2) & ~3u & ~(7u << 6)) | (1u << 9), io_rd(tx, 0), io_rd(tx, 4));
+	IOSleep(2);
+	f3_cmd("HCI_Reset", tx, rx, io0 | 2u, hci_reset, (int)sizeof(hci_reset), 30000);
+	IOSleep(20);
+	f3_cmd("QCA version (EDL 0x19)", tx, rx, io0 | 2u, qca_ver, (int)sizeof(qca_ver), 30000);
+	IOSleep(20);
+	if (f3_level_arg >= 5) {
+		/* 23f3b: btqca qca_read_fw_board_id (EDL_GET_BID_REQ_CMD 0x23): bid = data[1] << 8 | data[2] after cresp / rtype
+		 * -> the NVM file qca/brhbtnv20.b<bid> (else brhbtnv20.bin); and EDL_GET_BUILD_INFO (0x20, a string) */
+		static const uint8_t qca_bid[] = { 0x01, 0x00, 0xfc, 0x01, 0x23 };
+		static const uint8_t qca_build[] = { 0x01, 0x00, 0xfc, 0x01, 0x20 };
+		f3_cmd("QCA board id (EDL 0x23)", tx, rx, io0 | 2u, qca_bid, (int)sizeof(qca_bid), 30000);
+		IOSleep(20);
+		f3_cmd("QCA build info (EDL 0x20)", tx, rx, io0 | 2u, qca_build, (int)sizeof(qca_build), 30000);
+		IOSleep(20);
+	}
+	if (f3_level_arg >= 6) {
+		f4_download(tx, rx, io0 | 2u);
+		IOSleep(20);
+	}
+	f3_cmd("HCI_Reset again", tx, rx, io0 | 2u, hci_reset, (int)sizeof(hci_reset), 30000);
+	/* undo: output off first, then the value */
+	*(volatile uint32_t *)(tx + 0) = ctl0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(tx + 4) = io0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icespmi: 23f3 gpio26 put back: ctl %08x io %08x (as found %08x %08x)\n", io_rd(tx, 0), io_rd(tx, 4), ctl0, io0);
+}
+
+static void
+f2_bt(void)
+{
+	int sub = f2_rd(0x8c05, NULL), mode = f2_rd(0x8c40, NULL), vin = f2_rd(0x8c41, NULL), pull = f2_rd(0x8c42, NULL);
+	int src = f2_rd(0x8c44, NULL), outc = f2_rd(0x8c45, NULL), en = f2_rd(0x8c46, NULL);
+	bool ok;
+
+	say("icespmi: 23f2 as found (APID %d): SUBTYPE %02x MODE_CTL %02x DIG_VIN %02x DIG_PULL %02x DIG_OUT_SRC %02x "
+	    "DIG_OUT_CTL %02x EN_CTL %02x\n", f2_apid, (uint32_t)sub & 0xff, (uint32_t)mode & 0xff, (uint32_t)vin & 0xff,
+	    (uint32_t)pull & 0xff, (uint32_t)src & 0xff, (uint32_t)outc & 0xff, (uint32_t)en & 0xff);
+	f2_pins("before");
+	if (sub != 0x12 || en != 0x80 || mode != 0 || vin < 0 || pull < 0 || src < 0) {
+		say("icespmi: 23f2 REFUSED: not an enabled LV_VIN2 GPIO left as an input (or a read failed): nothing written\n");
+		return;
+	}
+	ok = f2_wr("DIG_VIN_CTL (power-source 1)", 0x8c41, 1) &&
+	    f2_wr("DIG_PULL_CTL (bias-disable)", 0x8c42, 5) &&
+	    f2_wr("MODE_CTL (digital output, low)", 0x8c40, 1);
+	if (ok) {
+		IOSleep(10);
+		ok = f2_wr("LV_MV_DIG_OUT_SOURCE_CTL (bt-enable HIGH)", 0x8c44, (uint8_t)(0x80 | (src & 0x0f)));
+	}
+	if (ok) {
+		say("icespmi: 23f2 bt-enable HIGH (pmh0104 GPIO 5 -> WCN7860 BT_EN): holding 3 s\n");
+		IOSleep(50);
+		f2_pins("+50 ms");
+		IOSleep(450);
+		f2_pins("+500 ms");
+		if (icegeni == 2 || icegeni == 3) {
+			h_bt();
+			f2_pins("after 23h");
+			if (hr_on) {
+				/* scan40 (23bt3): the controller is resident - bt-enable stays HIGH, the pad as set */
+				say("icespmi: 23f2 bt-enable stays HIGH: the BT controller is resident (23bt3), not put back\n");
+				return;
+			}
+		} else if (f3_level_arg >= 4) {
+			f3_uart();
+			f2_pins("after 23f3");
+		}
+		IOSleep(2500);
+		f2_pins("+3 s");
+	} else {
+		say("icespmi: 23f2: a write was not done or read back differently: undoing\n");
+	}
+	/* undo: output low first (as pwrseq power-off), then the pad as found */
+	f2_wr("LV_MV_DIG_OUT_SOURCE_CTL (as found: low)", 0x8c44, (uint8_t)src);
+	IOSleep(10);
+	f2_wr("MODE_CTL (as found)", 0x8c40, (uint8_t)mode);
+	f2_wr("DIG_PULL_CTL (as found)", 0x8c42, (uint8_t)pull);
+	f2_wr("DIG_VIN_CTL (as found)", 0x8c41, (uint8_t)vin);
+	say("icespmi: 23f2 put back: MODE_CTL %02x DIG_VIN %02x DIG_PULL %02x DIG_OUT_SRC %02x (found %02x %02x %02x %02x)\n",
+	    (uint32_t)f2_rd(0x8c40, NULL) & 0xff, (uint32_t)f2_rd(0x8c41, NULL) & 0xff, (uint32_t)f2_rd(0x8c42, NULL) & 0xff,
+	    (uint32_t)f2_rd(0x8c44, NULL) & 0xff, (uint32_t)mode, (uint32_t)vin, (uint32_t)pull, (uint32_t)src);
+	f2_pins("after");
+	say("icespmi: 23f2 %s\n", ok ? "PASS (bt-enable driven high 3 s and put back)" : "FAILED (put back)");
+}
+
+static void
+spmi_probe(int level)
+{
+	vm_offset_t core = ml_io_map_unmappable(0x0c400000u, 0x3000, VM_WIMG_IO);
+	vm_offset_t map = ml_io_map_unmappable(0x0c403000u, 0x8000, VM_WIMG_IO);
+	vm_offset_t own = ml_io_map_unmappable(0x0c42a000u, 0x8000, VM_WIMG_IO);
+	int apid = -1, said = 0;
+
+	if (core == 0 || map == 0 || own == 0) {
+		say("icespmi: not mapped\n");
+		return;
+	}
+	say("icespmi: arbiter version %08x\n", io_rd(core, 0));
+	for (uint32_t n = 0; n < 0x2000; n++) {
+		uint32_t v = io_rd(map, 4 * n);
+		uint32_t a = v & 0xfff, b = (v >> 8) & 0xfff;
+		if (v == 0) {
+			continue;
+		}
+		if (((a >> 8) == 9 || (b >> 8) == 9) && said++ < 24) {
+			say("icespmi: apid %u: map %08x (ppid %03x / %03x) owner %08x\n", n, v, a, b, io_rd(own, 4 * n));
+		}
+		if ((a == 0x98c || b == 0x98c) && apid < 0) {
+			apid = (int)n;
+		}
+	}
+	if (apid < 0) {
+		say("icespmi: PPID 0x98c (SID 9 GPIO 5) not in the channel map\n");
+		return;
+	}
+	say("icespmi: SID 9 GPIO 5 (0x8c00) = APID %d, map %08x, owner EE %u (%08x)\n", apid, io_rd(map, 4 * apid),
+	    io_rd(own, 4 * apid) & 7, io_rd(own, 4 * apid));
+	if (level < 2) {
+		return;
+	}
+	vm_offset_t obs = ml_io_map_unmappable(0x0c4c0000u + 0x20u * (uint32_t)apid - ((0x20u * (uint32_t)apid) & 0xfffu),
+	    PAGE_SIZE, VM_WIMG_IO);
+	if (obs == 0) {
+		return;
+	}
+	obs += (0x20u * (uint32_t)apid) & 0xfffu;
+	if (level >= 3) {
+		f3_level_arg = level;
+		f2_resolve(core, map);
+		return;
+	}
+	static const struct { const char *name; uint16_t addr; } regs[] = {
+		{ "SUBTYPE", 0x8c05 }, { "STATUS1", 0x8c08 }, { "MODE_CTL", 0x8c40 }, { "DIG_VIN", 0x8c41 },
+		{ "DIG_PULL", 0x8c42 }, { "DIG_OUT_SRC", 0x8c44 }, { "DIG_OUT", 0x8c45 }, { "EN_CTL", 0x8c46 },
+	};
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		uint32_t cmd = 1u << 27 | (uint32_t)(regs[i].addr & 0xff) << 4 | 0;
+		int t;
+		*(volatile uint32_t *)(obs + 0x0) = cmd;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (t = 0; t < 100 && !(io_rd(obs, 0x8) & 1); t++) {
+			delay(10);
+		}
+		say("icespmi: observer read %s %#x: cmd %08x -> status %08x data %02x\n", regs[i].name, regs[i].addr, cmd,
+		    io_rd(obs, 0x8), io_rd(obs, 0x18) & 0xff);
+	}
+}
