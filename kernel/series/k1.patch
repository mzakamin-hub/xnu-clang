@@ -0,0 +1,547 @@
+/*
+ * Copyright (c) 2026 The iceland macOS port. All rights reserved.
+ *
+ * PSCI SYSTEM_RESET and SYSTEM_OFF for the platform expert's halt/restart path (q41, q41b), and the two ways an
+ * unattended run ends in a reset instead of a hang (K2).
+ *
+ * IOPlatformExpert::haltRestart() calls PE_halt_restart, which nothing set, so a panic's "MACH Reboot" (and any
+ * reboot(2)) fell through to the loader and the machine sat there. This registers a handler that asks the firmware,
+ * the way the platform's own PSCI node says to: SYSTEM_RESET (0x84000009) for a restart, SYSTEM_OFF (0x84000008)
+ * for a halt, over the conduit the device tree names in /psci's "method" property ("hvc" on QEMU's virt machine,
+ * "smc" on the tablet).
+ *
+ * The loader's /chosen/psci-method wins when it is present: under Qualcomm's hypervisor the same calls are made
+ * with HVC and the loader is the one that knows (osfmk/arm64/psci_smp.c trusts it for CPU_ON/CPU_OFF for the same
+ * reason). Nothing here hardcodes a conduit, and the handler is only registered when the device tree has a PSCI
+ * node or the loader named a conduit; with neither, PE_halt_restart stays NULL and the old fallback applies.
+ *
+ * K2 (chain plan 11.4, review F10). Both boot-args are off by default, and off nothing changes.
+ *
+ *   psci-panic-reset=<seconds>  (q41b's bool, now a time: =1 waits 1 s)
+ *     A panic ends in a reset. Once the panic has printed (its text has gone to the console: the panel's vc-text
+ *     screen, and the loader's ring that the host reads while the kernel runs), the panicking processor names the
+ *     panic once more, keeps it on the screen for <seconds>, then calls PSCI SYSTEM_RESET. It acts at the end of the
+ *     panic path, osfmk/kern/debug.c's kdp_machine_reboot_type() and panic_spin_forever(), before the panic would go
+ *     back to the loader: with it set, a panic does not return to the loader (it did not get the tablet back: the
+ *     loader's timed return never fires after a panic, and on DarwinBoot there is no loader).
+ *
+ *   reset-after=<seconds>
+ *     A one-shot timer, armed here at early boot as loader_return_after's is (loader_return.c), that fires <seconds>
+ *     later: the run's orderly end (the GPU, the Wi-Fi DSP and the audio DSP stopped, as loader_return_after's end
+ *     does, less its data-volume save, which is a storage write), then PSCI SYSTEM_RESET from that thread.
+ *     Precedence: loader_return_after=N (N > 0) with a loader listening (it patched the XNULDRST return slot,
+ *     loader_stub_slot[1], start.s: the U-Boot/loader route) owns the end of the run, and reset-after is not
+ *     armed. With no loader to return to (DarwinBoot/UniXNU: the slot stays 0 and loader_return() comes straight
+ *     back), reset-after arms even when loader_return_after is in the line. psci-panic-reset has no such rule.
+ *
+ * Neither depends on the other processors. SYSTEM_RESET resets the whole system from whichever core calls it
+ * (PSCI 1.1, 5.10); nothing here signals, waits for or hands over to another core. The panic path has already
+ * stopped them (the panic's debugger entry), or they were never started; the timer runs on any core.
+ *
+ * Provenance: reset-after follows piano's k27 0056 (piano-reset-after=<s>; PIANO 613a209 and PIANO-E ea12db1,
+ * patches/k27/0056-k27-piano-reset-after-s-PSCI-reset-after-N-seconds-Gunyah-wa.patch, the same blob) in
+ * behaviour only. It is written fresh: piano's repository has no LICENSE (review F10a), and its Gunyah watchdog
+ * arming and pets (0056) and PMIC SDAM restart reason (0057) are hardware writes this kernel does not make. UniXNU
+ * (dff2765) has no kernel equivalent: its timed reset is a binary patch at kernel entry (scripts/patch-xnu-entry-probe.py).
+ *
+ * If the firmware returns, the caller's own fallback runs (halt_all_cpus() hands control back to the loader; a
+ * panic goes on as it did before K2; reset-after lets the run go on).
+ *
+ * A3 (reenter_uboot.c, boot-arg reenter-uboot=): when U-Boot stashed itself before UniXNU and the kernel armed the
+ * stash, both ends go back into U-Boot with no reset instead, so the log comes back with them. reset-after's timer
+ * then ends in loader_return() (the other cores off, the drivers stopped) and the jump; a panic keeps
+ * psci-panic-reset's hold and then goes on to loader_return() (osfmk/kern/debug.c), which ends in the jump. If the
+ * jump cannot be made, reenter_uboot_now() asks for the PSCI reset itself (psci_halt_reset_quiet()).
+ *
+ * w0 (25 Nov, gains plan 0.3): icewdt=1, the Gunyah watchdog; see icewdt_init() below.
+ */
+
+#include <kern/startup.h>
+#include <kern/misc_protos.h>
+#include <kern/debug.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <IOKit/IOPlatformExpert.h>
+
+#define PSCI_SYSTEM_OFF         0x84000008u
+#define PSCI_SYSTEM_RESET       0x84000009u
+
+/* q41b, K2: a panic resets only when asked, after this many seconds with the panic on screen (0: never) */
+static TUNABLE(uint32_t, psci_panic_reset, "psci-panic-reset", 0);
+/* K2: an orderly reset this many seconds after early boot (0: never) */
+static TUNABLE(uint32_t, psci_reset_after, "reset-after", 0);
+
+extern uint64_t loader_stub_slot[4];    /* start.s: [1] is the loader's return stub, 0 when no loader listens */
+extern void redwood_adreno_stop(void);
+extern void redwood_wifi_stop(void);
+extern void redwood_adsp_stop(void);
+void psci_panic_reset_wait(void);
+#if defined(XNU_TARGET_OS_OSX)
+extern void hakios_iceland_dpu_panic_show(void);        /* bsd/dev/hakios_iceland_dpu.c (dpu-direct=1) */
+#endif
+void psci_halt_reset_quiet(void);
+/* reenter_uboot.c (A3) */
+extern bool reenter_uboot_armed(void);
+extern void reenter_uboot_reason(uint32_t reason);
+extern void reenter_uboot_from_thread(uint32_t reason);
+#define REENTER_UBOOT_REASON_RESET_AFTER 1u
+#define REENTER_UBOOT_REASON_PANIC      2u
+
+static int psci_halt_hvc;       /* 1 = HVC, 0 = SMC */
+
+static int
+psci_halt_call(uint32_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	if (psci_halt_hvc) {
+		__asm__ volatile ("hvc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3) :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+		    "cc", "memory");
+	} else {
+		__asm__ volatile ("smc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3) :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+		    "cc", "memory");
+	}
+	return (int)x0;
+}
+
+/*
+ * w0: icewdt=1, the hypervisor's watchdog. A hang of this kernel (no heartbeat for 30 s) resets the tablet through
+ * Gunyah, with nobody at the power key, and the boot chain then starts its default system.
+ *
+ * Sheng's way, in behaviour only (written fresh; the piano/sheng device repository has no LICENSE, review F10a):
+ * research/refs/piano-macos-code002-2026-11-23 (e9ff4f0) package/BootResetCore.h:26-28 (the four calls, 30000 ms,
+ * enable 3 / disable 2), BootReset.c:133-182 (status probe, set time, enable, a ping every 10 s, a deadline after which
+ * the pings stop, a stop flag), BootLog.c:3035-3050 (armed at EARLY_BOOT; the deadline is the run's timed end + 30 s)
+ * and BootLog.c:2951-2955 (a panic stops the pings). The older sheng-forks-2026-11-14 main (1108068) BootReset.c:104-137
+ * is the same with 60 s. The SMCCC facts are also the owner's Linux's (linux a2e1ea44d3c3
+ * drivers/watchdog/gunyah_wdt.c:14-22 vendor hypervisor fast calls 0x86000005 control, 6 status, 7 ping, 8 set time;
+ * :31-32 control 3 on, 2 off; :34-38 0 ok, -1 not implemented; :117-121 status x2 = ms since the last ping; :189-194
+ * at most 32 s).
+ *
+ * The calls go over this file's PSCI conduit: "smc" on the tablet, as sheng and Linux make them; "hvc" on QEMU's
+ * virt machine, whose PSCI emulation answers every other function NOT_SUPPORTED, so there icewdt says so once and
+ * does nothing. The pings ride on the kernel's 10 s heartbeat (loader_return.c hv_wdt_pet() -> icewdt_beat()), a
+ * thread call: a kernel whose timers and thread calls no longer run is a hung kernel, and 30 s later it is reset.
+ *
+ *   off      no icewdt=1 on the line (not built in), no PSCI conduit, or a status other than 0.
+ *   timed    with reset-after=<s> armed, the pings stop <s> + 30 s after boot (sheng: autoreset + 30): a run whose
+ *            orderly end hung is reset 30 s later.
+ *   test     icewdt_test=<s> (a test line only): the pings stop <s> s after boot, as if the kernel hung there; the
+ *            hypervisor's reset 30 s later is the proof (the forced-hang run). It wins over reset-after's deadline.
+ *   panic    the processor that panicked pings once more when the panic ends (psci_panic_reset_wait()) and never
+ *            again: the panic stays readable for 30 s, then the hypervisor resets. psci-panic-reset=<s> (s < 30)
+ *            still resets first, its own way. Sheng stops at the panic without that last ping (20 to 30 s).
+ *   disarmed (control 2) right before our PSCI SYSTEM_RESET or SYSTEM_OFF, and before a loader or U-Boot takes the
+ *            machine back (psci_panic_reset_wait() with A3, reset-after's A3 end, loader_return()): nothing pings there.
+ */
+#define ICEWDT_CONTROL          0x86000005u
+#define ICEWDT_STATUS           0x86000006u
+#define ICEWDT_PING             0x86000007u
+#define ICEWDT_SET_TIME         0x86000008u
+#define ICEWDT_ENABLE           3u
+#define ICEWDT_DISABLE          2u
+#define ICEWDT_TIMEOUT_MS       30000u          /* Gunyah takes at most 32000 */
+
+/* the one writable word (8 B): 0 not armed or stopped, UINT64_MAX armed for good ("until 0 s"), else until this mach time */
+static uint64_t icewdt_until;
+
+void icewdt_beat(void);
+bool icewdt_stop(bool disarm);
+static int psci_halt_restart(unsigned int type);
+
+/* an SMCCC 1.1 call with two arguments over the PSCI conduit; x0 (an int) and x2 come back */
+static int32_t
+icewdt_call(uint32_t fn, uint64_t a1, uint64_t a2, uint64_t *r2)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = 0;
+
+	if (psci_halt_hvc) {
+		__asm__ volatile ("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+		    "cc", "memory");
+	} else {
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17",
+		    "cc", "memory");
+	}
+	if (r2 != NULL) {
+		*r2 = x2;
+	}
+	return (int32_t)x0;
+}
+
+/* every heartbeat (loader_return.c hv_wdt_pet, 10 s): a ping while armed */
+void
+icewdt_beat(void)
+{
+	uint64_t until = __atomic_load_n(&icewdt_until, __ATOMIC_RELAXED);
+
+	if (until == 0) {
+		return;
+	}
+	if (until != UINT64_MAX && mach_absolute_time() >= until) {
+		__atomic_store_n(&icewdt_until, 0, __ATOMIC_RELAXED);
+		printf("icewdt: the pings end here (icewdt_test, or reset-after + 30 s): reset in 30 s\n");
+		return;
+	}
+	(void)icewdt_call(ICEWDT_PING, 0, 0, NULL);
+}
+
+/* the pings end: disarm (control 2) or one last ping. No line: any context (a panic, the cross-call of loader_return()). */
+bool
+icewdt_stop(bool disarm)
+{
+	if (__atomic_exchange_n(&icewdt_until, 0, __ATOMIC_RELAXED) == 0) {
+		return false;
+	}
+	(void)icewdt_call(disarm ? ICEWDT_CONTROL : ICEWDT_PING, disarm ? ICEWDT_DISABLE : 0, 0, NULL);
+	return true;
+}
+
+static void
+icewdt_init(bool timed)
+{
+	uint32_t on = 0, test = 0, end = 0;
+	uint64_t since = 0, until = UINT64_MAX;
+	int32_t status, set = 0, enable = 0;
+
+	if (!PE_parse_boot_argn("icewdt", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (PE_halt_restart != psci_halt_restart) {
+		printf("icewdt: no PSCI conduit: off\n");
+		return;
+	}
+	status = icewdt_call(ICEWDT_STATUS, 0, 0, &since);
+	if (status != 0) {
+		printf("icewdt: Gunyah watchdog status %d over %s: not supported, off\n", status, psci_halt_hvc ? "hvc" : "smc");
+		return;
+	}
+	(void)icewdt_call(ICEWDT_CONTROL, ICEWDT_DISABLE, 0, NULL);
+	set = icewdt_call(ICEWDT_SET_TIME, ICEWDT_TIMEOUT_MS, ICEWDT_TIMEOUT_MS, NULL);
+	if (set == 0) {
+		enable = icewdt_call(ICEWDT_CONTROL, ICEWDT_ENABLE, 0, NULL);
+	}
+	if (set != 0 || enable != 0) {
+		printf("icewdt: set time %d, enable %d: not armed\n", set, enable);
+		return;
+	}
+	if (PE_parse_boot_argn("icewdt_test", &test, sizeof(test)) && test != 0) {
+		end = test;                     /* the forced-hang test: the pings stop here */
+	} else if (timed) {
+		end = psci_reset_after + 30;
+	}
+	if (end != 0) {
+		clock_interval_to_deadline(end, NSEC_PER_SEC, &until);
+	}
+	__atomic_store_n(&icewdt_until, until, __ATOMIC_RELAXED);
+	printf("icewdt: Gunyah watchdog over %s (last ping %llu ms ago): armed %u ms, a ping every 10 s (until %u s%s)\n",
+	    psci_halt_hvc ? "hvc" : "smc", (unsigned long long)since, ICEWDT_TIMEOUT_MS, end, test != 0 ? ": icewdt_test" : "");
+}
+
+static int
+psci_halt_restart(unsigned int type)
+{
+	uint32_t fn;
+
+	switch (type) {
+	case kPEPanicRestartCPU:
+		if (psci_panic_reset == 0) {
+			return -1;      /* the loader keeps the panic on screen; psci-panic-reset=<s> opts in */
+		}
+		fn = PSCI_SYSTEM_RESET;
+		break;
+	case kPERestartCPU:
+		/* haltRestart() turns a panic's restart into this one on arm64; the panic state still tells them apart. */
+		if (panic_active() && psci_panic_reset == 0) {
+			return -1;
+		}
+		fn = PSCI_SYSTEM_RESET;
+		break;
+	case kPEHaltCPU:
+		fn = PSCI_SYSTEM_OFF;
+		break;
+	default:
+		return -1;
+	}
+
+	printf("psci: %s (0x%08x) over %s%s\n",
+	    fn == PSCI_SYSTEM_RESET ? "SYSTEM_RESET" : "SYSTEM_OFF", fn, psci_halt_hvc ? "hvc" : "smc",
+	    icewdt_stop(true) ? "; icewdt disarmed" : "");
+	(void)psci_halt_call(fn);
+	return -1;      /* only if the firmware refused; halt_all_cpus() falls back to the loader */
+}
+
+/* K2: the panic's own line ("panic(cpu N caller ...): ...") once more, last on the screen for the photo */
+static void
+psci_panic_reset_reason(void)
+{
+	char line[200];
+	const char *p, *end;
+	size_t n = 0;
+
+	if (debug_buf_base == NULL || debug_buf_ptr <= debug_buf_base) {
+		return;
+	}
+	end = debug_buf_ptr - debug_buf_base > 64 * 1024 ? debug_buf_base + 64 * 1024 : debug_buf_ptr;
+	for (p = debug_buf_base; p + 9 <= end && strncmp(p, "panic(cpu", 9) != 0; p++) {
+		;
+	}
+	if (p + 9 > end) {
+		return;
+	}
+	while (p < end && *p != '\n' && n < sizeof(line) - 1) {
+		line[n++] = (*p >= 32 && *p < 127) ? *p : '?';
+		p++;
+	}
+	line[n] = '\0';
+	printf("psci-panic-reset: %s\n", line);
+}
+
+/*
+ * K2: the last line ("... firing ...") is given this long to reach the console feed before the reset (the host and
+ * QEMU's pollers read the ring and the message buffer a few times a second; piano's 0056 waits 200 ms).
+ */
+#define PSCI_LAST_LINE_MS       1000u
+
+/* a busy wait on the timebase: a panicked processor, interrupts off, nothing to block on */
+static void
+psci_panic_reset_spin(uint64_t ms)
+{
+	uint64_t interval, deadline;
+
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &interval);
+	deadline = mach_absolute_time() + interval;
+	while (mach_absolute_time() < deadline) {
+		__asm__ volatile ("yield" ::: "memory");
+	}
+}
+
+/*
+ * K2: psci-panic-reset=<s>, from the end of the panic path (osfmk/kern/debug.c) on the processor that panicked,
+ * interrupts off, before the panic would go back to the loader. Unset, or with no PSCI conduit, it returns at once
+ * and the panic ends as before. It returns only if the firmware does not reset.
+ */
+void
+psci_panic_reset_wait(void)
+{
+	static uint32_t entered;
+	bool a3 = reenter_uboot_armed();
+
+#if defined(XNU_TARGET_OS_OSX)
+	hakios_iceland_dpu_panic_show();        /* dpu-direct: the pipes back on the panel memory first, so the panic shows */
+#endif
+	/* w0 icewdt: U-Boot takes over (A3): disarmed; else one last ping, and the hypervisor resets 30 s from now */
+	if (icewdt_stop(a3)) {
+		printf("icewdt: %s\n", a3 ? "disarmed (U-Boot is next)" : "last ping: the hypervisor resets in 30 s");
+	}
+
+	if (psci_panic_reset == 0 || PE_halt_restart != psci_halt_restart) {
+		if (a3) {
+			reenter_uboot_reason(REENTER_UBOOT_REASON_PANIC);       /* loader_return() next: back into U-Boot */
+		}
+		return;
+	}
+	if (__atomic_fetch_add(&entered, 1, __ATOMIC_RELAXED) != 0) {
+		/* a panic during the wait, or a nested panic's bailout: no second wait */
+		printf("psci-panic-reset: firing again (PSCI SYSTEM_RESET)\n");
+		(void)psci_halt_call(PSCI_SYSTEM_RESET);
+		return;
+	}
+	psci_panic_reset_reason();
+	printf("psci-panic-reset: the panic stays on the screen for %u s, then %s\n", psci_panic_reset,
+	    a3 ? "reenter-uboot" : "PSCI SYSTEM_RESET");
+	psci_panic_reset_spin((uint64_t)psci_panic_reset * 1000);
+	if (a3) {
+		/* A3: the caller (osfmk/kern/debug.c) goes on to loader_return(), which ends in reenter_uboot_now() */
+		printf("psci-panic-reset: firing (reenter-uboot)\n");
+		reenter_uboot_reason(REENTER_UBOOT_REASON_PANIC);
+		psci_panic_reset_spin(PSCI_LAST_LINE_MS);
+		return;
+	}
+	printf("psci-panic-reset: firing (PSCI SYSTEM_RESET)\n");
+	psci_panic_reset_spin(PSCI_LAST_LINE_MS);
+	PE_sync_panic_buffers();        /* the panic region written back first, as XNU's own panic restart does */
+	(void)psci_halt_restart(kPEPanicRestartCPU);
+	printf("psci-panic-reset: the firmware did not reset; the panic ends as before\n");
+}
+
+/* A3: PSCI SYSTEM_RESET from a context that may not print (interrupts off); returns only if there is none */
+void
+psci_halt_reset_quiet(void)
+{
+	if (PE_halt_restart == psci_halt_restart) {
+		(void)psci_halt_call(PSCI_SYSTEM_RESET);
+	}
+}
+
+/* K2: reset-after=<s> */
+static void
+psci_reset_after_fire(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	bool a3 = reenter_uboot_armed();
+
+	printf("reset-after: %u s reached: the run's end (GPU, Wi-Fi, audio DSP stopped), then %s\n",
+	    psci_reset_after, a3 ? "reenter-uboot" : "PSCI SYSTEM_RESET");
+	redwood_adreno_stop();          /* a GPU kept for the system is given back while there is a thread to wait in */
+	redwood_wifi_stop();            /* and the Wi-Fi DSP, if it runs, shut down */
+	redwood_adsp_stop();            /* and the audio DSP */
+	{
+		extern void hakios_iceland_adsp_stop(void);     /* bsd/dev/hakios_iceland_adsp.c (icedsp=) */
+
+		hakios_iceland_adsp_stop();     /* the iceland one: its clients, GLINK, the DSP, then banks 8 / 7 */
+	}
+#if defined(XNU_TARGET_OS_OSX)
+	{
+		extern void hakios_iceland_pcie_stop(void);     /* bsd/dev/hakios_iceland_pcie.c (icepcie_lx=1) */
+		extern void hakios_iceland_bt_stop(void);       /* bsd/dev/hakios_iceland_bt.c (icebt=N) */
+
+		hakios_iceland_bt_stop();       /* the Bluetooth stage ended, uart18 and bt-enable put back as found */
+		hakios_iceland_pcie_stop();     /* the ath12k driver stopped, PCIe0 and the WCN7860 put back as found */
+	}
+	{
+		extern void hakios_iceland_dpu_stop(void);      /* bsd/dev/hakios_iceland_dpu.c (dpu-direct=1) */
+
+		hakios_iceland_dpu_stop();      /* the pipes back on the panel memory, the display's SMMU bank as found */
+	}
+	{
+		/*
+		 * w3-power: with disp-sleep=1 the render server may have turned the display off (the backlight off, BACKLIGHT_ENABLE 0
+		 * on both KTZ8869): the backlight goes back on at its kept level before the jump, so U-Boot and the next kit are
+		 * seen. ENODEV (nothing written) unless icebl>=2 found the ICs.
+		 */
+		extern int hakios_iceland_backlight_power(int on);     /* bsd/dev/hakios_iceland_backlight.c */
+		unsigned int dsleep = 0;
+
+		if (PE_parse_boot_argn("disp-sleep", &dsleep, sizeof(dsleep)) && (dsleep == 1 || dsleep == 2)) {
+			if (dsleep == 2) {   /* the panel too was put to sleep by DCS: sleep-out and display-on first (nothing if on) */
+				extern int hakios_iceland_dsi_panel(int on);     /* bsd/dev/hakios_iceland_dsi.c (25hot1) */
+
+				printf("reset-after: disp-sleep: the panel on (%d)\n", hakios_iceland_dsi_panel(1));
+			}
+			printf("reset-after: disp-sleep: the backlight on at its kept level (%d)\n", hakios_iceland_backlight_power(1));
+		}
+	}
+	{
+		extern int hakios_iceland_backlight_restore(void);    /* bsd/dev/hakios_iceland_backlight.c (icebl=2) */
+
+		(void)hakios_iceland_backlight_restore();     /* w3-keys: the backlight's level and on/off as found */
+	}
+#endif
+	if (a3) {
+		if (icewdt_stop(true)) {
+			printf("icewdt: disarmed (U-Boot is next)\n");
+		}
+		printf("reset-after: firing (reenter-uboot)\n");
+		delay_for_interval(PSCI_LAST_LINE_MS, NSEC_PER_MSEC);
+		/* the other cores off, the drivers stopped, the jump; if it cannot be made, the PSCI reset (quietly) */
+		reenter_uboot_from_thread(REENTER_UBOOT_REASON_RESET_AFTER);
+		for (;;) {
+			__builtin_arm_wfi();    /* neither happened: interrupts may be off, so no line; stay out of the way */
+		}
+	}
+	printf("reset-after: firing (PSCI SYSTEM_RESET)\n");
+	delay_for_interval(PSCI_LAST_LINE_MS, NSEC_PER_MSEC);
+	/*
+	 * Interrupts stay on: the handler prints its own line, and console output with interrupts off outside a
+	 * panic is itself a panic ("Console I/O from interrupt-disabled context", serial_console.c; K2 run timer60).
+	 * Nothing has to be held off for the call: SYSTEM_RESET does not return when it works.
+	 */
+	(void)psci_halt_restart(kPERestartCPU);
+	printf("reset-after: the firmware did not reset; the run goes on\n");
+}
+
+static bool
+psci_reset_after_init(void)
+{
+	uint32_t lra = 0;
+	uint64_t deadline;
+	thread_call_t call;
+
+	if (psci_reset_after == 0) {
+		return false;
+	}
+	if (PE_halt_restart != psci_halt_restart) {
+		printf("reset-after: not armed: no PSCI conduit\n");
+		return false;
+	}
+	if (PE_parse_boot_argn("loader_return_after", &lra, sizeof(lra)) && lra != 0 && loader_stub_slot[1] != 0) {
+		printf("reset-after: not armed: loader_return_after=%u and a loader to return to own the end of the run\n", lra);
+		return false;
+	}
+	call = thread_call_allocate_with_options(psci_reset_after_fire, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH,
+	    THREAD_CALL_OPTIONS_ONCE);
+	clock_interval_to_deadline(psci_reset_after, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+	if (reenter_uboot_armed()) {
+		printf("reset-after: armed %u s (then reenter-uboot)\n", psci_reset_after);
+		return true;
+	}
+	printf("reset-after: armed %u s (then PSCI SYSTEM_RESET over %s%s)\n", psci_reset_after,
+	    psci_halt_hvc ? "hvc" : "smc", lra != 0 ? "; loader_return_after has no loader to return to" : "");
+	return true;
+}
+
+/* true when node/name says HVC */
+static bool
+psci_halt_method(const char *node, const char *name)
+{
+	DTEntry entry;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, node, &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, name, &prop, &size) != kSuccess ||
+	    size < 3) {
+		return false;
+	}
+	return strncmp((const char *)prop, "hvc", 3) == 0;
+}
+
+static void
+psci_halt_init(void)
+{
+	DTEntry psci;
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+	bool have_psci = SecureDTLookupEntry(NULL, "/psci", &psci) == kSuccess;
+	bool have_method = SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "psci-method", &prop, &size) == kSuccess && size >= 3;
+
+	if (!have_psci && !have_method) {
+		printf("psci: no /psci node and no /chosen/psci-method; PE_halt_restart left NULL\n");
+		if (psci_panic_reset != 0) {
+			printf("psci-panic-reset: not armed: no PSCI conduit\n");
+		}
+		(void)psci_reset_after_init();
+		icewdt_init(false);     /* says "no PSCI conduit" when asked for */
+		return;
+	}
+	/* /psci is the binding's own answer; the loader's /chosen/psci-method overrides it when it is there. */
+	if (have_psci) {
+		psci_halt_hvc = psci_halt_method("/psci", "method");
+	}
+	if (have_method) {
+		psci_halt_hvc = strncmp((const char *)prop, "hvc", 3) == 0;
+	}
+	PE_halt_restart = psci_halt_restart;
+	printf("psci: reset and power off over %s (PE_halt_restart set; panic reset %s)\n",
+	    psci_halt_hvc ? "hvc" : "smc", psci_panic_reset ? "on" : "off");
+	if (psci_panic_reset != 0) {
+		printf("psci-panic-reset: armed %u s (a panic stays on the screen that long, then PSCI SYSTEM_RESET)\n",
+		    psci_panic_reset);
+	}
+	icewdt_init(psci_reset_after_init());
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, psci_halt_init);
diff --git a/osfmk/arm64/psci_smp.c b/osfmk/arm64/psci_smp.c
new file mode 100644
index 0000000000000000000000000000000000000000..abca80a29184b0096a0befe7917c26d127713bed
--- /dev/null
+++ b/osfmk/arm64/psci_smp.c
@@ -0,0 +1,517 @@
+/*
+ * More than one processor on generic (non-Apple) ARMv8 boards.
+ *
+ * On Apple hardware the other cores are powered up by closed drivers. Here
+ * the firmware does it, through the standard power interface of ARM systems
+ * (PSCI): CPU_ON starts a core at an address of the caller's choice, CPU_OFF
+ * stops the calling core for good. The address we give is the kernel's own
+ * reset vector (LowResetVectorBase in start.s), so that a new core takes the
+ * path Apple's cores take: it finds its cpu data by its MPIDR, turns the MMU
+ * on and comes out in arm_init_cpu(). The calls are made with SMC or, under
+ * a hypervisor that implements them itself, with HVC; the boot loader says
+ * which (/chosen/psci-method).
+ *
+ * The platform expert (iokit/Kernel/GenericARMPE.cpp) registers the cores of
+ * the device tree and starts them here, one after the other. Signals between
+ * processors are interrupts of the GIC (gic_v3_irq.c).
+ *
+ * A new core begins with its MMU and caches off, and what it reads then it
+ * reads from memory. On real hardware that is not the same as what the
+ * running processors see: under Qualcomm's hypervisor (the phone this was
+ * written for) a line that is dirty in another core's cache is simply not
+ * there yet. QEMU has no cache and shows none of this. So before CPU_ON
+ * everything that core will read before its MMU is on is written back to
+ * memory (psci_smp_start_cpu()), and what it writes in that state is read
+ * only after throwing away the reader's cached copy.
+ *
+ * The other half is the way out. The kernel ends by returning to the boot
+ * loader (loader_return.c), and the loader gets back only what it started:
+ * one core, the boot processor's. psci_smp_stop_others() makes every other
+ * core switch itself off first, wherever it is.
+ */
+#include <mach/mach_types.h>
+#include <kern/clock.h>
+#include <kern/cpu_number.h>
+#include <kern/debug.h>
+#include <kern/kalloc.h>
+#include <kern/misc_protos.h>
+#include <libkern/kernel_mach_header.h>
+#include <machine/atomic.h>
+
+#include <kern/processor.h>
+
+/*
+ * The boot processor's number. (Not redwood's master_cpu: nothing sets it in this kernel, it stays -1,
+ * and with it the boot processor took itself for another core at the return to the loader.)
+ */
+static inline int
+psci_smp_boot_cpu(void)
+{
+	return master_processor->cpu_id;
+}
+#include <arm/caches_internal.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/cpu_internal.h>
+#include <arm/machine_routines.h>
+#include <arm64/proc_reg.h>
+#include <arm64/psci_smp.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm64/board_config.h>
+#include <vm/pmap.h>
+
+#if defined(GENERIC_PSCI_SMP)
+
+#define PSCI_CPU_OFF            0x84000002u
+#define PSCI_CPU_ON             0xC4000003u
+#define PSCI_AFFINITY_INFO      0xC4000004u
+#define PSCI_AFFINITY_OFF       1
+
+#define PSCI_SMP_START_SECONDS  5       /* how long a started core is waited for */
+#define PSCI_SMP_STOP_SECONDS   3       /* ... and the cores that were told to stop */
+
+extern void loader_return(void);
+extern void loader_log_putc(char c);
+extern unsigned long gVirtBase, gPhysBase;
+
+/* The firmware is called with HVC, not SMC. (start.s reads this too, at its physical address.) */
+uint32_t psci_smp_hvc;
+
+/*
+ * hakios: where the loader wants the other cores started (/chosen/hakios,secondary-entry), 0 if
+ * nowhere in particular. Its code puts the pointer-authentication keys in place first -- under
+ * Qualcomm's hypervisor the kernel's own writes to those registers do not take -- and goes on to the
+ * address given as the CPU_ON context, the kernel's reset vector.
+ */
+static uint64_t psci_smp_loader_entry;
+
+/*
+ * hakios: the loader's own core as the kernel's last processor (loader boot-arg joincore=1; /chosen
+ * hakios,join-box = the physical address of this box). PSCI cannot start a core that is running, and the
+ * loader runs on it, watching: the kernel asks in the box instead, and the loader enters the kernel's
+ * reset vector on that core the way a core started by the firmware would (secondary_cpu_entry). Where
+ * every other core switches itself off (psci_smp_cpu_off()), that one goes back into the loader (the
+ * box's "back": loader_return_stub), which watches again and takes the boot processor's return.
+ */
+struct psci_join_box {
+	uint64_t request;       /* ours: 1 = start that core */
+	uint64_t entry;         /* ours: the CPU_ON context (the reset vector's physical address) */
+	uint64_t back;          /* the loader's: where that core goes back to */
+	uint64_t state;         /* the loader's: 0 waiting, 1 joining, 2 declined, 3 back */
+	uint64_t mpidr;         /* the loader's: that core */
+	uint64_t pac_seen, pac_want, spare;
+};
+static uint64_t psci_join_pa;                   /* 0: no such core */
+static volatile struct psci_join_box *psci_join_box;
+static uint32_t psci_join_mpidr = UINT32_MAX;
+extern void loader_core_back(uint64_t stub);    /* loader_return.c */
+
+static bool
+psci_smp_is_join_core(uint32_t phys_id)
+{
+	return psci_join_box != NULL && phys_id == psci_join_mpidr;
+}
+
+/*
+ * Left by a core that took an exception between its first instruction and the kernel's vectors
+ * (Lsecondary_early_exception in start.s). That core writes it with its cache off; it has a
+ * cache line to itself so that looking at memory does not disturb anything else.
+ */
+struct psci_smp_start_fault {
+	uint64_t valid, mpidr, esr, elr, far, lr, sp, unused;
+} psci_smp_start_fault __attribute__((aligned(64)));
+_Static_assert(sizeof(struct psci_smp_start_fault) == 64, "one cache line");
+
+static uint32_t psci_smp_cpu_stage[MAX_CPUS];   /* PSCI_SMP_CPU_*, by cpu number */
+static uint32_t psci_smp_started;               /* a bit per core that CPU_ON was granted for */
+
+static int      psci_smp_stop_owner = -1;       /* the processor that began the return to the boot loader */
+static bool     psci_smp_boot_wanted;           /* it was not the boot processor: that one is to finish */
+static bool     psci_smp_boot_busy;             /* ... and has begun to */
+static bool     psci_smp_stopping;              /* every other core switches itself off */
+
+static int64_t
+psci_call(uint64_t function, uint64_t arg1, uint64_t arg2, uint64_t arg3)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	register uint64_t x1 __asm__("x1") = arg1;
+	register uint64_t x2 __asm__("x2") = arg2;
+	register uint64_t x3 __asm__("x3") = arg3;
+
+	if (psci_smp_hvc) {
+		__asm__ volatile ("hvc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+                    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17");
+	} else {
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+                    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17");
+	}
+	return (int64_t)x0;
+}
+
+static const char *
+psci_error(int64_t status)
+{
+	static const char *const names[] = {
+		"success", "not supported", "invalid parameters", "denied", "already on", "on pending",
+		"internal failure", "not present", "disabled", "invalid address",
+	};
+
+	return (status <= 0 && status > -(int64_t)(sizeof(names) / sizeof(names[0]))) ? names[-status] : "?";
+}
+
+void
+psci_smp_init(void)
+{
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "psci-method", &prop, &size) == kSuccess &&
+	    size >= 3 && strncmp((const char *)prop, "hvc", 3) == 0) {
+		psci_smp_hvc = 1;
+	}
+	{
+		extern void loader_log_line(const char *line);
+		char line[120];
+		int found = SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+		    SecureDTGetProperty(chosen, "hakios,secondary-entry", &prop, &size) == kSuccess;
+
+		if (found && size == sizeof(uint64_t)) {
+			memcpy(&psci_smp_loader_entry, prop, sizeof(psci_smp_loader_entry));
+		}
+		snprintf(line, sizeof(line), "hakios: psci_smp_init: secondary-entry %s, size %u, 0x%llx\n",
+		    found ? "found" : "not found", found ? size : 0, psci_smp_loader_entry);
+		loader_log_line(line);
+		if (SecureDTGetProperty(chosen, "hakios,join-box", &prop, &size) == kSuccess && size == sizeof(uint64_t)) {
+			memcpy(&psci_join_pa, prop, sizeof(psci_join_pa));
+		}
+	}
+}
+
+/* (from psci_smp_start_cpu(): the VM is up by then) */
+static void
+psci_smp_join_map(void)
+{
+	vm_offset_t page;
+
+	if (psci_join_pa == 0 || psci_join_box != NULL || (psci_join_pa & 63) != 0) {
+		return;
+	}
+	page = ml_io_map(psci_join_pa & ~(uint64_t)PAGE_MASK, PAGE_SIZE);      /* uncached: the loader cleans and flushes */
+	if (page == 0) {
+		return;
+	}
+	psci_join_box = (volatile struct psci_join_box *)(page + (psci_join_pa & PAGE_MASK));
+	psci_join_mpidr = (uint32_t)psci_join_box->mpidr;
+	printf("psci: the loader's core (MPIDR 0x%x) can join as the last processor; its way back 0x%llx\n",
+	    psci_join_mpidr, psci_join_box->back);
+}
+
+/* A processor other than the boot processor says how far it has come. */
+void
+psci_smp_cpu_reached(uint32_t stage)
+{
+	os_atomic_store(&psci_smp_cpu_stage[cpu_number()], stage, release);
+}
+
+/* ... all the way: from GenericARMCPU::initCPU(), where the scheduler takes it. */
+void
+psci_smp_cpu_running(void)
+{
+	psci_smp_cpu_reached(PSCI_SMP_CPU_RUNNING);
+}
+
+static void
+psci_smp_clean_segment(const char *name)
+{
+	unsigned long size = 0;
+	vm_offset_t start = (vm_offset_t)getsegdatafromheader(&_mh_execute_header, name, &size);
+
+	if (start != 0 && size != 0) {
+		CleanPoC_DcacheRegion(start, size);
+	}
+}
+
+/*
+ * Start a registered processor: the platform's half of cpu_start(). Waits until the core has
+ * joined the scheduler, and says what became of it if it has not: on a phone the log is all
+ * there is to go by.
+ */
+kern_return_t
+psci_smp_start_cpu(int cpu)
+{
+	cpu_data_t *cdp = cpu_datap(cpu);
+	uint32_t phys_id = cdp->cpu_phys_id, stage;
+	uint64_t entry = ml_static_vtop((vm_offset_t)&LowResetVectorBase);
+	uint64_t now, deadline;
+	int64_t status;
+	static bool psci_smp_init_done;
+
+	/* (psci_smp_init() is not on every way here: read /chosen once, whoever starts the first core) */
+	if (!psci_smp_init_done) {
+		psci_smp_init_done = true;
+		psci_smp_init();
+	}
+	psci_smp_join_map();
+
+	/*
+	 * What that core reads with its MMU off: the code and the page tables of start.s, and what
+	 * the reset vector finds its way by (ResetHandlerData, CpuDataEntries, the boot arguments,
+	 * cpu_ttep, psci_smp_hvc ...), all of it in the kernel's own segments; and the cpu data of
+	 * every processor, which the reset vector goes through looking for its own.
+	 * Clean, not flush: the processors that are running keep using all of it.
+	 */
+	psci_smp_start_fault.valid = 0;
+	psci_smp_clean_segment("__TEXT");
+	psci_smp_clean_segment("__DATA_CONST");
+	psci_smp_clean_segment("__TEXT_EXEC");
+	psci_smp_clean_segment("__DATA");
+	psci_smp_clean_segment("__BOOTDATA");
+	for (int other = 0; other <= ml_get_max_cpu_number(); other++) {
+		if (cpu_datap(other) != NULL) {
+			CleanPoC_DcacheRegion((vm_offset_t)cpu_datap(other), sizeof(cpu_data_t));
+		}
+	}
+	__builtin_arm_dsb(DSB_SY);
+
+	os_atomic_store(&psci_smp_cpu_stage[cpu], PSCI_SMP_CPU_ASKED, release);
+	{
+		extern void loader_log_line(const char *line);
+		char line[120];
+		snprintf(line, sizeof(line), "hakios: psci CPU_ON cpu %d (MPIDR 0x%x) at 0x%llx, kernel entry 0x%llx\n", cpu,
+		    phys_id, psci_smp_loader_entry ? psci_smp_loader_entry : entry, entry);
+		loader_log_line(line);
+	}
+	if (psci_smp_is_join_core(phys_id)) {
+		/* the loader's core: asked in the box, not of the firmware (that core is running: the loader) */
+		psci_join_box->entry = entry;
+		__builtin_arm_dsb(DSB_SY);
+		psci_join_box->request = 1;
+		__builtin_arm_dsb(DSB_SY);
+		__builtin_arm_sev();
+		status = 0;
+	} else if (psci_smp_loader_entry != 0) {
+		status = psci_call(PSCI_CPU_ON, phys_id, psci_smp_loader_entry, entry);
+	} else {
+		status = psci_call(PSCI_CPU_ON, phys_id, entry, 0);
+	}
+	if (status != 0) {
+		os_atomic_store(&psci_smp_cpu_stage[cpu], 0, release);
+		printf("psci: cpu %d (MPIDR 0x%x) was not started: the firmware answers %lld (%s)\n",
+		    cpu, phys_id, status, psci_error(status));
+		return KERN_FAILURE;
+	}
+	os_atomic_or(&psci_smp_started, 1u << cpu, relaxed);
+
+	clock_interval_to_deadline(PSCI_SMP_START_SECONDS, NSEC_PER_SEC, &deadline);
+	do {
+		stage = os_atomic_load(&psci_smp_cpu_stage[cpu], acquire);
+		if (stage >= PSCI_SMP_CPU_RUNNING) {
+			return KERN_SUCCESS;
+		}
+		if (psci_smp_is_join_core(phys_id) && psci_join_box->state == 2) {
+			printf("psci: cpu %d (MPIDR 0x%x, the loader's core) declined to join: its PAC check gave 0x%llx, "
+			    "the other cores 0x%llx\n", cpu, phys_id, psci_join_box->pac_seen, psci_join_box->pac_want);
+			os_atomic_store(&psci_smp_cpu_stage[cpu], 0, release);
+			os_atomic_andnot(&psci_smp_started, 1u << cpu, relaxed);
+			return KERN_FAILURE;
+		}
+		/* memory, not this processor's copy of it */
+		FlushPoC_DcacheRegion((vm_offset_t)&psci_smp_start_fault, sizeof(psci_smp_start_fault));
+		if (psci_smp_start_fault.valid != 0) {
+			break;
+		}
+		delay_for_interval(1, NSEC_PER_MSEC);
+		now = mach_absolute_time();
+	} while (now < deadline);
+
+	if (psci_smp_start_fault.valid != 0) {
+		struct psci_smp_start_fault *f = &psci_smp_start_fault;
+		uint64_t to_virtual = gVirtBase - gPhysBase;
+
+		printf("psci: cpu %d (MPIDR 0x%llx) took an exception on its way in and has switched itself off: "
+		    "ESR 0x%llx ELR 0x%llx FAR 0x%llx LR 0x%llx SP 0x%llx (ELR and LR as kernel addresses: 0x%llx 0x%llx)\n",
+		    cpu, f->mpidr, f->esr, f->elr, f->far, f->lr, f->sp, f->elr + to_virtual, f->lr + to_virtual);
+		os_atomic_andnot(&psci_smp_started, 1u << cpu, relaxed);        /* nothing of it is left to stop */
+	} else {
+		printf("psci: cpu %d (MPIDR 0x%x) was started %d seconds ago and has not joined: %s\n",
+		    cpu, phys_id, PSCI_SMP_START_SECONDS,
+		    stage >= PSCI_SMP_CPU_IN_KERNEL ? "it got as far as arm_init_cpu()" : "no sign of it since the firmware took the request");
+	}
+	return KERN_FAILURE;
+}
+
+/*
+ * The calling processor switches itself off. Its interrupted work, if any, is abandoned where
+ * it was: only for the end of the system.
+ */
+void
+psci_smp_cpu_off(void)
+{
+	__builtin_arm_wsr("DAIFSet", DAIFSC_ALL);
+	/* leave nothing behind that would interrupt a core that is no longer there */
+	__builtin_arm_wsr64("CNTV_CTL_EL0", CNTV_CTL_EL0_IMASKED);
+	gic_v3_irq_cpu_shutdown();
+	if (psci_smp_is_join_core((uint32_t)getCpuDatap()->cpu_phys_id)) {
+		/* the loader's core: back to the loader, which watches again (stage OFF: the boot processor need not wait) */
+		os_atomic_store(&psci_smp_cpu_stage[cpu_number()], PSCI_SMP_CPU_OFF, release);
+		__builtin_arm_dsb(DSB_SY);
+		loader_core_back(psci_join_box->back);
+		for (;;) {
+			__builtin_arm_wfi();    /* (no way back: it stays out of the way) */
+		}
+	}
+	os_atomic_store(&psci_smp_cpu_stage[cpu_number()], PSCI_SMP_CPU_OFF, release);
+	__builtin_arm_dsb(DSB_SY);
+
+	(void) psci_call(PSCI_CPU_OFF, 0, 0, 0);
+	for (;;) {
+		__builtin_arm_wfi();    /* the firmware refused: stay out of the way all the same */
+	}
+}
+
+static void
+psci_smp_note(const char *what, int cpu)
+{
+	static const char prefix[] = "\npsci: cpu ";
+
+	for (const char *c = prefix; *c; c++) {
+		loader_log_putc(*c);
+	}
+	loader_log_putc((char)('0' + cpu));
+	for (const char *c = what; *c; c++) {
+		loader_log_putc(*c);
+	}
+}
+
+/* Tell every core but this one to switch itself off (psci_smp_stop_here() is where they hear it). */
+static void
+psci_smp_stop_rest(void)
+{
+	int me = cpu_number(), max_cpu = ml_get_max_cpu_number();
+
+	os_atomic_store(&psci_smp_stopping, true, release);
+	__builtin_arm_dsb(DSB_SY);
+	for (int cpu = 0; cpu <= max_cpu; cpu++) {
+		cpu_data_t *cdp = cpu_datap(cpu);
+
+		if (cpu != me && cdp != NULL && (cpu == psci_smp_boot_cpu() || (psci_smp_started & (1u << cpu)))) {
+			gic_v3_irq_signal_stop(cdp->cpu_phys_id);
+		}
+	}
+	/* for those that wait with their interrupts off (wait_while_mp_kdp_trap(), after a panic) */
+	__builtin_arm_sev();
+}
+
+/*
+ * The system is going back to the boot loader (loader_return()). Returns on the boot processor
+ * only, once the other cores are off -- or have been given up on. On any other processor it
+ * does not return: that one hands the job to the boot processor, which the loader's side of
+ * the return belongs to, and switches itself off like the rest.
+ */
+void
+psci_smp_stop_others(void)
+{
+	int me, max_cpu;
+	uint64_t now, deadline;
+
+	if (psci_smp_started == 0) {
+		return;                 /* there is only this one */
+	}
+	__builtin_arm_wsr("DAIFSet", DAIFSC_ALL);
+	me = cpu_number();
+	max_cpu = ml_get_max_cpu_number();
+	if (!os_atomic_cmpxchg(&psci_smp_stop_owner, -1, me, acq_rel) && psci_smp_stop_owner != me && me != psci_smp_boot_cpu()) {
+		psci_smp_cpu_off();     /* another processor is at it already */
+	}
+
+	if (me != psci_smp_boot_cpu()) {
+		/*
+		 * Nobody is stopped before the boot processor has answered: a core that is switched
+		 * off while it holds a lock the boot processor is waiting for would take the return
+		 * with it.
+		 */
+		psci_smp_note(" ends the system: the return to the boot loader is the boot processor's to make\n", me);
+		os_atomic_store(&psci_smp_boot_wanted, true, release);
+		__builtin_arm_dsb(DSB_SY);
+		gic_v3_irq_signal_stop(cpu_datap(psci_smp_boot_cpu())->cpu_phys_id);
+		__builtin_arm_sev();
+		now = mach_absolute_time();
+		nanoseconds_to_absolutetime(PSCI_SMP_STOP_SECONDS * NSEC_PER_SEC, &deadline);
+		deadline += now;
+		while (!os_atomic_load(&psci_smp_stopping, acquire) && now < deadline) {
+			now = mach_absolute_time();
+		}
+		if (!os_atomic_load(&psci_smp_stopping, acquire)) {
+			/*
+			 * It does not hear (stuck with its interrupts off). There is no return without
+			 * it; a loader that watches from its own core will find the kernel silent and
+			 * take the log as it is, and so this goes into the log.
+			 */
+			psci_smp_note(" cannot return to the boot loader and the boot processor does not answer: all cores stop here\n", me);
+			psci_smp_stop_rest();
+		}
+		psci_smp_cpu_off();
+	}
+
+	psci_smp_stop_rest();
+	now = mach_absolute_time();
+	nanoseconds_to_absolutetime(PSCI_SMP_STOP_SECONDS * NSEC_PER_SEC, &deadline);
+	deadline += now;
+	for (int cpu = 0; cpu <= max_cpu; cpu++) {
+		cpu_data_t *cdp = cpu_datap(cpu);
+
+		if (cpu == me || cdp == NULL || !(psci_smp_started & (1u << cpu))) {
+			continue;
+		}
+		while (now < deadline) {
+			if (os_atomic_load(&psci_smp_cpu_stage[cpu], acquire) == PSCI_SMP_CPU_OFF &&
+			    psci_smp_is_join_core(cdp->cpu_phys_id)) {
+				break;          /* the loader's core: gone back to the loader, which the firmware sees as on */
+			}
+			if (os_atomic_load(&psci_smp_cpu_stage[cpu], acquire) == PSCI_SMP_CPU_OFF) {
+				/* it has said it is going; the firmware knows when it has gone (if it can tell at all) */
+				int64_t state = psci_call(PSCI_AFFINITY_INFO, cdp->cpu_phys_id, 0, 0);
+
+				if (state == PSCI_AFFINITY_OFF || state < 0) {
+					break;
+				}
+			}
+			now = mach_absolute_time();
+		}
+		if (os_atomic_load(&psci_smp_cpu_stage[cpu], acquire) != PSCI_SMP_CPU_OFF &&
+		    (psci_smp_is_join_core(cdp->cpu_phys_id) ||
+		    psci_call(PSCI_AFFINITY_INFO, cdp->cpu_phys_id, 0, 0) != PSCI_AFFINITY_OFF)) {
+			psci_smp_note(" did not stop: it is left running\n", cpu);
+		}
+	}
+}
+
+/*
+ * Where a processor learns that the system is ending: the interrupt psci_smp_stop_rest() sends,
+ * and the loop in which the processors wait while another one panics (they have their
+ * interrupts off there). Comes back if there is nothing of the kind going on.
+ */
+void
+psci_smp_stop_here(void)
+{
+	if (psci_smp_started == 0) {
+		return;
+	}
+	if (cpu_number() != psci_smp_boot_cpu()) {
+		if (os_atomic_load(&psci_smp_stopping, acquire)) {
+			psci_smp_cpu_off();
+		}
+		return;
+	}
+	if (os_atomic_load(&psci_smp_boot_wanted, acquire) && !psci_smp_boot_busy) {
+		psci_smp_boot_busy = true;
+		loader_return();        /* stops the rest (psci_smp_stop_others()); back only if no loader listens */
+		for (;;) {
+			__builtin_arm_wfi();
+		}
+	}
+}
+
+#endif /* defined(GENERIC_PSCI_SMP) */
diff --git a/osfmk/arm64/psci_smp.h b/osfmk/arm64/psci_smp.h
