+++ b/iokit/Native/IcelandHid/NativeIcelandHid.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland input step 1-2: a keyboard (and consumer keys) for macOS 27.3 with no keyboard hardware behind it: an IOHIDDevice
+// of the 26C5035r collection's own IOHIDFamily, whose reports IcelandHidProbe.cpp makes from the PC's lines on the USB
+// console and from the tablet's side keys.
+//
+// Provenance:
+// - The class is UniXNU-piano 1c11b0d package/PianoDwc3/PianoDwc3.cpp:2164-2380 (PianoUsbHID and what feeds it, BSD-2-Clause-Patent), itself
+//   macOS-DroidVM 11ac316 overlay/kext/DroidVMInput/DroidVMInput.cpp's DroidVMHIDDevice (piano's package/PianoInput/UPSTREAM):
+//   the same overrides (the report descriptor, transport, manufacturer, product, vendor and product IDs, location ID, primary
+//   usage pair) and the LED output report taken and dropped. One device here (piano has a keyboard and a pointer), our own
+//   names and IDs, and the LED report is counted (IcelandHidProbe.cpp).
+// - The way it is built in is this tree's NullEthernet (sheng 1108068's ShengEthernet; sheng 6880068
+//   scripts/build-gop-legacy-display-27.py:397-490 does the same for its NativeHidInput): Apple's published IOKit/hid headers
+//   as a build input outside the tree (iokit/conf/Makefile.template NATIVE_IOHID_INCLUDE), so every IOHIDDevice virtual keeps
+//   its real name and pointer-authentication discriminator; the family's instance size asserted; the vtable checked slot by
+//   slot against the collection's (sheng scripts/hid-device-26C5035r.json, 334 slots; gen_bindings.py); the family symbols
+//   bound to the collection (native_hid_*_26C5035r.s); the metaclass made late, after IOHIDFamily has loaded.
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+#if defined(XNU_TARGET_OS_OSX) && XNU_TARGET_OS_OSX
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-anon-enum-enum-conversion"
+#pragma clang diagnostic ignored "-Wdocumentation"
+#include <IOKit/hid/IOHIDDevice.h>
+#pragma clang diagnostic pop
+#include "IcelandHidReports.h"
+
+// The subclass is allocated with the size these headers give; the build passes the collection's (sheng's fixture).
+static_assert(sizeof(IOHIDDevice) == NATIVE_HID_DEVICE_SIZE, "IOHIDDevice as the collection has it");
+
+extern "C" {
+IOService *native_iceland_hid_allocate(void);
+IOService *native_iceland_hid_allocate_pointer(void);
+bool native_iceland_hid_is_pointer(IOService *device);
+IOService *native_iceland_hid_allocate_touch(void);
+bool native_iceland_hid_is_touch(IOService *device);
+IOService *native_iceland_hid_allocate_sensor(void);
+bool native_iceland_hid_is_sensor(IOService *device);
+IOReturn native_iceland_hid_send(IOService *device, const uint8_t *bytes, uint32_t length);
+void native_iceland_hid_led_observed(uint32_t leds, uint32_t bytes);   // IcelandHidProbe.cpp
+}
+
+// One class, two devices (input step 3): the keyboard, and with fPointer the touch screen's absolute pointer (piano has a
+// class for each; here the overrides - and so the vtable and the family symbols bound in native_hid_*_26C5035r.s - stay
+// exactly the keyboard's, and each answers for the device it is).
+class NativeIcelandHid : public IOHIDDevice {
+	OSDeclareDefaultStructors(NativeIcelandHid)
+
+public:
+	bool fPointer = false;             // set right after the allocation, before init and start
+	bool fTouch = false;               // input step 4 (w4-touch): the touch screen as a digitizer; never with fPointer
+	bool fSensor = false;              // w4-sensors: the motion sensor; never with fPointer or fTouch
+
+	IOReturn
+	newReportDescriptor(IOMemoryDescriptor **descriptor) const override
+	{
+		*descriptor = fSensor
+		    ? IOBufferMemoryDescriptor::withBytes(icelandhid::kSensorDescriptor, sizeof(icelandhid::kSensorDescriptor), kIODirectionNone)
+		    : fTouch
+		    ? IOBufferMemoryDescriptor::withBytes(icelandhid::kTouchDescriptor, sizeof(icelandhid::kTouchDescriptor), kIODirectionNone)
+		    : fPointer
+		    ? IOBufferMemoryDescriptor::withBytes(icelandhid::kPointerDescriptor, sizeof(icelandhid::kPointerDescriptor), kIODirectionNone)
+		    : IOBufferMemoryDescriptor::withBytes(icelandhid::kDescriptor, sizeof(icelandhid::kDescriptor), kIODirectionNone);
+		return *descriptor ? kIOReturnSuccess : kIOReturnNoMemory;
+	}
+	OSString *newTransportString() const override { return OSString::withCString(fPointer || fTouch || fSensor ? "SPI" : "USB"); }
+	// Never "Apple" on the digitizer: the collection's AppleMultitouchDriver personality "AppleMultitouchHIDService (0x0D,0x04)"
+	// takes a Touch Screen interface of that manufacturer and then expects Apple's multitouch protocol.
+	OSString *newManufacturerString() const override { return OSString::withCString("iceland"); }
+	OSString *newProductString() const override { return OSString::withCString(fPointer || fTouch ? "Iceland Touch Screen" : fSensor ? "Iceland Motion Sensors" : "Iceland Console Keyboard"); }
+	OSNumber *newVendorIDNumber() const override { return OSNumber::withNumber(fPointer || fTouch || fSensor ? icelandhid::kVendorId : icelandhid::keyboardVendorId(), 32); }
+	OSNumber *newProductIDNumber() const override { return OSNumber::withNumber(fSensor ? icelandhid::kSensorProductId : fTouch ? icelandhid::kTouchProductId : fPointer ? icelandhid::kPointerProductId : icelandhid::kProductId, 32); }
+	OSNumber *newLocationIDNumber() const override { return OSNumber::withNumber(fSensor ? 0x49480003u : fTouch ? 0x49480002u : fPointer ? 0x49480001u : 0x49480000u, 32); }
+	OSNumber *newPrimaryUsagePageNumber() const override { return OSNumber::withNumber(fSensor ? 0x20 : fTouch ? 0x0d : 1, 32); }   // Sensor : Digitizer : Generic Desktop
+	OSNumber *newPrimaryUsageNumber() const override { return OSNumber::withNumber(fSensor ? 0x73 : fTouch ? 4 : fPointer ? 2 : 6, 32); }   // Accelerometer 3D : Touch Screen : Mouse : Keyboard
+	// The keyboard's LED report (Caps Lock and the rest): taken, so macOS sees no error, and counted: it is macOS's own
+	// answer to a Caps Lock press, the one sign in the kernel log that a typed key reached the HID event system.
+	IOReturn
+	setReport(IOMemoryDescriptor *report, IOHIDReportType reportType, IOOptionBits options) override
+	{
+		if (!report || reportType != kIOHIDReportTypeOutput || fPointer || fTouch || fSensor) {
+			return kIOReturnUnsupported;
+		}
+		uint8_t bytes[2] = {};
+		const IOByteCount length = report->getLength();
+		report->readBytes(0, bytes, length < sizeof(bytes) ? length : sizeof(bytes));
+		native_iceland_hid_led_observed(length >= 2 ? bytes[1] : bytes[0], (uint32_t)length);
+		return kIOReturnSuccess;
+	}
+};
+
+OSDefineMetaClassAndStructors(NativeIcelandHid, IOHIDDevice)
+
+IOService *
+native_iceland_hid_allocate(void)
+{
+	return OSTypeAlloc(NativeIcelandHid);
+}
+
+IOService *
+native_iceland_hid_allocate_pointer(void)
+{
+	NativeIcelandHid *hid = OSTypeAlloc(NativeIcelandHid);
+	if (hid) {
+		hid->fPointer = true;
+	}
+	return hid;
+}
+
+IOService *
+native_iceland_hid_allocate_touch(void)
+{
+	NativeIcelandHid *hid = OSTypeAlloc(NativeIcelandHid);
+	if (hid) {
+		hid->fTouch = true;
+	}
+	return hid;
+}
+
+IOService *
+native_iceland_hid_allocate_sensor(void)
+{
+	NativeIcelandHid *hid = OSTypeAlloc(NativeIcelandHid);
+	if (hid) {
+		hid->fSensor = true;
+	}
+	return hid;
+}
+
+bool
+native_iceland_hid_is_pointer(IOService *device)
+{
+	NativeIcelandHid *hid = OSDynamicCast(NativeIcelandHid, device);
+	return hid && hid->fPointer;
+}
+
+bool
+native_iceland_hid_is_touch(IOService *device)
+{
+	NativeIcelandHid *hid = OSDynamicCast(NativeIcelandHid, device);
+	return hid && hid->fTouch;
+}
+
+bool
+native_iceland_hid_is_sensor(IOService *device)
+{
+	NativeIcelandHid *hid = OSDynamicCast(NativeIcelandHid, device);
+	return hid && hid->fSensor;
+}
+
+// One input report to the family (IOHIDDevice::handleReport, through the vtable: the collection's own entry).
+IOReturn
+native_iceland_hid_send(IOService *device, const uint8_t *bytes, uint32_t length)
+{
+	NativeIcelandHid *hid = OSDynamicCast(NativeIcelandHid, device);
+	if (!hid) {
+		return kIOReturnNotAttached;
+	}
+	IOBufferMemoryDescriptor *report = IOBufferMemoryDescriptor::withBytes(bytes, length, kIODirectionNone);
+	const IOReturn result = report ? hid->handleReport(report) : kIOReturnNoMemory;
+	OSSafeReleaseNULL(report);
+	return result;
+}
