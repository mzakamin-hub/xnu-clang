+				 * name the vnode and its volume, and keep the error */
+				const char *nm = vnode_getname(vp);
+				mount_t mp = vnode_mount(vp);
+				snprintf(desc, desclen, "%s on %s (vn_getpath %d)",
+				    nm != NULL ? nm : "?",
+				    mp != NULL ? mp->mnt_vfsstat.f_mntonname : "?",
+				    err);
+				if (nm != NULL) {
+					vnode_putname(nm);
+				}
+			} else {
