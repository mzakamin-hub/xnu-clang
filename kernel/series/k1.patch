+
+/* The boot processor's CPU number; arm_init() assigns it from ml_get_boot_cpu_number(). */
+int master_cpu = -1;
+
+/* Not production-fused: this is a bring-up/development board. */
+boolean_t
+ml_device_is_prod_fused(void)
+{
+	return FALSE;
+}
+
+/* Jetsam critical-pressure thresholds; memorystatus_init() recomputes both at boot. */
+unsigned int memorystatus_available_pages_critical = 0;
+unsigned int memorystatus_available_pages_critical_base = 0;
diff --git a/osfmk/arm64/reenter_uboot.c b/osfmk/arm64/reenter_uboot.c
new file mode 100644
index 0000000000000000000000000000000000000000..1128adc083f2072462a13604b79b4c3e71bcde1a
--- /dev/null
+++ b/osfmk/arm64/reenter_uboot.c
@@ -0,0 +1,645 @@
+/*
+ * Copyright (c) 2026 The iceland macOS port. All rights reserved.
+ *
+ * reenter-uboot (A3: chain plan 11.4 and review A3, for owner decision O17): the end of an unattended run goes back
+ * into our U-Boot with no reset, so that RAM, and the kernel's log in it, is kept.
+ *
+ * Why. On the UniXNU route (U1: our U-Boot -> UniXNU.efi -> DarwinBoot -> this kernel) nothing returns: DarwinBoot
+ * calls ExitBootServices and never comes back, so loader_return()'s stub slot (start.s, XNULDRST) stays 0, and no
+ * RAM survives a reset on this tablet, cold or warm (chain plan 11.5, 11.6). K2's reset-after brings the tablet back
+ * to Fedora, but without a line of the kernel's log.
+ *
+ * How. Before it starts UniXNU, U-Boot's U1 mode (iceland-u-boot 0027, cmd/a3_stash.c) fills a "stash" at a fixed,
+ * reserved physical address outside DarwinBoot's window (the tablet: ABL's 129 MiB bank at 0x8b0000000, which no
+ * window can take): a header, a copy of U-Boot's own image as ABL loaded it, and a copy of the device tree ABL handed
+ * it. At the end of the run (reset-after=, a panic, a halt) this kernel stops its other processors and its drivers
+ * (loader_return()), cleans its memory to the point of coherency, writes its log into the stash, turns its MMU off
+ * and enters the copy of U-Boot the way ABL does: at EL1, MMU and caches off, interrupts masked, x0 = the device
+ * tree. U-Boot finds the log in the stash (a3_stash check), puts it into its console record and serves it over
+ * fastboot (`fastboot oem console`); the PC then says `fastboot reboot` (ABL, boot_b, Fedora).
+ *
+ * The target. The stash address is the board's: U-Boot's a3_addr and board.toml's [adt.chosen.u64]
+ * "iceland,a3-stash", which UniXNU's devicetree.py writes into /chosen. Boot-arg reenter-uboot=1 switches this on with
+ * that address; reenter-uboot=<physical address> names it outright; reenter-uboot=0, or no such argument: off, and
+ * nothing changes. Everything else (where the image copy, the device tree and the log room are) is in the stash's
+ * header, which U-Boot writes and this kernel checks at early boot: the magic, the version, the bounds (all inside the
+ * stash, the stash outside this kernel's memory), the CRC-32 of the image copy and of the device tree. When a check
+ * fails the kernel says why and the run ends as before (K2's PSCI reset). The CRCs are checked again just before the
+ * jump; a mismatch then means a PSCI reset instead of a jump into memory that changed.
+ *
+ * The header (little-endian; the same layout in U-Boot's cmd/a3_stash.c):
+ *   0x00 magic "ICEA3STH"   0x08 version 1 (u32), header size 0x1000 (u32)   0x10 stash size
+ *   0x18 U-Boot entry (its image copy)   0x20 image size   0x28 device tree   0x30 its size
+ *   0x38 log room   0x40 its size   0x48 where ABL had loaded U-Boot   0x50 U-Boot's relocaddr (both for the record)
+ *   0x58 CRC-32 of the image copy (u32), of the device tree (u32)
+ *   0x80 "XNURETRN" (this kernel's: a log is there)   0x88 log length   0x90 its CRC-32 (u32), the reason (u32)
+ *   0x98 the kernel's uptime in ms   0xa0 a note (96 bytes)   0x100 U-Boot's "SERVED!!" once it has served the log
+ *
+ * The jump. loader_jump()'s way (loader_return.c), with this kernel's own trampoline instead of a loader's stub: a
+ * TTBR0 of 2 MiB blocks maps the stash and the trampoline's page 1:1 (T0SZ_BOOT, as loader_jump() does for the
+ * 47-bit user TCR); the trampoline, entered at its physical address, puts SCTLR_EL1 back to its architectural
+ * MMU-off value (no PAC, no WXN, no alignment checks: what U-Boot gets from ABL), clears PAN and UAO, invalidates the
+ * instruction cache and the TLBs and branches to U-Boot with x0 = the device tree, x1-x3 = 0. Before that the boot
+ * processor's timer and GIC CPU interface are quiet (gic_v3_irq_cpu_shutdown(), as a core that switches itself off),
+ * and the kernel's whole window (and any adopted outside memory) is cleaned and invalidated to the point of coherency
+ * by virtual address through the physical aperture, page by page where it is mapped (AT S1E1R): no dirty line of
+ * this kernel's can later land on what U-Boot writes with its MMU off.
+ *
+ * QEMU only so far (build/runs/a3). Nothing here runs unless reenter-uboot= is given and U-Boot armed the stash.
+ */
+
+#include <mach/mach_types.h>
+#include <kern/clock.h>
+#include <kern/cpu_number.h>
+#include <kern/debug.h>
+#include <kern/misc_protos.h>
+#include <kern/processor.h>
+#include <kern/startup.h>
+#include <arm/cpu_internal.h>
+#include <arm/machine_routines.h>
+#include <arm64/proc_reg.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm64/board_config.h>
+#include <vm/pmap.h>
+
+#define A3_MAGIC                0x4854533341454349ULL   /* "ICEA3STH" */
+#define A3_RET_MAGIC            0x4e52544552554e58ULL   /* "XNURETRN" */
+#define A3_VERSION              1u
+#define A3_HDR_SIZE             0x1000u
+#define A3_BLOCK                0x200000ULL             /* the identity map's 2 MiB blocks */
+
+#define A3_OFF_MAGIC            0x00
+#define A3_OFF_VERSION          0x08
+#define A3_OFF_HDRSIZE          0x0c
+#define A3_OFF_STASH_SIZE       0x10
+#define A3_OFF_ENTRY            0x18
+#define A3_OFF_IMAGE_SIZE       0x20
+#define A3_OFF_FDT              0x28
+#define A3_OFF_FDT_SIZE         0x30
+#define A3_OFF_LOG              0x38
+#define A3_OFF_LOG_MAX          0x40
+#define A3_OFF_ORIG             0x48
+#define A3_OFF_RELOCADDR        0x50
+#define A3_OFF_IMAGE_CRC        0x58
+#define A3_OFF_FDT_CRC          0x5c
+#define A3_OFF_RET_MAGIC        0x80
+#define A3_OFF_LOG_LEN          0x88
+#define A3_OFF_LOG_CRC          0x90
+#define A3_OFF_REASON           0x94
+#define A3_OFF_UPTIME_MS        0x98
+#define A3_OFF_NOTE             0xa0
+#define A3_NOTE_SIZE            96
+#define A3_OFF_SERVED           0x100
+
+/* reenter_uboot_reason(): why the run ends (the header's reason; U-Boot prints it) */
+#define REENTER_UBOOT_REASON_END        0u      /* loader_return() for any other reason (a halt, a hung GPU) */
+#define REENTER_UBOOT_REASON_RESET_AFTER 1u     /* K2's reset-after= timer */
+#define REENTER_UBOOT_REASON_PANIC      2u      /* a panic, after psci-panic-reset='s hold */
+
+extern char     loader_log[];
+extern uint32_t loader_log_len;
+extern void     loader_log_line(const char *line);
+extern void     loader_return(void);
+extern void     psci_halt_reset_quiet(void);            /* psci_halt.c: PSCI SYSTEM_RESET without a line */
+extern unsigned long gPhysBase;
+extern unsigned long real_phys_size;
+extern bool arm_vm_outside_range(unsigned int index, pmap_paddr_t *base, pmap_paddr_t *end);  /* arm_vm_init.c (K3) */
+extern uint32_t crc32(uint32_t crc, const void *bufp, size_t len);     /* bsd/libkern/crc32.c: zlib's CRC-32, as U-Boot's */
+#if defined(GENERIC_GIC_V3_IRQ)
+extern void gic_v3_irq_cpu_shutdown(void);
+#endif
+
+bool reenter_uboot_armed(void);
+void reenter_uboot_reason(uint32_t reason);
+void reenter_uboot_from_thread(uint32_t reason);
+extern void hakios_iceland_ufs_close_before_jump(void);        /* bsd/dev/hakios_iceland_ufs.c */
+void reenter_uboot_now(void);
+void reenter_uboot_tramp(void);
+
+/* bsd/sys/msgbuf.h (not includable from osfmk) */
+struct msgbuf {
+	int   msg_magic;
+	int   msg_size;
+	int   msg_bufx;
+	int   msg_bufr;
+	char *msg_bufc;
+};
+extern struct msgbuf *msgbufp;
+
+static struct {
+	uint64_t stash, size, entry, image_size, fdt, fdt_size, log, log_max, orig, relocaddr;
+	uint32_t image_crc, fdt_crc;
+	bool     armed;
+	const char *source;                     /* where the address came from */
+} a3;
+#define A3_NOT_ARMED "reenter-uboot: not armed: stash 0x%llx: %s\n"
+static bool     a3_setup_done;
+static bool     a3_entered;
+static uint32_t a3_reason = REENTER_UBOOT_REASON_END;
+
+/* the lines of the way out: written with interrupts off, after the loader log may be full; they go last */
+static char     a3_lines[1024];
+static size_t   a3_lines_len;
+
+/* one L1 table and two L2 tables: the stash's blocks and the trampoline's (in another gigabyte, as a rule) */
+static uint64_t a3_l1[512] __attribute__((aligned(4096)));
+static uint64_t a3_l2[2][512] __attribute__((aligned(4096)));
+static uint32_t a3_l2_of[2] = { UINT32_MAX, UINT32_MAX };
+
+/*
+ * The trampoline, entered at its physical address through the 1:1 TTBR0 with the MMU still on: x0 = the device
+ * tree, x1 = U-Boot's entry. 64-byte aligned and shorter than 64 bytes, so it never straddles a 2 MiB block.
+ * SCTLR_EL1 = 0x30d00800: its RES1 bits only (LSMAOE, nTLSMD, SPAN, EIS, TSCXT, EOS), so M, C, I, A, SA, WXN and
+ * the PAC enables are 0 - the state U-Boot is started in.
+ */
+__attribute__((naked, aligned(64)))
+void
+reenter_uboot_tramp(void)
+{
+	__asm__ volatile (
+                "msr DAIFSet, #0xf\n"
+                ".inst 0xd500409f\n"            /* msr PAN, #0 */
+                ".inst 0xd500407f\n"            /* msr UAO, #0 */
+                "movz x9, #0x0800\n"
+                "movk x9, #0x30d0, lsl #16\n"
+                "msr SCTLR_EL1, x9\n"
+                "isb\n"
+                "ic iallu\n"
+                "tlbi vmalle1\n"
+                "dsb sy\n"
+                "isb\n"
+                "mov x2, xzr\n"
+                "mov x3, xzr\n"
+                "br x1\n");
+}
+
+static void
+a3_line(const char *line)
+{
+	size_t n = strlen(line);
+
+	loader_log_line(line);
+	if (a3_lines_len + n < sizeof(a3_lines)) {
+		memcpy(a3_lines + a3_lines_len, line, n);
+		a3_lines_len += n;
+	}
+}
+
+static const char *
+a3_reason_name(uint32_t reason)
+{
+	switch (reason) {
+	case REENTER_UBOOT_REASON_RESET_AFTER: return "reset-after";
+	case REENTER_UBOOT_REASON_PANIC: return "panic";
+	default: return "the end of the run";
+	}
+}
+
+/*
+ * [lo, hi) overlaps this kernel's memory: its window, a run of outside memory it took (K3: arm_vm_outside_range(),
+ * adopted page by page), or any run DarwinBoot listed as free outside the window (/chosen darwinboot-memory-outside,
+ * (base, size) pairs: what memory-outside= may adopt, whether this boot adopts it or not).
+ */
+static bool
+a3_overlaps_kernel(uint64_t lo, uint64_t hi)
+{
+	pmap_paddr_t base, end;
+	DTEntry chosen;
+	void const *prop;
+	unsigned int size;
+
+	if (lo < gPhysBase + real_phys_size && hi > gPhysBase) {
+		return true;
+	}
+	for (unsigned int i = 0; arm_vm_outside_range(i, &base, &end); i++) {
+		if (lo < end && hi > base) {
+			return true;
+		}
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "darwinboot-memory-outside", &prop, &size) == kSuccess) {
+		for (unsigned int i = 0; i + 16 <= size; i += 16) {
+			uint64_t pair[2];
+
+			memcpy(pair, (const uint8_t *)prop + i, sizeof(pair));
+			if (pair[1] != 0 && lo < pair[0] + pair[1] && hi > pair[0]) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static bool
+a3_inside(uint64_t pa, uint64_t size)
+{
+	return size != 0 && pa >= a3.stash + A3_HDR_SIZE && pa + size > pa && pa + size <= a3.stash + a3.size;
+}
+
+/*
+ * A temporary device mapping of physical memory outside this kernel's: ml_io_map_unmappable(), because ml_io_map()'s
+ * mappings are permanent and ml_io_unmap() of one panics in vm_map_delete() ("Attempting to remove permanent VM map
+ * entry": QEMU run a3 20261113-121706-q1-cpus1).
+ */
+static vm_offset_t
+a3_map_phys(uint64_t pa, uint64_t len)
+{
+	return ml_io_map_unmappable(pa, len, VM_WIMG_IO);
+}
+
+/* CRC-32 of physical memory outside this kernel's, through a device mapping (byte reads: no alignment fault) */
+static uint32_t
+a3_crc_phys(uint64_t pa, uint64_t size)
+{
+	uint64_t lo = trunc_page(pa), len = round_page(pa + size) - lo;
+	vm_offset_t m = a3_map_phys(lo, len);
+	uint32_t crc;
+
+	if (m == 0) {
+		return 0;
+	}
+	crc = crc32(0, (const void *)(m + (pa - lo)), (size_t)size);
+	ml_io_unmap(m, len);
+	return crc;
+}
+
+/* the header at early boot, through a device mapping; the CRCs of the image and the device tree too */
+static void
+reenter_uboot_setup(void)
+{
+	uint64_t want = 0, stash = 0;
+	vm_offset_t h;
+	uint32_t crc;
+
+	if (a3_setup_done) {
+		return;
+	}
+	a3_setup_done = true;
+	if (!PE_parse_boot_argn("reenter-uboot", &want, sizeof(want)) || want == 0) {
+		return;
+	}
+	if (want == 1) {
+		DTEntry chosen;
+		void const *prop;
+		unsigned int size;
+
+		if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+		    SecureDTGetProperty(chosen, "iceland,a3-stash", &prop, &size) != kSuccess || size != sizeof(uint64_t)) {
+			printf("reenter-uboot: not armed: no /chosen/iceland,a3-stash\n");
+			return;
+		}
+		memcpy(&stash, prop, sizeof(stash));
+		a3.source = "chosen";
+	} else {
+		stash = want;
+		a3.source = "boot-arg";
+	}
+	if (stash == 0 || (stash & (A3_BLOCK - 1)) != 0) {
+		printf(A3_NOT_ARMED, stash, "not 2 MiB aligned");
+		return;
+	}
+	if (a3_overlaps_kernel(stash, stash + A3_HDR_SIZE)) {
+		printf(A3_NOT_ARMED, stash, "in kernel memory");
+		return;
+	}
+	h = a3_map_phys(stash, A3_HDR_SIZE);
+	if (h == 0) {
+		printf(A3_NOT_ARMED, stash, "no mapping");
+		return;
+	}
+#define A3_RD64(o) (*(volatile uint64_t *)(h + (o)))
+#define A3_RD32(o) (*(volatile uint32_t *)(h + (o)))
+	if (A3_RD64(A3_OFF_MAGIC) != A3_MAGIC || A3_RD32(A3_OFF_VERSION) != A3_VERSION ||
+	    A3_RD32(A3_OFF_HDRSIZE) != A3_HDR_SIZE) {
+		printf(A3_NOT_ARMED, stash, "no magic (no a3_stash arm)");
+		ml_io_unmap(h, A3_HDR_SIZE);
+		return;
+	}
+	a3.stash = stash;
+	a3.size = A3_RD64(A3_OFF_STASH_SIZE);
+	a3.entry = A3_RD64(A3_OFF_ENTRY);
+	a3.image_size = A3_RD64(A3_OFF_IMAGE_SIZE);
+	a3.fdt = A3_RD64(A3_OFF_FDT);
+	a3.fdt_size = A3_RD64(A3_OFF_FDT_SIZE);
+	a3.log = A3_RD64(A3_OFF_LOG);
+	a3.log_max = A3_RD64(A3_OFF_LOG_MAX);
+	a3.orig = A3_RD64(A3_OFF_ORIG);
+	a3.relocaddr = A3_RD64(A3_OFF_RELOCADDR);
+	a3.image_crc = A3_RD32(A3_OFF_IMAGE_CRC);
+	a3.fdt_crc = A3_RD32(A3_OFF_FDT_CRC);
+#undef A3_RD64
+#undef A3_RD32
+	ml_io_unmap(h, A3_HDR_SIZE);
+
+	if (a3.size < 4 * A3_BLOCK || a3.stash + a3.size < a3.stash || a3_overlaps_kernel(a3.stash, a3.stash + a3.size)) {
+		printf(A3_NOT_ARMED, a3.stash, "size, or in kernel memory");
+		return;
+	}
+	if (!a3_inside(a3.entry, a3.image_size) || (a3.entry & 0xfff) != 0 || !a3_inside(a3.fdt, a3.fdt_size) ||
+	    !a3_inside(a3.log, a3.log_max) || a3.log_max < 64 * 1024) {
+		printf(A3_NOT_ARMED, a3.stash, "header ranges");
+		return;
+	}
+	crc = a3_crc_phys(a3.entry, a3.image_size);
+	if (crc != a3.image_crc) {
+		printf(A3_NOT_ARMED, a3.stash, "image crc");
+		return;
+	}
+	crc = a3_crc_phys(a3.fdt, a3.fdt_size);
+	if (crc != a3.fdt_crc) {
+		printf(A3_NOT_ARMED, a3.stash, "fdt crc");
+		return;
+	}
+	a3.armed = true;
+	printf("reenter-uboot: armed: stash 0x%llx+0x%llx (%s); U-Boot 0x%llx (%llu B, crc %08x, from 0x%llx), x0 0x%llx "
+	    "(crc %08x), log 0x%llx\n", a3.stash, a3.size, a3.source, a3.entry, a3.image_size, a3.image_crc, a3.orig,
+	    a3.fdt, a3.fdt_crc, a3.log);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, reenter_uboot_setup);
+
+bool
+reenter_uboot_armed(void)
+{
+	reenter_uboot_setup();
+	return a3.armed && !a3_entered;
+}
+
+void
+reenter_uboot_reason(uint32_t reason)
+{
+	a3_reason = reason;
+}
+
+static void
+reenter_uboot_xcall(__unused void *arg)
+{
+	loader_return();
+}
+
+/*
+ * From a thread (reset-after's): the boot processor, the core U-Boot ran on and DarwinBoot started this kernel on,
+ * makes the jump; a timer that fires on another core hands it over, as loader_return_after's does
+ * (loader_return.c). loader_return() stops the other cores (psci_smp_stop_others()) and the drivers, puts the log in
+ * order and, with no loader listening, ends in reenter_uboot_now().
+ */
+void
+reenter_uboot_from_thread(uint32_t reason)
+{
+	int boot_cpu = master_processor->cpu_id;
+
+	a3_reason = reason;
+	printf("reenter-uboot: %s on cpu %d, jump on cpu %d\n", a3_reason_name(reason), cpu_number(), boot_cpu);
+	/*
+	 * The storage closed on this thread first, whichever processor it is on: the cross-call may land on a thread with
+	 * a command in U-Boot's slot, and every reset-after end takes one path.
+	 */
+	hakios_iceland_ufs_close_before_jump();
+	/* (the parameter must not be NULL: cpu_xcall_internal() panics on a null func or param, QEMU run q2-cpus2) */
+	if (cpu_number() != boot_cpu && cpu_xcall(boot_cpu, reenter_uboot_xcall, (void *)(uintptr_t)1) == KERN_SUCCESS) {
+		for (;;) {
+			delay_for_interval(1000, NSEC_PER_MSEC);        /* the boot processor ends it, and this core */
+		}
+	}
+	loader_return();
+}
+
+static inline bool
+a3_va_mapped(vm_offset_t va)
+{
+	uint64_t par;
+
+	__asm__ volatile ("at s1e1r, %1\n"
+                "isb\n"
+                "mrs %0, PAR_EL1\n" : "=r" (par) : "r" (va) : "memory");
+	return (par & 1) == 0;
+}
+
+/* clean and invalidate [lo, hi) to the point of coherency through the physical aperture, page by page where mapped */
+static uint64_t
+a3_clean_phys(pmap_paddr_t lo, pmap_paddr_t hi, uint64_t line)
+{
+	uint64_t done = 0;
+
+	for (pmap_paddr_t pa = lo & ~0xfffULL; pa < hi; pa += 0x1000) {
+		vm_offset_t va = phystokv(pa);
+
+		if (!a3_va_mapped(va)) {
+			continue;
+		}
+		for (vm_offset_t p = va; p < va + 0x1000; p += line) {
+			__asm__ volatile ("dc civac, %0" : : "r" (p) : "memory");
+		}
+		done += 0x1000;
+	}
+	return done;
+}
+
+/* identity-map [lo, hi) with 2 MiB blocks into a3_l1 */
+static bool
+a3_map(uint64_t lo, uint64_t hi)
+{
+	for (uint64_t b = lo & ~(A3_BLOCK - 1); b < hi; b += A3_BLOCK) {
+		uint32_t l1i = (uint32_t)(b >> 30), t;
+
+		if ((b >> (64 - T0SZ_BOOT)) != 0) {
+			return false;                   /* beyond what a T0SZ_BOOT TTBR0 reaches */
+		}
+		for (t = 0; t < 2 && a3_l2_of[t] != l1i; t++) {
+			;
+		}
+		if (t == 2) {
+			for (t = 0; t < 2 && a3_l2_of[t] != UINT32_MAX; t++) {
+				;
+			}
+			if (t == 2) {
+				return false;           /* a third gigabyte: not needed by any stash + trampoline */
+			}
+			a3_l2_of[t] = l1i;
+			a3_l1[l1i] = kvtophys((vm_offset_t)a3_l2[t]) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
+		}
+		a3_l2[t][(b >> 21) & 0x1ff] = b | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK | ARM_TTE_BLOCK_AF |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_AP(AP_RWNA) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITEBACK);
+	}
+	return true;
+}
+
+static size_t
+a3_put(char *dst, size_t at, size_t room, const char *src, size_t n)
+{
+	if (at >= room) {
+		return at;
+	}
+	if (n > room - at) {
+		n = room - at;
+	}
+	memcpy(dst + at, src, n);
+	return at + n;
+}
+
+static void
+a3_fail(const char *why)
+{
+	char line[200];
+
+	snprintf(line, sizeof(line), "reenter-uboot: not done (%s): PSCI reset\n", why);
+	loader_log_line(line);
+	psci_halt_reset_quiet();        /* returns only if the firmware does not reset (or there is no conduit) */
+}
+
+/*
+ * The end of loader_return() when no loader listened (loader_jump() came back): with the stash armed, back into
+ * U-Boot. On the boot processor, the others off. Returns only if it cannot go (and the PSCI reset failed too).
+ */
+void
+reenter_uboot_now(void)
+{
+	char line[256];
+	uint64_t line_size, t0, t1, ns = 0, cleaned, outside = 0, tcr, old_tcr, old_ttbr0, tramp_va, tramp_pa, crc, n;
+	char *dst;
+
+	if (!a3.armed || a3_entered) {
+		return;
+	}
+	a3_entered = true;
+	__builtin_arm_wsr("DAIFSet", DAIFSC_ALL);
+	/* nothing may interrupt U-Boot: this core's timer off, its GIC CPU interface quiet (psci_smp_cpu_off()'s way) */
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 0);
+	__builtin_arm_isb(ISB_SY);
+#if defined(GENERIC_GIC_V3_IRQ)
+	gic_v3_irq_cpu_shutdown();
+#endif
+	line_size = 4ULL << ((__builtin_arm_rsr64("CTR_EL0") >> 16) & 0xf);
+
+	/* the window, and any adopted outside memory, back to RAM: no dirty line of ours outlives the jump */
+	t0 = mach_absolute_time();
+	cleaned = a3_clean_phys(gPhysBase, gPhysBase + real_phys_size, line_size);
+	{
+		/* K3's runs of adopted outside memory: phystokv() maps them (arm_vm_outside_ptov), page by page as adopted */
+		pmap_paddr_t base, end;
+
+		for (unsigned int i = 0; arm_vm_outside_range(i, &base, &end); i++) {
+			outside += a3_clean_phys(base, end, line_size);
+		}
+		cleaned += outside;
+	}
+	__builtin_arm_dsb(DSB_SY);
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	snprintf(line, sizeof(line), "reenter-uboot: %s: window 0x%lx+0x%lx, %llu MiB adopted: %llu MiB to PoC in %llu ms\n",
+	    a3_reason_name(a3_reason), gPhysBase, real_phys_size, outside >> 20, cleaned >> 20, ns / NSEC_PER_MSEC);
+	a3_line(line);
+
+	/* 1:1 for the stash and the trampoline */
+	__asm__ volatile ("adrp %0, _reenter_uboot_tramp@PAGE\n"
+                "add %0, %0, _reenter_uboot_tramp@PAGEOFF\n" : "=r" (tramp_va));
+	tramp_pa = kvtophys((vm_offset_t)tramp_va);
+	if (tramp_pa == 0 || !a3_map(a3.stash, a3.stash + a3.size) || !a3_map(tramp_pa, tramp_pa + 64)) {
+		a3_fail("map");
+		return;
+	}
+	old_tcr = __builtin_arm_rsr64("TCR_EL1");
+	old_ttbr0 = __builtin_arm_rsr64("TTBR0_EL1");
+	tcr = (old_tcr & ~(TCR_TSZ_MASK << TCR_T0SZ_SHIFT)) | (T0SZ_BOOT << TCR_T0SZ_SHIFT);
+	tcr &= ~(1ULL << 7);                    /* TCR_EL1.EPD0: TTBR0 walks on */
+	__builtin_arm_dsb(DSB_SY);
+	__asm__ volatile (
+                "msr TCR_EL1, %0\n"
+                "msr TTBR0_EL1, %1\n"
+                "isb\n"
+                "tlbi vmalle1\n"
+                "dsb sy\n"
+                "isb\n" : : "r" (tcr), "r" (kvtophys((vm_offset_t)a3_l1)) : "memory");
+
+	/* the copies U-Boot made are what the header says they are */
+	crc = crc32(0, (const void *)a3.entry, (size_t)a3.image_size);
+	if (crc != a3.image_crc || crc32(0, (const void *)a3.fdt, (size_t)a3.fdt_size) != a3.fdt_crc) {
+		__asm__ volatile (
+                        "msr TTBR0_EL1, %1\n"
+                        "msr TCR_EL1, %0\n"
+                        "isb\n"
+                        "tlbi vmalle1\n"
+                        "dsb sy\n"
+                        "isb\n" : : "r" (old_tcr), "r" (old_ttbr0) : "memory");
+		snprintf(line, sizeof(line), "crc %08llx", crc);
+		a3_fail(line);
+		return;
+	}
+	snprintf(line, sizeof(line), "reenter-uboot: jumping to U-Boot at 0x%llx (crc %08x ok), x0 0x%llx (crc %08x ok), "
+	    "tramp 0x%llx, log 0x%llx\n", a3.entry, a3.image_crc, a3.fdt, a3.fdt_crc,
+	    tramp_pa, a3.log);
+	a3_line(line);
+
+	/* the log: the message buffer (everything printf, IOLog and os_log wrote), the console feed, these lines */
+	dst = (char *)a3.log;
+	n = 0;
+	{
+		static const char h1[] = "=== msgbuf ===\n";
+		static const char h2[] = "\n=== console ===\n";
+		static const char h3[] = "\n=== reenter-uboot ===\n";
+		static const char h4[] = "=== end ===\n";
+		uint64_t tail = loader_log_len + a3_lines_len + 4096;   /* what comes after the message buffer */
+		uint64_t room = a3.log_max > tail ? a3.log_max - tail : 0;
+		struct msgbuf *mb = msgbufp;
+
+		n = a3_put(dst, n, a3.log_max, h1, sizeof(h1) - 1);
+		if (mb != NULL && mb->msg_bufc != NULL && mb->msg_size > 0 && mb->msg_bufx >= 0 &&
+		    mb->msg_bufx <= mb->msg_size) {
+			for (int pass = 0; pass < 2; pass++) {
+				int from = pass == 0 ? mb->msg_bufx : 0, to = pass == 0 ? mb->msg_size : mb->msg_bufx;
+
+				for (int i = from; i < to && n < room; i++) {
+					if (mb->msg_bufc[i] != 0) {
+						dst[n++] = mb->msg_bufc[i];
+					}
+				}
+			}
+		}
+		n = a3_put(dst, n, a3.log_max, h2, sizeof(h2) - 1);
+		n = a3_put(dst, n, a3.log_max, loader_log, loader_log_len);
+		n = a3_put(dst, n, a3.log_max, h3, sizeof(h3) - 1);
+		n = a3_put(dst, n, a3.log_max, a3_lines, a3_lines_len);
+		n = a3_put(dst, n, a3.log_max, h4, sizeof(h4) - 1);
+	}
+	{
+		volatile uint8_t *hp = (volatile uint8_t *)a3.stash;
+		uint64_t ms = 0;
+		char note[A3_NOTE_SIZE];
+
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		ms = ns / NSEC_PER_MSEC;
+		snprintf(note, sizeof(note), "%s at %llu s", a3_reason_name(a3_reason), ms / 1000);
+		*(volatile uint64_t *)(hp + A3_OFF_LOG_LEN) = n;
+		*(volatile uint32_t *)(hp + A3_OFF_LOG_CRC) = (uint32_t)crc32(0, dst, (size_t)n);
+		*(volatile uint32_t *)(hp + A3_OFF_REASON) = a3_reason;
+		*(volatile uint64_t *)(hp + A3_OFF_UPTIME_MS) = ms;
+		for (unsigned i = 0; i < A3_NOTE_SIZE; i++) {
+			hp[A3_OFF_NOTE + i] = i < strlen(note) ? (uint8_t)note[i] : 0;
+		}
+		*(volatile uint64_t *)(hp + A3_OFF_SERVED) = 0;
+		__builtin_arm_dmb(DMB_ISH);
+		*(volatile uint64_t *)(hp + A3_OFF_RET_MAGIC) = A3_RET_MAGIC;
+	}
+	/* the log, the header and the trampoline to the point of coherency: U-Boot starts with its caches off */
