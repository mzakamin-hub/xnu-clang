+namespace {
+void
+setNumber(OSDictionary *d, const char *key, uint64_t value, unsigned bits = 32)
+{
+	if (OSNumber *n = OSNumber::withNumber(value, bits)) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
+void
+setNumber(IORegistryEntry *e, const char *key, uint64_t value, unsigned bits = 32)
+{
+	if (OSNumber *n = OSNumber::withNumber(value, bits)) {
+		e->setProperty(key, n);
+		n->release();
+	}
+}
+OSDictionary *
+format(uint32_t channels)
+{
+	OSDictionary *f = OSDictionary::withCapacity(8);
+	if (!f) {
+		return nullptr;
+	}
+	setNumber(f, "sample rate", uint64_t(fixed64(kRate)), 64);
+	setNumber(f, "format ID", kFormatLinearPCM);
+	setNumber(f, "format flags", kFlagsS16);
+	setNumber(f, "bytes per packet", 2 * channels);
+	setNumber(f, "frames per packet", 1);
+	setNumber(f, "bytes per frame", 2 * channels);
+	setNumber(f, "channels per frame", channels);
+	setNumber(f, "bits per channel", 16);
+	return f;
+}
+OSArray *
+streams(uint32_t channels, uint32_t terminal)
+{
+	OSDictionary *stream = OSDictionary::withCapacity(8), *current = format(channels), *range = format(channels);
+	OSArray *available = OSArray::withCapacity(1), *list = OSArray::withCapacity(1);
+	if (stream && current && range && available && list) {
+		setNumber(range, "min sample rate", uint64_t(fixed64(kRate)), 64);
+		setNumber(range, "max sample rate", uint64_t(fixed64(kRate)), 64);
+		available->setObject(range);
+		setNumber(stream, "stream ID", kStreamID);
+		setNumber(stream, "starting channel", 1);
+		setNumber(stream, "latency", 0);
+		setNumber(stream, "terminal type", terminal);
+		stream->setObject("current format", current);
+		stream->setObject("available formats", available);
+		list->setObject(stream);
+	}
+	OSSafeReleaseNULL(stream);
+	OSSafeReleaseNULL(current);
+	OSSafeReleaseNULL(range);
+	OSSafeReleaseNULL(available);
+	return list;
+}
+uint64_t
+absolute(uint64_t frames)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(frames * 1000000000ULL / kRate, &t);
+	return t;
+}
+}  // namespace
