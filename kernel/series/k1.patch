+/*
+ * Host unit test for bsd/dev/hakios_iceland_charger_plan.h: every icechg_plan() case and the helpers.
+ * It runs on the PC, with no kernel and no hardware, and prints one line per check.
+ * Build and run from the repository root:
+ * cc -std=c11 -Wall -Wextra -Werror -pedantic -I bsd/dev \
+ *    -o /tmp/w4-battery-plan-test tools/tests/hakios_iceland/charger_plan_test.c \
+ *    && /tmp/w4-battery-plan-test
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "hakios_iceland_charger_plan.h"
+
+struct plan_case {
+	const char *name;
+	struct icechg_state in;
+	bool ask_9v;
+	uint32_t icl_ma;
+	const char *why;	/* a substring of plan.why; NULL: not checked */
+};
+
+static const struct plan_case cases[] = {
+	{ "stage A: computer USB-A port, adapter 9, lowest VBUS",
+	  { true, 9, 4536, 2000, 2000, 3800, false, false }, false, 0, "BrickID" },
+	{ "stage A, highest VBUS",
+	  { true, 9, 4683, 2000, 2000, 3800, false, false }, false, 0, "BrickID" },
+	{ "stage A, the passed run 053910: 4735 mV, battery 3850 mV",
+	  { true, 9, 4735, 2000, 2000, 3850, false, false }, false, 0, "BrickID" },
+	{ "adapter 9 with a low firmware limit: still no write",
+	  { true, 9, 4900, 2000, 500, 3800, false, false }, false, 0, "BrickID" },
