index ee5edb3a44691bdbd6bca5f536aa0bb9075d03d5..c9043ceac20c65af7776340420408bdc811d63b8 100644
--- a/iokit/Kernel/IODeviceTreeSupport.cpp
+++ b/iokit/Kernel/IODeviceTreeSupport.cpp
@@ -104,6 +104,75 @@ static void AddPHandle( IORegistryEntry * regEntry );
 static void FreePhysicalMemory( vm_offset_t * range );
 static bool IODTMapInterruptsSharing( IORegistryEntry * regEntry, OSDictionary * allInts );
 
+/*
+ * iceland (34ux4 / 34ux7, 1 Nov 2026): entries iBoot's device tree has and our loader's does not, added to the
+ * IODeviceTree plane once it is built (the flattened tree itself stays as the loader made it). Off without the boot-args.
+ *   icedt_wlan=1  an empty node "wlan" at the tree's root. launchd's _LimitLoadToDeviceTree (com.apple.wifid: "wlan",
+ *                 "marconi-wifi", "centauri-alpha", "centauri-alpha-protium") is answered by the kernel's
+ *                 io_device_tree_entry_exists_with_name: a recursive search of this plane by name (IOUserClient.cpp,
+ *                 icedt_log=1 logs each question). No compatible and no device_type: no driver is matched to it.
+ *   def.NAME=N    the property NAME = N (32 bits) on /defaults, as iBoot's tree carries kern.maxvnodes / sleep-disabled,
+ *                 for user space; the kernel's own PE_get_default() reads come from the same boot-args (bootargs.c).
+ * Lines "icedt: ...".
+ */
+static void
+IcelandDTExtras(IORegistryEntry * root)
+{
+	uint32_t wlan = 0;
+	const char * args = PE_boot_args();
+	IORegistryEntry * defaults = NULL;
+
+	if (PE_parse_boot_argn("icedt_wlan", &wlan, sizeof(wlan)) && wlan != 0) {
+		IORegistryEntry * node = OSTypeAlloc(IORegistryEntry);
+		OSDictionary * props = OSDictionary::withCapacity(2);
+		OSData * name = OSData::withBytes("wlan", sizeof("wlan"));
+
+		if (node != NULL && props != NULL && name != NULL && props->setObject(gIODTNameKey, name) && node->init(props)) {
+			node->setName("wlan");
+			node->attachToParent(root, gIODTPlane);
+			IOLog("icedt: /wlan added to the device-tree plane (icedt_wlan=1, for launchd's _LimitLoadToDeviceTree of wifid)\n");
+		} else {
+			IOLog("icedt: /wlan NOT added (no memory)\n");
+		}
+		OSSafeReleaseNULL(name);
+		OSSafeReleaseNULL(props);
+		OSSafeReleaseNULL(node);
+	}
+	/* every "def.NAME=N" of the boot-args onto /defaults */
+	for (const char * p = args; p != NULL && *p != '\0';) {
+		const char * end;
+		const char * eq = NULL;
+		char key[64];
+		uint32_t value;
+		size_t n;
+
+		while (*p == ' ') {
+			p++;
+		}
+		for (end = p; *end != '\0' && *end != ' '; end++) {
+			if (*end == '=' && eq == NULL) {
+				eq = end;
+			}
+		}
+		if (end - p > 4 && strncmp(p, "def.", 4) == 0 && eq != NULL && (n = (size_t) (eq - p - 4)) > 0 && n < sizeof(key)) {
+			memcpy(key, p + 4, n);
+			key[n] = '\0';
+			value = (uint32_t) strtol(eq + 1, NULL, 0);
+			if (defaults == NULL) {
+				defaults = IORegistryEntry::fromPath("/defaults", gIODTPlane);
+			}
+			if (defaults != NULL) {
+				defaults->setProperty(key, &value, sizeof(value));
+				IOLog("icedt: /defaults %s = %u (boot-arg def.%s)\n", key, value, key);
+			} else {
+				IOLog("icedt: no /defaults node: def.%s not published\n", key);
+			}
+		}
+		p = end;
+	}
+	OSSafeReleaseNULL(defaults);
+}
+
 // FIXME: Implementation of this function is hidden from the static analyzer.
