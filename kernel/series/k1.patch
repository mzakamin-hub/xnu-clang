+/* ---- the ath12k board layer's getters (hakios_iceland_ath12k.c, the (B) route) ----
+ * Exposed so the Linux ath12k driver (ath12k.o, UniXNU Ath12kWifi) can run on the WCN7860 with this bring-up. For
+ * icepcie_lx=1 the harvest driver's MHI/QMI does NOT run, so the QMI arena (q_pa/q_va, 32 MB below 4 GB) is free for
+ * the driver's DMA heap. iceland_ath12k_link() is called from the harvest thread right after the PCIe link is up and
+ * the BAR / config space / MSI are set (before any MHI/QMI step). */
+vm_offset_t iceland_ath12k_bar;      /* the endpoint's MHI BAR (e2_bar1m) */
+vm_offset_t iceland_ath12k_conf;     /* the endpoint's config space (e2_cfg) */
+uint64_t iceland_ath12k_dma_pa;      /* the DMA arena bus base (q_pa) */
+vm_offset_t iceland_ath12k_dma_va;   /* the DMA arena mapping (q_va) */
+uint32_t iceland_ath12k_dma_size;    /* the DMA arena length (Q_ARENA) */
+uint64_t iceland_ath12k_msi;         /* the MSI sink (e2_iova + 0xf0000) */
+
+const uint8_t *
+iceland_ath12k_fw(const char *name, uint32_t *len)
+{
+	/* the firmware files in md1 fw/, sha256-pinned (iceland-firmware ath12k/WCN7860/hw2.0) */
+	static const struct {
+		const char *name, *sha;
+	} files[] = {
+		{ "ath12k_amss.bin", "23811bd6abe91a89ef00057e0a4d2e85ea3d0defcad377334cdef987ec4df820" },
+		{ "ath12k_board.bin", "355578ce4162b885c9371e8df7eac20bb4bcd28c8b9d11cf0bdd5114ec6cfe3c" },
+		{ "ath12k_m3.bin", "c1a1295b1808ba204676c03967aea91effc5d85b55a9d269ba858c5e80c92b9c" },
+		{ "ath12k_aux_ucode.bin", "4db9df6fdac982752f71c513f174da7e22307a769a9d49fd336b054919c9451e" },
+		{ "ath12k_qdss.cfg", "4683d8683437a11172723dc5820801aaaf5eb082336875a7664142582cc90cbb" },
+		{ "ath12k_regdb.bin", "365026525f6a9a1ebf0668b8c61fb1300bfdb2450148e994b9a4ca66257e7e43" },
+	};
+	uint64_t size = 0;
+	int disk = -1;
+	const uint8_t *d;
+	uint8_t dg[32];
+	SHA256_CTX c;
+	uint32_t i;
+
+	for (i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		if (strcmp(name, files[i].name) == 0) {
+			break;
+		}
+	}
+	if (i == sizeof(files) / sizeof(files[0])) {
+		return NULL;
+	}
+	d = redwood_image_file("fw", files[i].name, &size, &disk);
+	if (d == NULL || size == 0 || size > (16u << 20)) {
+		return NULL;
+	}
+	SHA256_Init(&c);
+	SHA256_Update(&c, d, (size_t)size);
+	SHA256_Final(dg, &c);
+	{
+		static const char h[] = "0123456789abcdef";
+		char hex[65];
+
+		for (uint32_t k = 0; k < 32; k++) {
+			hex[2 * k] = h[dg[k] >> 4];
+			hex[2 * k + 1] = h[dg[k] & 15];
+		}
+		hex[64] = 0;
+		if (strcmp(hex, files[i].sha) != 0) {
+			return NULL;
+		}
+	}
+	if (len != NULL) {
+		*len = (uint32_t)size;
+	}
+	return d;
+}
+
+void
+iceland_ath12k_link(void)
+{
+	/* 23e2g: bus master on BOTH the endpoint and the root port. Linux's pci_set_master only turns on the endpoint
+	 * (the board layer has no pci_enable_bridge); without the root port's Bus Master Enable the chip's PBL DMA
+	 * completes as Unsupported Request and the PBL reports SYS_ERR (MHISTATUS 0xff04) instead of READY. */
+	e2_bm_on(e2_cfg, "icepcie_lx handoff");
+	/* the endpoint's MHI BAR, mapped here (e2_bar1m is only mapped inside e2_sw_reset(), which the (B) route skips) */
+	iceland_ath12k_bar = ml_io_map_unmappable(0x40400000u, 0x200000, VM_WIMG_IO);
+	iceland_ath12k_conf = e2_cfg;
+	iceland_ath12k_dma_pa = q_pa;
+	iceland_ath12k_dma_va = q_va;
+	iceland_ath12k_dma_size = Q_ARENA;
+	iceland_ath12k_msi = e2_iova + 0xf0000;
+	say("icepcie: ath12k: link handed off (BAR %#lx, conf %#lx, dma %#llx %#lx %u B, msi %#llx)\n",
+	    iceland_ath12k_bar, iceland_ath12k_conf, iceland_ath12k_dma_pa, iceland_ath12k_dma_va,
+	    iceland_ath12k_dma_size, iceland_ath12k_msi);
+}
+
+/* (B) route: the ath12k driver calls this from its crash handler (MHI_CB_EE_RDDM) to read the SMMU bank-9 fault
+ * registers, so a firmware Master Abort / translation fault leaves its faulting IOVA in FAR. Reads only. */
+/*
+/*
+ * 46cn2m22: the endpoint's Device Control, read where it is still readable (kept for e2_bm_on).
+ */
+static void
+e2_devctl_log(const char *when)
+{
+	if (e2_cfg != 0) {
+		uint32_t cap = io_rd(e2_cfg, 0x34) & 0xfcu, devctl = 0, ncap = 0;
+
+		for (uint32_t g = 0; cap >= 0x40 && cap <= 0xfc && g < 48; g++) {
+			uint32_t w = io_rd(e2_cfg, cap);
+
+			if (w == 0 || w == 0xffffffffu) {
+				break;
+			}
+			ncap++;
+			if ((w & 0xff) == 0x10) {
+				devctl = (io_rd(e2_cfg, cap + 0x08) >> 16) & 0xffff;
+				break;
+			}
+			cap = (w >> 8) & 0xfcu;
+		}
+		say("icepcie: ath12k: pcie %s: id %04x:%04x DevCtl %04x (%u caps walked; Enable No Snoop %s)\n",
+		    when, io_rd(e2_cfg, 0x00) & 0xffff, io_rd(e2_cfg, 0x00) >> 16, devctl, ncap,
+		    (devctl & (1u << 11)) ? "ENABLED" : "off");
+	}
+	/* the root port's own view (DBI window, still readable when the endpoint's config space is not): DLL link active,
+	 * link speed/width, and the LTSSM state - did the link drop, and when did these disagree? */
+	if (e2_dbi != 0) {
+		uint32_t lnk = io_rd(e2_dbi, 0x80);
+
+		say("icepcie: ath12k: rp %s: lnkctl/sta %08x (speed %u width x%u DLLLA %u) LTSSM %08x sec-status %04x\n",
+		    when, lnk, (lnk >> 16) & 0xf, (lnk >> 20) & 0x3f, (lnk >> 29) & 1,
+		    io_rd(e2_dbi, 0x728) & 0x3f, io_rd(e2_dbi, 0x1c) >> 16);
+	}
+}
+
+void
+iceland_smmu_fault_read(void)
+{
+	if (e5_cb == 0) {
+		say("icepcie: ath12k: smmu fault read: bank 9 not mapped\n");
+		return;
+	}
+	say("icepcie: ath12k: smmu bank %u FSR %08x (fault bits %08x) FAR %08x_%08x FSYNR0 %08x\n",
+	    E2A_BANK, io_rd(e5_cb, 0x58), io_rd(e5_cb, 0x58) & ~0x600u,
+	    io_rd(e5_cb, 0x64), io_rd(e5_cb, 0x60), io_rd(e5_cb, 0x68));
+	/* the device-side attribute overrides: the CB's SCTLR/ACTLR (ACTLR can force cacheable/system-cache) and the
+	 * SID 0x1400/0x1401 stream entry (SMR/S2CR: MTCFG/MEMATTR/SHCFG can override the page-table attrs) */
+	say("icepcie: ath12k: smmu bank %u SCTLR %08x ACTLR %08x; SMR %08x S2CR %08x\n",
+	    E2A_BANK, io_rd(e5_cb, 0x00), io_rd(e5_cb, 0x04),
+	    e5_gr0 ? io_rd(e5_gr0, 0x800 + 4 * E2A_SMR) : 0,
+	    e5_gr0 ? io_rd(e5_gr0, 0xc00 + 4 * E2A_SMR) : 0);
+	e2_devctl_log("at the fault");
+	/* a zero bank-9 CFSR only covers faults routed to bank 9: the global registers catch unmatched streams (USF) and
+	 * the other banks catch faults we never expect; sweep them so "no SMMU fault" is not an assumption */
+	if (e5_gr0 != 0) {
+		say("icepcie: ath12k: smmu GFSR %08x GFSYNR0 %08x GFSYNR1 %08x\n",
+		    io_rd(e5_gr0, 0x48), io_rd(e5_gr0, 0x50), io_rd(e5_gr0, 0x54));
+	}
+	if (e5_cbs != 0 && e5_cbs_count != 0) {
+		uint32_t hit = 0;
+
+		for (uint32_t b = 0; b < e5_cbs_count; b++) {
+			uint32_t fsr = io_rd(e5_cbs + b * e5_cbs_stride, 0x58);
+
+			if (fsr != 0) {
+				say("icepcie: ath12k: smmu bank %u CFSR %08x FAR %08x_%08x\n", b, fsr,
+				    io_rd(e5_cbs + b * e5_cbs_stride, 0x64), io_rd(e5_cbs + b * e5_cbs_stride, 0x60));
+				hit++;
+			}
+		}
+		if (hit == 0) {
+			say("icepcie: ath12k: smmu banks 0..%u all CFSR 0 (no context bank reported a fault)\n",
+			    e5_cbs_count - 1);
+		}
+	}
+}
+
+void
+hakios_iceland_harvest_init(void)
+{
+	thread_t thread;
+	char name[MAXCOMLEN + 1] = { 0 };
+
+	if (PE_parse_boot_argn("icepathlog", name, sizeof(name)) && name[0] != 0) {
+		strlcpy(pathlog_name, name, sizeof(pathlog_name));
+		say("icepath: failed opens of %s logged (400 at most)\n", pathlog_name);
+	}
+	PE_parse_boot_argn("icedpu", &icedpu, sizeof(icedpu));
+	PE_parse_boot_argn("iceidle", &iceidle, sizeof(iceidle));
+	PE_parse_boot_argn("icehw", &icehw, sizeof(icehw));
+	PE_parse_boot_argn("icewifi", &icewifi, sizeof(icewifi));
+	PE_parse_boot_argn("icepcie", &icepcie, sizeof(icepcie));
+	PE_parse_boot_argn("icepcie_lx", &icepcie_lx, sizeof(icepcie_lx));
+	PE_parse_boot_argn("icedsi", &icedsi, sizeof(icedsi));
+	PE_parse_boot_argn("icespmi", &icespmi, sizeof(icespmi));
+	PE_parse_boot_argn("icegeni", &icegeni, sizeof(icegeni));
+	if ((icegeni == 2 || icegeni == 3) && (icewifi < 2 || icespmi < 3)) {
+		say("icegeni: 23h needs icewifi=2 icespmi=3 (the bt-enable hold): not run\n");
+	}
+	{
+		/*
+		 * scan40 (23bt3, icegeni_bt=3/4): /dev/cu.bluetooth + /dev/uart.bluetooth and RedwoodBT's 'bluetooth' service now,
+		 * at kernel start, as the Xiaomi port does: bluetoothd looks for them as soon as it runs. The address and the
+		 * kernel control follow when the controller is up (hr_start, ~1 min in).
+		 */
+		int bt = 0;
+
+		PE_parse_boot_argn("icegeni_bt", &bt, sizeof(bt));
+		if (bt == 3 || bt == 4) {
+			if (icegeni == 3 && icewifi >= 2 && icespmi >= 3) {
+				hakios_dada_bt_make_node();
+			} else {
+				say("icegeni: 23bt3 needs icegeni=3 icewifi=2 icespmi=3: no bluetooth node made\n");
+			}
+		}
+	}
+	if (icepcie && icewifi < 2) {
+		say("icepcie: needs icewifi=2 in the same run (23c2): PCIe0 not touched\n");
+	}
+	if (!icedpu && !iceidle && !icehw && !icewifi && !icedsi && !icespmi && !icegeni) {
+		return;
+	}
+	say("iceh: icedpu=%d iceidle=%d icehw=%d icewifi=%d (thread starts its steps at 20 s)\n", icedpu, iceidle, icehw,
+	    icewifi);
+	if (kernel_thread_start(harvest_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+#endif /* !defined(XNU_TARGET_OS_OSX) */
diff --git a/bsd/dev/hakios_iceland_net.c b/bsd/dev/hakios_iceland_net.c
new file mode 100644
index 0000000000000000000000000000000000000000..fa7d890098cac89ba26b6bbe1c653fe14f04099a
--- /dev/null
+++ b/bsd/dev/hakios_iceland_net.c
@@ -0,0 +1,1020 @@
+/*
+ * iceland w3-net: the Pad 4's Wi-Fi link handed to macOS's own network stack. Boot-arg icewifi_net, default off.
+ *
+ * The interface is the one macOS has already: the built-in en0 of iokit/Native/NullEthernet (an IOEthernetController of
+ * the collection's own IONetworkingFamily, Ethernet as far as macOS can tell). configd has a service for it and asks for
+ * a DHCP lease on it from the first boot on (runs/wifi-2/20261115-053935: "bpf0 attached to en0 by configd" every ~8 s,
+ * every packet dropped). With icewifi_net that controller carries frames instead of dropping them, and this file is what
+ * stands between it and the station of hakios_iceland_ath12k.c (W2: the join from the private PMK record):
+ *
+ *   en0's output  -> NativeNullEthernet::outputPacket -> hakios_iceland_net_output() -> nw_wifi_tx()
+ *   the station's rx (w2_rx) -> hakios_iceland_net_rx() -> native_null_ethernet_input() -> en0's input
+ *   joined (keys in, port open) -> en0 takes the radio's address, then its link goes up: configd's DHCP follows
+ *   link lost / the run's end   -> en0's link goes down
+ *
+ * The design is UniXNU piano's (lenzhang/UniXNU-xiaomipad8pro dcfbe72, package/PianoWifi/PianoWifiEthernet.cpp and
+ * docs/drivers/wifi.md section 5.2 B: "an Ethernet-like interface, not a Wi-Fi one"; BSD-2-Clause-Patent; ideas, no code
+ * copied): no IO80211, no airportd, nothing in user space. piano makes a second controller and takes en0 over from its
+ * null one; here the null controller itself becomes the carrier, so there is one interface from the start and nothing to
+ * take over.
+ *
+ *   icewifi_net=1   the station's frames on en0. Implies the W2 join (icewifi_join=1); the in-kernel DHCP, ARP and ping
+ *                   of W2 are then left out (one DHCP client per address: configd's). icewifi_join=1 alone stays what
+ *                   it was, the in-kernel test with no interface.
+ *   icewifi_net=2   the self-test, for QEMU and any kernel without the radio: no station; a DHCP server and a gateway
+ *                   are played here (192.0.2.0/24, the documentation network) behind the same two calls, so that the
+ *                   whole path through the controller, the stack and configd runs with no hardware and no network.
+ *   icewifi_net_lan=1   with either: nothing en0 sends leaves the lease's subnet. IPv4 to a host outside it and IPv6
+ *                   that is neither link-local nor multicast are held back here and counted. The lease, ARP, the
+ *                   gateway and a resolver inside the subnet work; macOS's daemons do not reach the internet. For a
+ *                   first run on a real network.
+ *   icewifi_txerr=1     with either (w5-wifi, default off): a frame en0 cannot send is refused with its errno (ENOBUFS when
+ *                   the station's queue is full), not kIOReturnOutputDropped, which the stack reads as ENOENT and which
+ *                   ended uploads at the queue's first full moment (NativeNullEthernet.cpp; piano's finding, 8164c23).
+ *
+ * Never in the log: an Ethernet address, a network's name, a key. IPv4 addresses as x.x.x.N. A DNS question's name is
+ * reduced to its last two labels, and only under com, net, org and arpa.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/if.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+
+#define say(...) printf("icenet: " __VA_ARGS__)
+#define NET_FRAME_MAX   1514
+
+/* iokit/Native/NullEthernet/NativeNullEthernet.cpp */
+extern volatile int native_null_ethernet_state;
+extern int native_null_ethernet_link(int up);
+extern int native_null_ethernet_input(const uint8_t *frame, uint32_t length);
+extern int native_null_ethernet_name(char *name, size_t size);
+extern int native_null_ethernet_address(const uint8_t *address);
+extern void native_null_ethernet_counts(uint64_t *enables, uint64_t *sent, uint64_t *dropped);
+/* the driver object's station (hakios_iceland_ath12k.c): weak, a kernel without ath12k.o still links */
+extern int nw_wifi_tx(const uint8_t *eth, size_t len) __attribute__((weak));
+/* the driver's transmit completion counts as text, "... tqm A B C ...": C is TQM's CMD_REMOVE_TX (sent, never acknowledged) */
+extern void nw_wifi_tx_reasons(char *text, int size) __attribute__((weak));
+
+uint32_t hakios_iceland_net_mode(void);
+void hakios_iceland_net_init(void);
+int hakios_iceland_net_output(mbuf_t packet);
+void hakios_iceland_net_rx(const uint8_t *eth, size_t len);
+void hakios_iceland_net_joined(const uint8_t *mac);
+void hakios_iceland_net_lost(void);
+void hakios_iceland_net_poll(void);
+void hakios_iceland_net_stop(void);
+
+static LCK_GRP_DECLARE(net_grp, "icenet");
+static LCK_MTX_DECLARE(net_tx_lock, &net_grp);
+static uint32_t net_mode, net_lan;
+static bool net_mode_read;
+static volatile int net_up;             /* frames pass */
+static volatile int net_want;           /* the driver's events: 1 joined, 2 lost; hakios_iceland_net_poll() does the work */
+static bool net_pending;                /* the link is to go up as soon as macOS has named the interface */
+static uint8_t net_mac[6];
+static bool net_have_mac;
+static char net_name[IFNAMSIZ] = "en?";
+static uint64_t net_up_ms, net_try_ms, net_said_ms, net_asked_ms;
+/* the frame buffers are allocated by hakios_iceland_net_init() only when icewifi_net asks for them: the kernel's __DATA
+ * has little room left before the collection's retained segments (orchestrator, 15 Nov) */
+static uint8_t *net_tx_frame;           /* NET_FRAME_MAX bytes, under net_tx_lock */
+static uint32_t net_ip, net_mask, net_gw;       /* the lease that passed (host order): for "inside / outside the subnet" */
+
+/* ---- icewifi_txq=1 (w7-wifi): the shim's own transmit queue between en0 and the driver's station queue of 128 ----
+ * The driver's nw_wifi_tx refuses with -2 when its queue is full, and until now the stack saw ENOBUFS at once: TCP
+ * then drops its send window to one segment (piano 8164c23's finding) and, with the driver's own drain stalled,
+ * frames out froze (run w6-conn-1/20261117-200432: 89901 frames out, then nothing for minutes, link still up).
+ * Here the refused packet is duplicated and parked (a ring of NET_TXQ_MAX), and hakios_iceland_net_poll() drains it
+ * once per pass of the driver's loop; ENOBUFS reaches the stack only when the park itself is full. All the queue's
+ * storage is on the heap (the kernel's __DATA has none to spare). */
+#define NET_TXQ_MAX 256
+static bool net_txq_read;               /* icewifi_txq read once */
+static int net_txq_on;                  /* the gate */
+static mbuf_t *net_txq;                 /* NET_TXQ_MAX slots, heap, under net_txq_lock */
+static unsigned net_txq_head, net_txq_n;
+static LCK_MTX_DECLARE(net_txq_lock, &net_grp);
+
+static int
+net_txq_gate(void)
+{
+	if (!net_txq_read) {
+		net_txq_read = true;
+		(void)PE_parse_boot_argn("icewifi_txq", &net_txq_on, sizeof(net_txq_on));
+		if (net_txq_on) {
+			printf("icenet: icewifi_txq=1: en0's output parks in a ring of %u frames and drains on the driver's pass\n",
+			    NET_TXQ_MAX);
+		}
+	}
+	return net_txq_on;
+}
+
+static struct {
+	uint64_t out, out_drop, out_full, in, in_drop, held, out_bytes, in_bytes;
+	int out_last;
+	uint32_t out_txq_parked, out_txq_stalls, out_txq_lost;   /* icewifi_txq: parked, drains that hit a full driver, lost there */
+	uint32_t eapol, ups, downs;
+	uint32_t dhcp_disc, dhcp_req, dhcp_offer, dhcp_ack, dhcp_nak;
+	uint32_t arp_out, arp_in, arp_gw;
+	uint32_t dns_q, dns_a, ntp_out, ntp_in;
+	uint32_t syn_out, syn_far, synack_in, synack_far;
+	uint32_t echo_out, echo_in, echo_far;
+	uint32_t v6_out, v6_in, other_out, other_in;
+} nc;
+
+/* park a refused packet (a duplicate; the caller's packet stays its own). 0 parked, -1 no room or no memory */
+static int
+net_txq_put(mbuf_t packet)
+{
+	mbuf_t dup = NULL;
+	int r = -1;
+
+	if (net_txq == NULL || net_txq_n >= NET_TXQ_MAX || mbuf_dup(packet, MBUF_DONTWAIT, &dup) != 0) {
+		return -1;
+	}
+	lck_mtx_lock(&net_txq_lock);
+	if (net_txq_n < NET_TXQ_MAX) {
+		net_txq[(net_txq_head + net_txq_n) % NET_TXQ_MAX] = dup;
+		net_txq_n++;
+		r = 0;
+	}
+	lck_mtx_unlock(&net_txq_lock);
+	if (r != 0) {
+		mbuf_free(dup);
+	}
+	return r;
+}
+
+/* the ring's frames: the driver takes what it can; what it still refuses goes back to the head and the pass ends.
+ * Called from hakios_iceland_net_poll() (the driver's loop thread), outside net_tx_lock's callers. */
+static void
+net_txq_drain(void)
+{
+	while (net_txq_n != 0) {
+		mbuf_t packet;
+
+		lck_mtx_lock(&net_txq_lock);
+		packet = net_txq[net_txq_head];
+		net_txq[net_txq_head] = NULL;
+		net_txq_head = (net_txq_head + 1) % NET_TXQ_MAX;
+		net_txq_n--;
+		lck_mtx_unlock(&net_txq_lock);
+		if (packet == NULL) {
+			continue;
+		}
+		{
+			size_t length = mbuf_pkthdr_len(packet);
+			int r = -1;
+
+			if (length >= 14 && length <= NET_FRAME_MAX) {
+				lck_mtx_lock(&net_tx_lock);
+				if (mbuf_copydata(packet, 0, length, net_tx_frame) == 0 && nw_wifi_tx != NULL) {
+					r = nw_wifi_tx(net_tx_frame, length);
+				}
+				lck_mtx_unlock(&net_tx_lock);
+			}
+			if (r == 0) {
+				nc.out++;
+				nc.out_bytes += length;
+				mbuf_free(packet);
+			} else {
+				nc.out_txq_stalls++;
+				if (length >= 14 && length <= NET_FRAME_MAX && net_txq_put(packet) == 0) {
+					return;         /* the driver is still full: the rest of the ring stays parked */
+				}
+				mbuf_free(packet);
+				nc.out_drop++;
+				nc.out_last = -2;
+				nc.out_txq_lost++;
+			}
+		}
+	}
+}
+
+/* the ring's frames out (the link is down): everything freed, the counts said once */
+static void
+net_txq_flush(const char *why)
+{
+	unsigned n = 0;
+
+	lck_mtx_lock(&net_txq_lock);
+	for (unsigned i = 0; i < NET_TXQ_MAX; i++) {
+		if (net_txq[i] != NULL) {
+			mbuf_free(net_txq[i]);
+			net_txq[i] = NULL;
+			n++;
+		}
+	}
+	net_txq_head = 0;
+	net_txq_n = 0;
+	lck_mtx_unlock(&net_txq_lock);
+	if (n) {
+		say("icewifi_txq: %u parked frame%s freed at the %s\n", n, n == 1 ? "" : "s", why);
+	}
+}
+
+static uint64_t
+net_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+uint32_t
+hakios_iceland_net_mode(void)
+{
+	if (!net_mode_read) {
+		uint32_t v = 0;
+
+		net_mode_read = true;
+		if (PE_parse_boot_argn("icewifi_net", &v, sizeof(v)) && (v == 1 || v == 2)) {
+			net_mode = v;
+		}
+		v = 0;
+		if (PE_parse_boot_argn("icewifi_net_lan", &v, sizeof(v)) && v == 1) {
+			net_lan = 1;
+		}
+	}
+	return net_mode;
+}
+
+static uint32_t
+get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+static bool
+far(uint32_t ip)
+{
+	return net_mask != 0 && ((ip ^ net_ip) & net_mask) != 0;
+}
+
+/* ---- what goes through, for the log: kinds and counts, nothing that names the network or its hosts ---- */
+
+/* a DNS question's name -> its last two labels under com / net / org / arpa, else "(other)" */
+static void
+dns_name(const uint8_t *q, const uint8_t *end, char *out, size_t size)
+{
+	const uint8_t *label[2] = { NULL, NULL };
+	unsigned n = 0;
+	size_t o = 0;
+
+	strlcpy(out, "(other)", size);
+	while (q < end && *q != 0) {
+		if (*q > 63 || q + 1 + *q > end) {
+			return;
+		}
+		label[0] = label[1];
+		label[1] = q;
+		n++;
+		q += 1 + *q;
+	}
+	if (n < 2 || q >= end) {
+		return;
+	}
+	if (!((label[1][0] == 3 && (memcmp(label[1] + 1, "com", 3) == 0 || memcmp(label[1] + 1, "net", 3) == 0 ||
+	    memcmp(label[1] + 1, "org", 3) == 0)) || (label[1][0] == 4 && memcmp(label[1] + 1, "arpa", 4) == 0))) {
+		return;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		for (unsigned k = 0; k < label[i][0] && o + 2 < size; k++) {
+			uint8_t c = label[i][1 + k];
+
+			out[o++] = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' ? (char)c : '?';
+		}
+		if (i == 0 && o + 1 < size) {
+			out[o++] = '.';
+		}
+	}
+	out[o] = 0;
+}
+
+static const uint8_t *
+dhcp_option(const uint8_t *bp, uint32_t blen, uint8_t want, uint8_t *len)
+{
+	uint32_t o = 240;
+
+	while (o + 2 <= blen && bp[o] != 255) {
+		if (bp[o] == 0) {
+			o++;
+			continue;
+		}
+		if (o + 2u + bp[o + 1] > blen) {
+			break;
+		}
+		if (bp[o] == want) {
+			*len = bp[o + 1];
+			return bp + o + 2;
+		}
+		o += 2u + bp[o + 1];
+	}
+	return NULL;
+}
+
+static void
+note_dhcp(const uint8_t *bp, uint32_t blen, bool out)
+{
+	uint8_t l = 0;
+	const uint8_t *t;
+
+	if (blen < 244 || get32(bp + 236) != 0x63825363 || (t = dhcp_option(bp, blen, 53, &l)) == NULL || l < 1) {
+		return;
+	}
+	if (out) {
+		uint32_t *c = t[0] == 1 ? &nc.dhcp_disc : t[0] == 3 ? &nc.dhcp_req : NULL;
+
+		if (c != NULL && ++*c <= 2) {
+			say("DHCP %s out (%s's own client, configd) at %llu ms\n", t[0] == 1 ? "DISCOVER" : "REQUEST", net_name, net_ms());
+		}
+		return;
+	}
+	if (t[0] == 2) {
+		if (++nc.dhcp_offer <= 2) {
+			say("DHCP OFFER in: address x.x.x.%u at %llu ms\n", bp[19], net_ms());
+		}
+	} else if (t[0] == 5) {
+		uint32_t mask = 0, gw = 0, lease = 0, prefix = 0;
+		unsigned dns = 0;
+		const uint8_t *v;
+
+		if ((v = dhcp_option(bp, blen, 1, &l)) != NULL && l >= 4) {
+			mask = get32(v);
+		}
+		if ((v = dhcp_option(bp, blen, 3, &l)) != NULL && l >= 4) {
+			gw = get32(v);
+		}
+		if ((v = dhcp_option(bp, blen, 6, &l)) != NULL) {
+			dns = l / 4;
+		}
+		if ((v = dhcp_option(bp, blen, 51, &l)) != NULL && l >= 4) {
+			lease = get32(v);
+		}
+		for (uint32_t m = mask; m & 0x80000000u; m <<= 1) {
+			prefix++;
+		}
+		net_ip = get32(bp + 16);
+		net_mask = mask;
+		net_gw = gw;
+		if (++nc.dhcp_ack <= 4) {
+			say("DHCP ACK in: LEASE x.x.x.%u/%u, gateway x.x.x.%u, %u DNS server(s), lease %u s at %llu ms\n", net_ip & 0xff,
+			    prefix, gw & 0xff, dns, lease, net_ms());
+		}
+	} else if (t[0] == 6) {
+		if (++nc.dhcp_nak <= 2) {
+			say("DHCP NAK in at %llu ms\n", net_ms());
+		}
+	}
+}
+
+/* one frame, Ethernet header first, `n` bytes of it in `f` */
+static void
+net_note(const uint8_t *f, size_t n, bool out)
+{
+	uint16_t type = (uint16_t)(f[12] << 8 | f[13]);
+	const uint8_t *ip = f + 14, *l4, *end = f + n;
+	uint32_t ihl, peer;
+
+	if (type == 0x0806 && n >= 14 + 28) {
+		if (out) {
+			nc.arp_out++;
+		} else {
+			nc.arp_in++;
+			if (ip[7] == 2 && net_gw != 0 && get32(ip + 14) == net_gw && nc.arp_gw++ == 0) {
+				say("the gateway x.x.x.%u answered ARP at %llu ms\n", net_gw & 0xff, net_ms());
+			}
+		}
+		return;
+	}
+	if (type == 0x86dd) {
+		if (out) {
+			nc.v6_out++;
+		} else {
+			nc.v6_in++;
+		}
+		return;
+	}
+	if (type != 0x0800 || n < 14 + 20 || (ihl = (ip[0] & 15) * 4u) < 20 || n < 14 + ihl + 8) {
+		if (out) {
+			nc.other_out++;
+		} else {
+			nc.other_in++;
+		}
+		return;
+	}
+	l4 = ip + ihl;
+	peer = get32(ip + (out ? 16 : 12));
+	if (ip[9] == 17) {
+		uint16_t sport = (uint16_t)(l4[0] << 8 | l4[1]), dport = (uint16_t)(l4[2] << 8 | l4[3]);
+
+		if ((out && dport == 67) || (!out && dport == 68)) {
+			note_dhcp(l4 + 8, (uint32_t)(end - (l4 + 8)), out);
+		} else if (out && dport == 53 && l4 + 8 + 12 < end) {
+			if (++nc.dns_q <= 24) {
+				char name[80];
+				const uint8_t *q = l4 + 8 + 12;
+
+				dns_name(q, end, name, sizeof(name));
+				say("DNS question %u out (a resolver in user space asks the lease's server): %s at %llu ms\n", nc.dns_q, name,
+				    net_ms());
+			}
+		} else if (!out && sport == 53 && l4 + 8 + 12 <= end) {
+			if (++nc.dns_a <= 8) {
+				say("DNS answer %u in: rcode %u, %u answer record(s) at %llu ms\n", nc.dns_a, l4[8 + 3] & 15,
+				    l4[8 + 6] << 8 | l4[8 + 7], net_ms());
+			}
+		} else if (out && dport == 123) {
+			nc.ntp_out++;
+		} else if (!out && sport == 123) {
+			if (++nc.ntp_in <= 2) {
+				say("NTP answer in at %llu ms (%s)\n", net_ms(), far(peer) ? "a host outside the subnet" : "inside the subnet");
+			}
+		}
+	} else if (ip[9] == 6 && l4 + 14 <= end) {
+		uint8_t flags = l4[13] & 0x12;
+
+		if (out && flags == 0x02) {
+			nc.syn_far += far(peer);
+			if (++nc.syn_out <= 8) {
+				say("TCP SYN %u out to port %u (%s) at %llu ms\n", nc.syn_out, l4[2] << 8 | l4[3],
+				    far(peer) ? "a host outside the subnet" : "inside the subnet", net_ms());
+			}
+		} else if (!out && flags == 0x12) {
+			nc.synack_far += far(peer);
+			if (++nc.synack_in <= 8) {
+				say("TCP SYN-ACK %u in from port %u (%s) at %llu ms%s\n", nc.synack_in, l4[0] << 8 | l4[1],
+				    far(peer) ? "a host outside the subnet" : "inside the subnet", net_ms(),
+				    far(peer) ? ": user space reaches the internet through en0" : "");
+			}
+		}
+	} else if (ip[9] == 1) {
+		if (out && l4[0] == 8) {
+			if (++nc.echo_out <= 4) {
+				say("ICMP echo request %u out (%s) at %llu ms\n", nc.echo_out, far(peer) ? "a host outside the subnet" :
+				    peer == net_gw ? "the gateway" : "inside the subnet", net_ms());
+			}
+		} else if (!out && l4[0] == 0) {
+			nc.echo_far += far(peer);
+			if (++nc.echo_in <= 8) {
+				say("ICMP echo reply %u in (%s) at %llu ms\n", nc.echo_in, far(peer) ? "a host outside the subnet" :
+				    peer == net_gw ? "the gateway" : "inside the subnet", net_ms());
+			}
+		}
+	}
+}
+
+/* ---- the self-test's network (icewifi_net=2): a DHCP server and a gateway at 192.0.2.1, one client address ---- */
+
+#define ST_NET          0xc0000200u     /* 192.0.2.0/24 (RFC 5737: never routed) */
+#define ST_GW           (ST_NET | 1)
+#define ST_CLIENT       (ST_NET | 2)
+#define ST_Q            8
+#define ST_FRAME        360             /* >= the DHCP answer's 342 bytes */
+static const uint8_t st_gw_mac[6] = { 0x02, 0x49, 0x43, 0x45, 0x4c, 0xfe };    /* made up, locally administered */
+static struct {
+	uint8_t (*frame)[ST_FRAME];     /* ST_Q frames, allocated with the self-test */
+	uint16_t len[ST_Q];
+	unsigned head, tail;
+} stq;                                  /* under net_tx_lock */
+static uint8_t *st_rx_frame;            /* ST_FRAME bytes: the self-test thread's copy of the next answer */
+
+static uint16_t
+ip_sum(const uint8_t *p, uint32_t n)
+{
+	uint32_t s = 0;
+
+	for (uint32_t i = 0; i + 1 < n; i += 2) {
+		s += (uint32_t)p[i] << 8 | p[i + 1];
+	}
+	while (s >> 16) {
+		s = (s & 0xffff) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+static uint8_t *
+st_slot(uint16_t len)
+{
+	uint8_t *f;
+
+	if (stq.head - stq.tail >= ST_Q) {
+		return NULL;
+	}
+	f = stq.frame[stq.head % ST_Q];
+	stq.len[stq.head % ST_Q] = len;
+	stq.head++;
+	bzero(f, ST_FRAME);
+	return f;
+}
+
+/* en0 sent this frame (under net_tx_lock): the answers of the played network are queued for the self-test's thread */
+static int
+st_tx(const uint8_t *f, size_t n)
+{
+	uint16_t type = (uint16_t)(f[12] << 8 | f[13]);
+	const uint8_t *ip = f + 14;
+
+	if (type == 0x0806 && n >= 14 + 28 && ip[7] == 1 && get32(ip + 24) == ST_GW) {
+		uint8_t *r = st_slot(60);
+
+		if (r != NULL) {
+			memcpy(r, f + 6, 6);
+			memcpy(r + 6, st_gw_mac, 6);
+			r[12] = 0x08; r[13] = 0x06;
+			r[14 + 1] = 1; r[14 + 2] = 0x08; r[14 + 4] = 6; r[14 + 5] = 4; r[14 + 7] = 2;
+			memcpy(r + 14 + 8, st_gw_mac, 6);
+			put32(r + 14 + 14, ST_GW);
+			memcpy(r + 14 + 18, ip + 8, 6);
+			memcpy(r + 14 + 24, ip + 14, 4);
+		}
+	} else if (type == 0x0800 && n >= 14 + 20 + 8 + 244 && ip[9] == 17) {
+		uint32_t ihl = (ip[0] & 15) * 4u;
+		const uint8_t *udp = ip + ihl, *bp = udp + 8, *t, *want;
+		uint32_t blen;
+		uint8_t l = 0, kind;
+		uint8_t *r, *rip, *rbp;
+		uint16_t c;
+		enum { bootp = 300, total = 14 + 20 + 8 + bootp };
+
+		if (ihl < 20 || n < 14 + ihl + 8 + 244 || udp[2] != 0 || udp[3] != 67 || bp[0] != 1) {
+			return 0;
+		}
+		blen = (uint32_t)(n - 14 - ihl - 8);
+		if (get32(bp + 236) != 0x63825363 || (t = dhcp_option(bp, blen, 53, &l)) == NULL || l < 1 || (t[0] != 1 && t[0] != 3)) {
+			return 0;
+		}
+		kind = t[0] == 1 ? 2 : 5;       /* DISCOVER -> OFFER, REQUEST -> ACK */
+		want = dhcp_option(bp, blen, 50, &l);
+		if (t[0] == 3 && ((want != NULL && l >= 4 && get32(want) != ST_CLIENT) || (want == NULL && get32(bp + 12) != ST_CLIENT))) {
+			kind = 6;               /* a REQUEST for another address (an old lease): NAK */
+		}
+		if ((r = st_slot(total)) == NULL) {
+			return 0;
+		}
+		memset(r, 0xff, 6);
+		memcpy(r + 6, st_gw_mac, 6);
+		r[12] = 0x08;
+		rip = r + 14;
+		rip[0] = 0x45;
+		rip[2] = (uint8_t)((20 + 8 + bootp) >> 8); rip[3] = (uint8_t)(20 + 8 + bootp);
+		rip[8] = 64; rip[9] = 17;
+		put32(rip + 12, ST_GW);
+		put32(rip + 16, 0xffffffffu);
+		c = ip_sum(rip, 20);
+		rip[10] = (uint8_t)(c >> 8); rip[11] = (uint8_t)c;
+		rip[20 + 1] = 67; rip[20 + 3] = 68;
+		rip[20 + 4] = (uint8_t)((8 + bootp) >> 8); rip[20 + 5] = (uint8_t)(8 + bootp);    /* (UDP checksum 0: none) */
+		rbp = rip + 28;
+		rbp[0] = 2; rbp[1] = 1; rbp[2] = 6;
+		memcpy(rbp + 4, bp + 4, 4);             /* xid */
+		memcpy(rbp + 10, bp + 10, 2);           /* flags */
+		if (kind != 6) {
+			put32(rbp + 16, ST_CLIENT);
+			put32(rbp + 20, ST_GW);
+		}
+		memcpy(rbp + 28, bp + 28, 16);          /* chaddr */
+		put32(rbp + 236, 0x63825363);
+		{
+			uint8_t *o = rbp + 240;
+
+			*o++ = 53; *o++ = 1; *o++ = kind;
+			*o++ = 54; *o++ = 4; put32(o, ST_GW); o += 4;
+			if (kind != 6) {
+				*o++ = 51; *o++ = 4; put32(o, 3600); o += 4;
+				*o++ = 1; *o++ = 4; put32(o, 0xffffff00u); o += 4;
+				*o++ = 3; *o++ = 4; put32(o, ST_GW); o += 4;
+				*o++ = 6; *o++ = 4; put32(o, ST_GW); o += 4;
+			}
+			*o = 255;
+		}
+	}
+	return 0;
+}
+
+/* ---- en0's two directions ---- */
+
+/* icewifi_net_lan=1: would this frame leave the lease's subnet? (Before a lease there is no route out of it.) */
+static bool
+net_leaves(const uint8_t *f, size_t n)
+{
+	uint16_t type = (uint16_t)(f[12] << 8 | f[13]);
+
+	if (type == 0x0800 && n >= 14 + 20) {
+		uint32_t dst = get32(f + 14 + 16);
+
+		return dst != 0xffffffffu && (dst >> 28) != 0xe && far(dst);
+	}
+	if (type == 0x86dd && n >= 14 + 40) {
+		const uint8_t *d = f + 14 + 24;
+
+		return !(d[0] == 0xff || (d[0] == 0xfe && (d[1] & 0xc0) == 0x80));
+	}
+	return false;
+}
+
+/*
+ * NativeNullEthernet::outputPacket: the stack has a frame to send. The packet stays the caller's. 0 = on its way; refused:
+ * ENETDOWN (no link), EMSGSIZE, ENOBUFS (the station's queue of 128 is full: nw_wifi_tx -2, or no copy), or -1 for a frame
+ * icewifi_net_lan held back. With icewifi_txerr=1 the controller hands the errno to the stack (w5-wifi, piano's 8164c23).
+ */
+int
+hakios_iceland_net_output(mbuf_t packet)
+{
+	size_t length = mbuf_pkthdr_len(packet);
+	int r = -1;
+	bool held = false;
+
+	if (!net_up || net_tx_frame == NULL || length < 14 || length > NET_FRAME_MAX) {
+		nc.out_drop++;
+		return !net_up || net_tx_frame == NULL ? ENETDOWN : EMSGSIZE;
+	}
+	lck_mtx_lock(&net_tx_lock);
+	if (mbuf_copydata(packet, 0, length, net_tx_frame) == 0) {
+		net_note(net_tx_frame, length, true);
+		if (net_lan && net_leaves(net_tx_frame, length)) {
+			held = true;
+			if (nc.held++ == 0) {
+				say("icewifi_net_lan=1: the first frame for a host outside the subnet is held back at %llu ms (counted from here on)\n",
+				    net_ms());
+			}
+		} else if (net_mode == 2) {
+			r = st_tx(net_tx_frame, length);
+		} else if (nw_wifi_tx != NULL) {
+			r = nw_wifi_tx(net_tx_frame, length);   /* copies the frame into the station's queue */
+			if (r != 0 && net_txq_gate() && net_txq_put(packet) == 0) {
+				/* icewifi_txq: the driver's queue is full, the frame is parked; the stack is told it is on its way */
+				lck_mtx_unlock(&net_tx_lock);
+				nc.out_txq_parked++;
+				return 0;
+			}
+		}
+	}
+	lck_mtx_unlock(&net_tx_lock);
+	if (r == 0) {
+		nc.out++;
+		nc.out_bytes += length;
+	} else if (!held) {
+		nc.out_drop++;
+		nc.out_last = r;
+		nc.out_full += r == -2;
+	}
+	return r == 0 ? 0 : held ? -1 : ENOBUFS;
+}
+
+static void
+net_input(const uint8_t *eth, size_t len)
+{
+	net_note(eth, len, false);
+	if (native_null_ethernet_input(eth, (uint32_t)len) == 0) {
+		nc.in++;
+		nc.in_bytes += len;
+	} else {
+		nc.in_drop++;
+	}
+}
+
+/* the station received a frame (the driver's thread; Ethernet header first; the buffer stays the caller's) */
+void
+hakios_iceland_net_rx(const uint8_t *eth, size_t len)
+{
+	if (!net_up || len < 14 || len > NET_FRAME_MAX) {
+		nc.in_drop++;
+		return;
+	}
+	if (eth[12] == 0x88 && eth[13] == 0x8e) {
+		nc.eapol++;                     /* the port's own (a group rekey): the station's, not the stack's */
+		return;
+	}
+	net_input(eth, len);
+}
+
+/* ---- the link ---- */
+
+/* the third number after " tqm " in the driver's transmit completion text (TQM's CMD_REMOVE_TX), or -1 */
+static long
+net_unacked(void)
+{
+	char t[200];
+	const char *p = NULL;
+	long v = -1;
+
+	t[0] = 0;
+	if (nw_wifi_tx_reasons == NULL) {
+		return -1;
+	}
+	nw_wifi_tx_reasons(t, sizeof(t));
+	t[sizeof(t) - 1] = 0;
+	for (const char *s = t; *s; s++) {
+		if (s[0] == ' ' && s[1] == 't' && s[2] == 'q' && s[3] == 'm' && s[4] == ' ') {
+			p = s + 4;
+			break;
+		}
+	}
+	for (int k = 0; p != NULL && k < 3; k++) {
+		while (*p == ' ') {
+			p++;
+		}
+		if (*p < '0' || *p > '9') {
+			return -1;
+		}
+		for (v = 0; *p >= '0' && *p <= '9'; p++) {
+			v = v * 10 + (*p - '0');
+		}
+	}
+	return p != NULL ? v : -1;
+}
+
+/* en0's state for the log: its flags and its IPv4 address as x.x.x.N, and what has passed */
+static void
+net_status(const char *why)
+{
+	ifnet_t ifp = NULL;
+	ifaddr_t *list = NULL;
+	char v4[72] = "no IPv4 address";
+	uint64_t enables = 0, sent = 0, dropped = 0;
+	uint32_t flags = 0;
+
+	if (ifnet_find_by_name(net_name, &ifp) == 0 && ifp != NULL) {
+		flags = ifnet_flags(ifp);
+		if (ifnet_get_address_list_family(ifp, &list, AF_INET) == 0 && list != NULL) {
+			if (list[0] != NULL) {
+				struct sockaddr_in a = { 0 }, m = { 0 };
+
+				if (ifaddr_address(list[0], (struct sockaddr *)&a, sizeof(a)) == 0) {
+					const uint8_t *b = (const uint8_t *)&a.sin_addr;
+					uint32_t prefix = 0, ip = get32(b);
+
+					if (ifaddr_netmask(list[0], (struct sockaddr *)&m, sizeof(m)) == 0) {
+						for (uint32_t k = get32((const uint8_t *)&m.sin_addr); k & 0x80000000u; k <<= 1) {
+							prefix++;
+						}
+					}
+					snprintf(v4, sizeof(v4), "IPv4 x.x.x.%u/%u (%s)", b[3], prefix, b[0] == 169 && b[1] == 254 ?
+					    "self-assigned: DHCP was not answered" : ip == net_ip ? "the DHCP lease's" : "not the lease seen here");
+				}
+			}
+			ifnet_free_address_list(list);
+		}
+		ifnet_release(ifp);
+	}
+	native_null_ethernet_counts(&enables, &sent, &dropped);
+	if (net_lan) {
+		say("icewifi_net_lan=1: %llu frames for hosts outside the subnet held back so far\n", nc.held);
+	}
+	if (net_mode == 1) {
+		say("%s: bytes out %llu in %llu; the radio's transmissions never acknowledged (TQM CMD_REMOVE_TX) %ld; queue full %llu\n",
+		    net_name, nc.out_bytes, nc.in_bytes, net_unacked(), nc.out_full);
+		if (net_txq_on) {
+			say("%s: icewifi_txq: parked now %u (of %u), parked once %u, drains that hit a full driver %u, lost there %u\n",
+			    net_name, net_txq_n, NET_TXQ_MAX, nc.out_txq_parked, nc.out_txq_stalls, nc.out_txq_lost);
+		}
+	} else {
+		say("%s: bytes out %llu in %llu\n", net_name, nc.out_bytes, nc.in_bytes);
+	}
+	say("%s: %s flags %#x (UP %u, RUNNING %u), link %s, %s; enables %llu; frames out %llu (refused %llu, last %d) in %llu "
+	    "(dropped %llu); DHCP out D%u R%u in O%u A%u N%u; ARP out %u in %u (gateway %u); DNS questions %u answers %u; "
+	    "TCP SYN out %u (outside %u) SYN-ACK in %u (outside %u); ICMP echo out %u replies %u (outside %u); NTP out %u in %u; "
+	    "IPv6 out %u in %u; other out %u in %u; EAPOL kept %u; ups %u downs %u at %llu ms\n", why, net_name, flags,
+	    (flags & IFF_UP) != 0, (flags & IFF_RUNNING) != 0, net_up ? "up" : "down", v4, enables, nc.out, nc.out_drop, nc.out_last,
+	    nc.in, nc.in_drop, nc.dhcp_disc, nc.dhcp_req, nc.dhcp_offer, nc.dhcp_ack, nc.dhcp_nak, nc.arp_out, nc.arp_in, nc.arp_gw,
+	    nc.dns_q, nc.dns_a, nc.syn_out, nc.syn_far, nc.synack_in, nc.synack_far, nc.echo_out, nc.echo_in, nc.echo_far,
+	    nc.ntp_out, nc.ntp_in, nc.v6_out, nc.v6_in, nc.other_out, nc.other_in, nc.eapol, nc.ups, nc.downs, net_ms());
+}
+
+/* the link goes up once macOS has named NullEthernet's interface (configd, about when the station joins); false: not yet */
+static bool
+net_try_up(void)
+{
+	ifnet_t ifp = NULL;
+	errno_t e = 0;
+
+	if (native_null_ethernet_state != 1 || native_null_ethernet_name(net_name, sizeof(net_name)) != 0 ||
+	    ifnet_find_by_name(net_name, &ifp) != 0 || ifp == NULL) {
+		strlcpy(net_name, "en?", sizeof(net_name));
+		return false;
+	}
+	if (net_have_mac) {
+		/* the station's frames carry the radio's address: the interface takes it (compared and set, never printed) */
+		(void)native_null_ethernet_address(net_mac);
+		e = ifnet_set_lladdr(ifp, net_mac, sizeof(net_mac));
+		/* 20 Nov (macos-diag-1): the set can be refused right after macOS names the interface; with the made-up
+		 * address kept, the router's DHCP answers never reach en0 (169.254 self-assigned, no SSH). Not up yet:
+		 * net_step() asks again every 100 ms for 10 s before the link goes up on the made-up address. No new
+		 * state (the kernel's __DATA has no room): the window is measured from net_asked_ms. */
+		if (e != 0 && net_ms() - net_asked_ms < 10000) {
+			if ((net_ms() - net_asked_ms) % 2000 < 100) {
+				say("%s: the radio's address refused (errno %d) at %llu ms: asked again every 100 ms for 10 s\n",
+				    net_name, e, net_ms() - net_asked_ms);
+			}
+			ifnet_release(ifp);
+			return false;
+		}
+	}
+	ifnet_release(ifp);
+	net_up = 1;
+	net_up_ms = net_said_ms = net_ms();
+	nc.ups++;
+	say("%s: %s (errno %d); the link goes up at %llu ms (%llu ms after it was asked): configd's DHCP is next\n", net_name,
+	    !net_have_mac ? "its own address kept" : e == 0 ? "it takes the radio's address (not printed)" :
+	    "the radio's address was REFUSED for 10 s (frames for it will not arrive)", e, net_up_ms, net_up_ms - net_asked_ms);
+	if (native_null_ethernet_link(1) != 0) {
+		say("%s: the controller did not take the link's state\n", net_name);
+	}
+	return true;
+}
+
+static void
+net_down(const char *why)
+{
+	net_pending = false;
+	if (!net_up) {
+		return;
+	}
+	net_up = 0;
+	nc.downs++;
+	if (net_txq_on) {
+		net_txq_flush(why);
+	}
+	(void)native_null_ethernet_link(0);
+	say("%s: the link goes down (%s) at %llu ms\n", net_name, why, net_ms());
+	net_status("at the link's down");
+}
+
+/* the driver's events, on its thread inside nw_wifi_step(): noted only */
+void
+hakios_iceland_net_joined(const uint8_t *mac)
+{
+	if (hakios_iceland_net_mode() != 1) {
+		return;
+	}
+	memcpy(net_mac, mac, 6);
+	net_have_mac = true;
+	net_want = 1;
+}
+
+void
+hakios_iceland_net_lost(void)
+{
+	if (hakios_iceland_net_mode() != 1) {
+		return;
+	}
+	net_want = 2;
+}
+
+/* what the events asked, the wait for the interface's name, and en0's state every 10 s (the first minute) or 30 s */
+static void
+net_step(void)
+{
+	int want = net_want;
+	uint64_t now = net_ms();
+
+	if (want != 0) {
+		net_want = 0;
+		if (want == 1) {
+			if (net_up) {
+				net_down("a new join");
+			}
+			net_pending = true;
+			net_asked_ms = now;
+			net_try_ms = 0;
+		} else {
+			net_down("the station lost the network");
+		}
+	}
+	if (net_pending && now - net_try_ms >= 100) {
+		net_try_ms = now;
+		if (net_try_up()) {
+			net_pending = false;
+		} else if (now - net_asked_ms >= 5000 && (now - net_asked_ms) % 10000 < 100) {
+			say("the link waits for macOS to name NullEthernet's interface (state %d, %llu ms so far)\n",
+			    native_null_ethernet_state, now - net_asked_ms);
+		}
+	}
+	if (net_up && now - net_said_ms >= (now - net_up_ms < 60000 ? 10000u : 30000u)) {
+		net_said_ms = now;
+		net_status("en0");
+	}
+}
+
+/* once per pass of the driver's loop (hakios_iceland_ath12k.c), outside nw_wifi_step() */
+void
+hakios_iceland_net_poll(void)
+{
+	if (hakios_iceland_net_mode() == 1) {
+		net_step();
+		if (net_txq_on && net_txq_n != 0) {
+			net_txq_drain();
+		}
+	}
+}
+
+/* before nw_wifi_stop(): the link down, and what passed said once more */
+void
+hakios_iceland_net_stop(void)
+{
+	if (hakios_iceland_net_mode() != 1) {
+		return;
+	}
+	net_want = 0;
+	if (net_up) {
+		net_down("the run's end");
+	} else {
+		net_pending = false;
+		net_status("at the run's end (the link never went up)");
+	}
+}
+
+/* icewifi_net=2: the played network instead of the station, on a thread of its own */
+static void
+st_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint8_t *frame = st_rx_frame;
+	uint32_t waited = 0;
+
+	while (native_null_ethernet_state != 1 || native_null_ethernet_name(net_name, sizeof(net_name)) != 0) {
+		if (native_null_ethernet_state < 0 || native_null_ethernet_state == 2 || waited >= 600) {
+			say("self-test: no interface from NullEthernet (state %d) after %u s: nothing is done\n", native_null_ethernet_state,
+			    waited);
+			return;
+		}
+		delay_for_interval(1000, NSEC_PER_MSEC);
+		waited++;
+	}
+	say("self-test (icewifi_net=2): no radio; a DHCP server and a gateway at x.x.x.1 (192.0.2.0/24) are played behind %s; its "
+	    "link goes up in 10 s\n", net_name);
+	delay_for_interval(10000, NSEC_PER_MSEC);
+	net_want = 1;
+	for (;;) {
+		uint16_t len = 0;
+
+		net_step();
+		lck_mtx_lock(&net_tx_lock);
+		if (stq.tail != stq.head) {
+			len = stq.len[stq.tail % ST_Q];
+			memcpy(frame, stq.frame[stq.tail % ST_Q], len);
+			stq.tail++;
+		}
+		lck_mtx_unlock(&net_tx_lock);
+		if (len != 0) {
+			net_input(frame, len);
+		} else {
+			delay_for_interval(10, NSEC_PER_MSEC);
+		}
+	}
+}
+
+/* from hakios_iceland_ath12k_init() (redwood_input_init, before launchd) */
+void
+hakios_iceland_net_init(void)
+{
+	thread_t thread;
+	uint32_t mode = hakios_iceland_net_mode();
+
+	if (mode == 0) {
+		return;
+	}
+	net_tx_frame = kalloc_data(NET_FRAME_MAX, Z_WAITOK | Z_ZERO);
+	if (mode == 1 && net_txq_gate()) {
+		net_txq = kalloc_data(NET_TXQ_MAX * sizeof(mbuf_t), Z_WAITOK | Z_ZERO);
+		if (net_txq == NULL) {
+			net_txq_on = 0;         /* the ring is a nicety, not a requirement */
+			say("icewifi_txq: no memory for the ring: the output path is as before\n");
+		}
+	}
+	if (mode == 2) {
+		stq.frame = kalloc_data(ST_Q * ST_FRAME, Z_WAITOK | Z_ZERO);
+		st_rx_frame = kalloc_data(ST_FRAME, Z_WAITOK | Z_ZERO);
+	}
+	if (net_tx_frame == NULL || (mode == 2 && (stq.frame == NULL || st_rx_frame == NULL))) {
+		/* never given back: a few KB for the life of the system, as the interface itself */
+		say("icewifi_net=%u: no memory for the frame buffers: en0 carries nothing (its link stays down)\n", mode);
+		net_mode = 0;
+		return;
+	}
+	say("icewifi_net=%u: %s\n", mode, mode == 1 ?
+	    "NullEthernet's built-in interface carries the Wi-Fi station's frames; its link is down until a network is joined" :
+	    "the self-test: NullEthernet's built-in interface on a played network, no radio");
+	if (net_lan) {
+		say("icewifi_net_lan=1: frames for hosts outside the lease's subnet are held back\n");
+	}
+	if (mode == 2 && kernel_thread_start(st_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_pcie.c b/bsd/dev/hakios_iceland_pcie.c
new file mode 100644
index 0000000000000000000000000000000000000000..3ac30c19e446c51e15c18dee7017e8b457763414
--- /dev/null
+++ b/bsd/dev/hakios_iceland_pcie.c
@@ -0,0 +1,994 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * hakios_iceland_pcie.c - macOS: the Pad 4's PCIe0 and WCN7860 brought up for the ath12k driver, and put back.
+ *
+ * Boot-arg icepcie_lx=1 (default off: nothing here is mapped, read or written). The iPadOS target does this in
+ * hakios_iceland_harvest.c's thread (wifi_power, pcie_d1, pcie_d2, pcie_e1, pcie_e2a), one boot-arg per step; this
+ * is the same sequence with the values of the last run that reached the scan there through this boot chain
+ * (runs/p4-1/20261113-032100: icewifi=2 icewifi_hpm=1 icepcie=5 icepcie_sid=1 icepcie_lowdma=1 icepcie_sn4=1),
+ * without the steps the ath12k route never uses (harvest's own BHI / MHI / QMI and their arenas). Register names
+ * and values are Linux's (gcc-kaanapali.c, pcie-qcom.c ops_1_9_0, phy-qcom-qmp-pcie.c, pwrseq-qcom-wcn.c,
+ * arm-smmu.c), as harvest.c's comments say step by step.
+ *
+ *   hakios_iceland_pcie_up()       from the driver's thread: true = the link is up and handed to the driver
+ *   hakios_iceland_pcie_stop()     from a thread at the run's end (reset-after): the driver stopped, then the undo
+ *   hakios_iceland_pcie_quiesce()  from loader_return() (A3 re-entry, a panic's end): the undo, no waiting on a thread
+ *
+ * The undo leaves what the bring-up found: bus master off, the apps SMMU's stream 13 invalid again and bank 9
+ * off, the endpoint's BAR and the root port's window, the iATU, the BDF-to-SID table, LTSSM off, PERST# asserted,
+ * the PHY in reset, the clock votes, both GDSCs collapsed, WLAN_EN (gpio16) low. Kept: the RPMh regulator votes
+ * (shared rails, counted with the Bluetooth half: hakios_iceland_wcn_rails_get / _put; a release could take the boot
+ * chain's vote with it, harvest.c:10598-10607) and the bank's CBAR /
+ * CBA2R (the hypervisor refuses the write back to a stage-2 type from EL1, hakios_iceland_adsp.c:3275-3281).
+ *
+ * The apps SMMU (0x15000000) is shared with the UFS (stream 0x60: SMR 0, bank 0). Written here: SMR 13, S2CR 13,
+ * CBAR 9, CBA2R 9 and context bank 9, nothing else; never sCR0 or a global TLB command. SMR 0 / S2CR 0 and bank
+ * 0's SCTLR / TTBR0 are read before the first write and after the undo and compared.
+ *
+ * The firmware and the private network list are not files here (the macOS kit has no md1): the private build links
+ * one packed object (XNU_WIFI_PACK_OBJECT, made outside every repository) into __BOOTDATA, which the kernel gives
+ * back at lockdown; with icepcie_lx=1 it is copied out before that. No object: no firmware, nothing is touched.
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/startup.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include <libkern/crypto/sha2.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void IOSleep(unsigned int milliseconds);
+extern unsigned long gPhysBase, gPhysSize;
+extern boolean_t pmap_valid_page(ppnum_t pn);
+extern uint64_t hakios_normal_nc_lo, hakios_normal_nc_hi;       /* osfmk/arm/pmap/pmap.c */
+extern uint32_t psci_smp_hvc;                                    /* osfmk/arm64/psci_smp.c: 1 = QEMU's virt, not the Pad */
+extern int hakios_iceland_rpmh_vote(const char *name, int32_t mode, uint32_t uv, bool enable);
+extern int hakios_iceland_rpmh_release(const char *name);
+extern int hakios_iceland_rpmh_bcm(const char *name, bool up);
+
+bool hakios_iceland_pcie_up(void);
+int hakios_iceland_wcn_rails_get(const char *who);
+void hakios_iceland_wcn_rails_put(const char *who);
+void hakios_iceland_pcie_stop(void);
+void hakios_iceland_pcie_quiesce(void);
+int hakios_iceland_pcie_stopping(void);
+void hakios_iceland_pcie_driver_done(void);
+const uint8_t *hakios_iceland_wifi_blob(const char *name, uint64_t *size);
+const uint8_t *iceland_ath12k_fw(const char *name, uint32_t *len);
+void iceland_smmu_fault_read(void);
+
+#include "hakios_iceland_pcie_tbl.h"
+
+/* ---- the packed private object: { char name[32]; uint64_t size; data, padded to 8 } ..., weak and empty by default ---- */
+__attribute__((weak, visibility("hidden"))) const uint8_t native_wifi_pack[8] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t native_wifi_pack_size = 0;
+static const uint8_t *pack;
+static uint64_t pack_size;
+
+static void
+wifi_pack_keep(void)
+{
+	uint32_t lx = 0, bt = 0;
+	vm_offset_t va = 0;
+	uint64_t n = native_wifi_pack_size;
+
+	/* kept for the Wi-Fi driver (icepcie_lx=1) or the Bluetooth download (icebt>=2: hakios_iceland_bt.c) */
+	PE_parse_boot_argn("icepcie_lx", &lx, sizeof(lx));
+	PE_parse_boot_argn("icebt", &bt, sizeof(bt));
+	if (n == 0 || (lx == 0 && bt < 2)) {
+		return;
+	}
+	if (kmem_alloc(kernel_map, &va, round_page(n), KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("icepcie: pack: no memory for %llu B\n", n);
+		return;
+	}
+	memcpy((void *)va, native_wifi_pack, (size_t)n);
+	pack = (const uint8_t *)va;
+	pack_size = n;
+	printf("icepcie: pack kept: %llu B\n", n);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, wifi_pack_keep);
+
+const uint8_t *
+hakios_iceland_wifi_blob(const char *name, uint64_t *size)
+{
+	uint64_t o = 0;
+
+	while (pack != NULL && o + 40 <= pack_size) {
+		uint64_t n;
+
+		memcpy(&n, pack + o + 32, 8);
+		if (pack[o] == 0 || pack[o + 31] != 0 || n > pack_size - o - 40) {
+			break;
+		}
+		if (strcmp((const char *)pack + o, name) == 0) {
+			*size = n;
+			return pack + o + 40;
+		}
+		o += 40 + ((n + 7) & ~7ull);
+	}
+	return NULL;
+}
+
+const uint8_t *
+iceland_ath12k_fw(const char *name, uint32_t *len)
+{
+	/* sha256-pinned (iceland-firmware ath12k/WCN7860/hw2.0), as the iPadOS target's md1 fw/ files */
+	static const struct {
+		const char *name, *sha;
+	} files[] = {
+		{ "ath12k_amss.bin", "23811bd6abe91a89ef00057e0a4d2e85ea3d0defcad377334cdef987ec4df820" },
+		{ "ath12k_board.bin", "355578ce4162b885c9371e8df7eac20bb4bcd28c8b9d11cf0bdd5114ec6cfe3c" },
+		{ "ath12k_m3.bin", "c1a1295b1808ba204676c03967aea91effc5d85b55a9d269ba858c5e80c92b9c" },
+		{ "ath12k_aux_ucode.bin", "4db9df6fdac982752f71c513f174da7e22307a769a9d49fd336b054919c9451e" },
+		{ "ath12k_qdss.cfg", "4683d8683437a11172723dc5820801aaaf5eb082336875a7664142582cc90cbb" },
+		{ "ath12k_regdb.bin", "365026525f6a9a1ebf0668b8c61fb1300bfdb2450148e994b9a4ca66257e7e43" },
+	};
+	static const char h[] = "0123456789abcdef";
+	uint64_t size = 0;
+	const uint8_t *d;
+	uint8_t dg[32];
+	char hex[65];
+	SHA256_CTX c;
+	uint32_t i;
+
+	for (i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		if (strcmp(name, files[i].name) == 0) {
+			break;
+		}
+	}
+	if (i == sizeof(files) / sizeof(files[0])) {
+		return NULL;
+	}
+	d = hakios_iceland_wifi_blob(files[i].name, &size);
+	if (d == NULL || size == 0 || size > (16u << 20)) {
+		return NULL;
+	}
+	SHA256_Init(&c);
+	SHA256_Update(&c, d, (size_t)size);
+	SHA256_Final(dg, &c);
+	for (uint32_t k = 0; k < 32; k++) {
+		hex[2 * k] = h[dg[k] >> 4];
+		hex[2 * k + 1] = h[dg[k] & 15];
+	}
+	hex[64] = 0;
+	if (strcmp(hex, files[i].sha) != 0) {
+		return NULL;
+	}
+	if (len != NULL) {
+		*len = (uint32_t)size;
+	}
+	return d;
+}
+
+/*
+ * ---- the driver object's interface (nw_abi.h: nw_wifi_*), weak and inert ----
+ * ld64 does not link the kernel with an undefined weak reference (run w2-wifi trial 1: 29 "Undefined symbols",
+ * every nw_wifi_* the board layer and hakios_iceland_wlan.c declare weak), so a kernel without ath12k.o - every
+ * build but the private one - needs definitions. The private build's ath12k.o defines the same names strong and
+ * wins, as the GPU firmware's images do (hidden for the same reason, hakios_iceland_gpu.c:860-879). Absent is told
+ * by nw_wifi_stats.stage, which the real driver starts at 0.
+ */
+#define NW_WEAK         __attribute__((weak, visibility("hidden")))
+#define NW_ABSENT       0x6e6f6c78u
+struct nw_stats_shape { uint32_t stage, scans, frames, beacons, bss_seen; int last_err; };
+NW_WEAK struct nw_stats_shape nw_wifi_stats = { .stage = NW_ABSENT };
+NW_WEAK volatile uint64_t nw_wifi_where[4];
+NW_WEAK unsigned long long nw_wifi_om_ready_us, nw_wifi_om_step_max;
+NW_WEAK unsigned int nw_wifi_om_ext[16], nw_wifi_om_ext_poll[16], nw_wifi_om_ext_work[16], nw_wifi_om_ce_svc[16];
+NW_WEAK unsigned int nw_wifi_om_ce_rx[16], nw_wifi_om_ce_tx[16], nw_wifi_om_irq_num[64], nw_wifi_om_irq_calls[64];
+NW_WEAK unsigned char nw_wifi_om_irq_dp[64];
+NW_WEAK unsigned int nw_wifi_om_step_hist[6], nw_wifi_om_cmds, nw_wifi_om_evts, nw_wifi_om_quiet;
+#define NW_NONE(name)   NW_WEAK int name(void); NW_WEAK int name(void) { return -1; }
+NW_NONE(nw_wifi_start) NW_NONE(nw_wifi_step) NW_NONE(nw_wifi_scan) NW_NONE(nw_wifi_bss_count) NW_NONE(nw_wifi_bss_get)
+NW_NONE(nw_wifi_connect) NW_NONE(nw_wifi_disconnect) NW_NONE(nw_wifi_tx)
+#define NW_VOID(name)   NW_WEAK void name(void); NW_WEAK void name(void) { }
+NW_VOID(nw_wifi_stop) NW_VOID(nw_wifi_set_events) NW_VOID(nw_wifi_status_get) NW_VOID(nw_wifi_tx_reasons)
+
+/* ---- the board layer's getters (hakios_iceland_ath12k.c) ---- */
+vm_offset_t iceland_ath12k_bar;      /* the endpoint's MHI BAR */
+vm_offset_t iceland_ath12k_conf;     /* the endpoint's config space */
+uint64_t iceland_ath12k_dma_pa;      /* the DMA arena's bus base (IOVA == PA) */
+vm_offset_t iceland_ath12k_dma_va;
+uint32_t iceland_ath12k_dma_size;
+uint64_t iceland_ath12k_msi;         /* the MSI sink (inside the 1 MB buffer) */
+
+/* ---- registers ---- */
+#define GCC_PA          0x00100000u
+#define TLMM_PA         0x0f100000u
+#define SMMU_PA         0x15000000u
+#define SMR_N           13u
+#define BANK_N          9u
+#define ASID_N          10u
+#define CBAR_OURS       (1u << 16 | 3u << 8 | 0xfu << 12)       /* 0x1f300: stage 1, stage 2 bypass, NSH, WB */
+#define BUF_SIZE        (1u << 20)
+#define Q_ARENA         (52u << 20)
+#define EP_ID           0x110e17cbu
+
+/* what is done, for the undo */
+#define D_PWR   0x001u  /* gpio16 high */
+#define D_GDSC  0x002u
+#define D_CLK   0x004u
+#define D_D2    0x008u  /* PERST# driven, the rchng RCG changed */
+#define D_PHY   0x010u
+#define D_LTSSM 0x020u
+#define D_SID   0x040u
+#define D_ATU0  0x080u
+#define D_E1    0x100u
+#define D_SMMU  0x200u
+#define D_BM    0x400u
+#define D_SN4   0x800u
+#define D_RAIL  0x1000u /* the PMU's rails taken (hakios_iceland_wcn_rails_get) */
+
+static vm_offset_t gcc, tcsr, parf, phy, dbi, atu, cfg, p16, p18, p102, gr0, gr1, cb, cb0;
+static struct {
+	uint32_t c16, i16, c102, i102, rcg, mux, pd, g0, g1, v0, v8, v18, t0, sidcfg, smr, s2cr, epcmd, bar0, bar1, rpcmd,
+	    rpwin, xcap, ufs[4];
+	bool bar64;
+} f;                                    /* as found */
+static uint32_t sidtbl[256];
+static volatile uint32_t done, down_once, stop_req, drv_done, drv_run, up_busy;
+static uint64_t buf_pa, q_pa;
+static vm_offset_t q_va;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+/* every write: the value before, the value written, the read-back */
+static void
+pw(vm_offset_t b, const char *n, uint32_t o, uint32_t v)
+{
+	uint32_t was = rd(b, o);
+
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("icepcie: %s +%x %08x > %08x = %08x\n", n, o, was, v, rd(b, o));
+}
+
+static vm_offset_t
+iomap(uint64_t pa, vm_size_t n)
+{
+	return ml_io_map_unmappable((vm_offset_t)pa, n, VM_WIMG_IO);
+}
+
+static void
+clean(vm_offset_t va, vm_size_t size)
+{
+	for (vm_offset_t l = va & ~63ul; l < va + size; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+link_is_up(void)
+{
+	return dbi != 0 && f.xcap != 0 && ((rd(dbi, f.xcap + 0x10) >> 29) & 1);
+}
+
+/* ---- the apps SMMU: SMR 13 -> bank 9 for PCIe0's streams 0x1400 / 0x1401 (harvest.c pcie_e2a) ---- */
+static void
+ufs_census(const char *when, bool compare)
+{
+	uint32_t v[4] = { rd(gr0, 0x800), rd(gr0, 0xc00), cb0 ? rd(cb0, 0x0) : 0, cb0 ? rd(cb0, 0x20) : 0 };
+
+	printf("icepcie: smmu UFS %s: SMR0 %08x S2CR0 %08x bank0 SCTLR %08x TTBR0 %08x%s\n", when, v[0], v[1], v[2], v[3],
+	    !compare ? "" : memcmp(v, f.ufs, sizeof(v)) == 0 ? " (unchanged)" : " (CHANGED)");
+	if (!compare) {
+		memcpy(f.ufs, v, sizeof(v));
+	}
+}
+
+static bool
+smmu_on(void)
+{
+	uint32_t id0, id1, nsmr, ncb, page, numpage, cbar0, sctlr0;
+	uint64_t low = 0, mb = 0, *l1, *l2, *l3, *lq;
+	vm_offset_t tables = 0, qt = 0, buf;
+
+	gr0 = iomap(SMMU_PA, 0x1000);
+	if (gr0 == 0) {
+		return false;
+	}
+	id0 = rd(gr0, 0x20);
+	id1 = rd(gr0, 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	numpage = 1u << (((id1 >> 28) & 7) + 1);
+	gr1 = iomap(SMMU_PA + page, 0x1000);
+	cb = iomap(SMMU_PA + (uint64_t)(numpage + BANK_N) * page, 0x1000);
+	if (gr1 == 0 || cb == 0 || SMR_N >= nsmr || BANK_N >= ncb) {
+		printf("icepcie: smmu REFUSED: %u SMRs, %u banks\n", nsmr, ncb);
+		return false;
+	}
+	/* the UFS's bank (S2CR 0's), for the census's reads */
+	if (((rd(gr0, 0xc00) >> 16) & 3) == 0 && (rd(gr0, 0xc00) & 0xff) < ncb) {
+		cb0 = iomap(SMMU_PA + (uint64_t)(numpage + (rd(gr0, 0xc00) & 0xff)) * page, 0x1000);
+	}
+	f.smr = rd(gr0, 0x800 + 4 * SMR_N);
+	f.s2cr = rd(gr0, 0xc00 + 4 * SMR_N);
+	cbar0 = rd(gr1, 4 * BANK_N);
+	sctlr0 = rd(cb, 0);
+	printf("icepcie: smmu as found: SMR%u %08x S2CR %08x; bank %u CBAR %08x SCTLR %08x (%u SMRs, %u banks)\n", SMR_N, f.smr,
+	    f.s2cr, BANK_N, cbar0, sctlr0, nsmr, ncb);
+	if ((f.smr >> 31) || (sctlr0 & 1) || (cbar0 != 0 && cbar0 != CBAR_OURS)) {
+		printf("icepcie: smmu REFUSED: SMR %u or bank %u not free\n", SMR_N, BANK_N);
+		return false;
+	}
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = rd(gr0, 0x800 + 4 * i), s2cr = rd(gr0, 0xc00 + 4 * i);
+
+		if (!(smr >> 31)) {
+			continue;
+		}
+		if ((((0x1400u ^ smr) & ~(smr >> 16) & 0x7fff) == 0) || (((0x1401u ^ smr) & ~(smr >> 16) & 0x7fff) == 0) ||
+		    (((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == BANK_N)) {
+			printf("icepcie: smmu REFUSED: SMR %u (%08x, S2CR %08x) has PCIe0's streams or bank %u\n", i, smr, s2cr, BANK_N);
+			return false;
+		}
+	}
+	/* the arenas: the loader's lowdma window, outside everything the kernel manages */
+	if (!PE_parse_boot_argn("lowdma", &low, sizeof(low)) || !PE_parse_boot_argn("lowdma_mb", &mb, sizeof(mb)) ||
+	    low == 0 || (low & 0x1fffff) || mb < 80 || low + (mb << 20) > 0x100000000ULL) {
+		printf("icepcie: REFUSED: no lowdma= / lowdma_mb= (2 MB aligned, 80 MB or more, below 4 GB)\n");
+		return false;
+	}
+	buf_pa = low + (4ull << 20);
+	q_pa = low + (24ull << 20);
+	for (uint64_t pa = buf_pa; pa < q_pa + Q_ARENA; pa += 0x100000) {
+		if ((pa >= gPhysBase && pa < (uint64_t)gPhysBase + gPhysSize) || pmap_valid_page((ppnum_t)atop_64(pa))) {
+			printf("icepcie: REFUSED: lowdma page %#llx is the kernel's memory\n", pa);
+			return false;
+		}
+	}
+	if ((buf_pa >> 30) != ((q_pa + Q_ARENA - 1) >> 30)) {
+		printf("icepcie: REFUSED: lowdma crosses a 1 GB slot\n");
+		return false;
+	}
+	hakios_normal_nc_lo = buf_pa;
+	hakios_normal_nc_hi = q_pa + Q_ARENA;
+	buf = ml_io_map_wcomb((vm_offset_t)buf_pa, BUF_SIZE);
+	q_va = ml_io_map_wcomb((vm_offset_t)q_pa, Q_ARENA);
+	/* 4 KB tables whatever the kernel's page size: level 1 / 2 / 3 (the buffer), 26 level-3 tables (the arena) */
+	if (buf == 0 || q_va == 0 ||
+	    kmem_alloc(kernel_map, &tables, 3 * 0x1000, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &qt, 26 * 0x1000, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("icepcie: REFUSED: arenas or tables not mapped\n");
+		return false;
+	}
+	bzero((void *)buf, BUF_SIZE);
+	bzero((void *)q_va, Q_ARENA);
+	l1 = (uint64_t *)tables;
+	l2 = (uint64_t *)(tables + 0x1000);
+	l3 = (uint64_t *)(tables + 0x2000);
+	lq = (uint64_t *)qt;
+	l1[(buf_pa >> 30) & 0x1ff] = kvtophys(tables + 0x1000) | 3;
+	l2[(buf_pa >> 21) & 0x1ff] = kvtophys(tables + 0x2000) | 3;
+	/* Normal non-cacheable (AttrIndx 0), outer shareable, access flag, read/write, nG, XN; IOVA == PA */
+	for (uint32_t i = 0; i < BUF_SIZE / 0x1000; i++) {
+		l3[((buf_pa >> 12) & 0x1ff) + i] = (buf_pa + i * 0x1000ull) | 3 | 1ull << 10 | 2ull << 8 | 1ull << 6 | 1ull << 11 |
+		    3ull << 53;
+	}
+	for (uint32_t k = 0; k < Q_ARENA >> 21; k++) {
+		l2[((q_pa >> 21) & 0x1ff) + k] = kvtophys(qt + k * 0x1000) | 3;
+	}
+	for (uint32_t i = 0; i < Q_ARENA / 0x1000; i++) {
+		lq[i] = (q_pa + i * 0x1000ull) | 3 | 1ull << 10 | 2ull << 8 | 1ull << 6 | 1ull << 11 | 3ull << 53;
+	}
+	clean(tables, 3 * 0x1000);
+	clean(qt, 26 * 0x1000);
+	printf("icepcie: arenas: 1 MB at %#llx, %u MB at %#llx, tables %#llx\n", buf_pa, Q_ARENA >> 20, q_pa,
+	    (uint64_t)kvtophys(tables));
+	ufs_census("before", false);
+	/* a census that reads all-ones is not a census: stop before the first write */
+	if (f.ufs[0] == 0xffffffffu || f.ufs[1] == 0xffffffffu || (cb0 != 0 && (f.ufs[2] == 0xffffffffu || f.ufs[3] == 0xffffffffu))) {
+		printf("icepcie: smmu REFUSED: the UFS census reads all-ones: nothing written\n");
+		return false;
+	}
+	done |= D_SMMU;
+	pw(gr1, "CBA2R", 0x800 + 4 * BANK_N, 1);
+	pw(gr1, "CBAR", 4 * BANK_N, CBAR_OURS);
+	pw(cb, "TCR2", 0x10, 2u | 7u << 15);
+	pw(cb, "TTBR0lo", 0x20, (uint32_t)kvtophys(tables));
+	pw(cb, "TTBR0hi", 0x24, (uint32_t)(kvtophys(tables) >> 32) | ASID_N << 16);
+	pw(cb, "TCR", 0x30, 1u << 23 | 3u << 12 | 1u << 10 | 1u << 8 | 32u);
+	pw(cb, "MAIR0", 0x38, 0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24);
+	pw(cb, "MAIR1", 0x3c, 0);
+	pw(cb, "TLBIASID", 0x610, ASID_N);
+	pw(cb, "TLBSYNC", 0x7f0, 0);
+	for (int i = 0; i < 1000 && (rd(cb, 0x7f4) & 1); i++) {
+		delay(10);
+	}
+	pw(cb, "FSR", 0x58, rd(cb, 0x58));
+	pw(cb, "SCTLR", 0x0, 1u << 5 | 1u << 2 | 1u << 1 | 1u << 0 | 1u << 12);
+	pw(gr0, "S2CR", 0xc00 + 4 * SMR_N, BANK_N);
+	pw(gr0, "SMR", 0x800 + 4 * SMR_N, 1u << 31 | 1u << 16 | 0x1400u);
+	IOSleep(100);
+	/* FSR bits 10:9 are the format, not a fault */
+	if ((rd(cb, 0x58) & ~0x600u) != 0) {
+		printf("icepcie: smmu FAULT on bank %u: FSR %08x FAR %08x_%08x\n", BANK_N, rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60));
+		return false;
+	}
+	printf("icepcie: smmu PASS: SMR %u -> bank %u, no fault\n", SMR_N, BANK_N);
+	return true;
+}
+
+/* SMR invalid first (the streams fault again, as found), S2CR as found, the bank off; CBAR / CBA2R stay (see the top) */
+static void
+smmu_off(void)
+{
+	pw(gr0, "SMR", 0x800 + 4 * SMR_N, f.smr);
+	pw(gr0, "S2CR", 0xc00 + 4 * SMR_N, f.s2cr);
+	pw(cb, "SCTLR", 0x0, 0);
+	pw(cb, "TLBIASID", 0x610, ASID_N);
+	pw(cb, "TLBSYNC", 0x7f0, 0);
+	for (int i = 0; i < 1000 && (rd(cb, 0x7f4) & 1); i++) {
+		delay(10);
+	}
+	pw(cb, "FSR", 0x58, rd(cb, 0x58));
+	pw(cb, "TTBR0lo", 0x20, 0);
+	pw(cb, "TTBR0hi", 0x24, 0);
+	pw(cb, "TCR", 0x30, 0);
+	pw(cb, "TCR2", 0x10, 0);
+	pw(cb, "MAIR0", 0x38, 0);
+	ufs_census("after", true);
+}
+
+/* the ath12k driver's crash handler: reads only */
+void
+iceland_smmu_fault_read(void)
+{
+	if (cb == 0 || gr0 == 0) {
+		return;
+	}
+	printf("icepcie: smmu bank %u FSR %08x FAR %08x_%08x FSYNR0 %08x; GFSR %08x GFSYNR0 %08x GFSYNR1 %08x\n", BANK_N,
+	    rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60), rd(cb, 0x68), rd(gr0, 0x48), rd(gr0, 0x50), rd(gr0, 0x54));
+	if (link_is_up()) {
+		printf("icepcie: rp lnk %08x ltssm %02x; ep id %08x\n", rd(dbi, f.xcap + 0x10), rd(dbi, 0x728) & 0x3f, rd(cfg, 0));
+	}
+}
+
+/* ---- the BDF -> stream table (PARF + 0x2000, CFG + 0x2c00), after link-up, as qcom_pcie_config_sid_1_9_0 ---- */
+static uint8_t
+sid_crc8(uint16_t rid)
+{
+	uint8_t p[2] = { (uint8_t)(rid >> 8), (uint8_t)rid }, c = 0;
+
+	for (int i = 0; i < 2; i++) {
+		c ^= p[i];
+		for (int k = 0; k < 8; k++) {
+			c = (c & 0x80) ? (uint8_t)((c << 1) ^ 0x07) : (uint8_t)(c << 1);
+		}
+	}
+	return c;
+}
+
+static void
+sid_on(void)
+{
+	static const uint16_t rid[2] = { 0x0000, 0x0100 };
+	vm_offset_t t = parf + 0x2000;
+
+	f.sidcfg = rd(t, 0xc00);
+	for (int i = 0; i < 256; i++) {
+		sidtbl[i] = rd(t, 4 * i);
+	}
+	done |= D_SID;
+	pw(t, "sidcfg", 0xc00, f.sidcfg & ~1u);
+	for (int i = 0; i < 256; i++) {
+		*(volatile uint32_t *)(t + 4 * i) = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int j = 0; j < 2; j++) {
+		uint8_t h = sid_crc8(rid[j]);
+		uint32_t v = rd(t, 4 * h);
+
+		while (v != 0) {
+			uint8_t cur = h++;
+
+			if (!(v & 0xff)) {
+				*(volatile uint32_t *)(t + 4 * cur) = v | h;
+			}
+			v = rd(t, 4 * h);
+		}
+		pw(t, "sid", 4 * h, (uint32_t)rid[j] << 16 | (uint32_t)j << 8);
+	}
+}
+
+static void
+sid_off(void)
+{
+	vm_offset_t t = parf + 0x2000;
+
+	for (int i = 0; i < 256; i++) {
+		*(volatile uint32_t *)(t + 4 * i) = sidtbl[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	pw(t, "sidcfg", 0xc00, f.sidcfg);
+}
+
+/*
+ * ---- the WCN7860 PMU's inputs, shared with the Bluetooth half (hakios_iceland_bt.c), counted ----
+ * The DT's wcn7860-pmu supplies and RPMH_RF_CLK1. Each half takes them before its own enable pin goes high
+ * (WLAN_EN gpio16 here, bt-enable PMIC GPIO 5 there) and gives them back after that pin is low again. Every take
+ * sends the seven votes (the same commands again if the other half sent them; hakios_iceland_rpmh_vote serialises).
+ * When the count returns to 0 the votes are still KEPT: a release could take the boot chain's vote with it
+ * (harvest.c:10598-10607). So no undo of either half can take a rail from the other, and the log shows the count.
+ * Atomics only: the give runs in pcie_down / bt_down, also at a panic's end with the other cores stopped.
+ */
+static volatile uint32_t wcn_rail_users;
+
+int
+hakios_iceland_wcn_rails_get(const char *who)
+{
+	static const struct {
+		const char *name;
+		int32_t mode;
+		uint32_t uv;
+	} rails[] = {
+		{ "L2G_E0", 5, 1800000 }, { "L3G_E0", 5, 1200000 }, { "S1J_E1", 7, 0 }, { "S2J_E1", 7, 0 }, { "S7F_E0", 7, 0 },
+		{ "S8F_E0", 7, 0 }, { "C1A_E0", -1, 0 },
+	};
+
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		int r = hakios_iceland_rpmh_vote(rails[i].name, rails[i].mode, rails[i].uv, true);
+
+		if (r != 0) {
+			printf("wcnpmu: %s: vote %s -> %d: not taken\n", who, rails[i].name, r);
+			return r;
+		}
+	}
+	printf("wcnpmu: %s takes L2G L3G S1J S2J S7F S8F C1A: users %u\n", who, __sync_add_and_fetch(&wcn_rail_users, 1));
+	return 0;
+}
+
+void
+hakios_iceland_wcn_rails_put(const char *who)
+{
+	uint32_t n = wcn_rail_users;
+
+	while (n != 0 && !__sync_bool_compare_and_swap(&wcn_rail_users, n, n - 1)) {
+		n = wcn_rail_users;
+	}
+	printf("wcnpmu: %s gives the rails back: users %u%s\n", who, n ? n - 1 : 0,
+	    n == 0 ? " (it held none)" : n == 1 ? "; the votes are kept (boot chain)" : "");
+}
+
+/* ---- the chip's power (pwrseq-qcom-wcn; harvest.c wifi_power level 2 with icewifi_hpm=1) ---- */
+static bool
+wcn_power(void)
+{
+	p16 = iomap(TLMM_PA + 0x1000u * 16, 0x1000);
+	p18 = iomap(TLMM_PA + 0x1000u * 18, 0x1000);
+	p102 = iomap(TLMM_PA + 0x1000u * 102, 0x1000);
+	if (p16 == 0 || p18 == 0 || p102 == 0) {
+		return false;
+	}
+	f.c16 = rd(p16, 0);
+	f.i16 = rd(p16, 4);
+	printf("icepcie: as found: gpio16 %08x/%08x gpio18 %08x/%08x\n", f.c16, f.i16, rd(p18, 0), rd(p18, 4));
+	if (((f.c16 >> 2) & 0xf) != 0 || (((f.c16 >> 9) & 1) && ((f.i16 >> 1) & 1))) {
+		printf("icepcie: REFUSED: gpio16 is not a plain GPIO left low\n");
+		return false;
+	}
+	if (hakios_iceland_wcn_rails_get("icepcie") != 0) {
+		printf("icepcie: REFUSED: the PMU's rails are not voted\n");
+		return false;
+	}
+	done |= D_RAIL;
+	IOSleep(20);
+	done |= D_PWR;
+	pw(p16, "gpio16io", 4, f.i16 | 2u);
+	pw(p16, "gpio16", 0, (f.c16 & ~(0xfu << 2)) | (1u << 9));
+	IOSleep(50);
+	printf("icepcie: gpio18 (sw_ctrl) %08x\n", rd(p18, 4));
+	if (!(rd(p18, 4) & 1)) {
+		printf("icepcie: REFUSED: the chip's power-up did not hold\n");
+		return false;
+	}
+	return true;
+}
+
+/* ---- PCIe0's power and clocks (harvest.c pcie_d1) ---- */
+static bool
+gdsc_on(uint32_t off)
+{
+	pw(gcc, "gdsc", off, rd(gcc, off) & ~1u);
+	for (int i = 0; i < 1000; i++) {
+		if (rd(gcc, off) >> 31) {
+			return true;
+		}
+		delay(100);
+	}
+	printf("icepcie: gdsc +%x NOT on (%08x)\n", off, rd(gcc, off));
+	return false;
+}
+
+static bool
+pcie_power(void)
+{
+	gcc = iomap(GCC_PA, 0x70000);
+	tcsr = iomap(0x01fc0000u + 0x15000u, 0x1000);
+	if (gcc == 0 || tcsr == 0) {
+		return false;
+	}
+	f.g0 = rd(gcc, 0x6b004);
+	f.g1 = rd(gcc, 0x6c000);
+	f.v0 = rd(gcc, 0x52000);
+	f.v8 = rd(gcc, 0x52008);
+	f.v18 = rd(gcc, 0x52018);
+	f.t0 = rd(tcsr, 0x44);
+	printf("icepcie: as found: gdsc %08x phy gdsc %08x votes %08x %08x %08x clkref %08x\n", f.g0, f.g1, f.v0, f.v8, f.v18,
+	    f.t0);
+	if ((f.g0 >> 31) || (f.g1 >> 31)) {
+		printf("icepcie: REFUSED: a PCIe GDSC is already on\n");
+		return false;
+	}
+	if (hakios_iceland_rpmh_vote("L3I_E0", 5, 880000, true) != 0 || hakios_iceland_rpmh_vote("L1D_E0", 5, 1200000, true) != 0) {
+		printf("icepcie: REFUSED: a PHY supply vote was not done\n");
+		return false;
+	}
+	done |= D_GDSC;
+	if (!gdsc_on(0x6b004) || !gdsc_on(0x6c000)) {
+		return false;
+	}
+	done |= D_CLK;
+	pw(tcsr, "clkref", 0x44, f.t0 | 1u);
+	pw(gcc, "gcc", 0x52008, f.v8 | 0x6fu);
+	pw(gcc, "gcc", 0x52000, f.v0 | (1u << 12) | (1u << 19) | (1u << 22));
+	pw(gcc, "gcc", 0x52018, f.v18 | (1u << 31));
+	delay(1000);
+	/* cfg_ahb, aux, phy_aux, phy_rchng running and the PHY's GDSC on, or the PHY's registers are not touched */
+	if ((rd(gcc, 0x6b040) >> 31) || (rd(gcc, 0x6b044) >> 31) || (rd(gcc, 0x6b054) >> 31) || (rd(gcc, 0x6b074) >> 31) ||
+	    !(rd(gcc, 0x6c000) >> 31)) {
+		printf("icepcie: REFUSED: clocks %08x %08x %08x %08x phy gdsc %08x\n", rd(gcc, 0x6b040), rd(gcc, 0x6b044),
+		    rd(gcc, 0x6b054), rd(gcc, 0x6b074), rd(gcc, 0x6c000));
+		return false;
+	}
+	return true;
+}
+
+/* ---- the PHY, PERST#, the link, the config window, the BAR (harvest.c pcie_d2, pcie_e1) ---- */
+static bool
+pcie_link(void)
+{
+	static const uint32_t blk[5][2] = { { 0x1000, 0x1000 }, { 0x0000, 0x0800 }, { 0x0200, 0x0a00 }, { 0x1400, 0x1400 },
+		                            { 0x1800, 0x1800 } };
+	uint32_t lnk = 0, size, v;
+	int i;
+
+	parf = iomap(0x01c00000u, 0x3000);
+	phy = iomap(0x01c06000u, 0x2000);
+	dbi = iomap(0x40000000u, 0x2000);
+	if (parf == 0 || phy == 0 || dbi == 0) {
+		return false;
+	}
+	atu = dbi + 0x1000;
+	f.c102 = rd(p102, 0);
+	f.i102 = rd(p102, 4);
+	f.rcg = rd(gcc, 0x6b07c);
+	f.mux = rd(gcc, 0x6b090);
+	f.pd = rd(phy, 0x1440);
+	done |= D_D2;
+	/* PERST# asserted; rchng 100 MHz */
+	pw(p102, "gpio102io", 4, f.i102 & ~2u);
+	pw(p102, "gpio102", 0, (f.c102 & ~(0xfu << 2)) | (1u << 9));
+	pw(gcc, "gcc", 0x6b07c, (f.rcg & ~0x7ffu) | 0x605u);
+	pw(gcc, "gcc", 0x6b078, rd(gcc, 0x6b078) | 1u);
+	for (i = 0; i < 100 && (rd(gcc, 0x6b078) & 1u); i++) {
+		delay(100);
+	}
+	if (rd(gcc, 0x6b078) & 1u) {
+		printf("icepcie: rchng update NOT done\n");
+		return false;
+	}
+	done |= D_PHY;
+	/* PHY and controller resets, PARF */
+	pw(gcc, "gcc", 0x6c01c, 1);
+	pw(gcc, "gcc", 0x6c028, 1);
+	delay(1000);
+	pw(gcc, "gcc", 0x6c01c, 0);
+	pw(gcc, "gcc", 0x6b000, 1);
+	delay(1000);
+	pw(gcc, "gcc", 0x6b000, 0);
+	delay(1000);
+	pw(parf, "parf", 0x1000, 4);
+	pw(parf, "parf", 0x40, rd(parf, 0x40) & ~1u);
+	pw(parf, "parf", 0x350, 0x40000000u);
+	pw(parf, "parf", 0x354, 0);
+	pw(parf, "parf", 0x634, 0x40001000u);
+	pw(parf, "parf", 0x638, 0);
+	pw(parf, "parf", 0x358, 0);
+	pw(parf, "parf", 0x35c, 0x80000000u);
+	pw(parf, "parf", 0x0, rd(parf, 0x0) & ~(1u << 29));
+	pw(parf, "parf", 0x174, rd(parf, 0x174) | (1u << 4));
+	pw(parf, "parf", 0x20, rd(parf, 0x20) & ~(1u << 5));
+	pw(parf, "parf", 0x1a8, rd(parf, 0x1a8) | (1u << 31));
+	/* the PHY: its table (not logged line by line: hakios_iceland_pcie_tbl.h), the pipe clock, start */
+	pw(phy, "phy", 0x1440, rd(phy, 0x1440) | 3u);
+	for (unsigned t = 0; t < sizeof(pcie0_phy_tbl) / sizeof(pcie0_phy_tbl[0]); t++) {
+		unsigned b = pcie0_phy_tbl[t].block, lanes = (b == QB_TX || b == QB_RX) ? 2 : 1;
+
+		for (unsigned l = 0; l < lanes; l++) {
+			if (pcie0_phy_tbl[t].lane != 0 && pcie0_phy_tbl[t].lane != l + 1) {
+				continue;
+			}
+			*(volatile uint32_t *)(phy + blk[b][l] + pcie0_phy_tbl[t].off) = pcie0_phy_tbl[t].val;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+	}
+	pw(gcc, "gcc", 0x6b090, 0);
+	pw(gcc, "gcc", 0x52008, rd(gcc, 0x52008) | (1u << 4));
+	pw(gcc, "gcc", 0x6c028, 0);
+	pw(phy, "phy", 0x1400, rd(phy, 0x1400) & ~1u);
+	pw(phy, "phy", 0x1444, rd(phy, 0x1444) | 3u);
+	delay(1000);
+	for (i = 0; i < 100 && (rd(phy, 0x1414) & 0x80u); i++) {
+		delay(100);
+	}
+	if (rd(phy, 0x1414) & 0x80u) {
+		printf("icepcie: PHY NOT ready (%08x)\n", rd(phy, 0x1414));
+		return false;
+	}
+	/* bus numbers; PERST# released after 100 ms; LTSSM on */
+	pw(dbi, "dbi", 0x18, 0x00ff0100u);
+	f.xcap = rd(dbi, 0x34) & 0xfc;
+	for (int n = 0; f.xcap != 0 && n < 16 && (rd(dbi, f.xcap) & 0xff) != 0x10; n++) {
+		f.xcap = (rd(dbi, f.xcap) >> 8) & 0xfc;
+	}
+	IOSleep(100);
+	pw(p102, "gpio102io", 4, rd(p102, 4) | 2u);
+	done |= D_LTSSM;
+	pw(parf, "parf", 0x1b0, rd(parf, 0x1b0) | (1u << 8));
+	for (i = 0; i < 200; i++) {
+		lnk = f.xcap ? rd(dbi, f.xcap + 0x10) >> 16 : 0;
+		if (lnk & (1u << 13)) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("icepcie: link %s after %d ms: lnksta %04x (speed %u, width x%u) ltssm %#x\n",
+	    (lnk & (1u << 13)) ? "UP" : "NOT up", i, lnk, lnk & 0xf, (lnk >> 4) & 0x3f, rd(parf, 0x1b0) & 0x3f);
+	if (!(lnk & (1u << 13))) {
+		return false;
+	}
+	sid_on();
+	/* the config window: iATU region 0, CFG0, bus 1 dev 0 */
+	done |= D_ATU0;
+	pw(atu, "atu", 0x08, 0x40100000u);
+	pw(atu, "atu", 0x0c, 0);
+	pw(atu, "atu", 0x10, 0x401fffffu);
+	pw(atu, "atu", 0x14, 0x01000000u);
+	pw(atu, "atu", 0x18, 0);
+	pw(atu, "atu", 0x00, 4);
+	pw(atu, "atu", 0x04, 1u << 31);
+	cfg = iomap(0x40100000u, 0x1000);
+	v = cfg ? rd(cfg, 0) : 0;
+	printf("icepcie: bus 1 dev 0: %08x%s\n", v, v == EP_ID ? " = the WCN7860" : " (not 17cb:110e)");
+	if (v != EP_ID) {
+		return false;
+	}
+	/* BAR0 at 0x40400000 (2 MB), the root port's window, iATU region 1, memory decoding */
+	f.bar0 = rd(cfg, 0x10);
+	f.bar1 = rd(cfg, 0x14);
+	f.epcmd = rd(cfg, 0x04) & 0xffff;
+	f.rpcmd = rd(dbi, 0x04);
+	f.rpwin = rd(dbi, 0x20);
+	done |= D_E1;
+	pw(cfg, "ep", 0x10, 0xffffffffu);
+	size = rd(cfg, 0x10);
+	pw(cfg, "ep", 0x10, f.bar0);
+	if ((size & 1) || (~(size & ~0xfu) + 1) > 0x200000u) {
+		printf("icepcie: REFUSED: BAR0 sizing %08x\n", size);
+		return false;
+	}
+	f.bar64 = (size & 6) == 4;
+	pw(cfg, "ep", 0x10, 0x40400000u | (f.bar0 & 0xfu));
+	if (f.bar64) {
+		pw(cfg, "ep", 0x14, 0);
+	}
+	pw(dbi, "rp", 0x20, 0x405f4040u);
+	pw(dbi, "rp", 0x04, f.rpcmd | 2u);
+	pw(atu, "atu", 0x208, 0x40400000u);
+	pw(atu, "atu", 0x20c, 0);
+	pw(atu, "atu", 0x210, 0x405fffffu);
+	pw(atu, "atu", 0x214, 0x40400000u);
+	pw(atu, "atu", 0x218, 0);
+	pw(atu, "atu", 0x200, 0);
+	pw(atu, "atu", 0x204, 1u << 31);
+	pw(cfg, "ep", 0x04, (rd(cfg, 0x04) & 0xffff0000u) | f.epcmd | 2u);
+	return true;
+}
+
+/* ---- the undo, in reverse; only delay(), no lock: it also runs at a panic's end with the other cores off ---- */
+static void
+pcie_down(const char *why)
+{
+	uint32_t d = done;
+	bool up;
+
+	if (d == 0 || !__sync_bool_compare_and_swap(&down_once, 0, 1)) {
+		return;
+	}
+	up = (d & D_LTSSM) && link_is_up();
+	printf("icepcie: undo (%s): done %#x, link %s\n", why, d, up ? "up" : "down");
+	if ((d & D_BM) && up && rd(cfg, 0) == EP_ID) {
+		pw(cfg, "ep", 0x04, rd(cfg, 0x04) & 0xfffbu);  /* bus master off first: no DMA from here on */
+	}
+	if (d & D_BM) {
+		pw(dbi, "rp", 0x04, rd(dbi, 0x04) & ~4u);
+	}
+	iceland_ath12k_bar = 0;
+	if (d & D_SMMU) {
+		smmu_off();
+	}
+	if (d & D_E1) {
+		if (up && rd(cfg, 0) == EP_ID) {
+			pw(cfg, "ep", 0x04, (rd(cfg, 0x04) & 0xffff0000u) | f.epcmd);
+			if (f.bar64) {
+				pw(cfg, "ep", 0x14, f.bar1);
+			}
+			pw(cfg, "ep", 0x10, f.bar0);
+		}
+		pw(atu, "atu", 0x204, 0);
+		pw(dbi, "rp", 0x04, f.rpcmd);
+		pw(dbi, "rp", 0x20, f.rpwin);
+	}
+	if (d & D_ATU0) {
+		pw(atu, "atu", 0x04, 0);
+	}
+	if (d & D_SID) {
+		sid_off();              /* before the LTSSM goes off, the PHY still up */
+	}
+	if (d & D_LTSSM) {
+		pw(parf, "parf", 0x1b0, rd(parf, 0x1b0) & ~(1u << 8));
+	}
+	if (d & D_D2) {
+		pw(p102, "gpio102io", 4, rd(p102, 4) & ~2u);    /* PERST# asserted */
+		if (d & D_PHY) {
+			pw(phy, "phy", 0x1444, 0);
+			pw(phy, "phy", 0x1400, rd(phy, 0x1400) | 1u);
+			pw(phy, "phy", 0x1440, f.pd);
+			pw(gcc, "gcc", 0x6c028, 1);
+			pw(gcc, "gcc", 0x6c01c, 1);
+			delay(100);
+			pw(gcc, "gcc", 0x6c01c, 0);
+			pw(gcc, "gcc", 0x6c028, 0);
+			pw(gcc, "gcc", 0x6b090, f.mux);
+		}
+		pw(gcc, "gcc", 0x6b07c, f.rcg);
+		pw(gcc, "gcc", 0x6b078, rd(gcc, 0x6b078) | 1u);
+		pw(p102, "gpio102", 0, f.c102);
+		pw(p102, "gpio102io", 4, f.i102);
+	}
+	if (d & D_CLK) {
+		/* only the bits this file set and did not find set: another driver's votes since then stay */
+		pw(gcc, "gcc", 0x52018, rd(gcc, 0x52018) & ~((1u << 31) & ~f.v18));
+		pw(gcc, "gcc", 0x52000, rd(gcc, 0x52000) & ~(((1u << 12) | (1u << 19) | (1u << 22)) & ~f.v0));
+		pw(gcc, "gcc", 0x52008, rd(gcc, 0x52008) & ~(0x7fu & ~f.v8));
+		pw(tcsr, "clkref", 0x44, f.t0);
+	}
+	if (d & D_GDSC) {
+		pw(gcc, "gdsc", 0x6c000, f.g1);
+		pw(gcc, "gdsc", 0x6b004, f.g0);
+	}
+	if (d & D_PWR) {
+		pw(p16, "gpio16io", 4, f.i16 & ~2u);    /* WLAN_EN low: the chip off */
+		pw(p16, "gpio16", 0, f.c16);
+		pw(p16, "gpio16io", 4, f.i16);
+	}
+	if (d & D_RAIL) {
+		hakios_iceland_wcn_rails_put("icepcie");        /* after WLAN_EN is low; the votes stay */
+	}
+	printf("icepcie: undo done: gdsc %08x %08x gpio16 %08x/%08x gpio102 %08x/%08x\n", gcc ? rd(gcc, 0x6b004) : 0,
+	    gcc ? rd(gcc, 0x6c000) : 0, p16 ? rd(p16, 0) : 0, p16 ? rd(p16, 4) : 0, p102 ? rd(p102, 0) : 0,
+	    p102 ? rd(p102, 4) : 0);
+}
+
+/* ---- entry points ---- */
+bool
+hakios_iceland_pcie_up(void)
+{
+	uint32_t len = 0;
+
+	if (psci_smp_hvc) {
+		printf("icepcie: PSCI is over hvc here: not the Pad, no PCIe card, nothing touched\n");
+		return false;
+	}
+	if (nw_wifi_stats.stage == NW_ABSENT || iceland_ath12k_fw("ath12k_amss.bin", &len) == NULL) {
+		printf("icepcie: no %s in this kernel: nothing touched\n",
+		    nw_wifi_stats.stage == NW_ABSENT ? "driver object" : "firmware");
+		return false;
+	}
+	drv_run = 1;
+	up_busy = 1;
+	if (stop_req || !wcn_power() || !pcie_power() || !pcie_link() || !smmu_on()) {
+		goto fail;
+	}
+	/* the PCIe0 -> DDR NoC (BCM SN4), held while the chip may DMA, as Linux's pcie-mem interconnect vote */
+	if (hakios_iceland_rpmh_bcm("SN4", true) != 0) {
+		printf("icepcie: REFUSED: no SN4 vote\n");
+		goto fail;
+	}
+	done |= D_SN4;
+	if (stop_req) {
+		goto fail;
+	}
+	/* bus master on both ends (Linux's pci_set_master does the endpoint only), then the driver's getters */
+	done |= D_BM;
+	pw(dbi, "rp", 0x04, rd(dbi, 0x04) | 4u);
+	pw(cfg, "ep", 0x04, rd(cfg, 0x04) | 4u);
+	iceland_ath12k_conf = cfg;
+	iceland_ath12k_dma_pa = q_pa;
+	iceland_ath12k_dma_va = q_va;
+	iceland_ath12k_dma_size = Q_ARENA;
+	iceland_ath12k_msi = buf_pa + 0xf0000;
+	iceland_ath12k_bar = iomap(0x40400000u, 0x200000);
+	if (iceland_ath12k_bar == 0) {
+		goto fail;
+	}
+	printf("icepcie: handed to ath12k: MHI VER %08x STATUS %08x\n", rd(iceland_ath12k_bar, 0x8), rd(iceland_ath12k_bar, 0x48));
+	up_busy = 0;
+	return true;
+fail:
+	pcie_down("bring-up failed");
+	if (done & D_SN4) {
+		(void)hakios_iceland_rpmh_bcm("SN4", false);
+	}
+	drv_run = 0;
+	up_busy = 0;
+	return false;
+}
+
+int
+hakios_iceland_pcie_stopping(void)
+{
+	return stop_req != 0;
+}
+
+void
+hakios_iceland_pcie_driver_done(void)
+{
+	drv_done = 1;
+}
+
+/* the run's end, from a thread: the driver's loop ends and stops the chip itself (5 s at most), then the undo */
+void
+hakios_iceland_pcie_stop(void)
+{
+	stop_req = 1;           /* first: a bring-up that has not begun yet must not begin after this */
+	if (done == 0 || down_once) {
+		return;
+	}
+	for (int i = 0; i < 100 && (up_busy || (drv_run && !drv_done)); i++) {
+		IOSleep(50);
+	}
+	pcie_down(drv_done || !drv_run ? "stop" : "stop, the driver did not end");
+	if (done & D_SN4) {
+		(void)hakios_iceland_rpmh_bcm("SN4", false);
+	}
+}
+
+void
+hakios_iceland_pcie_quiesce(void)
+{
+	stop_req = 1;
+	pcie_down("quiesce");
+}
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/bsd/dev/hakios_iceland_pcie_tbl.h b/bsd/dev/hakios_iceland_pcie_tbl.h
new file mode 100644
index 0000000000000000000000000000000000000000..561142a2b36d6d736569b1e01921e2c8dff2ace7
--- /dev/null
+++ b/bsd/dev/hakios_iceland_pcie_tbl.h
@@ -0,0 +1,137 @@
+/*
+ * iceland kit 23d2: the PCIe0 PHY init of the OnePlus Pad 4 (WCN7860 link), from Linux
+ * drivers/phy/qualcomm/phy-qcom-qmp-pcie.c kaanapali_qmp_gen3x2_pcie_{serdes,tx,rx,pcs,pcs_misc}_tbl:
+ * register offsets and values only (hardware facts), resolved through its headers by a generator script.
+ * block offsets (qmp_pcie_offsets_v8_0): serdes +0x1000, tx +0x0 / +0x800, rx +0x200 / +0xa00, pcs +0x1400, pcs_misc +0x1800
+ */
+enum { QB_SERDES, QB_TX, QB_RX, QB_PCS, QB_PCS_MISC };
+static const struct { uint8_t block; uint16_t off; uint8_t val; uint8_t lane; } pcie0_phy_tbl[] = {
+	{ QB_SERDES, 0x00c0, 0x01, 0 }, /* QSERDES_V8_COM_SSC_EN_CENTER */
+	{ QB_SERDES, 0x0000, 0x93, 0 }, /* QSERDES_V8_COM_SSC_STEP_SIZE1_MODE1 */
+	{ QB_SERDES, 0x0004, 0x01, 0 }, /* QSERDES_V8_COM_SSC_STEP_SIZE2_MODE1 */
+	{ QB_SERDES, 0x0010, 0x06, 0 }, /* QSERDES_V8_COM_CP_CTRL_MODE1 */
+	{ QB_SERDES, 0x0014, 0x16, 0 }, /* QSERDES_V8_COM_PLL_RCTRL_MODE1 */
+	{ QB_SERDES, 0x0018, 0x36, 0 }, /* QSERDES_V8_COM_PLL_CCTRL_MODE1 */
+	{ QB_SERDES, 0x001c, 0x04, 0 }, /* QSERDES_V8_COM_CORECLK_DIV_MODE1 */
+	{ QB_SERDES, 0x0020, 0x0a, 0 }, /* QSERDES_V8_COM_LOCK_CMP1_MODE1 */
+	{ QB_SERDES, 0x0024, 0x1a, 0 }, /* QSERDES_V8_COM_LOCK_CMP2_MODE1 */
+	{ QB_SERDES, 0x0028, 0x34, 0 }, /* QSERDES_V8_COM_DEC_START_MODE1 */
+	{ QB_SERDES, 0x0030, 0x55, 0 }, /* QSERDES_V8_COM_DIV_FRAC_START1_MODE1 */
+	{ QB_SERDES, 0x0034, 0x55, 0 }, /* QSERDES_V8_COM_DIV_FRAC_START2_MODE1 */
+	{ QB_SERDES, 0x0038, 0x01, 0 }, /* QSERDES_V8_COM_DIV_FRAC_START3_MODE1 */
+	{ QB_SERDES, 0x003c, 0x01, 0 }, /* QSERDES_V8_COM_HSCLK_SEL_1 */
