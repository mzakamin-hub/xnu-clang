+/*
+ * The modes of the display, the way CoreAnimation reads them (the properties TimingElements
+ * and ColorElements; without a mode it draws nothing). One timing, the panel's size at
+ * 60 Hz (boot-arg fb_hz=N: at N), with one colour mode, 8-bit RGB. The identifiers are what "the current mode"
+ * (block 0x40) answers with.
+ */
+#define kFBTimingID     1
+#define kFBColorID      1
+
+void
+IOMobileFramebuffer::publishModes(void)
+{
+	/*
+	 * iOS 26 takes the modes the way a real phone's display driver lays them out (an M1's AppleCLCD2,
+	 * read with ioreg, is the model here): besides the attributes, each element carries its binary
+	 * description (ElementData), and the timing says it is the preferred one. With only the attributes
+	 * iOS 16.5 was content; iOS 26 found no preferred mode ("preferred mode (0 x 0)", current mode
+	 * 16383 x 16383) and never drew. The porches are made up, the pixel clock follows from them.
+	 */
+	const uint32_t hz = refreshHz();
+	const uint32_t hSync = 32, hBack = 42, hFront = 8, vSync = 8, vBack = 42, vFront = 32;
+	const uint32_t hTotal = fWidth + hSync + hBack + hFront, vTotal = fHeight + vSync + vBack + vFront;
+	const uint64_t pixelClock = (uint64_t) hTotal * vTotal * hz;
+	const uint32_t lineRate = (uint32_t) (((pixelClock << 16) / hTotal) / 1000);     /* kHz, 16.16 */
+	const uint32_t frameRate = hz << 16;                                            /* Hz, 16.16 */
+	uint32_t timingData[20] = {
+		0, hTotal, fWidth, hSync, hBack, hFront, lineRate, 1, 0,
+		vTotal, fHeight, vSync, vBack, vFront, frameRate, 1, 0,
+		(uint32_t) pixelClock, 13, 0,
+	};
+	uint8_t colorData[32] = { 8 };
+	OSDictionary * timing = OSDictionary::withCapacity(24);
+	OSDictionary * horizontal = OSDictionary::withCapacity(9);
+	OSDictionary * vertical = OSDictionary::withCapacity(9);
+	OSDictionary * color = OSDictionary::withCapacity(12);
+	OSDictionary * refresh = OSDictionary::withCapacity(6);
+	OSDictionary * attributes = OSDictionary::withCapacity(1);
+	OSDictionary * product = OSDictionary::withCapacity(1);
+	OSArray * timings = OSArray::withCapacity(1);
+	OSArray * colors = OSArray::withCapacity(1);
+	OSArray * none = OSArray::withCapacity(1);
+	OSData * data;
+	uint64_t frameTicks;
+
+	if (timing == NULL || horizontal == NULL || vertical == NULL || color == NULL || refresh == NULL ||
+	    attributes == NULL || product == NULL || timings == NULL || colors == NULL || none == NULL) {
+		return;
+	}
+	colorData[12] = 16;                                     /* colorimetry */
+	setNumber(color, "ID", kFBColorID);
+	setNumber(color, "ElementType", 1);
+	setNumber(color, "StandardType", 0);
+	setNumber(color, "PixelEncoding", 0);                   /* RGB 4:4:4 */
+	setNumber(color, "Depth", 8);
+	setNumber(color, "Colorimetry", 16);
+	setNumber(color, "EOTF", 0);
+	setNumber(color, "DynamicRange", 0);
+	setNumber(color, "SupportsDSC", 0);
+	setNumber(color, "Score", 240999);
+	color->setObject("IsVirtual", kOSBooleanFalse);
+	if ((data = OSData::withBytes(colorData, sizeof(colorData))) != NULL) {
+		color->setObject("ElementData", data);
+		data->release();
+	}
+	colors->setObject(color);
+
+	setNumber(horizontal, "Active", fWidth);
+	setNumber(horizontal, "Total", hTotal);
+	setNumber(horizontal, "SyncWidth", hSync);
+	setNumber(horizontal, "BackPorch", hBack);
+	setNumber(horizontal, "FrontPorch", hFront);
+	setNumber(horizontal, "SyncPolarity", 1);
+	setNumber(horizontal, "PixelRepetition", 0);
+	setNumber(horizontal, "SyncRate", lineRate);
+	setNumber(horizontal, "PreciseSyncRate", lineRate);
+	setNumber(vertical, "Active", fHeight);
+	setNumber(vertical, "Total", vTotal);
+	setNumber(vertical, "SyncWidth", vSync);
+	setNumber(vertical, "BackPorch", vBack);
+	setNumber(vertical, "FrontPorch", vFront);
+	setNumber(vertical, "SyncPolarity", 1);
+	setNumber(vertical, "PixelRepetition", 0);
+	setNumber(vertical, "SyncRate", frameRate);
+	setNumber(vertical, "PreciseSyncRate", frameRate);
+	setNumber(timing, "ID", kFBTimingID);
+	setNumber(timing, "ElementType", 0);
+	setNumber(timing, "StandardType", 0);
+	setNumber(timing, "TimingType", 3);
+	setNumber(timing, "ScanInformation", 0);
+	setNumber(timing, "Score", 16346);
+	setNumber(timing, "AspectRatio", 13);
+	setNumber(timing, "PreciseAspectRatio", (uint64_t) fWidth * 65536 / fHeight);
+	setNumber(timing, "ValidPixelEncodings", 1);
+	setNumber(timing, "MinimumVariableRefreshRate", 0);
+	setNumber(timing, "MaximumVariableRefreshRate", 0);
+	timing->setObject("IsPreferred", kOSBooleanTrue);
+	timing->setObject("IsVirtual", kOSBooleanFalse);
+	timing->setObject("IsOverscanned", kOSBooleanFalse);
+	timing->setObject("IsInterlaced", kOSBooleanFalse);
+	timing->setObject("IsSplit", kOSBooleanFalse);
+	timing->setObject("IsPromoted", kOSBooleanFalse);
+	timing->setObject("HorizontalAttributes", horizontal);
+	timing->setObject("VerticalAttributes", vertical);
+	timing->setObject("ColorModes", colors);
+	timing->setObject("DiscreteMediaRefreshRates", none);
+	timing->setObject("UnsafeColorElementIDs", none);
+	timing->setObject("DSCRequiredColorElementIDs", none);
+	if ((data = OSData::withBytes(timingData, sizeof(timingData))) != NULL) {
+		timing->setObject("ElementData", data);
+		data->release();
+	}
+	timings->setObject(timing);
+
+	setProperty("TimingElements", timings);
+	setProperty("ColorElements", colors);
+	setProperty("DPTimingModeId", kFBTimingID, 32);
+	setProperty("DisplayWidth", fWidth, 32);
+	setProperty("DisplayHeight", fHeight, 32);
+	setProperty("PixelClock", pixelClock, 64);
+	attributes->setObject("ProductAttributes", product);
+	setProperty("DisplayAttributes", attributes);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / hz, &frameTicks);
+	setNumber(refresh, "displayMinRefreshInterval", (1ULL << 32) / hz);
+	setNumber(refresh, "displayMaxRefreshInterval", (1ULL << 32) / hz);
+	setNumber(refresh, "displayMinRefreshIntervalMachTime", frameTicks);
+	setNumber(refresh, "displayMaxRefreshIntervalMachTime", frameTicks);
+	setNumber(refresh, "displayRefreshStep", 0);
+	setNumber(refresh, "displayRefreshStepMachTime", 0);
+	setProperty("IOMFBDisplayRefresh", refresh);
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(none);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+	OSSafeReleaseNULL(refresh);
+	OSSafeReleaseNULL(attributes);
+	OSSafeReleaseNULL(product);
+}
+
+bool
+IOMobileFramebuffer::start(IOService * provider)
+{
+	thread_t thread;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	if (vinfo.v_baseaddr == 0 || vinfo.v_width == 0 || vinfo.v_height == 0 || vinfo.v_depth != 32) {
+		IOLog("MiniIOMobileFramebuffer: no usable boot framebuffer (%ux%u, depth %u)\n", vinfo.v_width, vinfo.v_height,
+		    vinfo.v_depth);
+		return false;
+	}
+	fLock = IOLockAlloc();
+	fSwapLock = IOLockAlloc();
+	gFbc.litMin = ~0u;
+	gFbc.prevLit = -1;
+	if (gFbCheck || gFbInval) {
+		IOLog("fbcheck: on (fb_check=%u, fb_inval=%u): framebuffer %#llx (phys %#llx) %ux%u, %u bytes a row\n", gFbCheck,
+		    gFbInval, (uint64_t) vinfo.v_baseaddr, (uint64_t) kvtophys((vm_offset_t) vinfo.v_baseaddr), vinfo.v_width,
+		    vinfo.v_height, vinfo.v_rowbytes);
+	}
+	/* 30sb: fb_scanwc (the panel mapped again) before any thread that draws onto it exists */
+	fBase = (uint8_t *) vinfo.v_baseaddr;
+	if (gScanWc == 1 || gScanWc == 2) {
+		scanwcMap();
+	}
+	if (panelThreadStart(&IOMobileFramebuffer::presenterMain, this, &thread) != KERN_SUCCESS) {
+		IOLog("MiniIOMobileFramebuffer: no thread to put frames on the panel with\n");
+		return false;
+	}
+	thread_set_thread_name(thread, "frames to the panel");
+	thread_deallocate(thread);
+	fThreads = gThreads >= 1 && gThreads <= 8 ? gThreads : 1;
+	fHelperLock = IOLockAlloc();
+	if (gFrameInfoLock == NULL) {
+		gFrameInfoLock = IOLockAlloc();         /* 29e (none: frame info is never turned on) */
+	}
+	for (unsigned i = 0; i + 1 < fThreads; i++) {
+		if (panelThreadStart(&IOMobileFramebuffer::helperMain, this, &thread) != KERN_SUCCESS) {
+			fThreads = i + 1;
+			break;
+		}
+		thread_set_thread_name(thread, "frames to the panel: a helper");
+		thread_deallocate(thread);
+	}
+	if (gFbPri != 0) {
+		printf("fbpri: fb_pri=%u: the presenter and %u helpers started at %s\n", gFbPri, fThreads - 1,
+		    gFbPri <= 95 ? "that priority" : "the default priority (out of range 1..95)");
+	}
+	/* (fBase: set above, before the threads; fb_scanwc may have mapped the panel again) */
+	fPhysWidth = vinfo.v_width;
+	fPhysHeight = vinfo.v_height;
+	fRotate = gRotate == 90 || gRotate == 180 || gRotate == 270 ? gRotate : 0;
+	fRotTile = gRotTile >= 2 && gRotTile <= 32 && fRotate != 180 ? gRotTile : 1;
+	fRotStride = fPhysHeight > fPhysWidth ? fPhysHeight : fPhysWidth;
+	if (fRotate != 0) {
+		IOLog("MiniIOMobileFramebuffer: fbrotate=%u: %s\n", fRotate, fRotTile > 1 ? "rows turned in tiles (fb_rottile)" :
+		    "rows turned one by one");
+		if (fRotTile > 1) {
+			IOLog("MiniIOMobileFramebuffer: fb_rottile=%u: %u rows at a time per drawer\n", fRotTile, fRotTile);
+		}
+	}
+	for (unsigned i = 0; fRotate != 0 && i < fThreads; i++) {
+		fRotRow[i] = IONew(uint32_t, (size_t) fRotStride * fRotTile);
+		if (fRotRow[i] == NULL) {
+			IOLog("MiniIOMobileFramebuffer: no memory to turn the picture: fbrotate ignored\n");
+			fRotate = 0;
+		}
+	}
+	fPanelWidth = fRotate == 90 || fRotate == 270 ? fPhysHeight : fPhysWidth;
+	fPanelHeight = fRotate == 90 || fRotate == 270 ? fPhysWidth : fPhysHeight;
+	fRowBytes = vinfo.v_rowbytes;
+	fWidth = gFBWidth ? gFBWidth : fPanelWidth;
+	fHeight = gFBHeight ? gFBHeight : fPanelHeight;
+	if (gFBScale != 0 && gFBScale != kFBDefaultScale) {
+		static const char * const places[][2] = { { "/chosen", "display-scale" }, { "/product", "artwork-scale-factor" } };
+		uint32_t scale = gFBScale;
+
+		fWidth = kFBPointsWide * scale;
+		fHeight = kFBPointsHigh * scale;
+		/* what the loader's device tree says about the scale is where MobileGestalt has it from */
+		for (unsigned i = 0; i < sizeof(places) / sizeof(places[0]); i++) {
+			IORegistryEntry * node = IORegistryEntry::fromPath(places[i][0], gIODTPlane);
+
+			if (node != NULL) {
+				node->setProperty(places[i][1], &scale, sizeof(scale));
+				node->release();
+			}
+		}
+	}
+	/*
+	 * 25e, boot-arg fb_disprot=90|180|270: /chosen "display-rotation" (the loader writes 0, as iBoot writes the panel's
+	 * mounting), which libMobileGestalt answers MainDisplayRotation / DisplayBootRotation from and FrontBoard / CoreAnimation
+	 * take as the main display's native rotation: with a landscape framebuffer (no fbrotate) the portrait UI is then meant
+	 * to be composed already turned, on the GPU, and the panel can scan it out directly (no CPU copy).
+	 */
+	if (gDispRot == 90 || gDispRot == 180 || gDispRot == 270) {
+		IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+		uint32_t rot = gDispRot;
+
+		if (chosen != NULL) {
+			chosen->setProperty("display-rotation", &rot, sizeof(rot));
+			chosen->release();
+		}
+		IOLog("MiniIOMobileFramebuffer: /chosen display-rotation = %u (fb_disprot)%s\n", rot, chosen != NULL ? "" : ": NO /chosen");
+	}
+	fColumn = IONewZero(uint32_t, fPanelWidth);
+	fColumnWeight = IONewZero(uint16_t, fPanelWidth);
+	if (gDamage && (fRotate == 90 || fRotate == 270) && fRotTile > 1) {
+		fDmg = IONewZero(DmgSlot, fPanelHeight);        /* 30sa3 (gen 0 never valid: fDmgGen starts at 1) */
+		fDmgGen = 1;
+		printf("fbdamage: on: %u slots, groups of %u rows, 1 in %u written every frame anyway%s\n", fPanelHeight, fRotTile,
+		    DMG_ROLL, fDmg != NULL ? "" : ": NO MEMORY, off");
+	} else if (gDamage) {
+		printf("fbdamage: not used: needs fbrotate 90 / 270 with fb_rottile (rotate %u, tile %u)\n", fRotate, fRotTile);
+	}
+	fDiff = gDiff != 0 && fRotate == 0;     /* (fb_diff compares panel rows: not with a turned picture) */
+	fDiffLeft = fDiffTop = ~0u;
+	IOLog("MiniIOMobileFramebuffer: display %ux%u on a panel of %ux%u (%u bytes per row)%s\n", fWidth, fHeight,
+	    fPanelWidth, fPanelHeight, fRowBytes, fRotate == 90 ? ", turned 90 degrees" : fRotate == 180 ? ", turned 180 degrees" :
+	    fRotate == 270 ? ", turned 270 degrees" : "");
+	/* (the frame: rows of 4 bytes a pixel, padded to 64 bytes as IOSurface pads them, and a little to spare) */
+	fScan = hakios_dada_scanout_init(kvtophys((vm_offset_t) vinfo.v_baseaddr), fPhysWidth, fPhysHeight, fRowBytes,
+	    ((fWidth * 4 + 255) & ~255u) * fHeight) == 0;
+	if (fScan) {
+		IOLog("MiniIOMobileFramebuffer: the display controller shows the frames from buffers of its own\n");
+	}
+	if (!fScan && fRotate == 0) {
+		scn_init();             /* iceland, icescan=N: kit 25a (the display's own fetch through bank 4's tables) */
+	}
+	gFramebuffer = this;
+
+	if (gRecSeconds != 0) {
+		/* one piece of physical memory: the loader will send it over USB as it lies */
+		IOBufferMemoryDescriptor * memory = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, (mach_vm_size_t) gRecMegabytes << 20, ~0ULL);
+
+		if (memory != NULL) {
+			struct rec_header * header = (struct rec_header *) memory->getBytesNoCopy();
+
+			fRecBase = (uint8_t *) header;
+			fRecSize = (uint64_t) gRecMegabytes << 20;
+			fRecUsed = sizeof(*header);
+			bzero(header, sizeof(*header));
+			memcpy(header->magic, "RWREC003", 8);
+			header->width = fWidth / REC_STEP;
+			header->height = fHeight / REC_STEP;
+			loader_recording[0] = memory->getPhysicalSegment(0, NULL);
+			loader_recording[1] = fRecUsed;
+			loader_recording[2] = (uint64_t) (uintptr_t) fRecBase;
+			IOLog("MiniIOMobileFramebuffer: recording %u s of the screen at %ux%u from second %u, into %u MB at %#llx%s\n",
+			    gRecSeconds, header->width, header->height, gRecStart, gRecMegabytes, loader_recording[0],
+			    gRecRing ? ", the last of it kept (rec_ring)" : "");
+		} else {
+			IOLog("MiniIOMobileFramebuffer: no memory for a recording of %u MB\n", gRecMegabytes);
+		}
+	}
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	/* for who draws with the GPU (userland/src/eagl.c): a frame need not be waited for before it is handed over */
+	setProperty("RedwoodWaitsForGPU", kOSBooleanTrue);
+	publishModes();
+	setName("disp0");
+	registerService();
+	return true;
+}
+
+/* Keep a small copy of the frame that is about to be shown (the surface is the whole screen). */
+void
+IOMobileFramebuffer::record(MiniIOSurface * s)
+{
+	struct rec_header * header = (struct rec_header *) fRecBase;
+	uint64_t now = mach_absolute_time(), since_first, since_start = 0, frame_size;
+	struct rec_frame * frame;
+	uint8_t * to;
+
+	if (fFirstFrame == 0) {
+		fFirstFrame = now;
+	}
+	if (fRecBase == NULL || fRecDone || s->info.width < fWidth || s->info.height < fHeight) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - fFirstFrame, &since_first);
+	if (since_first < (uint64_t) gRecStart * NSEC_PER_SEC) {
+		return;
+	}
+	if (fRecFirst == 0) {
+		uint64_t began;
+
+		fRecFirst = now;
+		absolutetime_to_nanoseconds(now, &began);
+		header->began = began;
+		IOLog("MiniIOMobileFramebuffer: the recording begins at %llu.%03llu s of the kernel's time (mach_absolute_time)\n",
+		    began / NSEC_PER_SEC, began / NSEC_PER_MSEC % 1000);
+	}
+	absolutetime_to_nanoseconds(now - fRecFirst, &since_start);
+	frame_size = sizeof(*frame) + (uint64_t) header->width * header->height * 3;
+	if (since_start > (uint64_t) gRecSeconds * NSEC_PER_SEC || (fRecUsed + frame_size > fRecSize && !gRecRing)) {
+		fRecDone = true;
+		IOLog("MiniIOMobileFramebuffer: recording finished: %u frames, %llu MB\n", header->frames, fRecUsed >> 20);
+		return;
+	}
+	if (fRecUsed + frame_size > fRecSize) {
+		/* (rec_ring) round again: over the oldest, which is the next one */
+		fRecUsed = sizeof(*header);
+		fRecWrapped = true;
+	}
+	frame = (struct rec_frame *) (fRecBase + fRecUsed);
+	/*
+	 * (dada: the surface it came from and the low bits of its last GPU submission ride in the time's top bits -- a run is far
+	 * shorter than 2^40 ns -- for telling which buffer a frame that flickers was: tools/recording.py writes them to tags.txt)
+	 */
+	frame->nanoseconds = (since_start & ((1ull << 40) - 1)) | (uint64_t) (s->sid & 0xffff) << 40 | (uint64_t) (s->drawn & 0xff) << 56;
+	to = (uint8_t *) (frame + 1);
+	for (uint32_t y = 0; y < header->height; y++) {
+		const uint32_t * from = (const uint32_t *) (s->pixels() + (size_t) (y * REC_STEP + 1) * s->info.bytesPerRow);
+
+		for (uint32_t x = 0; x < header->width; x++) {
+			uint32_t pixel = from[x * REC_STEP + 1];        /* B G R A in memory */
+
+			*to++ = (uint8_t) (pixel >> 16);
+			*to++ = (uint8_t) (pixel >> 8);
+			*to++ = (uint8_t) pixel;
+		}
+	}
+	fRecUsed += frame_size;
+	if (!fRecWrapped) {
+		header->frames++;
+		loader_recording[1] = fRecUsed;
+	} else {
+		/* the memory full of frames: all of them are handed over, from the one after this */
+		header->oldest = (uint32_t) ((fRecUsed - sizeof(*header)) / frame_size);
+		if (header->oldest >= header->frames) {
+			header->oldest = 0;
+		}
+		loader_recording[1] = sizeof(*header) + (uint64_t) header->frames * frame_size;
+	}
+}
+
+MiniIOSurface *
+IOMobileFramebuffer::defaultSurface(void)
+{
+	IOLockLock(fLock);
+	if (fDefaultSurface == NULL) {
+		fDefaultSurface = MiniIOSurfaceCreateSimple(fWidth, fHeight, FOURCC('B', 'G', 'R', 'A'));
+	}
+	IOLockUnlock(fLock);
+	return fDefaultSurface;
+}
+
+/*
+ * Two pixels mixed: `w` of 256 of the second. Two of the four channels at a time, in one word.
+ */
+static inline uint32_t
+blend(uint32_t a, uint32_t b, uint32_t w)
+{
+	uint32_t rb = ((a & 0xff00ff) * (256 - w) + (b & 0xff00ff) * w) >> 8 & 0xff00ff;
+	uint32_t ga = ((a >> 8 & 0xff00ff) * (256 - w) + (b >> 8 & 0xff00ff) * w) & 0xff00ff00;
+
+	return rb | ga;
+}
+
+/*
+ * Where the middle of the `i`th of `out` pixels falls among `in` of them, in 256ths of a pixel,
+ * kept within the first and the last.
+ */
+static inline int64_t
+sample_at(int64_t i, int64_t in, int64_t out)
+{
+	int64_t at = ((2 * i + 1) * in - out) * 128 / out;
+
+	return at < 0 ? 0 : at > (in - 1) * 256 ? (in - 1) * 256 : at;
+}
+
+/*
+ * The rows of one layer, from `y0` to `y1` (panel rows), as drawLayer() has worked them out:
+ * scaling a whole frame takes one processor some 9 ms, so with boot-arg fb_threads=N it is shared
+ * out between N of them, each with rows of its own and a row of blending of its own.
+ */
+struct RowJob {
+	const uint8_t * pixels;
+	uint32_t        stride;
+	int32_t         sx, sy, sw, sh, px0, py0, px1, py1, cx0, cx1;
+	bool            filter, unscaled;
+	bool            damage;                 /* 30sa3 fb_damage: groups of rows compared with what the panel got */
+	bool            beam;                   /* 30sa5 fb_scanpos=2: written in strips, timed against the scan */
+	uint32_t        beamStep;               /* ... strips per drawer turn: the number of drawers sharing the job */
+};
+
+/*
+ * fbrotate: row `y` of the upright picture, pixels x0 to x1, onto the real panel, where it is a column: 90, at panel
+ * column (width - 1 - y), its x going down; 270, at panel column y, its x going up.
+ */
+void
+IOMobileFramebuffer::rotateRow(int32_t y, int32_t x0, int32_t x1, const uint32_t * row)
+{
+	uint64_t anat = gAnat ? mach_absolute_time() : 0;      /* 30sa1: the write phase's time */
+
+	if (fRotate == 180) {
+		/* 180: the row is panel row (height - 1 - y), its x going right to left */
+		uint32_t * to = (uint32_t *) (fBase + (size_t) (fPhysHeight - 1 - (uint32_t) y) * fRowBytes);
+
+		for (int32_t x = x0; x < x1; x++) {
+			to[fPhysWidth - 1 - (uint32_t) x] = row[x];
+		}
+	} else if (fRotate == 90) {
+		uint8_t * column = fBase + (size_t) (fPhysWidth - 1 - (uint32_t) y) * 4;
+
+		for (int32_t x = x0; x < x1; x++) {
+			*(uint32_t *) (column + (size_t) x * fRowBytes) = row[x];
+		}
+	} else {
+		uint8_t * column = fBase + (size_t) y * 4;
+
+		for (int32_t x = x0; x < x1; x++) {
+			*(uint32_t *) (column + (size_t) (fPhysHeight - 1 - (uint32_t) x) * fRowBytes) = row[x];
+		}
+	}
+	if (anat != 0) {
+		anatAdd(&fAnatWriteAbs, mach_absolute_time() - anat);
+	}
+}
+
+/*
+ * 20v, fb_rottile=N (90 / 270): `n` upright rows y0 .. y0 + n - 1 (row k at rows + k * fRotStride), pixels x0 to x1, onto the
+ * panel. Row by row (rotateRow), every pixel of a row lands in another panel row: 2400 stores a row, each to its own cache
+ * line, and each line filled over 16 passes. Here the n rows' pixels of one x are n neighbours in one panel row and go
+ * out together (n = 16: one 64-byte line), the n source rows staying in the cache meanwhile.
+ */
+void
+IOMobileFramebuffer::rotateRows(int32_t y0, uint32_t n, int32_t x0, int32_t x1, const uint32_t * rows)
+{
+	const size_t rs = fRotStride;
+	uint64_t anat = gAnat ? mach_absolute_time() : 0;      /* 30sa1: the write phase's time */
+	const bool wb = fScanWc == 2;                           /* 30sb fb_scanwc=2: each panel run cleaned once written */
+
+	if (fRotate == 90) {
+		/* row y is panel column (width - 1 - y): the last of the n rows comes first in the panel row */
+		uint8_t * first = fBase + (size_t) (fPhysWidth - (uint32_t) y0 - n) * 4;
+
+		for (int32_t x = x0; x < x1; x++) {
+			uint32_t * __restrict to = (uint32_t *) (first + (size_t) x * fRowBytes);
+			const uint32_t * from = rows + x;
+
+			for (uint32_t k = 0; k < n; k++) {
+				to[k] = from[(size_t) (n - 1 - k) * rs];
+			}
+			if (wb) {
+				scanwcLines(to, to + n - 1);
+			}
+		}
+	} else {
+		/* 270: row y is panel column y, its x going up */
+		uint8_t * first = fBase + (size_t) y0 * 4;
+
+		for (int32_t x = x0; x < x1; x++) {
+			uint32_t * __restrict to = (uint32_t *) (first + (size_t) (fPhysHeight - 1 - (uint32_t) x) * fRowBytes);
+			const uint32_t * from = rows + x;
+
+			for (uint32_t k = 0; k < n; k++) {
+				to[k] = from[(size_t) k * rs];
+			}
+			if (wb) {
+				scanwcLines(to, to + n - 1);
+			}
+		}
+	}
+	if (anat != 0) {
+		anatAdd(&fAnatWriteAbs, mach_absolute_time() - anat);
+	}
+}
+
+/* 30sa3: one 64-bit word into a signature lane (a bijection of the lane for each word: any one changed word changes it) */
+static inline uint64_t
+dmgMix(uint64_t h, uint64_t w)
+{
+	h = (h ^ w) * 0x9e3779b97f4a7c15ull;
+	return h << 31 | h >> 33;
+}
+
+/* 30sa3: `px` pixels of a row (in the drawer's own cacheable rows) into the four lanes */
+static void
+dmgHashRow(uint64_t * lanes, const uint32_t * row, uint32_t px)
+{
+	const uint8_t * p = (const uint8_t *) row;
+	uint64_t a = lanes[0], b = lanes[1], c = lanes[2], d = lanes[3], w0, w1, w2, w3;
+	uint32_t words = px / 2, i = 0;
+
+	for (; i + 4 <= words; i += 4) {
+		memcpy(&w0, p + 8 * (size_t) i, 8);
+		memcpy(&w1, p + 8 * (size_t) i + 8, 8);
+		memcpy(&w2, p + 8 * (size_t) i + 16, 8);
+		memcpy(&w3, p + 8 * (size_t) i + 24, 8);
+		a = dmgMix(a, w0);
+		b = dmgMix(b, w1);
+		c = dmgMix(c, w2);
+		d = dmgMix(d, w3);
+	}
+	for (; i < words; i++) {
+		memcpy(&w0, p + 8 * (size_t) i, 8);
+		a = dmgMix(a, w0);
+	}
+	if (px & 1) {
+		b = dmgMix(b, row[px - 1]);
+	}
+	lanes[0] = a;
+	lanes[1] = b;
+	lanes[2] = c;
+	lanes[3] = d;
+}
+
+/*
+ * 30sa3: the group of `gn` upright rows from `gy0` onto the panel -- unless (lanes given) the panel got this very group, at
+ * this place and size, last time and it is not the group's turn in the rolling refresh. lanes NULL: written as before.
+ */
+void
+IOMobileFramebuffer::bandOut(const RowJob * job __unused, int32_t gy0, uint32_t gn, int32_t x0, int32_t x1, uint32_t * rotRow,
+    const uint64_t * lanes)
+{
+	DmgSlot * d;
+	bool same, roll;
+
+	if (lanes == NULL || fDmg == NULL || gy0 < 0 || (uint32_t) gy0 >= fPanelHeight) {
+		rotateRows(gy0, gn, x0, x1, rotRow);
+		return;
+	}
+	d = &fDmg[gy0];
+	roll = ((uint32_t) gy0 / fRotTile) % DMG_ROLL == fDmgTick % DMG_ROLL;
+	same = d->gen == fDmgGen && d->n == gn && d->x0 == x0 && d->x1 == x1 && d->h[0] == lanes[0] && d->h[1] == lanes[1] &&
+	    d->h[2] == lanes[2] && d->h[3] == lanes[3];
+	if (same && !roll) {
+		__atomic_fetch_add(&fDmgSkipped, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	rotateRows(gy0, gn, x0, x1, rotRow);
+	memcpy(d->h, lanes, sizeof(d->h));
+	d->n = gn;
+	d->x0 = x0;
+	d->x1 = x1;
+	d->gen = fDmgGen;
+	__atomic_fetch_add(&fDmgWritten, 1, __ATOMIC_RELAXED);
+	if (same) {
+		__atomic_fetch_add(&fDmgRolled, 1, __ATOMIC_RELAXED);
+	}
+}
+
+void
+IOMobileFramebuffer::drawRows(const RowJob * job, int32_t y0, int32_t y1, uint32_t * blendRow, uint32_t * rotRow)
+{
+	const uint8_t * pixels = job->pixels;
+	uint32_t stride = job->stride;
+	int32_t sx = job->sx, sy = job->sy, sw = job->sw, sh = job->sh;
+	int32_t px0 = job->px0, py0 = job->py0, px1 = job->px1, py1 = job->py1, cx0 = job->cx0, cx1 = job->cx1;
+	bool filter = job->filter;
+	bool turned = fRotate != 0 && rotRow != NULL;
+	/* 20v, fb_rottile=N: N upright rows gathered in rotRow, then put on the panel N pixels (one cache line at 16) per column */
+	bool tiled = turned && fRotTile > 1 && fRotate != 180;
+	/* 30sa3 fb_damage: each group's signature over its rows as they are gathered (unscaled frames only) */
+	const bool dmg = tiled && job->damage && job->unscaled && fDmg != NULL;
+	uint64_t lanes[4] = { 0, 0, 0, 0 }, hashAbs = 0;
+	int32_t gy0 = 0;
+	uint32_t gn = 0;
+	uint64_t anat = gAnat ? mach_absolute_time() : 0;      /* 30sa1: this drawer's whole share (read = all - write) */
+
+	for (int32_t y = y0; y < y1; y++) {
+		const uint32_t * from;
+		uint32_t * to;
+
+		if (y < 0 || (uint32_t) y >= fPanelHeight) {
+			continue;
+		}
+		if (tiled && gn != 0 && y != gy0 + (int32_t) gn) {
+			bandOut(job, gy0, gn, job->unscaled ? px0 : cx0, job->unscaled ? px0 + sw : cx1, rotRow, dmg ? lanes : NULL);
+			gn = 0;
+		}
+		if (tiled && gn == 0) {
+			gy0 = y;
+			lanes[0] = 0x243f6a8885a308d3ull;
+			lanes[1] = 0x13198a2e03707344ull;
+			lanes[2] = 0xa4093822299f31d0ull;
+			lanes[3] = 0x082efa98ec4e6c89ull;
+		}
+		/* turned: the row is made upright in rotRow first, then put on the panel as a column */
+		to = tiled ? rotRow + (size_t) gn * fRotStride : turned ? rotRow : (uint32_t *) (fBase + (size_t) y * fRowBytes);
+		if (job->unscaled) {
+			/* not scaled at all */
+			memcpy(to + px0, pixels + (size_t) (sy + y - py0) * stride + (size_t) sx * 4, (size_t) sw * 4);
+			if (dmg) {
+				uint64_t h0 = mach_absolute_time();
+
+				dmgHashRow(lanes, to + px0, (uint32_t) sw);
+				hashAbs += mach_absolute_time() - h0;
+			}
+			if (tiled) {
+				if (++gn == fRotTile) {
+					bandOut(job, gy0, gn, px0, px0 + sw, rotRow, dmg ? lanes : NULL);
+					gn = 0;
+				}
+			} else if (turned) {
+				rotateRow(y, px0, px0 + sw, rotRow);
+			}
+			continue;
+		}
+		if (filter) {
+			int64_t at = sample_at(y - py0, sh, py1 - py0);
+			uint32_t row = (uint32_t) (at >> 8), weight = (uint32_t) (at & 255);
+			const uint32_t * upper = (const uint32_t *) (pixels + (size_t) (sy + row) * stride) + sx;
+
+			if (weight == 0 || row + 1 >= (uint32_t) sh) {
+				from = upper;
+			} else {
+				const uint32_t * lower = (const uint32_t *) (pixels + (size_t) (sy + row + 1) * stride) + sx;
+				uint32_t first = fColumn[cx0], last = fColumn[cx1 - 1] + 1 < (uint32_t) sw ? fColumn[cx1 - 1] + 1 : fColumn[cx1 - 1];
+
+				uint32_t * __restrict mixed = blendRow;
+
+				for (uint32_t c = first; c <= last; c++) {
+					uint32_t a = upper[c], b = lower[c];
+
+					mixed[c] = a == b ? a : blend(a, b, weight);           /* (most of a screen is the same as next to it) */
+				}
+				from = blendRow;
+			}
+		} else {
+			from = (const uint32_t *) (pixels + (size_t) (sy + (int64_t) (y - py0) * sh / (py1 - py0)) * stride);
+		}
+		if (fDiff) {
+			for (int32_t x = cx0; x < cx1; x++) {
+				uint32_t value = filter ? blend(from[fColumn[x]], from[fColumn[x] + (fColumnWeight[x] != 0)], fColumnWeight[x]) :
+				    from[fColumn[x]];
+
+				if (to[x] != value) {
+					fDiffPixels++;
+					fDiffLeft = (uint32_t) x < fDiffLeft ? (uint32_t) x : fDiffLeft;
+					fDiffRight = (uint32_t) x > fDiffRight ? (uint32_t) x : fDiffRight;
+					fDiffTop = (uint32_t) y < fDiffTop ? (uint32_t) y : fDiffTop;
+					fDiffBottom = (uint32_t) y > fDiffBottom ? (uint32_t) y : fDiffBottom;
+				}
+			}
+		}
+		if (filter) {
+			const uint32_t * __restrict column = fColumn + cx0;
+			const uint16_t * __restrict weights = fColumnWeight + cx0;
+			uint32_t * __restrict out = to + cx0;
+
+			for (uint32_t i = 0, n = (uint32_t) (cx1 - cx0); i < n; i++) {
+				uint32_t c = column[i], w = weights[i], a = from[c];
+
+				out[i] = w == 0 || a == from[c + 1] ? a : blend(a, from[c + 1], w);
+			}
+		} else {
+			for (int32_t x = cx0; x < cx1; x++) {
+				to[x] = from[fColumn[x]];
+			}
+		}
+		if (tiled) {
+			if (++gn == fRotTile) {
+				rotateRows(gy0, gn, cx0, cx1, rotRow);
+				gn = 0;
+			}
+		} else if (turned) {
+			rotateRow(y, cx0, cx1, rotRow);
+		}
+	}
+	if (tiled && gn != 0) {
+		bandOut(job, gy0, gn, job->unscaled ? px0 : cx0, job->unscaled ? px0 + sw : cx1, rotRow, dmg ? lanes : NULL);
+	}
+	if (hashAbs != 0) {
+		__atomic_fetch_add(&fDmgHashAbs, hashAbs, __ATOMIC_RELAXED);
+	}
+	if (fScanWc != 0) {
+		/* 30sb fb_scanwc: this drawer's stores (and cleans) complete on its own CPU before it says it is done */
+		uint64_t at = anat != 0 ? mach_absolute_time() : 0;
+
+		scanDsb();
+		if (anat != 0) {
+			anatAdd(&fAnatWriteAbs, mach_absolute_time() - at);
+		}
+	}
+	if (anat != 0) {
+		anatAdd(&fAnatAllAbs, mach_absolute_time() - anat);
+	}
+}
+
+/*
+ * 30sa5 fb_scanpos=2: drawer `drawer`'s strips of the panel (strip k = panel rows k * S .. k * S + S - 1; the drawers take
+ * them in turn, each top to bottom), every upright row's piece of the strip gathered fb_rottile rows at a time and put on
+ * the panel as rotateRows does. Before each strip the scan position is read: overtaken / early counted (reads only).
+ * (A drawer that is the only one -- helpers not all started -- takes every strip: fThreads 1 or job shared out only when
+ * all are up, as drawLayer decides.)
+ */
+void
+IOMobileFramebuffer::drawBeam(const RowJob * job, unsigned drawer, uint32_t * rotRow)
+{
+	const uint32_t strip = gScanStrip >= 16 && gScanStrip <= 512 ? gScanStrip : 64;
+	const uint32_t rows = fPhysHeight, upright = fPanelHeight, tile = fRotTile;
+	const size_t rs = fRotStride;
+	const uint32_t strips = (rows + strip - 1) / strip, step = job->beamStep >= 1 ? job->beamStep : 1;
+	const uint64_t target = fSpTarget;
+	uint32_t done = 0, over = 0, early = 0;
+	uint64_t anat = gAnat ? mach_absolute_time() : 0;
+
+	for (uint32_t k = drawer; k < strips; k += step) {
+		uint32_t r0 = k * strip, r1 = r0 + strip < rows ? r0 + strip : rows;
+		int32_t x0 = fRotate == 270 ? (int32_t) (rows - r1) : (int32_t) r0;
+		int32_t x1 = fRotate == 270 ? (int32_t) (rows - r0) : (int32_t) r1;
+
+		if (target != 0) {
+			uint64_t p = spPos();
+
+			if (p != 0 && p + SP_MARGIN >= target + r0) {
+				over++;                 /* (this copy's scan in or past the strip: it shows old rows there) */
+			} else if (p != 0 && p + fSpVTotal < target + r1 + SP_MARGIN) {
+				early++;                /* (the scan before not yet past it: that scan shows new rows there) */
+			}
+		}
+		for (uint32_t gy0 = 0; gy0 < upright; gy0 += tile) {
+			uint32_t n = gy0 + tile <= upright ? tile : upright - gy0;
+
+			for (uint32_t i = 0; i < n; i++) {
+				memcpy(rotRow + (size_t) i * rs + x0, job->pixels + (size_t) (job->sy + (int32_t) (gy0 + i) - job->py0) * job->stride +
+				    (size_t) (job->sx + x0 - job->px0) * 4, (size_t) (x1 - x0) * 4);
+			}
+			rotateRows((int32_t) gy0, n, x0, x1, rotRow);
+		}
+		done++;
+	}
+	if (fScanWc != 0) {
+		scanDsb();              /* (as drawRows: this drawer's stores complete before it says it is done) */
+	}
+	__atomic_fetch_add(&fSpStrips, done, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&fSpOvertaken, over, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&fSpEarly, early, __ATOMIC_RELAXED);
+	if (anat != 0) {
+		anatAdd(&fAnatAllAbs, mach_absolute_time() - anat);
+	}
+}
+
+/* A helper of the scaling (fb_threads): waits for rows to do, does them, says so. */
+void
+IOMobileFramebuffer::helperMain(void * self, wait_result_t result __unused)
+{
+	IOMobileFramebuffer * fb = (IOMobileFramebuffer *) self;
+	unsigned index;
+	uint64_t done = 0;
+
+	IOLockLock(fb->fHelperLock);
+	index = fb->fHelpersStarted++;
+	IOLockUnlock(fb->fHelperLock);
+	for (;;) {
+		const RowJob * job;
+		int32_t rows, y0, y1;
+		uint32_t * blend;
+
+		IOLockLock(fb->fHelperLock);
+		while (fb->fHelperGeneration == done) {
+			IOLockSleep(fb->fHelperLock, &fb->fHelperGeneration, THREAD_UNINT);
+		}
+		done = fb->fHelperGeneration;
+		job = fb->fHelperJob;
+		IOLockUnlock(fb->fHelperLock);
+		/* share index + 1 of fThreads (the presenter takes share 0) */
+		rows = job->py1 - job->py0;
+		y0 = job->py0 + (int32_t) ((int64_t) rows * (index + 1) / fb->fThreads);
+		y1 = job->py0 + (int32_t) ((int64_t) rows * (index + 2) / fb->fThreads);
+		blend = fb->fHelperBlend[index];
+		if (job->beam) {
+			fb->drawBeam(job, index + 1, fb->fRotRow[index + 1]);   /* 30sa5: strips index + 1, + fThreads, ... */
+		} else {
+			fb->drawRows(job, y0, y1, blend, fb->fRotRow[index + 1]);
+		}
+		if (gAnat) {
+			fb->anatCpu(index + 1);         /* 30sb */
+		}
+		IOLockLock(fb->fHelperLock);
+		fb->fHelpersBusy--;
+		if (fb->fHelpersBusy == 0) {
+			IOLockWakeup(fb->fHelperLock, &fb->fHelpersBusy, true);
+		}
+		IOLockUnlock(fb->fHelperLock);
+	}
+}
+
+/*
+ * Put a rectangle of a 32-bit surface on the screen. `dst` is in display coordinates; the
+ * panel may be of another size, and the layer itself may be scaled: both are done in one
+ * step, bilinear (or nearest neighbour: fb_filter=0).
+ */
+void
+IOMobileFramebuffer::drawLayer(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	int32_t sx = src[0], sy = src[1], sw = src[2], sh = src[3];
+	int32_t dx = dst[0], dy = dst[1], dw = dst[2], dh = dst[3];
+	int32_t px0, py0, px1, py1, cx0, cx1;
+	bool filter = gFilter != 0;
+	RowJob job;
+
+	if (sw <= 0 || sh <= 0) {
+		sx = sy = 0;
+		sw = (int32_t) s->info.width;
+		sh = (int32_t) s->info.height;
+	}
+	if (dw <= 0 || dh <= 0) {
+		dx = dy = 0;
+		dw = (int32_t) fWidth;
+		dh = (int32_t) fHeight;
+	}
+	if (sx < 0 || sy < 0 || (uint32_t) (sx + sw) > s->info.width || (uint32_t) (sy + sh) > s->info.height) {
+		return;
+	}
+	/* the rectangle on the panel */
+	px0 = (int32_t) ((int64_t) dx * fPanelWidth / fWidth);
+	py0 = (int32_t) ((int64_t) dy * fPanelHeight / fHeight);
+	px1 = (int32_t) ((int64_t) (dx + dw) * fPanelWidth / fWidth);
+	py1 = (int32_t) ((int64_t) (dy + dh) * fPanelHeight / fHeight);
+	if (px1 <= px0 || py1 <= py0) {
+		return;
+	}
+	/* (blending, a row of the picture mixed from two: room for it, for every one who draws rows) */
+	if (filter && fBlendRowSize < (uint32_t) sw) {
+		if (fBlendRow != NULL) {
+			IODelete(fBlendRow, uint32_t, fBlendRowSize);
+		}
+		for (unsigned i = 0; i + 1 < fThreads; i++) {
+			if (fHelperBlend[i] != NULL) {
+				IODelete(fHelperBlend[i], uint32_t, fBlendRowSize);
+			}
+		}
+		fBlendRowSize = (uint32_t) sw;
+		fBlendRow = IONew(uint32_t, fBlendRowSize);
+		for (unsigned i = 0; i + 1 < fThreads; i++) {
+			fHelperBlend[i] = IONew(uint32_t, fBlendRowSize);
+			if (fHelperBlend[i] == NULL && fBlendRow != NULL) {
+				IODelete(fBlendRow, uint32_t, fBlendRowSize);
+				fBlendRow = NULL;
+			}
+		}
+		if (fBlendRow == NULL) {
+			fBlendRowSize = 0;
+		}
+	}
+	filter = filter && fBlendRow != NULL;
+	/* which pixel of a source row each pixel of a panel row takes: worked out once, not 2.6 million times */
+	cx0 = px0 < 0 ? 0 : px0;
+	cx1 = (uint32_t) px1 > fPanelWidth ? (int32_t) fPanelWidth : px1;
+	for (int32_t x = cx0; x < cx1; x++) {
+		if (filter) {
+			int64_t at = sample_at(x - px0, sw, px1 - px0);
+
+			fColumn[x] = (uint32_t) (at >> 8);              /* (in the blended row: from sx on) */
+			fColumnWeight[x] = (uint16_t) (fColumn[x] + 1 < (uint32_t) sw ? at & 255 : 0);
+		} else {
+			fColumn[x] = (uint32_t) (sx + (int64_t) (x - px0) * sw / (px1 - px0));
+		}
+	}
+	job.pixels = s->pixels();
+	job.stride = s->info.bytesPerRow;
+	job.sx = sx;
+	job.sy = sy;
+	job.sw = sw;
+	job.sh = sh;
+	job.px0 = px0;
+	job.py0 = py0;
+	job.px1 = px1;
+	job.py1 = py1;
+	job.cx0 = cx0;
+	job.cx1 = cx1;
+	job.filter = filter;
+	job.unscaled = px1 - px0 == sw && py1 - py0 == sh && px0 >= 0 && (uint32_t) px1 <= fPanelWidth;
+	job.damage = false;
+	job.beam = false;
+	job.beamStep = fThreads <= 1 || fDiff || fHelpersStarted + 1 < fThreads ? 1 : fThreads;
+	{
+		/* 30sa3 / 30sa5: a frame of this one layer, the whole panel, unscaled, turned in tiles (fDmgFrame: show() says) */
+		const bool whole = fDmgFrame && job.unscaled && px0 == 0 && py0 == 0 && px1 == (int32_t) fPanelWidth &&
+		    py1 == (int32_t) fPanelHeight && sx == 0 && sy == 0 && (fRotate == 90 || fRotate == 270) && fRotTile > 1 && !fDiff &&
+		    fRotRow[0] != NULL;
+
+		if (whole && gScanPos >= 2 && spMap()) {
+			job.beam = true;
+		} else if (whole && fDmg != NULL) {
+			job.damage = true;
+			fDmgUsed = true;
+		}
+	}
+	if (gAnat) {
+		anatPars(s);    /* 30sa1: before the first frame, then every 5 s (reads only) */
+	}
+	if (fScanWc == 2 && !((fRotate == 90 || fRotate == 270) && fRotTile > 1)) {
+		fScanWbAll = true;      /* 30sb fb_scanwc=2: not the tiled rotation, which cleans its own lines: all, in show() */
+	}
+	if (job.beam) {
+		spGate();               /* 30sa5: the copy's start put 0.5-4 ms before the next scan's first active line */
+	}
+	uint64_t copyStart = mach_absolute_time();     /* 20v: the present copy's time */
+	if (job.damage) {
+		fDmgTick++;             /* 30sa3: the rolling refresh moves on a group a frame */
+		fDmgFrames++;
+	}
+	if (job.beamStep == 1) {
+		if (job.beam) {
+			drawBeam(&job, 0, fRotRow[0]);
+		} else {
+			drawRows(&job, py0, py1, fBlendRow, fRotRow[0]);
+		}
+		if (gAnat) {
+			anatCpu(0);     /* 30sb */
+		}
+		fSpTarget = 0;
+		noteCopy(mach_absolute_time() - copyStart);
+		return;
+	}
+	/* shared out: the helpers take their rows, this thread the first share, then waits for them */
+	IOLockLock(fHelperLock);
+	fHelperJob = &job;
+	fHelpersBusy = fThreads - 1;
+	fHelperGeneration++;
+	IOLockWakeup(fHelperLock, &fHelperGeneration, false);
+	IOLockUnlock(fHelperLock);
+	if (job.beam) {
+		drawBeam(&job, 0, fRotRow[0]);
+	} else {
+		drawRows(&job, py0, py0 + (int32_t) ((int64_t) (py1 - py0) / fThreads), fBlendRow, fRotRow[0]);
+	}
+	if (gAnat) {
+		anatCpu(0);     /* 30sb */
+	}
+	IOLockLock(fHelperLock);
+	while (fHelpersBusy != 0) {
+		IOLockSleep(fHelperLock, &fHelpersBusy, THREAD_UNINT);
+	}
+	IOLockUnlock(fHelperLock);
+	fSpTarget = 0;
+	noteCopy(mach_absolute_time() - copyStart);
+}
+
+/* 28h2: fb_thumb (see gThumb); fLock held */
+void
+IOMobileFramebuffer::reportThumb(void)
+{
+	enum { TW = 24, TH = 34 };
+	static char digits[TH][TW + 1];
+	static uint8_t cells[TH][TW];
+	uint32_t sum = 2166136261u, edge[4] = { 0, 0, 0, 0 };     /* top, bottom, left, right */
+	uint32_t maxLuma = 0, lit = 0;
+	uint32_t pw = fPanelWidth, ph = fPanelHeight;
+	uint64_t ms;
+	/*
+	 * 25e2: with direct scanout (icescan=3) the panel memory is not what is shown: read the surface the display fetches
+	 * now, and with fb_disprot (CoreAnimation draws the portrait UI turned into a landscape surface) turn it back as
+	 * the copy path's fRotate does, so both thumbnails are the picture as the user sees it and compare cell for cell.
+	 */
+	const uint8_t *base = (const uint8_t *) fBase;
+	uint32_t rowBytes = fRowBytes, physW = fPhysWidth, physH = fPhysHeight, rot = fRotate;
+	const char *source = "panel memory";
+
+	if (gIceScan >= 3 && scn.current != 0 && !scn.c_failed) {
+		MiniIOSurface *s = scn.slot[scn.current - 1];
+
+		if (s != NULL && s->kpixels != NULL && s->info.bytesPerElement == 4) {
+			base = s->pixels();
+			rowBytes = s->info.bytesPerRow;
+			physW = s->info.width;
+			physH = s->info.height;
+			rot = gDispRot == 90 || gDispRot == 180 || gDispRot == 270 ? gDispRot : 0;
+			pw = rot == 90 || rot == 270 ? physH : physW;
+			ph = rot == 90 || rot == 270 ? physW : physH;
+			source = "scanout surface";
+		}
+	}
+	if (base == NULL || pw == 0 || ph == 0) {
+		return;
+	}
+	for (uint32_t r = 0; r < TH; r++) {
+		for (uint32_t c = 0; c < TW; c++) {
+			uint32_t luma = 0;
+
+			for (uint32_t i = 0; i < 3; i++) {
+				for (uint32_t j = 0; j < 3; j++) {
+					uint32_t x = (uint32_t) (((uint64_t) c * 3 + j) * 2 + 1) * pw / (TW * 6);
+					uint32_t y = (uint32_t) (((uint64_t) r * 3 + i) * 2 + 1) * ph / (TH * 6);
+					uint32_t mr, mc, p;
+
+					switch (rot) {
+					case 270: mr = physH - 1 - x; mc = y; break;
+					case 90: mr = x; mc = physW - 1 - y; break;
+					case 180: mr = physH - 1 - y; mc = physW - 1 - x; break;
+					default: mr = y; mc = x; break;
+					}
+					if (mr >= physH || mc >= physW) {
+						continue;
+					}
+					p = *(const volatile uint32_t *) (base + (size_t) mr * rowBytes + (size_t) mc * 4);
+					lit += (p & 0xffffff) != 0;
+					/* BGRA in memory: (2 r + 5 g + b) / 8 */
+					luma += (2 * ((p >> 16) & 0xff) + 5 * ((p >> 8) & 0xff) + (p & 0xff)) / 8;
+				}
+			}
+			luma /= 9;
+			cells[r][c] = (uint8_t) luma;
+			maxLuma = luma > maxLuma ? luma : maxLuma;
+			edge[0] += r < 2 ? luma : 0;
+			edge[1] += r >= TH - 2 ? luma : 0;
+			edge[2] += c < 2 ? luma : 0;
+			edge[3] += c >= TW - 2 ? luma : 0;
+		}
+	}
+	/*
+	 * 28h2b: auto levels. 28h2's home screen (black wallpaper, no icons yet) is nearly all under 16 of 255, which the
+	 * fixed scale (luma / 16) printed as 0 everywhere: the digits now span 0..f between black and this picture's
+	 * brightest cell ("max"), so a dark picture's layout still shows; "lit" counts the sampled pixels not black.
+	 */
+	for (uint32_t r = 0; r < TH; r++) {
+		for (uint32_t c = 0; c < TW; c++) {
+			uint32_t d = maxLuma != 0 ? (cells[r][c] * 15u + maxLuma / 2) / maxLuma : 0;
+
+			digits[r][c] = "0123456789abcdef"[d > 15 ? 15 : d];
+			sum = (sum ^ (uint32_t) digits[r][c]) * 16777619u;
+		}
+		digits[r][TW] = 0;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ms);
+	/*
+	 * 25e3: IOLog goes through redwood_tl's 192-character line: 28h2's two lines of 17 rows each were cut after ~3 rows
+	 * (20ag, 20ae3: "rows 0-16: 000.../000.../0000000000000000000fb" and the rest gone). Now printf, a header and one
+	 * short line per row ("fbthumb: <ms> r07 <24 digits>"), every third report (15 s) to keep the log's tail.
+	 */
+	{
+		static uint32_t round;
+
+		if (round++ % 3 != 0) {
+			return;
+		}
+	}
+	printf("fbthumb: at %llu ms %s rot %u %ux%u sum %08x max %02x lit %u/%u edges top %02x bottom %02x left %02x right %02x "
+	    "(%u rows follow)\n", ms / NSEC_PER_MSEC, source, rot, pw, ph, sum, maxLuma, lit, (uint32_t) (TW * TH * 9),
+	    edge[0] / (2 * TW), edge[1] / (2 * TW), edge[2] / (2 * TH), edge[3] / (2 * TH), (uint32_t) TH);
+	for (uint32_t r = 0; r < TH; r++) {
+		printf("fbthumb: %llu r%02u %s\n", ms / NSEC_PER_MSEC, r, digits[r]);
+	}
+}
+
+/*
+ * 30sa1 fb_anat: PAR_EL1 of the surface's first source pixel (the kernel VA the copy reads) and of the panel's first
+ * pixel (what it writes), before the first frame and then every 5 s; with gpu_cached / fb_inval as booted. (fLock held)
+ */
+void
+IOMobileFramebuffer::anatPars(MiniIOSurface * s)
+{
+	static uint32_t cached = ~0u;
+	uint64_t now = mach_absolute_time(), every, ms, sp, fp;
+
+	nanoseconds_to_absolutetime(5 * NSEC_PER_SEC, &every);
+	if (fAnatParAt != 0 && now - fAnatParAt < every) {
+		return;
+	}
+	fAnatParAt = now;
+	if (cached == ~0u && !PE_parse_boot_argn("gpu_cached", &cached, sizeof(cached))) {
+		cached = 0;
+	}
+	sp = anatPar(s->pixels());
+	fp = anatPar(fBase);
+	absolutetime_to_nanoseconds(now, &ms);
+	printf("fbanat: %llu ms sid %u %ux%u r%u src par %016llx a%02x %s; scan par %016llx a%02x %s; gpu_cached %u fb_inval %u "
+	    "scanwc %u pri %u\n",
+	    ms / NSEC_PER_MSEC, s->sid, s->info.width, s->info.height, s->info.bytesPerRow, sp, (unsigned) (sp >> 56),
+	    anatKind(sp), fp, (unsigned) (fp >> 56), anatKind(fp), cached, gFbInval, fScanWc, gFbPri);
+}
+
+/*
+ * 30sb fb_scanwc=1|2 (see gScanWc): the panel's pages mapped again for the copy -- same physical address, Normal
+ * non-cacheable (1) or write-back (2) -- and fBase moved there. Nothing is written to any device: a new kernel VA and its
+ * page-table entries only. Any doubt (not one physical piece, the new VA faults): fBase stays the console's mapping.
+ */
+void
+IOMobileFramebuffer::scanwcMap(void)
+{
+	vm_offset_t va = (vm_offset_t) vinfo.v_baseaddr, to;
+	vm_size_t bytes = (vm_size_t) vinfo.v_rowbytes * vinfo.v_height;
+	uint64_t pa = kvtophys(va), last = kvtophys(va + bytes - 1), was = anatPar((const void *) va), par;
+	unsigned want = gScanWc == 1 ? 0x44 : 0xff;
+
+	if (pa == 0 || bytes == 0 || last != pa + bytes - 1) {
+		printf("fbwc: mode %u: the panel is not one physical piece (%#llx, last byte %#llx): fb_scanwc not used\n", gScanWc,
+		    pa, last);
+		return;
+	}
+	if (gScanWc == 1) {
+		/* pmap.c wimg_to_pte: VM_WIMG_WCOMB in this range -> CACHE_ATTRINDX_WRITECOMB (16 KB pages: whole pages) */
+		hakios_normal_nc2_lo = pa & ~0x3fffull;
+		hakios_normal_nc2_hi = (pa + bytes + 0x3fffull) & ~0x3fffull;
+		__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	}
+	to = ml_io_map_unmappable((vm_offset_t) pa, bytes, gScanWc == 1 ? VM_WIMG_WCOMB : VM_WIMG_COPYBACK);
+	par = to != 0 ? anatPar((const void *) to) : 1;
+	printf("fbwc: mode %u: panel %#llx (%llu KB) mapped again at %#llx: par %016llx a%02x %s (want a%02x%s); the console's "
+	    "par %016llx a%02x %s\n", gScanWc, pa, (uint64_t) bytes >> 10, (uint64_t) to, par, (unsigned) (par >> 56),
+	    anatKind(par), want, (par & 1) ? ": NOT USED" : (unsigned) (par >> 56) == want ? "" : ": other attribute, used anyway",
+	    was, (unsigned) (was >> 56), anatKind(was));
+	if (to == 0 || (par & 1) || (par & ~0xff00000000000fffull) != (pa & ~0xfffull)) {
+		if (to != 0 && !(par & 1)) {
+			printf("fbwc: the new mapping's PA %#llx is not the panel's %#llx: NOT USED\n", par & ~0xff00000000000fffull,
+			    pa & ~0xfffull);
+		}
+		return;
+	}
+	fScanWcPar = par;
+	fScanWcBytes = bytes;
+	fBase = (uint8_t *) to;
+	fScanWc = gScanWc;
+}
+
+/* 30sb fb_scanwc=2: the lines from `first` to `last` (bytes, inclusive) cleaned to memory (DC CVAC; the DSB comes after) */
+void
+IOMobileFramebuffer::scanwcLines(const void * first, const void * last)
+{
+	for (uintptr_t line = (uintptr_t) first & ~(uintptr_t) 63; line <= (uintptr_t) last; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line) : "memory");
+	}
+}
+
+/* 30sb (fb_anat): drawer `drawer` (0: the presenter, i: helper i - 1) has just drawn its share on this CPU */
+void
+IOMobileFramebuffer::anatCpu(unsigned drawer)
+{
+	int c = cpu_number();
+
+	if (drawer < 8) {
+		fAnatCpu[drawer] = c + 1;
+		if (c >= 0 && c < 64) {
+			__atomic_fetch_or(&fAnatCpuMask[drawer], 1ull << c, __ATOMIC_RELAXED);
+		}
+	}
+}
+
+/* 20v: one layer's copy onto the panel took `abs` (wall time, all its drawers together) */
+void
+IOMobileFramebuffer::noteCopy(uint64_t abs)
+{
+	fCopyAbs += abs;
+	fCopyLayers++;
+	if (abs > fCopyMaxAbs) {
+		fCopyMaxAbs = abs;
+	}
+}
+
+/*
+ * How evenly the frames of the last seconds came: how many followed the one before within the
+ * time of one refresh at 120, 60, 40 and 30 a second, and the times half and 95 in 100 of them
+ * stayed under. With the lock held.
+ */
+void
+IOMobileFramebuffer::reportFrameTimes(void)
+{
+	static const uint32_t limits[] = { 10, 18, 26, 35, FRAME_TIMES + 1 };
+	uint32_t within[sizeof(limits) / sizeof(limits[0])] = { 0 }, total = 0, sum = 0, half = 0, most = 0;
+
+	if (fPaceFrames != 0) {
+		/* 25e2: where a frame's time goes, in us: waiting for its GPU work, then its present (copy, or the flip) */
+		uint64_t g, gm, p, pm;
+
+		absolutetime_to_nanoseconds(fPaceGpuAbs / fPaceFrames, &g);
+		absolutetime_to_nanoseconds(fPaceGpuMax, &gm);
+		absolutetime_to_nanoseconds(fPacePresentAbs / fPaceFrames, &p);
+		absolutetime_to_nanoseconds(fPacePresentMax, &pm);
+		printf("fbpace: %u frames (%s, %u Hz): GPU wait %llu us avg / %llu max (%u over a period), present %llu us avg / %llu "
+		    "max (%u over a period)\n", fPaceFrames, gIceScan >= 3 && scn.shows != 0 && !scn.c_failed ? "scanout" : "copy",
+		    refreshHz(), g / 1000, gm / 1000, fPaceGpuOver, p / 1000, pm / 1000, fPacePresentOver);
+		fPaceFrames = fPaceGpuOver = fPacePresentOver = 0;
+		fPaceGpuAbs = fPaceGpuMax = fPacePresentAbs = fPacePresentMax = 0;
+	}
+	if (gFrameInfo) {
+		printf("fbinfo: %llu shown, %llu sent, %llu not (no client %llu, closed %llu, no callback %llu, no port %llu, no "
+		    "items %llu), send errors %llu (last %#x)\n", gFrameInfoCalls, gFrameInfoSent, gFrameInfoDropped,
+		    gFrameInfoNoClient, gFrameInfoWhy[0], gFrameInfoWhy[1], gFrameInfoWhy[2], gFrameInfoWhy[3], gFrameInfoSendErr,
+		    gFrameInfoLastErr);
+	}
+	for (uint32_t ms = 0; ms <= FRAME_TIMES; ms++) {
+		for (uint32_t i = 0; i < sizeof(limits) / sizeof(limits[0]); i++) {
+			if (ms < limits[i]) {
+				within[i] += fFrameTimes[ms];
+				break;
+			}
+		}
+		total += fFrameTimes[ms];
+	}
+	for (uint32_t ms = 0; ms <= FRAME_TIMES && total != 0; ms++) {
+		sum += fFrameTimes[ms];
+		if (half == 0 && 2 * sum >= total) {
+			half = ms + 1;
+		}
+		if (most == 0 && 100 * sum >= 95 * total) {
+			most = ms + 1;
+		}
+	}
+	if (total != 0) {
+		IOLog("MiniIOMobileFramebuffer: from one frame to the next: %u times under 10 ms, %u under 18, %u under 26, %u under 35, "
+		    "%u longer (the longest %u ms); half under %u ms, 95 in 100 under %u ms; %u pauses\n", within[0], within[1],
+		    within[2], within[3], within[4], fFrameLongest, half, most, fFramePauses);
+	}
+	if (fCopyLayers != 0) {
+		uint64_t ns, maxns;
+
+		absolutetime_to_nanoseconds(fCopyAbs, &ns);
+		absolutetime_to_nanoseconds(fCopyMaxAbs, &maxns);
+		IOLog("MiniIOMobileFramebuffer: present copy: %u layers, %llu us each on average, the longest %llu us, %llu ms in all "
+		    "(%u drawers, %s)\n", fCopyLayers, ns / 1000 / fCopyLayers, maxns / 1000, ns / 1000000, fThreads,
+		    fRotate == 0 ? "not turned" : fRotTile > 1 ? "turned in tiles" : "turned row by row");
+		if (gAnat) {
+			/* 30sa1: CPU time a layer, all drawers added up: read (+ scale, into fRotRow) and the rotated write */
+			uint64_t all = __atomic_load_n(&fAnatAllAbs, __ATOMIC_RELAXED), wr = __atomic_load_n(&fAnatWriteAbs, __ATOMIC_RELAXED);
+			uint64_t alln, wrn;
+
+			absolutetime_to_nanoseconds(all, &alln);
+			absolutetime_to_nanoseconds(wr < all ? wr : all, &wrn);
+			/* 30sb: each drawer's last CPU / the CPUs it ran on since the last report (hex mask), "d<i> -" if none */
+			char cpus[8 * 24];
+			size_t used = 0;
+
+			cpus[0] = 0;
+			for (unsigned i = 0; i < fThreads && i < 8 && used < sizeof(cpus); i++) {
+				uint64_t mask = __atomic_exchange_n(&fAnatCpuMask[i], 0, __ATOMIC_RELAXED);
+				int n = fAnatCpu[i] != 0 ? snprintf(cpus + used, sizeof(cpus) - used, " d%u %d/%llx", i, fAnatCpu[i] - 1, mask) :
+				    snprintf(cpus + used, sizeof(cpus) - used, " d%u -", i);
+
+				used += n > 0 ? (size_t) n : 0;
+			}
+			printf("fbanat: copy %u layers, cpu us a layer: read %llu write %llu (all %llu, wall %llu, %u drawers, rot %u tile %u) "
+			    "scanwc %u pri %u cpus%s\n",
+			    fCopyLayers, (alln - wrn) / 1000 / fCopyLayers, wrn / 1000 / fCopyLayers, alln / 1000 / fCopyLayers,
+			    ns / 1000 / fCopyLayers, fThreads, fRotate, fRotTile, fScanWc, gFbPri, cpus);
+		}
+	}
+	__atomic_store_n(&fAnatAllAbs, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&fAnatWriteAbs, 0, __ATOMIC_RELAXED);
+	fCopyAbs = fCopyMaxAbs = 0;
+	fCopyLayers = 0;
+	bzero(fFrameTimes, sizeof(fFrameTimes));
+	fFramePauses = fFrameLongest = 0;
+}
+
+/* SwapEnd: the swap is handed to the thread that puts frames on the panel, as soon as that has no other waiting. */
+void
+IOMobileFramebuffer::present(const uint8_t * swap)
+{
+	AbsoluteTime deadline;
+
+	uint64_t now = mach_absolute_time(), period, pause;
+
+	/* (a frame that is late on the panel was late here already, or it was not: for telling whose it is) */
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / refreshHz() * 5 / 4, &period);
+	nanoseconds_to_absolutetime(FRAME_PAUSE * NSEC_PER_MSEC, &pause);
+	clock_interval_to_deadline(SWAP_HELD_MS, kMillisecondScale, &deadline);
+	if (gTouchLat) {
+		redwood_tl("tl: s %u at %llu\n", swapWord(swap, SWAP_ID), micros(now));
+	}
+	IOLockLock(fSwapLock);
+	fStatSwapsLate += fSwapTime != 0 && now - fSwapTime > period && now - fSwapTime < pause;
+	fSwapTime = now;
+	fStatHeld += fSwapsWaiting >= swapQueue();
+	while (fSwapsWaiting >= swapQueue()) {
+		if (IOLockSleepDeadline(fSwapLock, &fSwapsWaiting, deadline, THREAD_UNINT) == THREAD_TIMED_OUT &&
+		    fSwapsWaiting >= swapQueue()) {
+			fStatLost++;                    /* (the GPU has stopped answering: the frame before is waiting for it) */
+			gFbc.lost++;
+			IOLockUnlock(fSwapLock);
+			return;
+		}
+	}
+	unsigned slot = (fSwapFirst + fSwapsWaiting) % SWAP_QUEUE;
+
+	memcpy(fSwap[slot], swap, SWAP_SIZE);
+	for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+		uint32_t sid = swapWord(swap, SWAP_SURFACE(layer));
+
+		fSwapSurfaces[slot][layer] = sid != 0 ? MiniIOSurfaceCopy(sid) : NULL;
+	}
+	hakios_ui_swap_at = mach_absolute_time();
+	/* 20l: icegate -- whose submissions wait for the flip: the program that swaps */
+	if (gIceGate) {
+		if (gGateLock == NULL) {
+			gGateLock = IOLockAlloc();
+		}
+		gGatePid = proc_selfpid();
+	}
+	/* 20g: drawn while the display read it (scn.torn); iceinuse=1: in use from here until shown and replaced */
+	if (gIceScan >= 3 && scn.shows != 0) {
+		uint32_t sid0 = swapWord(swap, SWAP_SURFACE(0));
+
+		scn.torn += sid0 != 0 && sid0 == fSidAtReturn;
+		if (gIceInUse) {
+			MiniIOSurfaceDisplayUse(fSwapSurfaces[slot][0], 1);
+			fSwapMarked[slot] = fSwapSurfaces[slot][0] != NULL;
+		}
+	}
+	fSwapsWaiting++;
+	gFbc.presented++;
+	IOLockWakeup(fSwapLock, fSwap, true);
+	uint64_t ticket = ++fSwapsQueued;
+	/* 20f, icesync=1 with the display fetching the surfaces itself: back once this frame is on the display */
+	if (gIceSync && scn.shows != 0 && !scn.c_failed) {
+		uint64_t held = mach_absolute_time();
+
+		/* 20k: icesync=N (N >= 2): held at most N ms (a short cap: most of the protection, a bounded cost) */
+		if (gIceSync >= 2) {
+			clock_interval_to_deadline(gIceSync, kMillisecondScale, &deadline);
+		}
+		while (fSwapsDone < ticket) {
+			if (IOLockSleepDeadline(fSwapLock, &fSwapsDone, deadline, THREAD_UNINT) == THREAD_TIMED_OUT &&
+			    fSwapsDone < ticket) {
+				scn.sync_late++;
+				break;
+			}
+		}
+		scn.synced++;
+		scn.sync_abs += mach_absolute_time() - held;
+	}
+	fSidAtReturn = scn.cur_sid;
+	IOLockUnlock(fSwapLock);
+}
+
+void
+IOMobileFramebuffer::presenterMain(void * self, wait_result_t result __unused)
+{
+	((IOMobileFramebuffer *) self)->presenter();
+}
+
+void
+IOMobileFramebuffer::presenter(void)
+{
+	static uint8_t swap[SWAP_SIZE];         /* (one thread) */
+	MiniIOSurface * surfaces[SWAP_LAYERS];
+
+	for (;;) {
+		IOLockLock(fSwapLock);
+		while (fSwapsWaiting == 0) {
+			IOLockSleep(fSwapLock, fSwap, THREAD_UNINT);
+		}
+		memcpy(swap, fSwap[fSwapFirst], SWAP_SIZE);
+		memcpy(surfaces, fSwapSurfaces[fSwapFirst], sizeof(surfaces));
+		bool marked = fSwapMarked[fSwapFirst];
+		fSwapMarked[fSwapFirst] = false;
+		IOLockUnlock(fSwapLock);
+		show(swap, surfaces);
+		if (gIceGate) {
+			gate_set(false);        /* (20l: the flip is taken, or this swap was not scanned out: the GPU may go on) */
+		}
+		if (marked) {
+			MiniIOSurfaceDisplayUse(surfaces[0], -1);       /* (iceinuse: the display's own mark, if shown, stays: scn_frame) */
+		}
+		if (!fEarlyDone) {              /* (30sa4 fb_early: show() told it done already) */
+			IOLockLock(fSwapLock);
+			fSwapsDone++;
+			IOLockWakeup(fSwapLock, &fSwapsDone, false);
+			IOLockUnlock(fSwapLock);
+		}
+		fEarlyDone = false;
+		for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+			if (surfaces[layer] != NULL) {
+				MiniIOSurfaceDrop(surfaces[layer]);
+			}
+		}
+		MiniIOSurfaceClearKept();               /* (the next frame is some milliseconds away) */
+	}
+}
+
+/*
+ * dada: the surface shown by the display controller from a buffer of its own, if it can be: 32 bits a pixel, one
+ * plane, of the display's whole size. False: it is drawn onto the panel as before.
+ */
+bool
+IOMobileFramebuffer::scanout(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	uint32_t bytes = s->info.bytesPerRow * s->info.height;
+	uint64_t began = mach_absolute_time(), nanos;
+	uint8_t * buffer;
+
+	(void) src;
+	(void) dst;
+	if (s->info.bytesPerElement != 4 || s->info.planeCount != 0 || s->info.width != fWidth || s->info.height != fHeight ||
+	    (buffer = hakios_dada_scanout_buffer(bytes)) == NULL) {
+		return false;
+	}
+	/*
+	 * What the GPU drew is in memory and not in this processor's cache, which may still hold lines of the surface
+	 * from before -- the zeros it was made with, or the last frame copied out of it -- and a copy would read those:
+	 * black or stale blocks that come and go as the lines do. Out of the cache first (clean and invalidate).
+	 */
+	for (uintptr_t line = (uintptr_t) s->pixels() & ~(uintptr_t) 63; line < (uintptr_t) s->pixels() + bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	memcpy(buffer, s->pixels(), bytes);
+	fScanCopying += mach_absolute_time() - began;
+	if (!hakios_dada_scanout_show(s->info.bytesPerRow, s->info.width, s->info.height)) {
+		return false;
+	}
+	if (++fScanShown % 600 == 1) {
+		absolutetime_to_nanoseconds(fScanCopying, &nanos);
+		IOLog("MiniIOMobileFramebuffer: %u frames shown from the display's buffers, %llu us a copy (surface %u, %u bytes a "
+		    "row)\n", fScanShown, nanos / fScanShown / NSEC_PER_USEC, s->sid, s->info.bytesPerRow);
+	}
+	return true;
+}
+
+/*
+ * iceland, fb_check / fb_inval: drawLayer() for the bottom layer, with the surface's 16 x 16 points looked at before and the
+ * panel's after (see gFbCheck), and with fb_inval=1 the surface out of the cache first. (With fLock held, from show().)
+ */
+void
+IOMobileFramebuffer::fbcheckDraw(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	static uint32_t c[256], m[256], f[256];
+	static int32_t sxs[16], sys_[16];
+	int32_t sx = src[0], sy = src[1], sw = src[2], sh = src[3];
+	int32_t dx = dst[0], dy = dst[1], dw = dst[2], dh = dst[3];
+	int32_t px0, py0, px1, py1;
+	const uint8_t * pixels = s->pixels();
+	uint32_t row = s->info.bytesPerRow, lit_c = 0, lit_m = 0, lit_f = 0, stale = 0, wrong = 0;
+	uint64_t room = s->info.allocSize > s->info.offset ? s->info.allocSize - s->info.offset : 0;
+	bool check = gFbCheck != 0 && fRotate == 0 && s->kpixels != NULL, unscaled;
+
+	if (sw <= 0 || sh <= 0) {
+		sx = sy = 0;
+		sw = (int32_t) s->info.width;
+		sh = (int32_t) s->info.height;
+	}
+	if (dw <= 0 || dh <= 0) {
+		dx = dy = 0;
+		dw = (int32_t) fWidth;
+		dh = (int32_t) fHeight;
+	}
+	px0 = (int32_t) ((int64_t) dx * fPanelWidth / fWidth);
+	py0 = (int32_t) ((int64_t) dy * fPanelHeight / fHeight);
+	px1 = (int32_t) ((int64_t) (dx + dw) * fPanelWidth / fWidth);
+	py1 = (int32_t) ((int64_t) (dy + dh) * fPanelHeight / fHeight);
+	unscaled = px1 - px0 == sw && py1 - py0 == sh;
+	if (px1 <= px0 || py1 <= py0) {
+		check = false;
+	}
+	/* the panel's 16 x 16 points (screen_look's grid) and the surface's pixels under them (-1: not under the layer) */
+	for (int32_t k = 0; check && k < 16; k++) {
+		int32_t x = (int32_t) ((2 * k + 1) * fPhysWidth / 32), y = (int32_t) ((2 * k + 1) * fPhysHeight / 32);
+
+		sxs[k] = x >= px0 && x < px1 ? sx + (int32_t) ((int64_t) (x - px0) * sw / (px1 - px0)) : -1;
+		sys_[k] = y >= py0 && y < py1 ? sy + (int32_t) ((int64_t) (y - py0) * sh / (py1 - py0)) : -1;
+	}
+	/* c: the surface as the cache has it, which is what the copy will read */
+	for (uint32_t j = 0; check && j < 16; j++) {
+		for (uint32_t i = 0; i < 16; i++) {
+			uint64_t at = (uint64_t) sys_[j] * row + (uint64_t) sxs[i] * 4;
+
+			c[16 * j + i] = sxs[i] < 0 || sys_[j] < 0 || at + 4 > room ? 0 : *(const volatile uint32_t *) (pixels + at);
+		}
+	}
+	if (gFbInval) {
+		uint64_t began = mach_absolute_time(), nanos;
+		uint64_t bytes = room < (uint64_t) row * s->info.height ? room : (uint64_t) row * s->info.height;
+
+		for (uintptr_t line = (uintptr_t) pixels & ~(uintptr_t) 63; line < (uintptr_t) pixels + bytes; line += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &nanos);
+		gFbc.invalNanos += nanos;
+		gFbc.invalFrames++;
+	}
+	drawLayer(s, src, dst);
+	if (!check) {
+		return;
+	}
+	/* f: the panel's memory after the copy; m: the surface from memory (those lines out of the cache first) */
+	for (uint32_t j = 0; j < 16; j++) {
+		for (uint32_t i = 0; i < 16; i++) {
+			uint32_t x = (2 * i + 1) * fPhysWidth / 32, y = (2 * j + 1) * fPhysHeight / 32;
+			uint64_t at = (uint64_t) sys_[j] * row + (uint64_t) sxs[i] * 4;
+			bool under = sxs[i] >= 0 && sys_[j] >= 0 && at + 4 <= room;
+			uint32_t k = 16 * j + i;
+
+			f[k] = *(const volatile uint32_t *) (fBase + (size_t) y * fRowBytes + 4 * (size_t) x) & 0xffffff;
+			if (under) {
+				fbcheckLineOut(pixels + at);
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t j = 0; j < 16; j++) {
+		for (uint32_t i = 0; i < 16; i++) {
+			uint64_t at = (uint64_t) sys_[j] * row + (uint64_t) sxs[i] * 4;
+			uint32_t k = 16 * j + i;
+
+			m[k] = sxs[i] < 0 || sys_[j] < 0 || at + 4 > room ? 0 : *(const volatile uint32_t *) (pixels + at);
+			lit_c += (c[k] & 0xffffff) != 0;
+			lit_m += (m[k] & 0xffffff) != 0;
+			lit_f += f[k] != 0;
+			stale += c[k] != m[k];
+			wrong += unscaled && !gFbInval && (c[k] & 0xffffff) != f[k];
+			wrong += unscaled && gFbInval && (m[k] & 0xffffff) != f[k];
+		}
+	}
+	gFbc.checked++;
+	gFbc.unscaledNo += !unscaled;
+	gFbc.staleFrames += stale != 0;
+	gFbc.stalePoints += stale;
+	gFbc.staleMost = stale > gFbc.staleMost ? stale : gFbc.staleMost;
+	gFbc.wrongFrames += wrong != 0;
+	gFbc.wrongPoints += wrong;
+	gFbc.litMin = lit_m < gFbc.litMin ? lit_m : gFbc.litMin;
+	gFbc.litMax = lit_m > gFbc.litMax ? lit_m : gFbc.litMax;
+	gFbc.litLast = lit_m;
+	gFbc.fbLitLast = lit_f;
+	gFbc.darkFrames += lit_m < 8;
+	if (gFbc.prevLit < 0 || (int32_t) lit_m - gFbc.prevLit >= 8 || gFbc.prevLit - (int32_t) lit_m >= 8 ||
+	    (stale >= 8 && gFbc.said < 40)) {
+		uint64_t ms;
+
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ms);
+		if (gFbc.said++ < 160) {
+			IOLog("fbcheck: at %llu ms surface %u %ux%u (rows %u%s): lit c %u m %u panel %u, stale %u, wrong %u; centre c %08x m "
+			    "%08x panel %06x; src %d,%d %dx%d -> panel %d,%d..%d,%d\n", ms / NSEC_PER_MSEC, s->sid, s->info.width,
+			    s->info.height, row, unscaled ? "" : ", scaled", lit_c, lit_m, lit_f, stale, wrong, c[8 * 16 + 8], m[8 * 16 + 8],
+			    f[8 * 16 + 8], sx, sy, sw, sh, px0, py0, px1, py1);
+		}
+		gFbc.prevLit = (int32_t) lit_m;
+	}
+}
+
+/* (every 5 s of frames, fLock held) */
+void
+IOMobileFramebuffer::fbcheckReport(void)
+{
+	char ids[160];
+	size_t used = 0;
+	uint64_t ms;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ms);
+	ids[0] = 0;
+	for (unsigned k = 0; k < FBCHECK_IDS && gFbc.ids[k] != 0 && used < sizeof(ids); k++) {
+		used += (size_t) snprintf(ids + used, sizeof(ids) - used, " %u x%u", gFbc.ids[k], gFbc.idCount[k]);
+	}
+	IOLog("fbcheck: 5 s to %llu ms: swaps: %u SwapEnd, %u handed over, %u lost, %u shown (%u no bottom surface, %u surface "
+	    "not found, %u GPU not done in %u ms); bottom surfaces%s%s\n", ms / NSEC_PER_MSEC, gFbc.swapEnds, gFbc.presented,
+	    gFbc.lost, gFbc.shown, gFbc.noBottom, gFbc.missing, gFbc.notDrawn, SWAP_GPU_MS, ids, gFbc.other ? " and others" : "");
+	IOLog("fbcheck: 5 s: %u frames checked (%u scaled): lit points (of 256, the GPU's memory) %u..%u, last %u (panel %u), %u "
+	    "frames under 8; stale cache: %u frames, %u points, most %u in one; copy wrong: %u frames, %u points; fb_inval: %u "
+	    "frames, %llu us each\n", gFbc.checked, gFbc.unscaledNo, gFbc.litMin == ~0u ? 0 : gFbc.litMin, gFbc.litMax,
+	    gFbc.litLast, gFbc.fbLitLast, gFbc.darkFrames, gFbc.staleFrames, gFbc.stalePoints, gFbc.staleMost, gFbc.wrongFrames,
+	    gFbc.wrongPoints, gFbc.invalFrames, gFbc.invalFrames ? gFbc.invalNanos / 1000 / gFbc.invalFrames : 0);
+	int32_t prev = gFbc.prevLit;
+	uint32_t said = gFbc.said;
+
+	bzero(&gFbc, sizeof(gFbc));
+	gFbc.litMin = ~0u;
+	gFbc.prevLit = prev;
+	gFbc.said = said;
+}
+
+/*
+ * 31hk2 gpurot: the bottom (only) layer turned onto the panel by the GPU's 2D engine and waited for; false: the caller
+ * copies it as before (not a full-screen unscaled 32-bit surface, the GPU service not up, the blit before still in flight,
+ * or this one not done in gpurot_ms).
+ */
+bool
+IOMobileFramebuffer::gpuRotate(MiniIOSurface * s, const int32_t * src, const int32_t * dst, uint32_t swapId)
+{
+	uint32_t sw = s->info.width, sh = s->info.height, row = s->info.bytesPerRow, fence = 0;
+	uint64_t t0 = mach_absolute_time(), gpuUs = 0, waited;
+	uint64_t room = s->info.allocSize > s->info.offset ? s->info.allocSize - s->info.offset : 0;
+	bool fullSrc = src[2] <= 0 || src[3] <= 0 || (src[0] == 0 && src[1] == 0 && (uint32_t) src[2] == sw && (uint32_t) src[3] == sh);
+	bool fullDst = dst[2] <= 0 || dst[3] <= 0 || (dst[0] == 0 && dst[1] == 0 && (uint32_t) dst[2] == fWidth &&
+	    (uint32_t) dst[3] == fHeight);
+
+	/* (fb_scanwc=2 maps the panel write-back: the CPU's dirty lines could land over the GPU's pixels: not with it) */
+	if ((fRotate != 90 && fRotate != 270) || s->info.bytesPerElement != 4 || s->info.planeCount != 0 || sw != fWidth ||
+	    sh != fHeight || fWidth != fPanelWidth || fHeight != fPanelHeight || !fullSrc || !fullDst || (uint64_t) row * sh > room ||
+	    fScanWc == 2) {
+		fGrRefused++;
+		return false;
+	}
+	if (fGrPending) {
+		if (!hakios_iceland_gpurot_done(fGrPendingFence)) {
+			fGrBusy++;              /* (a late blit may still land on the panel: no second one meanwhile) */
+			return false;
+		}
+		fGrPending = false;
+	}
+	if (!hakios_iceland_gpurot_on()) {
+		fGrNotUp++;
+		return false;
+	}
+	if (!fGrTarget) {
+		uint64_t pa = kvtophys((vm_offset_t) vinfo.v_baseaddr);
+
+		if (hakios_iceland_gpurot_target(pa, fPhysWidth, fPhysHeight, fRowBytes) != 0) {
+			fGrRefused++;
+			return false;
+		}
+		fGrTarget = true;
+		printf("icegpurot: on from swap %u: panel %#llx %ux%u (%u bytes a row), surface %ux%u (%u bytes a row), ROTATE %u, "
+		    "fence wait %u ms, fbrotate %u\n", swapId, pa, fPhysWidth, fPhysHeight, fRowBytes, sw, sh, row, gGpuRotTurn,
+		    gGpuRotMs, fRotate);
+	}
+	/* 31hk3: this blit checked whole (the panel and the cached surface read before it) */
+	const bool chk = gGpuRotChk != 0 && fHkBlitNo++ % gGpuRotChk == 0;
+
+	if (chk) {
+		hk3Before(s);
+	}
+	if (gGpuRotClean) {
+		/* 31hk3f candidate: the source's lines cleaned to memory, so the GPU reads what the processors' caches hold */
+		const uint8_t * px = s->pixels();
+		uint64_t c0 = mach_absolute_time();
+
+		for (uintptr_t line = (uintptr_t) px & ~(uintptr_t) 63; line < (uintptr_t) px + (uint64_t) row * sh; line += 64) {
+			__asm__ volatile ("dc cvac, %0" : : "r" (line) : "memory");
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		fHkCleaned++;
+		fHkCleanAbs += mach_absolute_time() - c0;
+	}
+	if (hakios_iceland_gpurot_blit(s, s->sid, s->pixels(), (uint64_t) row * sh, sw, sh, row, gGpuRotTurn, &fence) != 0) {
+		fGrRefused++;
+		return false;
+	}
+	waited = mach_absolute_time();
+	if (hakios_iceland_gpurot_wait(fence, gGpuRotMs, &gpuUs) != 0) {
+		fGrTimeouts++;
+		fGrFallbacks++;
+		fGrMisses++;
+		fGrPending = true;
+		fGrPendingFence = fence;
+		if (fGrSaid++ < 20) {
+			printf("icegpurot: swap %u: blit fence %u not done in %u ms: the CPU copies this frame (%u in a row)\n", swapId,
+			    fence, gGpuRotMs, fGrMisses);
+		}
+		if (fGrMisses >= 3) {
+			fGrOff = true;
+			printf("icegpurot: %u timeouts in a row: gpurot OFF for the rest of the boot (the CPU copies every frame)\n",
+			    fGrMisses);
+		}
+		return false;
+	}
+	waited = mach_absolute_time() - waited;
+	fGrMisses = 0;
+	fGrBlits++;
+	fGrGpuUs += gpuUs;
+	fGrGpuMax = gpuUs > fGrGpuMax ? gpuUs : fGrGpuMax;
+	fGrWaitAbs += waited;
+	fGrWaitMax = waited > fGrWaitMax ? waited : fGrWaitMax;
+	fGrAllAbs += mach_absolute_time() - t0;
+	noteCopy(mach_absolute_time() - t0);    /* (the "present copy" line: the GPU's frames counted as copies) */
+	if (chk) {
+		hk3After(s, swapId);            /* 31hk3 (after the copy's time is taken: the check is not the blit's cost) */
+	}
+	return true;
+}
+
+/* (every 5 s of frames, fLock held) */
+void
+IOMobileFramebuffer::gpuRotReport(void)
+{
+	uint64_t wavg = 0, wmax, all = 0;
+
+	if (fGrBlits != 0) {
+		absolutetime_to_nanoseconds(fGrWaitAbs / fGrBlits, &wavg);
+		absolutetime_to_nanoseconds(fGrAllAbs / fGrBlits, &all);
+	}
+	absolutetime_to_nanoseconds(fGrWaitMax, &wmax);
+	printf("icegpurot: 5 s: %u blits (ROTATE %u), %u CPU fallbacks (%u timeouts, %u busy), %u not the GPU's (refused %u, GPU "
+	    "not up %u); GPU us avg %llu max %llu; fence wait us avg %llu max %llu; whole blit us avg %llu; gpurot %s\n", fGrBlits,
+	    gGpuRotTurn, fGrFallbacks + fGrBusy, fGrTimeouts, fGrBusy, fGrRefused + fGrNotUp, fGrRefused, fGrNotUp,
+	    fGrBlits ? fGrGpuUs / fGrBlits : 0, fGrGpuMax, wavg / 1000, wmax / 1000, all / 1000, fGrOff ? "OFF" : "on");
+	fGrBlits = fGrFallbacks = fGrTimeouts = fGrBusy = fGrRefused = fGrNotUp = 0;
+	fGrGpuUs = fGrGpuMax = fGrWaitAbs = fGrWaitMax = fGrAllAbs = 0;
+}
+
+/* 31st: INTF1's frame counter (0: not mapped) */
+uint32_t
+IOMobileFramebuffer::stFrameCount(void)
+{
+	return fStMapped ? *(volatile uint32_t *) (fStIntf + ST_INTF(1) + 0xac) : 0;
+}
+
+/*
+ * 31st: the display's status registers, read (never written) at most once a second, only from show() (frames come: the
+ * panel is on and the display scans, its blocks clocked) and never with fb_panelpower (the panel may be off). report: the
+ * 5 s line. A change in a latched error bit is logged at once (40 lines at most).
+ */
+void
+IOMobileFramebuffer::stRegs(bool report)
+{
+	static const uint32_t dsiOff[5] = { 0x008, 0x00c, 0x068, 0x110, 0x120 };   /* STATUS0, FIFO_STATUS, ACK_ERR, INTR_CTRL, CLK_STATUS */
+	uint64_t now = mach_absolute_time(), sec, ms;
+	uint32_t regs[2][4], dsi[2][5];
+
+	if (!fStTried) {
+		fStTried = true;
+		if (gPanelPower) {
+			printf("icest: registers NOT read: fb_panelpower may turn the panel off\n");
+			return;
+		}
+		fStIntf = ml_io_map_unmappable(ST_INTF_PA, ST_INTF_LEN, VM_WIMG_IO);
+		fStDsi = ml_io_map_unmappable(ST_DSI_PA, PAGE_SIZE, VM_WIMG_IO);
+		fStMapped = fStIntf != 0 && fStDsi != 0;
+		uint32_t ddr = 0;
+
+		(void) PE_parse_boot_argn("icecpu_ddr", &ddr, sizeof(ddr));
+		printf("icest: on: INTF1 / INTF2 at %#x / %#x, DSI0 / DSI1 at %#x / %#x %s; points %u a frame; bus: the display's "
+		    "interconnect vote is the boot chain's (this kernel has no ICC driver, nothing changes it), the processors' "
+		    "MC0 / SH0 vote icecpu_ddr=%u (its own \"ddr:\" lines), USB: no XNU driver (the controller as the loader left it; "
+		    "its registers not read: power state unknown)\n", ST_INTF_PA + ST_INTF(1), ST_INTF_PA + ST_INTF(2), ST_DSI_PA,
+		    ST_DSI_PA + ST_DSI1, fStMapped ? "mapped" : "NOT MAPPED (no register is read)", ST_POINTS, ddr);
+	}
+	if (!fStMapped) {
+		return;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	if (!report && fStRegsAt != 0 && now - fStRegsAt < sec) {
+		return;
+	}
+	fStRegsAt = now;
+	for (unsigned n = 0; n < 2; n++) {
+		vm_offset_t intf = fStIntf + ST_INTF(n + 1), d = fStDsi + (n ? ST_DSI1 : 0);
+
+		regs[n][0] = *(volatile uint32_t *) (intf + 0xac);      /* INTF_FRAME_COUNT */
+		regs[n][1] = *(volatile uint32_t *) (intf + 0xb0);      /* INTF_LINE_COUNT */
+		regs[n][2] = *(volatile uint32_t *) (intf + 0x1c0);     /* INTR_EN */
+		regs[n][3] = *(volatile uint32_t *) (intf + 0x1c4);     /* INTR_STATUS */
+		for (unsigned k = 0; k < 5; k++) {
+			dsi[n][k] = *(volatile uint32_t *) (d + dsiOff[k]);
+		}
+	}
+	fStReads++;
+	absolutetime_to_nanoseconds(now, &ms);
+	ms /= NSEC_PER_MSEC;
+	if (fStReads == 1) {
+		fStFirstFrame[0] = regs[0][0];
+		fStFirstFrame[1] = regs[1][0];
+	} else {
+		/* latched error state that changed: underrun (INTF bit 24), DSI ACK_ERR, FIFO_STATUS, INTR_CTRL's ERROR (bit 24) */
+		for (unsigned n = 0; n < 2; n++) {
+			bool intfCh = ((regs[n][3] ^ fStLastRegs[n][3]) & (1u << 24)) != 0;
+			bool dsiCh = dsi[n][1] != fStLastDsi[n][1] || dsi[n][2] != fStLastDsi[n][2] ||
+			    ((dsi[n][3] ^ fStLastDsi[n][3]) & (1u << 24)) != 0;
+
+			if ((intfCh || dsiCh) && fStChanges++ < 40) {
+				printf("icest: at %llu ms CHANGE: intf%u intr %08x -> %08x (underrun %u); dsi%u fifo %08x -> %08x, ack_err %08x -> "
+				    "%08x, intr %08x -> %08x (error %u)\n", ms, n + 1, fStLastRegs[n][3], regs[n][3], (regs[n][3] >> 24) & 1, n,
+				    fStLastDsi[n][1], dsi[n][1], fStLastDsi[n][2], dsi[n][2], fStLastDsi[n][3], dsi[n][3], (dsi[n][3] >> 24) & 1);
+			}
+		}
+	}
+	if (report) {
+		printf("icest: regs at %llu ms: intf1 frame %u (+%u since the first read) line %u intr en %08x st %08x (underrun %u "
+		    "vsync %u); intf2 frame %u (+%u) line %u en %08x st %08x (underrun %u); dsi0 st0 %08x fifo %08x ack %08x intr %08x "
+		    "(error %u) clk %08x; dsi1 st0 %08x fifo %08x ack %08x intr %08x (error %u) clk %08x; %u reads, %u changes\n", ms,
+		    regs[0][0], regs[0][0] - fStFirstFrame[0], regs[0][1], regs[0][2], regs[0][3], (regs[0][3] >> 24) & 1,
+		    (regs[0][3] >> 27) & 1, regs[1][0], regs[1][0] - fStFirstFrame[1], regs[1][1], regs[1][2], regs[1][3],
+		    (regs[1][3] >> 24) & 1, dsi[0][0], dsi[0][1], dsi[0][2], dsi[0][3], (dsi[0][3] >> 24) & 1, dsi[0][4], dsi[1][0],
+		    dsi[1][1], dsi[1][2], dsi[1][3], (dsi[1][3] >> 24) & 1, dsi[1][4], fStReads, fStChanges);
+	}
+	memcpy(fStLastRegs, regs, sizeof(regs));
+	memcpy(fStLastDsi, dsi, sizeof(dsi));
+}
+
+/*
+ * 31st: the panel after a full-screen frame's copy (CPU or GPU) against the surface (from memory) and the frame before:
+ * ok / stale / torn / garbage, and whether INTF1 began a frame during the copy (frameBefore: its counter before). Reads only.
+ */
+void
+IOMobileFramebuffer::stCheck(MiniIOSurface * s, bool gpu, uint32_t frameBefore)
+{
+	const uint8_t * pixels = s->pixels();
+	uint32_t row = s->info.bytesPerRow, m[ST_POINTS], changed = 0, updated = 0, stale = 0, garbage = 0, bad = ~0u, badF = 0;
+	uint64_t room = s->info.allocSize > s->info.offset ? s->info.allocSize - s->info.offset : 0;
+
+	if ((fRotate != 90 && fRotate != 270) || s->info.bytesPerElement != 4 || s->info.planeCount != 0 || s->info.width != fWidth ||
+	    s->info.height != fHeight || fWidth != fPanelWidth || fHeight != fPanelHeight || (uint64_t) row * fHeight > room) {
+		fStSkipped++;
+		fStPrevValid = false;
+		return;
+	}
+	if (fStMapped && stFrameCount() != frameBefore) {
+		fStOverlap++;                   /* (the display began a frame while this one was being put in its memory) */
+	}
+	for (uint32_t k = 0; k < ST_POINTS; k++) {
+		uint32_t x = (2 * (k % 16) + 1) * fWidth / 32, y = (2 * (k / 16) + 1) * fHeight / 32;
+
+		__asm__ volatile ("dc civac, %0" : : "r" ((uintptr_t) (pixels + (size_t) y * row + 4 * (size_t) x) & ~(uintptr_t) 63) :
+		    "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t k = 0; k < ST_POINTS; k++) {
+		uint32_t x = (2 * (k % 16) + 1) * fWidth / 32, y = (2 * (k / 16) + 1) * fHeight / 32, px, py, f;
+		bool ch;
+
+		m[k] = *(const volatile uint32_t *) (pixels + (size_t) y * row + 4 * (size_t) x) & 0xffffff;
+		if (fRotate == 270) {
+			px = y;
+			py = fPhysHeight - 1 - x;
+		} else {
+			px = fPhysWidth - 1 - y;
+			py = x;
+		}
+		f = *(const volatile uint32_t *) (fBase + (size_t) py * fRowBytes + 4 * (size_t) px) & 0xffffff;
+		ch = fStPrevValid && fStPrev[k] != m[k];
+		changed += ch;
+		if (f == m[k]) {
+			updated += ch;
+		} else {
+			if (fStPrevValid && f == fStPrev[k]) {
+				stale++;
+			} else {
+				garbage++;
+			}
+			if (bad == ~0u) {
+				bad = k;                /* (the first point that differs, for the line below) */
+				badF = f;
+			}
+		}
+	}
+	fStChecked++;
+	fStGpu += gpu;
+	if (garbage != 0) {
+		fStGarbage++;
+		fStGarbagePts += garbage;
+	} else if (stale != 0 && updated != 0) {
+		fStTorn++;
+	} else if (stale != 0) {
+		fStStale++;
+	} else {
+		fStOk++;
+	}
+	static uint32_t said;                   /* (presenter thread only) */
+
+	if (bad != ~0u && said++ < 40) {
+		uint64_t ms;
+
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ms);
+		printf("icest: at %llu ms frame by the %s, surface %u: %s: changed %u, new %u, stale %u, garbage %u; point %u panel %06x "
+		    "surface %06x before %06x\n", ms / NSEC_PER_MSEC, gpu ? "GPU" : "CPU", s->sid, garbage ? "GARBAGE" : updated ?
+		    "TORN" : "STALE", changed, updated, stale, garbage, bad, badF, m[bad], fStPrevValid ? fStPrev[bad] : 0);
+	}
+	memcpy(fStPrev, m, sizeof(m));
+	fStPrevValid = true;
+}
+
+/* (every 5 s of frames, fLock held) */
+void
+IOMobileFramebuffer::stReport(void)
+{
+	uint64_t gap;
+
+	absolutetime_to_nanoseconds(fStGapMax, &gap);
+	printf("icest: 5 s: %u frames checked (%u by the GPU): ok %u, stale %u, torn %u, garbage %u (%u points), skipped %u; copy "
+	    "while the display began a frame %u; longest gap between frames %llu ms; gpurot CPU fallbacks %u\n", fStChecked, fStGpu,
+	    fStOk, fStStale, fStTorn, fStGarbage, fStGarbagePts, fStSkipped, fStOverlap, gap / NSEC_PER_MSEC,
+	    fGrFallbacks + fGrBusy);
+	stRegs(true);
+	fStChecked = fStGpu = fStOk = fStStale = fStTorn = fStGarbage = fStGarbagePts = fStSkipped = fStOverlap = 0;
+	fStGapMax = 0;
+}
+
+/* ---- 31hk3 gpurot_chk ---- */
+
+/* point k of the check (see gGpuRotChk) on a w x h upright surface */
+bool
+IOMobileFramebuffer::hk3Point(uint32_t k, uint32_t w, uint32_t h, uint32_t * x, uint32_t * y)
+{
+	if (w < 4 || h < 4) {
+		return false;
+	}
+	if (k < HK3_GX * HK3_GY) {
+		*x = (2 * (k % HK3_GX) + 1) * w / (2 * HK3_GX);
+		*y = (2 * (k / HK3_GX) + 1) * h / (2 * HK3_GY);
+	} else if (k < HK3_GX * HK3_GY + 4 * HK3_GX) {
+		uint32_t e = k - HK3_GX * HK3_GY, r = e / HK3_GX;        /* edge rows 0, 1, h - 2, h - 1 */
+
+		*x = (2 * (e % HK3_GX) + 1) * w / (2 * HK3_GX);
+		*y = r < 2 ? r : h - 4 + r;
+	} else if (k < HK3_POINTS) {
+		uint32_t e = k - HK3_GX * HK3_GY - 4 * HK3_GX, c = e / HK3_GY;  /* edge columns 0, 1, w - 2, w - 1 */
+
+		*x = c < 2 ? c : w - 4 + c;
+		*y = (2 * (e % HK3_GY) + 1) * h / (2 * HK3_GY);
+	} else {
+		return false;
+	}
+	return true;
+}
+
+/* the panel's pixel (24 bits) where upright x, y lands (fbrotate 270 / 90, as stCheck) */
+uint32_t
+IOMobileFramebuffer::hk3Panel(uint32_t x, uint32_t y)
+{
+	uint32_t px, py;
+
+	if (fRotate == 270) {
+		px = y;
+		py = fPhysHeight - 1 - x;
+	} else {
+		px = fPhysWidth - 1 - y;
+		py = x;
+	}
+	return *(const volatile uint32_t *) (fBase + (size_t) py * fRowBytes + 4 * (size_t) px) & 0xffffff;
+}
+
+/* before the blit: the panel there and the surface as the cache has it (no cache maintenance: nothing changed) */
+void
+IOMobileFramebuffer::hk3Before(MiniIOSurface * s)
+{
+	const uint8_t * pixels = s->pixels();
+	uint32_t row = s->info.bytesPerRow, w = s->info.width, h = s->info.height, x, y;
+
+	for (uint32_t k = 0; k < HK3_POINTS; k++) {
+		if (!hk3Point(k, w, h, &x, &y)) {
+			gHkPanelBefore[k] = gHkCached[k] = 0;
+			continue;
+		}
+		gHkPanelBefore[k] = hk3Panel(x, y);
+		gHkCached[k] = *(const volatile uint32_t *) (pixels + (size_t) y * row + 4 * (size_t) x) & 0xffffff;
+	}
+	fHkDrawnBefore = s->drawn;
+}
+
+/* after the blit's fence: every point compared, the differing grid cells joined into rectangles (reads only) */
+void
+IOMobileFramebuffer::hk3After(MiniIOSurface * s, uint32_t swapId)
+{
+	static uint8_t cell[HK3_GY][HK3_GX];
+	static uint16_t stack[HK3_GX * HK3_GY];
+	static const char * const kind[4] = { "ok", "MOVING", "UNWRITTEN", "WRONG" };
+	const uint8_t * pixels = s->pixels();
+	uint32_t row = s->info.bytesPerRow, w = s->info.width, h = s->info.height, x, y, n[4] = { 0, 0, 0, 0 }, edge[4] = { 0, 0, 0, 0 };
+	uint32_t ex[3], exp_[3], exm[3], exs = 0, bad;
+	uint64_t ms;
+
+	for (uint32_t k = 0; k < HK3_POINTS; k++) {
+		if (hk3Point(k, w, h, &x, &y)) {
+			__asm__ volatile ("dc civac, %0" : : "r" ((uintptr_t) (pixels + (size_t) y * row + 4 * (size_t) x) & ~(uintptr_t) 63) :
+			    "memory");
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t k = 0; k < HK3_POINTS; k++) {
+		uint32_t p, m, c = 0;
+
+		if (!hk3Point(k, w, h, &x, &y)) {
+			continue;
+		}
+		p = hk3Panel(x, y);
+		m = *(const volatile uint32_t *) (pixels + (size_t) y * row + 4 * (size_t) x) & 0xffffff;
+		if (p != m) {
+			c = gHkCached[k] != m ? 1 : p == gHkPanelBefore[k] ? 2 : 3;
+			n[c]++;
+			if (exs < 3) {
+				ex[exs] = k;
+				exp_[exs] = p;
+				exm[exs] = m;
+				exs++;
+			}
+		}
+		if (k < HK3_GX * HK3_GY) {
+			cell[k / HK3_GX][k % HK3_GX] = (uint8_t) c;
+		} else if (c != 0) {
+			uint32_t e = k - HK3_GX * HK3_GY;
+
+			edge[e < 4 * HK3_GX ? (e / HK3_GX < 2 ? 0 : 1) : ((e - 4 * HK3_GX) / HK3_GY < 2 ? 2 : 3)]++;
+		}
+	}
+	bad = n[1] + n[2] + n[3];
+	fHkChecks++;
+	fHkMoving += n[1];
+	fHkUnwritten += n[2];
+	fHkWrong += n[3];
+	for (unsigned i = 0; i < 4; i++) {
+		fHkEdge[i] += edge[i];
+	}
+	if (bad == 0) {
+		fHkClean++;
+		return;
+	}
+	fHkBad++;
+	fHkWorst = bad > fHkWorst ? bad : fHkWorst;
+	if (fHkSaid >= 40) {
+		return;
+	}
+	fHkSaid++;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ms);
+	printf("icehk3: at %llu ms swap %u surface %u %ux%u (rows %u, GPU submission %u -> %u): %u of %u points differ: moving %u, "
+	    "unwritten %u, wrong %u; edges top %u bottom %u left %u right %u\n", ms / NSEC_PER_MSEC, swapId, s->sid, w, h, row,
+	    fHkDrawnBefore, s->drawn, bad, HK3_POINTS, n[1], n[2], n[3], edge[0], edge[1], edge[2], edge[3]);
+	/* the differing cells of the grid, 4-connected, as rectangles (at most 6 lines) */
+	unsigned rects = 0;
+
+	for (uint32_t j0 = 0; j0 < HK3_GY; j0++) {
+		for (uint32_t i0 = 0; i0 < HK3_GX; i0++) {
+			uint32_t sp = 0, il = i0, ir = i0, jt = j0, jb = j0, cnt = 0, cls[4] = { 0, 0, 0, 0 };
+
+			if (cell[j0][i0] == 0 || cell[j0][i0] >= 4) {
+				continue;
+			}
+			cls[cell[j0][i0]]++;
+			cell[j0][i0] += 4;      /* (visited: 5..7) */
+			stack[sp++] = (uint16_t) (j0 * HK3_GX + i0);
+			while (sp != 0) {
+				uint32_t at = stack[--sp], i = at % HK3_GX, j = at / HK3_GX;
+				static const int di[4] = { 1, -1, 0, 0 }, dj[4] = { 0, 0, 1, -1 };
+
+				cnt++;
+				il = i < il ? i : il;
+				ir = i > ir ? i : ir;
+				jt = j < jt ? j : jt;
+				jb = j > jb ? j : jb;
+				for (unsigned d = 0; d < 4; d++) {
+					int ni = (int) i + di[d], nj = (int) j + dj[d];
+
+					if (ni < 0 || nj < 0 || ni >= (int) HK3_GX || nj >= (int) HK3_GY) {
+						continue;
+					}
+					if (cell[nj][ni] != 0 && cell[nj][ni] < 4 && sp < HK3_GX * HK3_GY) {
+						cls[cell[nj][ni]]++;
+						cell[nj][ni] += 4;
+						stack[sp++] = (uint16_t) (nj * HK3_GX + ni);
+					}
+				}
+			}
+			if (rects++ < 6) {
+				uint32_t ux0 = il * w / HK3_GX, ux1 = (ir + 1) * w / HK3_GX - 1, uy0 = jt * h / HK3_GY, uy1 = (jb + 1) * h / HK3_GY - 1;
+				uint32_t qx0, qx1, qy0, qy1;
+
+				if (fRotate == 270) {
+					qx0 = uy0;
+					qx1 = uy1;
+					qy0 = fPhysHeight - 1 - ux1;
+					qy1 = fPhysHeight - 1 - ux0;
+				} else {
+					qx0 = fPhysWidth - 1 - uy1;
+					qx1 = fPhysWidth - 1 - uy0;
+					qy0 = ux0;
+					qy1 = ux1;
+				}
+				printf("icehk3:   rect %u: upright x %u..%u y %u..%u = panel x %u..%u y %u..%u: %u of %u cells (moving %u, "
+				    "unwritten %u, wrong %u)\n", rects, ux0, ux1, uy0, uy1, qx0, qx1, qy0, qy1, cnt, (ir - il + 1) * (jb - jt + 1),
+				    cls[1], cls[2], cls[3]);
+			}
+		}
+	}
+	if (rects > 6) {
+		printf("icehk3:   (%u rectangles in all)\n", rects);
+	}
+	for (uint32_t e = 0; e < exs; e++) {
+		uint32_t k = ex[e];
+
+		(void) hk3Point(k, w, h, &x, &y);
+		printf("icehk3:   point %u (%u,%u): panel %06x surface %06x, before the blit panel %06x cached %06x: %s\n", k, x, y,
+		    exp_[e], exm[e], gHkPanelBefore[k], gHkCached[k], kind[gHkCached[k] != exm[e] ? 1 : exp_[e] == gHkPanelBefore[k] ? 2 : 3]);
+	}
+}
