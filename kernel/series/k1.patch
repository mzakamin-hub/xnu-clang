+static uint32_t stderr_log_count;       /* lines printed in the general window */
+static uint32_t stderr_log_dropped;     /* lines the general window refused */
+static uint64_t stderr_log_pid1_second; /* the same, for pid 1's own budget at level 2 */
+static uint32_t stderr_log_pid1_count;
+static uint32_t stderr_log_pid1_dropped;
