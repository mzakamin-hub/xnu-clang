+      checks the compiled object's __ZTV19NativeLegacyDisplay: exactly the fixture's slots, each signed IA with address
+      diversity and the original diversity; every abstract original slot implemented by us; any inherited slot below the
+      family's either the kernel's IOService entry or the original family's; then writes the bindings: a metaclass or vtable
+      as an absolute address, a function through a "bti c; b <name>.original" stub (XnuPrelink re-aims the branch after it
+      moves our code), as iokit/Native/NullEthernet/gen_bindings.py does. The fixture's "checks" (the bound IOSurface
+      accessors' instruction words) are compared with the kernelcache file first.
+
+The fixture is sheng's scripts/legacy-display-26C5035r.json (UniXNU-sheng 6880068; kernelcache_sha256 d1003b51..., the
+collection this kernel is prelinked into). It is read from outside the tree (it holds a few original instruction words) and
+not copied in; its addresses plus collection_slide are the collection's.
+"""
+import hashlib, json, struct, sys
+
+
+def discriminator(name):
+    """clang ptrauth_string_discriminator: SipHash-2-4 with the fixed key, modulo 0xffff, plus one (sheng :52-75)."""
+    mask = (1 << 64) - 1
+    rotl = lambda x, b: ((x << b) | (x >> (64 - b))) & mask  # noqa: E731
+    key = bytes([0xb5, 0xd4, 0xc9, 0xeb, 0x79, 0x10, 0x4a, 0x79, 0x6f, 0xec, 0x8b, 0x1b, 0x42, 0x87, 0x81, 0xd4])
+    k0, k1 = struct.unpack('<2Q', key)
+    v = [0x736f6d6570736575 ^ k0, 0x646f72616e646f6d ^ k1, 0x6c7967656e657261 ^ k0, 0x7465646279746573 ^ k1]
