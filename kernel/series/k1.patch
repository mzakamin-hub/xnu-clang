+	char line[186];
+	int at;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	secs = ns / NSEC_PER_SEC;
+	lck_mtx_lock(&ice_wl_lock);
+	printf("icewl: %llu s written %llu MB (+%llu MB in %u s), %llu MB pageout not attributed, %llu table evictions;;\n",
+	    secs, w->total >> 20, (w->total - w->last_total) >> 20, ice_wl_seconds,
+	    os_atomic_load(&w->unattributed, relaxed) >> 20, w->evicted);
+	w->last_total = w->total;
+	for (int kind = 0; kind < 2; kind++) {
+		int n = kind == 0 ? ICE_WL_PROCS : ICE_WL_PATHS;
+
+		bzero(done, sizeof(done));
+		at = snprintf(line, sizeof(line), "icewl:   %s:", kind == 0 ? "procs" : "paths");
+		for (int k = 0; k < 10; k++) {
+			int best = -1;
+			uint64_t bytes, last;
+
+			for (int i = 0; i < n; i++) {
+				bytes = kind == 0 ? w->procs[i].bytes : w->paths[i].bytes;
+				if (!done[i] && bytes != 0 && (best < 0 || bytes > (kind == 0 ? w->procs[best].bytes : w->paths[best].bytes))) {
+					best = i;
+				}
+			}
+			if (best < 0) {
+				break;
+			}
+			done[best] = true;
+			bytes = kind == 0 ? w->procs[best].bytes : w->paths[best].bytes;
+			last = kind == 0 ? w->procs[best].last : w->paths[best].last;
+			if (at > 110) {
+				printf("%s;;\n", line);
+				at = snprintf(line, sizeof(line), "icewl:   %s:", kind == 0 ? "procs" : "paths");
+			}
+			if (kind == 0) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %s[%d] %lluM(+%llu)", w->procs[best].name,
+				    w->procs[best].pid, bytes >> 20, (bytes - last) >> 20);
+				w->procs[best].last = bytes;
+			} else {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %.48s %lluM(+%llu)", w->paths[best].prefix,
+				    bytes >> 20, (bytes - last) >> 20);
+				w->paths[best].last = bytes;
+			}
+		}
+		printf("%s;;\n", line);
+	}
+	lck_mtx_unlock(&ice_wl_lock);
+	ice_wl_arm();
+}
+
+__startup_func
+static void
+ice_wl_init(void)
+{
+	struct ice_wl_state *w;
+
+	if (ice_wl_seconds == 0) {
+		return;
+	}
+	ice_wl_seconds = MIN(MAX(ice_wl_seconds, 5u), 3600u);
+	w = kalloc_type(struct ice_wl_state, Z_WAITOK | Z_ZERO | Z_NOFAIL);
+	ice_wl_call = thread_call_allocate_with_options(ice_wl_tick, NULL, THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
+	os_atomic_store(&ice_wl, w, release);
+	printf("icewl: write census every %u s (read only);;\n", ice_wl_seconds);
+	ice_wl_arm();
+}
+STARTUP(THREAD_CALL, STARTUP_RANK_LAST, ice_wl_init);
