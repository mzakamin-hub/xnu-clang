+	z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+	return z ^ (z >> 31);
+}
+
+static uint32_t
+pac_std_fp_fold(uint64_t h)
+{
+	return (uint32_t)(h ^ (h >> 32));
