+static void
+census(const char *when)
+{
+	note("iceusb: %s: gdscr %08x cfg %08x bcr %08x master %08x sleep %08x utmi %08x cfg_noc %08x aggre %08x "
+	    "rcg %08x/%08x %08x/%08x qusb2 bcr %08x clkref %08x\n", when, rd(GCC(G_GDSCR)), rd(GCC(G_CFG_GDSCR)),
+	    rd(GCC(G_BCR)), rd(GCC(G_MASTER)), rd(GCC(G_SLEEP)), rd(GCC(G_UTMI)), rd(GCC(G_CFG_NOC)), rd(GCC(G_AGGRE)),
+	    rd(GCC(G_MASTER_RCG)), rd(GCC(G_MASTER_RCG + 4)), rd(GCC(G_UTMI_RCG)), rd(GCC(G_UTMI_RCG + 4)), rd(u.qusb),
+	    rd(u.tcsr + T_USB2_CLKREF));
+	u.powered = clocks_on();
+	if (!u.powered) {
+		note("iceusb: %s: the core is off, in reset or unclocked: its registers are not read\n", when);
+		return;
+	}
+	note("iceusb: %s: core %08x gctl %08x dcfg %08x dctl %08x dsts %08x u2phy %08x u3pipe %08x ev %08x%08x/%08x/%08x "
+	    "hw0 %08x hw1 %08x hw3 %08x hw7 %08x qs %08x %08x %08x\n", when, rd(DWC(GSNPSID)), rd(DWC(GCTL)), rd(DWC(DCFG)),
+	    rd(DWC(DCTL)), rd(DWC(DSTS)), rd(DWC(GUSB2PHYCFG)), rd(DWC(GUSB3PIPECTL)), rd(DWC(GEVNTADRHI)),
+	    rd(DWC(GEVNTADRLO)), rd(DWC(GEVNTSIZ)), rd(DWC(GEVNTCOUNT)), rd(DWC(GHWPARAMS0)), rd(DWC(GHWPARAMS1)),
+	    rd(DWC(GHWPARAMS3)), rd(DWC(GHWPARAMS7)), rd(QS(QS_GENERAL)), rd(QS(QS_HS_PHY)), rd(QS(QS_SS_PHY)));
+}
+
+/* stream 0x40's route, read only: global page 0 and the bank's own page; never GR1 (CBAR/CBA2R) */
+static void
+smmu_census(void)
+{
+	vm_offset_t g = map4k(SMMU_PA), cb;
+	uint32_t id0, id1, n, smr, s2cr = 0, slot = ~0u, pages, shift;
+
+	if (g == 0) {
+		return;
+	}
+	id0 = rd(g + 0x20);
+	id1 = rd(g + 0x24);
+	n = id0 & 0xff;
+	for (uint32_t i = 0; i < n && i < 128; i++) {
+		smr = rd(g + 0x800 + 4 * i);
+		if ((smr & 0x80000000u) && ((smr ^ USB_STREAM) & 0x7fffu & ~((smr >> 16) & 0x7fffu)) == 0) {
+			slot = i;
+			s2cr = rd(g + 0xc00 + 4 * i);
+			break;
+		}
+	}
+	note("iceusb: smmu: id0 %08x id1 %08x cr0 %08x; stream 0x40: slot %d smr %08x s2cr %08x\n", id0, id1, rd(g),
+	    (int)slot, slot != ~0u ? rd(g + 0x800 + 4 * slot) : 0, s2cr);
+	if (slot == ~0u || ((s2cr >> 16) & 3) != 0) {
+		return;
+	}
+	shift = (id1 >> 31) ? 16 : 12;
+	pages = 2u << ((id1 >> 28) & 7);
+	cb = map4k(SMMU_PA + ((uint64_t)(pages + (s2cr & 0xff)) << shift));
+	if (cb != 0) {
+		note("iceusb: smmu: bank %u sctlr %08x tcr %08x ttbr0 %08x%08x\n", s2cr & 0xff, rd(cb), rd(cb + 0x30),
+		    rd(cb + 0x24), rd(cb + 0x20));
+	}
+}
+
+/* ---- endpoint commands and transfers ---------------------------------------------------------------------------- */
+static bool
+cmd(uint32_t phys, uint32_t command, uint32_t p0, uint32_t p1, uint32_t p2, uint32_t *result)
+{
+	vm_offset_t c = DWC(DEPCMD(phys));
+	uint32_t v = 0;
+
+	wr(c - 12, p2);
+	wr(c - 8, p1);
+	wr(c - 4, p0);
+	dsb();
+	wr(c, command | CMDACT);
+	if ((command & 0xf) == C_END) {
+		/* END TRANSFER without CmdIOC: no CmdAct poll (DWC_usb31 need not clear it), 2 ms instead (gadget.c:385-392, 446-448) */
+		wait_us(2000);
+		return true;
+	}
+	for (uint32_t i = 0; i < 1000; i++) {
+		v = rd(c);
+		if (!(v & CMDACT)) {
+			if (result != NULL) {
+				*result = v;
+			}
+			if ((v >> 12) & 0xf) {
+				u.cmd_errors++;
+				note("iceusb: ep %u command %#x: status %u\n", phys, command & 0xf, (v >> 12) & 0xf);
+				return false;
+			}
+			return true;
+		}
+		wait_us(10);
+	}
+	u.cmd_errors++;
+	note("iceusb: ep %u command %#x: timeout (%08x)\n", phys, command & 0xf, v);
+	return false;
+}
+
+static bool
+ep_config(uint32_t phys, uint32_t type, uint32_t mps, bool modify, uint32_t interval_m1)
+{
+	uint32_t p0 = (type << 1) | (mps << 3) | (modify ? 2u << 30 : 0), p1 = (1u << 8) | (phys << 25);
+
+	if ((phys & 1) && type != E_CONTROL) {
+		p0 |= (phys >> 1) << 17;                /* IN endpoint n sends from TX FIFO n */
+	}
+	if (type == E_CONTROL) {
+		p1 |= 1u << 10;                         /* XferNotReady: the control stages */
+	}
+	if (type == E_INTR) {
+		p1 |= interval_m1 << 16;
+	}
+	return cmd(phys, C_EPCFG, p0, p1, 0, NULL);
+}
+
+static bool
+xfer_start(uint32_t phys, uint32_t off, uint32_t len, uint32_t ctl, bool zlp)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(void *)(u.dma + TRB_OFF(phys));
+	uint64_t buf = u.dma_pa + off, zero = u.dma_pa + ZERO_OFF, trb = u.dma_pa + TRB_OFF(phys);
+	uint32_t v = 0;
+
+	t[0] = (uint32_t)buf;
+	t[1] = (uint32_t)(buf >> 32);
+	t[2] = len;
+	if (zlp) {
+		t[4] = (uint32_t)zero;
+		t[5] = (uint32_t)(zero >> 32);
+		t[6] = 0;
+		t[7] = TRB_HWO | TRB_LST | TRB_IOC | TRB_ISP_IMI | (ctl << 4);
+		t[3] = TRB_HWO | TRB_CHN | (ctl << 4);
+	} else {
+		t[3] = TRB_HWO | TRB_LST | TRB_IOC | TRB_ISP_IMI | (ctl << 4);
+	}
+	if (len != 0) {
+		dma_sync(off, len);
+	}
+	dma_sync(TRB_OFF(phys), 32);
+	u.ep[phys].busy = 1;                    /* even a refused START may have read the TRB: ours again only by END */
+	u.ep[phys].posted = len;
+	if (!cmd(phys, C_START, (uint32_t)(trb >> 32), (uint32_t)trb, 0, &v)) {
+		cmd(phys, C_END | FORCERM, 0, 0, 0, NULL);
+		u.ep[phys].busy = 0;
+		return false;
+	}
+	u.ep[phys].res = (uint8_t)((v >> 16) & 0x7f);
+	return true;
+}
+
+static void
+xfer_end(uint32_t phys)
+{
+	if (!u.ep[phys].busy) {
+		return;
+	}
+	/* ForceRM, no completion event: the TRB is ours again after cmd()'s wait (PianoDwc3 endXfer; gadget.c:1796-1829) */
+	cmd(phys, C_END | FORCERM | ((uint32_t)u.ep[phys].res << 16), 0, 0, 0, NULL);
+	u.ep[phys].busy = 0;
+}
+
+static void
+arm_setup(void)
+{
+	u.phase = PH_SETUP;
+	u.ep0_since = now_us();
+	if (!xfer_start(0, SETUP_OFF, 8, T_SETUP, false)) {
+		note("iceusb: SETUP not armed\n");
+	}
+}
+
+static void
+stall_restart(void)
+{
+	u.stalls++;
+	xfer_end(0);
+	xfer_end(1);
+	cmd(0, C_SETSTALL, 0, 0, 0, NULL);      /* cleared by the core with the next SETUP */
+	u.pend_addr = u.pend_cfg = 0;
+	arm_setup();
+}
+
+/*
+ * ---- descriptors (USB 2.0 ch. 9, the IAD ECN, CDC 1.2 / PSTN 1.2): one ACM function behind an interface association,
+ * as PianoDwc3's (a composite device: Windows' usbccgp + usbser, Linux cdc_acm and macOS bind it with no driver) ----
+ */
+static uint8_t d_device[18] = { 18, 1, 0x00, 0x02, 0xef, 0x02, 0x01, 64, 0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1 };
+static uint8_t d_config[75] = {
+	9, 2, 75, 0, 2, 1, 0, 0xc0, 50,                         /* type patched (2 or 7), self powered */
+	8, 0x0b, 0, 2, 0x02, 0x02, 0x01, 0,                     /* interface association: interfaces 0-1, CDC ACM */
+	9, 4, 0, 0, 1, 0x02, 0x02, 0x01, 0,                     /* communications interface, ACM, AT commands */
+	5, 0x24, 0x00, 0x10, 0x01,                              /* header, CDC 1.10 */
+	5, 0x24, 0x01, 0x00, 1,                                 /* call management: data interface 1 */
+	4, 0x24, 0x02, 0x02,                                    /* ACM: line coding and serial state */
+	5, 0x24, 0x06, 0, 1,                                    /* union */
+	7, 5, 0x81, 0x03, 16, 0, 9,                             /* notification IN: interval patched */
+	9, 4, 1, 0, 2, 0x0a, 0, 0, 0,                           /* data interface */
+	7, 5, 0x02, 0x02, 0, 2, 0,                              /* bulk OUT: packet size patched */
+	7, 5, 0x82, 0x02, 0, 2, 0,                              /* bulk IN */
+};
+static char s_maker[] = "iceland";
+static char s_product[] = "iceland XNU console";
+static char s_serial[] = "ICEUSB0";
+
+static uint32_t
+config_descriptor(uint8_t *out, uint8_t type, bool hs)
+{
+	memcpy(out, d_config, sizeof(d_config));
+	out[1] = type;
+	out[51] = hs ? 9 : 32;                          /* the notification endpoint's interval: 32 ms either way */
+	out[65] = out[72] = hs ? 0x00 : 0x40;           /* the bulk pair's packet size: 512 or 64 */
+	out[66] = out[73] = hs ? 0x02 : 0x00;
+	return sizeof(d_config);
+}
+
+static uint32_t
+string_descriptor(uint8_t *out, uint32_t index)
+{
+	const char *s = index == 1 ? s_maker : index == 2 ? s_product : s_serial;
+	uint32_t n = 0;
+
+	if (index == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;
+		return 4;
+	}
+	if (index > 3) {
+		return 0;
+	}
+	for (; s[n] != 0; n++) {
+		out[2 + 2 * n] = (uint8_t)s[n];
+		out[3 + 2 * n] = 0;
+	}
+	out[0] = (uint8_t)(2 + 2 * n);
+	out[1] = 3;
+	return 2 + 2 * n;
+}
+
+/* ---- the bulk side ------------------------------------------------------------------------------------------------ */
+static void
+unconfigure(void)
+{
+	for (uint32_t p = 2; p < NPHYS; p++) {
+		xfer_end(p);
+	}
+	wr(DWC(DALEPENA), 3);
+	u.configured = 0;
+}
+
+static bool
+configure(void)
+{
+	uint32_t mps = u.high_speed ? 512 : 64;
+
+	if (!ep_config(P_NOTIFY, E_INTR, 16, false, u.high_speed ? 8 : 0) || !ep_config(P_OUT, E_BULK, mps, false, 0) ||
+	    !ep_config(P_IN, E_BULK, mps, false, 0)) {
+		return false;
+	}
+	wr(DWC(DALEPENA), 3u | 1u << P_NOTIFY | 1u << P_OUT | 1u << P_IN);
+	return true;
+}
+
+static void
+pump(void)
+{
+	uint8_t *in = u.dma + IN_OFF;
+	uint32_t n = 0, mps = u.high_speed ? 512 : 64;
+	uint64_t drops;
+
+	if (!u.configured) {
+		return;
+	}
+	if (!u.ep[P_OUT].busy) {
+		xfer_start(P_OUT, OUT_OFF, OUT_BYTES, T_NORMAL, false);
+	}
+	if (u.ep[P_IN].busy) {
+		return;
+	}
+	drops = ring_drops;
+	if (drops != drops_told) {
+		n = (uint32_t)snprintf((char *)in, 64, "\n[iceusb: %llu bytes dropped]\n", drops - drops_told);
+		drops_told = drops;
+	}
+	n += ring_take(in + n, IN_BYTES - n);
+	if (n != 0) {
+		/* a transfer that ends on a packet boundary gets a zero-length packet: the host's read completes now */
+		xfer_start(P_IN, IN_OFF, n, T_NORMAL, n % mps == 0);
+	}
+}
+
+static void
+monitor_byte(uint8_t c)
+{
+	if (c != '\r' && c != '\n') {
+		if (u.mon_len < sizeof(u.mon) - 1) {
+			u.mon[u.mon_len++] = (char)c;
+		}
+		return;
+	}
+	if (u.mon_len == 0) {
+		return;
+	}
+	u.mon[u.mon_len] = 0;
+	if (u.mon[0] == '!') {
+		/* a keyboard command: to the HID front's ring (it takes a mutex: not from the quiesce), then wiped here */
+		u.hid_lines++;
+#if defined(XNU_TARGET_OS_OSX)
+		if (!u.quiet) {
+			iceland_hid_line(u.mon + 1);
+		}
+#endif
+		memset(u.mon, 0, sizeof(u.mon));
+	} else {
+		u.mon_cmd = strcmp(u.mon, "usb") == 0 ? 1 : strcmp(u.mon, "help") == 0 ? 2 : 3;
+	}
+	u.mon_len = 0;
+}
+
+/* the host's port closed, or the bus went away: nothing the keyboard commands hold stays pressed */
+static void
+hid_closed(void)
+{
+#if defined(XNU_TARGET_OS_OSX)
+	if (!u.quiet) {
+		iceland_hid_port_closed();
+	}
+#endif
+}
+
+static void
+bulk_complete(uint32_t phys)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(void *)(u.dma + TRB_OFF(phys));
+	uint32_t got;
+
+	dma_sync(TRB_OFF(phys), 32);
+	if (!u.ep[phys].busy || (t[3] & TRB_HWO)) {
+		u.stale++;
+		return;
+	}
+	u.ep[phys].busy = 0;
+	if (phys == P_IN) {
+		u.in_bytes += u.ep[phys].posted;
+	} else if (phys == P_OUT) {
+		got = (t[2] & 0xffffff) <= u.ep[phys].posted ? u.ep[phys].posted - (t[2] & 0xffffff) : 0;
+		dma_sync(OUT_OFF, OUT_BYTES);
+		u.out_bytes += got;
+		for (uint32_t i = 0; i < got; i++) {
+			monitor_byte(u.dma[OUT_OFF + i]);
+		}
+	}
+}
+
+/* ---- EP0 (the SETUP / DATA / STATUS stages) ---------------------------------------------------------------------- */
+enum { R_STALL, R_NONE, R_IN, R_OUT };
+
+static uint32_t
+dispatch(const uint8_t *s, uint32_t *len)
+{
+	uint8_t type = s[0], req = s[1], *d = u.dma + EP0_OFF;
+	uint16_t value = (uint16_t)(s[2] | s[3] << 8), index = (uint16_t)(s[4] | s[5] << 8), length = (uint16_t)(s[6] | s[7] << 8);
+	bool in = (type & 0x80) != 0;
+
+	*len = 0;
+	if ((type & 0x60) == 0x00) {
+		switch (req) {
+		case 0x00:                              /* GET_STATUS */
+			if (!in || length < 2) {
+				return R_STALL;
+			}
+			d[0] = (type & 0x1f) == 0 ? 1 : 0;      /* self powered */
+			d[1] = 0;
+			*len = 2;
+			return R_IN;
+		case 0x01:                              /* CLEAR_FEATURE */
+		case 0x03:                              /* SET_FEATURE */
+			if (in || length) {
+				return R_STALL;
+			}
+			if ((type & 0x1f) == 2 && value == 0) {         /* ENDPOINT_HALT on one of ours */
+				uint32_t phys = ((index & 0xf) << 1) | ((index >> 7) & 1);
+
+				if (phys < 2 || phys >= NPHYS || phys == 2 || !u.configured) {
+					return phys < 2 ? R_NONE : R_STALL;
+				}
+				if (req == 0x01) {
+					xfer_end(phys);
+				}
+				cmd(phys, req == 0x01 ? C_CLRSTALL : C_SETSTALL, 0, 0, 0, NULL);
+				return R_NONE;
+			}
+			return (type & 0x1f) == 0 && value == 1 ? R_NONE : R_STALL;
+		case 0x05:                              /* SET_ADDRESS: DCFG now, before the status stage (Linux ep0.c:607-626) */
+			if (in || length || value > 127) {
+				return R_STALL;
+			}
+			wr(DWC(DCFG), (rd(DWC(DCFG)) & ~(0x7fu << 3)) | ((uint32_t)value << 3));
+			u.pend_addr = 1;
+			u.new_addr = (uint8_t)value;
+			return R_NONE;
+		case 0x06:                              /* GET_DESCRIPTOR */
+			if (!in) {
+				return R_STALL;
+			}
+			switch (value >> 8) {
+			case 1:
+				memcpy(d, d_device, sizeof(d_device));
+				*len = sizeof(d_device);
+				break;
+			case 2:
+				*len = config_descriptor(d, 2, u.high_speed);
+				break;
+			case 3:
+				*len = string_descriptor(d, value & 0xff);
+				break;
+			case 6:                         /* device qualifier */
+				memcpy(d, d_device, 10);
+				d[0] = 10; d[1] = 6; d[8] = 1; d[9] = 0;
+				*len = 10;
+				break;
+			case 7:                         /* other speed configuration */
+				*len = config_descriptor(d, 7, !u.high_speed);
+				break;
+			default:
+				break;
+			}
+			return *len != 0 ? R_IN : R_STALL;
+		case 0x08:                              /* GET_CONFIGURATION */
+			if (!in || length < 1) {
+				return R_STALL;
+			}
+			d[0] = u.configured;
+			*len = 1;
+			return R_IN;
+		case 0x09:                              /* SET_CONFIGURATION: endpoints now, transfers after the status stage */
+			if (in || length || value > 1 || u.address == 0) {
+				return R_STALL;
+			}
+			unconfigure();
+			if (value == 1 && !configure()) {
+				return R_STALL;
+			}
+			u.pend_cfg = 1;
+			u.new_cfg = (uint8_t)value;
+			return R_NONE;
+		case 0x0a:                              /* GET_INTERFACE */
+			if (!in || length < 1 || index > 1 || !u.configured) {
+				return R_STALL;
+			}
+			d[0] = 0;
+			*len = 1;
+			return R_IN;
+		case 0x0b:                              /* SET_INTERFACE: alternate 0 only */
+			return in || length || index > 1 || value != 0 || !u.configured ? R_STALL : R_NONE;
+		default:
+			return R_STALL;
+		}
+	}
+	if ((type & 0x7f) == 0x21 && index == 0) {      /* CDC-ACM (PSTN) requests to the communications interface */
+		switch (req) {
+		case 0x20:                              /* SET_LINE_CODING */
+			if (in || length < 7 || length > 64) {
+				return R_STALL;
+			}
+			u.out_line_coding = 1;
+			*len = length;
+			return R_OUT;
+		case 0x21:                              /* GET_LINE_CODING */
+			if (!in || length == 0) {
+				return R_STALL;
+			}
+			memcpy(d, u.line_coding, 7);
+			*len = 7;
+			return R_IN;
+		case 0x22:                              /* SET_CONTROL_LINE_STATE (bit 0 DTR) */
+		case 0x23:                              /* SEND_BREAK */
+			if (in || length) {
+				return R_STALL;
+			}
+			if (req == 0x22) {
+				if ((u.line_state & 1) && !(value & 1)) {
+					hid_closed();
+				}
+				u.line_state = value;
+			}
+			return R_NONE;
+		default:
+			return R_STALL;
+		}
+	}
+	return R_STALL;
+}
+
+static void
+setup_stage(void)
+{
+	uint8_t s[8];
+	uint32_t n, kind, length;
+
+	dma_sync(SETUP_OFF, 8);
+	for (uint32_t i = 0; i < 8; i++) {
+		s[i] = u.dma[SETUP_OFF + i];
+	}
+	u.setups++;
+	length = (uint32_t)(s[6] | s[7] << 8);
+	u.pend_addr = u.pend_cfg = u.out_line_coding = 0;
+	kind = dispatch(s, &n);
+	if (u.setups_noted < 24) {
+		u.setups_noted++;
+		note("iceusb: setup %02x %02x %04x %04x %u -> %s %u\n", s[0], s[1], s[2] | s[3] << 8, s[4] | s[5] << 8, length,
+		    kind == R_STALL ? "stall" : kind == R_NONE ? "status" : kind == R_IN ? "in" : "out", n);
+	}
+	switch (kind) {
+	case R_STALL:
+		stall_restart();
+		return;
+	case R_NONE:
+		u.three_stage = 0;
+		u.status_phys = 1;
+		u.phase = PH_WAIT_STATUS;
+		return;
+	case R_IN:
+		if (n > length) {
+			n = length;
+		}
+		u.three_stage = 1;
+		u.data_phys = 1;
+		u.status_phys = 0;
+		u.phase = PH_DATA;
+		/* an IN reply shorter than wLength that ends on a packet boundary needs a zero-length packet */
+		if (!xfer_start(1, EP0_OFF, n, T_DATA, n < length && n != 0 && n % u.mps == 0)) {
+			stall_restart();
+		}
+		return;
+	default:
+		u.three_stage = 1;
+		u.data_phys = 0;
+		u.status_phys = 1;
+		u.phase = PH_DATA;
+		if (!xfer_start(0, EP0_OFF, (n + u.mps - 1) / u.mps * u.mps, T_DATA, false)) {
+			stall_restart();
+		}
+		return;
+	}
+}
+
+static void
+status_done(void)
+{
+	if (u.pend_addr) {
+		u.address = u.new_addr;
+	}
+	if (u.pend_cfg) {
+		u.configured = u.new_cfg;
+		if (u.configured) {
+			note("iceusb: configured (%s speed): the console streams\n", u.high_speed ? "high" : "full");
+		}
+	}
+	u.pend_addr = u.pend_cfg = 0;
+}
+
+static void
+ep0_event(uint32_t phys, uint32_t type, uint32_t status)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(void *)(u.dma + TRB_OFF(phys));
+
+	if (type == 1) {                                /* XferComplete */
+		dma_sync(TRB_OFF(phys), 32);
+		if (!u.ep[phys].busy || (t[3] & TRB_HWO)) {
+			u.stale++;
+			return;
+		}
+		u.ep[phys].busy = 0;
+		u.ep0_since = now_us();
+		switch (u.phase) {
+		case PH_SETUP:
+			if (phys == 0) {
+				setup_stage();
+			}
+			return;
+		case PH_DATA:
+			if ((t[2] >> 28) == 2) {        /* SETUP pending: the host gave up on this request */
+				arm_setup();
+				return;
+			}
+			if (phys != u.data_phys) {
+				u.stale++;
+				return;
+			}
+			if (phys == 0 && u.out_line_coding) {
+				dma_sync(EP0_OFF, 64);
+				memcpy(u.line_coding, u.dma + EP0_OFF, 7);
+			}
+			u.phase = PH_WAIT_STATUS;
+			return;
+		case PH_STATUS:
+			if (phys == u.status_phys) {
+				status_done();
+				arm_setup();
+			}
+			return;
+		default:
+			u.stale++;
+			return;
+		}
+	}
+	if (type != 3) {                                /* XferNotReady: status 1 data stage, 2 status stage */
+		return;
+	}
+	if ((status & 3) == 1 && u.phase == PH_DATA && phys != u.data_phys) {
+		stall_restart();
+		return;
+	}
+	if ((status & 3) == 2 && (u.phase == PH_WAIT_STATUS || u.phase == PH_DATA)) {
+		u.ep0_since = now_us();
+		if (phys != u.status_phys) {
+			stall_restart();
+			return;
+		}
+		if (u.phase == PH_DATA) {
+			xfer_end(u.data_phys);          /* a short data stage: the host moved on */
+		}
+		u.phase = PH_STATUS;
+		if (!xfer_start(phys, ZERO_OFF, 0, u.three_stage ? T_STATUS3 : T_STATUS2, false)) {
+			stall_restart();
+		}
+	}
+}
+
+static void
+bus_reset(bool rearm)
+{
+	unconfigure();
+	xfer_end(0);
+	xfer_end(1);
+	wr(DWC(DCFG), rd(DWC(DCFG)) & ~(0x7fu << 3));
+	u.address = 0;
+	u.pend_addr = u.pend_cfg = 0;
+	if (u.line_state & 1) {
+		hid_closed();
+	}
+	u.line_state = 0;
+	u.phase = PH_IDLE;
+	if (u.resets + u.disconnects <= 8) {
+		u.trace_left = u.trace;
+	}
+	if (rearm) {
+		arm_setup();
+	}
+}
+
+static void
+handle(uint32_t e)
+{
+	uint32_t phys, type;
+
+	u.events++;
+	if (u.trace_left != 0) {
+		u.trace_left--;
+		note("iceusb: ev %08x phase %u busy %u/%u dsts %08x\n", e, u.phase, u.ep[0].busy, u.ep[1].busy, rd(DWC(DSTS)));
+	}
+	if (e & 1) {
+		if ((e >> 1) & 0x7f) {
+			return;
+		}
+		switch ((e >> 8) & 0xf) {
+		case 0:                                 /* disconnect */
+			u.disconnects++;
+			bus_reset(false);
+			break;
+		case 1:                                 /* USB reset */
+			u.resets++;
+			bus_reset(true);
+			break;
+		case 2:                                 /* connect done */
+			u.connects++;
+			u.high_speed = (rd(DWC(DSTS)) & 7) == 0;
+			u.mps = 64;
+			ep_config(0, E_CONTROL, 64, true, 0);
+			ep_config(1, E_CONTROL, 64, true, 0);
+			if (!u.ep[0].busy && !u.ep[1].busy) {
+				arm_setup();
+			}
+			break;
+		case 9:                                 /* erratic error */
+		case 11:                                /* event buffer overflow */
+			note("iceusb: device event %u (dsts %08x)\n", (e >> 8) & 0xf, rd(DWC(DSTS)));
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	phys = (e >> 1) & 0x1f;
+	type = (e >> 6) & 0xf;
+	if (phys < 2) {
+		ep0_event(phys, type, (e >> 12) & 0xf);
+	} else if (phys < NPHYS && type == 1) {
+		bulk_complete(phys);
+	}
+}
+
+static uint32_t
+poll_events(void)
+{
+	uint32_t count = rd(DWC(GEVNTCOUNT)) & 0xfffc, done = 0;
+
+	if (count == 0) {
+		return 0;
+	}
+	if (count > EV_BYTES) {
+		count = EV_BYTES;
+	}
+	dsb();
+	dma_sync(EV_OFF, EV_BYTES);
+	for (; done < count; done += 4) {
+		uint32_t e = *(volatile uint32_t *)(void *)(u.dma + EV_OFF + u.ev_pos);
+
+		u.ev_pos = (u.ev_pos + 4) % EV_BYTES;
+		handle(e);
+	}
+	wr(DWC(GEVNTCOUNT), count);
+	return count / 4;
+}
+
+/* the EP0 watchdog and, while no host has reset the bus, a state line every 20 s (at most 6) */
+static void
+tick(void)
+{
+	uint64_t now = now_us();
+
+	if ((u.phase == PH_DATA || u.phase == PH_WAIT_STATUS || u.phase == PH_STATUS) && now - u.ep0_since > 1000000) {
+		note("iceusb: EP0 stuck in phase %u for 1 s: SETUP again\n", u.phase);
+		xfer_end(0);
+		xfer_end(1);
+		arm_setup();
+	} else if (u.phase == PH_SETUP && !u.ep[0].busy && now - u.ep0_since > 100000) {
+		arm_setup();
+	}
+	if (!u.configured && u.snaps < 6 && now - u.last_snap > 20000000) {
+		u.last_snap = now;
+		u.snaps++;
+		note("iceusb: not configured after %llu s: resets %u connects %u setups %u dsts %08x dctl %08x evcount %08x\n",
+		    (now - u.run_at) / 1000000, u.resets, u.connects, u.setups, rd(DWC(DSTS)), rd(DWC(DCTL)),
+		    rd(DWC(GEVNTCOUNT)));
+	}
+}
+
+static void
+status_line(void)
+{
+	note("iceusb: usb: %s, address %u, line %x, events %u resets %u connects %u setups %u stalls %u errors %u stale %u, "
+	    "in %llu B out %llu B, ring %u B, dropped %llu B, dsts %08x, keyboard lines %u\n",
+	    u.configured ? "configured" : "not configured",
+	    u.address, u.line_state, u.events, u.resets, u.connects, u.setups, u.stalls, u.cmd_errors, u.stale, u.in_bytes,
+	    u.out_bytes, ring_used(), ring_drops, rd(DWC(DSTS)), u.hid_lines);
+}
+
+/* ---- bring-up ------------------------------------------------------------------------------------------------------ */
+static bool
+dma_alloc(void)
+{
+	vm_offset_t va = 0;
+	uint64_t ctr = __builtin_arm_rsr64("CTR_EL0");
+
+	u.line = 4u << ((ctr >> 16) & 0xf);
+	/* below 4 GiB when the kernel has pages there (whatever the bank's VA64 is); anywhere else otherwise */
+	if (kmem_alloc_contig(kernel_map, &va, DMA_BYTES, 0, 0xfffff, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS &&
+	    kmem_alloc_contig(kernel_map, &va, DMA_BYTES, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	u.dma = (uint8_t *)va;
+	u.dma_pa = kvtophys(va);
+	if (u.dma_pa == 0 || kvtophys(va + DMA_BYTES - 1) != u.dma_pa + DMA_BYTES - 1) {
+		return false;
+	}
+	bzero(u.dma, DMA_BYTES);
+	dma_sync(0, DMA_BYTES);
+	return true;
+}
+
+/* GDSC on, the block reset, the branch clocks and the reference clock (Linux's order: dwc3-qcom.c:949-963) */
+static bool
+power_up(void)
+{
+	static const uint32_t branches[] = { G_CFG_NOC, G_AGGRE, G_MASTER, G_SLEEP, G_UTMI };
+	uint32_t v = rd(GCC(G_GDSCR));
+
+	if (u.steps & 4) {
+		if ((v & 1) || !(v & (1u << 31))) {
+			wr(GCC(G_GDSCR), v & ~1u);
+			dsb();
+			if (!wait_bits(GCC(G_CFG_GDSCR), 1u << 16, 1u << 16, 5000, 10) &&
+			    !wait_bits(GCC(G_GDSCR), 1u << 31, 1u << 31, 1000, 10)) {
+				note("iceusb: the GDSC does not power up (%08x %08x)\n", rd(GCC(G_GDSCR)), rd(GCC(G_CFG_GDSCR)));
+				return false;
+			}
+		}
+	}
+	if (u.steps & 1) {
+		wr(GCC(G_BCR), rd(GCC(G_BCR)) | 1u);
+		dsb();
+		delay(20);
+		wr(GCC(G_BCR), rd(GCC(G_BCR)) & ~1u);
+		dsb();
+		delay(20);
+	} else if (rd(GCC(G_BCR)) & 1u) {
+		wr(GCC(G_BCR), rd(GCC(G_BCR)) & ~1u);
+		dsb();
+	}
+	if (u.steps & 4) {
+		for (uint32_t i = 0; i < sizeof(branches) / sizeof(branches[0]); i++) {
+			v = rd(GCC(branches[i]));
+			if (!(v & 1u)) {
+				wr(GCC(branches[i]), v | 1u);
+				dsb();
+			}
+			/* a voted branch under hardware gating may read off: Linux does not wait for it either */
+			if (!(rd(GCC(branches[i])) & 2u) &&
+			    !wait_bits(GCC(branches[i]), 1u << 31, 0, 10000, 10)) {
+				note("iceusb: GCC branch %#x stays off (%08x)\n", 0x39000u + branches[i], rd(GCC(branches[i])));
+				return false;
+			}
+		}
+		if (!(rd(u.tcsr + T_USB2_CLKREF) & 1u)) {
+			wr(u.tcsr + T_USB2_CLKREF, rd(u.tcsr + T_USB2_CLKREF) | 1u);
+			dsb();
+			delay(10);
+		}
+	}
+	u.powered = clocks_on();
+	return u.powered;
+}
+
+/* the M31 eUSB2 PHY: its reset, then its tables, each written and read back (Linux m31 :191-225) */
+static void
+phy_init(void)
+{
+	uint32_t bad = 0;
+
+	wr(u.qusb, rd(u.qusb) | 1u);
+	dsb();
+	delay(10);
+	wr(u.qusb, rd(u.qusb) & ~1u);
+	dsb();
+	delay(10);
+	for (uint32_t i = 0; i < sizeof(m31_seq) / sizeof(m31_seq[0]); i++) {
+		vm_offset_t r = M31(m31_seq[i][0]);
+
+		wr(r, (rd(r) & ~m31_seq[i][1]) | m31_seq[i][2]);
+		dsb();
+		if ((rd(r) & m31_seq[i][1]) != m31_seq[i][2]) {
+			bad++;
+		}
+	}
+	note("iceusb: M31 PHY init: %u readback differences; ctrl0 %08x ctrl5 %08x common0 %08x ctrl2 %08x cfg0 %08x\n", bad,
+	    rd(M31(0x3c)), rd(M31(0x50)), rd(M31(0x54)), rd(M31(0x64)), rd(M31(0x94)));
+}
+
+static void
+set_bits(vm_offset_t r, uint32_t clear, uint32_t set)
+{
+	wr(r, (rd(r) & ~clear) | set);
+	dsb();
+}
+
+static bool
+core_init(void)
+{
+	uint32_t id = u.snpsid >> 16, waited = 0, v, nump, ram;
+	bool dwc31 = id != 0x5533;
+
+	/* halt whatever runs (U-Boot left RUN_STOP clear; a reset block reads halted anyway) */
+	if (rd(DWC(DCTL)) & RUN_STOP) {
+		set_bits(DWC(DCTL), RUN_STOP, 0);
+		wait_bits(DWC(DSTS), DEVCTRLHLT, DEVCTRLHLT, 100000, 100);
+	}
+	wr(DWC(DEVTEN), 0);
+	wr(DWC(GEVNTSIZ), 1u << 31);
+	/* the UTMI clock as the PIPE clock: high speed only, no QMP PHY (dwc3-qcom.c:668-685, at the glue's probe :994-995) */
+	set_bits(QS(QS_GENERAL), 0, 1u << 8);
+	delay(100);
+	set_bits(QS(QS_GENERAL), 0, 1u << 0 | 1u << 3);
+	delay(100);
+	set_bits(QS(QS_GENERAL), 1u << 8, 0);
+	/*
+	 * Linux's core init order (core.c:1358-1387): the PHY interface set up (both suspend controls off: DT quirks
+	 * dis_u2_susphy, dis_enblslpm; the USB3 side too, as PianoDwc3), the PHY initialised, then the soft reset -- with the
+	 * device role set first (PianoDwc3: no device soft reset outside the device role).
+	 */
+	set_bits(DWC(GCTL), 3u << 12, 2u << 12);
+	set_bits(DWC(GUSB2PHYCFG), 1u << 6 | 1u << 8, 0);
+	set_bits(DWC(GUSB3PIPECTL), 1u << 17, 0);
+	if (u.steps & 2) {
+		phy_init();
+	}
+	delay(1000);
+	wr(DWC(DCTL), (rd(DWC(DCTL)) & ~(RUN_STOP | 0xfu << 5)) | CSFTRST);
+	while (rd(DWC(DCTL)) & CSFTRST) {
+		if (waited >= (dwc31 ? 200000u : 100000u)) {
+			note("iceusb: soft reset did not finish (dctl %08x)\n", rd(DWC(DCTL)));
+			return false;
+		}
+		delay(dwc31 ? 20000 : 10);
+		waited += dwc31 ? 20000 : 10;
+	}
+	if (dwc31) {
+		delay(50000);
+	}
+	set_bits(DWC(GUSB2PHYCFG), 1u << 6 | 1u << 8, 0);
+	set_bits(DWC(GUSB3PIPECTL), 1u << 17, 0);
+	/* global control as Linux sets it for a device (core.c:1026-1068): no scale-down, clock gating on with PWROPT_CLK */
+	v = rd(DWC(GCTL)) & ~(3u << 12 | 3u << 4 | 1u << 1);
+	if (((rd(DWC(GHWPARAMS1)) >> 24) & 3) == 1) {
+		v &= ~1u;
+	}
+	wr(DWC(GCTL), v | 2u << 12);
+	/* event buffer 0, polled (its interrupt masked) */
+	wr(DWC(GEVNTADRLO), (uint32_t)(u.dma_pa + EV_OFF));
+	wr(DWC(GEVNTADRHI), (uint32_t)((u.dma_pa + EV_OFF) >> 32));
+	wr(DWC(GEVNTSIZ), 1u << 31 | EV_BYTES);
+	v = rd(DWC(GEVNTCOUNT)) & 0xfffc;
+	if (v != 0) {
+		wr(DWC(GEVNTCOUNT), v);
+	}
+	u.ev_pos = 0;
+	/* high speed, address 0, NUMP from the RX FIFO (gadget.c:2956-2972), no LPM (usb2-gadget-lpm-disable) */
+	ram = (rd(DWC(GHWPARAMS7)) >> 16) * ((rd(DWC(GHWPARAMS0)) >> 8) & 0xff) / 8;
+	nump = ram > 40 ? (ram - 40) / 1024 : 1;
+	nump = nump < 1 ? 1 : nump > 16 ? 16 : nump;
+	set_bits(DWC(DCFG), 7u | 0x7fu << 3 | 0x1fu << 17 | 1u << 22, nump << 17);
+	u.mps = 64;
+	u.high_speed = 1;
+	if (!cmd(0, C_STARTCFG, 0, 0, 0, NULL) || !ep_config(0, E_CONTROL, 64, false, 0) ||
+	    !ep_config(1, E_CONTROL, 64, false, 0)) {
+		return false;
+	}
+	for (uint32_t p = 0; p < NPHYS; p++) {
+		if (!cmd(p, C_XFERRES, 1, 0, 0, NULL)) {
+			return false;
+		}
+	}
+	wr(DWC(DALEPENA), 3);
+	wr(DWC(DEVTEN), 1u << 0 | 1u << 1 | 1u << 2 | 1u << 9);  /* disconnect, reset, connect done, erratic error */
+	note("iceusb: core %08x reset in %u us; gctl %08x dcfg %08x u2phy %08x u3pipe %08x nump %u\n", u.snpsid, waited,
+	    rd(DWC(GCTL)), rd(DWC(DCFG)), rd(DWC(GUSB2PHYCFG)), rd(DWC(GUSB3PIPECTL)), nump);
+	/* the VBUS / session override, without which the core sees no attach (dwc3-qcom.c:252-258) */
+	set_bits(QS(QS_SS_PHY), 0, 1u << 24);
+	set_bits(QS(QS_HS_PHY), 0, 1u << 20 | 1u << 28);
+	u.trace_left = u.trace;
+	arm_setup();
+	set_bits(DWC(GUSB3PIPECTL), 0, 1u << 17);      /* the USB3 side may suspend now (gadget.c:3071; dis_u2 keeps USB2's off) */
+	set_bits(DWC(DCTL), 0xfu << 1 | 0xfu << 5 | 0xfu << 9, RUN_STOP);
+	if (!wait_bits(DWC(DSTS), DEVCTRLHLT, 0, 100000, 100)) {
+		note("iceusb: the core did not leave halt (dsts %08x)\n", rd(DWC(DSTS)));
+	}
+	u.run_at = u.last_snap = now_us();
+	return true;
+}
+
+static bool
+bring_up(void)
+{
+	uint64_t midr = __builtin_arm_rsr64("MIDR_EL1");
+
+	if (((midr >> 24) & 0xff) != 0x51) {
+		note("iceusb: not the tablet (MIDR %llx is not a Qualcomm core): no hardware is touched\n", midr);
+		return false;
+	}
+	u.gcc = map4k(GCC_USB_PA);
+	u.qusb = map4k(GCC_QUSB2_PA);
+	u.tcsr = map4k(TCSR_PA);
+	u.m31 = map4k(M31_PA);
+	u.dwc = map4k(DWC_PA);
+	u.qs = map4k(QS_PA);
+	if (!u.gcc || !u.qusb || !u.tcsr || !u.m31 || !u.dwc || !u.qs) {
+		note("iceusb: cannot map the registers\n");
+		return false;
+	}
+	census("as found");
+	if (u.smmu) {
+		smmu_census();
+	}
+	if (u.level == 2) {
+		note("iceusb: iceusb=2: census only, nothing written\n");
+		return false;
+	}
+	if (!dma_alloc()) {
+		note("iceusb: no %u bytes of contiguous memory\n", DMA_BYTES);
+		return false;
+	}
+	if (!power_up()) {
+		census("power-up failed");
+		return false;
+	}
+	u.snpsid = rd(DWC(GSNPSID));
+	if ((u.snpsid >> 16) != 0x5533 && (u.snpsid >> 16) != 0x3331 && (u.snpsid >> 16) != 0x3332) {
+		note("iceusb: GSNPSID %08x is not a DWC_usb3x core\n", u.snpsid);
+		return false;
+	}
+	note("iceusb: DMA %#llx + %#x (line %u B); bring-up steps %#x\n", u.dma_pa, DMA_BYTES, u.line, u.steps);
+	return core_init();
+}
+
+/*
+ * ---- lane E (24 Nov): the host role, iceusbh= HOST / HID / OTG / QEMU (bsd/dev/hakios_iceland_usbh.h) ------------------
+ * Off unless iceusbh= has 0x04 (with iceusb=1) or 0x40 (QEMU): nothing below runs, maps or allocates otherwise.
+ * The console: the host role takes the port the console uses, so it is entered only while no computer holds the console
+ * (not configured for 15 s, and never in the first 60 s of this thread), or, with OTG, when UCSI says a peripheral is on
+ * the cable (never with a computer: partner DFP). The console's ring (256 KB) keeps every line meanwhile; back in the
+ * device role (iceusbh_back s, default 120, or the cable) the PC gets them all. keep_words=iceusbh also keeps them in the
+ * loader log that reset-after hands to the ESP.
+ * The role change (Linux facts, linux a2e1ea44d3c3: dwc3-qcom.c:252-263 the VBUS/session override off for the host,
+ * :865-916; core.c (GCTL PRTCAPDIR 1 host / 2 device, the core soft reset GCTL bit 11); phy-qcom-eusb2-repeater.c:15-26,
+ * 197-221 (host: FORCE_EN_5 0xe8 = FORCE_VAL_5 0xed = bit 6, the 19.2 MHz clock; device: 0); pmih0108-kaanapali.dtsi:
+ * 63-96 (the repeater at 0xfd00 of PMIH0108, spmi_bus1 SID 7 -> PPID 0x7fd); kaanapali.dtsi:5001-5071 (the quirks:
+ * dis_u2_susphy, dis_enblslpm). The order of the switch follows UniXNU QcomDwc3 setCoreRole (BSD-2-Clause-Patent,
+ * QcomDwc3.cpp:665-684): GCTL soft reset 100 ms, PRTCAPDIR, the PHY suspend bits off, then the repeater.
+ * The host controller is our own, polled, from the xHCI specification (rev 1.2: capability / operational / runtime
+ * registers, the TRB and context layouts, the command, transfer and event rings): reset, one event ring, a command ring,
+ * DCBAA and scratchpads, then per connected port a reset, Enable Slot, Address Device, the device and configuration
+ * descriptors; with HID a boot keyboard's (mouse's) interrupt endpoint, its reports turned into IcelandHid lines. 64-bit
+ * registers high half first (Linux's dwc3 host: write-64-hi-lo-quirk; QcomDwc3 XHCI_WRITE64). DMA as the gadget's:
+ * physically contiguous kernel pages, clean+invalidate at every hand-over (Apple's own xHCI does no cache maintenance:
+ * that is why this lane does not start AppleUSBXHCI on the tablet yet -- see runs/laneE/REPORT.md).
+ * Hardware written, only in the host role: DWC3 GCTL / GUSB2PHYCFG / GUSB3PIPECTL / DCTL / DEVTEN / DALEPENA / GEVNT*,
+ * QSCRATCH HS_PHY_CTRL bits 20 28 and SS_PHY_CTRL bit 24 (cleared; set again by the device init), the xHCI registers,
+ * PMIH0108 0xfde8 / 0xfded (SPMI, only when the arbiter says the apps own PPID 0x7fd; else refused, logged).
+ */
+#include <sys/redwood_input.h>                  /* redwood_spmi_lock / unlock */
+#include "hakios_iceland_usbh.h"
+
+#define XHCI_PA        0x0a600000ULL           /* the DWC3's xHCI registers, 0x0000-0x7fff (DWC3_XHCI_REGS_END) */
+#define H_BYTES         0x10000u
+#define H_DCBAA         0x0000u
+#define H_ERST          0x0800u
+#define H_SPA           0x0840u                 /* the scratchpad array, up to 32 entries */
+#define H_CMD           0x1000u                 /* rings: 64 TRBs, the last a link */
+#define H_EP0           0x1400u
+#define H_INT           0x1800u
+#define H_BUF           0x1c00u                 /* control data, 1 KB */
+#define H_EV            0x2000u                 /* the event ring: 256 TRBs */
+#define H_IN            0x3000u                 /* input context */
+#define H_DEV           0x4000u                 /* device context */
+#define H_REP           0x5000u                 /* the interrupt endpoint's report */
+#define H_SP            0x6000u                 /* scratchpad pages, at most 10 */
+#define RING_TRBS       64u
+#define EV_TRBS         256u
+#define PPID_REPEATER   0x7fdu
+
+static struct {
+	uint32_t bits, back_s, at_s, enters, leaves, devs, reps, errs;
+	int cable, partner;
+	uint32_t cable_gen;
+	bool in_host, qemu, spmi_ok, spmi_tried, forced;
+	vm_offset_t x, op, rt, db, sobsv, schnv;
+	uint8_t *mem;
+	uint64_t pa, since, unconf, left;
+	uint32_t caplen, ports, slots, csz, sp, line;
+	uint32_t ci, cc, ei, ec, e0i, e0c, ini, inc;
+	uint32_t slot, port, speed, mps0, dci, ifc, imps, kind;
+	uint8_t last[8];
+	uint32_t mx, my;
+	uint32_t ev_cc, ev_slot, ev_type;
+	uint64_t ev_ptr;
+	uint32_t ev_res, psc;
+} h;
+
+void
+hakios_iceland_usbh_cable(int wants_host, int partner, uint32_t generation)
+{
+	h.partner = partner;
+	h.cable_gen = generation;
+	os_atomic_store(&h.cable, wants_host, release);
+}
+
+#define XR(o)   rd(h.x + (o))
+#define OPR(o)  (h.op + (o))
+#define RTR(o)  (h.rt + (o))
+
+static void
+w64(vm_offset_t a, uint64_t v)
+{
+	if (h.qemu) {
+		/* QEMU's xHCI model takes CRCR and ERSTBA when their HIGH half is written (hw/usb/hcd-xhci.c): low first */
+		wr(a, (uint32_t)v);
+		dsb();
+		wr(a + 4, (uint32_t)(v >> 32));
+		dsb();
+		return;
+	}
+	wr(a + 4, (uint32_t)(v >> 32));
+	dsb();
+	wr(a, (uint32_t)v);
+	dsb();
+}
+
+static void
+hsync(uint32_t off, uint32_t len)
+{
+	uintptr_t a = ((uintptr_t)h.mem + off) & ~((uintptr_t)h.line - 1), end = (uintptr_t)h.mem + off + len;
+
+	for (; a < end; a += h.line) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a) : "memory");
+	}
+	dsb();
+}
+
+static volatile uint32_t *
+trb(uint32_t off, uint32_t i)
+{
+	return (volatile uint32_t *)(void *)(h.mem + off + 16 * i);
+}
+
+/* a ring of RING_TRBS, the last a link back to its start (toggle cycle) */
+static void
+ring_init(uint32_t off, uint32_t *idx, uint32_t *cyc)
+{
+	volatile uint32_t *l = trb(off, RING_TRBS - 1);
+
+	bzero(h.mem + off, 16 * RING_TRBS);
+	l[0] = (uint32_t)(h.pa + off);
+	l[1] = (uint32_t)((h.pa + off) >> 32);
+	l[3] = 6u << 10 | 1u << 1;
+	*idx = 0;
+	*cyc = 1;
+	hsync(off, 16 * RING_TRBS);
+}
+
+static uint64_t
+ring_put(uint32_t off, uint32_t *idx, uint32_t *cyc, uint64_t p, uint32_t st, uint32_t ctl)
+{
+	volatile uint32_t *t = trb(off, *idx);
+	uint64_t at = h.pa + off + 16 * *idx;
+
+	t[0] = (uint32_t)p;
+	t[1] = (uint32_t)(p >> 32);
+	t[2] = st;
+	dsb();
+	t[3] = ctl | *cyc;
+	hsync(off + 16 * *idx, 16);
+	if (++*idx == RING_TRBS - 1) {
+		volatile uint32_t *l = trb(off, RING_TRBS - 1);
+
+		l[3] = 6u << 10 | 1u << 1 | *cyc;
+		hsync(off + 16 * (RING_TRBS - 1), 16);
+		*idx = 0;
+		*cyc ^= 1;
+	}
+	return at;
+}
+
+/* the next event, if any: 32 transfer, 33 command completion, 34 port status change (0: none) */
+static uint32_t
+ev_next(void)
+{
+	volatile uint32_t *t = trb(H_EV, h.ei);
+	uint32_t type;
+
+	hsync(H_EV + 16 * h.ei, 16);
+	if ((t[3] & 1) != h.ec) {
+		return 0;
+	}
+	h.ev_ptr = t[0] | (uint64_t)t[1] << 32;
+	h.ev_res = t[2] & 0xffffff;
+	h.ev_cc = t[2] >> 24;
+	h.ev_slot = t[3] >> 24;
+	h.ev_type = (t[3] >> 16) & 0x1f;        /* (a transfer's endpoint id) */
+	type = (t[3] >> 10) & 0x3f;
+	if (++h.ei == EV_TRBS) {
+		h.ei = 0;
+		h.ec ^= 1;
+	}
+	w64(RTR(0x38), (h.pa + H_EV + 16 * h.ei) | 8u);
+	if (type == 34) {
+		h.psc |= 1u << ((h.ev_ptr >> 24) & 31);
+	}
+	return type;
+}
+
+/* until an event of `want` (and, for 32 / 33, of that TRB / endpoint): its completion code, or 0x100 at the limit */
+static uint32_t
+ev_wait(uint32_t want, uint64_t trb_pa, uint32_t dci, uint32_t limit_ms)
+{
+	for (uint32_t t = 0; t <= limit_ms * 10; t++) {
+		uint32_t type = ev_next();
+
+		if (type == 0) {
+			wait_us(100);
+			continue;
+		}
+		if (type == want && (want != 33 || h.ev_ptr == trb_pa) && (want != 32 || h.ev_type == dci)) {
+			return h.ev_cc;
+		}
+	}
+	return 0x100;
+}
+
+static uint32_t
+xcmd(uint64_t p, uint32_t ctl)
+{
+	uint64_t at = ring_put(H_CMD, &h.ci, &h.cc, p, 0, ctl);
+
+	wr(h.db, 0);
+	dsb();
+	return ev_wait(33, at, 0, 300);
+}
+
+/* a control transfer on EP0 of h.slot; the data stage in H_BUF; true on success (or a short packet) */
+static bool
+ctrl(uint8_t type, uint8_t req, uint16_t value, uint16_t index, uint16_t len)
+{
+	bool in = (type & 0x80) != 0;
+	uint32_t cc;
+
+	if (len > 1024) {
+		return false;
+	}
+	ring_put(H_EP0, &h.e0i, &h.e0c, (uint64_t)type | (uint64_t)req << 8 | (uint64_t)value << 16 | (uint64_t)index << 32 |
+	    (uint64_t)len << 48, 8, 2u << 10 | 1u << 6 | (len ? (in ? 3u : 2u) : 0u) << 16);
+	if (len) {
+		hsync(H_BUF, len);
+		ring_put(H_EP0, &h.e0i, &h.e0c, h.pa + H_BUF, len, 3u << 10 | (in ? 1u << 16 : 0));
+	}
+	ring_put(H_EP0, &h.e0i, &h.e0c, 0, 0, 4u << 10 | 1u << 5 | (len && in ? 0 : 1u << 16));
+	wr(h.db + 4 * h.slot, 1);
+	dsb();
+	cc = ev_wait(32, 0, 1, 500);
+	if (cc == 1 || cc == 13) {
+		if (len) {
+			hsync(H_BUF, len);
+		}
+		return true;
+	}
+	h.errs++;
+	note("iceusbh: ep0 %02x %02x cc %u\n", type, req, cc);
+	if (cc == 6 || cc == 4) {               /* stalled / transaction error: the endpoint reset, the ring moved on */
+		(void)xcmd(0, 14u << 10 | 1u << 16 | h.slot << 24);
+		(void)xcmd((h.pa + H_EP0 + 16 * h.e0i) | h.e0c, 16u << 10 | 1u << 16 | h.slot << 24);
+	}
+	return false;
+}
+
+/* ---- the eUSB2 repeater's host clock (SPMI bus 1, PPID 0x7fd), as hakios_iceland_bt.c's channel lookup ---- */
+static vm_offset_t
+hmap(uint64_t pa, uint32_t n)
+{
+	return ml_io_map_unmappable((vm_offset_t)pa, n, VM_WIMG_IO);
+}
+
+static bool
+spmi_find(void)
+{
+	vm_offset_t core = hmap(0x0c400000u, 0x3000), map = hmap(0x0c403000u, 0x8000), own1 = hmap(0x0c43b000u, 0x8000);
+	uint32_t base, cnt, o, c;
+	int chosen = -1;
+
+	h.spmi_tried = true;
+	if (core == 0 || map == 0 || own1 == 0 || (rd(core) >> 28) != 8) {
+		return false;
+	}
+	base = rd(core + 4) & 0x1fff;
+	cnt = rd(core + 8) & 0x1fff;
+	for (uint32_t n = base; n < base + cnt && n < 0x2000 && 4 * (n - base) < 0x8000; n++) {
+		if ((rd(map + 4 * n) & 0x1fff) == PPID_REPEATER && (rd(own1 + 4 * (n - base)) & 7) == 0) {
+			chosen = (int)n;
+			break;
+		}
+	}
+	if (chosen < 0) {
+		note("iceusbh: repeater: no apps channel\n");
+		return false;
+	}
+	o = 0x0c4c0000u + 0x20u * (uint32_t)chosen;
+	c = 0x0c900000u + 0x200u * (uint32_t)chosen;
+	h.sobsv = hmap(o & ~0xfffu, 0x1000);
+	h.schnv = hmap(c & ~0xfffu, 0x1000);
+	if (h.sobsv == 0 || h.schnv == 0) {
+		return false;
+	}
+	h.sobsv += o & 0xfff;
+	h.schnv += c & 0xfff;
+	return true;
+}
+
+static int
+spmi_rw(uint8_t reg, int val)
+{
+	uint32_t st = 0;
+	int v = -1;
+
+	if (!u.quiet) {
+		redwood_spmi_lock();
+	}
+	if (val >= 0) {
+		wr(h.schnv + 0x10, (uint32_t)val);
+		wr(h.schnv, (uint32_t)reg << 4);
+		for (int t = 0; t < 1000 && !((st = rd(h.schnv + 8)) & 1); t++) {
+			wait_us(1);
+		}
+	}
+	wr(h.sobsv, 1u << 27 | (uint32_t)reg << 4);
+	for (int t = 0; t < 100 && !((st = rd(h.sobsv + 8)) & 1); t++) {
+		wait_us(10);
+	}
+	if (st == 1) {
+		v = (int)(rd(h.sobsv + 0x18) & 0xff);
+	}
+	if (!u.quiet) {
+		redwood_spmi_unlock();
+	}
+	return v;
+}
+
+static void
+repeater(bool host)
+{
+	int a, b;
+
+	if (h.qemu || (!h.spmi_tried && !(h.spmi_ok = spmi_find())) || !h.spmi_ok) {
+		return;
+	}
+	a = spmi_rw(0xe8, host ? 0x40 : 0);
+	b = spmi_rw(0xed, host ? 0x40 : 0);
+	note("iceusbh: repeater %s: %x %x\n", host ? "host" : "dev", a, b);
+}
+
+/* ---- the controller ---- */
+static void xhci_stop(void);
+
+static bool
+xhci_start(void)
+{
+	uint32_t v, pg;
+
+	if (h.mem == NULL) {
+		vm_offset_t va = 0;
+
+		h.line = 4u << ((__builtin_arm_rsr64("CTR_EL0") >> 16) & 0xf);
+		if (kmem_alloc_contig(kernel_map, &va, H_BYTES, 0, 0xfffff, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS && kmem_alloc_contig(kernel_map, &va, H_BYTES, 0, 0, 0,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return false;
+		}
+		h.mem = (uint8_t *)va;
+		h.pa = kvtophys(va);
+		if (h.pa == 0 || kvtophys(va + H_BYTES - 1) != h.pa + H_BYTES - 1) {
+			return false;
+		}
+	}
+	bzero(h.mem, H_BYTES);
+	hsync(0, H_BYTES);
+	v = XR(0);
+	h.caplen = v & 0xff;
+	h.op = h.x + h.caplen;
+	h.rt = h.x + (XR(0x18) & ~0x1fu);
+	h.db = h.x + (XR(0x14) & ~3u);
+	h.ports = XR(4) >> 24;
+	h.slots = XR(4) & 0xff;
+	h.csz = (XR(0x10) & 4) ? 64 : 32;
+	h.sp = ((XR(8) >> 21) & 0x1f) << 5 | XR(8) >> 27;
+	pg = rd(OPR(8)) & 0xffff;
+	note("iceusbh: xhci %x hcs %08x %08x hcc %08x ports %u slots %u sp %u pg %x\n", v >> 16, XR(4), XR(8), XR(0x10),
+	    h.ports, h.slots, h.sp, pg);
+	if (h.sp > 10 || !(pg & 1) || h.slots == 0) {
+		return false;
+	}
+	wr(OPR(0), rd(OPR(0)) & ~1u);
+	(void)wait_bits(OPR(4), 1, 1, 20000, 100);
+	wr(OPR(0), 2);                                  /* HCRST */
+	dsb();
+	wait_us(1000);
+	if (!wait_bits(OPR(0), 2, 0, 200000, 1000) || !wait_bits(OPR(4), 1u << 11, 0, 200000, 1000)) {
+		note("iceusbh: hcrst %08x %08x\n", rd(OPR(0)), rd(OPR(4)));
+		return false;
+	}
+	wr(OPR(0x38), (rd(OPR(0x38)) & ~0xffu) | 1);   /* one device slot */
+	for (uint32_t i = 0; i < h.sp; i++) {
+		((volatile uint64_t *)(void *)(h.mem + H_SPA))[i] = h.pa + H_SP + 0x1000u * i;
+	}
+	((volatile uint64_t *)(void *)(h.mem + H_DCBAA))[0] = h.sp ? h.pa + H_SPA : 0;
+	*(volatile uint64_t *)(void *)(h.mem + H_ERST) = h.pa + H_EV;
+	*(volatile uint32_t *)(void *)(h.mem + H_ERST + 8) = EV_TRBS;
+	hsync(0, H_EV);
+	ring_init(H_CMD, &h.ci, &h.cc);
+	h.ei = 0;
+	h.ec = 1;
+	w64(OPR(0x30), h.pa + H_DCBAA);
+	w64(OPR(0x18), (h.pa + H_CMD) | 1);
+	wr(RTR(0x28), 1);
+	w64(RTR(0x38), h.pa + H_EV);
+	w64(RTR(0x30), h.pa + H_ERST);
+	wr(RTR(0x20), 0);                               /* IMAN: interrupts off (polled) */
+	/* the controller holds what we wrote, or it never runs (no DMA from a half-written address) */
+	if ((rd(OPR(0x30)) | (uint64_t)rd(OPR(0x34)) << 32) != h.pa + H_DCBAA ||
+	    (rd(RTR(0x30)) | (uint64_t)rd(RTR(0x34)) << 32) != h.pa + H_ERST) {
+		note("iceusbh: readback %08x %08x\n", rd(OPR(0x30)), rd(RTR(0x30)));
+		return false;
+	}
+	wr(OPR(0), 1);                                  /* run, no interrupts */
+	if (!wait_bits(OPR(4), 1, 0, 20000, 100)) {
+		note("iceusbh: no run %08x\n", rd(OPR(4)));
+		xhci_stop();
+		return false;
+	}
+	v = xcmd(0, 23u << 10);                         /* No-Op */
+	note("iceusbh: run sts %08x noop cc %u\n", rd(OPR(4)), v);
+	h.slot = 0;
+	h.psc = ~0u;                                    /* look at every port once */
+	if (v != 1) {
+		xhci_stop();                            /* halted and reset: no DMA once we give up */
+		return false;
+	}
+	return true;
+}
+
+static void
+xhci_stop(void)
+{
+	if (h.x == 0 || h.op == 0) {
+		return;
+	}
+	wr(OPR(0), rd(OPR(0)) & ~1u);
+	(void)wait_bits(OPR(4), 1, 1, 20000, 100);
+	wr(OPR(0), 2);
+	dsb();
+	wait_us(1000);
+	(void)wait_bits(OPR(0), 2, 0, 200000, 1000);
+}
+
+#define PORTSC(p)       OPR(0x400 + 0x10 * ((p) - 1))
+#define PS_KEEP         ((1u << 0) | (1u << 3) | (0xfu << 10) | (1u << 30) | (0xfu << 5) | (1u << 9) | (3u << 14) | \
+	                 (7u << 25))
+
+static void
+hid_out(const char *line)
+{
+#if defined(XNU_TARGET_OS_OSX)
+	if ((h.bits & ICEUSBH_HID) && !u.quiet) {
+		iceland_hid_line(line);
+	}
+#else
+	(void)line;
+#endif
+}
+
+static void
+dev_gone(void)
+{
+	if (h.slot != 0) {
+		(void)xcmd(0, 10u << 10 | h.slot << 24);
+		if (h.kind != 0) {
+			hid_out("R");
+		}
+		note("iceusbh: port %u gone\n", h.port);
+	}
+	h.slot = h.port = h.dci = h.kind = 0;
+}
+
+/* the HID boot interface's interrupt endpoint: configured, its first report asked */
+static bool
+hid_start(uint32_t ep, uint32_t mps, uint32_t interval)
+{
+	volatile uint32_t *c;
+	uint32_t n = 0;
+
+	h.dci = 2 * (ep & 0xf) + 1;
+	h.imps = mps > 64 ? 64 : mps;
+	if (h.speed == 3) {
+		n = interval ? interval - 1 : 0;
+	} else {
+		for (uint32_t f = interval * 8; f > 1; f >>= 1) {
+			n++;
+		}
+		n = n < 3 ? 3 : n > 10 ? 10 : n;
+	}
+	ring_init(H_INT, &h.ini, &h.inc);
+	bzero(h.mem + H_IN, 0x1000);
+	c = (volatile uint32_t *)(void *)(h.mem + H_IN);
+	c[1] = 1u | 1u << h.dci;
+	c = (volatile uint32_t *)(void *)(h.mem + H_IN + h.csz);
+	c[0] = h.dci << 27 | h.speed << 20;
+	c[1] = h.port << 16;
+	c = (volatile uint32_t *)(void *)(h.mem + H_IN + h.csz * (1 + h.dci));
+	c[0] = (n & 0xff) << 16;
+	c[1] = mps << 16 | 7u << 3 | 3u << 1;
+	c[2] = (uint32_t)(h.pa + H_INT) | 1;
+	c[3] = (uint32_t)((h.pa + H_INT) >> 32);
+	c[4] = mps << 16 | mps;
+	hsync(H_IN, 0x1000);
+	if (xcmd(h.pa + H_IN, 12u << 10 | h.slot << 24) != 1) {
+		note("iceusbh: cfg ep %x failed\n", ep);
+		return false;
+	}
+	ring_put(H_INT, &h.ini, &h.inc, h.pa + H_REP, h.imps, 1u << 10 | 1u << 5 | 1u << 2);
+	wr(h.db + 4 * h.slot, h.dci);
+	return true;
+}
+
+/* a device on port p: reset, address, descriptors, and the HID boot interface when asked */
+static void
+dev_new(uint32_t p)
+{
+	volatile uint32_t *c;
+	uint32_t ps, cc, total, i, ep = 0, emps = 0, ival = 0, cfgval;
+	uint8_t *b = h.mem + H_BUF;
+
+	ps = rd(PORTSC(p));
+	if (!(ps & 2)) {                                /* USB2: reset to enable */
+		wr(PORTSC(p), (ps & PS_KEEP) | 1u << 4);
+		(void)wait_bits(PORTSC(p), 1u << 21, 1u << 21, 200000, 1000);
+		ps = rd(PORTSC(p));
+		wr(PORTSC(p), (ps & PS_KEEP) | 0xfeu << 16);
+		wait_us(20000);
+		ps = rd(PORTSC(p));
+	}
+	h.speed = (ps >> 10) & 0xf;
+	if (!(ps & 2) || h.speed == 0) {
+		note("iceusbh: port %u not enabled %08x\n", p, ps);
+		return;
+	}
+	cc = xcmd(0, 9u << 10);
+	if (cc != 1) {
+		note("iceusbh: enable slot cc %u\n", cc);
+		return;
+	}
+	h.slot = h.ev_slot;
+	h.port = p;
+	h.mps0 = h.speed == 4 ? 512 : h.speed == 3 ? 64 : 8;
+	ring_init(H_EP0, &h.e0i, &h.e0c);
+	bzero(h.mem + H_IN, 0x2000);
+	((volatile uint64_t *)(void *)(h.mem + H_DCBAA))[h.slot] = h.pa + H_DEV;
+	c = (volatile uint32_t *)(void *)(h.mem + H_IN);
+	c[1] = 3;
+	c = (volatile uint32_t *)(void *)(h.mem + H_IN + h.csz);
+	c[0] = 1u << 27 | h.speed << 20;
+	c[1] = p << 16;
+	c = (volatile uint32_t *)(void *)(h.mem + H_IN + 2 * h.csz);
+	c[1] = h.mps0 << 16 | 4u << 3 | 3u << 1;
+	c[2] = (uint32_t)(h.pa + H_EP0) | 1;
+	c[3] = (uint32_t)((h.pa + H_EP0) >> 32);
+	c[4] = 8;
+	hsync(0, 0x2000);
+	hsync(H_IN, 0x2000);
+	cc = xcmd(h.pa + H_IN, 11u << 10 | h.slot << 24);
+	if (cc != 1) {
+		note("iceusbh: address cc %u port %u speed %u\n", cc, p, h.speed);
+		dev_gone();
+		return;
+	}
+	if (!ctrl(0x80, 6, 0x100, 0, 8)) {
+		dev_gone();
+		return;
+	}
+	if (b[7] != h.mps0 && b[7] >= 8) {              /* full speed: EP0's real packet size, by Evaluate Context */
+		h.mps0 = b[7];
+		c = (volatile uint32_t *)(void *)(h.mem + H_IN);
+		c[0] = 0;
+		c[1] = 2;
+		c = (volatile uint32_t *)(void *)(h.mem + H_IN + 2 * h.csz);
+		c[1] = h.mps0 << 16 | 4u << 3 | 3u << 1;
+		hsync(H_IN, 0x1000);
+		(void)xcmd(h.pa + H_IN, 13u << 10 | h.slot << 24);
+	}
+	if (!ctrl(0x80, 6, 0x100, 0, 18) || !ctrl(0x80, 6, 0x200, 0, 9)) {
+		dev_gone();
+		return;
+	}
+	h.devs++;
+	total = b[2] | b[3] << 8;
+	cfgval = b[5];
+	total = total > 1024 ? 1024 : total;
+	if (!ctrl(0x80, 6, 0x200, 0, (uint16_t)total)) {
+		dev_gone();
+		return;
+	}
+	/* the device descriptor again (H_BUF now holds the configuration): its fields were logged below from a copy */
+	{
+		uint8_t cfg[1024];
+
+		memcpy(cfg, b, total);
+		(void)ctrl(0x80, 6, 0x100, 0, 18);
+		note("iceusbh: dev port %u speed %u %04x:%04x cls %x/%x/%x mps %u cfg %u B\n", p, h.speed, b[8] | b[9] << 8,
+		    b[10] | b[11] << 8, b[4], b[5], b[6], h.mps0, total);
+		for (i = 0; i + 2 <= total && cfg[i] >= 2; i += cfg[i]) {
+			if (cfg[i + 1] == 4 && i + 9 <= total) {
+				note("iceusbh: if %u cls %x/%x/%x ep %u\n", cfg[i + 2], cfg[i + 5], cfg[i + 6], cfg[i + 7], cfg[i + 4]);
+				if (h.kind == 0 && cfg[i + 5] == 3 && cfg[i + 6] == 1 && (cfg[i + 7] == 1 || cfg[i + 7] == 2)) {
+					h.kind = cfg[i + 7];
+					h.ifc = cfg[i + 2];
+				}
+			} else if (cfg[i + 1] == 5 && i + 7 <= total && h.kind != 0 && ep == 0 && (cfg[i + 2] & 0x80) &&
+			    (cfg[i + 3] & 3) == 3) {
+				ep = cfg[i + 2];
+				emps = (cfg[i + 4] | cfg[i + 5] << 8) & 0x7ff;
+				ival = cfg[i + 6];
+			}
+		}
+	}
+	if (!(h.bits & ICEUSBH_HID) || h.kind == 0 || ep == 0) {
+		h.kind = 0;
+		return;
+	}
+	if (!ctrl(0x00, 9, (uint16_t)cfgval, 0, 0) || !ctrl(0x21, 0x0b, 0, (uint16_t)h.ifc, 0)) {
+		h.kind = 0;
+		return;
+	}
+	(void)ctrl(0x21, 0x0a, 0, (uint16_t)h.ifc, 0);  /* SET_IDLE 0 (a mouse may stall it) */
+	if (!hid_start(ep, emps, ival)) {
+		h.kind = 0;
+		return;
+	}
+	note("iceusbh: hid %s ep %x mps %u int %u\n", h.kind == 1 ? "kbd" : "mouse", ep, emps, ival);
+	h.mx = h.my = 0x4000;
+}
+
+static void
+hid_report(uint32_t len)
+{
+	uint8_t *r = h.mem + H_REP;
+	char line[48];
+	int n;
+
+	hsync(H_REP, 64);
+	h.reps++;
+	if (h.kind == 1 && len >= 8 && memcmp(r, h.last, 8) != 0) {
+		n = snprintf(line, sizeof(line), "K %x", r[0]);
+		for (uint32_t k = 2; k < 8; k++) {
+			if (r[k] > 3) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " %x", r[k]);
+			}
+		}
+		memcpy(h.last, r, 8);
+		hid_out(line);
+	} else if (h.kind == 2 && len >= 3) {
+		int32_t x = (int32_t)h.mx + 16 * (int8_t)r[1], y = (int32_t)h.my + 16 * (int8_t)r[2];
+
+		h.mx = (uint32_t)(x < 0 ? 0 : x > 0x7fff ? 0x7fff : x);
+		h.my = (uint32_t)(y < 0 ? 0 : y > 0x7fff ? 0x7fff : y);
+		snprintf(line, sizeof(line), "A %x %x %x", r[0] & 7, h.mx, h.my);
+		hid_out(line);
+	}
+	if (h.reps <= 3 || h.reps % 500 == 0) {
+		note("iceusbh: reports %u\n", h.reps);
+	}
+}
+
+/* the host role's pass: events, ports, reports */
+static void
+host_poll(void)
+{
+	uint32_t type, p;
+
+	while ((type = ev_next()) != 0) {
+		if (type == 32 && h.slot != 0 && h.ev_type == h.dci && h.kind != 0 && h.ev_slot == h.slot) {
+			if (h.ev_cc == 1 || h.ev_cc == 13) {
+				hid_report(h.imps - (h.ev_res < h.imps ? h.ev_res : h.imps));
+			} else if (++h.errs <= 5) {
+				note("iceusbh: int cc %u\n", h.ev_cc);
+			}
+			if (h.ev_cc == 1 || h.ev_cc == 13 || h.ev_cc == 4) {
+				ring_put(H_INT, &h.ini, &h.inc, h.pa + H_REP, h.imps, 1u << 10 | 1u << 5 | 1u << 2);
+				wr(h.db + 4 * h.slot, h.dci);
+			}
+		}
+	}
+	for (p = 1; p <= h.ports && h.psc != 0; p++) {
+		uint32_t ps;
+
+		if (!(h.psc & (1u << p)) && h.psc != ~0u) {
+			continue;
+		}
+		ps = rd(PORTSC(p));
+		wr(PORTSC(p), (ps & PS_KEEP) | (ps & 0xfeu << 16));
+		note("iceusbh: port %u sc %08x\n", p, ps);
+		if ((ps & 1) && h.slot == 0) {
+			wait_us(100000);                /* debounce (USB 2.0 7.1.7.3: 100 ms) */
+			dev_new(p);
+		} else if (!(ps & 1) && h.port == p) {
+			dev_gone();
+		}
+	}
+	h.psc = 0;
+}
+
+static void
+gadget_stop(void)
+{
+	set_bits(DWC(DCTL), RUN_STOP, 0);
+	(void)wait_bits(DWC(DSTS), DEVCTRLHLT, DEVCTRLHLT, 100000, 100);
+	wr(DWC(DEVTEN), 0);
+	wr(DWC(DALEPENA), 0);
+	wr(DWC(GEVNTSIZ), 1u << 31);
+	if (u.line_state & 1) {
+		hid_closed();
+	}
+	for (uint32_t p = 0; p < NPHYS; p++) {
+		u.ep[p].busy = 0;
+	}
+	u.configured = u.address = 0;
+	u.line_state = 0;
+	u.phase = PH_IDLE;
+	u.pend_addr = u.pend_cfg = 0;
+}
+
+static void
+core_role(uint32_t prtcap)
+{
+	set_bits(DWC(GCTL), 0, 1u << 11);
+	wait_us(100000);
+	set_bits(DWC(GCTL), 1u << 11, 0);
+	set_bits(DWC(GCTL), 3u << 12, prtcap << 12);
+	set_bits(DWC(GUSB2PHYCFG), 1u << 6 | 1u << 8, 0);
+	set_bits(DWC(GUSB3PIPECTL), 1u << 17, 0);
+}
+
+static void
+enter_host(const char *why)
+{
+	h.enters++;
+	note("iceusbh: host in (%s) #%u\n", why, h.enters);
+	gadget_stop();
+	core_role(1);
+	set_bits(QS(QS_HS_PHY), 1u << 20 | 1u << 28, 0);
+	set_bits(QS(QS_SS_PHY), 1u << 24, 0);
+	repeater(true);
+	if (h.x == 0) {
+		h.x = hmap(XHCI_PA, 0x8000);
+	}
+	h.in_host = true;
+	h.since = now_us();
+	if (h.x == 0 || !xhci_start()) {
+		note("iceusbh: host failed\n");
+		h.since = 0;                            /* leave at the next look */
+	}
+}
+
+static void
+leave_host(const char *why)
+{
+	h.leaves++;
+	dev_gone();
+	xhci_stop();
+	repeater(false);
+	core_role(2);
+	h.in_host = false;
+	h.left = h.unconf = now_us();
+	u.ev_pos = 0;
+	if (core_init()) {
+		u.state = S_RUN;
+	}
+	note("iceusbh: host out (%s): devs %u reps %u errs %u\n", why, h.devs, h.reps, h.errs);
+}
+
+/* every pass of the USB thread: which role */
+static void
+role_check(void)
+{
+	uint64_t now = now_us();
+	int cable = os_atomic_load(&h.cable, acquire), go;
+	bool otg = (h.bits & ICEUSBH_OTG) != 0;
+
+	if (!h.in_host && u.configured) {
+		h.unconf = now;
+	}
+	if (h.at_s != 0 && !h.forced && !h.in_host && now - u.run_at >= (uint64_t)h.at_s * 1000000) {
+		/* iceusbh_at=S (sheng's usb-host=<s>): once, S s after the device start, whatever holds the console; back after
+		 * iceusbh_back s by the time rule (the unattended host-role test; no VBUS is ever made by this) */
+		h.forced = true;
+		enter_host("forced");
+		return;
+	}
+	if (h.forced && h.in_host) {
+		otg = false;
+	}
+	go = iceusbh_role(h.in_host, otg, cable, h.partner, h.in_host && h.since == 0, (unsigned)((now - u.run_at) / 1000000),
+	    (unsigned)((now - h.unconf) / 1000000), (unsigned)((now - h.left) / 1000000),
+	    h.in_host && h.since ? (unsigned)((now - h.since) / 1000000) : 0, h.back_s);
+	if (go > 0) {
+		enter_host(otg ? "cable" : "time");
+	} else if (go < 0) {
+		leave_host(h.since == 0 ? "failed" : otg ? "cable" : "time");
+	} else if (h.in_host) {
+		host_poll();
+	}
+}
+
+/* QEMU (iceusbh 0x40, refused on the tablet): the same host code on qemu-xhci, found by its class in the PCI ECAM */
+static void
+qemu_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	vm_offset_t ecam = 0;
+	uint64_t bar = 0;
+
+	for (uint32_t d = 0; d < 32 && bar == 0; d++) {
+		vm_offset_t f = hmap(0x4010000000ULL + ((uint64_t)d << 15), 0x1000);
+
+		if (f == 0 || (rd(f) & 0xffff) == 0xffff || (rd(f + 8) >> 8) != 0x0c0330) {
+			continue;
+		}
+		ecam = f;
+		bar = (rd(f + 0x10) & ~0xfu) | (uint64_t)((rd(f + 0x10) & 6) == 4 ? rd(f + 0x14) : 0) << 32;
+		if (bar == 0) {                         /* not assigned by the firmware: the start of the 32-bit window */
+			wr(f + 0x10, 0x10000000u);
+			wr(f + 0x14, 0);
+			bar = 0x10000000u;
+		}
+		wr(f + 4, rd(f + 4) | 6);               /* memory space, bus master */
+		note("iceusbh: qemu xhci 00:%02x bar %llx\n", d, bar);
+	}
+	if (ecam == 0 || (h.x = hmap(bar, 0x4000)) == 0 || !xhci_start()) {
+		note("iceusbh: qemu: no xhci\n");
+		thread_terminate(current_thread());
+	}
+	h.in_host = true;
+	for (;;) {
+		host_poll();
+		delay_for_interval(4, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- the USB thread ------------------------------------------------------------------------------------------------ */
+static void
+usb_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	bool up;
+
+	os_atomic_store(&in_op, 1, release);
+	up = bring_up();
+	if (up) {
+		u.state = S_RUN;
+		note("iceusb: running: waiting for a host (1209:0001, CDC-ACM)\n");
+	}
+	os_atomic_store(&in_op, 0, release);
+	if (!up) {
+		if (u.state == S_UP) {
+			u.state = S_FAIL;
+		}
+		if (ring != NULL) {
+			loader_log_tap_install(NULL);   /* nobody will read the ring: the log goes on without the tap */
+			note("iceusb: no console (%u B were taken for it)\n", ring_used());
+		}
+		thread_terminate(current_thread());
+		/* NOTREACHED */
+	}
+	while (u.state == S_RUN) {
+		uint32_t n;
+
+		os_atomic_store(&in_op, 1, release);
+		if (u.state != S_RUN) {
+			os_atomic_store(&in_op, 0, release);
+			break;
+		}
+		if (h.bits & ICEUSBH_HOST) {
+			role_check();           /* lane E (iceusbh 0x04): may take the port into the host role and back */
+		}
+		if (h.in_host) {
+			os_atomic_store(&in_op, 0, release);
+			delay_for_interval(4, NSEC_PER_MSEC);
+			continue;
+		}
+		n = poll_events();
+		tick();
+		pump();
+		os_atomic_store(&in_op, 0, release);
+		if (u.mon_cmd != 0) {
+			uint8_t c = u.mon_cmd;
+
+			u.mon_cmd = 0;
+			if (c == 1) {
+				status_line();
+			} else {
+				note("iceusb: commands: usb (the link's state), help; !<line>: a keyboard command (icehid=1)\n");
+			}
+		}
+		delay_for_interval(n != 0 || ring_used() != 0 ? 1 : 4, NSEC_PER_MSEC);
+	}
+	thread_terminate(current_thread());
+}
+
+/*
+ * ---- icedrop: a file from macOS to the PC over the console (/dev/icedrop; w4-audio round 6) -----------------------------
+ * For a run with nobody at the tablet: a program writes a file (a recording of some megabytes) into /dev/icedrop and
+ * closes it; the kernel then sends it as text lines through the USB console's ring, where the PC's console reader
+ * already listens, with a SHA-256 over the bytes:
+ *   icedrop: BEGIN <id> bytes=<n> lines=<n> raw=144 sha256=<64 hex> pass=<p>/<passes>
+ *   icedrop: <id> <line number, 5 digits or more, from 0> <base64 of up to 144 bytes>
+ *   icedrop: END <id> pass=<p>/<passes>
+ * (build/runs/w4-audio/tools/icedrop_decode.py puts the file together again from the reader's console.raw or
+ * console.txt, takes any line from either pass, and checks the SHA-256.) The lines go to the ring ALONE
+ * (loader_log_tap_write): not into the loader log, the kept lines or the message buffer, whose few hundred KB hold the
+ * run's own lines. The sender waits for room in the ring before each line (the console's own lines keep 16 KB), so
+ * nothing of the file is dropped there; a line that finds no room for 5 s is given up and counted, and the whole file
+ * goes twice (icedrop_passes=N, 1 .. 4) for a reader that was away. What the log gets: one line when the file is
+ * closed (bytes, SHA-256) and one when it has been sent (lines, passes, time, waits, lines given up).
+ * The node is made with icedrop=1 or icerec=1 on the line. icedrop=2 (QEMU, where there is no USB console): the same
+ * lines through printf instead, into the serial log. Without a console and without icedrop=2 nothing is sent; the
+ * close line still gives the checksum. One file at a time (EBUSY while one is open or being sent), at most 8 MB.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/crypto/sha2.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+
+extern bool loader_log_tap_write(const char *text, uint32_t len);       /* osfmk/arm64/loader_return.c */
+void hakios_iceland_drop_init(void);
+
+#define DROP_MAX        (8u * 1024u * 1024u)
+#define DROP_RAW        144u                    /* bytes a line: 192 characters of base64 */
+#define DROP_KEEP       (16u * 1024u)           /* ring room left to the console's own lines */
+
+static LCK_GRP_DECLARE(drop_lck_grp, "icedrop");
+static LCK_MTX_DECLARE(drop_lock, &drop_lck_grp);
+static uint8_t *drop_buf;
+static uint32_t drop_len, drop_mode, drop_passes = 2, drop_id;
+static bool drop_is_open, drop_busy, drop_over;
+static uint32_t drop_waits, drop_given_up;
+
+static uint32_t
+drop_b64(const uint8_t *in, uint32_t n, char *out)
+{
+	static const char t[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	uint32_t o = 0;
+
+	for (uint32_t i = 0; i < n; i += 3) {
+		uint32_t left = n - i, v = (uint32_t)in[i] << 16 | (left > 1 ? (uint32_t)in[i + 1] << 8 : 0) |
+		    (left > 2 ? (uint32_t)in[i + 2] : 0);
+
+		out[o++] = t[v >> 18];
+		out[o++] = t[(v >> 12) & 63];
+		out[o++] = left > 1 ? t[(v >> 6) & 63] : '=';
+		out[o++] = left > 2 ? t[v & 63] : '=';
+	}
+	return o;
+}
+
+/* true while a host has the console configured and the ring is the tap's */
+static bool
+drop_usb_ready(void)
+{
+	return ring != NULL && u.state == S_RUN && u.configured != 0;
+}
+
+/* one whole line to the ring (waiting for room) or, icedrop=2, to printf */
+static bool
+drop_line(const char *line, uint32_t len, bool usb)
+{
+	if (!usb) {
+		printf("%s", line);
+		return true;
+	}
+	for (uint32_t waited = 0; RING_BYTES - ring_used() < len + DROP_KEEP || !drop_usb_ready(); waited += 2) {
+		if (waited >= 5000) {
+			drop_given_up++;
+			return false;
+		}
+		if (waited == 0) {
+			drop_waits++;
+		}
+		delay_for_interval(2, NSEC_PER_MSEC);
+	}
+	return loader_log_tap_write(line, len);
+}
+
+static void
+drop_send(__unused void *parameter, __unused wait_result_t result)
+{
+	static const char hex[] = "0123456789abcdef";
+	uint8_t digest[SHA256_DIGEST_LENGTH];
+	char sum[2 * SHA256_DIGEST_LENGTH + 1], line[320];
+	SHA256_CTX ctx;
+	uint32_t len = drop_len, lines = (len + DROP_RAW - 1) / DROP_RAW, id = drop_id, n;
+	uint64_t t0 = now_us(), drops0 = ring_drops;
+	bool usb;
+
+	SHA256_Init(&ctx);
+	SHA256_Update(&ctx, drop_buf, len);
+	SHA256_Final(digest, &ctx);
+	for (uint32_t i = 0; i < SHA256_DIGEST_LENGTH; i++) {
+		sum[2 * i] = hex[digest[i] >> 4];
+		sum[2 * i + 1] = hex[digest[i] & 15];
+	}
+	sum[2 * SHA256_DIGEST_LENGTH] = 0;
+	/* a host may still be on its way back (the reader re-opens the port): up to 20 s for it */
+	for (uint32_t i = 0; drop_mode != 2 && ring != NULL && !drop_usb_ready() && i < 200; i++) {
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	usb = drop_mode != 2 && drop_usb_ready();
+	printf("icedrop: file %u closed: %u bytes%s, sha256 %s: %s\n", id, len, drop_over ? " (CUT at 8 MB)" : "", sum,
+	    usb ? "going out over iceusb" : drop_mode == 2 ? "going out through printf (icedrop=2)" :
+	    "NOT SENT (no USB console with a host; icedrop=2 would print it)");
+	drop_waits = drop_given_up = 0;
+	for (uint32_t pass = 1; (usb || drop_mode == 2) && pass <= drop_passes && drop_given_up < 4; pass++) {
+		n = (uint32_t)snprintf(line, sizeof(line), "\nicedrop: BEGIN %u bytes=%u lines=%u raw=%u sha256=%s pass=%u/%u\n",
+		    id, len, lines, DROP_RAW, sum, pass, drop_passes);
+		(void)drop_line(line, n, usb);
+		for (uint32_t k = 0; k < lines; k++) {
+			uint32_t at = k * DROP_RAW, take = len - at < DROP_RAW ? len - at : DROP_RAW;
+
+			n = (uint32_t)snprintf(line, sizeof(line), "icedrop: %u %05u ", id, k);
+			n += drop_b64(drop_buf + at, take, line + n);
+			line[n++] = '\n';
+			line[n] = 0;
+			if (!drop_line(line, n, usb) && drop_given_up >= 4) {
+				break;                          /* nobody reads: 20 s were enough */
+			}
+			if (!usb && (k & 15) == 15) {
+				/*
+				 * icedrop=2 is read out of the message buffer by a poller (QEMU: runs/integ/tools/ringpoll-big.py, a
+				 * snapshot of the 1 MB ring about twice a second): some 110 KB a second, so every line is in a
+				 * snapshot before the ring comes round to it; a line cut at the ring's end comes whole in the next pass
+				 */
+				delay_for_interval(30, NSEC_PER_MSEC);
+			}
+		}
+		n = (uint32_t)snprintf(line, sizeof(line), "icedrop: END %u pass=%u/%u\n", id, pass, drop_passes);
+		(void)drop_line(line, n, usb);
+	}
+	if (usb || drop_mode == 2) {
+		printf("icedrop: file %u sent: %u bytes, sha256 %s, %u lines x %u passes %s in %llu ms; %u waits for the ring, "
+		    "%u lines given up, %llu console bytes dropped meanwhile\n", id, len, sum, lines + 2, drop_passes,
+		    usb ? "over iceusb" : "through printf", (now_us() - t0) / 1000, drop_waits, drop_given_up,
+		    ring_drops - drops0);
+	}
+	lck_mtx_lock(&drop_lock);
+	drop_busy = false;
+	lck_mtx_unlock(&drop_lock);
+	thread_terminate(current_thread());
+}
+
+static int
+drop_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	int error = 0;
+
+	lck_mtx_lock(&drop_lock);
+	if (drop_is_open || drop_busy) {
+		error = EBUSY;
+	} else {
+		if (drop_buf == NULL) {
+			drop_buf = (uint8_t *)kalloc_data(DROP_MAX, Z_WAITOK);
+		}
+		if (drop_buf == NULL) {
+			error = ENOMEM;
+		} else {
+			drop_len = 0;
+			drop_over = false;
+			drop_is_open = true;
+		}
+	}
+	lck_mtx_unlock(&drop_lock);
+	return error;
+}
+
+static int
+drop_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int error = 0;
+
+	lck_mtx_lock(&drop_lock);
+	while (error == 0 && uio_resid(uio) > 0) {
+		user_ssize_t n = uio_resid(uio);
+
+		if (!drop_is_open || drop_len >= DROP_MAX) {
+			drop_over = drop_is_open;
+			error = ENOSPC;
+			break;
+		}
+		if (n > (user_ssize_t)(DROP_MAX - drop_len)) {
+			n = DROP_MAX - drop_len;
+		}
+		if (n > 65536) {
+			n = 65536;
+		}
+		error = uiomove((caddr_t)(drop_buf + drop_len), (int)n, uio);
+		if (error == 0) {
+			drop_len += (uint32_t)n;
+		}
+	}
+	lck_mtx_unlock(&drop_lock);
+	return error;
+}
+
+static int
+drop_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	thread_t thread;
+	bool send;
+
+	lck_mtx_lock(&drop_lock);
+	send = drop_is_open && drop_len != 0;
+	drop_is_open = false;
+	if (send) {
+		drop_busy = true;
+		drop_id++;
+	}
+	lck_mtx_unlock(&drop_lock);
+	if (send) {
+		if (kernel_thread_start(drop_send, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			printf("icedrop: no thread: file %u (%u bytes) not sent\n", drop_id, drop_len);
+			lck_mtx_lock(&drop_lock);
+			drop_busy = false;
+			lck_mtx_unlock(&drop_lock);
+		}
+	}
+	return 0;
+}
+
+static const struct cdevsw drop_cdevsw = {
+	.d_open = drop_open, .d_close = drop_close, .d_read = eno_rdwrt, .d_write = drop_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* from redwood_audio_init() (bsd_init: devfs is mounted): the node, only when the line asks for it */
+void
+hakios_iceland_drop_init(void)
+{
+	uint32_t rec = 0;
+	int major;
+
+	PE_parse_boot_argn("icedrop", &drop_mode, sizeof(drop_mode));
+	PE_parse_boot_argn("icerec", &rec, sizeof(rec));
+	if (drop_mode == 0 && rec == 1) {
+		drop_mode = 1;
+	}
+	if (drop_mode != 1 && drop_mode != 2) {
+		return;
+	}
+	PE_parse_boot_argn("icedrop_passes", &drop_passes, sizeof(drop_passes));
+	drop_passes = drop_passes < 1 ? 1 : drop_passes > 4 ? 4 : drop_passes;
+	major = cdevsw_add(-1, &drop_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0622, "icedrop") == NULL) {
+		printf("icedrop: /dev/icedrop cannot be made\n");
+		return;
+	}
+	printf("icedrop: /dev/icedrop: a file written there and closed goes to the PC as text lines %s, %u pass(es), with its "
+	    "SHA-256\n", drop_mode == 2 ? "through printf (icedrop=2)" : "over the USB console's ring alone (iceusb=1)",
+	    drop_passes);
+}
+
+void
+hakios_iceland_usbcon_init(void)
+{
+	thread_t thread;
+	vm_offset_t r = 0;
+
+	if (PE_parse_boot_argn("iceusbh", &h.bits, sizeof(h.bits)) && h.bits != 0) {
+		/* lane E: iceusbh= (bsd/dev/hakios_iceland_usbh.h); this file's bits are HOST, HID, OTG and QEMU */
+		h.cable = -1;
+		h.back_s = 120;
+		PE_parse_boot_argn("iceusbh_back", &h.back_s, sizeof(h.back_s));
+		PE_parse_boot_argn("iceusbh_at", &h.at_s, sizeof(h.at_s));
+		if ((h.bits & ICEUSBH_QEMU) && ((__builtin_arm_rsr64("MIDR_EL1") >> 24) & 0xff) != 0x51 && h.mem == NULL) {
+			h.qemu = true;
+			h.bits &= ~ICEUSBH_OTG;
+			if (kernel_thread_start(qemu_thread, NULL, &thread) == KERN_SUCCESS) {
+				thread_deallocate(thread);
+			}
+			return;
+		}
+		h.bits &= ~ICEUSBH_QEMU;
+		if ((h.bits & ICEUSBH_OTG) && !(h.bits & ICEUSBH_TC)) {
+			h.bits &= ~ICEUSBH_OTG;         /* the cable rule needs UCSI */
+		}
+	}
+	if (!PE_parse_boot_argn("iceusb", &u.level, sizeof(u.level)) || u.level == 0 || u.state != S_OFF) {
+		return;
+	}
+	if (u.level != 1) {
+		h.bits &= ~ICEUSBH_HOST;                /* the host role needs the device bring-up (iceusb=1) first */
+	}
+	u.steps = 7;
+	u.trace = 24;
+	PE_parse_boot_argn("iceusb_smmu", &u.smmu, sizeof(u.smmu));
+	PE_parse_boot_argn("iceusb_steps", &u.steps, sizeof(u.steps));
+	PE_parse_boot_argn("iceusb_trace", &u.trace, sizeof(u.trace));
+	u.line_coding[1] = 0xc2;                        /* 115200 8N1, only reported */
+	u.line_coding[2] = 0x01;
+	u.line_coding[6] = 8;
+	u.state = S_UP;
+	if (u.level == 1) {
+		if (kmem_alloc(kernel_map, &r, RING_BYTES, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			note("iceusb: no ring\n");
+			u.state = S_FAIL;
+			return;
+		}
+		ring = (char *)r;
+		loader_log_tap_install(iceusb_tap);     /* the log so far first, then every character as it comes */
+	}
+	note("iceusb: iceusb=%u smmu %u steps %#x trace %u: the USB thread starts\n", u.level, u.smmu, u.steps, u.trace);
+	if (kernel_thread_start(usb_thread, NULL, &thread) != KERN_SUCCESS) {
+		u.state = S_FAIL;
+		return;
+	}
+	thread_deallocate(thread);
+}
+
+/*
+ * From loader_return() (A3's re-entry, a panic's or reset-after's end), the other cores already off, interrupts maybe
+ * off: what the ring still holds goes out (at most 2 s, only when the USB thread was not inside the gadget), then the
+ * core halts with its events off and its event buffer forgotten. GDSC, clocks and PHY stay on: the re-entered U-Boot
+ * finds the controller as ABL's fastboot hands it over (device role, halted) and initialises it as it does then.
+ */
+void
+hakios_iceland_usbcon_quiesce(void)
+{
+	uint64_t until;
+	uint32_t left;
+	bool drained = false;
+
+	if (u.state != S_RUN && u.state != S_UP) {
+		return;
+	}
+	u.quiet = true;
+	if (u.state == S_RUN && os_atomic_load(&in_op, acquire) == 0 && u.configured) {
+		until = now_us() + 2000000;
+		while (now_us() < until && u.configured && (ring_used() != 0 || u.ep[P_IN].busy)) {
+			poll_events();
+			pump();
+		}
+		drained = ring_used() == 0 && !u.ep[P_IN].busy;
+	}
+	left = ring != NULL ? ring_used() : 0;
+	u.state = S_STOP;
+	if (h.in_host && !h.qemu && u.powered && u.dwc != 0) {
+		/* lane E: the loader gets the port back in the device role (as ABL's fastboot hands it over), the repeater's
+		 * host clock off; the xHCI halted and reset first */
+		xhci_stop();
+		repeater(false);
+		core_role(2);
+		h.in_host = false;
+		note("iceusbh: quiesce: host role left\n");
+	}
+	if (u.powered && u.dwc != 0) {
+		set_bits(DWC(DCTL), RUN_STOP, 0);
+		wait_bits(DWC(DSTS), DEVCTRLHLT, DEVCTRLHLT, 50000, 100);
+		wr(DWC(DEVTEN), 0);
+		wr(DWC(DALEPENA), 0);
+		wr(DWC(GEVNTSIZ), 1u << 31);
+		wr(DWC(GEVNTADRLO), 0);
+		wr(DWC(GEVNTADRHI), 0);
+		wr(DWC(GEVNTCOUNT), rd(DWC(GEVNTCOUNT)) & 0xfffc);
+		note("iceusb: quiesce: %s, %u B not sent; in %llu B; halted (dsts %08x)\n", drained ? "drained" : "not drained",
+		    left, u.in_bytes, rd(DWC(DSTS)));
+	}
+}
diff --git a/bsd/dev/hakios_iceland_usbh.h b/bsd/dev/hakios_iceland_usbh.h
new file mode 100644
index 0000000000000000000000000000000000000000..85df25d1bec1e7fd87ab97a58a3d92597181d0f7
--- /dev/null
+++ b/bsd/dev/hakios_iceland_usbh.h
@@ -0,0 +1,90 @@
+/*
+ * lane E (24 Nov 2026): the USB switches, one boot-arg word, iceusbh=<bits>. Every bit is off unless written on the
+ * line; iceusbh=0 or no word: nothing of lane E runs, maps, allocates, writes or logs (the kernel is install-6.7's).
+ *   0x01 TC    Type-C: the OPM side of UCSI over the SoCCP's GLINK channel (needs icebatt>=3, which opens it): PPM reset,
+ *              notifications on, the connector status at every change (connected, partner, power direction, mode).
+ *              Writes: GLINK messages to the charger firmware's UCSI owner only (no register, no bus).
+ *   0x02 DP    DP alt mode, observed: PAN enable, every port notification decoded (mux, orientation, SVID, pin
+ *              assignment, HPD) and acknowledged as Linux does. No display output (not in this lane).
+ *   0x04 HOST  the DWC3 in the host role (iceusb=1 needed): the gadget is stopped, core soft reset, host port capability,
+ *              the VBUS/session override off, the eUSB2 repeater's 19.2 MHz host clock forced (SPMI), and our own polled
+ *              xHCI: reset, rings, ports, one device enumerated and named. Back to the device role (the console) after
+ *              iceusbh_back s (default 120) or when the cable says so (0x10). Entered only while no computer holds the
+ *              console (not configured for 15 s) and never in the first 60 s of the USB thread.
+ *   0x08 HID   a boot-protocol keyboard (and a mouse, when IcelandHid has a pointer device) on the host port feeds
+ *              iokit/Native/IcelandHid as its "K" / "A" lines (icehid=1 needed).
+ *   0x10 OTG   the role follows the cable (needs 0x01 and 0x04): a peripheral (UCSI partner UFP) -> host; a computer
+ *              (DFP) or nothing -> device. Without it only the time rule of 0x04 switches.
+ *   0x20 VBUS  the OTG boost through the charger firmware, as the owner's Linux does it (qcom_battmgr OPLUS): only after
+ *              the firmware's own OTG-enable notification, only with a cable in and NO charger or computer (USB online
+ *              0, UCSI partner not DFP), never under 3600 mV / 15 % / outside 0..45 C, at most iceusbh_ma mA (default
+ *              500, at most 1500) and iceusbh_vbus_s s (default 1200) per attach; off at once on any of these.
+ *   0x40 QEMU  (QEMU only; refused on a Qualcomm CPU) the host code of 0x04 on QEMU's qemu-xhci (PCI ECAM, BAR0).
+ * With 0x04: iceusbh_at=S forces the host role ONCE, S s after the device start, whatever holds the console (sheng's
+ * usb-host=<s>: the unattended test; no VBUS is made by it), and iceusbh_back=S (default 120) is the time in the host
+ * role before the device role (the console) comes back, for the forced and the time rule (not the cable rule).
+ * VBUS: iceusbh_ma=MA (100 .. 1500, default 500) the boost current limit, iceusbh_vbus_s=S (default 1200, at most 3600)
+ * the boost time an attach may have.
+ * Lines start "iceusbh: ".
+ */
+#ifndef HAKIOS_ICELAND_USBH_H
+#define HAKIOS_ICELAND_USBH_H
+
+#define ICEUSBH_TC      0x01u
+#define ICEUSBH_DP      0x02u
+#define ICEUSBH_HOST    0x04u
+#define ICEUSBH_HID     0x08u
+#define ICEUSBH_OTG     0x10u
+#define ICEUSBH_VBUS    0x20u
+#define ICEUSBH_QEMU    0x40u
+
+/* the cable as UCSI tells it (battery thread -> USB thread): wants_host 1 / 0 / -1 (unknown), partner type, generation */
+void hakios_iceland_usbh_cable(int wants_host, int partner, uint32_t generation);
+
+/*
+ * The VBUS rule, pure (the kernel and runs/laneE/tests/t-usbh.c use this one function): VBUS out only when every reading
+ * was answered, a cable is in (OPLUS CID 1), USB online is 0 (no charger, no computer), the firmware has said OTG enable
+ * (0x50) since the attach, UCSI does not say DFP, the battery is >= 3600 mV, >= 15 %, 0 .. 45 C, this attach's boost time
+ * is under its limit and the firmware has not refused a boost write.
+ */
+#define ICEUSBH_VBUS_MIN_MV     3600
+#define ICEUSBH_VBUS_MIN_SOC    15
+#define ICEUSBH_VBUS_MAX_C      45
+struct iceusbh_vbus_in {
+	int have, cid, online, sourcing, partner_dfp, refused;
+	int mv, soc, deg_c;
+	unsigned on_s, limit_s;
+};
+
+static inline int
+iceusbh_vbus_ok(const struct iceusbh_vbus_in *v)
+{
+	return v->have && v->cid == 1 && v->online == 0 && v->sourcing && !v->partner_dfp && !v->refused &&
+	       v->mv >= ICEUSBH_VBUS_MIN_MV && v->soc >= ICEUSBH_VBUS_MIN_SOC && v->deg_c >= 0 &&
+	       v->deg_c <= ICEUSBH_VBUS_MAX_C && v->on_s < v->limit_s;
+}
+
+/*
+ * The role rule, pure: 1 go to the host role, -1 leave it, 0 stay. Times in seconds since the USB thread's run, its last
+ * configured moment and the last leave. otg: the cable decides (cable 1 host, 0 device, -1 unknown: stay).
+ */
+static inline int
+iceusbh_role(int in_host, int otg, int cable, int partner, int failed, unsigned since_run_s, unsigned unconf_s,
+    unsigned since_left_s, unsigned in_host_s, unsigned back_s)
+{
+	if (!in_host) {
+		if (otg) {
+			return cable == 1 ? 1 : 0;
+		}
+		return unconf_s > 15 && since_run_s > 60 && since_left_s > 30 && !(cable == 0 && partner == 1) ? 1 : 0;
+	}
+	if (failed) {
+		return -1;
+	}
+	if (otg) {
+		return cable == 0 ? -1 : 0;
+	}
+	return in_host_s > back_s ? -1 : 0;
+}
+
+#endif /* HAKIOS_ICELAND_USBH_H */
diff --git a/bsd/dev/hakios_iceland_video.c b/bsd/dev/hakios_iceland_video.c
new file mode 100644
index 0000000000000000000000000000000000000000..1797fe3b909f00d0fb702b5319b07df02d4b146b
--- /dev/null
+++ b/bsd/dev/hakios_iceland_video.c
@@ -0,0 +1,198 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") video decoder VPU (the "iris", VPU 4.0): the kaanapali half of
+ * sheng's device-verified QcomIris (UniXNU-sheng drivers/QcomIris, BSD-2 + GPL-2 Linux C, the iris stateful decoder
+ * that plays the Aerials wallpaper from the HEVC decoder instead of VTDecoderXPCService's 4-GB software path).
+ * Only with boot-arg icevideo=N; without it nothing here is touched and VideoToolbox keeps its own codecs.
+ *
+ * The driver itself is the qcomiris object (base/tools/mk-qcomiris.sh in the hakios tree builds it from pinned
+ * sources outside every repository: sheng's QcomIris C core + the VideoToolbox paravirtualization host + this
+ * board's platform, compiled as arm64e kernel code and linked as REDWOOD_OBJECTS' video object, XNU_VIDEO_OBJECT):
+ * it answers AppleVideoToolboxParavirtualizationDriver's user-client messages on macOS 27's own wire format
+ * (VtWire.h, pinned by sheng against the 27.3 dyld cache) and decodes on the iris device (IrisMedia.cpp, the
+ * stateful V4L2 decoder layer, SoC-agnostic as sheng built it). Its platform half (KaanapaliVideo.cpp) carries
+ * every kaanapali value this board's DT and mainline's own driver give (the sm8550->kaanapali delta):
+ *   the VPU          kaanapali.dtsi iris: video-codec@2000000 "qcom,kaanapali-iris", reg 0x02000000 + 0xf0000,
+ *                    GIC_SPI 174, iommus apps_smmu 0x1940 0x1943 0x1944 0x1a20, dma-coherent, memory-region
+ *                    video_mem@9a600000 (0x800000), firmware-name qcom/kaanapali/iceland/vpu40_2v.mbn
+ *   the firmware     our device's own image (the stock vendor_a partition's /firmware/vpu40_2v.mbn, sha256
+ *                    69d4e215..9a411abc, in the iceland-firmware package), linked here as the video pack below;
+ *                    loaded through PAS 9 (iris_firmware.c IRIS_PAS_ID, every platform's) and the kaanapali
+ *                    content-protection pair (iris_platform_kaanapali.h: VM0 secure np [0x01000000, 0x25800000)
+ *                    and non-secure np [0x25800000, 0xffc00000), so the VPU's DMA window is [0x25800000, 0xe0000000)
+ *                    as the driver's IOVA allocator has it)
+ *   the clocks       videocc@20f0000: the four Taycan EKO T PLLs, the MVS0C/MVS0/VPP0/VPP1/MVS0A GDSCs, the fixed
+ *                    operating point the iris OPP table's nominal row gives (MVS0 533 MHz, MVS0C 800 MHz), the GCC
+ *                    video AHB/AXI0/AXI1 branches; KaanapaliVideoCc.c, from videocc-kaanapali.c and gdsc.c
+ *   the capability   kaanapali_data (iris_platform_vpu3x.c): the SM8550 instance caps (8192x4352 max), num_vpp_pipe 2,
+ *                    HFI gen2 (the same command set sheng's driver speaks), and UBWC 6.0 (ubwc_config.c
+ *                    "qcom,kaanapali" = ubwc_6_0_hbb16): the HFI init values it is told are the same numbers
+ *                    ubwc_4_0_hbb16 gives the SM8550 (macrotile 8, MAL 32, HBB 16, swizzle 0/1/1, bank spread 1)
+ *   the rails        MMCX and MXC voted to nominal through the apps RSC (rsc@18900000, drv-0) and the AOP command
+ *                    database (aop-cmd-db@81c60000), never lowered
+ *
+ * The video pack (built by runs/qcomiris/scripts/mk-video-pack.sh, linked as XNU_VIDEO_OBJECT, strong over the
+ * weak empty defaults here): "ICEVID1", u32 0, char name[48], u64 size, u8 sha256[32], then the vpu40_2v.mbn image,
+ * in __BOOTDATA (writable, and the kernel gives it back at lockdown). With icevideo= it is copied out first
+ * (video_pack_keep, the adsp pack's pattern); the firmware loads at the first VideoToolbox session.
+ *
+ * Lines go to the kernel log, prefixed "icevideo:". The driver's own rows keep the [video] prefix sheng's log
+ * readers know.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <kern/startup.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+__attribute__((weak, visibility("hidden"))) const uint8_t native_video_pack[8] = { 0 };
+__attribute__((weak, visibility("hidden"))) const uint64_t native_video_pack_size = 0;
+
+static const uint8_t *video_pack;
+static uint64_t video_pack_size;
+
+/* the driver object's entry points: weak no-op definitions without the object (a weak kernel has no VPU); the
+ * qcomiris object's strong definitions override them at the link, as the Wi-Fi pack's do */
+#define VIDEO_WEAK __attribute__((weak))
+int native_video_start(const uint8_t *pack, uint64_t size) VIDEO_WEAK;
+int native_video_stat(unsigned index) VIDEO_WEAK;
+const char *native_video_version(void) VIDEO_WEAK;
+int native_video_fw_text(char *to, unsigned capacity, unsigned row) VIDEO_WEAK;
+
+int
+native_video_start(const uint8_t *pack, uint64_t size)
+{
+#pragma unused(pack, size)
+	return -1;
+}
+
+int
+native_video_stat(unsigned index)
+{
+#pragma unused(index)
+	return 0;
+}
+
+const char *
+native_video_version(void)
+{
+	return NULL;
+}
+
+int
+native_video_fw_text(char *to, unsigned capacity, unsigned row)
+{
+#pragma unused(to, capacity, row)
+	return 0;
+}
+
+/*
+ * laneD (23 Nov): icevideo=N on the line, or else the lane's umbrella iceld=<ids> holding '3' (= icevideo=1), so the A/B
+ * test line needs 8 bytes; icevideo=0 on the line still wins. Without either: nothing here is touched, as before.
+ */
+extern int PE_iceland_laned(char id);
+
+static uint32_t
+video_level(void)
+{
+	uint32_t v = 0;
+
+	if (!PE_parse_boot_argn("icevideo", &v, sizeof(v))) {
+		v = PE_iceland_laned('3') ? 1 : 0;
+	}
+	return v;
+}
+
+/* the pack out of __BOOTDATA before lockdown (adsp_pack_keep's pattern), only when the driver will use it */
+static void
+video_pack_keep(void)
+{
+	uint32_t v = 0;
+	uint64_t n = native_video_pack_size;
+
+	if (n == 0) {
+		return;
+	}
+	if ((v = video_level()) == 0) {
+		printf("icevideo: pack: %llu B linked, not kept (no icevideo=)\n", n);
+		return;
+	}
+	if (n < 104 || memcmp(native_video_pack, "ICEVID1", 7) != 0) {
+		printf("icevideo: pack: %llu B linked, not one this knows: not kept\n", n);
+		return;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc(kernel_map, &va, round_page(n), KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("icevideo: pack: no memory for %llu B\n", n);
+		return;
+	}
+	memcpy((void *)va, native_video_pack, (size_t)n);
+	video_pack = (const uint8_t *)va;
+	video_pack_size = n;
+	printf("icevideo: pack kept: %llu B (out of __BOOTDATA before lockdown)\n", n);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, video_pack_keep);
+
+/* the pack's one entry: the vpu40_2v.mbn image after the header (16 magic + version, 48 name, 8 size, 32 sha256) */
+static bool
+video_pack_image(const uint8_t **image, uint64_t *bytes)
+{
+	if (video_pack_size < 104) {
+		return false;
+	}
+	uint64_t size = 0;
+	memcpy(&size, video_pack + 64, sizeof(size));
+	if (size == 0 || video_pack_size < 104 + size) {
+		return false;
+	}
+	*image = video_pack + 104;
+	*bytes = size;
+	return true;
+}
+
+void
+hakios_iceland_video_init(void)
+{
+	uint32_t level = 0;
+	const uint8_t *image = NULL;
+	uint64_t bytes = 0;
+
+	if ((level = video_level()) == 0) {
+		return;
+	}
+	if (native_video_pack_size == 0) {
+		printf("icevideo: no video pack in this kernel (the qcomiris object's firmware): the VPU stays off\n");
+		return;
+	}
+	if (native_video_pack_size && !video_pack_image(&image, &bytes)) {
+		printf("icevideo: the pack is malformed: the VPU stays off\n");
+		return;
+	}
+	const int stage = native_video_start(image, bytes);
+	if (stage == -1) {
+		printf("icevideo: no driver object in this kernel: the VPU stays off\n");
+		return;
+	}
+	printf("icevideo: stage %d (%s)\n", stage,
+	    stage == 6 ? "ready" : stage == -2 ? "no SMMU domain" : stage == -3 ? "no queues" : stage == -4 ? "no interrupt" :
+	    stage == -5 ? "no threads" : "failed");
+	if (stage == 6) {
+		const char *const version = native_video_version ? native_video_version() : NULL;
+		if (version) {
+			printf("icevideo: firmware %s\n", version);
+		}
+		for (unsigned row = 0; row < 4; ++row) {
+			char text[100];
+			if (native_video_fw_text && native_video_fw_text(text, sizeof(text), row) && text[0]) {
+				printf("[video fw] %s\n", text);
+			}
+		}
+	}
+}
diff --git a/bsd/dev/hakios_iceland_wlan.c b/bsd/dev/hakios_iceland_wlan.c
new file mode 100644
index 0000000000000000000000000000000000000000..022756ee0e989af62b73983f54a8c4a7bc1a460b
--- /dev/null
+++ b/bsd/dev/hakios_iceland_wlan.c
@@ -0,0 +1,606 @@
+/*
+ * iceland's Wi-Fi for iPadOS: en0 and the station boundary on top of the Linux ath12k driver (icepcie_lx=1,
+ * hakios_iceland_ath12k.c). Kit K2 of docs/IPADOS-WIFI-PLAN-2026-11-06.md. Gated on boot-arg icewifi_ios=1.
+ *
+ * Adapted from bsd/dev/hakios_dada_wlan.c (this tree; APSL-2.0 as the rest of the kernel). Ideas, not code, from
+ * UniXNU-sheng package/WifiNet.cpp (BSD-2-Clause-Patent): a scan asked for while joined is answered from the last
+ * results (an off-channel scan breaks the link and the handshake), and a join while joined first drains a disconnect.
+ *
+ * The parts iPadOS talks to are redwood's, already in this kernel:
+ *   - en0:            bsd/dev/redwood_net.c (ifnet KPI, Ethernet family, Wi-Fi subfamily, NX_NOAUTO, BPF);
+ *   - registry:       iokit/Kernel/RedwoodWLAN.cpp (IO80211Controller -> IO80211Interface/IONetworkInterface) and
+ *                     iokit/Kernel/MiniIONetworkStack.cpp (IONetworkStack + user client, started by GenericARMPE);
+ *   - Apple80211:     bsd/dev/redwood_apple80211.c (SIOCGA80211 / SIOCSA80211 and the class-6 kernel events);
+ *   - station thread: bsd/dev/redwood_sta.c (one call at a time; scan / join block on it, not on the driver).
+ * What is here is the link behind en0 and the station operations, done with the driver object's station interface
+ * (Ath12kWifi f6bf561 include/nw_abi.h). Its calls only queue a request; the work, and the events that tell its end,
+ * run on the driver's thread (nw_wifi_step in hakios_iceland_ath12k.c). The WPA2 handshake is the driver's own
+ * (src/nw_sta.c, in the kernel): no wpa_supplicant job in userland.
+ *
+ *   hakios_iceland_wlan_early()   from hakios_iceland_ath12k_init(): en0 now, link down (wifid looks for it once, at
+ *                                 its start, long before the firmware is up)
+ *   hakios_iceland_wlan_events()  before nw_wifi_start(): scan done, join done, link lost, frames in
+ *   hakios_iceland_wlan_poll()    from the driver's loop: the station is attached once the driver's interface exists
+ *   hakios_iceland_wlan_stop()    before nw_wifi_stop(): link down, station detached, the Apple80211 summary
+ *   hakios_iceland_wlan_fw_mac()  the driver's wlan_mac.bin: the address en0 was made with (mk-ath12k.sh 13)
+ *
+ * Never in the log: the address, the network's name, the access point, the passphrase or the key.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/if.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+
+#define say(...) printf("icewlan: " __VA_ARGS__)
+extern const uint8_t *redwood_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+extern bool redwood_wifi_radio_address(uint8_t *address);
+extern const char *redwood_apple80211_driver_name;      /* redwood_apple80211.c (DRIVER_VERSION / HARDWARE_VERSION) */
+
+/* the driver object's station interface (Ath12kWifi include/nw_abi.h; by hand, plain C) -- weak, as in hakios_iceland_ath12k.c */
+struct nw_bss_info {
+	uint8_t bssid[6]; uint8_t ssid_len; uint8_t ssid[32];
+	uint32_t freq_mhz; int8_t signal_dbm; uint16_t caps, beacon_int; uint32_t age_ms;
+	uint16_t ie_len; uint8_t ie[384];
+};
+enum { NW_STA_OFF, NW_STA_IDLE, NW_STA_SCANNING, NW_STA_AUTH, NW_STA_ASSOC, NW_STA_KEYS, NW_STA_UP };
+enum { NW_RES_OK = 0, NW_RES_NOT_FOUND = 1, NW_RES_TIMEOUT = 2, NW_RES_REJECTED = 3, NW_RES_BAD_KEY = 4, NW_RES_UNSUPPORTED = 5,
+       NW_RES_FAILED = 6 };
+struct nw_wifi_status {
+	uint32_t state; int32_t result; uint8_t bssid[6]; uint8_t ssid_len; uint8_t ssid[32]; uint32_t freq_mhz; int8_t signal_dbm;
+	uint8_t mac[6]; uint32_t channels;
+};
+/* signed as the driver object calls them (IA key, discriminator 0): see hakios_iceland_ath12k.c's NW_FP */
+#if defined(XNU_TARGET_OS_OSX) && __has_feature(ptrauth_calls)
+#include <ptrauth.h>
+#define NW_FP __ptrauth(ptrauth_key_function_pointer, 0, 0)
+#else
+#define NW_FP
+#endif
+struct nw_wifi_events {
+	void (*NW_FP scan_done)(void);
+	void (*NW_FP connect_done)(int result);
+	void (*NW_FP link_lost)(int reason);
+	void (*NW_FP rx)(const uint8_t *eth, size_t len);
+};
+struct nw_wifi_stats { uint32_t stage, scans, frames, beacons, bss_seen; int last_err; };
+extern struct nw_wifi_stats nw_wifi_stats __attribute__((weak));
+extern void nw_wifi_set_events(const struct nw_wifi_events *ev) __attribute__((weak));
+extern int nw_wifi_scan(const uint8_t *ssid, size_t len) __attribute__((weak));
+extern int nw_wifi_bss_count(void) __attribute__((weak));
+extern int nw_wifi_bss_get(int i, struct nw_bss_info *out) __attribute__((weak));
+extern int nw_wifi_connect(const uint8_t *ssid, size_t len, const uint8_t *bssid, const char *pass, size_t plen) __attribute__((weak));
+extern void nw_wifi_disconnect(void) __attribute__((weak));
+extern int nw_wifi_tx(const uint8_t *eth, size_t len) __attribute__((weak));
+extern void nw_wifi_status_get(struct nw_wifi_status *st) __attribute__((weak));
+
+/*
+ * boot-arg icewifi_ios (0 or absent: all of K2 off, the kernel behaves as K1):
+ *   bit 0 (1)  on: en0, registry, /arm-io/wlan, Apple80211, the station for iPadOS
+ *   bit 1 (2)  a scan asked for while joined really scans (default: answered from the last results)
+ *   bit 2 (4)  the association event always in the 540-byte iPadOS 27 form
+ *   bit 3 (8)  the association event always without data (iOS 16.5 form); neither bit: by the join request's length
+ */
+#define ICEWLAN_ON              1u
+#define ICEWLAN_SCAN_JOINED     2u
+#define ICEWLAN_EVENT_27        4u
+#define ICEWLAN_EVENT_LEGACY    8u
+#define ICEWLAN_EVENT_EMPTY     0x10u   /* 46cn4h: force the join-done event without data */
+extern int redwood_apple80211_assoc_event_form;         /* redwood_apple80211.c */
+static uint32_t wlan_args;
+static bool wlan_args_read;
+static uint8_t wlan_address[6];
+static bool wlan_have_address, wlan_early_done, wlan_station_up, wlan_stopped;
+
+static uint32_t
+args(void)
+{
+	if (!wlan_args_read) {
+		wlan_args_read = true;
+		if (!PE_parse_boot_argn("icewifi_ios", &wlan_args, sizeof(wlan_args))) {
+			wlan_args = 0;
+		}
+	}
+	return wlan_args;
+}
+
+/* true when iPadOS's Wi-Fi side owns the station: an in-kernel test join (K1's) must then step aside */
+bool
+hakios_iceland_wlan_owns(void)
+{
+	return (args() & ICEWLAN_ON) != 0 && nw_wifi_tx != NULL;
+}
+
+static void
+ms(uint32_t n)
+{
+	delay_for_interval(n, NSEC_PER_MSEC);
+}
+
+/* ---- the address ---- */
+
+static int
+hexval(uint8_t c)
+{
+	return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+/* Android's wlan_mac.bin (in md1 fw/, private): lines "Intf0MacAddress=001122334455"; the first interface's */
+static bool
+address_from_file(uint8_t *a)
+{
+	uint64_t size = 0;
+	const uint8_t *d = redwood_image_file("fw", "wlan_mac.bin", &size, NULL);
+	uint64_t at = 0;
+	unsigned k = 0;
+
+	if (d == NULL || size == 0) {
+		return false;
+	}
+	while (at < size && d[at] != '=') {
+		at++;
+	}
+	for (at++; at < size && k < 12; at++) {
+		int v = hexval(d[at]);
+
+		if (v < 0) {
+			break;
+		}
+		a[k / 2] = (uint8_t)((k & 1) ? (a[k / 2] << 4 | v) : v);
+		k++;
+	}
+	return k == 12 && !(a[0] & 1) && (a[0] | a[1] | a[2] | a[3] | a[4] | a[5]) != 0;
+}
+
+/* en0's and the radio's address, the same: decided once (wifi_mac=, else md1 fw/wlan_mac.bin, else a local one) */
+static void
+address(uint8_t *out)
+{
+	if (!wlan_have_address) {
+		if (redwood_wifi_radio_address(wlan_address)) {
+			say("the radio's address: given (wifi_mac)\n");
+		} else if (address_from_file(wlan_address)) {
+			say("the radio's address: the tablet's own (fw/wlan_mac.bin)\n");
+		} else {
+			static const uint8_t made[6] = { 0x02, 0x1c, 0xe1, 0x00, 0x00, 0x01 };
+
+			memcpy(wlan_address, made, 6);
+			say("the radio's address: none known, a locally administered one is made (wifi_mac= gives one)\n");
+		}
+		wlan_have_address = true;
+	}
+	memcpy(out, wlan_address, 6);
+}
+
+/* the driver asks for wlan_mac.bin (lx_fw_get): the same address, in Android's form. false when K2 is off. */
+bool
+hakios_iceland_wlan_fw_mac(const uint8_t **data, size_t *size)
+{
+	static char text[40];
+	uint8_t a[6];
+
+	if (!hakios_iceland_wlan_owns()) {
+		return false;
+	}
+	address(a);
+	snprintf(text, sizeof(text), "Intf0MacAddress=%02X%02X%02X%02X%02X%02X\n", a[0], a[1], a[2], a[3], a[4], a[5]);
+	*data = (const uint8_t *)text;
+	*size = strlen(text);
+	return true;
+}
+
+/* ---- the link behind en0 ---- */
+
+static uint8_t tx_frame[REDWOOD_NET_FRAME_MAX];
+static uint64_t tx_frames, tx_dropped, rx_frames;
+
+/* redwood_net.c calls this under its transmit lock: one at a time. nw_wifi_tx copies the frame into its queue. */
+static bool
+link_transmit(mbuf_t packet, size_t length)
+{
+	if (length > sizeof(tx_frame) || nw_wifi_tx == NULL || mbuf_copydata(packet, 0, length, tx_frame) != 0) {
+		tx_dropped++;
+		return false;
+	}
+	if (nw_wifi_tx(tx_frame, length) != 0) {
+		tx_dropped++;
+		return false;
+	}
+	tx_frames++;
+	return true;
+}
+
+static struct redwood_net_link wlan_link = {
+	.name = "the tablet's radio (ath12k, WCN7860)",
+	.wireless = true,
+	.up = false,
+	.transmit = link_transmit,
+};
+
+/* from hakios_iceland_ath12k_init(), before the driver's thread: en0 is there before iPadOS's Wi-Fi side looks */
+void
+hakios_iceland_wlan_early(void)
+{
+	if (!(args() & ICEWLAN_ON)) {
+		return;
+	}
+	if (nw_wifi_tx == NULL) {
+		say("icewifi_ios=%u: the driver's object is not in this kernel: no en0\n", args());
+		return;
+	}
+	if (wlan_early_done) {
+		return;
+	}
+	wlan_early_done = true;
+	redwood_apple80211_driver_name = "iceland: ath12k for the WCN7860";
+	redwood_apple80211_assoc_event_form = (args() & ICEWLAN_EVENT_27) ? 1 : (args() & (ICEWLAN_EVENT_LEGACY | ICEWLAN_EVENT_EMPTY)) ? 2 : 0;
+	address(wlan_link.address);
+	say("icewifi_ios=%u: en0 %s\n", args(), redwood_net_attach(&wlan_link) ?
+	    "made, the radio behind it (link down until a network is joined)" : "NOT MADE: there is another link behind en0");
+}
+
+/* ---- the driver's events (on its thread: no sleeping) ---- */
+
+static volatile int ev_scan_done, ev_join_done, ev_join_result;
+
+static void
+ev_scan(void)
+{
+	ev_scan_done = 1;
+}
+
+static void
+ev_join(int result)
+{
+	ev_join_result = result;
+	ev_join_done = 1;
+	if (result == NW_RES_OK) {
+		redwood_net_link_state(true);   /* authorized: nw_sta.c reports OK only after the keys and AUTHORIZED */
+	}
+}
+
+static void
+ev_lost(int reason)
+{
+	say("the network is lost (reason %d)\n", reason);
+	redwood_net_link_state(false);
+	redwood_sta_lost(ECONNRESET);
+}
+
+static void
+ev_rx(const uint8_t *eth, size_t len)
+{
+	rx_frames++;
+	redwood_net_input(eth, len);
+}
+
+static const struct nw_wifi_events wlan_events = { ev_scan, ev_join, ev_lost, ev_rx };
+
+/* before nw_wifi_start(): the events are iPadOS's */
+void
+hakios_iceland_wlan_events(void)
+{
+	if (hakios_iceland_wlan_owns() && nw_wifi_set_events != NULL) {
+		nw_wifi_set_events(&wlan_events);
+		say("the driver's events go to en0 and Apple80211\n");
+	}
+}
+
+/* ---- the station's operations (on redwood_sta.c's thread: they may wait) ---- */
+
+/* wait for a flag an event sets, at most `most` ms: true when it was set */
+static bool
+wait_flag(volatile int *flag, uint32_t most)
+{
+	for (uint32_t waited = 0; !*flag && waited < most; waited += 20) {
+		ms(20);
+	}
+	return *flag != 0;
+}
+
+static uint32_t
+station_state(void)
+{
+	struct nw_wifi_status s;
+
+	if (nw_wifi_status_get == NULL) {
+		return NW_STA_OFF;
+	}
+	nw_wifi_status_get(&s);
+	return s.state;
+}
+
+static int
+sta_power(bool on)
+{
+	say("power %s asked\n", on ? "on" : "off");
+	if (!on && nw_wifi_disconnect != NULL) {
+		nw_wifi_disconnect();
+		redwood_net_link_state(false);
+	}
+	return 0;
+}
+
+static int
+sta_scan(const struct redwood_sta_scan *what)
+{
+	static unsigned cached;
+	uint32_t state = station_state();
+
+	/* joining or joined: a scan takes the radio off its channel for seconds; the last results are answered (sheng) */
+	if (state >= NW_STA_AUTH && !(args() & ICEWLAN_SCAN_JOINED)) {
+		if (++cached <= 8 || cached % 64 == 0) {
+			say("scan %u while joined (state %u): answered from the last results\n", cached, state);
+		}
+		return 0;
+	}
+	ev_scan_done = 0;
+	(void)nw_wifi_scan(what != NULL && what->ssid_length ? what->ssid : NULL, what != NULL ? what->ssid_length : 0);
+	/* a scan that runs already (the driver's own first one) ends as this one would */
+	if (!wait_flag(&ev_scan_done, 15000)) {
+		say("a scan did not end in 15 s: what was heard so far is answered\n");
+	}
+	return 0;
+}
+
+static struct redwood_sta_bss heard_one;
+
+static void
+sta_heard(void (*each)(const struct redwood_sta_bss *bss, void *context), void *context)
+{
+	static struct nw_bss_info b;
+	int n = nw_wifi_bss_count != NULL ? nw_wifi_bss_count() : 0, given = 0;
+
+	for (int i = 0; i < n; i++) {
+		if (nw_wifi_bss_get(i, &b) != 0) {
+			continue;
+		}
+		bzero(&heard_one, sizeof(heard_one));
+		memcpy(heard_one.bssid, b.bssid, 6);
+		heard_one.ssid_length = b.ssid_len > 32 ? 32 : b.ssid_len;
+		memcpy(heard_one.ssid, b.ssid, heard_one.ssid_length);
+		heard_one.frequency = (uint16_t)b.freq_mhz;
+		heard_one.rssi = b.signal_dbm;
+		heard_one.beacon_interval = b.beacon_int;
+		heard_one.capability = b.caps;
+		heard_one.age_ms = b.age_ms;
+		heard_one.elements_length = b.ie_len > sizeof(b.ie) ? sizeof(b.ie) : b.ie_len;
+		memcpy(heard_one.elements, b.ie, heard_one.elements_length);
+		each(&heard_one, context);
+		given++;
+	}
+	{
+		static unsigned said;
+
+		if (++said <= 16 || said % 32 == 0) {
+			say("scan results for Apple80211: %d networks (scan %u)\n", given, said);
+		}
+	}
+}
+
+static int
+sta_join(const struct redwood_sta_join *what)
+{
+	static const uint8_t none[6];
+	char pass[65];
+	size_t plen = 0;
+	const uint8_t *bssid = memcmp(what->bssid, none, 6) != 0 ? what->bssid : NULL;
+
+	/* joined or joining: the driver's one request slot must see the disconnect through before the connect (sheng) */
+	if (station_state() >= NW_STA_AUTH && nw_wifi_disconnect != NULL) {
+		say("a join while joined: the old network is left first\n");
+		nw_wifi_disconnect();
+		redwood_net_link_state(false);
+		for (uint32_t waited = 0; station_state() >= NW_STA_AUTH && waited < 2000; waited += 10) {
+			ms(10);
+		}
+	}
+	if (what->security == REDWOOD_STA_WPA2_PSK) {
+		if (what->passphrase_length != 0) {
+			plen = what->passphrase_length > 63 ? 63 : what->passphrase_length;
+			memcpy(pass, what->passphrase, plen);
+		} else {
+			/* the key itself (wifid's cipher 6): 64 hexadecimal digits are taken as the PMK (nw_sta.c) */
+			for (int i = 0; i < 32; i++) {
+				snprintf(pass + 2 * i, 3, "%02x", what->pmk[i]);
+			}
+			plen = 64;
+		}
+		pass[plen] = 0;
+	}
+	say("join asked: %s, %s access point, %s\n", what->security == REDWOOD_STA_WPA2_PSK ? "WPA2-PSK" : "open",
+	    bssid != NULL ? "a given" : "any", plen == 64 ? "a PMK" : plen ? "a passphrase" : "no key");
+	ev_join_done = 0;
+	if (nw_wifi_connect(what->ssid, what->ssid_length, bssid, plen ? pass : NULL, plen) != 0) {
+		memset_s(pass, sizeof(pass), 0, sizeof(pass));
+		return EIO;
+	}
+	memset_s(pass, sizeof(pass), 0, sizeof(pass));
+	if (!wait_flag(&ev_join_done, 30000)) {
+		say("join: no answer from the driver in 30 s\n");
+		return ETIMEDOUT;
+	}
+	say("join: the driver says %d\n", ev_join_result);
+	switch (ev_join_result) {
+	case NW_RES_OK:
+		return 0;
+	case NW_RES_NOT_FOUND:
+		return ENOENT;
+	case NW_RES_TIMEOUT:
+		return ETIMEDOUT;
+	case NW_RES_BAD_KEY:
+		return EAUTH;
+	case NW_RES_REJECTED:
+		return ECONNREFUSED;
+	case NW_RES_UNSUPPORTED:
+		return ENOTSUP;
+	default:
+		return EIO;
+	}
+}
+
+static int
+sta_leave(void)
+{
+	say("leave asked\n");
+	if (nw_wifi_disconnect != NULL) {
+		nw_wifi_disconnect();
+	}
+	redwood_net_link_state(false);
+	return 0;
+}
+
+static void
+sta_state(struct redwood_sta_state *st)
+{
+	struct nw_wifi_status s;
+
+	bzero(st, sizeof(*st));
+	if (nw_wifi_status_get == NULL) {
+		return;
+	}
+	nw_wifi_status_get(&s);
+	switch (s.state) {
+	case NW_STA_OFF:
+		st->phase = REDWOOD_STA_OFF;
+		break;
+	case NW_STA_IDLE:
+		st->phase = REDWOOD_STA_IDLE;
+		break;
+	case NW_STA_SCANNING:
+		st->phase = REDWOOD_STA_SCANNING;
+		break;
+	case NW_STA_UP:
+		st->phase = REDWOOD_STA_JOINED;
+		break;
+	default:
+		st->phase = REDWOOD_STA_JOINING;
+		break;
+	}
+	memcpy(st->bss.bssid, s.bssid, 6);
+	st->bss.ssid_length = s.ssid_len > 32 ? 32 : s.ssid_len;
+	memcpy(st->bss.ssid, s.ssid, st->bss.ssid_length);
+	st->bss.frequency = (uint16_t)s.freq_mhz;
+	st->bss.rssi = s.signal_dbm;
+}
+
+/* what the radio may tune to: 2.4 GHz 1-13, 5 GHz (52-64 and 100-144 passive, radar); 6 GHz is left out as the station
+ * code leaves it out of its scans */
+static unsigned
+sta_channels(struct redwood_sta_channel *c, unsigned most)
+{
+	static const uint16_t five[] = { 5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320, 5500, 5520, 5540, 5560, 5580, 5600,
+		                         5620, 5640, 5660, 5680, 5700, 5720, 5745, 5765, 5785, 5805, 5825 };
+	unsigned n = 0;
+
+	for (unsigned ch = 1; ch <= 13 && n < most; ch++) {
+		c[n].frequency = (uint16_t)(2407 + 5 * ch);
+		c[n++].flags = 0;
+	}
+	for (unsigned i = 0; i < sizeof(five) / sizeof(five[0]) && n < most; i++) {
+		bool radar = five[i] >= 5260 && five[i] <= 5720;
+
+		c[n].frequency = five[i];
+		c[n++].flags = radar ? REDWOOD_STA_CHANNEL_PASSIVE | REDWOOD_STA_CHANNEL_RADAR : 0;
+	}
+	return n;
+}
+
+static struct redwood_sta_ops wlan_ops = {
+	.power = sta_power,
+	.scan = sta_scan,
+	.heard = sta_heard,
+	.join = sta_join,
+	.leave = sta_leave,
+	.state = sta_state,
+	.channels = sta_channels,
+};
+
+/* en0's IPv4 state for the log, without the address: whether there is one, self-assigned (DHCP failed) or not */
+static void
+say_en0(void)
+{
+	ifnet_t ifp = NULL;
+	ifaddr_t *list = NULL;
+	const char *what = "no IPv4 address";
+	struct ifnet_stats_param stats = { 0 };
+
+	if (ifnet_find_by_name("en0", &ifp) != 0 || ifp == NULL) {
+		return;
+	}
+	if (ifnet_get_address_list_family(ifp, &list, AF_INET) == 0 && list != NULL) {
+		if (list[0] != NULL) {
+			struct sockaddr_in a = { 0 };
+
+			if (ifaddr_address(list[0], (struct sockaddr *)&a, sizeof(a)) == 0) {
+				const uint8_t *b = (const uint8_t *)&a.sin_addr;
+
+				what = b[0] == 169 && b[1] == 254 ? "a self-assigned IPv4 address (169.254/16: DHCP was not answered)" :
+				    "an IPv4 address from DHCP";
+			}
+		}
+		ifnet_free_address_list(list);
+	}
+	(void)ifnet_stat(ifp, &stats);
+	say("en0: %s, flags %#x; packets in %llu out %llu; radio frames: %llu sent, %llu dropped, %llu received\n", what,
+	    ifnet_flags(ifp), stats.packets_in, stats.packets_out, tx_frames, tx_dropped, rx_frames);
+	ifnet_release(ifp);
+}
+
+/* from the driver's loop: the station is attached once the driver's interface is up (stage 4) */
+void
+hakios_iceland_wlan_poll(void)
+{
+	static uint64_t said_at;
+	uint64_t now = mach_absolute_time(), ns;
+
+	if (!hakios_iceland_wlan_owns() || wlan_stopped) {
+		return;
+	}
+	if (!wlan_station_up && &nw_wifi_stats != NULL && nw_wifi_stats.stage >= 4) {
+		struct nw_wifi_status s;
+
+		wlan_station_up = true;
+		address(wlan_ops.address);
+		if (nw_wifi_status_get != NULL) {
+			nw_wifi_status_get(&s);
+			/* (compared, never printed) */
+			say("the radio's address %s en0's\n", memcmp(s.mac, wlan_ops.address, 6) == 0 ? "is" :
+			    "IS NOT (frames for en0 will not arrive; mk-ath12k.sh 13 / wlan_mac.bin)");
+		}
+		redwood_sta_attach(&wlan_ops);
+		say("the station is attached: iPadOS is told the radio is on\n");
+	}
+	absolutetime_to_nanoseconds(now - said_at, &ns);
+	if (wlan_station_up && ns > 30ull * NSEC_PER_SEC) {
+		said_at = now;
+		say_en0();
+	}
+}
+
+/* before nw_wifi_stop(): iPadOS sees the link go, the station leaves, and what was asked is said once */
+void
+hakios_iceland_wlan_stop(void)
+{
+	if (!hakios_iceland_wlan_owns() || wlan_stopped) {
+		return;
+	}
+	wlan_stopped = true;
+	say_en0();
+	redwood_net_link_state(false);
+	if (wlan_station_up) {
+		redwood_sta_attach(NULL);
+	}
+	redwood_apple80211_summary();
+	say("stopped\n");
+}
diff --git a/bsd/dev/hakios_mhi_boot.c b/bsd/dev/hakios_mhi_boot.c
new file mode 100644
index 0000000000000000000000000000000000000000..552527e1abb5b8c2997e4fe1d1d97d29d316a513
--- /dev/null
+++ b/bsd/dev/hakios_mhi_boot.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "hakios_mhi_boot.h"
+/* (UniXNU MhiBoot.c, unchanged; bsd/dev/hakios_dada_wifi.c drives it) */
+
+static uint32_t rd(MhiBoot *m, uint32_t reg) {return m->io.read(m->io.ctx, reg);}
+static void wr(MhiBoot *m, uint32_t reg, uint32_t value) {m->io.write(m->io.ctx, reg, value);}
+
+int mhi_boot_open(MhiBoot *m, const MhiIo *io)
+{
+    for (unsigned i = 0; i < sizeof *m; ++i) ((uint8_t *)m)[i] = 0;
+    m->io = *io;
+    m->reglen = io->space ? io->space : rd(m, MHI_REGLEN);
+    m->bhi = rd(m, MHI_BHIOFF);
+    m->bhie = rd(m, MHI_BHIEOFF);
+    const int good = m->reglen >= 0x100 && m->reglen <= 0x100000 && m->bhi >= 0x100 && m->bhi + MHI_BHI_ERRCODE + 4 <= m->reglen &&
+                     m->bhie >= 0x100 && m->bhie + MHI_BHIE_TXVECSTATUS + 4 <= m->reglen && !(m->bhi & 3) && !(m->bhie & 3);
+    if (!good) {m->phase = MhiFailed; m->error = MhiErrLayout; return -1;}
+    m->phase = MhiIdle;
+    return 0;
+}
+
+uint32_t mhi_boot_ee(MhiBoot *m) {return m->ee = rd(m, m->bhi + MHI_BHI_EXECENV);}
+uint32_t mhi_boot_state(MhiBoot *m) {return m->state = (rd(m, MHI_STATUS) >> MHI_STATE_SHIFT) & 0xffu;}
+
+static uint32_t fail(MhiBoot *m, uint32_t error)
+{
+    m->failed_phase = m->phase;
+    m->error = error;
+    m->phase = MhiFailed;
+    return m->phase;
+}
+
+static uint32_t start_sbl(MhiBoot *m)
+{
+    wr(m, m->bhi + MHI_BHI_INTVEC, m->msi_vector);  /* a reset clears it */
+    wr(m, m->bhi + MHI_BHI_IMGADDR_HIGH, (uint32_t)(m->sbl_addr >> 32));
+    wr(m, m->bhi + MHI_BHI_IMGADDR_LOW, (uint32_t)m->sbl_addr);
+    wr(m, m->bhi + MHI_BHI_IMGSIZE, m->sbl_size);
+    wr(m, m->bhi + MHI_BHI_IMGTXDB, m->seq);
+    m->phase = MhiSblLoading;
+    return m->phase;
+}
+
+uint32_t mhi_boot_begin(MhiBoot *m, uint32_t msi_vector, uint64_t sbl_addr, uint32_t sbl_size, uint64_t table_addr, uint32_t table_size,
+                        uint32_t seq)
+{
+    if (m->phase != MhiIdle) return fail(m, MhiErrState);
+    m->msi_vector = msi_vector;
+    m->sbl_addr = sbl_addr; m->sbl_size = sbl_size;
+    m->table_addr = table_addr; m->table_size = table_size;
+    m->seq = seq & MHI_SEQ_MASK;
+    if (!m->seq) m->seq = 1;
+    const uint32_t ee = mhi_boot_ee(m);
+    if (ee != MhiEePbl && ee != MhiEeEdl) return fail(m, MhiErrNotPbl);
+    const uint32_t status = rd(m, MHI_STATUS);
+    m->state = (status >> MHI_STATE_SHIFT) & 0xffu;
+    wr(m, m->bhi + MHI_BHI_INTVEC, msi_vector);
+    if ((status & MHI_STATUS_SYSERR) || m->state == MhiStateSysErr) {
+        wr(m, MHI_CTRL, MHI_CTRL_RESET);
+        m->phase = MhiResetting;
+        return m->phase;
+    }
+    return start_sbl(m);
+}
+
+static uint32_t start_image(MhiBoot *m)
+{
+    m->seq = (m->seq + 1) & MHI_SEQ_MASK;
+    if (!m->seq) m->seq = 1;
+    wr(m, m->bhie + MHI_BHIE_TXVECADDR_HIGH, (uint32_t)(m->table_addr >> 32));
+    wr(m, m->bhie + MHI_BHIE_TXVECADDR_LOW, (uint32_t)m->table_addr);
+    wr(m, m->bhie + MHI_BHIE_TXVECSIZE, m->table_size);
+    wr(m, m->bhie + MHI_BHIE_TXVECDB, m->seq);
+    m->phase = MhiImageLoading;
+    return m->phase;
+}
+
+uint32_t mhi_boot_step(MhiBoot *m)
+{
+    if (m->phase == MhiIdle || m->phase == MhiDone || m->phase == MhiFailed || m->phase == MhiNeedContexts) return m->phase;
+    const uint32_t status = rd(m, MHI_STATUS);
+    if (status == 0xffffffffu) return m->phase;   /* the device does not answer (its link is retraining while its boot loader starts): not a status */
+    m->state = (status >> MHI_STATE_SHIFT) & 0xffu;
+    if (m->phase == MhiResetting) {
+        if (rd(m, MHI_CTRL) & MHI_CTRL_RESET) return m->phase;
+        return start_sbl(m);
+    }
+    const uint32_t ee = mhi_boot_ee(m);
+    if (ee == MhiEeRddm) return fail(m, MhiErrRddm);
+    if ((status & MHI_STATUS_SYSERR) || m->state == MhiStateSysErr) return fail(m, MhiErrSysErr);
+    switch (m->phase) {
+    case MhiSblLoading: {
+        const uint32_t bhi = rd(m, m->bhi + MHI_BHI_STATUS);
+        m->last_status = bhi;
+        if (bhi == 0xffffffffu) return m->phase;
+        if (bhi >> 30 == MHI_XFER_ERROR) {m->errcode = rd(m, m->bhi + MHI_BHI_ERRCODE); return fail(m, MhiErrBhi);}
+        if (bhi >> 30 != MHI_XFER_SUCCESS) return m->phase;
+        m->phase = MhiWaitReady;
+        return mhi_boot_step(m);
+    }
+    case MhiWaitReady:
+        if ((rd(m, MHI_CTRL) & MHI_CTRL_RESET) || !(status & MHI_STATUS_READY)) return m->phase;
+        m->phase = MhiNeedContexts;
+        return m->phase;
+    case MhiWaitSbl:
+        if (ee == MhiEeAmss || ee == MhiEeWfw) {m->phase = MhiDone; return m->phase;}  /* the device had the full image already */
+        if (ee != MhiEeSbl) return m->phase;
+        return start_image(m);
+    case MhiImageLoading: {
+        const uint32_t tx = rd(m, m->bhie + MHI_BHIE_TXVECSTATUS);
+        m->last_status = tx;
+        if ((tx & MHI_SEQ_MASK) != m->seq) return m->phase;  /* not this transfer's status yet */
+        if (tx >> 30 == MHI_XFER_ERROR) return fail(m, MhiErrBhie);
+        if (tx >> 30 != MHI_XFER_SUCCESS) return m->phase;
+        m->phase = MhiWaitMission;
+        return mhi_boot_step(m);
+    }
+    case MhiWaitMission:
+        if (ee == MhiEeAmss || ee == MhiEeWfw) m->phase = MhiDone;
+        return m->phase;
+    default:
+        return m->phase;
+    }
+}
+
+uint32_t mhi_boot_contexts_done(MhiBoot *m)
+{
+    if (m->phase != MhiNeedContexts) return fail(m, MhiErrState);
+    wr(m, MHI_CTRL, (rd(m, MHI_CTRL) & ~(0xffu << MHI_STATE_SHIFT) & ~MHI_CTRL_RESET) | (uint32_t)MhiStateM0 << MHI_STATE_SHIFT);
+    m->phase = MhiWaitSbl;
+    return mhi_boot_step(m);
+}
+
+uint32_t mhi_boot_timeout(MhiBoot *m)
+{
+    if (m->phase == MhiIdle || m->phase == MhiDone || m->phase == MhiFailed) return m->phase;
+    if (m->phase == MhiSblLoading) m->errcode = rd(m, m->bhi + MHI_BHI_ERRCODE);
+    return fail(m, MhiErrTimeout);
+}
+
+uint32_t mhi_bhie_table(MhiBhieEntry *table, uint32_t count, const uint64_t *addresses, uint32_t image_size, uint32_t segment_size)
+{
+    if (!segment_size || !image_size) return 0;
+    const uint32_t needed = (image_size + segment_size - 1) / segment_size;
+    if (needed > count) return 0;
+    for (uint32_t i = 0; i < needed; ++i) {
+        const uint32_t left = image_size - i * segment_size;
+        table[i].address = addresses[i];
+        table[i].size = left < segment_size ? left : segment_size;
+    }
+    return needed;
+}
diff --git a/bsd/dev/hakios_mhi_boot.h b/bsd/dev/hakios_mhi_boot.h
new file mode 100644
index 0000000000000000000000000000000000000000..91d11af534a2739b28972ccbe9f9c923a19ba014
--- /dev/null
+++ b/bsd/dev/hakios_mhi_boot.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Booting a Qualcomm MHI device's firmware from its primary boot loader, as a state machine the owner drives from the device's
+ * interrupt or a timer: prepare (interrupt vector, a reset when the device sits in an error state), the secondary boot loader through
+ * the boot host interface (BHI, one image in one DMA buffer), the wait for the device's READY, a hand back to the owner to program the
+ * MHI contexts before M0 is requested, then the full image through the vector interface (BHIe, a table of DMA segments) once the device
+ * runs the secondary boot loader, and the wait for mission mode. No call waits: each reads or writes a few registers and returns the
+ * phase; the owner keeps the deadlines and calls mhi_boot_timeout when one passes. */
+#ifndef MHI_BOOT_H
+#define MHI_BOOT_H
+#include <stdint.h>
+/* (UniXNU MhiBoot.h, unchanged: the boot of a Qualcomm MHI device's firmware; used by hakios_dada_wifi.c) */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* MHI registers (offsets in the MHI register space) and the boot interfaces' (from BHIOFF and BHIEOFF). */
+#define MHI_REGLEN 0x00u
+#define MHI_BHIOFF 0x28u
+#define MHI_BHIEOFF 0x2cu
+#define MHI_CTRL 0x38u
+#define MHI_STATUS 0x48u
+#define MHI_CTRL_RESET (1u << 1)
+#define MHI_STATUS_READY (1u << 0)
+#define MHI_STATUS_SYSERR (1u << 2)
+#define MHI_STATE_SHIFT 8u                   /* state field 15:8 in both MHI_CTRL and MHI_STATUS */
+#define MHI_BHI_IMGADDR_LOW 0x08u
+#define MHI_BHI_IMGADDR_HIGH 0x0cu
+#define MHI_BHI_IMGSIZE 0x10u
+#define MHI_BHI_IMGTXDB 0x18u
+#define MHI_BHI_INTVEC 0x20u
+#define MHI_BHI_EXECENV 0x28u
+#define MHI_BHI_STATUS 0x2cu
+#define MHI_BHI_ERRCODE 0x30u
+#define MHI_BHIE_TXVECADDR_LOW 0x2cu
+#define MHI_BHIE_TXVECADDR_HIGH 0x30u
+#define MHI_BHIE_TXVECSIZE 0x34u
+#define MHI_BHIE_TXVECDB 0x3cu
+#define MHI_BHIE_TXVECSTATUS 0x44u
+#define MHI_SEQ_MASK 0x3fffffffu             /* doorbell and status sequence 29:0, status 31:30 */
+#define MHI_XFER_SUCCESS 2u
+#define MHI_XFER_ERROR 3u
+
+enum {MhiStateReset = 0, MhiStateReady = 1, MhiStateM0 = 2, MhiStateBhi = 7, MhiStateSysErr = 0xff};
+enum {MhiEePbl = 0, MhiEeSbl = 1, MhiEeAmss = 2, MhiEeRddm = 3, MhiEeWfw = 4, MhiEePthru = 5, MhiEeEdl = 6, MhiEeFp = 7};
+
+enum {
+    MhiIdle, MhiResetting, MhiSblLoading, MhiWaitReady, MhiNeedContexts, MhiWaitSbl, MhiImageLoading, MhiWaitMission, MhiDone, MhiFailed
+};
+enum {MhiErrNone, MhiErrLayout, MhiErrNotPbl, MhiErrBhi, MhiErrBhie, MhiErrSysErr, MhiErrTimeout, MhiErrState, MhiErrRddm};
+
+typedef struct {
+    uint32_t (*read)(void *ctx, uint32_t reg);
+    void (*write)(void *ctx, uint32_t reg, uint32_t value);
+    void *ctx;
+    uint32_t space;   /* bytes of register space the owner mapped (0: use the MHIREGLEN register, which only counts the MHI block itself) */
+} MhiIo;
+
+typedef struct {
+    MhiIo io;
+    uint32_t bhi, bhie, reglen;
+    uint32_t phase, error, failed_phase, ee, state;
+    uint32_t seq, errcode, last_status;
+    uint64_t sbl_addr, table_addr;
+    uint32_t sbl_size, table_size, msi_vector;
+} MhiBoot;
+
+/* One BHIe vector table entry: a DMA segment's address and size, as the device reads them (little endian). */
+typedef struct {uint64_t address, size;} MhiBhieEntry;
+
+/* Reads the register layout. Returns 0, or -1 when the boot interfaces are not inside the register space. */
+int mhi_boot_open(MhiBoot *m, const MhiIo *io);
+uint32_t mhi_boot_ee(MhiBoot *m);
+uint32_t mhi_boot_state(MhiBoot *m);
+/* Starts the boot: sbl_* the DMA buffer holding the secondary boot loader (the image's first part), table_* the BHIe vector table
+ * describing the whole image (size: bytes of the table). seq: a nonzero value the doorbells carry (the owner's random number). */
+uint32_t mhi_boot_begin(MhiBoot *m, uint32_t msi_vector, uint64_t sbl_addr, uint32_t sbl_size, uint64_t table_addr, uint32_t table_size,
+                        uint32_t seq);
+/* Re-reads what the current phase waits for and moves on; returns the phase. */
+uint32_t mhi_boot_step(MhiBoot *m);
+/* The owner programmed the MHI contexts (phase MhiNeedContexts): requests M0 and waits for the secondary boot loader. */
+uint32_t mhi_boot_contexts_done(MhiBoot *m);
+/* The owner's deadline for the current phase passed. */
+uint32_t mhi_boot_timeout(MhiBoot *m);
+/* Fills a BHIe table for an image of image_size bytes cut in segments of segment_size placed at addresses[]; returns the number of
+ * entries, or 0 when count is too small. */
+uint32_t mhi_bhie_table(MhiBhieEntry *table, uint32_t count, const uint64_t *addresses, uint32_t image_size, uint32_t segment_size);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/memdev.c b/bsd/dev/memdev.c
