+/* 30sa1: PAR_EL1 for a kernel VA from AT S1E1R, interrupts off so PAR_EL1 is still ours (SnapAdreno mappingAttribute, MIT) */
+static uint64_t
+anatPar(const void * va)
+{
+	uint64_t par;
+	boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+
+	__asm__ volatile ("at s1e1r, %1\n\tisb\n\tmrs %0, par_el1" : "=r" (par) : "r" (va) : "memory");
+	ml_set_interrupts_enabled(enabled);
+	return par;
+}
+
+/* 30sa1: PAR_EL1.ATTR (MAIR encoding, outer << 4 | inner) by kind; write-back as SnapAdreno's attrWriteBack (MIT) */
+static const char *
+anatKind(uint64_t par)
+{
+	unsigned attr = (unsigned) (par >> 56), in = attr & 15, out = (attr >> 4) & 15;
+
+	if (par & 1) {
+		return "fault";
+	}
+	if (out == 0) {
+		return "Dev";
+	}
+	if ((in & 4) && (in & 3) && (out & 4) && (out & 3)) {
+		return "WB";
+	}
+	if (in == 4 && out == 4) {
+		return "NC";
+	}
+	return "other";
+}
