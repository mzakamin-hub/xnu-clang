diff --git a/iokit/Kernel/HakiosIcelandThermalLevel.cpp b/iokit/Kernel/HakiosIcelandThermalLevel.cpp
new file mode 100755
index 0000000000000000000000000000000000000000..a0b2a6acbad4f0731d5a2a81b18b5915f1cca881
--- /dev/null
+++ b/iokit/Kernel/HakiosIcelandThermalLevel.cpp
@@ -0,0 +1,271 @@
+/*
+ * iceland w3-power, boot-arg thermal-level=1 (macOS, needs the governor: icecpu=5): the CPU temperatures as macOS's thermal
+ * pressure level.
+ *
+ * Without it macOS has no thermal input on the Pad: the level stays nominal while the governor lowers the clusters at 90 C.
+ * thermalmonitord (26C5035r) does not compute a level: it opens IOServiceMatching("AppleSMCSensorDispatcher") with type 0, asks
+ * selector 0 (one scalar out: the number of keys) and selector 1 (60 bytes: fifteen 32-bit key codes, the first character in the
+ * top byte), then once a second selector 2 (60 bytes: the values in the order of the codes), and posts the value of key 'mTPL'
+ * as kOSThermalNotificationPressureLevelName (com.apple.system.thermalpressurelevel) when it changes: 0 nominal, 1 moderate,
+ * 2 heavy, 3 trapping, 4 sleeping. Selector 3 (88 bytes in) is a write request with no caller in this build. The user client
+ * refuses a task without the boolean entitlement com.apple.private.smcsensor.user-access, as Apple's does. Those are the facts
+ * lenzhang's UniXNU-sheng found and wrote down (github.com/lenzhang/UniXNU-sheng 6880068 package/ThermalLevel.h:6-25,
+ * BSD-2-Clause-Patent); this file follows its design (package/ThermalLevel.cpp: the service and the user client with Apple's
+ * class names, selectors 0-3, the level from trip points with hysteresis) and is written here.
+ *
+ * Apple's class lives in com.apple.driver.AppleSMC, which is not in this kernel's collection (only ApplePMGR of that family), so
+ * the names are free; the classes are always registered and the service is published only with thermal-level=1. AppleSMC itself
+ * is not published: thermalmonitord logs that it cannot reach the SMC for its other keys and goes on (sheng's finding).
+ *
+ * The level: the hottest CPU sensor of each domain from the governor's 100 ms check (bsd/dev/hakios_iceland_cpu.c,
+ * hakios_iceland_cpu_temp_deci: tsens1 / tsens3 as Linux's DT names them) and, as a third input, the hottest of the rest of
+ * the SoC (hakios_iceland_tsens_soc_deci: the cache, QMX, NSP, GPU, DDR, modem, camera and video sensors, tsens0 / 2 / 4 / 5 /
+ * 6, read with icetsens / icecpu_trips / icegpu_thermal / thermal-level). An input's level is the number of trips it crossed,
+ * moderate at 90 C, heavy at 95 C, trapping at 110 C (sheng's CPU trips; the governor starts lowering the cap at 90 C), each
+ * kept until the reading is 2 C (1 C for the last) below it; the level is the highest of the three. A fourth input, the shell
+ * level (hakios_iceland_shell_level: the battery gauge's temperature now, its own 41 / 45 / 51 C trips in
+ * bsd/dev/hakios_iceland_cpu.c), counts as it is. An input without a reading counts as nominal. Computed at most twice a
+ * second (the daemon asks once a second). Lines "icethermal: ...": the publish, the first open, every change of level (at
+ * most 100), refused opens.
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+extern "C" {
+int32_t hakios_iceland_cpu_temp_deci(unsigned domain);   /* tenths of a degree; -1000: no reading */
+int32_t hakios_iceland_tsens_soc_deci(void);             /* ... the rest of the SoC (tsens0/2/4/5/6); -1000: no reading */
+uint32_t hakios_iceland_shell_level(void);               /* 0..3 = nominal..trapping; 0 without a reading */
+uint32_t hakios_iceland_thermal_arg(const char *name, uint32_t bundle);   /* w5-thermal: icethermal=1's bundle */
+int hakios_iceland_thermal_level_publish(void);
+}
+
+namespace {
+constexpr unsigned kSlots = 15, kArrayBytes = 4 * kSlots, kWriteBytes = 88, kSelectors = 4;
+constexpr uint32_t kKeyMTPL = 0x6d54504cu;              /* 'mTPL' */
+constexpr const char *kEntitlement = "com.apple.private.smcsensor.user-access";
+constexpr int32_t kTripDeci[3] = {900, 950, 1100}, kHystDeci[3] = {20, 20, 10};
+constexpr unsigned kInputs = 3;         /* the two CPU domains and the rest of the SoC */
+const char *const kLevelName[5] = {"nominal", "moderate", "heavy", "trapping", "sleeping"};
+
+IOLock *gLock;
+uint8_t gCrossed[kInputs], gLevel;
+uint64_t gLastAbs, gMinAbs;
+uint32_t gChanges, gOpens, gRefused, gReads, gWrites, gUnsupported;
+
+/* with gLock held */
+unsigned
+currentLevel()
+{
+	const uint64_t now = mach_absolute_time();
+
+	if (gLastAbs != 0 && now - gLastAbs < gMinAbs) {
+		return gLevel;
+	}
+	gLastAbs = now;
+	int32_t deci[kInputs];
+	unsigned level = 0;
+
+	for (unsigned d = 0; d < kInputs; d++) {
+		deci[d] = d < 2 ? hakios_iceland_cpu_temp_deci(d) : hakios_iceland_tsens_soc_deci();
+		unsigned crossed = 0;
+
+		if (deci[d] > -1000) {
+			for (unsigned t = 0; t < 3; t++) {
+				const int32_t at = gCrossed[d] > t ? kTripDeci[t] - kHystDeci[t] : kTripDeci[t];
+
+				if (deci[d] < at) {
+					break;
+				}
+				crossed = t + 1;
+			}
+		}
+		gCrossed[d] = (uint8_t)crossed;
+		level = crossed > level ? crossed : level;
+	}
+	const uint32_t shell = hakios_iceland_shell_level();      /* the fourth input: its own level, as it is */
+
+	level = shell > level ? shell : level;
+	if (level != gLevel) {
+		const int32_t soc = deci[kInputs - 1] > -1000 ? deci[kInputs - 1] : 0;   /* (0.0 when there is no reading) */
+
+		if (gChanges++ < 100) {
+			IOLog("icethermal: level %u (%s) from %u (d0 %d.%d C, d1 %d.%d C, soc %d.%d C, shell level %u)\n", level,
+			    kLevelName[level], gLevel, deci[0] / 10, deci[0] < 0 ? 0 : deci[0] % 10, deci[1] / 10,
+			    deci[1] < 0 ? 0 : deci[1] % 10, soc / 10, soc < 0 ? 0 : soc % 10, shell);
+		}
+		gLevel = (uint8_t)level;
+	}
+	return level;
+}
+}  // namespace
+
+class AppleSMCSensorDispatcher : public IOService {
+	OSDeclareDefaultStructors(AppleSMCSensorDispatcher)
+};
+OSDefineMetaClassAndStructors(AppleSMCSensorDispatcher, IOService)
+
+class AppleSMCSensorDispatcherUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleSMCSensorDispatcherUserClient)
+
+	static IOReturn
+	sCount(OSObject *, void *, IOExternalMethodArguments *args)
+	{
+		args->scalarOutput[0] = 1;              /* one key: mTPL */
+		return kIOReturnSuccess;
+	}
+	static IOReturn
+	sKeys(OSObject *, void *, IOExternalMethodArguments *args)
+	{
+		uint32_t keys[kSlots] = {};
+
+		if (args->structureOutput == nullptr) {
+			return kIOReturnBadArgument;
+		}
+		keys[0] = kKeyMTPL;
+		memcpy(args->structureOutput, keys, sizeof(keys));
+		return kIOReturnSuccess;
+	}
+	static IOReturn
+	sValues(OSObject *, void *, IOExternalMethodArguments *args)
+	{
+		uint32_t values[kSlots] = {};
+
+		if (args->structureOutput == nullptr) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gLock);
+		values[0] = currentLevel();
+		gReads++;
+		IOLockUnlock(gLock);
+		memcpy(args->structureOutput, values, sizeof(values));
+		return kIOReturnSuccess;
+	}
+	/* Apple's writes the request's keys to the SMC; there is none: counted and dropped (a count above five pairs is refused) */
+	static IOReturn
+	sWrite(OSObject *, void *, IOExternalMethodArguments *args)
+	{
+		if (args->structureInput == nullptr) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gLock);
+		gWrites++;
+		IOLockUnlock(gLock);
+		return static_cast<const uint8_t *>(args->structureInput)[0] <= 5 ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+
+public:
+	bool
+	initWithTask(task_t task, void *security, UInt32 type) override
+	{
+		OSObject *entitlement = copyClientEntitlement(task, kEntitlement);
+		const bool entitled = entitlement == kOSBooleanTrue;
+
+		OSSafeReleaseNULL(entitlement);
+		if (!entitled) {
+			IOLockLock(gLock);
+			const uint32_t refused = ++gRefused;
+			IOLockUnlock(gLock);
+			if (refused <= 10) {
+				IOLog("icethermal: an open without %s refused (%u so far)\n", kEntitlement, refused);
+			}
+			return false;
+		}
+		return IOUserClient::initWithTask(task, security, type);
+	}
+	bool
+	start(IOService *provider) override
+	{
+		if (OSDynamicCast(AppleSMCSensorDispatcher, provider) == nullptr || !IOUserClient::start(provider)) {
+			return false;
+		}
+		setProperty(kIOUserClientDefaultLockingKey, kOSBooleanTrue);    /* one external method at a time, as Apple's */
+		IOLockLock(gLock);
+		const uint32_t opens = ++gOpens;
+		const unsigned level = currentLevel();
+		IOLockUnlock(gLock);
+		if (opens <= 3) {
+			IOLog("icethermal: opened (%u): level %u (%s)\n", opens, level, kLevelName[level]);
+		}
+		return true;
+	}
+	IOReturn
+	clientClose() override
+	{
+		terminate();
+		return kIOReturnSuccess;
+	}
+	IOReturn
+	externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *, OSObject *, void *) override
+	{
+		/* selectors 0 to 3 of Apple's table: the scalar counts and structure sizes IOUserClient::externalMethod checks */
+		static const IOExternalMethodDispatch methods[kSelectors] = {
+			{&AppleSMCSensorDispatcherUserClient::sCount, 0, 0, 1, 0},
+			{&AppleSMCSensorDispatcherUserClient::sKeys, 0, 0, 0, kArrayBytes},
+			{&AppleSMCSensorDispatcherUserClient::sValues, 0, 0, 0, kArrayBytes},
+			{&AppleSMCSensorDispatcherUserClient::sWrite, 0, kWriteBytes, 0, 0},
+		};
+
+		if (selector >= kSelectors) {
+			IOLockLock(gLock);
+			gUnsupported++;
+			IOLockUnlock(gLock);
+			return kIOReturnUnsupported;
+		}
+		return IOUserClient::externalMethod(selector, args, const_cast<IOExternalMethodDispatch *>(&methods[selector]), this, nullptr);
+	}
+};
+OSDefineMetaClassAndStructors(AppleSMCSensorDispatcherUserClient, IOUserClient)
+
+/* from the governor's thread once it has temperatures; 1 published, 0 not asked (no thermal-level=1), < 0 failed */
+int
+hakios_iceland_thermal_level_publish(void)
+{
+	static bool done;
+	unsigned mode;
+
+	/* w5-thermal: thermal-level's own boot-arg, or the icethermal=1 bundle (thermal-level=0 still turns it off) */
+	mode = hakios_iceland_thermal_arg("thermal-level", 1);
+	if (done || mode != 1) {
+		return 0;
+	}
+	done = true;
+	IOService *platform = IOService::getPlatform();
+
+	gLock = IOLockAlloc();
+	nanoseconds_to_absolutetime(500 * NSEC_PER_MSEC, &gMinAbs);
+	AppleSMCSensorDispatcher *service = OSTypeAlloc(AppleSMCSensorDispatcher);
+
+	if (gLock == nullptr || platform == nullptr || service == nullptr || !service->init()) {
+		OSSafeReleaseNULL(service);
+		IOLog("icethermal: thermal-level=1: not published (no lock, platform or service)\n");
+		return -1;
+	}
+	service->setProperty("IOUserClientClass", "AppleSMCSensorDispatcherUserClient");
+	if (!service->attach(platform)) {
+		service->release();
+		IOLog("icethermal: thermal-level=1: not published (attach)\n");
+		return -2;
+	}
+	if (!service->start(platform)) {
+		service->detach(platform);
+		service->release();
+		IOLog("icethermal: thermal-level=1: not published (start)\n");
+		return -3;
+	}
+	service->registerService();
+	IOLockLock(gLock);
+	const unsigned level = currentLevel();
+	IOLockUnlock(gLock);
+	IOLog("icethermal: AppleSMCSensorDispatcher published (thermalmonitord's mTPL): level %u (%s); moderate / heavy / trapping at "
+	    "90 / 95 / 110 C\n", level, kLevelName[level]);
+	service->release();                     /* the platform's attachment keeps it */
+	return 1;
+}
+#endif /* XNU_TARGET_OS_OSX */
