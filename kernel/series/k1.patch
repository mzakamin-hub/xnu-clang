+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * hakios_iceland_ath12k.c - run the Linux ath12k driver (ath12k.o, UniXNU Ath12kWifi) on the WCN7860.
+ *
+ * This is the (B) route for Wi-Fi: instead of the hand-written datapath in hakios_iceland_harvest.c, the real Linux
+ * driver (with its own MHI / QMI / WMI / datapath, compiled by tools/mk-ath12k.sh) runs. Its tx completions, TKIP group
+ * cipher and broadcast handling are correct by construction.
+ *
+ * The boundary is nw_abi.h (struct lx_platform + struct nw_board + the nw_wifi_* calls); the structs are re-declared
+ * here, exactly as hakios_dada_wifi.c does, so this file does not need the ath12k build tree's header.
+ *
+ * Gated on boot-arg icepcie_lx=1. It reuses the harvest driver's PCIe bring-up through the getters iceland_ath12k_*
+ * (exported at the end of hakios_iceland_harvest.c): the endpoint BAR, the config space, the MSI sink, a DMA arena
+ * below 4 GB, and the firmware files in md1 fw/ (ath12k_*.bin). The ath12k driver's own MHI/QMI then does
+ * BHI/BHIe -> FW_READY -> WLAN_CFG/MISSION -> CE/WMI -> the 802.11 station.
+ */
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <mach/mach_types.h>
+#include <kern/thread.h>
+#include <kern/kalloc.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <vm/vm_kern.h>
+#include <vm/memory_types.h>
+#include <pexpert/pexpert.h>
+#include <stdarg.h>
+
+/*
+ * ---- 46cn4e (kernel scan239): the Wi-Fi log buffer. 46cn4a's 8 MB kernel ring kept only 160-300 s (userland os_log and a
+ * DMA-out flood overwrote the bring-up). Every line this file prints and harvest.c's icepcie / icewifi lines
+ * (hakios_iceland_wifilog_add) are also kept here, with a ms time: the first 2 MB as they come, then the last 1 MB in a
+ * ring. Dumped as "icewifi-log:" lines at the first SYS_ERR / RDDM and at 285 s (then only what came after the first
+ * dump), so the record is the newest thing in the kernel ring when the run ends.
+ */
+#define WL_HEAD (2u << 20)
+#define WL_TAIL (1u << 20)
+#if defined(XNU_TARGET_OS_OSX)
+/*
+ * (macOS: never allocated. The prelinked collection's __DATA has no room for 3 MB of log, and the driver cannot
+ * start here at all (hakios_iceland_ath12k_init() returns), so these stay NULL and the record writes nothing.)
+ */
+static char *wl_head, *wl_tail;
+#else
+static char wl_head[WL_HEAD], wl_tail[WL_TAIL];
+#endif
+static uint64_t wl_total, wl_dumped;
+static uint32_t wl_head_len;
+static volatile uint32_t wl_lock;
+void hakios_iceland_wifilog_add(const char *line);
+
+static void
+wl_add_raw(const char *p, size_t n)
+{
+#if defined(XNU_TARGET_OS_OSX)
+	if (wl_head == NULL) {
+		return;
+	}
+#endif
+	while (!__sync_bool_compare_and_swap(&wl_lock, 0, 1)) {
+	}
+	if (wl_total == wl_head_len && wl_head_len + n <= WL_HEAD) {
+		memcpy(wl_head + wl_head_len, p, n);
+		wl_head_len += (uint32_t)n;
+	} else {
+		for (size_t i = 0; i < n; i++) {
+			wl_tail[(wl_total + i - wl_head_len) % WL_TAIL] = p[i];
+		}
+	}
+	wl_total += n;
+	__sync_lock_release(&wl_lock);
+}
+
+void
+hakios_iceland_wifilog_add(const char *line)
+{
+	char b[1100];
+	uint64_t ns;
+	int n;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	n = snprintf(b, sizeof(b), "[%llu.%03llu] %s", ns / 1000000000ull, (ns / 1000000ull) % 1000ull, line);
+	if (n <= 0) {
+		return;
+	}
+	if (n > (int)sizeof(b) - 2) {
+		n = (int)sizeof(b) - 2;
+	}
+	if (b[n - 1] != '\n') {
+		b[n++] = '\n';
+	}
+	wl_add_raw(b, (size_t)n);
+}
+
+static int om_printf(const char *fmt, ...) __printflike(1, 2);
+static int
+om_printf(const char *fmt, ...)
+{
+	char b[1024];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(b, sizeof(b), fmt, ap);
+	va_end(ap);
+	printf("%s", b);
+	hakios_iceland_wifilog_add(b);
+	return 0;
+}
+#define printf(...) om_printf(__VA_ARGS__)
+static uint64_t lx_now_ms(void);
+
+/* the record as "icewifi-log:" lines, from global byte index lo (the real printf: not kept again) */
+static void
+wl_dump(const char *why)
+{
+	char line[1200];
+	uint64_t lo = wl_dumped, total, tail0;
+	uint32_t ln = 0;
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (wl_head == NULL) {
+		return;
+	}
+#endif
+	while (!__sync_bool_compare_and_swap(&wl_lock, 0, 1)) {
+	}
+	total = wl_total;
+	__sync_lock_release(&wl_lock);
+	tail0 = total > wl_head_len + WL_TAIL ? total - WL_TAIL : wl_head_len;
+	(printf)("icewifi-log: ==== Wi-Fi record (%s): bytes %llu..%llu of %llu (first %u B kept whole, last %u B in a ring; %llu B "
+	    "dropped between) ====\n", why, lo, total, total, wl_head_len, WL_TAIL, tail0 > wl_head_len ? tail0 - wl_head_len : 0ull);
+	for (uint64_t i = lo; i < total; i++) {
+		char c;
+
+		if (i >= wl_head_len && i < tail0) {
+			if (ln) {
+				line[ln] = 0;
+				(printf)("icewifi-log: %s\n", line);
+				ln = 0;
+			}
+			(printf)("icewifi-log: ==== %llu B not kept ====\n", tail0 - i);
+			i = tail0;
+			/* the first line in the ring may be cut: skip to its end */
+			while (i < total && wl_tail[(i - wl_head_len) % WL_TAIL] != '\n') {
+				i++;
+			}
+			continue;
+		}
+		c = i < wl_head_len ? wl_head[i] : wl_tail[(i - wl_head_len) % WL_TAIL];
+		if (c == '\n' || ln >= sizeof(line) - 2) {
+			line[ln] = 0;
+			(printf)("icewifi-log: %s\n", line);
+			ln = 0;
+			continue;
+		}
+		line[ln++] = c;
+	}
+	if (ln) {
+		line[ln] = 0;
+		(printf)("icewifi-log: %s\n", line);
+	}
+	(printf)("icewifi-log: ==== end of the Wi-Fi record (%s) ====\n", why);
+	wl_dumped = total;
+}
+
+/* these two are not visible under the kernel's current feature set: declare them as the harvest driver does */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void IOSleep(unsigned int milliseconds);
+
+/* ---- the harvest driver's primitives (exported from hakios_iceland_harvest.c) ---- */
+extern vm_offset_t iceland_ath12k_bar;      /* the endpoint's MHI BAR, mapped */
+extern vm_offset_t iceland_ath12k_conf;     /* the endpoint's config space, mapped */
+extern uint64_t iceland_ath12k_dma_pa;      /* the DMA arena's bus base (below 4 GB) */
+extern vm_offset_t iceland_ath12k_dma_va;   /* the DMA arena's mapping */
+extern uint32_t iceland_ath12k_dma_size;    /* the DMA arena's length */
+extern uint64_t iceland_ath12k_msi;         /* the MSI sink the chip writes to raise vector 0 */
+extern const uint8_t *iceland_ath12k_fw(const char *name, uint32_t *len);  /* a firmware file from md1 fw/, or NULL */
+
+/* ---- the nw_abi.h boundary, re-declared (as hakios_dada_wifi.c does) ---- */
+/*
+ * The pointers this file hands to the driver object. ath12k.o is compiled without
+ * -fptrauth-function-pointer-type-discrimination (tools/mk-ath12k.sh:741-743) and calls them with blraaz: IA key,
+ * discriminator 0. The macOS kernel is compiled with that flag (base/xnu-clang-ld956:25-29), so a plain function
+ * pointer field here would be signed with its type's discriminator and the driver's first call through one fails
+ * authentication (run wifi-1/20261115-043859: "PAC failure from kernel with IA key while branching to x8" in
+ * pci_register_driver + 0x90, the call of nw_board.cfg_read). The qualifier makes every store and every static
+ * initialiser of these fields sign as the driver expects. iOS: no qualifier, as before.
+ */
+#if defined(XNU_TARGET_OS_OSX) && __has_feature(ptrauth_calls)
+#include <ptrauth.h>
+#define NW_FP __ptrauth(ptrauth_key_function_pointer, 0, 0)
+#else
+#define NW_FP
+#endif
+struct lx_platform {
+	uint64_t (*NW_FP now_ms)(void);
+	void (*NW_FP sleep_ms)(unsigned int ms);
+	void (*NW_FP poll)(void);
+	void (*NW_FP log)(int level, const char *line);
+	void (*NW_FP halt)(void);
+	void *(*NW_FP alloc)(size_t n);
+	void (*NW_FP free)(void *p);
+	void *(*NW_FP dma_alloc)(size_t n, uint64_t *bus);
+	void (*NW_FP dma_free)(size_t n, void *p, uint64_t bus);
+	uint64_t (*NW_FP dma_map)(void *p, size_t n, int dir);
+	void (*NW_FP dma_sync)(uint64_t bus, size_t n, int dir);
+	int (*NW_FP fw_get)(const char *name, const uint8_t **data, size_t *size);
+};
+struct nw_board {
+	void *bar;
+	size_t bar_len;
+	uint16_t device_id, msi_cap;
+	int irq_base;
+	int (*NW_FP cfg_read)(int off, int size, uint32_t *v);
+	int (*NW_FP cfg_write)(int off, int size, uint32_t v);
+	int (*NW_FP msi_target)(uint32_t *lo, uint32_t *hi, uint32_t *data);
+	void *(*NW_FP map_phys)(uint64_t pa, size_t n);
+};
+struct nw_wifi_stats { uint32_t stage, scans, frames, beacons, bss_seen; int last_err; };
+
+/* weak: a kernel built without ath12k.o still links; driver() finds nw_wifi_start NULL and says so */
+extern struct nw_wifi_stats nw_wifi_stats __attribute__((weak));
+extern volatile uint64_t nw_wifi_where[4] __attribute__((weak));
+extern int nw_wifi_start(const struct lx_platform *p, const struct nw_board *b) __attribute__((weak));
+extern int nw_wifi_step(void) __attribute__((weak));
+extern void nw_wifi_stop(void) __attribute__((weak));
+
+/* ---- kit K2 (boot-arg icewifi_ios=1): en0 / Apple80211 / the station for iPadOS (hakios_iceland_wlan.c) ---- */
+extern bool hakios_iceland_wlan_owns(void);
+extern bool hakios_iceland_wlan_fw_mac(const uint8_t **data, size_t *size);
+extern void hakios_iceland_wlan_early(void);
+extern void hakios_iceland_wlan_events(void);
