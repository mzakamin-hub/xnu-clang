+/* 23f2 (icespmi=3): bt-enable inside 23c2's power-up; resolved and written by the SPMI code further down */
+static bool f2_ready;
+static void f2_bt(void);
+static bool hr_on;                      /* scan40 23bt3: the BT controller is resident (nothing of its power-up put back) */
+
+/* 34ux2: one readback of a WCN buck through 34ux1's SPMI observer channel (reads only) */
+static void
+ux2_rb(const char *rail, int k, const char *when)
+{
+	const uint8_t *v = u1_p[k].v;
+
+	if (!u1_read_p(k)) {
+		say("icewifi: 34ux2 readback %s %s: no SPMI read (%s)\n", rail, when, u1_p[k].ok ? "the read was not done" :
+		    "no observer channel for this buck");
+		return;
+	}
+	say("icewifi: 34ux2 readback %s %s: STATUS1 %02x (VREG_OK %u) STATUS2-4 %02x %02x %02x RT_STS %02x VSET %u mV "
+	    "(0x40 %02x 0x41 %02x) MODE 0x45 %02x EN_CTL 0x46 %02x (enabled %u)\n", rail, when, v[0], v[0] >> 7, v[1], v[2],
+	    v[3], v[4], (uint32_t)v[6] << 8 | v[5], v[5], v[6], v[10], v[11], v[11] >> 7);
+}
+
+/*
+ * 34ux2: the four WCN bucks, the wcn7860-pmu consumer's voltage request (none: 0) and the DT range of this tablet's
+ * regulators (vreg_s1j_0p8, vreg_s2j_0p8, vreg_s7f_1p2, vreg_s8f_1p8); u1 = the buck's u1_p index
+ */
+#define UX2_N   4
+static const struct {
+	const char *name;
+	int u1;
+	uint32_t req_uv, min_uv, max_uv;
+} ux2_r[UX2_N] = {
+	{ "S1J_E1", 0, 0, 400000, 1000000 }, { "S2J_E1", 1, 0, 500000, 1100000 },
+	{ "S7F_E0", 2, 0, 1224000, 1372000 }, { "S8F_E0", 3, 0, 1800000, 2000000 },
+};
+static bool ux2_voted[UX2_N];
+
+/* 34ux2: the voltage votes released (VOLTAGE 0) in reverse, only when the enables' undo releases (icewifi_release=1) */
+static void
+ux2_release(int release, const char *why)
+{
+	bool any = false;
+
+	for (int q = UX2_N - 1; q >= 0; q--) {
+		any |= ux2_voted[q];
+	}
+	if (!any) {
+		return;
+	}
+	if (!release) {
+		say("icewifi: 34ux2 at %s: the voltage votes stay, as the enables (icewifi_release=1 releases them)\n", why);
+		return;
+	}
+	for (int q = UX2_N - 1; q >= 0; q--) {
+		if (ux2_voted[q]) {
+			int r = hakios_iceland_rpmh_volt(ux2_r[q].name, 0);
+			say("icewifi: 34ux2 release %s VOLTAGE -> %d (at %s)\n", ux2_r[q].name, r, why);
+			ux2_voted[q] = false;
+			ux2_rb(ux2_r[q].name, ux2_r[q].u1, "after the release");
+		}
+	}
+}
