+/*
+ * The bus cleared (I2C-bus spec 3.1.16, Linux's i2c_generic_scl_recovery): SDA released, 9 SCL pulses (a slave that
+ * was left inside a byte -- e.g. by the pad mux glitch when the pins went back to the serial engine and came back to
+ * GPIO -- shifts it out and lets SDA go), then a STOP (SDA low while SCL is low, SCL up, SDA up). No slave register is
+ * written: 9 clocks with SDA high can only complete an address byte 0x7f/0xff, which no amplifier answers.
+ */
+static uint32_t amp_clear_on = 1;      /* boot-arg iceamp_clear=0: no bus clear (the retries stay) */
+
+static void
+amp_bus_clear(void)
+{
+	if (!amp_clear_on) {
+		return;
+	}
+	amp_release(amp_sda);
+	amp_wait();
+	for (int i = 0; i < 9; i++) {
+		amp_low(amp_scl);
+		amp_wait();
+		(void)amp_scl_high();
+	}
+	amp_low(amp_scl);
+	amp_wait();
+	amp_stop();
+}
