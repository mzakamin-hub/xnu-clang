+static bool
+cam_wait(vm_offset_t a, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t t = 0; t <= us; t += 10) {
+		if ((rd(a) & mask) == want) {
+			return true;
+		}
+		wait_us(10);
+	}
+	return (rd(a) & mask) == want;
+}
+
+/* a store that is named in the log: the value before, the value written, the read-back */
+static void
+cwl(const char *name, vm_offset_t base, uint32_t off, uint32_t v)
+{
+	uint32_t was = rd(base + off);
+
+	wr(base + off, v);
+	cam.writes++;
+	if (!cam.quiet) {
+		say("w %s +%#x: %#x > %#x = %#x\n", name, off, was, v, rd(base + off));
+	}
+}
+
+/* a store that is only counted (the PHY's list, the CSID's and the write master's per-frame registers) */
+static inline void
+cw(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	wr(base + off, v);
+	cam.writes++;
+}
