+	    "each\n", fHkChecks, gGpuRotChk, HK3_POINTS, fHkClean, fHkBad, fHkMoving, fHkUnwritten, fHkWrong, fHkWorst, fHkEdge[0],
+	    fHkEdge[1], fHkEdge[2], fHkEdge[3], gGpuRotClean, fHkCleaned, cleanUs / 1000);
