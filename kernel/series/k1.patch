+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: chip window +3278 <- %08x (read back %08x)\n", 0x40000000u | w, io_rd(e2_bar1m, 0x3278));
+		e2_window = w;
+	}
+}
+
+static uint32_t
+e2_rd(uint32_t off)
+{
+	if (off < 0x80000) {
+		return io_rd(e2_bar1m, off);
+	}
+	e2_win(off);
+	return io_rd(e2_bar1m, 0x80000 + (off & 0x7ffff));
+}
+
+static void
+e2_wr(const char *name, uint32_t off, uint32_t val)
+{
+	vm_offset_t a;
+
+	if (off < 0x80000) {
+		a = e2_bar1m + off;
+	} else {
+		e2_win(off);
+		a = e2_bar1m + 0x80000 + (off & 0x7ffff);
+	}
+	*(volatile uint32_t *)a = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icepcie: chip %s %#x <- %08x (read back %08x)\n", name, off, val, e2_rd(off));
+}
+
+/* 23e2e: MHI state after each step of the sw reset (reads only) */
+static void
+e2_mhilog(const char *when)
+{
+	say("icepcie: 23e2e: %s: MHISTATUS %08x MHICTRL %08x\n", when, e2_rd(0x48), e2_rd(0x38));
+}
+
+/*
+ * 23e2e: as mhi_async_power_up: BHI_INTVEC = 0; on SYS_ERR MHICTRL |= RESET; RESET polled every 25 ms for up to ms;
+ * INTVEC = 0 again once it cleared. true = RESET clear and the state is not SYS_ERR.
+ */
+static bool
+e2_mhi_reset_wait(const char *tag, int ms)
+{
+	uint32_t bhi = e2_rd(0x28), st = 0, ctl = 0, ee = 0, lst = ~0u, lctl = ~0u, lee = ~0u;
+	int t;
+	bool ok;
+
+	if (bhi == 0 || bhi >= 0x1f00 || (bhi & 3)) {
+		say("icepcie: %s: BHIOFF %08x not plausible: stopping\n", tag, bhi);
+		return false;
+	}
+	e2_wr("BHI_INTVEC (mhi_async_power_up)", bhi + 0x20, 0);
+	st = e2_rd(0x48);
+	if (st == 0xffffffffu) {
+		say("icepcie: %s: MHISTATUS reads 0xffffffff (no answer): stopping\n", tag);
+		return false;
+	}
+	if (((st >> 8) & 0xff) == 0xff) {
+		e2_wr("MHICTRL (reset: state SYS_ERR, mhi_async_power_up)", 0x38, e2_rd(0x38) | 2u);
+	}
+	for (t = 0; t <= ms; t += 25) {
+		st = e2_rd(0x48);
+		ctl = e2_rd(0x38);
+		ee = e2_rd(bhi + 0x28);
+		if (st != lst || ctl != lctl || ee != lee) {
+			say("icepcie: %s: +%d ms MHISTATUS %08x (ready %u, syserr %u, state %#x) MHICTRL %08x EXECENV %08x\n", tag, t,
+			    st, st & 1, (st >> 2) & 1, (st >> 8) & 0xff, ctl, ee);
+			lst = st;
+			lctl = ctl;
+			lee = ee;
+		}
+		if (st == 0xffffffffu) {
+			say("icepcie: %s: the chip stopped answering: stopping\n", tag);
+			return false;
+		}
+		if (!(ctl & 2u)) {
+			break;
+		}
+		IOSleep(25);
+	}
+	ok = !(ctl & 2u) && ((st >> 8) & 0xff) != 0xff;
+	say("icepcie: %s: MHI RESET %s after ~%d ms: MHISTATUS %08x MHICTRL %08x EXECENV %08x MHIVER %08x\n", tag,
+	    ok ? "CLEARED" : "NOT cleared", t, e2_rd(0x48), e2_rd(0x38), e2_rd(bhi + 0x28), e2_rd(0x8));
+	if (ok) {
+		e2_wr("BHI_INTVEC (after RESET)", bhi + 0x20, 0);
+	}
+	return ok;
+}
+
+/*
+ * 23e2e: the generic MHI SoC reset (Linux mhi_soc_reset: MHI_SOC_RESET_REQ_OFFSET 0xb0 = MHI_SOC_RESET_REQ, read back).
+ * The endpoint's config space is watched for 2 s (mhi_pci_reset_prepare waits, then mhi_pci_reset_done restores the
+ * saved config state): BAR0 / BAR1 / COMMAND put back as found before the reset if they were cleared (23e1's writes);
+ * no MMIO read while BAR0 is not set. Refused (false) if the device ID no longer reads 17cb:110e (link down).
+ */
+static vm_offset_t e2_cfg;
+
+static bool
+e2_soc_reset(void)
+{
+	uint32_t id, b0, b1, cmd, lid = ~0u, lb0 = ~0u, lcmd = ~0u, fb0, fb1, fcmd;
+	int t;
+
+	if (e2_cfg == 0) {
+		return false;
+	}
+	fb0 = io_rd(e2_cfg, 0x10);
+	fb1 = io_rd(e2_cfg, 0x14);
+	fcmd = io_rd(e2_cfg, 0x04) & 0xffffu;
+	say("icepcie: 23e2e: MHI SoC reset (mhi_soc_reset): before: id %08x BAR0 %08x BAR1 %08x COMMAND %04x MHISTATUS %08x\n",
+	    io_rd(e2_cfg, 0), fb0, fb1, fcmd, e2_rd(0x48));
+	*(volatile uint32_t *)(e2_bar1m + 0xb0) = 1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icepcie: chip MHI_SOC_RESET_REQ 0xb0 <- 00000001 (read back %08x)\n", io_rd(e2_bar1m, 0xb0));
+	e2_window = ~0u;
+	for (t = 0; t <= 2000; t += 25) {
+		id = io_rd(e2_cfg, 0);
+		b0 = io_rd(e2_cfg, 0x10);
+		cmd = io_rd(e2_cfg, 0x04);
+		if (id != lid || b0 != lb0 || cmd != lcmd) {
+			say("icepcie: 23e2e: +%d ms config id %08x BAR0 %08x COMMAND %08x%s\n", t, id, b0, cmd,
+			    (id == 0x110e17cbu && b0 == fb0 && (cmd & 2u)) ? "" : " (not as before the reset)");
+			lid = id;
+			lb0 = b0;
+			lcmd = cmd;
+		}
+		IOSleep(25);
+	}
+	if (id != 0x110e17cbu) {
+		say("icepcie: 23e2e: after the SoC reset the device ID reads %08x (link down?): stopping\n", id);
+		return false;
+	}
+	if (b0 != fb0 || io_rd(e2_cfg, 0x14) != fb1 || (io_rd(e2_cfg, 0x04) & 0xffffu) != fcmd) {
+		/* as pci_restore_state: BARs first, COMMAND last */
+		*(volatile uint32_t *)(e2_cfg + 0x10) = fb0;
+		*(volatile uint32_t *)(e2_cfg + 0x14) = fb1;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: ep cfg +010 <- %08x (read back %08x), +014 <- %08x (read back %08x)\n", fb0, io_rd(e2_cfg, 0x10), fb1,
+		    io_rd(e2_cfg, 0x14));
+		*(volatile uint32_t *)(e2_cfg + 0x04) = (io_rd(e2_cfg, 0x04) & ~0xffffu) | fcmd;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: ep cfg +004 <- COMMAND %04x (read back %08x)\n", fcmd, io_rd(e2_cfg, 0x04));
+		if (io_rd(e2_cfg, 0x10) != fb0 || (io_rd(e2_cfg, 0x04) & 0xffffu) != fcmd) {
+			say("icepcie: 23e2e: config space not put back: stopping\n");
+			return false;
+		}
+	}
+	say("icepcie: 23e2e: after the SoC reset: MHIVER %08x MHISTATUS %08x MHICTRL %08x BHIOFF %08x\n", e2_rd(0x8),
+	    e2_rd(0x48), e2_rd(0x38), e2_rd(0x28));
+	return e2_rd(0x48) != 0xffffffffu;
+}
+
+static bool
+e2_sw_reset(void)
+{
+	uint32_t v;
+	int i;
+
+	e2_bar1m = ml_io_map_unmappable(0x40400000u, 0x100000, VM_WIMG_IO);
+	if (e2_bar1m == 0) {
+		say("icepcie: 23e2b: BAR0 (1 MB) not mapped\n");
+		return false;
+	}
+	say("icepcie: 23e2b sw reset (ath12k_pci_sw_reset): before: LTSSM %08x HOT_RST %08x MHISTATUS %08x SOC_GLOBAL_RESET %08x "
+	    "Q6 cookie %08x warm entry %08x reset cause %08x\n", e2_rd(0x1e081b0), e2_rd(0x1e65304), e2_rd(0x48), e2_rd(0x3008),
+	    e2_rd(0x1f80500), e2_rd(0x1f80504), e2_rd(0x1f8060c));
+	for (i = 0; i < 5 && (v = e2_rd(0x1e081b0)) != 0x111; i++) {
+		if (v == 0xffffffffu) {
+			delay(5000);
+		}
+		e2_wr("PARF_LTSSM", 0x1e081b0, 0x111);
+	}
+	/* 23e2c: 23e2b read 0xffffffff here and wrote it back | 0x10 - never write a register that reads all-ones */
+	v = e2_rd(0x1e65304);
+	if (v != 0xffffffffu) {
+		e2_wr("GCC_PCIE_HOT_RST", 0x1e65304, v | 0x10u);
+	} else {
+		say("icepcie: 23e2c: GCC_PCIE_HOT_RST 0x1e65304 reads 0xffffffff (not this chip's register): not written\n");
+	}
+	delay(5000);
+	e2_wr("PCIE_INT_ALL_CLEAR", 0x1e08228, 0xffffffffu);
+	e2_wr("WLAON_QFPROM_PWR_CTRL", 0x1f8031c, e2_rd(0x1f8031c) & ~0x4u);
+	e2_mhilog("after LTSSM / INT_ALL_CLEAR / QFPROM_PWR_CTRL");
+	e2_wr("TXVECDB", 0x360, 0);
+	e2_wr("TXVECSTATUS", 0x368, 0);
+	e2_wr("RXVECDB", 0x394, 0);
+	e2_wr("RXVECSTATUS", 0x39c, 0);
+	delay(10000);
+	e2_wr("WLAON_WARM_SW_ENTRY", 0x1f80504, 0);
+	delay(10000);
+	e2_mhilog("after the MHI vectors / WARM_SW_ENTRY");
+	v = e2_rd(0x3008);
+	e2_wr("SOC_GLOBAL_RESET (set)", 0x3008, v | 1u);
+	delay(10000);
+	e2_wr("SOC_GLOBAL_RESET (clear)", 0x3008, v & ~1u);
+	delay(10000);
+	if (e2_rd(0x3008) == 0xffffffffu) {
+		say("icepcie: 23e2b: the chip reads 0xffffffff after its global reset: stopping\n");
+		return false;
+	}
+	e2_window = ~0u;        /* (ath12k restores its window after the reset) */
+	/*
+	 * 23e2c: 23e2b went to BHI at once and the chip was not alive (MHIVER 0xdeadbeef, MHISTATUS 0xff04 = SYSERR with
+	 * state 0xff, MHICTRL RESET never cleared). Linux mhi_async_power_up only starts BHI on a device whose MHI answers:
+	 * here the chip gets up to 3 s after its global reset for MHIVER to read a real version (not 0xdeadbeef /
+	 * 0xffffffff), then MHICTRL RESET (as ath12k_mhi_set_mhictrl_reset) and up to 1 s for RESET to clear and
+	 * MHISTATUS READY (bit 0); TCSR_SOC_HW_VERSION (0x1b00000) read for the record. Refused if MHI never answers.
+	 */
+	say("icepcie: 23e2c: TCSR_SOC_HW_VERSION %08x\n", e2_rd(0x01b00000));
+	/*
+	 * 23e2e (23e2d: MHISTATUS 0xff04 = SYSERR / state SYS_ERR after the global reset, MHICTRL RESET not cleared in 1 s;
+	 * at link-up and before the sw reset MHISTATUS read 0): Linux's order, no 3 s MHIVER wait any more -
+	 * ath12k_mhi_set_mhictrl_reset (MHISTATUS logged, MHICTRL = RESET, 10 ms) right after the global reset, then
+	 * mhi_async_power_up: BHI_INTVEC = 0, EXECENV read, and on SYS_ERR MHICTRL RESET again, polled every 25 ms for up
+	 * to timeout_ms (ath12k_mhi_start sets MHI_TIMEOUT_DEFAULT_MS = 90 s; here 10 s), then INTVEC = 0 again.
+	 * If RESET still does not clear: the generic MHI SoC reset (mhi_soc_reset: MHI_SOC_RESET_REQ_OFFSET 0xb0 = 1), up to
+	 * 2 s with the endpoint's config space checked first (a SoC reset may clear BAR0 / COMMAND: then put back as 23e1
+	 * set them, link down = stop), and on SYS_ERR once more MHICTRL RESET + 10 s. MHISTATUS / MHICTRL / EXECENV logged at
+	 * every change. BHI only if MHICTRL RESET is clear and the state is not SYS_ERR.
+	 */
+	say("icepcie: 23e2e: after the global reset: MHIVER %08x MHISTATUS %08x MHICTRL %08x BHIOFF %08x EXECENV %08x\n",
+	    e2_rd(0x8), e2_rd(0x48), e2_rd(0x38), e2_rd(0x28), e2_rd(e2_rd(0x28) + 0x28));
+	e2_wr("MHICTRL (reset, ath12k_mhi_set_mhictrl_reset)", 0x38, 0x2u);
+	delay(10000);
+	if (!e2_mhi_reset_wait("23e2e", 10000)) {
+		if (!e2_soc_reset()) {
+			return false;
+		}
+		if (!e2_mhi_reset_wait("23e2e after the SoC reset", 10000)) {
+			say("icepcie: 23e2e: MHI RESET did not clear after the SoC reset either: no BHI\n");
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * 23e2g (23e2f: MHI RESET cleared with bus master on, BHI STATUS 0xffffffff / ERRCODE 0xef120700 10 ms after the
+ * doorbell, no SMMU fault): the root port's own COMMAND had memory space only (23e1: 0x00100002) - bus master was set
+ * on the endpoint alone. A PCIe root port forwards upstream memory requests (the chip's DMA read of the image) only
+ * with its Bus Master Enable set; else they complete as Unsupported Request, the device never reaches the SMMU (no
+ * fault) and its PBL reports the transfer as failed. Linux: pci_enable_device -> pci_enable_bridge -> pci_set_master on
+ * every bridge above the device, before ath12k's own pci_set_master. Now set on both (the root port's DBI +0x4 bit 2,
+ * the same register 23e1 writes), off on both in every undo, endpoint first.
+ */
+static vm_offset_t e2_dbi;
+
+static void e2_devctl_log(const char *when);   /* 46cn2m22: DevCtl at link-up and at the fault, + root port link/LTSSM */
+
+static void
+e2_bm_on(vm_offset_t cfg, const char *why)
+{
+	if (e2_dbi != 0) {
+		*(volatile uint32_t *)(e2_dbi + 0x04) = io_rd(e2_dbi, 0x04) | 4u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: rp dbi +004 |= bus master (%s; read back %08x)\n", why, io_rd(e2_dbi, 0x04));
+	}
+	*(volatile uint32_t *)(cfg + 0x04) = io_rd(cfg, 0x04) | 4u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icepcie: ep cfg +004 |= bus master (%s; read back %08x)\n", why, io_rd(cfg, 0x04));
+	e2_devctl_log("at link-up");
+}
+
+/* bus master OFF (the first undo step, dada: before anything else is taken down) - endpoint, then the root port */
+static void
+e2_bm_off(vm_offset_t cfg)
+{
+	if (io_rd(cfg, 0x04) & 4u) {
+		*(volatile uint32_t *)(cfg + 0x04) = io_rd(cfg, 0x04) & ~4u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: ep cfg +004 bus master OFF (read back %08x)\n", io_rd(cfg, 0x04));
+	}
+	if (e2_dbi != 0 && (io_rd(e2_dbi, 0x04) & 4u)) {
+		*(volatile uint32_t *)(e2_dbi + 0x04) = io_rd(e2_dbi, 0x04) & ~4u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		say("icepcie: rp dbi +004 bus master OFF (read back %08x)\n", io_rd(e2_dbi, 0x04));
+	}
+}
+
+/*
+ * 23e2g: the link and both functions' error bits (reads only): endpoint ID / COMMAND+STATUS (bit 29 received master
+ * abort = its request got UR, bit 28 received target abort), root port COMMAND+STATUS, secondary status (+0x1c bits
+ * 31:16), link control / status (express cap 0x70 + 0x10), BHI ERRDBG1-3 (as mhi_fw_load_error_dump).
+ */
+static void
+e2_linkdiag(const char *when, vm_offset_t cfg, vm_offset_t bar, uint32_t bhi)
+{
+	uint32_t lnk = e2_dbi ? io_rd(e2_dbi, 0x80) : 0;
+
+	say("icepcie: 23e2g %s: ep id %08x cmd/status %08x; rp cmd/status %08x sec status %04x lnkctl/sta %08x (speed %u width "
+	    "x%u DLLLA %u); BHI ERRCODE %08x ERRDBG1 %08x ERRDBG2 %08x ERRDBG3 %08x\n", when, io_rd(cfg, 0), io_rd(cfg, 0x04),
+	    e2_dbi ? io_rd(e2_dbi, 0x04) : 0, e2_dbi ? io_rd(e2_dbi, 0x1c) >> 16 : 0, lnk, (lnk >> 16) & 0xf, (lnk >> 20) & 0x3f,
+	    (lnk >> 29) & 1, io_rd(bar, bhi + 0x30), io_rd(bar, bhi + 0x34), io_rd(bar, bhi + 0x38), io_rd(bar, bhi + 0x3c));
+}
+
+/*
+ * 23e2i (reads only): what tells a DMA that never completed from an image the PBL refused -
+ *  - the endpoint's PCIe Device Status (express cap + 0xa: bits 0-3 correctable / non-fatal / fatal / UR detected) and
+ *    its AER uncorrectable status (bit 14 COMPLETION TIMEOUT = its read of our buffer got no completion, 15 completer
+ *    abort, 16 unexpected completion, 19 ECRC, 20 UR, 12 poisoned TLP), correctable status and the header log; the
+ *    same for the root port (DBI);
+ *  - the DMA path's GCC branches (PCIe0 mstr_axi 0x6b030, aggre_noc_pcie_axi 0x10068, ddrss_pcie_sf_qtb 0x1007c: all
+ *    BRANCH_HALT_SKIP in Linux, so CLK_OFF there may only mean "gated while idle").
+ */
+static void
+e2_capdiag(const char *who, vm_offset_t base)
+{
+	uint32_t p = io_rd(base, 0x34) & 0xfc, exp = 0, aer = 0, x = 0x100;
+
+	for (int i = 0; p != 0 && i < 48; i++) {
+		uint32_t h = io_rd(base, p);
+		if ((h & 0xff) == 0x10) {
+			exp = p;
+			break;
+		}
+		p = (h >> 8) & 0xfc;
+	}
+	for (int i = 0; x != 0 && x < 0x1000 && i < 64; i++) {
+		uint32_t h = io_rd(base, x);
+		if (h == 0 || h == 0xffffffffu) {
+			break;
+		}
+		if ((h & 0xffff) == 0x0001) {
+			aer = x;
+			break;
+		}
+		x = h >> 20;
+	}
+	say("icepcie: 23e2i %s: DevCtl/Sta %08x (UR %u fatal %u nonfatal %u corr %u)%s; AER %s uncor %08x (CmplTO %u CmplAbort %u "
+	    "UnexpCmpl %u UR %u poisoned %u) mask %08x sev %08x cor %08x hdr %08x %08x %08x %08x\n", who,
+	    exp ? io_rd(base, exp + 8) : 0, exp ? (io_rd(base, exp + 8) >> 19) & 1 : 0, exp ? (io_rd(base, exp + 8) >> 18) & 1 : 0,
+	    exp ? (io_rd(base, exp + 8) >> 17) & 1 : 0, exp ? (io_rd(base, exp + 8) >> 16) & 1 : 0, exp ? "" : " (no express cap)",
+	    aer ? "at +ext" : "NOT FOUND", aer ? io_rd(base, aer + 4) : 0, aer ? (io_rd(base, aer + 4) >> 14) & 1 : 0,
+	    aer ? (io_rd(base, aer + 4) >> 15) & 1 : 0, aer ? (io_rd(base, aer + 4) >> 16) & 1 : 0,
+	    aer ? (io_rd(base, aer + 4) >> 20) & 1 : 0, aer ? (io_rd(base, aer + 4) >> 12) & 1 : 0, aer ? io_rd(base, aer + 8) : 0,
+	    aer ? io_rd(base, aer + 0xc) : 0, aer ? io_rd(base, aer + 0x10) : 0, aer ? io_rd(base, aer + 0x1c) : 0,
+	    aer ? io_rd(base, aer + 0x20) : 0, aer ? io_rd(base, aer + 0x24) : 0, aer ? io_rd(base, aer + 0x28) : 0);
+	if (exp) {
+		/* Linux on this tablet: 8 GT/s x1 (DT num-lanes 2); ours read x2 at link-up - what each side can do */
+		uint32_t cap = io_rd(base, exp + 0xc), st = io_rd(base, exp + 0x10) >> 16;
+		say("icepcie: 23e2i %s link: LnkCap %08x (max speed %u, max width x%u) LnkSta %04x (speed %u, width x%u)\n", who, cap,
+		    cap & 0xf, (cap >> 4) & 0x3f, st, st & 0xf, (st >> 4) & 0x3f);
+	}
+}
+
+static void
+e2_dmadiag(const char *when, vm_offset_t cfg)
+{
+	vm_offset_t gcc = ml_io_map_unmappable(GCC_PA, 0xb0000, VM_WIMG_IO);
+
+	if (gcc != 0) {
+		say("icepcie: 23e2i %s: DMA-path CBCRs mstr_axi %08x aggre_noc_pcie_axi %08x ddrss_pcie_sf_qtb %08x; votes 52000 %08x "
+		    "52008 %08x\n", when, io_rd(gcc, 0x6b030), io_rd(gcc, 0x10068), io_rd(gcc, 0x1007c), io_rd(gcc, 0x52000),
+		    io_rd(gcc, 0x52008));
+	}
+	e2_capdiag("endpoint", cfg);
+	if (e2_dbi != 0) {
+		e2_capdiag("root port", e2_dbi);
+	}
+}
+
+/*
+ * 23e2k, icepcie_ctx=1: the MHI context arrays and their base registers BEFORE BHI (UniXNU's SM8850 WCN7860 notes:
+ * the PBL refused the image when it was offered with no contexts programmed; their order: settle, contexts, image -
+ * approach only, their code is unlicensed and not used). Written as Linux builds them (mhi_init_dev_ctxt for
+ * ath12k's WCN7850-class config, then mhi_init_mmio's register writes - Linux itself does this only after READY):
+ *   in the upper half of 23e2a's mapped 1 MB (IOVA 0x10080000.., below it the 512 KB SBL), each naturally aligned:
+ *     +0x80000 128 channel contexts (44 B: chcfg, chtype, erindex, rbase, rlen, rp, wp): all DISABLED; 20 (IPCR,
+ *              outbound, chtype 1) and 21 (IPCR, inbound, 2): event ring 1, burst mode 2 (MHI_DB_BRST_DISABLE)
+ *     +0x82000 2 event contexts: intmodt 0 / 1 (bits 31:16), ertype 1 (VALID), msivec 1 / 2, ring 32 / 256 x 16 B
+ *     +0x83000 1 command context: ring 128 x 16 B
+ *     +0x84000 event ring 0 (512 B), +0x85000 event ring 1 (4 KB), +0x86000 command ring (2 KB); rp = wp = rbase
+ *   registers (BAR0, the MHI block): the wake doorbell (CHDBOFF + 8 x 127: +4 then +0 = 0), CCABAP / ECABAP / CRCBAP
+ *   high + low, MHICTRLBASE / MHIDATABASE = 0, MHICTRLLIMIT / MHIDATALIMIT = 0xffffffff (ath12k's 32-bit DMA mask),
+ *   MHICFG NER (23:16) = 2, NHWER (31:24) = 0. Same kind of writes as 23e2's (the chip's MHI / BHI registers, our DMA
+ *   memory behind bank 9); undone by the MHI reset and the chip's power-off.
+ * Alignment (asked for 23e3): the BHI image is at IOVA 0x10000000 (256 MB aligned, 512 KB). Linux's BHIe segments
+ * (seg_len 512 KB each) and the vector table (entries x 16 B) come from dma_alloc_coherent, whose IOVAs are aligned to
+ * their power-of-two size; 23e3 must place each 512 KB segment 512 KB-aligned and the table at its rounded-up size.
+ */
+#define E2K_CTX         0x80000u
+#define E2K_LEN         0x7000u
+static int e2k_full;            /* scan74: icepcie_ctxfull (0 off, 1 ch 20 / 21 rings, 2 all channels' rings) */
+static int w3_pre;              /* scan79: icepcie_rddm_pre (45wf3): RDDM RX table before BHI + 36-bit MHI limits */
+
+static void
+e2k_w32(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static void
+e2k_w64(vm_offset_t a, uint64_t v)
+{
+	e2k_w32(a, (uint32_t)v);
+	e2k_w32(a + 4, (uint32_t)(v >> 32));
+}
+
+static uint32_t
+e2k_sum(vm_offset_t buf)
+{
+	uint32_t s = 0;
+
+	for (uint32_t o = E2K_CTX; o < E2K_CTX + E2K_LEN; o += 4) {
+		s = s * 31u + *(volatile uint32_t *)(buf + o);
+	}
+	return s;
+}
+
+static bool
+e2k_contexts(vm_offset_t bar, vm_offset_t buf)
+{
+	static const struct {
+		uint32_t off, elems, intmodt, msi;
+	} ev[2] = { { 0x84000, 32, 0, 1 }, { 0x85000, 256, 1, 2 } };
+	uint32_t chdb = io_rd(bar, 0x18), erdb = io_rd(bar, 0x20), mcfg = io_rd(bar, 0x10), len = io_rd(bar, 0x0);
+	uint64_t cc = E2A_IOVA + 0x80000, ec = E2A_IOVA + 0x82000, mc = E2A_IOVA + 0x83000;
+
+#define KW(name, o, val) do { *(volatile uint32_t *)(bar + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: 23e2k mhi %s +%#x <- %08x (read back %08x)\n", name, (uint32_t)(o), (uint32_t)(val), io_rd(bar, o)); } while (0)
+	say("icepcie: 23e2k as found: MHIREGLEN %08x MHICFG %08x CHDBOFF %08x ERDBOFF %08x CCABAP %08x_%08x ECABAP %08x_%08x "
+	    "CRCBAP %08x_%08x\n", len, mcfg, chdb, erdb, io_rd(bar, 0x5c), io_rd(bar, 0x58), io_rd(bar, 0x64), io_rd(bar, 0x60),
+	    io_rd(bar, 0x6c), io_rd(bar, 0x68));
+	if (chdb == 0 || (chdb & 7) || chdb + 8 * 128 > 0x1000 || erdb == 0 || erdb >= 0x1000 || len == 0xffffffffu ||
+	    mcfg == 0xffffffffu) {
+		say("icepcie: 23e2k REFUSED: doorbell offsets / MHI block not plausible: no context written\n");
+		return false;
+	}
+	bzero((void *)(buf + E2K_CTX), E2K_LEN);
+	PE_parse_boot_argn("icepcie_ctxfull", &e2k_full, sizeof(e2k_full));
+	for (uint32_t i = 0; i < 128; i++) {
+		vm_offset_t c = buf + 0x80000 + 44 * i;
+		bool ipcr = i == 20 || i == 21;
+		e2k_w32(c, ipcr ? 2u << 8 : 0);                 /* chstate DISABLED (0), brstmode */
+		e2k_w32(c + 4, i == 20 ? 1 : i == 21 ? 2 : 0);  /* chtype = DMA direction */
+		e2k_w32(c + 8, ipcr ? 1 : 0);                   /* erindex */
+		/*
+		 * scan74 (34ux1e), icepcie_ctxfull=1|2 (host memory only, no new device write): every channel context gets a
+		 * valid, zeroed transfer ring (rbase = rp = wp, rlen), chstate still DISABLED. 1: channels 20 / 21 only, on 23e4q's
+		 * own rings (+0x87000 / +0x88000, 64 x 16 B: what e4_start writes later, as Linux's mhi_init_chan_ctxt does at
+		 * channel prepare); 2: also the other 126, each a 16 x 16 B zeroed ring at +0xf1000 + 256 x channel (to +0xf9000,
+		 * inside bank 9's 1 MB; the MSI sink at +0xf0000 is untouched). Linux's mhi_init_dev_ctxt leaves rbase / rlen / rp /
+		 * wp of a channel at 0 until that channel is prepared, so 2 goes BEYOND Linux: it only rules out a firmware read
+		 * of a zero ring base. Off (0, the default): the contexts exactly as before (= Linux's).
+		 */
+		if (e2k_full >= 1 && ipcr) {
+			uint64_t rb = E2A_IOVA + (i == 20 ? 0x87000u : 0x88000u);
+			bzero((void *)(buf + (i == 20 ? 0x87000u : 0x88000u)), 64 * 16);
+			e2a_clean(buf + (i == 20 ? 0x87000u : 0x88000u), 64 * 16);
+			e2k_w64(c + 12, rb);
+			e2k_w64(c + 20, 64 * 16ull);
+			e2k_w64(c + 28, rb);
+			e2k_w64(c + 36, rb);
+		} else if (e2k_full >= 2) {
+			uint64_t rb = E2A_IOVA + 0xf1000u + 256u * i;
+			bzero((void *)(buf + 0xf1000u + 256u * i), 256);
+			e2a_clean(buf + 0xf1000u + 256u * i, 256);
+			e2k_w64(c + 12, rb);
+			e2k_w64(c + 20, 256ull);
+			e2k_w64(c + 28, rb);
+			e2k_w64(c + 36, rb);
+		}
+	}
+	if (e2k_full != 0) {
+		say("icepcie: scan74 icepcie_ctxfull=%d: %s (host memory only; chstate DISABLED; ch 20 rbase %08x rlen %u, ch 0 rbase "
+		    "%08x rlen %u, ch 127 rbase %08x)\n", e2k_full, e2k_full >= 2 ? "all 128 channel contexts with valid zeroed rings" :
+		    "channels 20 / 21 with valid zeroed rings", *(volatile uint32_t *)(buf + 0x80000 + 44 * 20 + 12),
+		    *(volatile uint32_t *)(buf + 0x80000 + 44 * 20 + 20), *(volatile uint32_t *)(buf + 0x80000 + 12),
+		    *(volatile uint32_t *)(buf + 0x80000 + 20), *(volatile uint32_t *)(buf + 0x80000 + 44 * 127 + 12));
+	}
+	for (uint32_t i = 0; i < 2; i++) {
+		vm_offset_t e = buf + 0x82000 + 44 * i;
+		e2k_w32(e, ev[i].intmodt << 16);
+		e2k_w32(e + 4, 1);                              /* MHI_ER_TYPE_VALID */
+		e2k_w32(e + 8, ev[i].msi);
+		e2k_w64(e + 12, E2A_IOVA + ev[i].off);          /* rbase */
+		e2k_w64(e + 20, ev[i].elems * 16ull);           /* rlen */
+		e2k_w64(e + 28, E2A_IOVA + ev[i].off);          /* rp */
+		e2k_w64(e + 36, E2A_IOVA + ev[i].off);          /* wp */
+	}
+	e2k_w64(buf + 0x83000 + 12, E2A_IOVA + 0x86000);
+	e2k_w64(buf + 0x83000 + 20, 128 * 16ull);
+	e2k_w64(buf + 0x83000 + 28, E2A_IOVA + 0x86000);
+	e2k_w64(buf + 0x83000 + 36, E2A_IOVA + 0x86000);
+	e2a_clean(buf + E2K_CTX, E2K_LEN);
+	KW("wake db hi", chdb + 8 * 127 + 4, 0);
+	KW("wake db lo", chdb + 8 * 127, 0);
+	KW("CCABAP_HIGHER", 0x5c, (uint32_t)(cc >> 32));
+	KW("CCABAP_LOWER", 0x58, (uint32_t)cc);
+	KW("ECABAP_HIGHER", 0x64, (uint32_t)(ec >> 32));
+	KW("ECABAP_LOWER", 0x60, (uint32_t)ec);
+	KW("CRCBAP_HIGHER", 0x6c, (uint32_t)(mc >> 32));
+	KW("CRCBAP_LOWER", 0x68, (uint32_t)mc);
+	KW("MHICTRLBASE_HIGHER", 0x84, 0);
+	KW("MHICTRLBASE_LOWER", 0x80, 0);
+	KW("MHIDATABASE_HIGHER", 0x9c, 0);
+	KW("MHIDATABASE_LOWER", 0x98, 0);
+	/* scan79 icepcie_rddm_pre=1 (45wf3): ath12k's iova_stop = DMA_BIT_MASK(36) -> the limits' high words 0xF (Linux 7.3) */
+	/* scan80: icepcie_rddm_pre 1 = both (45wf3), 2 = the RDDM table only (45wf3a), 3 = the limit high words only (45wf3b) */
+	PE_parse_boot_argn("icepcie_rddm_pre", &w3_pre, sizeof(w3_pre));
+	KW("MHICTRLLIMIT_HIGHER", 0x8c, (w3_pre == 1 || w3_pre == 3) ? 0xfu : 0);
+	KW("MHICTRLLIMIT_LOWER", 0x88, 0xffffffffu);
+	KW("MHIDATALIMIT_HIGHER", 0xa4, (w3_pre == 1 || w3_pre == 3) ? 0xfu : 0);
+	KW("MHIDATALIMIT_LOWER", 0xa0, 0xffffffffu);
+	KW("MHICFG (NER 2, NHWER 0)", 0x10, (mcfg & 0x0000ffffu) | 2u << 16);
+#undef KW
+	say("icepcie: 23e2k contexts written (chan %#llx, event %#llx, cmd %#llx; checksum %08x); MHISTATUS %08x EXECENV %08x\n",
+	    cc, ec, mc, e2k_sum(buf), io_rd(bar, 0x48), io_rd(bar, io_rd(bar, 0x28) + 0x28));
+	return true;
+}
+
+/*
+ * 23dd2 (icepcie_msi=1): the endpoint's MSI pointed into our mapped memory before BHI, as dada's endpoint_setup
+ * (approach): MSI address = IOVA + 0xf0000 (inside bank 9's 1 MB, past the contexts), data 0, Multiple Message Enable
+ * 2 (4 vectors), MSI enable. Put back as found after bus master is off. Same kind of write as 23e1's config writes.
+ */
+static uint32_t e2m_cap, e2m_found[4], e2m_maskoff, e2m_mask_found;
+static bool e2m_on;
+/*
+ * scan79, icepcie_msi16 (0 = 23dd2 as before): 1 (kit 45wf1) = MSI as Fedora's lspci shows it under ath12k
+ * (ath12k_wifi7_msi_config: 16 vectors, MHI 3 / CE 5 / DP 8): Multiple Message Enable 4 (16 vectors) and, if the
+ * capability is per-vector maskable, the mask register = 0xffff8000; address (the sink) and data 0 as 23dd2. All 16
+ * vectors write the same address (MSI multi-message varies the data's low bits only), so the one sink word takes any of
+ * them; nothing on our side waits for an MSI (we poll). 2 (kit 45wf1o) = MSI left DISABLED (enable bit 0, address / data
+ * untouched): the host polls as before. Both put back as found (control, address, data, mask) at the undo.
+ */
+static int e2m_16;
+
+static void
+e2_msi(vm_offset_t cfg, bool on)
+{
+	if (on) {
+		PE_parse_boot_argn("icepcie_msi16", &e2m_16, sizeof(e2m_16));
+		uint32_t p = io_rd(cfg, 0x34) & 0xfc;
+		e2m_cap = 0;
+		for (int i = 0; p >= 0x40 && i < 48; i++) {
+			uint32_t w = io_rd(cfg, p);
+			if ((w & 0xff) == 0x05) {
+				e2m_cap = p;
+				break;
+			}
+			p = (w >> 8) & 0xfc;
+		}
+		if (e2m_cap == 0) {
+			say("icepcie: 23dd2 no MSI capability: not set\n");
+			return;
+		}
+		for (int i = 0; i < 4; i++) {
+			e2m_found[i] = io_rd(cfg, e2m_cap + 4 * i);
+		}
+		/* per-vector masking (control bit 8): the mask register at +0x0c (32-bit cap) or +0x10 (64-bit cap) */
+		e2m_maskoff = ((e2m_found[0] >> 16) & 0x100) ? (((e2m_found[0] >> 16) & 0x80) ? 0x10u : 0x0cu) : 0;
+		e2m_mask_found = e2m_maskoff ? io_rd(cfg, e2m_cap + e2m_maskoff) : 0;
+		if (e2m_16 == 2) {
+			*(volatile uint32_t *)(cfg + e2m_cap) = e2m_found[0] & ~(1u << 16);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			e2m_on = true;
+			say("icepcie: scan79 icepcie_msi16=2 (45wf1o): MSI left DISABLED at cfg +%#x (control %08x, found %08x; address / data "
+			    "untouched): the host polls\n", e2m_cap, io_rd(cfg, e2m_cap), e2m_found[0]);
+			return;
+		}
+		{
+			bool is64 = (e2m_found[0] >> 16) & 0x80;
+			uint64_t sink = E2A_IOVA + 0xf0000;
+			*(volatile uint32_t *)(cfg + e2m_cap + 4) = (uint32_t)sink;
+			if (is64) {
+				*(volatile uint32_t *)(cfg + e2m_cap + 8) = (uint32_t)(sink >> 32);
+				*(volatile uint32_t *)(cfg + e2m_cap + 0xc) = 0;
+			} else {
+				*(volatile uint32_t *)(cfg + e2m_cap + 8) = 0;
+			}
+			if (e2m_16 == 1 && e2m_maskoff) {
+				*(volatile uint32_t *)(cfg + e2m_cap + e2m_maskoff) = 0xffff8000u;
+			}
+			*(volatile uint32_t *)(cfg + e2m_cap) = (e2m_found[0] & 0xffff) |
+			    ((((e2m_found[0] >> 16) & ~0x70u) | (e2m_16 == 1 ? 0x40u : 0x20u) | 1u) << 16);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			e2m_on = true;
+			if (e2m_16 == 1) {
+				say("icepcie: scan79 icepcie_msi16=1 (45wf1): MME 4 = 16 vectors (MMC %u), mask register %s (read back %08x, found "
+				    "%08x); control read back %08x\n", 1u << ((e2m_found[0] >> 17) & 7), e2m_maskoff ? "= ffff8000" :
+				    "ABSENT (not maskable)", e2m_maskoff ? io_rd(cfg, e2m_cap + e2m_maskoff) : 0, e2m_mask_found, io_rd(cfg, e2m_cap));
+			}
+			say("icepcie: 23dd2 MSI at cfg +%#x: %s, address %#llx data 0, MME 2, enabled (read back ctl %08x lo %08x %08x %08x; "
+			    "found %08x %08x %08x %08x)\n", e2m_cap, is64 ? "64-bit" : "32-bit", sink, io_rd(cfg, e2m_cap),
+			    io_rd(cfg, e2m_cap + 4), io_rd(cfg, e2m_cap + 8), io_rd(cfg, e2m_cap + 0xc), e2m_found[0], e2m_found[1],
+			    e2m_found[2], e2m_found[3]);
+		}
+		return;
+	}
+	if (!e2m_on) {
+		return;
+	}
+	*(volatile uint32_t *)(cfg + e2m_cap) = e2m_found[0] & ~(1u << 16);
+	*(volatile uint32_t *)(cfg + e2m_cap + 4) = e2m_found[1];
+	*(volatile uint32_t *)(cfg + e2m_cap + 8) = e2m_found[2];
+	*(volatile uint32_t *)(cfg + e2m_cap + 0xc) = e2m_found[3];
+	if (e2m_maskoff == 0x10u) {
+		*(volatile uint32_t *)(cfg + e2m_cap + 0x10) = e2m_mask_found;     /* scan79: the 64-bit cap's mask */
+	}
+	*(volatile uint32_t *)(cfg + e2m_cap) = e2m_found[0];
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icepcie: 23dd2 MSI put back: ctl %08x (found %08x)\n", io_rd(cfg, e2m_cap), e2m_found[0]);
+	e2m_on = false;
+}
+
+/*
+ * ---- 23e3, icepcie_bhie=1|2 (CLASS C: the SBL's BHIe load of the WLAN image) -----------------------------------------
+ * Runs only after 23e2q2's steps ended in BHI SUCCESS and MHI READY with EXECENV 1 (SBL); everything before is unchanged.
+ * The method is the MHI host's for ath12k (fbc_download, sbl_size = seg_len = 512 KB): Linux drivers/bus/mhi/host/boot.c
+ * (mhi_fw_load_handler, mhi_alloc_bhie_table, mhi_firmware_copy_bhie, mhi_fw_load_bhie) was read as a reference only -
+ * this is our own code. SnapQCC2072 (Snapintosh, MIT licence) src/qcc2072-mhi.c prepares the same layout (512 KB SBL
+ * chunk skipped when an ELF header follows it, 16 B vectors {IOVA, length}): credited, not copied.
+ *   image: icepcie_bhie=1 = Linux's current rule: if amss.bin has an ELF header at sbl_size (ours: the ARM SBL ELF in the
+ *     first 512 KB, the Hexagon WLAN ELF at 0x80000) only the bytes from 0x80000 on go over BHIe (6950976 B, 14 segments),
+ *     else the whole file; icepcie_bhie=2 = always the whole file (7475264 B, 15 segments; Linux before the ELF rule).
+ *   memory: the 8 MB arena (IOVA == PA); segment i at +i x 512 KB (512 KB aligned, as dma_alloc_coherent's), the vector
+ *     table (16 B per segment: IOVA, then length; the last segment's length is the remainder) in the next 512 KB slot.
+ *   registers (the BHIe block at BHIEOFF = MHI +0x2c, as Linux reads it): TXVECADDR_HIGH +0x30, TXVECADDR_LOW +0x2c,
+ *     TXVECSIZE +0x34 = 16 x segments, TXVECDB +0x3c bits 29:0 = a nonzero sequence number (read-modify-write as
+ *     mhi_write_reg_field); TXVECSTATUS +0x44 polled every 1 ms: bits 31:30 2 = XFER_COMPL (bits 29:0 echo the sequence),
+ *     3 = ERROR; no status in 8 s = stop.
+ *   then reads only (up to 20 s in all): EXECENV (2 = AMSS, mission mode), MHISTATUS state (2 = M0), MHICTRL, the event
+ *     contexts' rp and the MSI sink word, logged at every change; stop at AMSS + M0, AMSS held 3 s, SYS_ERR, RDDM.
+ *   icepcie_bhie_m0=1 (kit 23e3m; Linux's order - mhi_ready_state_transition runs before the SBL's EE event starts BHIe):
+ *     first 23e2k's context writes again (mhi_init_mmio), both event rings' context wp = base + len - 16 with their
+ *     doorbells (ERDBOFF + 8 i: high, then low), MHICTRL MHISTATE (bits 15:8) = 2 (M0), up to 1 s for MHISTATUS M0.
+ *   No channel is started and no firmware message is sent. The undo is 23e2q2's (bus master off, MSI back, MHI reset).
+ */
+static const char *
+e3_ee(uint32_t ee)
+{
+	static const char *const n[] = { "PBL", "SBL", "AMSS", "RDDM", "WFW", "PTHRU", "EDL", "FP" };
+
+	return ee < 8 ? n[ee] : ee == 0xffffffffu ? "no answer" : "?";
+}
+
+static const char *
+e3_state(uint32_t ms)
+{
+	static const char *const n[] = { "RESET", "READY", "M0", "M1", "M2", "M3", "M3_FAST", "BHI" };
+	uint32_t s = (ms >> 8) & 0xff;
+
+	return ms == 0xffffffffu ? "no answer" : s < 8 ? n[s] : s == 0xff ? "SYS_ERR" : "?";
+}
+
+#define E3W(name, o, val) do { *(volatile uint32_t *)(bar + (o)) = (val); __asm__ volatile ("dsb sy" ::: "memory"); \
+	say("icepcie: 23e3 mhi %s +%#x <- %08x (read back %08x)\n", name, (uint32_t)(o), (uint32_t)(val), io_rd(bar, o)); } while (0)
+
+/*
+ * scan79, icepcie_wake=1|2 (kits 45wf2 / 45wf2h): the device-wake doorbell around the MHI state changes, as OpenBSD qwz(4)
+ * does it (sys/dev/ic/qwz.c, ISC licence, Stefan Sperling: qwz_mhi_mission_mode_state_transition / the M0 path; approach
+ * adapted with credit) and Linux's mhi_pm_m0_transition / mhi_pm_mission_mode_transition (read as a reference only):
+ * wake doorbell (CHDBOFF + 8 x 127, high then low) = 1, each event ring's doorbell (ERDBOFF + 8 i) = its context wp
+ * (base + len - 16 since 23e3m), the command doorbell only if the command ring is not empty, wake = 0.
+ *   at the SBL M0 (right after 23e3m's M0) and at the AMSS execution-environment change (first EXECENV 2 in 23e3's loop,
+ *   within ~1 ms). icepcie_wake=2: at the AMSS change the wake stays 1 (23e4q's wake_put is skipped) until the end of the
+ *   watch (diagnostic, beyond Linux). Same register kinds as 23e3m / 23e4q (the wake and event doorbells); new timing only.
+ */
+static int w_mode;
+static bool w_held;
+
+static void
+w_db(vm_offset_t bar, uint32_t off, uint64_t v, const char *name)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(bar + off + 4) = (uint32_t)(v >> 32);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(bar + off) = (uint32_t)v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icepcie: scan79 mhi %s +%#x/+%#x <- %08x_%08x (read back %08x_%08x)\n", name, off + 4, off, (uint32_t)(v >> 32),
+	    (uint32_t)v, io_rd(bar, off + 4), io_rd(bar, off));
+}
+
+static void
+w_pulse(vm_offset_t bar, vm_offset_t buf, const char *when, bool hold)
+{
+	uint32_t chdb = io_rd(bar, 0x18), erdb = io_rd(bar, 0x20), crp, cwp;
+
+	if (chdb == 0 || (chdb & 7) || chdb + 8 * 128 > 0x1000 || erdb == 0 || (erdb & 7) || erdb + 16 > 0x1000) {
+		say("icepcie: scan79 wake %s REFUSED: CHDBOFF %08x ERDBOFF %08x not plausible\n", when, chdb, erdb);
+		return;
+	}
+	w_db(bar, chdb + 8 * 127, 1, "device wake = 1 (wake_get)");
+	for (uint32_t i = 0; i < 2; i++) {
+		vm_offset_t e = buf + 0x82000 + 44 * i;
+		uint64_t wp = (uint64_t)*(volatile uint32_t *)(e + 36) | (uint64_t)*(volatile uint32_t *)(e + 40) << 32;
+		w_db(bar, erdb + 8 * i, wp, i == 0 ? "event ring 0 doorbell (context wp)" : "event ring 1 doorbell (context wp)");
+	}
+	crp = *(volatile uint32_t *)(buf + 0x83000 + 28);
+	cwp = *(volatile uint32_t *)(buf + 0x83000 + 36);
+	if (crp != cwp) {
+		uint64_t w = (uint64_t)cwp | (uint64_t)*(volatile uint32_t *)(buf + 0x83000 + 40) << 32;
+		w_db(bar, 0x70, w, "command ring doorbell CRDB (ring not empty)");
+	}
+	if (hold) {
+		w_held = true;
+	} else {
+		w_db(bar, chdb + 8 * 127, 0, "device wake = 0 (wake_put)");
+	}
+	say("icepcie: scan79 icepcie_wake=%d %s: wake pulse done%s; command ring %s; MHISTATUS %08x EXECENV %08x\n", w_mode, when,
+	    hold ? " - wake HELD at 1 until the end of the watch" : " (wake 1 -> event doorbells -> wake 0)", crp != cwp ?
+	    "rung" : "empty (no doorbell)", io_rd(bar, 0x48), io_rd(bar, io_rd(bar, 0x28) + 0x28));
+}
+
+static void
+w_release(vm_offset_t bar, const char *when)
+{
+	uint32_t chdb = io_rd(bar, 0x18);
+
+	if (!w_held) {
+		return;
+	}
+	w_held = false;
+	if (chdb != 0 && !(chdb & 7) && chdb + 8 * 128 <= 0x1000) {
+		w_db(bar, chdb + 8 * 127, 0, when);
+	}
+}
+
+/* 23e3m: Linux's mhi_ready_state_transition after READY - contexts (mhi_init_mmio), event ring doorbells, M0 */
+static bool
+e3_linux_m0(vm_offset_t bar, vm_offset_t buf)
+{
+	static const uint32_t ring[2] = { 0x84000, 0x85000 }, rlen[2] = { 32 * 16, 256 * 16 };
+	uint32_t erdb = io_rd(bar, 0x20), ms = 0, lms = ~0u;
+	int t;
+
+	if (erdb == 0 || erdb == 0xffffffffu || (erdb & 7) || erdb + 16 > 0x1000) {
+		say("icepcie: 23e3m REFUSED: ERDBOFF %08x not plausible: no M0\n", erdb);
+		return false;
+	}
+	if (!e2k_contexts(bar, buf)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < 2; i++) {
+		uint64_t wp = E2A_IOVA + ring[i] + rlen[i] - 16;
+		e2k_w64(buf + 0x82000 + 44 * i + 36, wp);
+		e2a_clean(buf + 0x82000 + 44 * i, 44);
+		E3W("event ring doorbell hi", erdb + 8 * i + 4, (uint32_t)(wp >> 32));
+		E3W("event ring doorbell lo", erdb + 8 * i, (uint32_t)wp);
+	}
+	E3W("MHICTRL MHISTATE = M0", 0x38, (io_rd(bar, 0x38) & ~0xff00u) | 2u << 8);
+	for (t = 0; t <= 1000; t++) {
+		ms = io_rd(bar, 0x48);
+		if (ms != lms) {
+			say("icepcie: 23e3m +%d ms: MHISTATUS %08x (%s) MHICTRL %08x EXECENV %08x; event ctxt 0 rp %08x, 1 rp %08x\n", t, ms,
+			    e3_state(ms), io_rd(bar, 0x38), io_rd(bar, io_rd(bar, 0x28) + 0x28), *(volatile uint32_t *)(buf + 0x82000 + 28),
+			    *(volatile uint32_t *)(buf + 0x82000 + 44 + 28));
+			lms = ms;
+		}
+		if (ms == 0xffffffffu || ((ms >> 8) & 0xff) == 2 || ((ms >> 8) & 0xff) == 0xff) {
+			break;
+		}
+		IOSleep(1);
+	}
+	say("icepcie: 23e3m M0 %s after ~%d ms (MHISTATUS %08x)\n", ((ms >> 8) & 0xff) == 2 && ms != 0xffffffffu ? "REACHED" :
+	    "NOT reached", t, ms);
+	PE_parse_boot_argn("icepcie_wake", &w_mode, sizeof(w_mode));
+	if (w_mode != 0 && ms != 0xffffffffu && ((ms >> 8) & 0xff) == 2) {
+		w_pulse(bar, buf, "at the SBL M0 (mhi_pm_m0_transition)", false);
+	}
+	return ms != 0xffffffffu && ((ms >> 8) & 0xff) != 0xff;
+}
+
+/* 34ux1 (icepcie_ux1=1): the read-only AMSS-window census - the block follows the 23e5 helpers */
+static int u1_on;
+static bool u1_live;
+static void u1_start(vm_offset_t bar, uint32_t bhi, vm_offset_t cb, const uint8_t *img, uint64_t len, uint32_t nseg);
+static void u1_tick(void);
+static void u1_finish(const char *why);
+
+static void
+e3_bhie(vm_offset_t bar, vm_offset_t buf, vm_offset_t cb, const uint8_t *fw, uint64_t size, uint32_t bhi)
+{
+	uint32_t bhie = io_rd(bar, 0x2c), chdb = io_rd(bar, 0x18), off = 0, nseg, seq, db, vsum = 0;
+	uint32_t st = 0, ee = 0, ms = 0, ctl = 0, lst = ~0u, lee = ~0u, lms = ~0u, lctl = ~0u, r0 = 0, r1 = 0, lr0 = ~0u, lr1 = ~0u;
+	uint64_t len, vec;
+	int t, done = -1, amss = -1;
+	bool bad = false, err = false;
+
+	e3_ran = true;
+	say("icepcie: 23e3 BHIe (icepcie_bhie=%d%s): BHIEOFF %08x CHDBOFF %08x; EXECENV %08x (%s) MHISTATUS %08x (%s) MHICTRL %08x\n",
+	    e3_mode, e3_m0 ? " icepcie_bhie_m0=1" : "", bhie, chdb, io_rd(bar, bhi + 0x28), e3_ee(io_rd(bar, bhi + 0x28)),
+	    io_rd(bar, 0x48), e3_state(io_rd(bar, 0x48)), io_rd(bar, 0x38));
+	if (e3_va == 0) {
+		say("icepcie: 23e3 REFUSED: no BHIe arena (needs icepcie_lowdma=1 and 16 MB of lowdma)\n");
+		return;
+	}
+	if (bhie == 0 || bhie == 0xffffffffu || (bhie & 3) || bhie < bhi + 0x50 || bhie + 0x48 > 0x1000 ||
+	    (chdb != 0 && chdb != 0xffffffffu && bhie + 0x48 > chdb)) {
+		say("icepcie: 23e3 REFUSED: BHIEOFF %08x not plausible (BHIOFF %08x CHDBOFF %08x)\n", bhie, bhi, chdb);
+		return;
+	}
+	if (io_rd(bar, bhi + 0x28) != 1) {
+		say("icepcie: 23e3 REFUSED: EXECENV %08x is not SBL\n", io_rd(bar, bhi + 0x28));
+		return;
+	}
+	say("icepcie: 23e3 BHIe as found: MSMSOCID %08x TXVECADDR %08x_%08x TXVECSIZE %08x TXVECDB %08x TXVECSTATUS %08x\n",
+	    io_rd(bar, bhie + 0x0), io_rd(bar, bhie + 0x30), io_rd(bar, bhie + 0x2c), io_rd(bar, bhie + 0x34),
+	    io_rd(bar, bhie + 0x3c), io_rd(bar, bhie + 0x44));
+	if (e3_mode == 1 && size > E3_SEG + 4 && memcmp(fw + E3_SEG, "\177ELF", 4) == 0) {
+		off = E3_SEG;
+	}
+	len = size - off;
+	e3_img = fw + off;
+	e3_img_len = len;
+	nseg = (uint32_t)((len + E3_SEG - 1) / E3_SEG);
+	if (len == 0 || (uint64_t)(nseg + 1) * E3_SEG > E3_ARENA) {
+		say("icepcie: 23e3 REFUSED: %llu bytes do not fit the 8 MB arena\n", len);
+		return;
+	}
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint64_t n = len - (uint64_t)i * E3_SEG < E3_SEG ? len - (uint64_t)i * E3_SEG : E3_SEG;
+		memcpy((void *)(e3_va + (vm_offset_t)i * E3_SEG), fw + off + (uint64_t)i * E3_SEG, (size_t)n);
+		if (n < E3_SEG) {
+			bzero((void *)(e3_va + (vm_offset_t)i * E3_SEG + n), (size_t)(E3_SEG - n));
+		}
+	}
+	vec = e3_pa + (uint64_t)nseg * E3_SEG;
+	bzero((void *)(e3_va + (vm_offset_t)nseg * E3_SEG), 0x1000);
+	for (uint32_t i = 0; i < nseg; i++) {
+		vm_offset_t v = e3_va + (vm_offset_t)nseg * E3_SEG + 16 * i;
+		uint64_t n = len - (uint64_t)i * E3_SEG < E3_SEG ? len - (uint64_t)i * E3_SEG : E3_SEG;
+		e2k_w64(v, e3_pa + (uint64_t)i * E3_SEG);
+		e2k_w64(v + 8, n);
+	}
+	e2a_clean(e3_va, (vm_size_t)(nseg + 1) * E3_SEG);
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint64_t n = len - (uint64_t)i * E3_SEG < E3_SEG ? len - (uint64_t)i * E3_SEG : E3_SEG;
+		vm_offset_t v = e3_va + (vm_offset_t)nseg * E3_SEG + 16 * i;
+		if (memcmp((const void *)(e3_va + (vm_offset_t)i * E3_SEG), fw + off + (uint64_t)i * E3_SEG, (size_t)n) != 0) {
+			bad = true;
+		}
+		vsum = vsum * 31u + *(volatile uint32_t *)v;
+		vsum = vsum * 31u + *(volatile uint32_t *)(v + 8);
+		if (i == 0 || i + 1 == nseg) {
+			say("icepcie: 23e3 vector %u: IOVA %08x_%08x length %08x_%08x\n", i, *(volatile uint32_t *)(v + 4),
+			    *(volatile uint32_t *)v, *(volatile uint32_t *)(v + 12), *(volatile uint32_t *)(v + 8));
+		}
+	}
+	say("icepcie: 23e3 image: amss.bin bytes %#x..%#llx (%llu B, %s) in %u segments of 512 KB at IOVA %#llx; vector table "
+	    "at IOVA %#llx, %u B (checksum %08x); copy %s\n", off, (uint64_t)size, len, off ? "Linux's rule: the ELF at 0x80000 on" :
+	    "the whole file", nseg, e3_pa, vec, nseg * 16, vsum, bad ? "DIFFERS from the file" : "verified");
+	if (bad) {
+		say("icepcie: 23e3 REFUSED: the arena does not hold the file\n");
+		return;
+	}
+	if (e3_m0) {
+		if (!e3_linux_m0(bar, buf)) {
+			say("icepcie: 23e3m: no BHIe without M0\n");
+			return;
+		}
+		if (io_rd(bar, bhi + 0x28) != 1) {
+			say("icepcie: 23e3m REFUSED: EXECENV %08x after M0 is not SBL\n", io_rd(bar, bhi + 0x28));
+			return;
+		}
+	}
+	db = io_rd(bar, bhie + 0x3c);
+	if (db == 0xffffffffu) {
+		say("icepcie: 23e3 REFUSED: TXVECDB reads 0xffffffff\n");
+		return;
+	}
+	/* nonzero, 30 bits, not BHI's session id (as MHI_RANDOM_U32_NONZERO(BHIE_TXVECSTATUS_SEQNUM_BMSK)) */
+	seq = (((uint32_t)mach_absolute_time() * 2654435761u >> 2) & 0x3fffffffu) | 1u;
+	if (seq == (io_rd(bar, bhi + 0x2c) & 0x3fffffffu)) {
+		seq ^= 2u;
+	}
+	if (u1_on) {
+		/* 34ux1: resolve + baselines now; its clock starts here, right before the BHIe doorbell */
+		u1_start(bar, bhi, cb, fw + off, len, nseg);
+	}
+	E3W("BHIE TXVECADDR_HIGH", bhie + 0x30, (uint32_t)(vec >> 32));
+	E3W("BHIE TXVECADDR_LOW", bhie + 0x2c, (uint32_t)vec);
+	E3W("BHIE TXVECSIZE", bhie + 0x34, nseg * 16);
+	E3W("BHIE TXVECDB", bhie + 0x3c, (db & ~0x3fffffffu) | seq);
+	for (t = 0; t <= 20000; t++) {
+		st = io_rd(bar, bhie + 0x44);
+		ee = io_rd(bar, bhi + 0x28);
+		ms = io_rd(bar, 0x48);
+		ctl = io_rd(bar, 0x38);
+		r0 = *(volatile uint32_t *)(buf + 0x82000 + 28);
+		r1 = *(volatile uint32_t *)(buf + 0x82000 + 44 + 28);
+		if (u1_live) {
+			u1_tick();              /* 34ux1: every 2 ms of wall time (reads only) */
+		}
+		if (st != lst || ee != lee || ms != lms || ctl != lctl || r0 != lr0 || r1 != lr1) {
+			say("icepcie: 23e3 +%d ms: TXVECSTATUS %08x (status %u, seq %s) EXECENV %08x (%s) MHISTATUS %08x (%s, ready %u, syserr "
+			    "%u) MHICTRL %08x ERRCODE %08x; event ctxt rp %08x %08x; MSI sink %08x; bank FSR %08x\n", t, st, st >> 30,
+			    (st & 0x3fffffffu) == seq ? "ours" : "not ours", ee, e3_ee(ee), ms, e3_state(ms), ms & 1, (ms >> 2) & 1, ctl,
+			    io_rd(bar, bhi + 0x30), r0, r1, *(volatile uint32_t *)(buf + 0xf0000), io_rd(cb, 0x58));
+			lst = st;
+			lee = ee;
+			lms = ms;
+			lctl = ctl;
+			lr0 = r0;
+			lr1 = r1;
+		}
+		if (done < 0 && st != 0xffffffffu && ((st >> 30) == 2 || (st >> 30) == 3)) {
+			done = t;
+			err = (st >> 30) == 3 || (st & 0x3fffffffu) != seq;
+			say("icepcie: 23e3 BHIe %s after ~%d ms: TXVECSTATUS %08x (sequence %08x %s) EXECENV %08x (%s) ERRCODE %08x ERRDBG1 %08x "
+			    "ERRDBG2 %08x ERRDBG3 %08x; bank FSR %08x FAR %08x_%08x\n", (st >> 30) == 2 ? "XFER_COMPL (the SBL took the image)" :
+			    "ERROR (bits 31:30 = 3)", t, st, seq, (st & 0x3fffffffu) == seq ? "echoed" : "NOT echoed", ee, e3_ee(ee),
+			    io_rd(bar, bhi + 0x30), io_rd(bar, bhi + 0x34), io_rd(bar, bhi + 0x38), io_rd(bar, bhi + 0x3c), io_rd(cb, 0x58),
+			    io_rd(cb, 0x64), io_rd(cb, 0x60));
+			if (e5_rddm == 3 && !err) {
+				/* 23e6r: the SBL has the image: the receive table now, before the AMSS starts (Linux: before power-up) */
+				e6_rddm_early(bar, bhi);
+			}
+		}
+		if (ms == 0xffffffffu) {
+			say("icepcie: 23e3 +%d ms: the chip stopped answering\n", t);
+			break;
+		}
+		if (((ms >> 8) & 0xff) == 0xff || ((ms >> 2) & 1)) {
+			say("icepcie: 23e3 +%d ms: SYS_ERR (MHISTATUS %08x EXECENV %08x ERRCODE %08x)\n", t, ms, ee, io_rd(bar, bhi + 0x30));
+			break;
+		}
+		if (ee == 3) {
+			say("icepcie: 23e3 +%d ms: EXECENV RDDM (the firmware crashed and waits for a ramdump)\n", t);
+			break;
+		}
+		if (ee == 2) {
+			if (amss < 0) {
+				amss = t;
+				if (w_mode != 0) {
+					/* scan79: the AMSS execution-environment change (mhi_pm_mission_mode_transition / qwz) */
+					w_pulse(bar, buf, "at the AMSS EE change (mission mode transition)", w_mode == 2);
+				}
+			}
+			if (((ms >> 8) & 0xff) == 2) {
+				say("icepcie: 23e3 MISSION MODE: EXECENV 2 (AMSS) and MHI M0 after ~%d ms (BHIe status after ~%d ms)\n", t, done);
+				e3_mission = true;
+				break;
+			}
+			if (t >= amss + 3000) {
+				say("icepcie: 23e3 AMSS UP: EXECENV 2 for 3 s, MHI state %s (MHISTATUS %08x)%s\n", e3_state(ms), ms,
+				    e3_m0 ? "" : " - no host M0 request in this kit (23e3m's)");
+				break;
+			}
+		}
+		if (done < 0 && t >= 8000) {
+			say("icepcie: 23e3 no BHIe status in 8 s (TXVECSTATUS %08x EXECENV %08x MHISTATUS %08x)%s\n", st, ee, ms,
+			    e3_m0 ? "" : " - the SBL may start BHIe only in M0 (23e3m)");
+			break;
+		}
+		if (err && t >= done + 2000) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (!e3_mission) {
+		w_release(bar, "device wake = 0 (45wf2h: released, no mission mode watch follows)");
+	}
+	say("icepcie: 23e3 END after ~%d ms: TXVECSTATUS %08x EXECENV %08x (%s) MHISTATUS %08x (%s) MHICTRL %08x ERRCODE %08x; bank FSR "
+	    "%08x\n", t, io_rd(bar, bhie + 0x44), io_rd(bar, bhi + 0x28), e3_ee(io_rd(bar, bhi + 0x28)), io_rd(bar, 0x48),
+	    e3_state(io_rd(bar, 0x48)), io_rd(bar, 0x38), io_rd(bar, bhi + 0x30), io_rd(cb, 0x58));
+}
+#undef E3W
+
+/*
+ * ---- 23e5 (1 Nov, after 23e3m / 23e4 / 23e4q / 23e4h: in every run EXECENV goes AMSS -> RDDM 16-18 ms after mission
+ * mode, whatever the host does in MHI) ---------------------------------------------------------------------------------
+ * The firmware itself names the likely cause. amss.bin (sha 23811bd6..., the Hexagon ELF at 0x80000) has, in its small
+ * plain-text log segment (vaddr 0xd4000000), "_pcielp_init" and "Invalid LTR threshold programmed by PCIe RC - PANIC";
+ * the code at 0x1875664 logs "_pcielp_init", calls a ROM routine (0x1234bcc) for the threshold, and when it returns 0
+ * logs that PANIC line and zeroes its L1.2 timing window (else window = threshold -/+ 5), which it then arms (0x1f31924).
+ * The threshold "programmed by the RC" is the endpoint's L1 PM Substates Control 1 LTR_L1.2_THRESHOLD (ext cap 0x1e,
+ * +8 bits 25:16 value, 31:29 scale). Linux writes it at enumeration, before ath12k ever powers the chip
+ * (drivers/pci/pcie/aspm.c aspm_calc_l12_info: T_POWER_ON in both ports' Control 2, Common_Mode_Restore_Time in the root
+ * port's Control 1, LTR_L1.2_THRESHOLD = 2 + 4 + T_COMMON_MODE + T_POWER_ON us in both ports' Control 1; probe.c
+ * pci_configure_ltr: DevCtl2 LTR enable, root port first) - read as a reference only, GPL, not copied. On this tablet
+ * Fedora shows both ends with L1SubCtl1 L1.2+ and DevCtl2 LTR+ (optscan run-20261026b B4). We never write any of it:
+ * after PERST# the endpoint's Control 1 is 0, so the firmware reads a zero threshold.
+ *   icepcie_diag5=1 (kit 23e5, READS ONLY): before BHI, at mission mode, at RDDM and at the end of the watch: both ports'
+ *     LnkCtl / DevCap2 / DevCtl2 / L1SS cap + Control 1 + Control 2 (threshold decoded) / LTR ext cap, the endpoint's MSI
+ *     capability, the MHI header, BHI (no serial number, no MSMHWID / OEMPKHASH: unit data) and BHIe (TX and RX vector
+ *     registers - Linux zeroes the RX ones before power-up: "POR values are undefined"), the event contexts as the device
+ *     sees them, the DEBUGOFF block if plausible (16 words), and the SMMU: bank 9 SCTLR / FSR (fault bits and FORMAT
+ *     decoded) / FAR / FSYNR0-1 / CBFRSYNRA, global sCR0 / GFSR / GFAR / GFSYNR0-1, SMR / S2CR 13. In the 1 ms watch the
+ *     BHIe RXVECSTATUS and BHI STATUS are logged at every change too.
+ *   icepcie_l1ss=1 (kit 23e5f, implies diag): right after the chip's reset and before BHI, the timing fields Linux's
+ *     aspm_calc_l12_info computes, from both ports' L1SS capabilities (refused unless both have L1 PM substates and L1.2,
+ *     and no L1.2 enable is set): root port Control 2, endpoint Control 2 = the larger T_POWER_ON; root port Control 1
+ *     bits 15:8 = the larger Common_Mode_Restore_Time; root port then endpoint Control 1 bits 31:16 = LTR_L1.2_THRESHOLD.
+ *     No enable bit, no ASPM: the link behaves as before. =2 also sets DevCtl2 LTR Mechanism Enable (bit 10), root port
+ *     then endpoint, when both DevCap2 say LTR supported (not in a kit yet). All put back as found after bus master off.
+ *   icepcie_rddm=1 (kit 23e5d, implies diag; NEW KIND of DMA: the device writes a RAM dump into our memory): when the
+ *     watch sees RDDM, the receive vector table of mhi_rddm_prepare: 9 x 512 KB (ath12k's rddm_size 0x420000 fits) in the
+ *     BHIe arena's slots 0-8 (the image the SBL already took), the table in slot 15; RXVECADDR_HIGH +0x64, LOW +0x60,
+ *     RXVECSIZE +0x68 = 144, RXVECDB +0x70 bits 29:0 = a nonzero sequence; RXVECSTATUS +0x78 polled 5 s (2 = done);
+ *     then bytes per segment, the first 64 B, and every printable string of 12+ characters with a crash keyword that is
+ *     NOT in amss.bin (a run-time message) - at most 64 checked, 40 logged. Linux programs the table before power-up;
+ *     here it comes after the crash so the run up to RDDM stays 23e5's (a device that ignores a late doorbell shows no
+ *     status: then a third arena is needed for Linux's timing).
+ */
+/*
+ * ---- 23e6 (1 Nov, after 23e5 / 23e5f / 23e5d) -----------------------------------------------------------------------
+ * 23e5f (L1SS threshold 65536 ns, CM restore 70 us, T_POWER_ON 0) still went AMSS -> RDDM at +16 ms. 23e5d's upload ran
+ * (RXVECSTATUS ERROR after ~148 ms with 9 x 512 KB: the dump is bigger; 3.55 MB with data) and showed the RDDM table
+ * header (version 1, header 0x308 = 12 entries of 64 B: base, phys, size, description[20], file name[20]; entry 0
+ * "Q6-SFR" / "Q6-SFR.bin", 80 B at Q6 0x015748d8, at dump +0x308) and the SFR text "...t: wdog or kernel error
+ * suspected." plus "QURT_fatalNotif": QuRT's own fatal path (a kernel exception or a watchdog), not an err_fatal with a
+ * file:line. The bytes were not kept. Fedora on this tablet (lspci, the Wi-Fi working) has, on BOTH ends: DevCtl2 LTR+,
+ * L1SubCtl1 L1.2/L1.1 PCI-PM and ASPM enables +, LTR1.2_Threshold 156672 ns (Linux's encode_l12_threshold rounds UP:
+ * scale 2, value 153), L1SubCtl2 T_PwrOn 80 us (scale 1, value 8), root port T_CommonMode 70 us, LnkCtl CommClk+; the
+ * endpoint's LTR max snoop / no-snoop stay 0 ns (Linux writes none on this platform). 23e5f's truncating encoder and the
+ * caps' T_POWER_ON 0 gave a different state; LTR enable was never set.
+ *   icepcie_l1ss=3 (kit 23e6, the top fix): Linux's state of the link at ath12k's power-up, in Linux's order (probe.c /
+ *     aspm.c pci_configure_ltr at device add, then aspm_calc_l12_info), each write logged with its read-back:
+ *     root port DevCtl2 |= LTR enable (bit 10), endpoint DevCtl2 |= bit 10; root port L1SS Control 2 = endpoint L1SS
+ *     Control 2 = 0x41 (T_POWER_ON 80 us); root port L1SS Control 1 = CM restore 70 us + threshold 0x40990000 (156672
+ *     ns); endpoint L1SS Control 1 = threshold 0x40990000. No enable bit, no ASPM.
+ *   icepcie_l1ss=4 (kit 23e6e): 3 + the four L1SS enable bits (Control 1 bits 3:0) root port then endpoint, as Linux's
+ *     pcie_config_aspm_l1ss. LnkCtl ASPM stays 0 (ath12k_pci_aspm_disable keeps it off during the download), so no L1
+ *     substate is entered.
+ *   icepcie_l1ss=5 (kit 23e6c): 4 + Common Clock Configuration (LnkCtl bit 6, endpoint then root port) and a link
+ *     retrain (root port LnkCtl bit 5), as pcie_aspm_configure_common_clock; up to 1 s for Link Training to clear and
+ *     DLLLA; the link is refused (no BHI) if it does not come back. NEW KIND of action: a link retrain.
+ *   Undo (all): after bus master off, each register written as found (LnkCtl without a retrain: the power-off follows).
+ *   icepcie_rddm=2 (kits 23e6d / 23e6 / 23e6e / 23e6c): 23e5d's late upload with 15 x 512 KB (ath12k's wcn7860
+ *     rddm_size 0x780000), the table in slot 15; then the dump is SAVED: zlib (deflate, level 1) of a 4 KB header +
+ *     the 15 segments into a contiguous 4 MB buffer, handed to the loader as its "recording" in the pipeline-cache pack
+ *     format ("SHEXP001", u32 stream bytes, u32 packed bytes, zlib) - the loader writes it into xnulog.bin's second half
+ *     (tools/iceland/xnulog.py export) and the kit's capture already fetches xnulog.bin. A pack that does not fit is
+ *     truncated (a partial zlib stream still inflates). Also logged: the RDDM table, small regions (the SFR) in hex /
+ *     text, and +/-128 B around crash keywords. UNIT DATA: the dump may hold MAC / calibration: private logs only.
+ *   icepcie_rddm=3 (kit 23e6r): as 2, but the receive table (RXVECADDR / RXVECSIZE / RXVECDB) is written right after
+ *     BHIe XFER_COMPL, before the AMSS starts - Linux's mhi_rddm_prepare timing (its POR values are junk: 23e5's
+ *     7f7dfce6_67ffdeb5); at RDDM the device's own upload is awaited 1 s, then 23e5d's late doorbell.
+ *   icepcie_watch=60 (the fix kits): the watch after mission mode runs 60 s of wall time (mach_absolute_time), logs
+ *     EXECENV / MHI state / SYS_ERR changes and every QRTR packet with "+N ms", and ends with one "23e6 STABILITY" line.
+ */
+/*
+ * ---- 23e7 (1 Nov, after 23e6*: LTR / L1SS / enables / common clock + retrain changed nothing; the crash is ~29 ms of
+ * wall time after AMSS in every run - the earlier "+16 ms" were 1 ms loop steps) -------------------------------------
+ * 23e6d's upload completed (XFER_COMPL, 15 segments) and the pack was made, but the kits carried the default loader
+ * (loader-iceland.efi fd88d1cc, 31 Oct), which has no esp_export_write: the export went nowhere. 23e7's kits take
+ * loader-iceland-20pc.efi (f430b818, the GPU agent's export loader, 20pc1 read back 3.87 MB). The table walk now also
+ * shows the SYS_ERR pointer's 1 KB (Q6 0x0140855c: Q6-SRAM). 23e6r: the RX table written at BHIe XFER_COMPL sent the SBL
+ * into RDDM before the AMSS (do not use icepcie_rddm=3). The fix candidate (icewifi_hpm=1, 23e2j's mode votes) and the
+ * x1 cap (icepcie_x1=1, 23e2m) are existing code; only the kits' args are new.
+ */
+#define E5_RDDM_SEGS    9u
+#define E6_RDDM_SEGS    15u             /* ath12k wcn7860 hw2.0 rddm_size 0x780000 = 15 x 512 KB */
+#define E5_RDDM_TAB     (15u * E3_SEG)
+#define E6_PACK_MAX     ((4u << 20) - 0x10000u)  /* xnulog.bin's second half less the loader's header block, with margin */
+#define E6_ZHEAP        (1u << 20)      /* deflate's state (level 1, 15-bit window, memLevel 8: ~270 KB) */
+
+static const uint8_t *e5_fw;
+static uint64_t e5_fwsize;
+static uint32_t e5_l1_ep, e5_l1_rp, e5_exp_ep, e5_exp_rp, e5_found[6];
+static bool e5_l1_set, e5_ltr_set, e5_rddm_done;
+static uint32_t e6_lnk_ep, e6_lnk_rp, e6_rxseq, e6_segs = E5_RDDM_SEGS;
+static bool e6_ccc_set, e6_early;
+static vm_offset_t e6_pack, e6_zheap;
+static vm_size_t e6_packsz, e6_zused;
+static uint64_t e7_errptr;              /* 23e7: the SYS_ERR event's pointer field (0x0140855c in every run so far) */
+static uint32_t e5_lrx = ~0u, e5_lbs = ~0u;
+
+/* standard capability id in a config space mapping (0 = none) */
+static uint32_t
+e5_cap(vm_offset_t base, uint32_t id)
+{
+	uint32_t p = io_rd(base, 0x34) & 0xfc;
+
+	for (int i = 0; p >= 0x40 && i < 48; i++) {
+		uint32_t h = io_rd(base, p);
+		if ((h & 0xff) == id) {
+			return p;
+		}
+		p = (h >> 8) & 0xfc;
+	}
+	return 0;
+}
+
+/* extended capability id (0x100 on) */
+static uint32_t
+e5_extcap(vm_offset_t base, uint32_t id)
+{
+	uint32_t x = 0x100;
+
+	for (int i = 0; x >= 0x100 && x < 0x1000 && i < 64; i++) {
+		uint32_t h = io_rd(base, x);
+		if (h == 0 || h == 0xffffffffu) {
+			return 0;
+		}
+		if ((h & 0xffff) == id) {
+			return x;
+		}
+		x = (h >> 20) & 0xffc;
+	}
+	return 0;
+}
