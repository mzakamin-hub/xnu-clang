diff --git a/bsd/dev/hakios_iceland_adsp.c b/bsd/dev/hakios_iceland_adsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..3e4d87e68550ecf488b684ce2b1865a9bb89dc71
--- /dev/null
+++ b/bsd/dev/hakios_iceland_adsp.c
@@ -0,0 +1,11358 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") audio DSP (ADSP, "lpass"): started and stopped again, nothing
+ * else -- the base for the sensor hub and sound. Only with boot-arg icedsp=N; without it nothing here is touched.
+ *
+ * The images come from U-Boot (armed with iceland.xnu=rootdsp: env xnu_fw, patch 0021), which loads adsp.mbn and
+ * adsp_dtb.mbn from the Fedora root (Linux's own copies, /fedora-root/usr/lib/firmware/updates/qcom/kaanapali/iceland/)
+ * to 0x890000000 / 0x893000000, outside the kernel's window, and tells the loader "adspfw=<pa>,<size>
+ * adspdtb=<pa>,<size>"; the loader reserves and writes them back and publishes them in /chosen: "hakios,adsp-fw" and
+ * "hakios,adsp-dtb", each two
+ * 64-bit words {physical address, size}. They are single-file ELF32 images (.mbn): program header 0 the ELF header,
+ * the last one the hash segment (flags bits 24-26 = 2), the rest loadable and relocatable (bit 27).
+ *
+ * Every value is the Pad's own (q90t tree):
+ *   kaanapali.dtsi    remoteproc_adsp: remoteproc@6800000 "qcom,kaanapali-adsp-pas", "qcom,sm8550-adsp-pas";
+ *                     memory-region adspslpi@a1400000 (0x5000000) and q6-adsp-dtb@a1380000 (0x80000); power-domains
+ *                     lcx, lmx; qcom,qmp = aoss_qmp (power-management@c300000, IPCC client AOP 0 signal 0);
+ *                     smp2p-adsp: qcom,smem <443>, <429> (theirs, ours), local 0, remote 2, IPCC client LPASS (3)
+ *                     signal SMP2P (2), entries "master-kernel" (ours: bit 0 stop) and "slave-kernel" (theirs: 0
+ *                     fatal, 1 ready, 2 handover, 3 stop-ack); smem@81d00000 (hwlock tcsr_mutex 3:
+ *                     hwlock@1f40000, stride 0x1000); aop-cmd-db@81c60000; apps_rsc: drv-2 at 0x18920000,
+ *                     tcs-offset 0xd00, ACTIVE_TCS first (TCS 0)
+ *   qcom_q6v5_pas.c   sm8550_adsp_resource: pas_id 1, dtb_pas_id 0x24, crash reason item 423, load_state "adsp",
+ *                     proxy power domains lcx / lmx (voted to their highest level: dev_pm_genpd_set_performance_state
+ *                     INT_MAX); the order: dtb loaded (init image + mem setup + segments), then at start "load_state
+ *                     on", the rails, dtb auth-and-reset, the main image loaded, its auth-and-reset, "ready" waited
+ *                     for (5 s); handover = the rails given back; stop = our "stop" bit, stop-ack, PAS shutdown
+ *   qcom_scm.c        PAS init image (2/1, value + buffer: a contiguous page, the hypervisor makes the SHM bridge),
+ *                     mem setup (2/2), auth and reset (2/5), shutdown (2/6); SIP, SMC64
+ *   qcom_mdt_loader.c metadata = ELF header + program headers + hash segment; mem setup (min paddr .. aligned max);
+ *                     segment i at region + (paddr - min paddr), zeroes to memsz
+ *   rpmh-rsc.c        layout v3 (RSC_DRV_ID >> 16 & 0xff >= 3); cmd-db.c; qcom_aoss.c (QMP v1, 64-byte messages)
+ * The method follows HakiOS's redwood_adsp.c (steps 1-7 and the stop); no value of it is used.
+ *
+ *   icedsp=1..6: six levels, each adding the next riskier kind of access (see icedsp_thread): 1 RAM only, 2 reads,
+ *             3 CE0 vote + TZ for the dtb image, 4 both images loaded (not started), 5 + the power path up and down,
+ *             6 the start, watched, held and stopped. (Re-split after run ipad16 hung the tablet at the old 3.)
+ *   Progress marks on the panel (mark_draw): a photo tells the step even when the log is lost.
+ * Lines go to the kernel log, prefixed "icedsp:".
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
