diff --git a/iokit/Native/NullEthernet/NativeNullEthernet.cpp b/iokit/Native/NullEthernet/NativeNullEthernet.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c478e7791de044adbac6b59eb6fabee0746942b9
--- /dev/null
+++ b/iokit/Native/NullEthernet/NativeNullEthernet.cpp
@@ -0,0 +1,400 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland S7 item 9: a built-in en0 with no hardware behind it, until a real network exists (Wi-Fi at S12, USB).
+// A fixed locally administered MAC, link up, every packet dropped.
+//
+// Why: IOTimeSyncClockManager makes the TimeSync clock identifier from a built-in Ethernet or 802.11 interface's MAC, and
+// looks once, at its start. Without one the clock never registers, clocksyncd waits for it, and WindowServer (QuartzCore's
+// TimeSync clock) waits on clocksyncd (piano 2026-11-11 on its tablet: with this interface logind, loginwindow and
+// WindowServer start and WindowServer opens the display; without it they hang; sheng ShengEthernet.cpp:15-16 the same).
+//
+// Provenance:
+// - The controller is UniXNU piano (lenzhang) 613a209 package/PianoNullEthernet/PianoNullEthernet.cpp (blob 1a15cf76),
+//   unchanged in substance: itself macOS-DroidVM 0855e2a overlay/kext/DroidVMEthernet.cpp without its virtio-net transport
+//   (piano's UPSTREAM). Renamed, and our own made-up locally administered MAC ("ICEL").
+// - The way it is built in and started is UniXNU-sheng 1108068's ShengEthernet (package/ShengEthernet.cpp worker;
+//   scripts/build-gop-legacy-display-27.py:742-827): Apple's published IONetworkingFamily-188 headers as IOKit/network
+//   (iokit/conf/Makefile.template), the family's instance size asserted, the vtable checked slot by slot against the
+//   collection's (sheng scripts/net-ether-26C5035r.json; gen_bindings.py), the family symbols bound to the collection
+//   (native_eth_*_26C5035r.s), and the metaclass made late, after the family kext has loaded.
+// - The TimeSync gate is piano's (tooling/k27/kext/PianoNullEthernet.json "patch_personalities": IOTimeSyncRootService gets
+//   IOResourceMatch on the controller's resource). piano writes it into its collection; here IOCatalogue::addDrivers()
+//   applies it when the personality arrives (native_null_ethernet_gate), so IOTimeSyncRootService, and the clock manager
+//   on it, start only once en0 is registered.
+//
+// When: IOKitBSDInit() starts it right after it publishes IOBSD (piano's personality: IOResources, IOResourceMatch IOBSD).
+// null-en0=0 leaves both the interface and the gate out (the "before" of a run pair).
+//
+// w3-net, icewifi_net=1|2 (default off: all of the above unchanged): the same interface carries the Wi-Fi station's frames
+// (bsd/dev/hakios_iceland_net.c). The way is piano's PianoWifiEthernet (lenzhang/UniXNU-xiaomipad8pro dcfbe72,
+// package/PianoWifi/PianoWifiEthernet.cpp, BSD-2-Clause-Patent; its shape and its findings, no code copied): an
+// Ethernet-like interface, not a Wi-Fi one; the link down until the station's port is open; received frames into an mbuf
+// of the family's and up through the interface's inputPacket(); and a work loop of the controller's own (piano's boot
+// 10g: with IOResources as the provider there is none, the family's command gate never ran, enable() was never called
+// and no frame reached outputPacket). piano makes a second controller and takes en0 over from its null one; here the
+// null controller itself is the carrier, so macOS sees one built-in interface from the start (TimeSync's, configd's).
+//
+// w5-wifi, icewifi_txerr=1 (with icewifi_net; default off): a frame the carrier refuses returns its errno from
+// outputPacket (ENOBUFS when the station's queue is full, ENETDOWN with no link, EMSGSIZE), not kIOReturnOutputDropped.
+// The finding is piano's (lenzhang/UniXNU-xiaomipad8pro 8164c23, PianoWifiEthernet 10s, piano-wifi-txerr; its finding, no
+// code copied): with no output queue of the controller's (we make none), the family hands outputPacket's value to the
+// stack as an errno; kIOReturnOutputDropped is 2, ENOENT, which TCP passes to the writer, so an upload ended the first time
+// the station's queue was full (piano's boots 10q/10r: after 0.1-0.6 s). ENOBUFS is a full queue to TCP, which goes on.
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOBSD.h>   // kIOBSDNameKey
+#include <IOKit/IOWorkLoop.h>
+#include <libkern/c++/OSMetaClass.h>
+#include <libkern/OSKextLib.h>
+#include <pexpert/pexpert.h>
+#include <kern/thread.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/errno.h>
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-anon-enum-enum-conversion"   // the family's headers mix anonymous enums
+#define __PRIVATE_SPI__   // the shipped family uses IONetworkController's reserved slots 2-5 (outputStart ... networkInterfaceNotification)
+#include <IOKit/network/IOEthernetController.h>
+#include <IOKit/network/IOEthernetInterface.h>
+#include <IOKit/network/IONetworkMedium.h>
+#include <IOKit/network/IOOutputQueue.h>   // kIOReturnOutputDropped
+#pragma clang diagnostic pop
+
+// The subclass is allocated with the size these headers give; the build passes the collection's (sheng's fixture).
+static_assert(sizeof(IOEthernetController) == NATIVE_ETHERNET_CONTROLLER_SIZE, "IOEthernetController as the collection has it");
+
+extern "C" {
+// bsd/dev/hakios_iceland_net.c: the stack's frame on its way out (copied there; the packet stays ours). 0 = on its way;
+// refused: ENETDOWN, EMSGSIZE or ENOBUFS (the station's queue full), or -1 (held back by icewifi_net_lan, a plain drop).
+int hakios_iceland_net_output(mbuf_t packet);
+// For hakios_iceland_net.c, all inert (-1) unless icewifi_net made the controller a carrier.
+int native_null_ethernet_link(int up);
+int native_null_ethernet_input(const uint8_t *frame, uint32_t length);
+int native_null_ethernet_name(char *name, size_t size);
+int native_null_ethernet_address(const uint8_t *address);
+void native_null_ethernet_counts(uint64_t *enables, uint64_t *sent, uint64_t *dropped);
+}
+
+namespace {
+constexpr UInt64 linkSpeed = 1000 * 1000000ULL;
+
+// icewifi_net=1 (the station's frames) or 2 (hakios_iceland_net.c's self-test): the controller carries frames.
+bool
+carrierAsked(void)
+{
+	uint32_t mode = 0;
+	return PE_parse_boot_argn("icewifi_net", &mode, sizeof(mode)) && (mode == 1 || mode == 2);
+}
+}
+
+class NativeNullEthernet : public IOEthernetController {
+	OSDeclareDefaultStructors(NativeNullEthernet)
+
+	IOEthernetInterface *fInterface = nullptr;
+	IOEthernetAddress fAddress = {{0x02, 0x49, 0x43, 0x45, 0x4c, 0x01}};   // locally administered, "ICEL"
+	UInt64 fTxDrops = 0;
+	// the carrier (icewifi_net): set once, in createWorkLoop() / start()
+	bool fCarrier = false;
+	bool fTxErrno = false;   // icewifi_txerr=1: a refused frame returns its errno (set in start(), carrier only)
+	volatile bool fLinkUp = false;
+	IOWorkLoop *fWorkLoop = nullptr;
+	IONetworkMedium *fMedium = nullptr;
+	UInt64 fEnables = 0, fTxFrames = 0;
+
+protected:
+	// The family calls this from its start(), before its first getWorkLoop(). Without icewifi_net: the family's own (no
+	// loop of ours, getWorkLoop() the provider's), as before.
+	bool createWorkLoop() override
+	{
+		if (!carrierAsked()) {
+			return IOEthernetController::createWorkLoop();   // (apple-kext: through the bound vtable; the slot is the family's)
+		}
+		fWorkLoop = IOWorkLoop::workLoop();
+		return fWorkLoop != nullptr;
+	}
+
+public:
+	IOWorkLoop *getWorkLoop() const override { return fWorkLoop ? fWorkLoop : IOService::getWorkLoop(); }
+	bool start(IOService *provider) override;
+	void stop(IOService *provider) override;
+	IOReturn getHardwareAddress(IOEthernetAddress *address) override { *address = fAddress; return kIOReturnSuccess; }
+	IOReturn enable(IONetworkInterface *) override { ++fEnables; return kIOReturnSuccess; }
+	IOReturn disable(IONetworkInterface *) override { return kIOReturnSuccess; }
+	// IOBSD is up (we start after it is published), and the family's wait for it from start() needs IOResources matched,
+	// which it may not be while IOResources' own matching runs: piano's note.
+	UInt32 getFeatures() const override { return kIONetworkFeatureNoBSDWait; }
+	UInt32 outputPacket(mbuf_t packet, void *) override
+	{
+		const int refused = fCarrier && fLinkUp ? hakios_iceland_net_output(packet) : ENETDOWN;
+		freePacket(packet);
+		if (refused != 0) {
+			++fTxDrops;
+			return fTxErrno && refused > 0 ? UInt32(refused) : kIOReturnOutputDropped;
+		}
+		++fTxFrames;
+		return kIOReturnOutputSuccess;
+	}
+	IOReturn setPromiscuousMode(bool) override { return kIOReturnSuccess; }
+	IOReturn setMulticastMode(bool) override { return kIOReturnSuccess; }
+	IOReturn setMulticastList(IOEthernetAddress *, UInt32) override { return kIOReturnSuccess; }
+
+	// the carrier's side, for hakios_iceland_net.c (not virtual: the vtable stays the family's, slot for slot)
+	int carrierLink(bool up);
+	int carrierInput(const uint8_t *frame, uint32_t length);
+	int carrierName(char *name, size_t size);
+	void carrierAddress(const uint8_t *address) { memcpy(fAddress.bytes, address, sizeof(fAddress.bytes)); }
+	void carrierCounts(uint64_t *enables, uint64_t *sent, uint64_t *dropped) { *enables = fEnables; *sent = fTxFrames; *dropped = fTxDrops; }
+};
+
+OSDefineMetaClassAndStructors(NativeNullEthernet, IOEthernetController)
+
+namespace {
+NativeNullEthernet *gCarrier;   // the one controller, once it is a started carrier; never cleared (it lives as long as the system)
+}
+
+// The link's state, from the station's side: active once its port is open, valid but not active when the network is gone.
+int
+NativeNullEthernet::carrierLink(bool up)
+{
+	fLinkUp = up;
+	return setLinkStatus(up ? (kIONetworkLinkValid | kIONetworkLinkActive) : kIONetworkLinkValid, fMedium, up ? linkSpeed : 0) ? 0 : -1;
+}
+
+// A received frame (Ethernet header first, the caller's buffer), one at a time: into a packet of the family's and up.
+int
+NativeNullEthernet::carrierInput(const uint8_t *frame, uint32_t length)
+{
+	mbuf_t m = allocatePacket(length);
+	if (!m) {
+		return -2;
+	}
+	if (mbuf_copyback(m, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		freePacket(m);
+		return -3;
+	}
+	fInterface->inputPacket(m, length);
+	return 0;
+}
+
+// The name macOS gave the interface (configd's InterfaceNamer through IONetworkStack; "en0"), once it has one.
+int
+NativeNullEthernet::carrierName(char *name, size_t size)
+{
+	OSObject *property = fInterface->copyProperty(kIOBSDNameKey);
+	OSString *bsd = OSDynamicCast(OSString, property);
+	const int found = bsd ? 0 : -1;
+	if (bsd) {
+		strlcpy(name, bsd->getCStringNoCopy(), size);
+	}
+	OSSafeReleaseNULL(property);
+	return found;
+}
+
+int
+native_null_ethernet_link(int up)
+{
+	return gCarrier ? gCarrier->carrierLink(up != 0) : -1;
+}
+
+int
+native_null_ethernet_input(const uint8_t *frame, uint32_t length)
+{
+	return gCarrier && frame && length >= 14 && length <= 1514 ? gCarrier->carrierInput(frame, length) : -1;
+}
+
+int
+native_null_ethernet_name(char *name, size_t size)
+{
+	return gCarrier && name && size ? gCarrier->carrierName(name, size) : -1;
+}
+
+// The radio's address, which the station's frames carry: what the controller answers from now on (hakios_iceland_net.c
+// sets the interface's own with ifnet_set_lladdr()). Never logged.
+int
+native_null_ethernet_address(const uint8_t *address)
+{
+	if (!gCarrier || !address) {
+		return -1;
+	}
+	gCarrier->carrierAddress(address);
+	return 0;
+}
+
+void
+native_null_ethernet_counts(uint64_t *enables, uint64_t *sent, uint64_t *dropped)
+{
+	if (gCarrier) {
+		gCarrier->carrierCounts(enables, sent, dropped);
+	}
+}
+
+bool
+NativeNullEthernet::start(IOService *provider)
+{
+	if (!IOEthernetController::start(provider)) {
+		return false;
+	}
+	OSDictionary *media = OSDictionary::withCapacity(1);
+	IONetworkMedium *medium = IONetworkMedium::medium(IOMediumType(kIOMediumEthernetAuto) | IOMediumType(kIOMediumOptionFullDuplex), linkSpeed);
+	if (!media || !medium || !IONetworkMedium::addMedium(media, medium) || !publishMediumDictionary(media)) {
+		OSSafeReleaseNULL(media);
+		OSSafeReleaseNULL(medium);
+		IOLog("NullEthernet: cannot publish the medium\n");
+		return false;
+	}
+	media->release();
+	setSelectedMedium(medium);
+	fCarrier = fWorkLoop != nullptr;
+	if (fCarrier) {
+		// the carrier: the interface is there, with no link until the station's port is open (carrierLink)
+		medium->retain();
+		fMedium = medium;
+		setLinkStatus(kIONetworkLinkValid, medium, 0);
+		// configd's InterfaceNamer names a new interface with no saved unit only once the IOService plane is quiet
+		// (configd-1405.100.8 Plugins/InterfaceNamer/ifnamer.c:3283-3290, the root's kIOBusyInterest :4369-4375): en0
+		// was named 0.1-0.6 s after the quiet in 25 tablet runs, at 30.6, 60.7 or 70.7 s (w3-net-1: 61.0 s, the link up
+		// 29.9 s after the join). A reserved unit is honoured before that wait (ifnamer.c:3267-3282): the property
+		// "network-interface-unit-<prefix>", one or two uint32 (first and last unit), searched from the interface up
+		// through its parents (NetworkInterfaceUtil.c:187-226), as a Mac's device tree gives its built-in ports.
+		const uint32_t unit = 0;
+		OSData *reserved = OSData::withBytes(&unit, sizeof(unit));
+		if (reserved) {
+			setProperty("network-interface-unit-en", reserved);
+			reserved->release();
+		}
+	} else {
+		setLinkStatus(kIONetworkLinkValid | kIONetworkLinkActive, medium, linkSpeed);
+	}
+	medium->release();
+	if (!attachInterface(reinterpret_cast<IONetworkInterface **>(&fInterface), false)) {
+		IOLog("NullEthernet: cannot attach the interface\n");
+		return false;
+	}
+	// IOTimeSyncClockManager takes the clock identifier from the built-in interfaces only (the interface copies IOBuiltin from the
+	// controller's provider, IOResources here): mark it built-in, register it, then release IOTimeSyncRootService's gate.
+	fInterface->setProperty(kIOBuiltin, true);
+	fInterface->registerService(kIOServiceSynchronous);
+	publishResource("NativeNullEthernet");
+	const uint8_t *m = fAddress.bytes;
+	if (fCarrier) {
+		uint32_t txErrno = 0;
+		fTxErrno = PE_parse_boot_argn("icewifi_txerr", &txErrno, sizeof(txErrno)) && txErrno == 1;
+		gCarrier = this;
+		IOLog("NullEthernet: en0 (built in) is a carrier (icewifi_net): link down, a work loop of its own, the made-up MAC "
+		    "%02x:%02x:%02x:%02x:%02x:%02x until a station's address replaces it; TimeSync released; icewifi_txerr=%d\n",
+		    m[0], m[1], m[2], m[3], m[4], m[5], fTxErrno ? 1 : 0);
+		return true;
+	}
+	IOLog("NullEthernet: en0 (built in, no hardware: every packet dropped), MAC %02x:%02x:%02x:%02x:%02x:%02x; TimeSync released\n",
+	    m[0], m[1], m[2], m[3], m[4], m[5]);
+	return true;
+}
+
+void
+NativeNullEthernet::stop(IOService *provider)
+{
+	if (fInterface) {
+		detachInterface(fInterface);
+		OSSafeReleaseNULL(fInterface);
+	}
+	IOEthernetController::stop(provider);
+}
+
+extern kmod_info_t g_kernel_kmod_info;
+extern "C" void native_null_ethernet_static_init(void) __asm__("__GLOBAL__sub_I_NativeNullEthernet.cpp");
+extern "C" {
+// 0 not run, 1 started, 2 left out (null-en0=0), negative: the step that failed.
+volatile int native_null_ethernet_state = 0;
+void native_null_ethernet_probe(void);
+void native_null_ethernet_gate(OSArray *personalities);
+}
+
+namespace {
+
+bool
+enabled(void)
+{
+	uint32_t on = 1;
+	return !PE_parse_boot_argn("null-en0", &on, sizeof(on)) || on;
+}
+
+void
+worker(void *, wait_result_t)
+{
+	// sheng's ShengEthernet worker: the family kext first, so the parent class exists before ours is made.
+	const OSReturn loaded = OSKextLoadKextWithIdentifier("com.apple.iokit.IONetworkingFamily");
+	void *handle = nullptr;
+	NativeNullEthernet *controller = nullptr;
+	IOService *parent = IOService::getResourceService();
+	bool attached = false;
+	if (loaded != kOSReturnSuccess && loaded != kOSKextReturnStartStopError) {
+		native_null_ethernet_state = -1;
+	} else if (!(handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name))) {
+		native_null_ethernet_state = -2;
+	} else {
+		native_null_ethernet_static_init();
+		if (OSMetaClass::postModLoad(handle)) {
+			native_null_ethernet_state = -3;
+		} else if (!(controller = OSTypeAlloc(NativeNullEthernet)) || !controller->init(nullptr) || !parent) {
+			native_null_ethernet_state = -4;
+		} else if (!(attached = controller->attach(parent))) {
+			native_null_ethernet_state = -5;
+		} else if (!controller->start(parent)) {
+			native_null_ethernet_state = -6;
+		} else {
+			controller->registerService();
+			controller->retain();   // held for the life of the system, as the family's own drivers are
+			native_null_ethernet_state = 1;
+		}
+	}
+	if (native_null_ethernet_state != 1) {
+		if (attached) {
+			controller->detach(parent);
+		}
+		IOLog("NullEthernet: not started (%d)\n", native_null_ethernet_state);
+	}
+	OSSafeReleaseNULL(controller);
+	thread_terminate(current_thread());
+}
+
+}  // namespace
+
+// The board entry (IOKitBSDInit, right after IOBSD is published), macOS only.
+void
+native_null_ethernet_probe(void)
+{
+	if (!enabled()) {
+		native_null_ethernet_state = 2;
+		IOLog("NullEthernet: left out (null-en0=0)\n");
+		return;
+	}
+	thread_t thread = nullptr;
+	if (kernel_thread_start(worker, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		native_null_ethernet_state = -7;
+	}
+}
+
+// IOCatalogue::addDrivers(), macOS only: piano's patch_personalities for IOTimeSyncFamily. IOTimeSyncRootService (provider
+// IOResources, no resource match in 26C5035r) waits for the resource the controller publishes once en0 is registered.
+void
+native_null_ethernet_gate(OSArray *personalities)
+{
+	if (!personalities || !enabled()) {
+		return;
+	}
+	for (unsigned i = 0; i < personalities->getCount(); i++) {
+		OSDictionary *p = OSDynamicCast(OSDictionary, personalities->getObject(i));
+		OSString *cls = p ? OSDynamicCast(OSString, p->getObject(kIOClassKey)) : nullptr;
+		if (!cls || !cls->isEqualTo("IOTimeSyncRootService") || p->getObject(gIOResourceMatchKey)) {
+			continue;
+		}
+		OSDictionary *gated = OSDictionary::withDictionary(p);
+		OSString *resource = OSString::withCString("NativeNullEthernet");
+		if (gated && resource && gated->setObject(gIOResourceMatchKey, resource)) {
+			personalities->replaceObject(i, gated);
+			IOLog("NullEthernet: IOTimeSyncRootService waits for en0 (IOResourceMatch NativeNullEthernet)\n");
+		}
+		OSSafeReleaseNULL(gated);
+		OSSafeReleaseNULL(resource);
+	}
+}
