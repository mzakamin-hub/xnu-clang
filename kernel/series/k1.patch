+static void
+cs_text_fixup_init(void)
+{
+	DTEntry chosen;
+	void const *table;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "text-fixups", &table, &size) == kSuccess) {
+		const char *s = table, *end = s + size;
+		for (int i = 0; s < end && *s; i++) {
+			char entry[160];
+			size_t length = strnlen(s, (size_t)(end - s));
+			if (length < sizeof(entry) && cs_text_fixup_count < CS_TEXT_FIXUP_MAX) {
+				strlcpy(entry, s, length + 1);
+				if (cs_text_fixup_parse(entry, &cs_text_fixups[cs_text_fixup_count])) {
+					cs_text_fixup_count++;
+				} else {
+					printf("text-fixups[%d]: malformed, ignored\n", i);
+				}
+			} else {
+				printf("text-fixups[%d]: too long or table full, ignored\n", i);
+			}
+			s += length + 1;
+		}
+	}
+	const char *args[] = {
+		cs_text_fixup_arg0, cs_text_fixup_arg1, cs_text_fixup_arg2, cs_text_fixup_arg3,
+		cs_text_fixup_arg4, cs_text_fixup_arg5, cs_text_fixup_arg6, cs_text_fixup_arg7,
+	};
+	for (int i = 0; i < (int)(sizeof(args) / sizeof(args[0])); i++) {
+		if (args[i][0] == '\0' || cs_text_fixup_count == CS_TEXT_FIXUP_MAX) {
+			continue;
+		}
+		if (cs_text_fixup_parse(args[i], &cs_text_fixups[cs_text_fixup_count])) {
+			cs_text_fixup_count++;
+		} else {
+			printf("text-fixup%d: malformed, ignored\n", i);
+		}
+	}
+	/*
+	 * w4-audio (the 24 MHz question): CoreAudio's AudioGetHostClockFrequency returns one constant, the double 24000000.0
+	 * (the timer of Apple's chips), which the audio server's IO clock and IO threads take for mach_absolute_time()'s
+	 * rate. This board's timer runs at another rate (the Pad 4: 19.2 MHz; QEMU: 62.5 MHz), and the audio server's cycles
+	 * then run long by the ratio (UniXNU-sheng hal/ShengAudioPlugIn.c:75-78, whose plug-in sets the constant at run
+	 * time through its kernel service). With boot-arg icehostclock=1 the constant's 8 bytes in 26C5035r's cache
+	 * (dyld_shared_cache_arm64e.09, file offset 0x45f4160: the literal that function's adrp + ldr d0 loads; checked
+	 * against the cache, where they are 24000000.0) become this kernel's timebase frequency as a double -- a fixup as
+	 * the ones above, applied only where the original bytes match, so another build is left alone. Mach time itself
+	 * is not touched. Off by default: the timebase is the owner's decision.
+	 */
+	uint32_t hostclock = 0;
+	if (PE_parse_boot_argn("icehostclock", &hostclock, sizeof(hostclock)) && hostclock == 1) {
+		static const uint8_t apple[8] = { 0x00, 0x00, 0x00, 0x00, 0x60, 0xe3, 0x76, 0x41 };     /* 24000000.0 */
+		uint64_t hz = gPEClockFrequencyInfo.timebase_frequency_hz;
+
+		if (hz == 0 || hz == 24000000 || cs_text_fixup_count == CS_TEXT_FIXUP_MAX) {
+			printf("icehostclock: nothing to change (the timebase is %llu Hz; %u fixups)\n", hz, cs_text_fixup_count);
+		} else {
+			struct cs_text_fixup *f = &cs_text_fixups[cs_text_fixup_count++];
+			unsigned e = 63 - (unsigned)__builtin_clzll(hz);
+			uint64_t bits = (uint64_t)(1023 + e) << 52 | ((e <= 52 ? hz << (52 - e) : hz >> (e - 52)) & ((1ULL << 52) - 1));
+
+			strlcpy(f->name, "dyld_shared_cache_arm64e.09", sizeof(f->name));
+			f->offset = 0x45f4160;
+			memcpy(f->original, apple, sizeof(apple));
+			memcpy(f->replacement, &bits, sizeof(bits));
+			f->length = 8;
+			printf("icehostclock: CoreAudio's host clock constant 24000000 Hz becomes this timebase's %llu Hz (double "
+			    "%#llx) in %s at %#llx\n", hz, bits, f->name, f->offset);
+		}
+	}
+	cs_text_fixup_parsed = cs_text_fixup_count;
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, cs_text_fixup_init);
+
+/*
+ * Applies the fixups that fall in this validated page of vp. kva is a writable kernel address of the page. Returns the
+ * number of fixups written, so the caller makes the instruction cache coherent.
+ */
+uint32_t
+cs_text_fixup_page(struct vnode *vp, memory_object_offset_t page_offset, void *kva)
+{
+	uint32_t written = 0;
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (f->offset < page_offset || f->offset + f->length > page_offset + PAGE_SIZE) {
+			continue;
+		}
+		if (vp == NULLVP || vp->v_name == NULL || strcmp(vp->v_name, f->name) != 0) {
+			continue;
+		}
+		uint8_t *at = (uint8_t *)kva + (f->offset - page_offset);
+		if (memcmp(at, f->original, f->length) != 0) {
+			continue;
+		}
+		memcpy(at, f->replacement, f->length);
+		written++;
+		if (os_atomic_inc(&cs_text_fixup_applied, relaxed) <= 16) {
+			printf("text-fixup: %s+0x%llx (%u bytes) applied\n", f->name, f->offset, f->length);
+		}
+	}
+	return written;
+}
+
+/*
+ * A file system that verifies whole blocks (a sealed APFS volume: 16 KiB) meets a fixed-up page again when another page of
+ * its block is paged in later: the block's resident pages are hashed as they are, the fixup with them, and the pagein fails
+ * with EBADMSG for good (decmpfs_pagein_compressed). cs_text_fixup_in_range() says whether a fixup of vp lies in
+ * [offset, offset + size); cs_text_fixup_restore() puts the original bytes back in a copy of that range, for the hash.
+ */
+bool
+cs_text_fixup_in_range(struct vnode *vp, off_t offset, size_t size)
+{
+	if (vp == NULLVP || vp->v_name == NULL) {
+		return false;
+	}
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (f->offset >= (uint64_t)offset && f->offset + f->length <= (uint64_t)offset + size &&
+		    strcmp(vp->v_name, f->name) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+uint32_t
+cs_text_fixup_restore(struct vnode *vp, off_t offset, uint8_t *copy, size_t size)
+{
+	static uint32_t said;
+	uint32_t restored = 0;
+
+	if (vp == NULLVP || vp->v_name == NULL) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (f->offset < (uint64_t)offset || f->offset + f->length > (uint64_t)offset + size ||
+		    strcmp(vp->v_name, f->name) != 0) {
+			continue;
+		}
+		uint8_t *at = copy + (f->offset - (uint64_t)offset);
+		if (memcmp(at, f->replacement, f->length) != 0) {
+			continue;
+		}
+		memcpy(at, f->original, f->length);
+		restored++;
+		if (os_atomic_inc(&said, relaxed) <= 4) {
+			printf("text-fixup: %s+0x%llx: its block is verified with the original bytes\n", f->name, f->offset);
+		}
+	}
+	return restored;
+}
+
+/*
+ * A fixed-up page is validated again when its validation was reset: the commit of a UPL that holds it does that to every
+ * validated page of a signed object (upl_commit_range), and a sealed volume's pagein of a neighbour page takes the whole
+ * 16 KiB block in its UPL. The page's hash is the file's, so it is taken with the original bytes in place of each fixup
+ * that is applied in [data, data + size), the bytes of vp at offset; the page is not touched. False, and nothing hashed,
+ * when no applied fixup lies there.
+ *
+ * Limits, as the fixups themselves have them (text-fixupN is a private boot argument):
+ *  - a fixup names its file by the last path component only (vp->v_name), here as in cs_text_fixup_page: a file of the
+ *    same name elsewhere that holds the replacement bytes at that offset is hashed with the original bytes too;
+ *  - only the whole-range branch of cs_validate_hash comes here. A range hashed in parts (the partial-page branch above)
+ *    gets no substitution: a fixup in such a page would still taint it on a second validation.
+ */
+static bool
+cs_text_fixup_hash(struct vnode *vp, off_t offset, const uint8_t *data, size_t size, const struct cs_hash *md, void *ctx)
+{
+	static uint32_t said;
+	const uint64_t start = (uint64_t)offset;
+	size_t done = 0;
+
+	if (__probable(cs_text_fixup_count == 0) || vp == NULLVP || vp->v_name == NULL) {
+		return false;
+	}
+	for (;;) {
+		const struct cs_text_fixup *next = NULL;
+
+		for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+			const struct cs_text_fixup *f = &cs_text_fixups[i];
+			if (f->offset < start + done || f->offset + f->length > start + size ||
+			    (next != NULL && f->offset >= next->offset) || strcmp(vp->v_name, f->name) != 0 ||
+			    memcmp(data + (f->offset - start), f->replacement, f->length) != 0) {
+				continue;
+			}
+			next = f;
+		}
+		if (next == NULL) {
+			break;
+		}
+		const size_t at = (size_t)(next->offset - start);
+		md->cs_update(ctx, data + done, at - done);
+		md->cs_update(ctx, next->original, next->length);
+		done = at + next->length;
+		if (os_atomic_inc(&said, relaxed) <= 4) {
+			printf("text-fixup: %s+0x%llx: its page is validated with the original bytes\n", next->name, next->offset);
+		}
+	}
+	if (done == 0) {
+		return false;
+	}
+	md->cs_update(ctx, data + done, size - done);
+	return true;
+}
+
