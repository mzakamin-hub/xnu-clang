+{
+	int len = MAXPATHLEN, n = 0;
+	char *p = buf, *q;
+
+	if (buf == NULL) {
+		return "(no memory)";
+	}
+	if (vn_getpath(vp, buf, &len) != 0) {
+		return "(no path)";
+	}
+	if (strncmp(p, "/System/Volumes/Data/", 21) == 0) {
+		p += 20;
+	}
+	for (q = p; *q != '\0'; q++) {
+		if (*q == '/' && q != p && ++n == 3) {
+			break;
+		}
+	}
+	*q = '\0';
+	return p;
