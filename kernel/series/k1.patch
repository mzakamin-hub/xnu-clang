+/* TLMM pin: pull [1:0], function [5:2], drive [8:6], output enable 9; eGPIO pads (bit 11) given to us (bit 12) */
+static void
+pin(unsigned n, uint32_t config, int level)
+{
+	vm_offset_t cfg = tlmm + 0x1000UL * n;
+	uint32_t old = rd(cfg);
+
+	if (old & (1u << 11)) {
+		config |= 1u << 12;
+	}
+	if (level >= 0) {
+		wr(cfg + 4, level ? 2 : 0);
+	}
+	wr(cfg, config);
+	if (level >= 0) {
+		wr(cfg + 4, level ? 2 : 0);
+	}
+}
