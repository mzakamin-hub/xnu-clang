+			/* "VM_KERN_MEMORY_IOKIT" -> "IOKIT" */
+			if (n != NULL && strlen(n) > 15) {
+				strlcpy(m->tag_name[at], n + 15, ICEMEM_NAME);
+			} else {
+				snprintf(m->tag_name[at], ICEMEM_NAME, "tag %u", idx);
+			}
+		} else if ((namelen = KA_NAME_LEN(site)) != 0) {
+			if (namelen > ICEMEM_NAME - 1) {
+				namelen = ICEMEM_NAME - 1;
+			}
+			memcpy(m->tag_name[at], KA_NAME(site), namelen);
+			m->tag_name[at][namelen] = '\0';
+		} else if (VM_TAG_KMOD & site->flags) {
+			(void)OSKextGetKmodIDForSite(site, m->tag_name[at], ICEMEM_NAME);
+		} else {
+			snprintf(m->tag_name[at], ICEMEM_NAME, "kernel site %#llx", (uint64_t)VM_KERNEL_UNSLIDE(site));
+		}
