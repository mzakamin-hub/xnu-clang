+/* a8xx_set_hwcg(true); the a840 catalog entry sets no gmu_cgc_mode (0) */
+static bool
+hw_clock_gating(void)
+{
+	W_G(G8_GPU_GMU_AO_GMU_CGC_MODE_CNTL, 0);
+	W_G(G8_GPU_GMU_AO_GMU_CGC_DELAY_CNTL, 0x110111);
+	W_G(G8_GPU_GMU_AO_GMU_CGC_HYST_CNTL, 0x55555);
+	W_G(G8_RBBM_CLOCK_CNTL_GLOBAL, 1);
+	W_G(G8_RBBM_CGC_GLOBAL_LOAD_CMD, 1);
+	W_G(G8_RBBM_CGC_P2S_TRIG_CMD, 1);
+	if (!wait_bits(gpu + 4UL * G8_RBBM_CGC_P2S_STATUS, 1, 1, 1000)) {
+		say("core: clock gating: P2S TXDONE not seen (status %#x): gating left as it is\n", G(G8_RBBM_CGC_P2S_STATUS));
+		return false;
+	}
+	W_G(G8_RBBM_CLOCK_CNTL_GLOBAL, 0);
+	say("core: hardware clock gating on\n");
+	return true;
+}
+
+/*
+ * The completion interrupt: kaanapali.dtsi gpu@3d00000 interrupts <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH> = INTID 332. The
+ * handler (interrupt context: no log, no lock) reads RBBM_INT_0_STATUS, writes it to RBBM_INT_CLEAR_CMD (a6xx_irq) and
+ * counts; after 8 it masks the SPI (a stuck level line). Its register writes are listed after the test.
+ */
+#define GPU_INTID               (32u + 300u)
+#define INT_RB_DONE_TS          (1u << 17)
+#define INT_CACHE_FLUSH_TS      (1u << 20)
+#define EV7_IRQ                 (1u << 31)
+
+extern kern_return_t gic_v3_spi_attach(uint32_t intid, bool edge, void (*handler)(void *context, uint32_t intid), void *context);
+extern void gic_v3_spi_mask(uint32_t intid);
+extern void gic_v3_spi_detach(uint32_t intid);
+
+static volatile uint32_t irq_count, irq_status, irq_masked, irq_zero;
+static bool irq_attached;
+static uint32_t stage6;
+static int fence_event;                 /* stage 6: fence waiters sleep on its address, the interrupt wakes them */
+static volatile bool core_live;         /* the core runs (SQE on, GBIF open): what a panic's loader_return halts */
+static volatile uint32_t *fence_view;   /* uncached view of the scratch page (stage 6) */
+
+/*
+ * The GPU's own time, for RedwoodGPU's "the GPU worked N us on each of M" (redwood_gpu_worked): each submission's time
+ * runs from when it was handed over, or when the one before it finished if that was later, to the interrupt that sees its
+ * fence. An estimate from the CPU's side (no CP timestamps: an always-on counter read by the CP is not in this kit yet),
+ * good enough to tell the GPU's share of a frame from the CPU's.
+ */
+#define GT_SLOTS                64
+static uint64_t gt_sub[GT_SLOTS];       /* mach time of each fence's submission, by fence % GT_SLOTS */
+static uint32_t gt_done;                /* the last fence accounted */
+static uint64_t gt_last_end, gt_busy;   /* mach time */
+static uint32_t gt_count, gt_by[7];
+/* 31hk1 / 31hk2 (gpurot): the fence of the last rotated blit, and when the interrupt saw it done (mach time; 0: not yet) */
+static volatile uint32_t rot_watch;
+static volatile uint64_t rot_end_abs;
+static LCK_GRP_DECLARE(icegpu_gt_group, "iceland-gpu-time");
+static LCK_SPIN_DECLARE(gt_lock, &icegpu_gt_group);     /* (taken with interrupts off: the handler and the reader) */
+
+/* with gt_lock held */
+static void
+gt_account(uint64_t now)
+{
+	volatile uint32_t *view = fence_view;
+	uint32_t word;
+
+	if (view == NULL || gt_done == 0) {
+		return;
+	}
+	word = view[FENCE_OFF / 4];
+	if ((int32_t)(word - gt_done) <= 0) {
+		return;
+	}
+	if (word - gt_done > GT_SLOTS) {
+		gt_done = word - GT_SLOTS;      /* (older ones written over: not timed) */
+	}
+	while (gt_done != word) {
+		uint64_t start = gt_sub[++gt_done % GT_SLOTS], ns;
+		unsigned by = 0;
+		static const uint32_t under_us[6] = { 100, 250, 500, 1000, 2000, 4000 };
+
+		if (gt_done == rot_watch) {
+			rot_end_abs = now;      /* (gpurot: its blit's completion as the interrupt saw it) */
+		}
+		start = start > gt_last_end ? start : gt_last_end;
+		if (start == 0 || start > now) {
+			continue;
+		}
+		absolutetime_to_nanoseconds(now - start, &ns);
+		while (by < 6 && ns / 1000 >= under_us[by]) {
+			by++;
+		}
+		gt_by[by]++;
+		gt_busy += now - start;
+		gt_count++;
+		gt_last_end = now;
+	}
+}
+
+static void
+gpu_irq(__unused void *context, uint32_t intid)
+{
+	uint32_t s = rd(gpu + 4UL * G8_RBBM_INT_0_STATUS);
+
+	wr(gpu + 4UL * G8_RBBM_INT_CLEAR_CMD, s);
+	irq_status |= s;
+	irq_count++;
+	if (stage6) {
+		/* many interrupts are normal now; a stuck line shows as interrupts with nothing pending */
+		lck_spin_lock(&gt_lock);
+		gt_account(mach_absolute_time());
+		lck_spin_unlock(&gt_lock);
+		thread_wakeup((event_t)&fence_event);
+		irq_zero = s ? 0 : irq_zero + 1;
+		if (irq_zero >= 8) {
+			gic_v3_spi_mask(intid);
+			irq_masked = 1;
+		}
+	} else if (irq_count >= 8) {
+		gic_v3_spi_mask(intid);
+		irq_masked = 1;
+	}
+}
+
+static void
+irq_on(void)
+{
+	kern_return_t kr = gic_v3_spi_attach(GPU_INTID, false, gpu_irq, NULL);
+
+	irq_attached = kr == KERN_SUCCESS;
+	say("core: GIC SPI 300 (INTID %u, level): %s (%d)\n", GPU_INTID, irq_attached ? "attached" : "NOT attached, polling",
+	    kr);
+	W_G(G8_RBBM_INT_CLEAR_CMD, 0xffffffff);
+	W_G(G8_RBBM_INT_0_MASK, INT_RB_DONE_TS | INT_CACHE_FLUSH_TS);
+}
+
+static void
+irq_off(void)
+{
+	if (gmu_readable() && (G(G8_GMU_PWR_CLK_STATUS) & 3) == 0) {
+		W_G(G8_RBBM_INT_0_MASK, 0);
+		W_G(G8_RBBM_INT_CLEAR_CMD, 0xffffffff);
+	}
+	if (irq_attached) {
+		gic_v3_spi_mask(GPU_INTID);
+		gic_v3_spi_detach(GPU_INTID);
+		irq_attached = false;
+		say("core: GIC SPI 300 detached (%u interrupts, status seen %#x%s)\n", irq_count, irq_status,
+		    irq_masked ? ", masked after 8" : "");
+	}
+}
+
+/* arm_smmu_tlb_inv_range_s1 for one 4 KB page of bank 0 (AArch64: TLBIVA at 0x600 = VA >> 12 | ASID << 48), then sync */
+static bool
+core_tlb_inv_page(uint64_t iova)
+{
+	uint64_t v = iova >> 12;                /* ASID 0 */
+	vm_offset_t a = smmu + SMMU_CB(0) + 0x600;
+
+	say("w CB0_TLBIVA @%#llx: -> %#llx (64-bit)\n", (uint64_t)SMMU_PHYS + SMMU_CB(0) + 0x600, v);
+	writes++;
+	__asm__ volatile ("str %0, [%1]" : : "r" (v), "r" (a) : "memory");
+	W_SMMU(SMMU_CB(0) + CB_TLBSYNC, "CB0_TLBSYNC", 0);
+	return wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000);
+}
+
+/* the 4 KB page at iova out of the shared tables: the PTE cleared, the table pushed out, the bank's TLB entry dropped */
+static bool
+core_unmap_page(uint64_t iova)
+{
+	int t = 0;
+
+	for (unsigned level = 0; level < 2; level++) {
+		uint64_t e = tables[t][iova >> (30 - 9 * level) & 0x1ff];
+
+		if (!(e & 1) || (t = table_of(e)) < 0) {
+			return false;
+		}
+	}
+	tables[t][iova >> 12 & 0x1ff] = 0;
+	to_memory((vm_offset_t)&tables[t][iova >> 12 & 0x1ff], 8);
+	return core_tlb_inv_page(iova);
+}
+
+/* one indirect buffer: CP_MEM_WRITE inside it, then a second fence from the ring with CP_EVENT_WRITE7's IRQ bit */
+#define TEST2_OFF               0x1010u
+#define TEST2_VALUE             0x1b0c0de5u
+#define FENCE2_VALUE            2u
+
+static bool
+ib_test(void)
+{
+	volatile uint32_t *ib = (volatile uint32_t *)core_ib.va, *scratch = (volatile uint32_t *)core_scratch.va;
+	uint32_t n = 0, seen_by_irq = 0, irq_before = irq_count;
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	ib[n++] = 7u << 28 | 3 | odd_parity(3) << 15 | CP_MEM_WRITE << 16 | odd_parity(CP_MEM_WRITE) << 23;
+	ib[n++] = SCRATCH_IOVA + TEST2_OFF;
+	ib[n++] = 0;
+	ib[n++] = TEST2_VALUE;
+	scratch[TEST2_OFF / 4] = 0;
+	to_memory(core_ib.va, IB_SIZE);
+	to_memory(core_scratch.va, SCRATCH_SIZE);
+	ring_pkt7(CP_INDIRECT_BUFFER_OP, 3);
+	ring(IB_IOVA);
+	ring(0);
+	ring(n);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_EVENT_WRITE7, 4);
+	ring(EV_CACHE_CLEAN | EV7_WRITE_ENABLED | EV7_IRQ);
+	ring(SCRATCH_IOVA + FENCE_OFF);
+	ring(0);
+	ring(FENCE2_VALUE);
+	if (!ring_run("CP_INDIRECT_BUFFER + CP_EVENT_WRITE7 fence 2 (IRQ)")) {
+		return false;
+	}
+	for (int i = 0; i < 100; i++) {
+		if (irq_count != irq_before) {
+			seen_by_irq = 1;
+			break;
+		}
+		sleep_ms(1);
+	}
+	to_memory(core_scratch.va, SCRATCH_SIZE);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	say("core: IB word %#x (%s), fence %#x (%s); completion seen by %s (interrupts %u, status %#x, int0 now %#x)\n",
+	    scratch[TEST2_OFF / 4], scratch[TEST2_OFF / 4] == TEST2_VALUE ? "written" : "NOT written", scratch[FENCE_OFF / 4],
+	    scratch[FENCE_OFF / 4] == FENCE2_VALUE ? "signalled" : "NOT signalled",
+	    seen_by_irq ? "THE INTERRUPT (SPI 300)" : "POLLING (no interrupt within 100 ms)", irq_count, irq_status,
+	    G(G8_RBBM_INT_0_STATUS));
+	if (irq_count) {
+		say("w RBBM_INT_CLEAR_CMD @%#llx: by the interrupt handler, %u times (the status it read each time)\n",
+		    (uint64_t)GPU_PHYS + 4UL * G8_RBBM_INT_CLEAR_CMD, irq_count);
+		writes += irq_count;
+	}
+	if (scratch[TEST2_OFF / 4] != TEST2_VALUE || scratch[FENCE_OFF / 4] != FENCE2_VALUE) {
+		core_state("IB");
+		return false;
+	}
+	say("AN INDIRECT BUFFER RAN: second fence back (%llu us)\n", ns / 1000);
+	return true;
+}
+
+/* 32vm4a, boot-arg icegpu_ubwcread=1: the UBWC mode registers read back right after core_up writes them (no new write) */
+static uint32_t ubwc_read_arg, ubwc_back[8], ubwc_asked;
+
+static bool
+core_up(void)
+{
+	const uint8_t *sqe;
+	uint64_t sqe_size = 0;
+	uint32_t granted = 0, hbb = 16 - 13;
+	volatile uint32_t *scratch = (volatile uint32_t *)core_scratch.va;
+
+	sqe = fw_image(SQE_NAME, &sqe_size, NULL);
+	if (sqe == NULL || sqe_size < 8 || sqe_size - 4 > SQE_SIZE) {
+		say("core: fw/%s %s\n", SQE_NAME,
+		    sqe == NULL ? "is neither in md1 nor linked into this kernel" : "has an odd size");
+		return false;
+	}
+	{
+		uint32_t ver = 0;
+
+		memcpy(&ver, sqe + 4, 4);
+		say("core: fw/gen80200_sqe.fw %llu bytes, first word %#x\n", sqe_size, ver);
+	}
+	memcpy((void *)core_sqe.va, sqe + 4, sqe_size - 4);     /* adreno_fw_create_bo: past the first word */
+	to_memory(core_sqe.va, SQE_SIZE);
+
+	/* hw_init: a6xx_gmu_set_oob(GMU_OOB_GPU_SET) first */
+	core_oob = true;
+	W_G(G8_GMU_HOST2GMU_INTR_SET, OOB_GPU_SET);
+	for (int i = 0; i < 10000 && !(granted & OOB_GPU_ACK); i++) {
+		sleep_us(100);
+		granted = G(G8_GMU_GMU2HOST_INTR_INFO);
+	}
+	W_G(G8_GMU_GMU2HOST_INTR_CLR, OOB_GPU_ACK);
+	if (!(granted & OOB_GPU_ACK) || !wait_bits(gpu + 4UL * G8_GMU_PWR_CLK_STATUS, 3, 0, 100000)) {
+		say("core: OOB GPU not granted again (g2h %#x pwr/clk %#x)\n", granted, G(G8_GMU_PWR_CLK_STATUS));
+		return false;
+	}
+	if (!core_smmu_on()) {
+		return false;
+	}
+
+	say("core: hw_init\n");
+	aperture(PIPE_NONE);
+	W_G(G8_GBIF_HALT, 0);
+	(void)G(G8_GBIF_HALT);
+	W_G(G8_RBBM_GBIF_HALT, 0);
+	(void)G(G8_RBBM_GBIF_HALT);
+	W_G(G8_RBBM_SECVID_TSB_CNTL, 0);
+	W_G64(G8_RBBM_SECVID_TSB_TRUSTED_BASE, "RBBM_SECVID_TSB_TRUSTED_BASE", 0);
+	W_G(G8_RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	W_G(G8_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	W_G64(G8_UCHE_CCHE_GC_GMEM_RANGE_MIN, "UCHE_CCHE_GC_GMEM_RANGE_MIN", GMEM_RANGE_MIN);
+	W_G64(G8_SP_HLSQ_GC_GMEM_RANGE_MIN, "SP_HLSQ_GC_GMEM_RANGE_MIN", GMEM_RANGE_MIN);
+	W_G64(G8_UCHE_TRAP_BASE, "UCHE_TRAP_BASE", UCHE_TRAP_BASE);
+	W_G64(G8_UCHE_WRITE_THRU_BASE, "UCHE_WRITE_THRU_BASE", UCHE_TRAP_BASE);
+	W_G64(G8_UCHE_CCHE_TRAP_BASE, "UCHE_CCHE_TRAP_BASE", UCHE_TRAP_BASE);
+	W_G64(G8_UCHE_CCHE_WRITE_THRU_BASE, "UCHE_CCHE_WRITE_THRU_BASE", UCHE_TRAP_BASE);
+	W_G(G8_RBBM_PERFCTR_CNTL, 1);
+	W_G(G8_RBBM_SLICE_PERFCTR_CNTL, 1);
+	W_GR(G8_CP_PERFCTR_CP_SEL(0), "CP_PERFCTR_CP_SEL(0)", 1);
+	/* a8xx_set_ubwc_config, kaanapali = ubwc_6_0_hbb16: hbb 3 (lo 3, hi 0), swizzle 2/3 on, yuvnotcomptofc, mode 5,
+	 * rgb565_predicator, amsbc; not lossless-8888, not fp16compoptdis, not ubwc_mode, no 64-byte min access */
+	aperture(PIPE_BV);
+	W_G(G8_GRAS_NC_MODE_CNTL, hbb << 5);
+	ubwc_back[0] = ubwc_read_arg ? G(G8_GRAS_NC_MODE_CNTL) : 0;     /* 32vm4a: read back under the same aperture */
+	aperture(PIPE_BR);
+	W_G(G8_GRAS_NC_MODE_CNTL, hbb << 5);
+	W_G(G8_RB_CCU_NC_MODE_CNTL, 1u << 6 | (hbb >> 2) << 3 | (hbb & 3) << 1);
+	W_G(G8_RB_CMP_NC_MODE_CNTL, 5u << 15 | 1u << 6 | 1u << 2 | 1u << 1);
+	if (ubwc_read_arg) {
+		ubwc_back[1] = G(G8_GRAS_NC_MODE_CNTL);
+		ubwc_back[2] = G(G8_RB_CCU_NC_MODE_CNTL);
+		ubwc_back[3] = G(G8_RB_CMP_NC_MODE_CNTL);
+	}
+	aperture(PIPE_NONE);
+	W_G(G8_SP_NC_MODE_CNTL, (hbb >> 2) << 10 | 2u << 4 | (hbb & 3) << 1);
+	W_G(G8_TPL1_NC_MODE_CNTL, (hbb >> 2) << 4 | (hbb & 3) << 1);
+	if (ubwc_read_arg) {
+		ubwc_back[4] = G(G8_SP_NC_MODE_CNTL);
+		ubwc_back[5] = G(G8_TPL1_NC_MODE_CNTL);
+	}
+	for (unsigned i = 0; i < 20; i++) {
+		W_GR(G8_TPL1_BICUBIC_WEIGHTS_TABLE(i), "TPL1_BICUBIC_WEIGHTS_TABLE", bicubic[i]);
+	}
+	W_G(G8_UCHE_CLIENT_PF, 1u << 7 | 1);
+	/* a8xx_nonctxt_config */
+	for (uint32_t pipe = PIPE_NONE; pipe <= PIPE_DDE_BV; pipe++) {
+		if (pipe == PIPE_LPAC) {
+			continue;
+		}
+		aperture(pipe);
+		for (unsigned i = 0; i < NONCTXT; i++) {
+			if (nonctxt[i].pipes & B(pipe)) {
+				W_GR(nonctxt[i].reg, "nonctxt", nonctxt[i].value);
+			}
+		}
+	}
+	aperture(PIPE_NONE);
+	if (ubwc_read_arg) {
+		/* 32vm4a: the UBWC mode registers as the GPU holds them now (reads only; GX powered: OOB GPU held) */
+		static const uint32_t want[6] = { 0x60, 0x60, 0x46, 0x28046, 0x26, 0x6 };
+		unsigned same = 0;
+
+		ubwc_back[6] = G(G8_RBBM_NC_MODE_CNTL);
+		ubwc_back[7] = G(G8_RBBM_SLICE_NC_MODE_CNTL);
+		for (unsigned i = 0; i < 6; i++) {
+			same += ubwc_back[i] == want[i];
+		}
+		say("ubwc: read back: GRAS_NC_MODE_CNTL bv %#x br %#x, RB_CCU_NC_MODE_CNTL %#x, RB_CMP_NC_MODE_CNTL %#x, "
+		    "SP_NC_MODE_CNTL %#x, TPL1_NC_MODE_CNTL %#x, RBBM_NC_MODE_CNTL %#x, RBBM_SLICE_NC_MODE_CNTL %#x; %u of 6 as "
+		    "Linux a8xx_set_ubwc_config writes for ubwc_6_0_hbb16 (60 60 46 28046 26 6): %s\n", ubwc_back[0], ubwc_back[1],
+		    ubwc_back[2], ubwc_back[3], ubwc_back[4], ubwc_back[5], ubwc_back[6], ubwc_back[7], same,
+		    same == 6 ? "UBWC 6.0 HBB 16 HELD" : "DIFFERS");
+	}
+	W_G(G8_RBBM_INTERFACE_HANG_INT_CNTL, 1u << 30 | 0xcfffff);
+	W_G(G8_RBBM_SLICE_INTERFACE_HANG_INT_CNTL, 1u << 30);
+	if (stage5) {
+		cp_protect();                   /* hw_init: a8xx_set_cp_protect, here in its order */
+	}
+	aperture(PIPE_BR);
+	W_G(G8_RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE, 1);
+	for (uint32_t pipe = PIPE_BR; pipe <= PIPE_DDE_BV; pipe++) {
+		if (pipe == PIPE_LPAC) {
+			continue;
+		}
+		aperture(pipe);
+		/* A8XX_APRIV_MASK (icache, rb fetch, rb privileged, rptr writeback); BR also the crash dumper's read / write */
+		W_G(G8_CP_APRIV_CNTL_PIPE, pipe == PIPE_BR ? 0x6f : 0x0f);
+	}
+	aperture(PIPE_NONE);
+	W_G64(G8_CP_SQE_INSTR_BASE, "CP_SQE_INSTR_BASE", SQE_IOVA);
+	W_G64(G8_CP_RB_BASE, "CP_RB_BASE", RING_IOVA);
+	W_G(G8_CP_RB_CNTL, 12u | 2u << 8);      /* MSM_GPU_RB_CNTL_DEFAULT */
+	W_G64(G8_CP_RB_RPTR_ADDR, "CP_RB_RPTR_ADDR", SCRATCH_IOVA);
+	W_G64(G8_CP_RB_RPTR_ADDR_BV, "CP_RB_RPTR_ADDR_BV", SCRATCH_IOVA + 0x40);
+	if (core_faulted("hw_init")) {
+		return false;
+	}
+
+	say("core: the SQE started\n");
+	core_sqe_on = true;
+	W_G(G8_CP_SQE_CNTL, 1);
+	sleep_ms(20);
+	say("core: after the SQE start: status %#x int0 %#x rptr %u\n", G(G8_RBBM_STATUS), G(G8_RBBM_INT_0_STATUS),
+	    G(G8_CP_RB_RPTR));
+
+	/* a8xx_cp_init */
+	ring_at = 0;
+	ring_pkt7(CP_THREAD_CONTROL, 1);
+	ring(1u << 27);
+	ring_pkt7(CP_ME_INIT, 7);
+	ring(1u << 0 | 1u << 1 | 1u << 3 | 1u << 6 | 1u << 8);
+	ring(0x00000003);
+	ring(0x20000000);
+	ring(0x00000002);
+	ring(PWRUP_IOVA);
+	ring(0);
+	ring(1u << 31);
+	if (!ring_run("CP_ME_INIT")) {
+		return false;
+	}
+	say("THE COMMAND PROCESSOR RUNS (CP_ME_INIT done)\n");
+
+	/* a6xx_zap_shader_init, then CP_SET_SECURE_MODE 0, then GMEM protection */
+	if (!zap_load()) {
+		return false;
+	}
+	ring_pkt7(CP_SET_SECURE_MODE, 1);
+	ring(0);
+	if (!ring_run("CP_SET_SECURE_MODE 0")) {
+		return false;
+	}
+	aperture(PIPE_BR);
+	W_G(G8_RB_GC_GMEM_PROTECT, GMEM_PROTECT_A840);
+	aperture(PIPE_NONE);
+	say("OUT OF SECURE MODE\n");
+	if (stage5) {
+		(void)hw_clock_gating();        /* hw_init's last step: a8xx_set_hwcg(true) */
+		irq_on();
+	}
+
+	/* the first fence: CP_NOP, a word by CP_MEM_WRITE, the fence by CP_EVENT_WRITE7 (CACHE_CLEAN, user 32-bit to RAM) */
+	scratch[TEST_OFF / 4] = 0;
+	scratch[FENCE_OFF / 4] = 0;
+	to_memory(core_scratch.va, SCRATCH_SIZE);
+	ring_pkt7(CP_NOP, 0);
+	ring_pkt7(CP_MEM_WRITE, 3);
+	ring(SCRATCH_IOVA + TEST_OFF);
+	ring(0);
+	ring(TEST_VALUE);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_EVENT_WRITE7, 4);
+	ring(EV_CACHE_CLEAN | EV7_WRITE_ENABLED);
+	ring(SCRATCH_IOVA + FENCE_OFF);
+	ring(0);
+	ring(FENCE_VALUE);
+	if (!ring_run("CP_NOP + CP_MEM_WRITE + CP_EVENT_WRITE7 fence")) {
+		return false;
+	}
+	for (int i = 0; i < 100; i++) {
+		to_memory(core_scratch.va, SCRATCH_SIZE);
+		if (scratch[FENCE_OFF / 4] == FENCE_VALUE) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	say("core: test word %#x (%s), fence %#x (%s), rptr shadow %u\n", scratch[TEST_OFF / 4],
+	    scratch[TEST_OFF / 4] == TEST_VALUE ? "written" : "NOT written", scratch[FENCE_OFF / 4],
+	    scratch[FENCE_OFF / 4] == FENCE_VALUE ? "signalled" : "NOT signalled", scratch[0]);
+	if (scratch[TEST_OFF / 4] != TEST_VALUE || scratch[FENCE_OFF / 4] != FENCE_VALUE) {
+		core_state("fence");
+		return false;
+	}
+	say("FIRST FENCE BACK: THE 3D CORE RAN OUR COMMANDS (word %#x, fence %u)\n", TEST_VALUE, FENCE_VALUE);
+	if (stage5) {
+		if (!ib_test()) {
+			return false;
+		}
+		if (!core_unmap_page(IB_IOVA)) {
+			say("core: per-page TLB invalidation of %#x: NOT FINISHED\n", IB_IOVA);
+			return false;
+		}
+		say("core: page %#x unmapped, bank 0's TLB entry invalidated (TLBIVA + sync)\n", IB_IOVA);
+	}
+	return true;
+}
+
+/* the core stopped: a8xx_bus_clear_pending_transactions (GX on), the SQE off, the zap given up, OOB GPU cleared */
+static void
+core_down(void)
+{
+	uint64_t answer = 0;
+
+	core_live = false;              /* (from here core_down's own way; loader_return's quiesce keeps out) */
+	irq_off();
+	if (core_sqe_on && gmu_readable() && (G(G8_GMU_PWR_CLK_STATUS) & 3) == 0) {
+		say("core: down: GBIF halted, SQE off\n");
+		W_G(G8_GBIF_HALT, GBIF_CLIENT_HALT);
+		if (!wait_bits(gpu + 4UL * G8_GBIF_HALT_ACK, GBIF_CLIENT_HALT, GBIF_CLIENT_HALT, 100000)) {
+			say("core: GBIF client halt not acknowledged (%#x)\n", G(G8_GBIF_HALT_ACK));
+		}
+		W_G(G8_GBIF_HALT, GBIF_ARB_HALT);
+		if (!wait_bits(gpu + 4UL * G8_GBIF_HALT_ACK, GBIF_ARB_HALT, GBIF_ARB_HALT, 100000)) {
+			say("core: GBIF arbiter halt not acknowledged (%#x)\n", G(G8_GBIF_HALT_ACK));
+		}
+		W_G(G8_GBIF_HALT, 0);
+		W_G(G8_CP_SQE_CNTL, 0);
+	}
+	core_sqe_on = false;
+	if (zap_loaded) {
+		int32_t r = scm(1ull << 30 | 2ull << 24 | 2u << 8 | 6, 1, PAS_GPU, &answer);
+
+		say("zap: TZ shutdown (13): returns %d, answer %#llx\n", r, answer);
+		zap_loaded = false;
+	}
+	if (core_oob && gmu_readable()) {
+		W_G(G8_GMU_HOST2GMU_INTR_SET, OOB_GPU_CLEAR);
+	}
+	core_oob = false;
+}
+
+/* ---- stage 6: per-process address spaces, a submit / wait API, fences waited on the interrupt ---------------------- */
+
+/*
+ * The base for a later IOKit user client / Turnip back end, run here by the kit's own self-test.
+ *
+ * Address spaces (the method: data-a-live's per-client windows and ArmSmmu4K's 4 KB stage-1 tables, MIT; no code of
+ * theirs copied; the mechanism Linux's a6xx_set_pagetable): each space has its own root table and ASID (2.. ; the
+ * kernel's bank-0 tables are ASID 0, the GMU's bank ASID 1). Root entries 0 and 1 (0..2 GB: the GMU's and the core's
+ * kernel blocks, ring, SQE, scratch) are the kernel root's own, shared, so the CP keeps its ring in every space; a space
+ * maps only inside its 4 GB window [4 GB, 8 GB) -- the same addresses in every space, different pages. Pages are 4 KB,
+ * PTE_CORE (+ read-only on request); an unmap clears the PTE and invalidates that page for that ASID (TLBIVA). The CP
+ * switches spaces itself: CP_SMMU_TABLE_UPDATE (TTBR0 + ASID, bank 0) after TrustZone opened the CP's SMMU aperture
+ * for bank 0 (adreno_hw_init: qcom_scm_set_gpu_smmu_aperture(0), SiP service 0xc command 0x1b).
+ *
+ * Submission: one ring (ring 0), one global fence counter. hakios_iceland_gpu_submit(space, IBs) puts, if the space
+ * differs from the ring's current one, the table switch (Linux's a6xx_set_pagetable for a8xx, without the perfcounter
+ * SRAM init: CP_WAIT_FOR_IDLE in place of CP_WAIT_TIMESTAMP, CP_THREAD_CONTROL sync both, CP_SMMU_TABLE_UPDATE,
+ * CP_THREAD_CONTROL sync BR, CP_EVENT_WRITE 0x31), then each IB (CP_INDIRECT_BUFFER), then CP_EVENT_WRITE7
+ * (CACHE_CLEAN, write fence to memory, IRQ), and moves WPTR; it returns the fence number. hakios_iceland_gpu_wait(fence,
+ * ms) sleeps on the interrupt (GIC SPI 300) and re-checks every 10 ms (a wakeup lost between check and sleep).
+ *
+ * Kept powered between submissions: no IFPC / slumber after hw_init, so the GMU keeps GX on until the way down. Idle
+ * power collapse (IFPC: HFI feature + the a840 power-up / IFPC register lists the GMU restores after collapsing GX, and
+ * fenced register writes around it) is stage 7.
+ */
+/*
+ * Address spaces at once. Was 8 everywhere. On macOS every process that makes a Metal device holds one for as long as
+ * the device lives (AGXDeviceUserClient::mount), and the desktop after a login asks for more than 8: run w2-login-2 had
+ * RedwoodGPU, WindowServer, SecurityAgent, iconservicesagent, VTDecoderXPCService, loginwindow, AccessibilityVisual and
+ * MenuBarAgent on the 8, and "NotificationCenter opens type 0x4147: refused (no GPU space)" at 413.4 s. A space costs
+ * its struct here (about 41 KB; macOS allocates the array at init) and the tables its own mappings need. The ASID is
+ * 2 + the index, so it stays far below the 8-bit limit.
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#define SPACES_MAX              32
+#else
+#define SPACES_MAX              8
+#endif
+/*
+ * Tables a space may need for its whole 4 GB window: the root, 4 level-2 tables (1 GB each), 2048 level-3 tables (2 MB
+ * each). Was 64 (about 120 MB of mappings): ipad14m's Metal sweep ran out of it ("a buffer of 8388608 bytes cannot be
+ * entered into the GPU's address space", m2v "OutOfMemory(Device)" at 75 MiB held, no 1125x2436 target). Tables are
+ * found by address (l2_at / l3_at), not by searching their list.
+ */
+#define SPACE_TABLES            (1 + 4 + 2048)
+#define SPACE_L3                2048
+#define WINDOW_BASE             0x100000000ull
+#define WINDOW_SIZE             0x100000000ull
+#define SPACE_KERNEL            0xffffffffu
+#define CP_SMMU_TABLE_UPDATE    0x53u
+#define CP_EVENT_WRITE          0x46u
+#define CACHE_INVALIDATE_EV     0x31u           /* a6xx_set_pagetable's CP_EVENT_WRITE CACHE_INVALIDATE, as Linux sends it */
+#define THREAD_SYNC             (1u << 31)
+#define THREAD_BR               1u
+#define THREAD_BOTH             3u
+#define FENCE_START             16u
+
+struct gspace {
+	bool used;
+	uint32_t asid;
+	unsigned n;
+	vm_offset_t pages[(SPACE_TABLES + TABLES_PER_GROUP - 1) / TABLES_PER_GROUP];
+	uint64_t *t[SPACE_TABLES];
+	uint64_t pa[SPACE_TABLES];
+	int16_t l2_at[8];                       /* by iova >> 30 (4..7 in the window): table index + 1, 0 none */
+	int16_t l3_at[SPACE_L3];                /* by (iova - WINDOW_BASE) >> 21: table index + 1, 0 none */
+};
+#if defined(XNU_TARGET_OS_OSX)
+/* (macOS: allocated in hakios_iceland_gpu_init; the collection's __DATA has no room) */
+static struct gspace *spaces;
+#else
+static struct gspace spaces[SPACES_MAX];
+#endif
+static LCK_GRP_DECLARE(icegpu_group, "iceland-gpu");
+static LCK_MTX_DECLARE(icegpu_submit_lock, &icegpu_group);
+static uint32_t cur_space = SPACE_KERNEL, last_fence, aperture_ok, api_up;
+static uint32_t waits_irq, waits_poll;
+static uint32_t api_quiet, api_quiet_unmaps;    /* RedwoodGPU's many submissions / unmaps: a line every 256th */
+
+int hakios_iceland_gpu_space_create(uint32_t *space);
+int hakios_iceland_gpu_map(uint32_t space, uint64_t gpuva, uint64_t pa, uint64_t size, bool read_only);
+int hakios_iceland_gpu_unmap(uint32_t space, uint64_t gpuva, uint64_t size);
+void hakios_iceland_gpu_space_destroy(uint32_t space);
+int hakios_iceland_gpu_submit(uint32_t space, const uint64_t *ib, const uint32_t *dwords, uint32_t n, uint32_t *fence);
+int hakios_iceland_gpu_wait(uint32_t fence, uint32_t ms);
+
+static int
+space_table(struct gspace *s)
+{
+	if (s->n == SPACE_TABLES) {
+		return -1;
+	}
+	if (s->n % TABLES_PER_GROUP == 0 &&
+	    kmem_alloc(kernel_map, &s->pages[s->n / TABLES_PER_GROUP], TABLES_PER_GROUP * TABLE_BYTES,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	s->t[s->n] = (uint64_t *)(s->pages[s->n / TABLES_PER_GROUP] +
+	    TABLE_BYTES * (s->n % TABLES_PER_GROUP));
+	s->pa[s->n] = kvtophys((vm_offset_t)s->t[s->n]);
+	to_memory((vm_offset_t)s->t[s->n], 4096);      /* (its zeros in memory before an entry points the SMMU at it) */
+	return (int)s->n++;
+}
+
+/* the level-3 table of a window address (made, with its level-2 table, when `make`); -1: none / no room */
+static int
+space_l3(struct gspace *s, uint64_t iova, bool make)
+{
+	unsigned k2 = (unsigned)(iova >> 30) & 7, k3 = (unsigned)((iova - WINDOW_BASE) >> 21);
+	int t2, t3;
+
+	if (iova < WINDOW_BASE || iova >= WINDOW_BASE + WINDOW_SIZE) {
+		return -1;
+	}
+	if (s->l2_at[k2] == 0) {
+		if (!make || (t2 = space_table(s)) < 0) {
+			return -1;
+		}
+		s->t[0][iova >> 30 & 0x1ff] = s->pa[t2] | PTE_VALID;
+		to_memory((vm_offset_t)&s->t[0][iova >> 30 & 0x1ff], 8);
+		s->l2_at[k2] = (int16_t)(t2 + 1);
+	}
+	t2 = s->l2_at[k2] - 1;
+	if (s->l3_at[k3] == 0) {
+		if (!make || (t3 = space_table(s)) < 0) {
+			return -1;
+		}
+		s->t[t2][iova >> 21 & 0x1ff] = s->pa[t3] | PTE_VALID;
+		to_memory((vm_offset_t)&s->t[t2][iova >> 21 & 0x1ff], 8);
+		s->l3_at[k3] = (int16_t)(t3 + 1);
+	}
+	return s->l3_at[k3] - 1;
+}
+
+static struct gspace *
+space_get(uint32_t id)
+{
+#if defined(XNU_TARGET_OS_OSX)
+	if (spaces == NULL) {
+		return NULL;
+	}
+#endif
+	return id < SPACES_MAX && spaces[id].used ? &spaces[id] : NULL;
+}
+
+int
+hakios_iceland_gpu_space_create(uint32_t *id)
+{
+	struct gspace *s = NULL;
+	uint32_t i;
+
+#if defined(XNU_TARGET_OS_OSX)
+	if (!api_up || spaces == NULL) {
+#else
+	if (!api_up) {
+#endif
+		return -1;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	for (i = 0; i < SPACES_MAX && s == NULL; i++) {
+		if (!spaces[i].used) {
+			s = &spaces[i];
+		}
+	}
+	if (s == NULL) {
+		lck_mtx_unlock(&icegpu_submit_lock);
+		return -1;
+	}
+	bzero(s, sizeof(*s));
+	if (space_table(s) != 0) {
+		lck_mtx_unlock(&icegpu_submit_lock);
+		return -1;
+	}
+	s->t[0][0] = tables[0][0];              /* 0..1 GB and 1..2 GB: the kernel's blocks, shared */
+	s->t[0][1] = tables[0][1];
+	to_memory((vm_offset_t)s->t[0], 4096);
+	s->used = true;
+	s->asid = 2 + (uint32_t)(s - spaces);
+	*id = (uint32_t)(s - spaces);
+	lck_mtx_unlock(&icegpu_submit_lock);
+	say("api: space %u created: ASID %u, root %#llx, window %#llx..%#llx\n", *id, s->asid, s->pa[0], WINDOW_BASE,
+	    WINDOW_BASE + WINDOW_SIZE);
+	return 0;
+}
+
+/*
+ * Page tables written but not yet pushed out of the CPU's cache (the SMMU walks them in memory). RedwoodGPU maps a buffer
+ * page by page and then says so (redwood_gpu_mapped): one cache push per touched table then, instead of one clean + DSB per
+ * page (ipad14p: a 3392x2400 surface is 8100 pages, taken ~19 times a second, 3.4 ms each). With icegpu_submit_lock held;
+ * also pushed before any submission and any unmap.
+ */
+#define PEND_MAX                64
+static struct gspace *pend_s;
+static int16_t pend_t[PEND_MAX];
+static unsigned pend_n;
+
+static void
+pend_flush(void)
+{
+	for (unsigned i = 0; i < pend_n; i++) {
+		to_memory((vm_offset_t)pend_s->t[pend_t[i]], 4096);
+	}
+	pend_n = 0;
+	pend_s = NULL;
+}
+
+static void
+pend_add(struct gspace *s, int t)
+{
+	if (pend_s != s || pend_n == PEND_MAX) {
+		pend_flush();
+		pend_s = s;
+	}
+	if (pend_n == 0 || pend_t[pend_n - 1] != t) {
+		for (unsigned i = 0; i < pend_n; i++) {
+			if (pend_t[i] == t) {
+				return;
+			}
+		}
+		pend_t[pend_n++] = (int16_t)t;
+	}
+}
+
+static int
+space_map(uint32_t id, uint64_t va, uint64_t pa, uint64_t size, bool read_only, bool defer)
+{
+	struct gspace *s = space_get(id);
+	int rc = 0;
+
+	if (s == NULL || (va & 0xfff) || (pa & 0xfff) || (size & 0xfff) || va < WINDOW_BASE ||
+	    va + size > WINDOW_BASE + WINDOW_SIZE) {
+		return -1;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	for (uint64_t off = 0; off < size && rc == 0; off += 4096) {
+		uint64_t iova = va + off;
+		int t = space_l3(s, iova, true);
+
+		if (t < 0) {
+			rc = -1;
+			say("api: space %u: no table for %#llx (%u of %u tables in use)\n", id, iova, s->n, SPACE_TABLES);
+		}
+		if (rc == 0) {
+			s->t[t][iova >> 12 & 0x1ff] = ((pa + off) & PTE_ADDR) | PTE_CORE | (read_only ? PTE_READ_ONLY : 0) | PTE_VALID;
+			if (defer) {
+				pend_add(s, t);
+			} else {
+				to_memory((vm_offset_t)&s->t[t][iova >> 12 & 0x1ff], 8);
+			}
+		}
+	}
+	lck_mtx_unlock(&icegpu_submit_lock);
+	return rc;
+}
+
+int
+hakios_iceland_gpu_map(uint32_t id, uint64_t va, uint64_t pa, uint64_t size, bool read_only)
+{
+	return space_map(id, va, pa, size, read_only, false);
+}
+
+/* one 4 KB page of a space's ASID out of bank 0's TLB (TLBIVA: VA >> 12 | ASID << 48), then sync */
+static bool
+tlb_inv_page_asid(uint64_t iova, uint32_t asid)
+{
+	uint64_t v = iova >> 12 | (uint64_t)asid << 48;
+	vm_offset_t a = smmu + SMMU_CB(0) + 0x600;
+
+	__asm__ volatile ("str %0, [%1]" : : "r" (v), "r" (a) : "memory");
+	wr(smmu + SMMU_CB(0) + CB_TLBSYNC, 0);
+	writes += 2;
+	return wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000);
+}
+
+int
+hakios_iceland_gpu_unmap(uint32_t id, uint64_t va, uint64_t size)
+{
+	struct gspace *s = space_get(id);
+	uint32_t pages = 0, slow = 0;
+
+	if (s == NULL || (va & 0xfff) || (size & 0xfff) || va < WINDOW_BASE || va + size > WINDOW_BASE + WINDOW_SIZE) {
+		return -1;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	pend_flush();
+	if (size > 16 * 4096) {
+		/*
+		 * a big buffer: every PTE cleared, each touched table pushed out of the cache once, then every page's TLBIVA
+		 * queued and one TLBSYNC after the last (arm_smmu_tlb_inv_range_s1's way)
+		 */
+		for (uint64_t off = 0; off < size; off += 4096) {
+			uint64_t iova = va + off;
+			int t = space_l3(s, iova, false);
+
+			if (t < 0 || !(s->t[t][iova >> 12 & 0x1ff] & 1)) {
+				continue;
+			}
+			s->t[t][iova >> 12 & 0x1ff] = 0;
+			pend_add(s, t);
+			pages++;
+		}
+		pend_flush();
+		for (uint64_t off = 0; pages != 0 && off < size; off += 4096) {
+			uint64_t v = (va + off) >> 12 | (uint64_t)s->asid << 48;
+			vm_offset_t a = smmu + SMMU_CB(0) + 0x600;
+
+			__asm__ volatile ("str %0, [%1]" : : "r" (v), "r" (a) : "memory");
+			writes++;
+		}
+	}
+	for (uint64_t off = 0; size <= 16 * 4096 && off < size; off += 4096) {
+		uint64_t iova = va + off;
+		int t = space_l3(s, iova, false);
+
+		if (t < 0 || !(s->t[t][iova >> 12 & 0x1ff] & 1)) {
+			continue;
+		}
+		s->t[t][iova >> 12 & 0x1ff] = 0;
+		to_memory((vm_offset_t)&s->t[t][iova >> 12 & 0x1ff], 8);
+		slow += !tlb_inv_page_asid(iova, s->asid);
+		pages++;
+	}
+	if (size > 16 * 4096 && pages != 0) {
+		wr(smmu + SMMU_CB(0) + CB_TLBSYNC, 0);
+		writes++;
+		slow += !wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000);
+	}
+	lck_mtx_unlock(&icegpu_submit_lock);
+	if (api_quiet && ++api_quiet_unmaps % 256 != 1) {
+		return slow ? -1 : 0;
+	}
+	say("api: space %u: %u pages unmapped from %#llx, each invalidated (TLBIVA ASID %u)%s; %u writes (CB0_TLBIVA, "
+	    "CB0_TLBSYNC) not listed one by one\n", id, pages, va, s->asid, slow ? ", A SYNC DID NOT FINISH" : "", 2 * pages);
+	return slow ? -1 : 0;
+}
+
+static bool
+ring_room(uint32_t words)
+{
+	for (int i = 0; i < 10000; i++) {
+		uint32_t rptr = G(G8_CP_RB_RPTR), room = (rptr + RING_WORDS - ring_at - 1) % RING_WORDS;
+
+		if (room >= words) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return false;
+}
+
+static void
+ring_table_switch(uint64_t ttbr, uint32_t asid)
+{
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt7(CP_THREAD_CONTROL, 1);
+	ring(THREAD_SYNC | THREAD_BOTH);
+	ring_pkt7(CP_SMMU_TABLE_UPDATE, 4);
+	ring((uint32_t)ttbr);
+	ring(((uint32_t)(ttbr >> 32) & 0xffff) | asid << 16);
+	ring(0);                                /* CONTEXTIDR: unused with AArch64 tables */
+	ring(0);                                /* CONTEXTBANK 0 */
+	ring_pkt7(CP_THREAD_CONTROL, 1);
+	ring(THREAD_SYNC | THREAD_BR);
+	ring_pkt7(CP_EVENT_WRITE, 1);
+	ring(CACHE_INVALIDATE_EV);
+}
+
+/* the ring to the core: pushed out of the cache, WPTR moved (logged), not waited for */
+static void
+ring_kick(void)
+{
+	to_memory(core_ring.va, RING_SIZE);
+	settle();
+	wr(gpu + 4UL * G8_CP_RB_WPTR, ring_at);
+	writes++;
+}
+
+/*
+ * Turnip's command buffers (RedwoodGPU, `full`): Linux's a7xx_submit (which a8xx uses) for one ring -- run with both CP
+ * threads (CP_THREAD_CONTROL BOTH) and IFPC off (CP_SET_MARKER 0x101) around the IBs, then CCU invalidates on BR, the BV
+ * thread's own fence, BR waiting for it (CP_WAIT_TIMESTAMP), the fence with its interrupt, both threads and IFPC on
+ * again; hakios_dada_gpu.c's dada_gpu_submit is the same. Run ipad14h: with only BR selected (the plain sequence, which
+ * the kit's own one-packet IBs are content with) Turnip's first IB never finished: rptr inside it, no fault.
+ */
+#define CP_SET_MARKER_OP        0x65u
+#define CP_WAIT_TIMESTAMP_OP    0x14u
+#define THREAD_BV               2u
+#define EV_CCU_INVALIDATE_DEPTH 0x18u
+#define EV_CCU_INVALIDATE_COLOR 0x19u
+#define BV_FENCE_OFF            (FENCE_OFF + 8)
+static uint64_t last_ib_iova;
+static uint32_t last_ib_dwords, last_ib_space = ~0u;
+
+static int submit_ex(uint32_t id, const uint64_t *ib, const uint32_t *dwords, uint32_t n, uint32_t *fence, bool full);
+
+int
+hakios_iceland_gpu_submit(uint32_t id, const uint64_t *ib, const uint32_t *dwords, uint32_t n, uint32_t *fence)
+{
+	return submit_ex(id, ib, dwords, n, fence, false);
+}
+
+static int
+submit_ex(uint32_t id, const uint64_t *ib, const uint32_t *dwords, uint32_t n, uint32_t *fence, bool full)
+{
+	struct gspace *s = id == SPACE_KERNEL ? NULL : space_get(id);
+	uint32_t need = 16 + 4 * n + 5 + (full ? 40 : 0);
+
+	if (!api_up || n > 128 || (id != SPACE_KERNEL && s == NULL) || (id != SPACE_KERNEL && !aperture_ok)) {
+		return -1;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	pend_flush();                           /* (tables written for this submission's buffers reach memory first) */
+	if (!ring_room(need)) {
+		lck_mtx_unlock(&icegpu_submit_lock);
+		say("api: the ring stays full (rptr %u, wptr %u)\n", G(G8_CP_RB_RPTR), ring_at);
+		return -2;                      /* (g6b: the ABI's kIOReturnBusy; every other caller tests != 0) */
+	}
+	if (full) {
+		ring_pkt7(CP_THREAD_CONTROL, 1);
+		ring(THREAD_SYNC | THREAD_BR);
+	}
+	if (id != cur_space) {
+		ring_table_switch(s != NULL ? s->pa[0] : table_pa[0], s != NULL ? s->asid : 0);
+		cur_space = id;
+	}
+	if (full) {
+		ring_pkt7(CP_THREAD_CONTROL, 1);
+		ring(THREAD_BOTH);
+		ring_pkt7(CP_SET_MARKER_OP, 1);
+		ring(0x101);                    /* IFPC off */
+		if (n > 0) {
+			last_ib_iova = ib[0];
+			last_ib_dwords = dwords[0];
+			last_ib_space = id;
+		}
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		ring_pkt7(CP_INDIRECT_BUFFER_OP, 3);
+		ring((uint32_t)ib[i]);
+		ring((uint32_t)(ib[i] >> 32));
+		ring(dwords[i] & 0xfffff);
+	}
+	*fence = ++last_fence;
+	gt_sub[*fence % GT_SLOTS] = mach_absolute_time();
+	if (full) {
+		ring_pkt7(CP_THREAD_CONTROL, 1);
+		ring(THREAD_BR);
+		ring_pkt7(CP_EVENT_WRITE7, 1);
+		ring(EV_CCU_INVALIDATE_DEPTH);
+		ring_pkt7(CP_EVENT_WRITE7, 1);
+		ring(EV_CCU_INVALIDATE_COLOR);
+		ring_pkt7(CP_THREAD_CONTROL, 1);
+		ring(THREAD_BV);
+		ring_pkt7(CP_EVENT_WRITE7, 4);
+		ring(EV_CACHE_CLEAN | EV7_WRITE_ENABLED);
+		ring(SCRATCH_IOVA + BV_FENCE_OFF);
+		ring(0);
+		ring(*fence);
+		ring_pkt7(CP_THREAD_CONTROL, 1);
+		ring(THREAD_BR);
+		ring_pkt7(CP_WAIT_TIMESTAMP_OP, 4);
+		ring(0);
+		ring(SCRATCH_IOVA + BV_FENCE_OFF);
+		ring(0);
+		ring(*fence);
+	}
+	ring_pkt7(CP_EVENT_WRITE7, 4);
+	ring(EV_CACHE_CLEAN | EV7_WRITE_ENABLED | EV7_IRQ);
+	ring(SCRATCH_IOVA + FENCE_OFF);
+	ring(0);
+	ring(*fence);
+	if (full) {
+		ring_pkt7(CP_THREAD_CONTROL, 1);
+		ring(THREAD_BOTH);
+		ring_pkt7(CP_SET_MARKER_OP, 1);
+		ring(0x100);                    /* IFPC on (the GMU has it off: no IFPC feature sent) */
+	}
+	ring_kick();
+	lck_mtx_unlock(&icegpu_submit_lock);
+	if (!api_quiet || *fence % 256 == 0) {
+		say("api: submit to space %d: %u IB(s), fence %u, w CP_RB_WPTR @%#llx -> %u\n", id == SPACE_KERNEL ? -1 : (int)id,
+		    n, *fence, (uint64_t)GPU_PHYS + 4UL * G8_CP_RB_WPTR, ring_at);
+	}
+	return 0;
+}
+
+int
+hakios_iceland_gpu_wait(uint32_t fence, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		wait_result_t wr_;
+		volatile uint32_t *view = fence_view;
+
+		if (!api_up || view == NULL) {
+			return -1;              /* the API went down while this waited (api_down wakes the waiters first) */
+		}
+		if ((int32_t)(view[FENCE_OFF / 4] - fence) >= 0) {
+			return 0;
+		}
+		if (mach_absolute_time() > deadline) {
+			return -1;
+		}
+		assert_wait_timeout((event_t)&fence_event, THREAD_UNINT, 10, NSEC_PER_MSEC);
+		wr_ = thread_block(THREAD_CONTINUE_NULL);
+		if (wr_ == THREAD_AWAKENED) {
+			waits_irq++;
+		} else {
+			waits_poll++;
+		}
+	}
+}
+
+/*
+ * render1 (21 Nov): the fence waits' counters for icerender= (osfmk/arm64/hakios_memtel.c): GPU interrupts, whether the
+ * line was masked (then every wait polls at 10 ms), waits woken by the interrupt and by the 10 ms re-check. Reads only.
+ */
+void hakios_iceland_gpu_waitstat(uint32_t *irqs, uint32_t *masked, uint32_t *woken, uint32_t *polled);
+void
+hakios_iceland_gpu_waitstat(uint32_t *irqs, uint32_t *masked, uint32_t *woken, uint32_t *polled)
+{
+	*irqs = irq_count;
+	*masked = irq_masked;
+	*woken = waits_irq;
+	*polled = waits_poll;
+}
+
+void
+hakios_iceland_gpu_space_destroy(uint32_t id)
+{
+	struct gspace *s = space_get(id);
+	uint32_t f;
+
+	if (s == NULL) {
+		return;
+	}
+	if (cur_space == id) {
+		/* the ring back on the kernel's tables before these go */
+		if (hakios_iceland_gpu_submit(SPACE_KERNEL, NULL, NULL, 0, &f) != 0 || hakios_iceland_gpu_wait(f, 1000) != 0) {
+			say("api: space %u: the ring does not come back to the kernel's tables: its tables are kept\n", id);
+			return;
+		}
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	if (pend_s == s) {
+		pend_n = 0;                     /* (its tables go: nothing of theirs is pushed later) */
+		pend_s = NULL;
+	}
+	wr(smmu + SMMU_CB(0) + CB_TLBIASID, s->asid);
+	wr(smmu + SMMU_CB(0) + CB_TLBSYNC, 0);
+	writes += 2;
+	(void)wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000);
+	for (unsigned i = 0; i < (s->n + TABLES_PER_GROUP - 1) / TABLES_PER_GROUP; i++) {
+		kmem_free(kernel_map, s->pages[i], TABLES_PER_GROUP * TABLE_BYTES);
+	}
+	s->used = false;
+	lck_mtx_unlock(&icegpu_submit_lock);
+	say("api: space %u destroyed (ASID %u invalidated: CB0_TLBIASID + CB0_TLBSYNC written)\n", id, s->asid);
+}
+
+#if defined(XNU_TARGET_OS_OSX)
+/*
+ * S11 g6b-1: the GPU half of AGXDeviceUserClient (iokit/Kernel/AGXAccelerator.cpp, NativeAdreno ABI v2). The client is
+ * IOKit's; spaces, maps, the ring and its fences stay the stage-6 API above (one space per connection, ASID 2..). These
+ * add only what the client needs beyond it: Turnip's submission form (submit_ex `full`, RedwoodGPU's), a buffer's 4 KB
+ * pages entered with one table push, a fence looked at without sleeping, the GMU's always-on counter (Linux a2e1ea44d3c3
+ * a8xx_gpu.c:1441-1443 reads it high, low, high) and the device facts (below). Every call refuses while the API is down.
+ */
+bool hakios_iceland_gpu_agx_up(void);
+int hakios_iceland_gpu_agx_map(uint32_t id, uint64_t va, const uint64_t *pa, uint32_t pages, bool read_only);
+int hakios_iceland_gpu_agx_submit(uint32_t id, const uint64_t *ib, const uint32_t *dwords, uint32_t n, uint32_t *fence);
+bool hakios_iceland_gpu_agx_done(uint32_t fence);
+uint32_t hakios_iceland_gpu_agx_last(void);
+uint32_t hakios_iceland_gpu_agx_retired(void);
+uint64_t hakios_iceland_gpu_agx_ticks(void);
+void hakios_iceland_gpu_agx_facts(uint32_t *chip, uint64_t *gmem_base, uint64_t *trap, uint64_t *va_start, uint64_t *va_size);
+extern void agx_probe_window(void);     /* AGXAccelerator.cpp: the probe's window for the client's self-test (icegpu_run) */
+
+bool
+hakios_iceland_gpu_agx_up(void)
+{
+	return api_up && aperture_ok && fence_view != NULL;
+}
+
+int
+hakios_iceland_gpu_agx_map(uint32_t id, uint64_t va, const uint64_t *pa, uint32_t pages, bool read_only)
+{
+	int rc = 0;
+	uint32_t i = 0;
+
+	if (!hakios_iceland_gpu_agx_up() || space_get(id) == NULL || pages == 0) {
+		return -1;
+	}
+	while (i < pages && rc == 0) {
+		uint32_t n = 1;
+
+		while (i + n < pages && pa[i + n] == pa[i] + 4096ull * n) {
+			n++;                    /* (a physically contiguous run: one call) */
+		}
+		rc = space_map(id, va + 4096ull * i, pa[i], 4096ull * n, read_only, true);
+		i += n;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	pend_flush();                           /* (the tables in memory before the map is answered) */
+	lck_mtx_unlock(&icegpu_submit_lock);
+	if (rc != 0) {
+		(void)hakios_iceland_gpu_unmap(id, va, 4096ull * i);
+	}
+	return rc;
+}
+
+/*
+ * g6b-2 diagnostic switch iceagx_full=0|1 (default 1): 1 is Turnip's submission form (submit_ex `full`: the BR/BV threads,
+ * the IFPC markers, the BV fence and CP_WAIT_TIMESTAMP), 0 the kit's own plain form, as the stage-6 API's own submits
+ * (hakios_iceland_gpu_submit). Off the default only to tell the form's part in a run: Turnip's IBs need the full form
+ * (ipad14h, above), the client self-test's CP_MEM_WRITEs do not.
+ */
+static bool
+agx_full_form(void)
+{
+	static int full = -1;
+
+	if (full < 0) {
+		uint32_t v = 1;
+
+		PE_parse_boot_argn("iceagx_full", &v, sizeof(v));
+		full = v != 0;
+		if (!full) {
+			printf("icegpu: agx: iceagx_full=0: the client's submissions take the kit's plain form\n");
+		}
+	}
+	return full != 0;
+}
+
+int
+hakios_iceland_gpu_agx_submit(uint32_t id, const uint64_t *ib, const uint32_t *dwords, uint32_t n, uint32_t *fence)
+{
+	if (!hakios_iceland_gpu_agx_up() || id == SPACE_KERNEL || n == 0) {
+		return -1;
+	}
+	return submit_ex(id, ib, dwords, n, fence, agx_full_form());
+}
+
+bool
+hakios_iceland_gpu_agx_done(uint32_t fence)
+{
+	volatile uint32_t *view = fence_view;
+
+	return api_up && view != NULL && (int32_t)(view[FENCE_OFF / 4] - fence) >= 0;
+}
+
+uint32_t
+hakios_iceland_gpu_agx_last(void)
+{
+	return last_fence;
+}
+
+/* w2-vsync: the last fence the GPU wrote back (0 while the API is down), for the display's wait before its CPU copy */
+uint32_t
+hakios_iceland_gpu_agx_retired(void)
+{
+	volatile uint32_t *view = fence_view;
+
+	return api_up && view != NULL ? view[FENCE_OFF / 4] : 0;
+}
+
+uint64_t
+hakios_iceland_gpu_agx_ticks(void)
+{
+	uint32_t hi, lo;
+
+	if (!api_up || !gmu_readable()) {
+		return 0;
+	}
+	do {
+		hi = G(G8_GMU_ALWAYS_ON_COUNTER_H);
+		lo = G(G8_GMU_ALWAYS_ON_COUNTER_L);
+	} while (hi != G(G8_GMU_ALWAYS_ON_COUNTER_H));
+	return (uint64_t)hi << 32 | lo;
+}
+
+/*
+ * GetDeviceInfo's facts that live here: the chip id the power-up read (DT 0x44050a01 with the slice count in bits 7:4,
+ * Fedora 0x44050a31), the GMEM range base SZ_64M (Linux a2e1ea44d3c3 adreno_gpu.c:386-388 for gen8, a8xx_gpu.c:726-729) and
+ * the UCHE trap base (a6xx_gpu.c:2821, a8xx_gpu.c:732-735) this kit programs, and a space's window [4 GB, 8 GB).
+ */
+void
+hakios_iceland_gpu_agx_facts(uint32_t *chip, uint64_t *gmem_base, uint64_t *trap, uint64_t *va_start, uint64_t *va_size)
+{
+	*chip = chip_id;
+	*gmem_base = GMEM_RANGE_MIN;
+	*trap = UCHE_TRAP_BASE;
+	*va_start = WINDOW_BASE;
+	*va_size = WINDOW_SIZE;
+}
+#endif /* XNU_TARGET_OS_OSX */
+
+/* the self-test of the API: two spaces, one VA, two pages; 64 submissions; the GPU kept powered between them */
+#define T_DATA                  (WINDOW_BASE + 0x0)
+#define T_IB                    (WINDOW_BASE + 0x10000)
+#define VAL_A                   0xaaaa0001u
+#define VAL_B                   0xbbbb0002u
+
+/* the API opened: the CP's SMMU aperture (TrustZone), the fence view, submissions taken from here on */
+static bool
+api_open(void)
+{
+	uint64_t answer = ~0ull;
+	int32_t r;
+
+	/* adreno_hw_init: TrustZone opens the CP's SMMU aperture for context bank 0 */
+	lck_mtx_lock(&hakios_iceland_scm_lock);
+	r = scm4_unlocked(1ull << 30 | 2ull << 24 | 0xcu << 8 | 0x1b, 4, 0xffff0000u | 0, 0xffffffffu, 0xffffffffu, 0xffffffffu,
+	    &answer);
+	lck_mtx_unlock(&hakios_iceland_scm_lock);
+	aperture_ok = r == 0;
+	say("api: TZ set_gpu_smmu_aperture(bank 0): returns %d, answer %#llx%s\n", r, answer, aperture_ok ? "" :
+	    ": per-space submissions refused");
+	fence_view = (volatile uint32_t *)ml_io_map_unmappable((vm_offset_t)kvtophys(core_scratch.va), SCRATCH_SIZE,
+	    VM_WIMG_WCOMB);
+	if (fence_view == NULL) {
+		return false;
+	}
+	/*
+	 * The fence words start where the counter starts. core_up's own fences left the word at 2; with no self-test after it
+	 * (icegpu_persist) "the last fence" was 16 while the GPU's word said 2, so a RedwoodGPU client that waited for "all
+	 * submitted" before submitting anything waited for a fence nobody would write (ipad14n: "redwood: no answer: fence 16
+	 * done 2 .. submissions 0"), and RedwoodGPU then stopped waiting for good (gGPUReported). The GPU is idle here.
+	 */
+	fence_view[FENCE_OFF / 4] = FENCE_START;
+	fence_view[BV_FENCE_OFF / 4] = FENCE_START;
+	settle();
+	last_fence = FENCE_START;
+	gt_done = FENCE_START;
+	api_up = 1;
+	return true;
+}
+
+static bool
+api_selftest(uint32_t hold)
+{
+	vm_offset_t page[4] = { 0, 0, 0, 0 };    /* A data, A ib, B data, B ib (16 KB each, 4 KB used) */
+	uint32_t a = ~0u, b = ~0u, f = 0, fa = 0, fb = 0, words = 4, ok = 0;
+	uint64_t ibva = T_IB, t0, ns;
+	bool pass = false;
+
+	if (!api_up && !api_open()) {
+		return false;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (kmem_alloc(kernel_map, &page[i], PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			goto out;
+		}
+	}
+	if (hakios_iceland_gpu_space_create(&a) || hakios_iceland_gpu_space_create(&b) ||
+	    hakios_iceland_gpu_map(a, T_DATA, kvtophys(page[0]), 4096, false) ||
+	    hakios_iceland_gpu_map(a, T_IB, kvtophys(page[1]), 4096, true) ||
+	    hakios_iceland_gpu_map(b, T_DATA, kvtophys(page[2]), 4096, false) ||
+	    hakios_iceland_gpu_map(b, T_IB, kvtophys(page[3]), 4096, true)) {
+		say("api: spaces / maps not made\n");
+		goto out;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		volatile uint32_t *ib = (volatile uint32_t *)page[1 + 2 * k];
+
+		ib[0] = 7u << 28 | 3 | odd_parity(3) << 15 | CP_MEM_WRITE << 16 | odd_parity(CP_MEM_WRITE) << 23;
+		ib[1] = (uint32_t)T_DATA;
+		ib[2] = (uint32_t)(T_DATA >> 32);
+		ib[3] = k ? VAL_B : VAL_A;
+		to_memory(page[1 + 2 * k], 4096);
+		to_memory(page[2 * k], 4096);
+	}
+	/* the same VA in two spaces: each IB writes its own page */
+	if (hakios_iceland_gpu_submit(a, &ibva, &words, 1, &fa) || hakios_iceland_gpu_submit(b, &ibva, &words, 1, &fb)) {
+		say("api: submissions refused\n");
+		goto out;
+	}
+	if (hakios_iceland_gpu_wait(fb, 1000) != 0) {
+		say("api: fence %u NOT back in 1 s (fence now %u)\n", fb, fence_view[FENCE_OFF / 4]);
+		core_state("api");
+		goto out;
+	}
+	to_memory(page[0], 4096);
+	to_memory(page[2], 4096);
+	say("api: fences %u, %u back; space %u's page reads %#x, space %u's %#x (same GPU address %#llx)\n", fa, fb, a,
+	    *(volatile uint32_t *)page[0], b, *(volatile uint32_t *)page[2], T_DATA);
+	if (*(volatile uint32_t *)page[0] != VAL_A || *(volatile uint32_t *)page[2] != VAL_B) {
+		core_faulted("api");
+		goto out;
+	}
+	say("PER-PROCESS ADDRESS SPACES WORK: one GPU address, two pages, switched by the CP (CP_SMMU_TABLE_UPDATE)\n");
+	/* 64 submissions alternating between the spaces, each waited on its fence */
+	t0 = mach_absolute_time();
+	for (unsigned i = 0; i < 64; i++) {
+		if (hakios_iceland_gpu_submit(i & 1 ? b : a, &ibva, &words, 1, &f) || hakios_iceland_gpu_wait(f, 1000)) {
+			say("api: submission %u (fence %u) failed\n", i, f);
+			core_state("api burst");
+			goto out;
+		}
+		ok++;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	say("api: 64 submissions, alternating spaces, each waited: %u ok in %llu us (%llu us each); waits woken by the "
+	    "interrupt %u, by the 10 ms re-check %u\n", ok, ns / 1000, ns / 64000, waits_irq, waits_poll);
+	/* kept powered between submissions: one a second for `hold` seconds, the GMU's state with it */
+	for (uint32_t sec = 1; sec <= hold; sec++) {
+		sleep_ms(1000);
+		t0 = mach_absolute_time();
+		if (hakios_iceland_gpu_submit(sec & 1 ? b : a, &ibva, &words, 1, &f) || hakios_iceland_gpu_wait(f, 1000)) {
+			say("api: idle submission %u failed\n", sec);
+			goto out;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		say("hold %u s: fence %u in %llu us; gx pwr/clk %#x rpmh state %#x busy %#x, interrupts %u\n", sec, f, ns / 1000,
+		    G(G8_GMU_PWR_CLK_STATUS), G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE), G(G8_GPU_GMU_AO_GPU_CX_BUSY_STATUS),
+		    irq_count);
+	}
+	if (hakios_iceland_gpu_unmap(a, T_DATA, 4096) != 0) {
+		goto out;
+	}
+	pass = true;
+out:
+	if (a != ~0u) {
+		hakios_iceland_gpu_space_destroy(a);
+	}
+	if (b != ~0u) {
+		hakios_iceland_gpu_space_destroy(b);
+	}
+	if (cur_space != SPACE_KERNEL || (a != ~0u && space_get(a)) || (b != ~0u && space_get(b))) {
+		say("api: a space could not be given back: its pages are kept (never freed)\n");
+	} else {
+		for (unsigned i = 0; i < 4; i++) {
+			if (page[i]) {
+				kmem_free(kernel_map, page[i], PAGE_SIZE);
+			}
+		}
+	}
+	say("api: self-test %s; %u fences in all, waits by interrupt %u, by re-check %u\n", pass ? "PASSED" : "FAILED",
+	    last_fence - FENCE_START, waits_irq, waits_poll);
+	return pass;
+}
+
+/* the API closed: no more submissions; the fence view unmapped (after the self-test, or after /dev/icegpu's service) */
+static void
+api_down(void)
+{
+	api_up = 0;
+	if (fence_view != NULL) {
+		/* a waiter still asleep on a fence wakes, sees the API down and leaves before the view goes */
+		thread_wakeup((event_t)&fence_event);
+		sleep_ms(50);
+		ml_io_unmap((vm_offset_t)fence_view, SCRATCH_SIZE);
+		fence_view = NULL;
+	}
+}
+
+/* ---- /dev/icegpu: the API for one userland client at a time (icegpu=6 icegpu_serve=S) --------------------------------- */
+
+/*
+ * A first user interface for a userland test tool (userland-ipad/src/icegpu_test.c), the step before an IOKit user
+ * client / Turnip back end. One open at a time; the opener gets its own address space (closed with the descriptor).
+ * Buffers are kernel pages mapped into that space at addresses the kernel hands out in the 4 GB window; userland fills
+ * and reads them with ioctls (copyin / copyout; no user mapping yet). A buffer is freed only after the client's own last
+ * fence (data-a-live's buffer-release lesson). Live for icegpu_serve seconds after a passed self-test; then the device
+ * refuses everything, whatever is still open is torn down, and the kit's way down runs. Commands are logged
+ * ("icegpu: dev:"), the ring writes by the API's submit lines.
+ */
+#include <sys/conf.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <vm/vm_map_xnu.h>
+#include <sys/ioccom.h>
+#include <miscfs/devfs/devfs.h>
+
+struct icegpu_info {
+	uint32_t chip_id, version, ready, gmu_fw;
+	uint64_t window_base, window_size;
+};
+struct icegpu_bo_new {
+	uint64_t size;                  /* in: bytes (rounded up to 16 KB) */
+	uint64_t gpuva;                 /* out */
+	uint32_t flags;                 /* in: 1 = read-only for the GPU */
+	uint32_t handle;                /* out */
+};
+struct icegpu_bo_rw {
+	uint32_t handle, pad;
+	uint64_t offset, len, uptr;     /* at most 64 KB a call */
+};
+#define ICEGPU_IB_MAX           8
+struct icegpu_submit {
+	uint32_t count, fence;          /* in: IBs; out: the fence */
+	uint64_t iova[ICEGPU_IB_MAX];
+	uint32_t dwords[ICEGPU_IB_MAX];
+};
+struct icegpu_wait {
+	uint32_t fence, ms;
+};
+#define ICEGPU_INFO             _IOR('G', 1, struct icegpu_info)
+#define ICEGPU_BO_NEW           _IOWR('G', 2, struct icegpu_bo_new)
+#define ICEGPU_BO_WRITE         _IOW('G', 3, struct icegpu_bo_rw)
+#define ICEGPU_BO_READ          _IOW('G', 4, struct icegpu_bo_rw)
+#define ICEGPU_SUBMIT           _IOWR('G', 5, struct icegpu_submit)
+#define ICEGPU_WAIT             _IOW('G', 6, struct icegpu_wait)
+#define ICEGPU_BO_FREE          _IOW('G', 7, uint32_t)
+/*
+ * interface 2: zero-copy. The client's own memory (16 KB aligned, e.g. posix_memalign / mmap) wired and mapped into its
+ * GPU space (data-a-live's bo-import method; mmap of a character device is ENODEV in this XNU). The kernel keeps the CPU
+ * caches right around the GPU (it maps with non-cacheable attributes): imported ranges are cleaned + invalidated at every
+ * SUBMIT and when a WAIT returns, in the client's own context.
+ */
+struct icegpu_bo_import {
+	uint64_t uptr, size;            /* in: 16 KB aligned */
+	uint64_t gpuva;                 /* out */
+	uint32_t flags, handle;         /* in: 1 = GPU read-only; out: handle */
+};
+#define ICEGPU_BO_IMPORT        _IOWR('G', 8, struct icegpu_bo_import)
+
+#define DEV_BOS                 64
+#define DEV_BO_MAX              (4u * 1024 * 1024)
+static struct {
+	vm_offset_t va;                 /* kernel pages, or (imported) the client's address */
+	vm_size_t size;
+	uint64_t gpuva;
+	vm_map_t map;                   /* imported: the client's map (a reference held), else NULL */
+} dev_bo[DEV_BOS];
+extern uint64_t pmap_find_pa(pmap_t map, addr64_t va);          /* (pmap_paddr_t: osfmk/arm/pmap/pmap.h) */
+
+/* the client's imported ranges through the CPU caches (clean + invalidate by its own addresses), in its context */
+static void
+dev_sync_imports(void)
+{
+	for (uint32_t h = 0; h < DEV_BOS; h++) {
+		if (dev_bo[h].va != 0 && dev_bo[h].map != NULL && dev_bo[h].map == current_map()) {
+			to_memory(dev_bo[h].va, dev_bo[h].size);
+		}
+	}
+}
+static LCK_MTX_DECLARE(icegpu_dev_lock, &icegpu_group);
+static bool dev_serving, dev_open, dev_node;
+static uint32_t dev_space = ~0u, dev_last_fence, dev_cmds;
+static uint64_t dev_next_va;
+static int dev_major = -1;
+
+static void
+dev_bo_free(uint32_t h)
+{
+	if (dev_bo[h].va == 0) {
+		return;
+	}
+	if (dev_last_fence) {
+		(void)hakios_iceland_gpu_wait(dev_last_fence, 1000);     /* the client's own last fence */
+	}
+	(void)hakios_iceland_gpu_unmap(dev_space, dev_bo[h].gpuva, dev_bo[h].size);
+	if (dev_bo[h].map != NULL) {
+		kern_return_t kr = vm_map_unwire(dev_bo[h].map, (vm_map_offset_t)dev_bo[h].va,
+		    (vm_map_offset_t)(dev_bo[h].va + dev_bo[h].size), TRUE);
+
+		say("dev: import %u unwired (%d)\n", h, kr);
+		vm_map_deallocate(dev_bo[h].map);
+		dev_bo[h].map = NULL;
+	} else {
+		kmem_free(kernel_map, dev_bo[h].va, dev_bo[h].size);
+	}
+	dev_bo[h].va = 0;
+}
+
+/* the client's space and buffers gone (close, or the end of the service) */
+static void
+dev_teardown(const char *why)
+{
+	for (uint32_t h = 0; h < DEV_BOS; h++) {
+		dev_bo_free(h);
+	}
+	if (dev_space != ~0u) {
+		hakios_iceland_gpu_space_destroy(dev_space);
+		dev_space = ~0u;
+	}
+	say("dev: client gone (%s): %u commands, last fence %u\n", why, dev_cmds, dev_last_fence);
+	dev_last_fence = 0;
+	dev_cmds = 0;
+}
+
+static int
+icegpu_open(__unused dev_t dev, __unused int flags, __unused int devtype, proc_t p)
+{
+	int rc = 0;
+
+	lck_mtx_lock(&icegpu_dev_lock);
+	if (!dev_serving || !api_up) {
+		rc = ENXIO;
+	} else if (dev_open) {
+		rc = EBUSY;
+	} else if (hakios_iceland_gpu_space_create(&dev_space) != 0) {
+		rc = ENOMEM;
+	} else {
+		dev_open = true;
+		dev_next_va = WINDOW_BASE;
+	}
+	lck_mtx_unlock(&icegpu_dev_lock);
+	say("dev: open by pid %d: %s (%d), space %d\n", proc_pid(p), rc ? "refused" : "ok", rc, rc ? -1 : (int)dev_space);
+	return rc;
+}
+
+static int
+icegpu_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	lck_mtx_lock(&icegpu_dev_lock);
+	if (dev_open) {
+		dev_teardown("closed");
+		dev_open = false;
+	}
+	lck_mtx_unlock(&icegpu_dev_lock);
+	return 0;
+}
+
+static int
+dev_bo_rw(struct icegpu_bo_rw *a, bool write)
+{
+	vm_offset_t at;
+	int rc;
+
+	if (a->handle >= DEV_BOS || dev_bo[a->handle].va == 0 || dev_bo[a->handle].map != NULL || a->len > 65536 || a->offset > dev_bo[a->handle].size ||
+	    a->len > dev_bo[a->handle].size - a->offset) {
+		return EINVAL;
+	}
+	at = dev_bo[a->handle].va + (vm_offset_t)a->offset;
+	if (write) {
+		rc = copyin((user_addr_t)a->uptr, (void *)at, (vm_size_t)a->len);
+		to_memory(at, (vm_size_t)a->len);
+	} else {
+		to_memory(at, (vm_size_t)a->len);          /* clean (unchanged by us) + invalidate: the GPU's bytes */
+		rc = copyout((const void *)at, (user_addr_t)a->uptr, (vm_size_t)a->len);
+	}
+	return rc;
+}
+
+static int
+icegpu_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int fflag, __unused proc_t p)
+{
+	int rc = 0;
+
+	lck_mtx_lock(&icegpu_dev_lock);
+	if (!dev_serving || !dev_open || !api_up) {
+		lck_mtx_unlock(&icegpu_dev_lock);
+		return ENXIO;
+	}
+	dev_cmds++;
+	switch (cmd) {
+	case ICEGPU_INFO: {
+		struct icegpu_info *i = (struct icegpu_info *)data;
+
+		i->chip_id = chip_id;
+		i->version = 2;
+		i->ready = api_up;
+		i->gmu_fw = G(G8_GMU_CORE_FW_VERSION);
+		i->window_base = WINDOW_BASE;
+		i->window_size = WINDOW_SIZE;
+		break;
+	}
+	case ICEGPU_BO_NEW: {
+		struct icegpu_bo_new *b = (struct icegpu_bo_new *)data;
+		vm_size_t size = round_page((vm_size_t)b->size);
+		uint32_t h;
+
+		for (h = 0; h < DEV_BOS && dev_bo[h].va != 0; h++) {
+		}
+		if (h == DEV_BOS || b->size == 0 || b->size > DEV_BO_MAX || dev_next_va + size > WINDOW_BASE + WINDOW_SIZE) {
+			rc = h == DEV_BOS ? ENOSPC : EINVAL;
+			break;
+		}
+		if (kmem_alloc(kernel_map, &dev_bo[h].va, size, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			dev_bo[h].va = 0;
+			rc = ENOMEM;
+			break;
+		}
+		to_memory(dev_bo[h].va, size);
+		dev_bo[h].size = size;
+		dev_bo[h].gpuva = dev_next_va;
+		for (vm_size_t off = 0; off < size && rc == 0; off += PAGE_SIZE) {
+			/* a 16 KB kernel page is one physical page: four 4 KB GPU pages */
+			if (hakios_iceland_gpu_map(dev_space, dev_bo[h].gpuva + off, kvtophys(dev_bo[h].va + off), PAGE_SIZE,
+			    (b->flags & 1) != 0) != 0) {
+				rc = ENOMEM;
+			}
+		}
+		if (rc != 0) {
+			(void)hakios_iceland_gpu_unmap(dev_space, dev_bo[h].gpuva, size);
+			kmem_free(kernel_map, dev_bo[h].va, size);
+			dev_bo[h].va = 0;
+			break;
+		}
+		dev_next_va += size + 0x10000;          /* a 64 KB gap: an overrun faults instead of hitting the next buffer */
+		b->gpuva = dev_bo[h].gpuva;
+		b->handle = h;
+		say("dev: buffer %u: %lu bytes at GPU %#llx%s\n", h, (unsigned long)size, b->gpuva, (b->flags & 1) ? ", read-only" :
+		    "");
+		break;
+	}
+	case ICEGPU_BO_WRITE:
+		rc = dev_bo_rw((struct icegpu_bo_rw *)data, true);
+		break;
+	case ICEGPU_BO_READ:
+		rc = dev_bo_rw((struct icegpu_bo_rw *)data, false);
+		break;
+	case ICEGPU_SUBMIT: {
+		struct icegpu_submit *s = (struct icegpu_submit *)data;
+
+		if (s->count == 0 || s->count > ICEGPU_IB_MAX) {
+			rc = EINVAL;
+			break;
+		}
+		for (uint32_t i = 0; i < s->count; i++) {
+			if (s->iova[i] < WINDOW_BASE || s->iova[i] + 4ull * s->dwords[i] > WINDOW_BASE + WINDOW_SIZE ||
+			    s->dwords[i] == 0 || s->dwords[i] > 0xfffff) {
+				rc = EINVAL;
+			}
+		}
+		if (rc == 0) {
+			dev_sync_imports();
+		}
+		if (rc == 0 && hakios_iceland_gpu_submit(dev_space, s->iova, s->dwords, s->count, &s->fence) != 0) {
+			rc = EIO;
+		}
+		if (rc == 0) {
+			dev_last_fence = s->fence;
+		}
+		break;
+	}
+	case ICEGPU_WAIT: {
+		struct icegpu_wait *w = (struct icegpu_wait *)data;
+
+		lck_mtx_unlock(&icegpu_dev_lock);
+		rc = hakios_iceland_gpu_wait(w->fence, w->ms > 5000 ? 5000 : w->ms) == 0 ? 0 : ETIMEDOUT;
+		lck_mtx_lock(&icegpu_dev_lock);
+		if (dev_open) {
+			dev_sync_imports();
+		}
+		lck_mtx_unlock(&icegpu_dev_lock);
+		return rc;
+	}
+	case ICEGPU_BO_IMPORT: {
+		struct icegpu_bo_import *b = (struct icegpu_bo_import *)data;
+		vm_map_t map = current_map();
+		uint32_t h;
+		kern_return_t kr;
+
+		for (h = 0; h < DEV_BOS && dev_bo[h].va != 0; h++) {
+		}
+		if (h == DEV_BOS || b->size == 0 || b->size > DEV_BO_MAX || (b->uptr & PAGE_MASK) || (b->size & PAGE_MASK) ||
+		    dev_next_va + b->size > WINDOW_BASE + WINDOW_SIZE) {
+			rc = h == DEV_BOS ? ENOSPC : EINVAL;
+			break;
+		}
+		kr = vm_map_wire_kernel(map, (vm_map_offset_t)b->uptr, (vm_map_offset_t)(b->uptr + b->size),
+		    VM_PROT_READ | VM_PROT_WRITE, VM_KERN_MEMORY_IOKIT, TRUE);
+		if (kr != KERN_SUCCESS) {
+			say("dev: import of %#llx (%llu bytes): wiring refused (%d)\n", b->uptr, b->size, kr);
+			rc = EFAULT;
+			break;
+		}
+		vm_map_reference(map);
+		dev_bo[h].va = (vm_offset_t)b->uptr;
+		dev_bo[h].size = (vm_size_t)b->size;
+		dev_bo[h].gpuva = dev_next_va;
+		dev_bo[h].map = map;
+		for (vm_size_t off = 0; off < dev_bo[h].size && rc == 0; off += PAGE_SIZE) {
+			uint64_t pa = pmap_find_pa(vm_map_get_pmap(map), (addr64_t)(b->uptr + off));
+
+			if (pa == 0 || hakios_iceland_gpu_map(dev_space, dev_bo[h].gpuva + off, pa & ~(uint64_t)PAGE_MASK,
+			    PAGE_SIZE, (b->flags & 1) != 0) != 0) {
+				rc = EFAULT;
+			}
+		}
+		if (rc != 0) {
+			uint32_t keep = dev_last_fence;
+
+			dev_last_fence = 0;
+			dev_bo_free(h);
+			dev_last_fence = keep;
+			break;
+		}
+		to_memory(dev_bo[h].va, dev_bo[h].size);
+		dev_next_va += dev_bo[h].size + 0x10000;
+		b->gpuva = dev_bo[h].gpuva;
+		b->handle = h;
+		say("dev: import %u: the client's %#llx (%llu bytes) wired, at GPU %#llx%s\n", h, b->uptr, b->size, b->gpuva,
+		    (b->flags & 1) ? ", read-only" : "");
+		break;
+	}
+	case ICEGPU_BO_FREE: {
+		uint32_t h = *(uint32_t *)data;
+
+		if (h >= DEV_BOS || dev_bo[h].va == 0) {
+			rc = EINVAL;
+		} else {
+			dev_bo_free(h);
+		}
+		break;
+	}
+	default:
+		rc = ENOTTY;
+	}
+	lck_mtx_unlock(&icegpu_dev_lock);
+	return rc;
+}
+
