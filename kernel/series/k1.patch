+/* as smmu_context_off (run ipad11's lesson): unroute, invalidate while valid, bank off; the rest only if found powered */
+static void
+core_smmu_off(void)
+{
+	if (core_cb < 0) {
+		return;
+	}
+	if (!smmu_readable()) {
+		say("core: SMMU off already: bank 0 left (CX's collapse resets it)\n");
+		core_cb = core_smr[0] = core_smr[1] = -1;
+		return;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		if (core_smr[k] >= 0) {
+			W_SMMU(SMMU_SMR(core_smr[k]), "SMR", found.smmu ? found.smr[core_smr[k]] : 0);
+			W_SMMU(SMMU_S2CR(core_smr[k]), "S2CR", found.smmu ? found.s2cr[core_smr[k]] : S2CR_FAULT);
+		}
+	}
+	W_SMMU(SMMU_CB(0) + CB_TLBIASID, "CB0_TLBIASID", 0);
+	W_SMMU(SMMU_CB(0) + CB_TLBSYNC, "CB0_TLBSYNC", 0);
+	if (!wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000)) {
+		say("core: context bank 0: TLB sync does not finish\n");
+	}
+	W_SMMU(SMMU_CB(0) + CB_SCTLR, "CB0_SCTLR", 0);
+	if (found.smmu) {
+		W_SMMU(SMMU_CBAR(0), "CBAR0", core_old_cbar);
+		W_SMMU(SMMU_CBA2R(0), "CBA2R0", core_old_cba2r);
+		W_SMMU(SMMU_CB(0) + CB_ACTLR, "CB0_ACTLR", core_old_actlr);
+	}
+	core_cb = core_smr[0] = core_smr[1] = -1;
+}
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return 0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1;
+}
+
+static void
+ring(uint32_t w)
+{
+	((volatile uint32_t *)core_ring.va)[ring_at] = w;
+	ring_at = (ring_at + 1) % RING_WORDS;
+}
+
+static void
+ring_pkt7(uint32_t opcode, uint32_t words)
+{
+	ring(7u << 28 | words | odd_parity(words) << 15 | opcode << 16 | odd_parity(opcode) << 23);
+}
+
+static void
+core_state(const char *what)
+{
+	uint32_t pipes[2] = { PIPE_BR, PIPE_BV };
+
+	say("core %s: rptr %u wptr %u, rbbm status %#x int0 %#x, cp global int %#x\n", what, G(G8_CP_RB_RPTR),
+	    G(G8_CP_RB_WPTR), G(G8_RBBM_STATUS), G(G8_RBBM_INT_0_STATUS), G(G8_CP_INTERRUPT_STATUS_GLOBAL));
+	for (unsigned i = 0; i < 2; i++) {
+		aperture(pipes[i]);
+		say("core %s: %s: hw fault %#x int %#x protect %#x sqe %#x\n", what, i ? "BV" : "BR",
+		    G(G8_CP_HW_FAULT_STATUS_PIPE), G(G8_CP_INTERRUPT_STATUS_PIPE), G(G8_CP_PROTECT_STATUS_PIPE),
+		    G(G8_CP_SQE_STATUS_PIPE));
+	}
+	aperture(PIPE_NONE);
+	(void)core_faulted(what);
+}
+
+/* a6xx_flush + a8xx_idle: the ring to the core; wait until it has read it all and only the CX master is busy */
+static bool
+ring_run(const char *what)
+{
+	uint32_t rptr = ~0u, status = ~0u;
+
+	to_memory(core_ring.va, RING_SIZE);
+	say("core: %s (ring to %u)\n", what, ring_at);
+	W_G(G8_CP_RB_WPTR, ring_at);
+	for (int i = 0; i < 20000; i++) {
+		sleep_us(100);
+		rptr = G(G8_CP_RB_RPTR);
+		status = G(G8_RBBM_STATUS);
+		if (rptr == ring_at && !(status & ~1u)) {
+			break;
+		}
+	}
+	if (rptr == ring_at && !(status & ~1u) && !core_faulted(what)) {
+		say("core: %s: done (rptr %u, status %#x)\n", what, rptr, status);
+		return true;
+	}
+	say("core: %s: NOT DONE in 2 s\n", what);
+	core_state(what);
+	return false;
+}
+
+/* adreno_zap_shader_load -> qcom_mdt_load + qcom_scm_pas_auth_and_reset (PAS 13), into gpu_microcode_mem */
+static bool
+zap_load(void)
+{
+	const uint8_t *img;
+	uint64_t size = 0, answer = ~0ull;
+	uint32_t phoff = 0, phnum, hash = ~0u, min_addr = ~0u, max_addr = 0, meta_size;
+	uint32_t ph[16][8];
+	vm_offset_t meta = 0, window, region;
+	/*
+	 * Run ipad14 panicked in ml_io_unmap -> pmap_remove_range_options ("PTE write is unaligned"): gpu_microcode_mem
+	 * 0x9959a000 (8 KB) is not on a 16 KB page, and the unmap got its own address and size. Now the whole 16 KB
+	 * pages around it are mapped (unmappable, device memory) and unmapped; only the 8 KB region is written.
+	 */
+	const uint64_t win_pa = ZAP_PHYS & ~(uint64_t)PAGE_MASK;
+	const vm_size_t win_size = (vm_size_t)round_page(ZAP_PHYS + ZAP_SIZE - win_pa);
+	int32_t r;
+
+	img = fw_image(ZAP_NAME, &size, NULL);
+	if (img == NULL) {
+		say("zap: fw/%s is neither in md1 nor linked into this kernel\n", ZAP_NAME);
+		return false;
+	}
+	if (size < 52 || img[0] != 0x7f || img[1] != 'E' || img[2] != 'L' || img[3] != 'F' || img[4] != 1) {
+		say("zap: not an ELF32 image\n");
+		return false;
+	}
+	memcpy(&phoff, img + 28, 4);
+	phnum = img[44] | (uint32_t)img[45] << 8;
+	if (phnum == 0 || phnum > 16 || (uint64_t)phoff + 32ull * phnum > size) {
+		say("zap: %u program headers at %#x: not usable\n", phnum, phoff);
+		return false;
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		memcpy(ph[i], img + phoff + 32 * i, 32);  /* type offset vaddr paddr filesz memsz flags align */
+		if ((ph[i][6] >> 24 & 7) == 2) {
+			hash = i;
+		} else if (ph[i][0] == 1 && ph[i][5] != 0) {
+			min_addr = ph[i][3] < min_addr ? ph[i][3] : min_addr;
+			max_addr = ph[i][3] + ph[i][5] > max_addr ? ph[i][3] + ph[i][5] : max_addr;
+			if ((uint64_t)ph[i][1] + ph[i][4] > size || ph[i][4] > ph[i][5]) {
+				say("zap: segment %u beyond the file\n", i);
+				return false;
+			}
+		}
+	}
+	max_addr = (max_addr + 0xfff) & ~0xfffu;
+	meta_size = 52 + 32 * phnum + (hash != ~0u ? ph[hash][4] : 0);
+	say("zap: %llu bytes, %u headers, hash %d (%u bytes), span %#x..%#x -> %#llx (%#x)\n", size, phnum, (int)hash,
+	    hash != ~0u ? ph[hash][4] : 0, min_addr, max_addr, ZAP_PHYS, ZAP_SIZE);
+	if (hash == ~0u || min_addr == ~0u || max_addr - min_addr > ZAP_SIZE || meta_size > ZAP_META_MAX ||
+	    (uint64_t)ph[hash][1] + ph[hash][4] > size) {
+		say("zap: does not fit\n");
+		return false;
+	}
+	const vm_size_t meta_bytes = (vm_size_t)round_page(meta_size);
+	if (kmem_alloc(kernel_map, &meta, meta_bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	memcpy((void *)meta, img, 52 + 32 * phnum);
+	memcpy((void *)(meta + 52 + 32 * phnum), img + ph[hash][1], ph[hash][4]);
+	to_memory(meta, meta_bytes);
+	r = scm3(1ull << 30 | 2ull << 24 | 2u << 8 | 1, 2 | 2 << 6, PAS_GPU, kvtophys(meta), 0, &answer);
+	say("zap: TZ init image (13, metadata %#llx): returns %d, answer %#llx\n", kvtophys(meta), r, answer);
+	if (r != 0 || answer != 0) {
+		kmem_free(kernel_map, meta, meta_bytes);
+		return false;
+	}
+	r = scm3(1ull << 30 | 2ull << 24 | 2u << 8 | 2, 3, PAS_GPU, ZAP_PHYS, max_addr - min_addr, &answer);
+	say("zap: TZ mem setup (%#llx, %#x): returns %d, answer %#llx\n", ZAP_PHYS, max_addr - min_addr, r, answer);
+	if (r != 0 || answer != 0) {
+		kmem_free(kernel_map, meta, meta_bytes);
+		return false;
+	}
+	window = ml_io_map_unmappable((vm_offset_t)win_pa, win_size, VM_WIMG_IO);  /* device type: no speculative reads of the neighbours */
+	region = window + (vm_offset_t)(ZAP_PHYS - win_pa);
+	if (window == 0) {
+		kmem_free(kernel_map, meta, meta_bytes);
+		return false;
+	}
+	for (uint32_t at = 0; at < ZAP_SIZE; at++) {
+		*(volatile uint8_t *)(region + at) = 0;
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		if (i == hash || ph[i][0] != 1 || ph[i][5] == 0) {
+			continue;
+		}
+		for (uint32_t at = 0; at < ph[i][4]; at++) {
+			*(volatile uint8_t *)(region + (ph[i][3] - min_addr) + at) = img[ph[i][1] + at];
+		}
+	}
+	settle();
+	ml_io_unmap(window, win_size);
+	r = scm(1ull << 30 | 2ull << 24 | 2u << 8 | 5, 1, PAS_GPU, &answer);
+	say("zap: TZ auth and reset: returns %d, answer %#llx\n", r, answer);
+	kmem_free(kernel_map, meta, meta_bytes);
+	if (r != 0 || answer != 0) {
+		return false;
+	}
+	zap_loaded = true;
+	say("TRUSTZONE RUNS THE ZAP SHADER\n");
+	return true;
+}
