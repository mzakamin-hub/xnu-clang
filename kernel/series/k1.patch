+				    strcmp(one, "com.apple.findmy.findmybeaconingd") != 0 && strcmp(one, "com.apple.fairplayd.A2") != 0) {
+					/* render1, launchd-disable=3: the same merge with each label on its own (the parse fixed). Three
+					 * labels stay enabled in mode 3: identityservicesd (Apple ID device keys, Continuity, the IDS side
+					 * of Bluetooth features), findmybeaconingd (Bluetooth LE advertising: the bt2 lane's call) and
+					 * fairplayd.A2 (FairPlay: an App Store app's encrypted binary would not start) */
+					curated_seen += native_launchd_merge(out, one, add, add_room, added, flipped, kept,
+					    list_room) >= 0;
+				} else if (length != 0 && length < 64 && enabled == 4) {
+					/* render1, launchd-disable=4: the way back, every curated label found disabled set to <false/> */
+					curated_seen += native_launchd_lift(out, room, one, flipped, list_room) > 0;
+				}
+				n += length;
+				n += *n == ',';
+			}
+			/* mode 4 also takes back mode 2's one bogus key (the last two labels as one, gains2 REPORT 2) */
+			if (enabled == 4) {
+				curated_seen += native_launchd_lift(out, room, "com.apple.ReportCrashService,com.apple.diagnosticservicesd",
+				    flipped, list_room) > 0;
+			}
+		}
+		if (add[0]) {
+			char *last = NULL;
+			for (char *f = native_launchd_strstr(out, "</dict>"); f != NULL; f = native_launchd_strstr(f + 1, "</dict>")) {
+				last = f;
+			}
+			const size_t extra = strlen(add);
+			if (last == NULL || strlen(out) + extra + 1 > room) {
+				error = E2BIG;
+			} else {
+				memmove(last + extra, last, strlen(last) + 1);
+				memcpy(last, add, extra);
+			}
+		}
+	}
+	int written = 0;
+	if (!error) {
+		written = native_gpu_addon_write(path, (const uint8_t *)out, strlen(out), 0644, ctx);
+		error = written > 0 ? written : 0;     /* -1: the same bytes were there */
+	}
+	int marker_error = -1;
+	if (!error) {
+		vnode_t mv = NULLVP;
+		marker_error = vnode_open(marker, O_CREAT | O_EXCL | FWRITE | O_NOFOLLOW, 0644, 0, &mv, ctx);
+		if (!marker_error) {
+			vnode_close(mv, FWRITE, ctx);
+		} else if (marker_error == EEXIST) {
+			marker_error = 0;
+		}
+	}
+	native_owner_launchd_disable_status = error;
+	if (error == ENOMEM) {
+		/* w8-gains: the buffers are heap now; with none of them the report line is skipped, not printed over NULL */
+		printf("owner Data: launchd-disable: no memory for the merge: status %d\n", error);
+		goto out;
+	}
+	printf("owner Data: launchd-disable: %s%s (%s, %s; %lu B before): added [%s], <false/> made <true/> [%s], "
+	    "already disabled [%s]; marker %d; status %d\n", path, error == EFTYPE ? " LEFT ALONE: not an XML dictionary" : "",
+	    error == EFTYPE ? "" : how, written < 0 ? "same bytes, nothing written" : error ? "not written" : "written",
+	    (unsigned long)old_length, added, flipped, kept, marker_error, error);
+	if (enabled == 2 || enabled == 3) {
+		printf("owner Data: launchd-disable: sheng's measured labels merged: %u of the curated list (mode %u%s)\n",
+		    curated_seen, enabled, enabled == 3 ? ", each label on its own" : "");
+	} else if (enabled == 4) {
+		printf("owner Data: launchd-disable: mode 4: %u curated labels set back to <false/> (listed under \"made <true/>\" "
+		    "above)\n", curated_seen);
+	}
+	if (crash_on) {
+		printf("owner Data: launchd-disable: icecrash=1: the crash reporter's labels left enabled, %u set back to <false/> "
+		    "[%s]; deny-exec skips ReportCrash*\n", crash_lifted, crash_names);
+	}
+out:
+	if (old) {
+		kfree_data(old, cap);
+	}
+	if (out) {
+		kfree_data(out, room);
+	}
+	if (add) {
+		kfree_data(add, add_room);
+	}
+	if (added) {
+		kfree_data(added, list_room);
+	}
+	if (flipped) {
+		kfree_data(flipped, list_room);
+	}
+	if (kept) {
+		kfree_data(kept, list_room);
+	}
+}
