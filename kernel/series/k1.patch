+extern unsigned int nw_wifi_om_ext[16] __attribute__((weak));
+extern unsigned int nw_wifi_om_ext_poll[16] __attribute__((weak));
+extern unsigned int nw_wifi_om_ext_work[16] __attribute__((weak));
+extern unsigned int nw_wifi_om_ce_svc[16] __attribute__((weak));
+extern unsigned int nw_wifi_om_ce_rx[16] __attribute__((weak));
+extern unsigned int nw_wifi_om_ce_tx[16] __attribute__((weak));
+extern unsigned int nw_wifi_om_irq_num[64] __attribute__((weak));
+extern unsigned int nw_wifi_om_irq_calls[64] __attribute__((weak));
+extern unsigned char nw_wifi_om_irq_dp[64] __attribute__((weak));
+extern unsigned int nw_wifi_om_step_hist[6] __attribute__((weak));
+extern unsigned long long nw_wifi_om_step_max __attribute__((weak));
+extern unsigned int nw_wifi_om_cmds __attribute__((weak));
+extern unsigned int nw_wifi_om_evts __attribute__((weak));
+extern unsigned int nw_wifi_om_quiet __attribute__((weak));
+
+int
+hakios_iceland_omni(int bit)
+{
+	if (ice_omni == 0xffffffffu) {
+		uint32_t m = ICE_OMNI_DEFAULT;
+
+		(void)PE_parse_boot_argn("dadawifi_omni", &m, sizeof(m));
+		ice_omni = m & 0x17ffu; /* 46cn4b: G6 0x200, G7 0x400, G9 0x1000 built; G8 0x800 / G10 0x2000 not (ignored) */
+		printf("icepcie: ath12k: 46cn4a dadawifi_omni %#x (asked %#x): A1 ext-irq counted %u, A2 log limiter %u, B wmi trace %u, "
+		    "C dp poll split %u, E retry %u, G1 rddm %u, G2 code store + arena map %u, G4 no all-ones write-back %u, G5 mrrs "
+		    "512 %u; 46cn4b G6 lmx %u, G7 x1 %u, G9 L3K_E1 %u; G8 / G10 not built\n", ice_omni, m, ice_omni & 1,
+		    (ice_omni >> 1) & 1, (ice_omni >> 2) & 1, (ice_omni >> 3) & 1, (ice_omni >> 4) & 1, (ice_omni >> 5) & 1,
+		    (ice_omni >> 6) & 1, (ice_omni >> 7) & 1, (ice_omni >> 8) & 1, (ice_omni >> 9) & 1, (ice_omni >> 10) & 1,
+		    (ice_omni >> 12) & 1);
+	}
+	return (ice_omni & (uint32_t)bit) != 0;
+}
+
+unsigned int
+hakios_iceland_poll_ms(void)
+{
+	if (ice_poll == 0xffffffffu) {
+		uint32_t p = 5;
+
+		(void)PE_parse_boot_argn("dadawifi_poll", &p, sizeof(p));
