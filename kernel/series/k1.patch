+		size_t namelen;
+		int at;
+
+		if (site == NULL || (at = iceland_top_slot(m->tag_bytes, site->total)) < 0) {
+			continue;
+		}
+		memmove(&m->tag_bytes[at + 1], &m->tag_bytes[at], (ICEMEM_TOP - 1 - at) * sizeof(m->tag_bytes[0]));
+		memmove(&m->tag[at + 1], &m->tag[at], (ICEMEM_TOP - 1 - at) * sizeof(m->tag[0]));
+		memmove(m->tag_name[at + 1], m->tag_name[at], (ICEMEM_TOP - 1 - at) * ICEMEM_NAME);
+		m->tag_bytes[at] = site->total;
+		m->tag[at] = (uint16_t)idx;
+		if (idx < VM_KERN_MEMORY_FIRST_DYNAMIC) {
+			const char *n = vm_kern_memory_names[idx];
