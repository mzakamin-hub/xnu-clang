+static uint64_t
+ms_since_boot(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/*
+ * The same moment as the userland logs see it: ms since the kit was started (hakios_iceland_gpu_init, in
+ * redwood_input_init before launchd) and the wall clock (UTC; launchd's lines are local time). mach_absolute_time is
+ * the SoC counter, which also counts ABL, U-Boot and the USB staging before this kernel ran.
+ */
+static uint64_t kit_init_at;
+
+static void
+say_when(const char *what)
+{
+	clock_sec_t secs = 0;
+	clock_usec_t usecs = 0;
+	uint64_t ns = 0;
+
+	clock_get_calendar_microtime(&secs, &usecs);
+	if (kit_init_at != 0) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - kit_init_at, &ns);
+	}
+	say("persist: %s: %llu ms after the kit's start, %02lu:%02lu:%02lu.%03u UTC (counter %llu ms)\n", what,
+	    ns / NSEC_PER_MSEC, (unsigned long)(secs / 3600 % 24), (unsigned long)(secs / 60 % 60), (unsigned long)(secs % 60),
+	    (unsigned)(usecs / 1000), ms_since_boot());
+}
+
+/*
+ * What the panel shows, without a photo: every 10 s, 256 points of the console framebuffer (the memory the display scans
+ * out; MiniIOMobileFramebuffer copies each swapped surface there) on a 16 x 16 grid, read one word at a time (no memcpy
+ * from it): how many are not black, how many colours (up to 16 told apart), how many changed since the last look, the
+ * centre and the four quarters' centres. Software or Metal composition alike: with the render server on Metal (kit 3) a
+ * screen that is not black and changes is the GPU's drawing reaching the panel.
+ */
+#include <console/video_console.h>     /* struct vc_info */
+extern struct vc_info vinfo;            /* the boot framebuffer, as the text console knows it (video_console.c) */
+static uint32_t screen_last[256];
+
+static uint32_t
+screen_px(uint32_t x, uint32_t y)
+{
+	return rd((vm_offset_t)vinfo.v_baseaddr + (vm_offset_t)y * vinfo.v_rowbytes + 4UL * x) & 0xffffff;
+}
+
+/* (looked at every second; said every 10 s, or at once when 8 or more points changed, with the boot clock) */
+static void
+screen_look(uint32_t s)
+{
+	uint32_t w = (uint32_t)vinfo.v_width, h = (uint32_t)vinfo.v_height, lit = 0, changed = 0, colours[16], n_colours = 0;
+	bool more = false;
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || w < 16 || h < 16) {
+		return;
+	}
+	for (uint32_t j = 0; j < 16; j++) {
+		for (uint32_t i = 0; i < 16; i++) {
+			uint32_t p = screen_px((2 * i + 1) * w / 32, (2 * j + 1) * h / 32), k;
+
+			lit += p != 0;
+			changed += p != screen_last[16 * j + i];
+			screen_last[16 * j + i] = p;
+			for (k = 0; k < n_colours && colours[k] != p; k++) {
+			}
+			if (k == n_colours) {
+				if (n_colours < 16) {
+					colours[n_colours++] = p;
+				} else {
+					more = true;
+				}
+			}
+		}
+	}
+	if (s % 10 != 0 && changed < 8) {
+		return;
+	}
+	/* (ipad14r: 2-4 points lit all run long -- which ones and what colour: the lock screen's clock, or something else) */
+	char where[120];
+	size_t used = 0;
+
+	where[0] = 0;
+	for (uint32_t k = 0; lit != 0 && lit <= 16 && k < 256 && used + 20 < sizeof(where); k++) {
+		if (screen_last[k] != 0) {
+			used += (size_t)snprintf(where + used, sizeof(where) - used, " %u,%u=%06x", k % 16, k / 16, screen_last[k]);
+		}
+	}
+	say("persist: screen %ux%u at %u s (%llu ms since boot): %u of 256 points not black, %u%s colours, %u changed since the "
+	    "last look; centre %06x, quarters %06x %06x %06x %06x%s%s\n", w, h, s, ms_since_boot(), lit, n_colours, more ? "+" : "",
+	    changed, screen_px(w / 2, h / 2), screen_px(w / 4, h / 4), screen_px(3 * w / 4, h / 4), screen_px(w / 4, 3 * h / 4),
+	    screen_px(3 * w / 4, 3 * h / 4), where[0] ? "; lit (column,row of 16)" : "", where);
+}
+
+/*
+ * Boot-arg icegpu_dcvs=1 (kit 19c, owner's OK 31 Oct "Go for the speed scaling kit"; with icegpu_persist=1): GPU frequency
+ * scaling while the GPU serves, after ShueiTsuki/data-a-live wsl/pandora_gpu.c patch 0198 (same SoC, same Adreno 840;
+ * method, code written here). The busy counter of Linux a8xx_gpu_busy: the GMU's CX power counter XOCLK_0 counts XO
+ * (19.2 MHz) ticks while the GPU is busy -- three writes, logged, the old values kept and put back at the way down:
+ *   GMU_AO_GPU_CX_BUSY_MASK (0x23b0e) = 0xff000000, POWER_COUNTER_SELECT_XOCLK_0 (0x1fc40) low byte = 0x20 (countable 5),
+ *   POWER_COUNTER_ENABLE (0x1fc10) = 1.
+ * Every 16 ms the frequency that would have kept the window 50 % busy: up at once to the lowest level at or above 1.1 x
+ * that, to the top after a window over 85 % busy or 50 ms busy without a break; down one level after 4 windows in a row
+ * that needed at most 0.8 x the next lower level (one more right after a step up); 80 ms without work: back to the
+ * fixed level (icegpu_speed). Levels: only this bin's table gmu_up uses (1 .. n_gpu-1; icegpu_dcvs_max=N caps it lower;
+ * never above the stock bin's top), each voted as gmu_up votes icegpu_speed: HFI GX_BW_PERF_VOTE, blocking, with the
+ * level's own bus index. Refused unless the GMU firmware is 0x50030021. On any HFI error or timeout: the fixed level
+ * voted again and scaling off for the rest of the run. Lines "icegpu: dcvs: " (every change, up to 400, and every 10 s).
+ * icegpu_thermal=1 adds a temperature cap on top of all that (the block below the statics): the hottest of the GPU's
+ * sensors, one level down every 100 ms from 105 C, the lowest from 115 C, one up a second under 100 C.
+ */
+static uint32_t dcvs_arg, dcvs_max, dcvs_cur, dcvs_saved[3];
+static bool dcvs_on;
+static uint64_t dcvs_last_busy, dcvs_last_t, dcvs_idle_since, dcvs_run_ns, dcvs_win_busy, dcvs_win_ns;
+static uint64_t dcvs_at[GX_MAX];
+static uint32_t dcvs_down, dcvs_hold, dcvs_changes, dcvs_said, dcvs_last_fence;
+static uint32_t dcvs_floor_level, dcvs_floor_held;      /* 20u: icegpu_uifloor */
+static uint64_t dcvs_ui_window;
+/*
+ * kit1 (25 Nov), boot-arg icegpu_dcvs_pct=<n> (default 1, sheng's rule; 0 = the rule before kit1): a 16 ms window counts
+ * as work only when the GPU was busy for n % of it or more, or the ring holds words the CP has not read (our A840's
+ * CP_RB_RPTR, 0x806, against ring_at, the WPTR we wrote). Before, any busy tick or any new fence made a window work, and
+ * every idle window has a trace of busy time: the 80 ms rest never came, so the GPU stayed off icegpu_speed at rest.
+ * UniXNU-sheng package/GpuPowerProbe.cpp:1941-1948 (its finding, porting.toml "The GPU governor counts a 16 ms window
+ * as work only when the GPU was busy for 1 % of it or the ring holds jobs"; run54: 96 % of the time above the floor).
+ * The 10 s line counts the faint windows (busy, under n %) and those that were work by the ring alone.
+ */
+static uint32_t dcvs_pct = 1, dcvs_faint, dcvs_ring;
+/*
+ * w4-perf, boot-arg ice_floor_yield=1 (default off): the GPU's ui floor yields to the pressure level. The floor is
+ * 726 MHz, built in on macOS (icegpu_uifloor); the target removes it at trapping (bsd/dev/hakios_iceland_cpu.c's
+ * hakios_iceland_pressure). Yielding only ever lowers a vote, never raises one: the load, the thermal cap and the idle
+ * branch still decide below it.
+ */
+static uint32_t dcvs_yield;
+extern uint32_t hakios_iceland_pressure(void);           /* 0 .. 3, the higher of the die's and the shell's pressure */
+
+/*
+ * w4-perf, boot-arg icegpu_thermal=1 (with icegpu_dcvs=1): the GPU had no thermal input at all -- DCVS followed the busy
+ * counter and the ui floor, nothing else -- while Linux on this tablet caps it from the gpuss sensors (thermal-zones
+ * gpuss-0..10: passive 105 C with hysteresis 5, cooling device gpu). dcvs_tcap is a level cap started at dcvs_max: the
+ * hottest gpuss sensor (tsens5 0-10, hakios_iceland_tsens_group_deci) is read every 6th tick (about 100 ms at the 16 ms
+ * one) and the cap goes one level down from 105 C, to the lowest level from 115 C, and one level up a second under 100 C
+ * (a missing reading, -1000, rises too: the cap is the load's then). It is only ever a ceiling on the vote: the load,
+ * the ui floor and the idle branch still decide below it.
+ */
+static uint32_t dcvs_thermal, dcvs_tcap, dcvs_tchanges;
+static uint32_t dcvs_tcheck;                            /* ticks since the last thermal look */
+static uint64_t dcvs_trise_at;                          /* when dcvs_tcap last came up a level */
+
+/*
+ * w4-perf, boot-arg icegpu_caps=1 (with icegpu_dcvs=1, default off): the target table's GPU caps by pressure level --
+ * 826 MHz at moderate, 726 at heavy, 422 at trapping (hakios_iceland_pressure, bsd/dev/hakios_iceland_cpu.c) -- as a
+ * ceiling on every vote of the tick, as dcvs_tcap is: the load, the ui floor and the idle branch still decide below it.
+ * dcvs_pcap[p] is the highest level of 1..dcvs_max whose clock is at most that MHz (at least level 1), computed once in
+ * dcvs_start; index 0, no pressure, is dcvs_max. dcvs_off / dcvs_end are unchanged: the cap is a vote like the others.
+ */
+static uint32_t dcvs_caps, dcvs_pcap[4], dcvs_pcap_seen, dcvs_cchanges;
+extern volatile uint64_t hakios_ui_swap_at;             /* the last SwapEnd (iokit/Kernel/MiniIOMobileFramebuffer.cpp) */
+extern volatile uint64_t hakios_ui_touch_at;            /* a finger last down (bsd/dev/hakios_iceland_touch.c) */
+
+static uint64_t
+dcvs_busy_ticks(void)
+{
+	uint32_t hi = G(G8_GMU_CX_GMU_POWER_COUNTER_XOCLK_0_H), lo = G(G8_GMU_CX_GMU_POWER_COUNTER_XOCLK_0_L);
+	uint32_t hi2 = G(G8_GMU_CX_GMU_POWER_COUNTER_XOCLK_0_H);
+
+	if (hi2 != hi) {
+		lo = G(G8_GMU_CX_GMU_POWER_COUNTER_XOCLK_0_L);
+	}
+	return (uint64_t)hi2 << 32 | lo;
+}
+
+static bool
+dcvs_vote(uint32_t level)
+{
+	static uint32_t vote[4];
+
+	vote[1] = 1;
+	vote[2] = level;
+	vote[3] = 0;
+	for (unsigned i = 1; i < n_bw; i++) {
+		if (bw_kbps[i] == gpu_kbps[level]) {
+			vote[3] = i;
+		}
+	}
+	hfi_quiet = true;
+	bool ok = hfi_send("GX_BW_PERF_VOTE", 30, vote, 4);
+	hfi_quiet = false;
+	return ok;
+}
+
+/* the lowest level up to the cap whose frequency is at least mhz (the cap when none is) */
+static uint32_t
+dcvs_level_for(uint64_t mhz)
+{
+	uint32_t l = 1;
+
+	while (l < dcvs_max && gpu_mhz[l] < mhz) {
+		l++;
+	}
+	return l;
+}
+
+static void
+dcvs_off(const char *why)
+{
+	dcvs_on = false;
+	say("dcvs: OFF (%s): back to the fixed level %u (%u MHz): %s\n", why, fixed_speed, gpu_mhz[fixed_speed],
+	    dcvs_vote(fixed_speed) ? "voted" : "NOT voted (the GMU does not answer)");
+}
+
+static void
+dcvs_start(void)
+{
+	PE_parse_boot_argn("icegpu_dcvs", &dcvs_arg, sizeof(dcvs_arg));
+	if (dcvs_arg == 0) {
+		return;
+	}
+	if (fw_version != 0x50030021) {
+		say("dcvs: REFUSED: GMU firmware %#x, not 0x50030021 (the vendor 5.3.33 this kit was checked with)\n", fw_version);
+		return;
+	}
+	if (fixed_speed == 0 || fixed_speed >= n_gpu) {
+		say("dcvs: REFUSED: no fixed level to fall back to (%u)\n", fixed_speed);
+		return;
+	}
+	dcvs_max = n_gpu - 1;
+	PE_parse_boot_argn("icegpu_dcvs_max", &dcvs_max, sizeof(dcvs_max));
+	dcvs_max = dcvs_max < 1 ? 1 : dcvs_max > n_gpu - 1 ? n_gpu - 1 : dcvs_max;
+	PE_parse_boot_argn("icegpu_dcvs_pct", &dcvs_pct, sizeof(dcvs_pct));    /* kit1: sheng's 1 % rule (0: the old one) */
+	dcvs_pct = dcvs_pct > 100 ? 100 : dcvs_pct;
+	say("dcvs: a window is work at %s\n", dcvs_pct != 0 ? "n % busy or ring words pending (icegpu_dcvs_pct)" :
+	    "any busy tick or a new fence (icegpu_dcvs_pct=0)");
+	/* w4-perf: the temperature cap (dcvs_tick): parsed here, where dcvs_max is final */
+	dcvs_tcap = dcvs_max;
+	dcvs_thermal = hakios_iceland_thermal_arg("icegpu_thermal", 1);
+	if (dcvs_thermal != 0) {
+		say("dcvs: thermal: icegpu_thermal=1: the hottest gpuss sensor (tsens5 0-10) caps the level: one down every 100 ms "
+		    "from 105 C (Linux's gpuss alert0), the lowest from 115 C, one up a second under 100 C\n");
+	}
+	/* w4-perf: the pressure level's caps (dcvs_pcap, the block above the statics); parsed here, where dcvs_max is final */
+	dcvs_caps = hakios_iceland_thermal_arg("icegpu_caps", 1);
+	if (dcvs_caps != 0) {
+		static const uint32_t cap_mhz[3] = { 826, 726, 422 };
+
+		dcvs_pcap[0] = dcvs_max;
+		for (uint32_t p = 1; p <= 3; p++) {
+			uint32_t l = 1;
+
+			for (uint32_t k = 1; k <= dcvs_max; k++) {
+				if (gpu_mhz[k] <= cap_mhz[p - 1]) {
+					l = k;
+				}
+			}
+			dcvs_pcap[p] = l;
+		}
+		dcvs_pcap_seen = dcvs_pcap[0];
+		say("dcvs: caps: icegpu_caps=1: at most %u / %u / %u MHz at pressure level 1 / 2 / 3\n", gpu_mhz[dcvs_pcap[1]],
+		    gpu_mhz[dcvs_pcap[2]], gpu_mhz[dcvs_pcap[3]]);
+	}
+	dcvs_saved[0] = G(G8_GPU_GMU_AO_GPU_CX_BUSY_MASK);
+	dcvs_saved[1] = G(G8_GMU_CX_GMU_POWER_COUNTER_SELECT_XOCLK_0);
+	dcvs_saved[2] = G(G8_GMU_CX_GMU_POWER_COUNTER_ENABLE);
+	say("dcvs: the busy counter (found: CX busy mask %#x, XO counter 0 select %#x, counter enable %#x)\n", dcvs_saved[0],
+	    dcvs_saved[1], dcvs_saved[2]);
+	W_G(G8_GPU_GMU_AO_GPU_CX_BUSY_MASK, 0xff000000u);
+	W_G(G8_GMU_CX_GMU_POWER_COUNTER_SELECT_XOCLK_0, (dcvs_saved[1] & ~0xffu) | 0x20u);
+	W_G(G8_GMU_CX_GMU_POWER_COUNTER_ENABLE, 1);
+	dcvs_cur = fixed_speed > dcvs_max ? dcvs_max : fixed_speed;
+	{
+		uint32_t mhz = 0;
+
+		PE_parse_boot_argn("icegpu_uifloor", &mhz, sizeof(mhz));
+		nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &dcvs_ui_window);
+		dcvs_floor_level = mhz != 0 ? dcvs_level_for(mhz) : 0;
+		if (dcvs_floor_level != 0) {
+			say("dcvs: ui floor %u MHz (level %u) while a SwapEnd or a finger down came in the last 200 ms (icegpu_uifloor=%u)\n",
+			    gpu_mhz[dcvs_floor_level], dcvs_floor_level, mhz);
+		}
+	}
+	/* w4-perf: the ui floor yields (see dcvs_yield above); parsed here, where the floor itself is settled */
+	dcvs_yield = hakios_iceland_thermal_arg("ice_floor_yield", 1);
+	if (dcvs_yield != 0) {
+		say("dcvs: ui floor yields: off at pressure level 3 (ice_floor_yield=1)\n");
+	}
+	dcvs_last_busy = dcvs_busy_ticks();
+	dcvs_last_t = dcvs_idle_since = mach_absolute_time();
+	dcvs_trise_at = dcvs_last_t;            /* w4-perf: the thermal cap's first rise needs a second from here */
+	dcvs_last_fence = last_fence;
+	dcvs_on = true;
+	sleep_ms(20);
+	say("dcvs: ON: levels 1..%u (%u..%u MHz), every 16 ms, from %u MHz; counter %llu -> %llu in 20 ms\n", dcvs_max,
+	    gpu_mhz[1], gpu_mhz[dcvs_max], gpu_mhz[dcvs_cur], dcvs_last_busy, dcvs_busy_ticks());
+	dcvs_last_busy = dcvs_busy_ticks();
+	dcvs_last_t = mach_absolute_time();
+}
+
+static void
+dcvs_tick(void)
+{
+	uint64_t busy, t, ns, busy_ns, need;
+	uint32_t want;
+	bool active;
+
+	if (!dcvs_on) {
+		return;
+	}
+	busy = dcvs_busy_ticks();
+	t = mach_absolute_time();
+	absolutetime_to_nanoseconds(t - dcvs_last_t, &ns);
+	busy_ns = (busy - dcvs_last_busy) * 625 / 12;   /* 52.083 ns an XO tick */
+	busy_ns = busy_ns > ns ? ns : busy_ns;
+	dcvs_last_busy = busy;
+	dcvs_last_t = t;
+	if (ns == 0) {
+		return;
+	}
+	dcvs_win_busy += busy_ns;
+	dcvs_win_ns += ns;
+	dcvs_at[dcvs_cur] += ns;
+	if (dcvs_pct == 0) {
+		active = busy_ns > 0 || last_fence != dcvs_last_fence;
+	} else {
+		/* kit1, sheng's rule (the block above the statics): n % busy, or words in the ring */
+		active = busy_ns * 100 >= ns * dcvs_pct;
+		if (!active && G(G8_CP_RB_RPTR) != ring_at) {
+			active = true;
+			dcvs_ring++;
+		}
+		dcvs_faint += busy_ns > 0 && busy_ns * 100 < ns * dcvs_pct;
+	}
+	dcvs_last_fence = last_fence;
+	need = busy_ns * gpu_mhz[dcvs_cur] * 2 / ns;    /* MHz that would have kept the window 50 % busy */
+	dcvs_run_ns = busy_ns * 100 >= ns * 95 ? dcvs_run_ns + ns : 0;
+	want = dcvs_cur;
+	if (busy_ns * 100 > ns * 85 || dcvs_run_ns >= 50 * NSEC_PER_MSEC) {
+		want = dcvs_max;
+	} else if (dcvs_level_for(need * 11 / 10) > dcvs_cur) {
+		want = dcvs_level_for(need * 11 / 10);
+	} else if (active) {
+		if (dcvs_cur > 1 && need * 10 <= (uint64_t)gpu_mhz[dcvs_cur - 1] * 8) {
+			if (++dcvs_down >= 4 + dcvs_hold) {
+				want = dcvs_cur - 1;
+			}
+		} else {
+			dcvs_down = 0;
+		}
+	} else {
+		uint64_t idle;
+
+		absolutetime_to_nanoseconds(t - dcvs_idle_since, &idle);
+		if (idle >= 80 * NSEC_PER_MSEC && dcvs_cur != fixed_speed && fixed_speed <= dcvs_max) {
+			want = fixed_speed;
+		}
+	}
+	if (active) {
+		dcvs_idle_since = t;
+	}
+	/*
+	 * w4-perf, icegpu_thermal=1: the temperature cap, every 6th tick (about 100 ms at the 16 ms one). 105 C is Linux's
+	 * gpuss passive trip (alert0; hysteresis 5) on this tablet, 115 C is below every gpuss zone's hot trip (120 C), and
+	 * the way back up is one level a second -- the CPU governor's rate, slow enough that a boost does not run into the
+	 * next look. A change is said once, with the reading and the level it leaves the cap at (at most 100 lines).
+	 */
+	if (dcvs_thermal != 0 && ++dcvs_tcheck >= 6) {
+		const int32_t temp = hakios_iceland_tsens_group_deci(ICETSENS_GPU);
+		const uint32_t before = dcvs_tcap;
+
+		dcvs_tcheck = 0;
+		if (temp >= 1150) {
+			dcvs_tcap = 1;                  /* the lowest level this table has, as dcvs_level_for's */
+		} else if (temp >= 1050) {
+			if (dcvs_tcap > 1) {
+				dcvs_tcap--;
+			}
+		} else if (temp < 1000 && dcvs_tcap < dcvs_max) {
+			uint64_t since = 0;
+
+			absolutetime_to_nanoseconds(t - dcvs_trise_at, &since);
+			if (since >= NSEC_PER_SEC) {
+				dcvs_tcap++;
+				dcvs_trise_at = t;
+			}
+		}
+		if (dcvs_tcap != before && dcvs_tchanges++ < 100) {
+			const int32_t a = temp < 0 ? -temp : temp;
+
+			if (temp > -1000) {
+				say("dcvs: thermal: gpuss %s%d.%d C: cap %u MHz (level %u of %u)\n", temp < 0 ? "-" : "", a / 10,
+				    a % 10, gpu_mhz[dcvs_tcap], dcvs_tcap, dcvs_max);
+			} else {
+				say("dcvs: thermal: no gpuss reading: cap %u MHz (level %u of %u)\n", gpu_mhz[dcvs_tcap], dcvs_tcap,
+				    dcvs_max);
+			}
+		}
+	}
+	/*
+	 * 20u, boot-arg icegpu_uifloor=MHz: while the screen is being drawn or touched (a SwapEnd or a finger down in the last
+	 * 200 ms) not below the lowest level at or above MHz (under icegpu_dcvs_max): a frame's GPU work, which icegate makes
+	 * backboardd's next frame wait for, no longer runs at 282-461 MHz between DCVS's steps up. Counted in the 10 s line.
+	 * w4-perf, ice_floor_yield=1: not at pressure level 3 (trapping), where the target removes the floor.
+	 */
+	const bool floor_yields = dcvs_yield != 0 && hakios_iceland_pressure() >= 3;
+
+	if (dcvs_floor_level != 0 && !floor_yields && want < dcvs_floor_level &&
+	    ((hakios_ui_swap_at != 0 && t - hakios_ui_swap_at < dcvs_ui_window) ||
+	    (hakios_ui_touch_at != 0 && t - hakios_ui_touch_at < dcvs_ui_window))) {
+		want = dcvs_floor_level;
+		dcvs_floor_held++;
+	}
+	/* w4-perf: the thermal cap wins over every vote above -- the load's, the ui floor's, the idle branch's fixed level */
+	if (dcvs_thermal != 0 && want > dcvs_tcap) {
+		want = dcvs_tcap;
+	}
+	/* w4-perf, icegpu_caps=1 (its block above): the pressure level's ceiling, on every vote of the tick as dcvs_tcap is;
+	 * each change of the level it holds the vote at is said once (at most 100 lines) */
+	if (dcvs_caps != 0) {
+		uint32_t p = hakios_iceland_pressure();
+
+		if (p > 3) {
+			p = 3;
+		}
+		if (want > dcvs_pcap[p]) {
+			want = dcvs_pcap[p];
+		}
+		if (dcvs_pcap[p] != dcvs_pcap_seen) {
+			dcvs_pcap_seen = dcvs_pcap[p];
+			if (dcvs_cchanges++ < 100) {
+				say("dcvs: caps: pressure level %u: at most %u MHz (level %u)\n", p, gpu_mhz[dcvs_pcap[p]],
+				    dcvs_pcap[p]);
+			}
+		}
+	}
+	if (want != dcvs_cur) {
+		if (!dcvs_vote(want)) {
+			dcvs_off("a level vote was not answered or refused");
+			return;
+		}
+		if (dcvs_said++ < 400) {
+			say("dcvs: %u -> %u MHz (busy %llu%% of %llu ms) at %llu ms since boot\n", gpu_mhz[dcvs_cur], gpu_mhz[want],
+			    busy_ns * 100 / ns, ns / NSEC_PER_MSEC, ms_since_boot());
+		}
+		dcvs_hold = want > dcvs_cur ? 1 : 0;
+		dcvs_cur = want;
+		dcvs_changes++;
+		dcvs_down = 0;
+	}
+	if (dcvs_win_ns >= 10ull * NSEC_PER_SEC) {
+		char used[200];
+		size_t n = 0;
+
+		used[0] = 0;
+		for (uint32_t l = 1; l < n_gpu && n < sizeof(used) - 16; l++) {
+			if (dcvs_at[l] * 100 / dcvs_win_ns >= 1) {
+				n += (size_t)snprintf(used + n, sizeof(used) - n, " %u:%llu%%", gpu_mhz[l], dcvs_at[l] * 100 / dcvs_win_ns);
+			}
+			dcvs_at[l] = 0;
+		}
+		say("dcvs: 10 s: busy %llu%%, MHz:time%s, %u changes, now %u MHz; ui floor %u MHz held %u ticks; faint %u, ring %u\n",
+		    dcvs_win_busy * 100 / dcvs_win_ns, used, dcvs_changes, gpu_mhz[dcvs_cur],
+		    dcvs_floor_level ? gpu_mhz[dcvs_floor_level] : 0, dcvs_floor_held, dcvs_faint, dcvs_ring);
+		dcvs_win_busy = dcvs_win_ns = 0;
+		dcvs_changes = 0;
+		dcvs_floor_held = 0;
+		dcvs_faint = dcvs_ring = 0;
+	}
+}
+
+/* the way down: the fixed level again, the counter's three registers as they were found */
+static void
+dcvs_end(void)
+{
+	if (dcvs_arg == 0 || dcvs_max == 0) {
+		return;
+	}
+	if (dcvs_on) {
+		dcvs_off("the way down");
+	}
+	W_G(G8_GMU_CX_GMU_POWER_COUNTER_ENABLE, dcvs_saved[2]);
+	W_G(G8_GMU_CX_GMU_POWER_COUNTER_SELECT_XOCLK_0, dcvs_saved[1]);
+	W_G(G8_GPU_GMU_AO_GPU_CX_BUSY_MASK, dcvs_saved[0]);
+	say("dcvs: put back: CX busy mask %#x, XO counter 0 select %#x, counter enable %#x\n",
+	    G(G8_GPU_GMU_AO_GPU_CX_BUSY_MASK), G(G8_GMU_CX_GMU_POWER_COUNTER_SELECT_XOCLK_0), G(G8_GMU_CX_GMU_POWER_COUNTER_ENABLE));
+}
+
+/* icegpu_persist=1: until the run's end asks (persist_stop / redwood_stop_asked); a line a minute */
+static void
+persist_wait(void)
+{
+	uint32_t s = 0, ticks = 0;
+
+	dcvs_start();
+	while (!persist_stop && !redwood_stop_asked) {
+		/* (a wakeup between the check and the sleep costs at most this second; with icegpu_dcvs a tick of 16 ms) */
+		assert_wait_timeout((event_t)&persist_event, THREAD_UNINT, dcvs_on ? 16 : 1000, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+		if (dcvs_on) {
+			dcvs_tick();
+			if (++ticks < 62) {     /* (62 x 16 ms: the rest once a second, as before) */
+				continue;
+			}
+			ticks = 0;
+		}
+		s++;
+		if (metal_arg && redwood_started && !redwood_plugin_named() && !persist_stop && !redwood_stop_asked) {
+			redwood_plugin_name_again(s);   /* (the accelerator service was not there yet at the start) */
+		}
+		screen_look(s);
+		if (rot_probe_arg == 2 && s == 30 && redwood_started && !persist_stop && !redwood_stop_asked) {
+			(void)rot_probe("30 s into the service, after Turnip's own state");
+		}
+		if (s % 60 == 0) {
+			say("persist: serving %u s: RedwoodGPU %s (%u submissions), /dev/icegpu client %s, fences %u, interrupts %u%s, gx "
+			    "pwr/clk %#x\n", s, redwood_started ? "on" : "OFF", rw_submits_seen(), dev_open ? "open" : "none",
+			    last_fence - FENCE_START, irq_count, irq_masked ? " (line masked: waits poll)" : "", G(G8_GMU_PWR_CLK_STATUS));
+		}
+	}
+	say("persist: the way down asked after %u s (%s) at %llu ms since boot\n", s, persist_stop ? "the run's end" :
+	    "RedwoodGPU stopped", ms_since_boot());
+	dcvs_end();
+}
+
+static void
+dev_serve(uint32_t seconds)
+{
+	if (!dev_node) {
+		dev_major = cdevsw_add(-1, &icegpu_cdevsw);
+		dev_node = dev_major >= 0 && devfs_make_node(makedev(dev_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666,
+		    "icegpu") != NULL;
+	}
+	if (!dev_node) {
+		say("dev: /dev/icegpu not made (major %d)\n", dev_major);
+		return;
+	}
+	lck_mtx_lock(&icegpu_dev_lock);
+	dev_serving = true;
+	lck_mtx_unlock(&icegpu_dev_lock);
+	if (persist) {
+		say("dev: /dev/icegpu SERVING until the run ends (one client at a time)\n");
+	} else {
+		say("dev: /dev/icegpu SERVING for %u s (one client at a time)\n", seconds);
+	}
+	if ((serve_redwood || (persist && !persist_stop)) && redwood_begin()) {
+		api_quiet = 1;
+	}
+	if (persist) {
+		kit_phase = 2;
+		say("persist: THE GPU IS A SERVICE: RedwoodGPU %s, /dev/icegpu on, at %llu ms since boot\n", redwood_started ?
+		    "started" : "NOT started", ms_since_boot());
+		say_when("THE GPU IS A SERVICE");
+		sleep_ms(500);         /* (registerService's matching is asynchronous) */
+		redwood_accelerator_say();
+		persist_wait();
+	}
+	for (uint32_t s = 0; !persist && s < seconds && !redwood_stop_asked; s++) {
+		sleep_ms(1000);
+		if (s % 10 == 9) {
+			say("dev: serving %u s: client %s, fences %u, interrupts %u, gx pwr/clk %#x\n", s + 1, dev_open ? "open" :
+			    "none", last_fence - FENCE_START, irq_count, G(G8_GMU_PWR_CLK_STATUS));
+		}
+	}
+	if (redwood_started) {
+		redwood_end();
+		api_quiet = 0;
+	}
+	lck_mtx_lock(&icegpu_dev_lock);
+	dev_serving = false;
+	if (dev_open) {
+		dev_teardown("the service ended");
+		dev_open = false;
+	}
+	lck_mtx_unlock(&icegpu_dev_lock);
+	say("dev: /dev/icegpu closed (refuses from now on)\n");
+}
+
+/* ---- RedwoodGPU's back end: dada's Turnip path (icegpu=6 icegpu_serve=S icegpu_redwood=1) ------------------------- */
+
+/*
+ * The service RedwoodGPU (iokit/Kernel/RedwoodGPU.cpp: an IOUserClient speaking Linux msm's interface, which Mesa's
+ * Turnip talks to through its darwin KMD, gpu2/patches/mesa-85fda3b-dada.patch) asks redwood_adreno.c's redwood_gpu_*,
+ * which hand over to these when hakios_iceland_gpu_redwood_ready() (as they do to hakios_dada_gpu.c on the Xiaomi).
+ * As dada ran it: one GPU address space for every RedwoodGPU client (a space of this kit's API, ASID 2..), addresses
+ * handed out of its 4 GB window first-fit with a 64 KB guard after each buffer, 4 KB pages mapped as RedwoodGPU asks;
+ * submissions through hakios_iceland_gpu_submit (fence + interrupt). GET_PARAM's answers are the Pad's (Fedora's msm
+ * params: chip_id 0xfc44050a31, gmem 18 MB, highest bank bit 16, UBWC swizzle 6, macrotile 1, UCHE trap base); AQE,
+ * PRR and ray tracing are not offered (no AQE microcode loaded; conservative first kit). Live while the kit serves;
+ * at its end (or RedwoodGPUStop from a run's end) RedwoodGPU is told the GPU is gone, then the space is destroyed.
+ */
+extern void RedwoodGPUStart(void);
+extern void RedwoodGPUStop(void);
+bool hakios_iceland_gpu_redwood_ready(void);
+bool ice_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t ice_gpu_address(uint64_t size);
+void ice_gpu_address_free(uint64_t address, uint64_t size);
+void ice_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost,
+    uint32_t *refused);
+bool ice_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void ice_gpu_mapped(void);
+void ice_gpu_unmap(uint64_t address, uint64_t size);
+void ice_gpu_to_memory(void *start, uint64_t size);
+bool ice_gpu_done(uint32_t fence);
+uint32_t ice_gpu_last(void);
+void ice_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+uint32_t ice_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+void ice_gpu_report(const char *why);
+bool ice_gpu_recover(void);
+void ice_gpu_stop(void);
+
+#define RW_GRANULE              0x10000ull
+#define RW_FREE_MAX             512
+static volatile bool redwood_on, redwood_stop_asked, redwood_kit_ending, redwood_started;
+static volatile bool redwood_owned;     /* RedwoodGPU was started on this GPU in this boot (sticky: see below) */
+static uint32_t rw_space = ~0u, rw_submits, rw_maps, rw_unmaps, rw_refused, rw_live;
+static uint64_t rw_used;
+static struct {
+	uint64_t start, size;
+} rw_free[RW_FREE_MAX];
+static unsigned rw_free_count;
+
+bool hakios_iceland_gpu_redwood_owned(void);
+void hakios_iceland_gpu_end(void);
+void hakios_iceland_gpu_quiesce(void);
+extern int RedwoodGPUAcceleratorState(void);
+extern bool RedwoodGPUNameMetalPlugin(const char *name, const char *class_name);
+static uint32_t metal_named;            /* boot-arg icegpu_metal=1 (with icegpu_persist=1): the plug-in named by the kernel */
+
+static uint32_t
+rw_submits_seen(void)
+{
+	return rw_submits;
+}
+
+static bool
+redwood_plugin_named(void)
+{
+	return metal_named != 0;
+}
+
+static void
+redwood_plugin_name_again(uint32_t s)
+{
+	metal_named = RedwoodGPUNameMetalPlugin("RedwoodMetal", "NativeAdrenoMetalDevice");
+	if (metal_named || s % 30 == 0) {
+		say("redwood: Metal plug-in RedwoodMetal %s after %u s\n", metal_named ? "NAMED" : "still NOT named", s);
+	}
+}
+
+bool
+hakios_iceland_gpu_redwood_ready(void)
+{
+	return redwood_on && api_up;
+}
+
+/*
+ * redwood_adreno.c routes RedwoodGPU's redwood_gpu_* here for as long as this is true, ready or not: once RedwoodGPU has
+ * been started on the Adreno 840 its callers stay ours, and the ice_gpu_* below answer "stopped" safely after the GPU
+ * is gone (a client still waiting, freeing or mapping when the service ends). Before, they fell through to
+ * redwood_adreno.c's own back end, whose blocks were never mapped on this tablet.
+ */
+bool
+hakios_iceland_gpu_redwood_owned(void)
+{
+	return redwood_owned;
+}
+
+/* the accelerator entry iOS's Metal looks for (MiniIOMobileFramebuffer's IOAcceleratorES) and RedwoodGPU, as found */
+static void
+redwood_accelerator_say(void)
+{
+	int st = RedwoodGPUAcceleratorState();
+
+	say("persist: registry: IOAcceleratorES %s, MetalPluginName %s, RedwoodGPU %s\n", (st & 1) ? "PRESENT" : "MISSING",
+	    (st & 2) ? "set" : "not set (software rendering until kit 3)", (st & 4) ? "registered" : "NOT registered");
+}
+
+bool
+ice_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01: case 0x06: case 0x08: case 0x09: case 0x0a:  /* GPU_ID, GMEM_BASE, PP_PGTABLE, FAULTS, SUSPENDS */
+	case 0x11: case 0x15: case 0x17:                        /* RAYTRACING, HAS_PRR, AQE: not offered */
+		*value = 0;
+		return true;
+	case 0x02:                              /* GMEM_SIZE (Fedora: 18874368) */
+		*value = 18u * 1024 * 1024;
+		return true;
+	case 0x03:                              /* CHIP_ID, speed bin 0xfc above it (Fedora: 0xfc44050a31) */
+		*value = (uint64_t)chip_id | 0xfcull << 32;
+		return true;
+	case 0x04:                              /* MAX_FREQ: the bin's top OPP */
+		*value = (uint64_t)gpu_mhz[n_gpu - 1] * 1000000;
+		return true;
+	case 0x05:                              /* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:                              /* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:                              /* HIGHEST_BANK_BIT (ubwc_6_0_hbb16) */
+		*value = 16;
+		if (ubwc_read_arg && ubwc_asked++ < 3) {
+			/* 32vm4a: what the Turnip side is told (its darwin shim sets ubwc_version itself) */
+			say("ubwc: GET_PARAM HIGHEST_BANK_BIT asked (%u): 16; UBWC_SWIZZLE 6, MACROTILE_MODE 1; registers at init %s\n",
+			    ubwc_asked, ubwc_back[3] == 0x28046 ? "UBWC 6.0 HBB 16" : "not as Linux (see the read-back line)");
+		}
+		return true;
+	case 0x12:                              /* UBWC_SWIZZLE */
+		*value = 6;
+		return true;
+	case 0x13:                              /* MACROTILE_MODE */
+		*value = 1;
+		return true;
+	case 0x14:                              /* UCHE_TRAP_BASE */
+		*value = UCHE_TRAP_BASE;
+		return true;
+	default:                                /* (VA_START / VA_SIZE refused, as dada: one space for every client) */
+		return false;
+	}
+}
+
+uint64_t
+ice_gpu_address(uint64_t size)
+{
+	uint64_t span = ((size + RW_GRANULE - 1) & ~(RW_GRANULE - 1)) + RW_GRANULE;
+
+	if (!redwood_on) {
+		rw_refused++;
+		return 0;
+	}
+	for (unsigned i = 0; i < rw_free_count; i++) {
+		if (rw_free[i].size >= span) {
+			uint64_t a = rw_free[i].start;
+
+			rw_free[i].start += span;
+			rw_free[i].size -= span;
+			if (rw_free[i].size == 0) {
+				memmove(&rw_free[i], &rw_free[i + 1], (--rw_free_count - i) * sizeof(rw_free[0]));
+			}
+			rw_used += span;
+			rw_live++;
+			return a;
+		}
+	}
+	rw_refused++;
+	return 0;
+}
+
+void
+ice_gpu_address_free(uint64_t address, uint64_t size)
+{
+	uint64_t span = ((size + RW_GRANULE - 1) & ~(RW_GRANULE - 1)) + RW_GRANULE;
+	unsigned at;
+
+	rw_used -= span;
+	rw_live--;
+	for (at = 0; at < rw_free_count && rw_free[at].start < address; at++) {
+	}
+	if (at > 0 && rw_free[at - 1].start + rw_free[at - 1].size == address) {
+		rw_free[at - 1].size += span;
+		if (at < rw_free_count && address + span == rw_free[at].start) {
+			rw_free[at - 1].size += rw_free[at].size;
+			memmove(&rw_free[at], &rw_free[at + 1], (--rw_free_count - at) * sizeof(rw_free[0]));
+		}
+	} else if (at < rw_free_count && address + span == rw_free[at].start) {
+		rw_free[at].start = address;
+		rw_free[at].size += span;
+	} else if (rw_free_count < RW_FREE_MAX) {
+		memmove(&rw_free[at + 1], &rw_free[at], (rw_free_count++ - at) * sizeof(rw_free[0]));
+		rw_free[at].start = address;
+		rw_free[at].size = span;
+	}
+}
+
+void
+ice_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost,
+    uint32_t *refused)
+{
+	*largest = 0;
+	for (unsigned i = 0; i < rw_free_count; i++) {
+		*largest = rw_free[i].size > *largest ? rw_free[i].size : *largest;
+	}
+	*used = rw_used;
+	*live = rw_live;
+	*holes = *most = rw_free_count;
+	*lost = 0;
+	*refused = rw_refused;
+}
+
+bool
+ice_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	if (!redwood_on) {
+		return false;
+	}
+	rw_maps++;
+	/* (the table's cache push waits for ice_gpu_mapped, after the buffer's last page) */
+	return space_map(rw_space, address & ~0xfffull, phys & ~0xfffull, 4096, read_only, true) == 0;
+}
+
+void
+ice_gpu_mapped(void)
+{
+	lck_mtx_lock(&icegpu_submit_lock);
+	pend_flush();
+	lck_mtx_unlock(&icegpu_submit_lock);
+}
+
+void
+ice_gpu_unmap(uint64_t address, uint64_t size)
+{
+	if (!redwood_on) {
+		return;                         /* (the space and its tables are gone with the service) */
+	}
+	rw_unmaps++;
+	(void)hakios_iceland_gpu_unmap(rw_space, address & ~0xfffull, (size + 0xfff) & ~0xfffull);
+}
+
+void
+ice_gpu_to_memory(void *start, uint64_t size)
+{
+	to_memory((vm_offset_t)start, (vm_size_t)size);
+}
+
+bool
+ice_gpu_done(uint32_t fence)
+{
+	volatile uint32_t *view = fence_view;
+
+	/* stopped (redwood_on cleared under RedwoodGPU's lock before the view goes): nothing is waited for any more */
+	return !redwood_on || view == NULL || (int32_t)(view[FENCE_OFF / 4] - fence) >= 0;
+}
+
+uint32_t
+ice_gpu_last(void)
+{
+	return last_fence;
+}
+
+void
+ice_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	uint64_t ns;
+	boolean_t on = ml_set_interrupts_enabled(FALSE);  /* (the interrupt handler adds to these) */
+
+	lck_spin_lock(&gt_lock);
+	gt_account(mach_absolute_time());
+	absolutetime_to_nanoseconds(gt_busy, &ns);
+	*microseconds = ns / 1000;
+	*submissions = gt_count;
+	memcpy(by, gt_by, 7 * sizeof(uint32_t));
+	gt_busy = 0;
+	gt_count = 0;
+	bzero(gt_by, sizeof(gt_by));
+	lck_spin_unlock(&gt_lock);
+	ml_set_interrupts_enabled(on);
+}
+
+uint32_t
+ice_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t f = 0;
+
+	if (!hakios_iceland_gpu_redwood_ready() || count == 0 || count > 128 ||
+	    submit_ex(rw_space, addresses, words, count, &f, true) != 0) {
+		return 0;
+	}
+	rw_submits++;
+	return f;
+}
+
+/* the physical address behind a space's GPU address (0: not mapped) */
+static uint64_t
+space_pa(struct gspace *s, uint64_t iova)
+{
+	int t = space_l3(s, iova, false);
+
+	if (t < 0 || !(s->t[t][iova >> 12 & 0x1ff] & 1)) {
+		return 0;
+	}
+	return (s->t[t][iova >> 12 & 0x1ff] & PTE_ADDR) | (iova & 0xfff);
+}
+
+/* a hang: fences, ring, both pipes' IB1 / IB2, SQE and protect status, bank 0's fault registers, the first IB's words */
+void
+ice_gpu_report(const char *why)
+{
+	struct gspace *s = space_get(last_ib_space);
+	uint64_t pa = s != NULL ? space_pa(s, last_ib_iova) : 0;
+	const uint32_t pipes[2] = { PIPE_BR, PIPE_BV };
+
+	if (!redwood_on || !api_up) {
+		say("redwood: %s: the GPU service has stopped (no registers read)\n", why);
+		return;
+	}
+	say("redwood: %s: fence %u done %u (BV fence %u), submissions %u; ring rptr %u wptr %u, rbbm status %#x int0 %#x\n", why,
+	    last_fence, fence_view ? fence_view[FENCE_OFF / 4] : 0, fence_view ? fence_view[BV_FENCE_OFF / 4] : 0, rw_submits,
+	    G(G8_CP_RB_RPTR), ring_at, G(G8_RBBM_STATUS), G(G8_RBBM_INT_0_STATUS));
+	for (unsigned i = 0; i < 2; i++) {
+		aperture(pipes[i]);
+		say("redwood: %s: IB1 %#x%08x rem %u (init %u), IB2 %#x%08x rem %u; sqe %#x, protect %#x, hw fault %#x, int %#x\n",
+		    i ? "BV" : "BR", G(G8_CP_IB1_BASE + 1), G(G8_CP_IB1_BASE), G(G8_CP_IB1_REM_SIZE), G(G8_CP_IB1_INIT_SIZE),
+		    G(G8_CP_IB2_BASE + 1), G(G8_CP_IB2_BASE), G(G8_CP_IB2_REM_SIZE), G(G8_CP_SQE_STATUS_PIPE),
+		    G(G8_CP_PROTECT_STATUS_PIPE), G(G8_CP_HW_FAULT_STATUS_PIPE), G(G8_CP_INTERRUPT_STATUS_PIPE));
+	}
+	aperture(PIPE_NONE);
+	if (smmu_readable()) {
+		say("redwood: SMMU bank 0: fsr %#x far %#x%08x fsynr0 %#x\n", rd(smmu + SMMU_CB(0) + CB_FSR),
+		    rd(smmu + SMMU_CB(0) + CB_FAR + 4), rd(smmu + SMMU_CB(0) + CB_FAR), rd(smmu + SMMU_CB(0) + CB_FSYNR0));
+	}
+	if (pa != 0) {
+		vm_offset_t page = ml_io_map_unmappable((vm_offset_t)(pa & ~(uint64_t)PAGE_MASK), PAGE_SIZE, VM_WIMG_IO);
+
+		if (page != 0) {
+			const volatile uint32_t *w = (const volatile uint32_t *)(page + (pa & PAGE_MASK));
+			uint32_t left = (uint32_t)((PAGE_SIZE - (pa & PAGE_MASK)) / 4), n = last_ib_dwords < 32 ? last_ib_dwords : 32;
+
+			n = n < left ? n : left;
+			for (uint32_t i = 0; i < n; i += 8) {
+				say("redwood: first IB at %#llx (%u words) +%u: %08x %08x %08x %08x %08x %08x %08x %08x\n", last_ib_iova,
+				    last_ib_dwords, i, w[i], i + 1 < n ? w[i + 1] : 0, i + 2 < n ? w[i + 2] : 0, i + 3 < n ? w[i + 3] : 0,
+				    i + 4 < n ? w[i + 4] : 0, i + 5 < n ? w[i + 5] : 0, i + 6 < n ? w[i + 6] : 0, i + 7 < n ? w[i + 7] : 0);
+			}
+			ml_io_unmap(page, PAGE_SIZE);
+		}
+	} else {
+		say("redwood: the first IB %#llx is not mapped in space %d\n", last_ib_iova, (int)last_ib_space);
+	}
+	core_state(why);
+}
+
+bool
+ice_gpu_recover(void)
+{
+	return false;                           /* (no recovery yet: a hang is reported and the run ends it) */
+}
+
+/* RedwoodGPUStop (gGPULock held): RedwoodGPU sees no GPU from now on; from another thread, the kit's teardown is waited */
+void
+ice_gpu_stop(void)
+{
+	redwood_on = false;
+	if (redwood_kit_ending) {
+		return;
+	}
+	redwood_stop_asked = true;
+	thread_wakeup((event_t)&persist_event);
+	for (int i = 0; i < 1000 && redwood_started; i++) {
+		sleep_ms(10);
+	}
+}
+
+/*
+ * icegpu_persist=1: the run is ending in order (redwood_adreno_stop, after RedwoodGPUStop, from a thread that may wait):
+ * the persistent service is asked for its way down and waited for -- clients torn down, stage 5's clean way down, the
+ * re-survey -- so loader_return finds the GPU given back. At most 20 s; then the run ends anyway and a panic's quiesce
+ * halts the core's bus. Without icegpu_persist nothing (the timed levels end on their own, as before).
+ */
+void
+hakios_iceland_gpu_end(void)
+{
+	uint64_t t0 = ms_since_boot();
+	uint32_t i;
+
+	if (!persist || kit_phase == 0 || kit_phase == 3) {
+		return;
+	}
+	persist_stop = true;
+	thread_wakeup((event_t)&persist_event);
+	for (i = 0; i < 2000 && kit_phase != 3; i++) {
+		sleep_ms(10);
+	}
+	say("persist: the run's end: the GPU %s after %llu ms\n", kit_phase == 3 ? "IS GIVEN BACK (way down done)" :
+	    "is NOT down in 20 s (the core's bus is halted at loader_return)", ms_since_boot() - t0);
+}
+
+/*
+ * loader_return (through redwood_adreno_quiesce), the other processors stopped, nothing may sleep or lock: if the core
+ * still runs (a panic, or the 20 s above ran out), its bus is halted and the SQE stopped (as core_down, spinning), so
+ * nothing the GPU does reaches memory U-Boot and the next kernel reuse. The GMU / power are left (the run is followed by
+ * a reset); no line is printed.
+ */
+void
+hakios_iceland_gpu_quiesce(void)
+{
+	if (!core_live || gpu == 0 || !gmu_readable() || (G(G8_GMU_PWR_CLK_STATUS) & 3) != 0) {
+		return;
+	}
+	core_live = false;
+	wr(gpu + 4UL * G8_RBBM_INT_0_MASK, 0);
+	wr(gpu + 4UL * G8_GBIF_HALT, GBIF_CLIENT_HALT);
+	for (int n = 0; n < 1000000 && (G(G8_GBIF_HALT_ACK) & GBIF_CLIENT_HALT) != GBIF_CLIENT_HALT; n++) {
+	}
+	wr(gpu + 4UL * G8_GBIF_HALT, GBIF_ARB_HALT);
+	for (int n = 0; n < 1000000 && (G(G8_GBIF_HALT_ACK) & GBIF_ARB_HALT) != GBIF_ARB_HALT; n++) {
+	}
+	wr(gpu + 4UL * G8_CP_SQE_CNTL, 0);
+	settle();
+}
+
+/* within the kit's serve window: RedwoodGPU started on a space of its own */
+static bool
+redwood_begin(void)
+{
+	if (hakios_iceland_gpu_space_create(&rw_space) != 0) {
+		say("redwood: no space\n");
+		return false;
+	}
+	rw_free[0].start = WINDOW_BASE;
+	rw_free[0].size = WINDOW_SIZE;
+	rw_free_count = 1;
+	redwood_started = true;
+	redwood_on = true;
+	RedwoodGPUStart();
+	redwood_owned = true;                   /* (after the start: RedwoodGPU's lock exists from here on) */
+	if (persist && metal_arg) {
+		/* Metal kit 3: the plug-in named before the render server asks (RedwoodMetal.bundle through /redwood/Extensions) */
+		metal_named = RedwoodGPUNameMetalPlugin("RedwoodMetal", "NativeAdrenoMetalDevice");
+		say("redwood: Metal plug-in RedwoodMetal %s on IOAcceleratorES (icegpu_metal=1)\n", metal_named ? "NAMED" :
+		    "NOT named (no accelerator service)");
+	}
+	say("redwood: RedwoodGPU started on the Adreno 840 (space %u, ASID %u): Turnip's darwin KMD may open it\n", rw_space,
+	    2 + rw_space);
+	return true;
+}
+
+static void
+redwood_end(void)
+{
+	redwood_kit_ending = true;
+	rot_down_all();                         /* 31hk2: no blit taken from here; its space given back */
+	if (metal_named) {
+		/* processes started from here on stay on the software renderer */
+		metal_named = !RedwoodGPUNameMetalPlugin("", "");
+		say("redwood: Metal plug-in name %s\n", metal_named ? "NOT taken away" : "taken away");
+	}
+	if (!redwood_stop_asked) {
+		RedwoodGPUStop();               /* -> redwood_gpu_stop -> ice_gpu_stop: not ready from here */
+	}                                       /* (else the run's end holds RedwoodGPU's lock and waits for this) */
+	redwood_on = false;
+	if (last_fence) {
+		(void)hakios_iceland_gpu_wait(last_fence, 2000);
+	}
+	say("redwood: RedwoodGPU stopped: %u submissions, %u pages mapped, %u unmaps, %u buffers live, %llu bytes of "
+	    "addresses in use\n", rw_submits, rw_maps, rw_unmaps, rw_live, rw_used);
+	hakios_iceland_gpu_space_destroy(rw_space);
+	rw_space = ~0u;
+	redwood_started = false;
+}
+
+/* ---- 31hk1 / 31hk2: the A8xx 2D engine's rotated blit (gpurot_probe=1|2, MiniIOMobileFramebuffer's gpurot=1) --------- */
+
+/*
+ * Approach from hakios-metal 362a01b (oosexgang/hakios-metal, MIT: render.cpp encodeBlit and probe.cpp, the measured quarter
+ * turns of the 2D engine's ROTATE: on A6XX 1 = clockwise, 2 = half, 3 = anticlockwise) and SnapMetal Blit.m
+ * (Snapintosh/SnapMetal, MIT: the A8xx 2D blit's packet order); register numbers and fields from Mesa (MIT:
+ * src/freedreno/registers/adreno/a6xx.xml A8XX variants, freedreno/vulkan/tu_clear_blit.cc r2d_*). Credited, written
+ * here, nothing copied. The sense of ROTATE on A8XX is not known: gpurot_probe measures it.
+ *
+ * One IB, BR only: CCU colour clean + invalidate; GRAS_A2D_BLT_CNTL (0x8500 on A8XX) with the source rectangle and the
+ * destination's; RB_A2D_BLT_CNTL (0x8c00) the same word; RB_A2D_PIXEL_CNTL 0; TPL1_A2D_BLT_CNTL TYPE 2D; SP_A2D_OUTPUT_INFO;
+ * TPL1_A2D_SRC_TEXTURE_INFO / SIZE / BASE / PITCH, its flag base / pitch 0; RB_A2D_DEST_BUFFER_INFO / BASE / PITCH, its flag
+ * base / pitch 0; CP_BLIT (BLIT_OP_SCALE); CCU colour clean; CP_WAIT_FOR_IDLE. FMT6_8_8_8_8_UNORM on both sides with the
+ * same swap (a raw copy of 32-bit pixels, whatever their channel order), R2D_UNORM8, no filter, no scissor, linear, no UBWC.
+ * These are GPU context registers written by the command stream (PKT4), as Turnip writes them: no MMIO write, and the
+ * a840 has no RB_DBG_ECO_CNTL blit value and no blit_wfi_quirk (Mesa freedreno_devices.py), so no non-context register.
+ * RB_CCU_CACHE_CNTL is left as found: either of Turnip's layouts (sysmem / GMEM) serves a sysmem blit.
+ * Submitted the way Turnip's IBs are (submit_ex `full`: both CP threads, BV fence, BR waiting for it, then the fence with
+ * its interrupt), on an address space of its own (ASID 2 + n): its IB page, its destination, its sources.
+ *   gpurot_probe=1 (31hk1): right after the API opens, before RedwoodGPU: GPU scratch memory only (two kernel buffers of
+ *     the full frame's size and two small ones; neither is the panel). 64 x 32 unique words through ROTATE 1, 2, 3, each
+ *     result matched against all four turns and both flips; then 2400 x 3392 -> 3392 x 2400 with ROTATE 1 and 3, 260
+ *     points compared with our fbrotate=270 copy (rotateRow: upright x, y -> panel column y, row 2399 - x = anticlockwise)
+ *     and with fbrotate=90's; then 4 full-frame blits timed. A fence not back in 2 s: the GPU is hung -- logged with the
+ *     core's state, nothing freed (the GPU may still reach it), no GPU service (ice_gpu_recover has no recovery), the
+ *     core's way down halts its bus; the boot goes on without the GPU.
+ *   gpurot_probe=2: the same 30 s into the service (the state after Turnip's command buffers); a hang there stalls the
+ *     Metal clients (no recovery).
+ * Lines "icegpu: gpurot".
+ */
+#define A2D_GRAS_BLT_CNTL       0x8500u         /* (A6XX / A7XX: 0x8400); then SRC_XMIN..YMAX 0x8501-4, DEST_TL / BR 0x8505-6 */
+#define A2D_RB_BLT_CNTL         0x8c00u         /* + RB_A2D_PIXEL_CNTL 0x8c01 */
+#define A2D_RB_DEST_INFO        0x8c17u         /* + BASE lo / hi 0x8c18-9, PITCH 0x8c1a (bytes >> 6) */
+#define A2D_RB_DEST_FLAG        0x8c20u         /* flag base lo / hi, flag pitch */
+#define A2D_SP_OUTPUT_INFO      0xa9bfu
+#define A2D_TPL1_SRC_INFO       0xb2c0u         /* + SIZE 0xb2c1, BASE lo / hi 0xb2c2-3, PITCH 0xb2c4 (bytes << 3) */
+#define A2D_TPL1_SRC_FLAG       0xb2cau         /* flag base lo / hi, flag pitch */
+#define A2D_TPL1_BLT_CNTL       0xb2d2u
+#define CP_BLIT_OP              0x2cu
+#define BLIT_OP_SCALE           3u
+#define EV_CCU_CLEAN_COLOR      0x21u
+#define FMT6_8_8_8_8_UNORM      0x30u
+#define ROT_IB_IOVA             (WINDOW_BASE + 0x00000000ull)   /* one 16 KB page, GPU read-only */
+#define ROT_DST_IOVA            (WINDOW_BASE + 0x01000000ull)   /* the panel (31hk2) or the probe's destination: 64 MB */
+#define ROT_DST_BYTES           0x04000000ull
+#define ROT_SLOTS               4u
+#define ROT_SLOT_BYTES          0x04000000ull
+#define ROT_SLOT_IOVA(i)        (WINDOW_BASE + 0x08000000ull + ROT_SLOT_BYTES * (i))  /* sources, GPU read-only */
+#define ROT_SMALL_SRC           (WINDOW_BASE + 0x20000000ull)
+#define ROT_SMALL_DST           (WINDOW_BASE + 0x20100000ull)
+#define ROT_SMALL_W             64u
+#define ROT_SMALL_H             32u
+#define ROT_PROBE_MS            2000u
+
+static uint32_t rot_space = ~0u;
+static vm_offset_t rot_ib;              /* the IB page (kernel VA) */
+static bool rot_dst_mapped, rot_down;
+static uint64_t rot_dst_pa;
+static uint32_t rot_dst_w, rot_dst_h, rot_dst_pitch;
+static struct {
+	const void *key;                /* the surface object, its number and its first page: what is mapped in the slot */
+	uint32_t sid, pages;
+	uint64_t pa0, used;
+} rot_slot[ROT_SLOTS];
+static uint64_t rot_use;
+static uint32_t rot_last_fence, rot_blits, rot_slot_maps;
+static uint64_t rot_submit_abs;
+static LCK_GRP_DECLARE(icegpu_rot_group, "iceland-gpurot");
+static LCK_MTX_DECLARE(rot_lock, &icegpu_rot_group);
+
+static inline uint32_t
+rot_pkt4(uint32_t reg, uint32_t n)
+{
+	return 4u << 28 | n | odd_parity(n) << 7 | (reg & 0x3ffff) << 8 | odd_parity(reg) << 27;
+}
+
+static inline uint32_t
+rot_pkt7(uint32_t op, uint32_t n)
+{
+	return 7u << 28 | n | odd_parity(n) << 15 | op << 16 | odd_parity(op) << 23;
+}
+
+/* the blit's IB into rot_ib (the GPU is done with the one before: every blit is waited for); its words */
+static uint32_t
+rot_build(uint64_t src, uint32_t sw, uint32_t sh, uint32_t spitch, uint64_t dst, uint32_t dw, uint32_t dh, uint32_t dpitch,
+    uint32_t rot)
+{
+	volatile uint32_t *ib = (volatile uint32_t *)rot_ib;
+	uint32_t n = 0, cntl = (rot & 7) | FMT6_8_8_8_8_UNORM << 8 | 0xfu << 20;   /* MASK 0xf, IFMT R2D_UNORM8 (0) */
+
+	ib[n++] = rot_pkt7(CP_THREAD_CONTROL, 1);
+	ib[n++] = THREAD_BR;
+	ib[n++] = rot_pkt7(CP_EVENT_WRITE7, 1);
+	ib[n++] = EV_CCU_CLEAN_COLOR;
+	ib[n++] = rot_pkt7(CP_EVENT_WRITE7, 1);
+	ib[n++] = EV_CCU_INVALIDATE_COLOR;
+	ib[n++] = rot_pkt4(A2D_GRAS_BLT_CNTL, 7);
+	ib[n++] = cntl;
+	ib[n++] = 0;                            /* SRC_XMIN (<< 8) */
+	ib[n++] = (sw - 1) << 8;                /* SRC_XMAX */
+	ib[n++] = 0;                            /* SRC_YMIN */
+	ib[n++] = (sh - 1) << 8;                /* SRC_YMAX */
+	ib[n++] = 0;                            /* DEST_TL 0, 0 */
+	ib[n++] = (dw - 1) | (dh - 1) << 16;    /* DEST_BR */
+	ib[n++] = rot_pkt4(A2D_RB_BLT_CNTL, 2);
+	ib[n++] = cntl;
+	ib[n++] = 0;                            /* RB_A2D_PIXEL_CNTL: PIXEL_OP_DISABLED */
+	ib[n++] = rot_pkt4(A2D_TPL1_BLT_CNTL, 1);
+	ib[n++] = 1u << 29;                     /* TYPE A6XX_TEX_2D, RAW_COPY 0 */
+	ib[n++] = rot_pkt4(A2D_SP_OUTPUT_INFO, 1);
+	ib[n++] = FMT6_8_8_8_8_UNORM << 3 | 0xfu << 12;    /* OUTPUT_IFMT_2D_FLOAT, MASK 0xf */
+	ib[n++] = rot_pkt4(A2D_TPL1_SRC_INFO, 5);
+	ib[n++] = FMT6_8_8_8_8_UNORM | 1u << 20 | 1u << 22; /* linear, WZYX, UNK20 + UNK22 as Turnip sets them, no filter */
+	ib[n++] = sw | sh << 15;                /* SIZE */
+	ib[n++] = (uint32_t)src;
+	ib[n++] = (uint32_t)(src >> 32);
+	ib[n++] = spitch << 3;                  /* PITCH (bits 3..23; a multiple of 128 bytes for TYPE 2D) */
+	ib[n++] = rot_pkt4(A2D_TPL1_SRC_FLAG, 3);
+	ib[n++] = 0;
+	ib[n++] = 0;
+	ib[n++] = 0;
+	ib[n++] = rot_pkt4(A2D_RB_DEST_INFO, 4);
+	ib[n++] = FMT6_8_8_8_8_UNORM;           /* linear, WZYX */
+	ib[n++] = (uint32_t)dst;
+	ib[n++] = (uint32_t)(dst >> 32);
+	ib[n++] = dpitch >> 6;
+	ib[n++] = rot_pkt4(A2D_RB_DEST_FLAG, 3);
+	ib[n++] = 0;
+	ib[n++] = 0;
+	ib[n++] = 0;
+	ib[n++] = rot_pkt7(CP_BLIT_OP, 1);
+	ib[n++] = BLIT_OP_SCALE;
+	ib[n++] = rot_pkt7(CP_EVENT_WRITE7, 1);
+	ib[n++] = EV_CCU_CLEAN_COLOR;
+	ib[n++] = rot_pkt7(CP_WAIT_FOR_IDLE, 0);
+	to_memory(rot_ib, (vm_size_t)n * 4);
+	return n;
+}
+
+/* the space's table pages out to memory (after space_map(..., defer)) */
+static void
+rot_flush_tables(void)
+{
+	lck_mtx_lock(&icegpu_submit_lock);
+	pend_flush();
+	lck_mtx_unlock(&icegpu_submit_lock);
+}
+
+/* `bytes` of kernel memory at `kva` (4 KB aligned) into the rotation space at `iova`, 4 KB page by page */
+static bool
+rot_map_kva(uint64_t iova, vm_offset_t kva, uint64_t bytes, bool read_only)
+{
+	uint32_t pages = (uint32_t)((bytes + 0xfff) >> 12);
+
+	for (uint32_t i = 0; i < pages; i++) {
+		uint64_t pa = kvtophys(kva + 4096ul * i);
+
+		if (pa == 0 || space_map(rot_space, iova + 4096ull * i, pa & ~0xfffull, 4096, read_only, true) != 0) {
+			rot_flush_tables();
+			return false;
+		}
+	}
+	rot_flush_tables();
+	return true;
+}
+
+/* PTEs `from`..`to` (pages) of a slot cleared (a smaller surface now in it) */
+static void
+rot_clear(uint64_t iova, uint32_t from, uint32_t to)
+{
+	struct gspace *s = space_get(rot_space);
+
+	if (s == NULL) {
+		return;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	for (uint32_t i = from; i < to; i++) {
+		int t = space_l3(s, iova + 4096ull * i, false);
+
+		if (t >= 0) {
+			s->t[t][(iova + 4096ull * i) >> 12 & 0x1ff] = 0;
+			pend_add(s, t);
+		}
+	}
+	pend_flush();
+	lck_mtx_unlock(&icegpu_submit_lock);
+}
+
+/*
+ * The space's TLB entries dropped (CB0_TLBIASID + TLBSYNC, the writes hakios_iceland_gpu_space_destroy makes) and the next
+ * submission made to switch tables again (the CP's CACHE_INVALIDATE event with CP_SMMU_TABLE_UPDATE): a slot remapped
+ */
+static void
+rot_tlb_all(void)
+{
+	struct gspace *s = space_get(rot_space);
+
+	if (s == NULL) {
+		return;
+	}
+	lck_mtx_lock(&icegpu_submit_lock);
+	wr(smmu + SMMU_CB(0) + CB_TLBIASID, s->asid);
+	wr(smmu + SMMU_CB(0) + CB_TLBSYNC, 0);
+	writes += 2;
+	(void)wait_bits(smmu + SMMU_CB(0) + CB_TLBSTATUS, 1, 0, 100000);
+	if (cur_space == rot_space) {
+		cur_space = SPACE_KERNEL - 1;   /* (no space has this number: the next submit switches tables) */
+	}
+	lck_mtx_unlock(&icegpu_submit_lock);
+}
+
+/* rot_lock held: the space and its IB page */
+static bool
+rot_space_up(void)
+{
+	if (rot_space != ~0u) {
+		return true;
+	}
+	if (!api_up || !aperture_ok || rot_hung || rot_down) {
+		return false;
+	}
+	if (rot_ib == 0 && kmem_alloc(kernel_map, &rot_ib, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		rot_ib = 0;
+		return false;
+	}
+	if (hakios_iceland_gpu_space_create(&rot_space) != 0) {
+		rot_space = ~0u;
+		return false;
+	}
+	if (!rot_map_kva(ROT_IB_IOVA, rot_ib, PAGE_SIZE, true)) {
+		hakios_iceland_gpu_space_destroy(rot_space);
+		rot_space = ~0u;
+		return false;
+	}
+	bzero(rot_slot, sizeof(rot_slot));
+	rot_dst_mapped = false;
+	say("gpurot: space %u (ASID %u): IB page %#llx at GPU %#llx, read-only\n", rot_space, 2 + rot_space,
+	    kvtophys(rot_ib), ROT_IB_IOVA);
+	return true;
+}
+
+/* rot_lock held: the space given back (the ring off its tables first) and the IB page freed; false: kept (hung) */
+static bool
+rot_space_down(void)
+{
+	if (rot_space == ~0u) {
+		return true;
+	}
+	hakios_iceland_gpu_space_destroy(rot_space);
+	if (space_get(rot_space) != NULL) {
+		say("gpurot: space %u could not be given back: kept, with its pages (never freed)\n", rot_space);
+		return false;
+	}
+	rot_space = ~0u;
+	rot_dst_mapped = false;
+	if (rot_ib != 0) {
+		kmem_free(kernel_map, rot_ib, PAGE_SIZE);
+		rot_ib = 0;
+	}
+	return true;
+}
+
+/* rot_lock held: one blit submitted (not waited for); false: refused */
+static bool
+rot_submit(uint64_t src, uint32_t sw, uint32_t sh, uint32_t spitch, uint64_t dst, uint32_t dw, uint32_t dh, uint32_t dpitch,
+    uint32_t rot, uint32_t *fence)
+{
+	uint64_t ibva = ROT_IB_IOVA;
+	uint32_t words;
+
+	if ((rot & 1) ? (dw != sh || dh != sw) : (dw != sw || dh != sh)) {
+		return false;                   /* a quarter turn swaps the sides; anything else would be a scale */
+	}
+	if (sw == 0 || sh == 0 || sw > 16384 || sh > 16384 || spitch % 128 || dpitch % 64 || (src & 63) || (dst & 63) ||
+	    rot > 5) {
+		return false;
+	}
+	words = rot_build(src, sw, sh, spitch, dst, dw, dh, dpitch, rot);
+	rot_end_abs = 0;
+	rot_submit_abs = mach_absolute_time();
+	if (submit_ex(rot_space, &ibva, &words, 1, fence, true) != 0) {
+		return false;
+	}
+	rot_watch = *fence;
+	rot_last_fence = *fence;
+	rot_blits++;
+	return true;
+}
+
+/* the GPU's time for the last blit: its submission to the interrupt that saw its fence (us; 0: not seen) */
+static uint64_t
+rot_gpu_us(void)
+{
+	uint64_t end = rot_end_abs, ns;
+
+	if (end == 0 || end < rot_submit_abs) {
+		return 0;
+	}
+	absolutetime_to_nanoseconds(end - rot_submit_abs, &ns);
+	return ns / 1000;
+}
+
+static vm_offset_t
+rot_alloc(vm_size_t bytes)
+{
+	vm_offset_t va = 0;
+
+	if (kmem_alloc(kernel_map, &va, round_page(bytes), KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		return 0;
+	}
+	return va;
+}
+
+/* one word of a buffer the GPU wrote, from memory (its line out of the cache first) */
+static uint32_t
+rot_peek(vm_offset_t buf, uint32_t pitch, uint32_t x, uint32_t y)
+{
+	vm_offset_t a = buf + (vm_offset_t)y * pitch + 4ul * x;
+
+	__asm__ volatile ("dc civac, %0" : : "r" (a & ~(vm_offset_t)63) : "memory");
+	settle();
+	return *(volatile uint32_t *)a;
+}
+
+static void
+rot_poke(vm_offset_t buf, uint32_t pitch, uint32_t x, uint32_t y, uint32_t v)
+{
+	vm_offset_t a = buf + (vm_offset_t)y * pitch + 4ul * x;
+
+	*(volatile uint32_t *)a = v;
+	__asm__ volatile ("dc civac, %0" : : "r" (a & ~(vm_offset_t)63) : "memory");
+	settle();
+}
+
+static const char *const rot_turn_name[6] = { "unturned", "clockwise", "half turn", "ANTICLOCKWISE (= fbrotate=270)",
+	                                     "h-flip", "v-flip" };
+
+/* the source pixel turn `c` puts at destination dx, dy for a w x h source (quarter turns: an h x w destination) */
+static bool
+rot_turn_src(unsigned c, uint32_t w, uint32_t h, uint32_t dx, uint32_t dy, uint32_t *x, uint32_t *y)
+{
+	switch (c) {
+	case 0:
+		*x = dx;
+		*y = dy;
+		break;
+	case 1:                                 /* clockwise */
+		*x = dy;
+		*y = h - 1 - dx;
+		break;
+	case 2:
+		*x = w - 1 - dx;
+		*y = h - 1 - dy;
+		break;
+	case 3:                                 /* anticlockwise: rotateRow's 270 (upright x, y -> panel y, w - 1 - x) */
+		*x = w - 1 - dy;
+		*y = dx;
+		break;
+	case 4:
+		*x = w - 1 - dx;
+		*y = dy;
+		break;
+	default:
+		*x = dx;
+		*y = h - 1 - dy;
+		break;
+	}
+	return *x < w && *y < h;
+}
+
+static inline uint32_t
+rot_small_word(uint32_t x, uint32_t y)
+{
+	return 0x5a000000u | y << 8 | x;
+}
+
+static inline uint32_t
+rot_full_word(uint32_t x, uint32_t y)
+{
+	return 0xff000000u | y << 12 | x;       /* every pixel its own word (x, y < 4096) */
+}
+
+/* 31hk1; false only when a blit's fence never came back (rot_hung) */
+static bool
+rot_probe(const char *when)
+{
+	const uint32_t fw = 2400, fh = 3392, fsp = fw * 4, fdp = fh * 4;    /* upright 2400 x 3392; the panel 3392 x 2400 */
+	vm_offset_t ssrc = 0, sdst = 0, fsrc = 0, fdst = 0;
+	uint32_t f = 0, small270 = 0, full270 = 0, ptx[260], pty[260], np = 0;
+	uint64_t ns, t0;
+
+	say("gpurot probe (%s): the A8xx 2D engine's ROTATE on GPU scratch memory only (gpurot_probe=%u, GPU level %u)\n",
+	    when, rot_probe_arg, fixed_speed);
+	lck_mtx_lock(&rot_lock);
+	if (!rot_space_up()) {
+		lck_mtx_unlock(&rot_lock);
+		say("gpurot probe: no space / IB page: NOT RUN\n");
+		return true;
+	}
+	ssrc = rot_alloc(16384);
+	sdst = rot_alloc(16384);
+	fsrc = rot_alloc((vm_size_t)fsp * fh);
+	fdst = rot_alloc((vm_size_t)fdp * fw);
+	if (!ssrc || !sdst || !fsrc || !fdst) {
+		say("gpurot probe: no memory for the buffers: NOT RUN\n");
+		goto done;
+	}
+	for (uint32_t y = 0; y < ROT_SMALL_H; y++) {
+		for (uint32_t x = 0; x < ROT_SMALL_W; x++) {
+			((uint32_t *)ssrc)[y * ROT_SMALL_W + x] = rot_small_word(x, y);
+		}
+	}
+	for (uint32_t y = 0; y < fh; y++) {
+		for (uint32_t x = 0; x < fw; x++) {
+			((uint32_t *)fsrc)[(size_t)y * fw + x] = rot_full_word(x, y);
+		}
+	}
+	/* (the destinations too: no dirty line of the CPU's may land on what the GPU writes) */
+	to_memory(ssrc, 16384);
+	to_memory(sdst, 16384);
+	to_memory(fsrc, (vm_size_t)fsp * fh);
+	to_memory(fdst, (vm_size_t)fdp * fw);
+	if (!rot_map_kva(ROT_SMALL_SRC, ssrc, 16384, true) || !rot_map_kva(ROT_SMALL_DST, sdst, 16384, false) ||
+	    !rot_map_kva(ROT_SLOT_IOVA(0), fsrc, (uint64_t)fsp * fh, true) ||
+	    !rot_map_kva(ROT_DST_IOVA, fdst, (uint64_t)fdp * fw, false)) {
+		say("gpurot probe: buffers not mapped: NOT RUN\n");
+		goto done;
+	}
+	say("gpurot probe: scratch buffers (kernel memory, not the panel): small %#llx -> %#llx, full %#llx (%u KB) -> %#llx "
+	    "(%u KB)\n", kvtophys(ssrc), kvtophys(sdst), kvtophys(fsrc), fsp * fh / 1024, kvtophys(fdst), fdp * fw / 1024);
+
+	/* 1: 64 x 32 unique words, ROTATE 1, 2, 3; each result against every turn and flip */
+	for (uint32_t r = 1; r <= 3; r++) {
+		uint32_t dw = (r & 1) ? ROT_SMALL_H : ROT_SMALL_W, dh = (r & 1) ? ROT_SMALL_W : ROT_SMALL_H, count[6] = { 0 };
+		uint32_t best = 0, next = 0, x, y;
+
+		for (uint32_t i = 0; i < 16384 / 4; i++) {
+			((volatile uint32_t *)sdst)[i] = 0xdeadbeefu;
+		}
+		to_memory(sdst, 16384);
+		if (!rot_submit(ROT_SMALL_SRC, ROT_SMALL_W, ROT_SMALL_H, ROT_SMALL_W * 4, ROT_SMALL_DST, dw, dh, dw * 4, r, &f)) {
+			say("gpurot probe: small ROTATE %u refused\n", r);
+			continue;
+		}
+		t0 = mach_absolute_time();
+		if (hakios_iceland_gpu_wait(f, ROT_PROBE_MS) != 0) {
+			goto hung;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		to_memory(sdst, 16384);
+		for (uint32_t dy = 0; dy < dh; dy++) {
+			for (uint32_t dx = 0; dx < dw; dx++) {
+				uint32_t w = ((volatile uint32_t *)sdst)[dy * dw + dx];
+
+				for (unsigned c = 0; c < 6; c++) {
+					count[c] += rot_turn_src(c, ROT_SMALL_W, ROT_SMALL_H, dx, dy, &x, &y) && w == rot_small_word(x, y);
+				}
+			}
+		}
+		for (unsigned c = 1; c < 6; c++) {
+			best = count[c] > count[best] ? c : best;
+		}
+		next = best == 0 ? 1 : 0;
+		for (unsigned c = 0; c < 6; c++) {
+			next = c != best && count[c] > count[next] ? c : next;
+		}
+		say("gpurot probe: small 64x32 ROTATE %u -> %ux%u: %s, %u of %u texels (next %s %u); first word %08x; %llu us\n", r,
+		    dw, dh, count[best] == dw * dh ? rot_turn_name[best] : "NO TURN MATCHES", count[best], dw * dh,
+		    rot_turn_name[next], count[next], ((volatile uint32_t *)sdst)[0], ns / 1000);
+		if (best == 3 && count[best] == dw * dh) {
+			small270 = r;
+		}
+		(void)core_faulted("gpurot probe small");
+	}
+
+	/* 2: the full frame, ROTATE 1 and 3: 16 x 16 points of the destination and its corners */
+	for (uint32_t j = 0; j < 16; j++) {
+		for (uint32_t i = 0; i < 16; i++) {
+			ptx[np] = (2 * i + 1) * fh / 32;
+			pty[np++] = (2 * j + 1) * fw / 32;
+		}
+	}
+	ptx[np] = 0;
+	pty[np++] = 0;
+	ptx[np] = fh - 1;
+	pty[np++] = 0;
+	ptx[np] = 0;
+	pty[np++] = fw - 1;
+	ptx[np] = fh - 1;
+	pty[np++] = fw - 1;
+	for (uint32_t r = 1; r <= 3; r += 2) {
+		uint32_t m270 = 0, m90 = 0, untouched = 0, x, y;
+
+		for (uint32_t k = 0; k < np; k++) {
+			rot_poke(fdst, fdp, ptx[k], pty[k], 0xdeadbeefu);
+		}
+		if (!rot_submit(ROT_SLOT_IOVA(0), fw, fh, fsp, ROT_DST_IOVA, fh, fw, fdp, r, &f)) {
+			say("gpurot probe: full ROTATE %u refused\n", r);
+			continue;
+		}
+		t0 = mach_absolute_time();
+		if (hakios_iceland_gpu_wait(f, ROT_PROBE_MS) != 0) {
+			goto hung;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		for (uint32_t k = 0; k < np; k++) {
+			uint32_t w = rot_peek(fdst, fdp, ptx[k], pty[k]);
+
+			m270 += rot_turn_src(3, fw, fh, ptx[k], pty[k], &x, &y) && w == rot_full_word(x, y);
+			m90 += rot_turn_src(1, fw, fh, ptx[k], pty[k], &x, &y) && w == rot_full_word(x, y);
+			untouched += w == 0xdeadbeefu;
+		}
+		say("gpurot probe: full %ux%u -> %ux%u ROTATE %u: our fbrotate=270 copy at %u of %u points, fbrotate=90's at %u, "
+		    "untouched %u; centre word %08x; %llu us (GPU %llu us)\n", fw, fh, fh, fw, r, m270, np, m90, untouched,
+		    rot_peek(fdst, fdp, fh / 2, fw / 2), ns / 1000, rot_gpu_us());
+		if (m270 == np) {
+			full270 = r;
+		}
+		(void)core_faulted("gpurot probe full");
+	}
+
+	/* 3: the full frame timed, four times, with the turn that equals our copy (else ROTATE 3) */
+	{
+		uint32_t r = full270 ? full270 : small270 ? small270 : 3, n = 0;
+		uint64_t wmin = ~0ull, wmax = 0, wsum = 0, gmin = ~0ull, gmax = 0, gsum = 0;
+
+		for (uint32_t i = 0; i < 4; i++) {
+			if (!rot_submit(ROT_SLOT_IOVA(0), fw, fh, fsp, ROT_DST_IOVA, fh, fw, fdp, r, &f)) {
+				break;
+			}
+			t0 = mach_absolute_time();
+			if (hakios_iceland_gpu_wait(f, ROT_PROBE_MS) != 0) {
+				goto hung;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			uint64_t g = rot_gpu_us();
+
+			wmin = ns / 1000 < wmin ? ns / 1000 : wmin;
+			wmax = ns / 1000 > wmax ? ns / 1000 : wmax;
+			wsum += ns / 1000;
+			gmin = g < gmin ? g : gmin;
+			gmax = g > gmax ? g : gmax;
+			gsum += g;
+			n++;
+		}
+		if (n != 0) {
+			uint64_t avg = wsum / n, mbs = avg ? (uint64_t)fsp * fh * 2 / avg : 0;    /* bytes / us = MB/s */
+
+			say("gpurot probe: RESULT: ROTATE that equals our fbrotate=270 copy: %u (small test %u, full frame %u) -> "
+			    "gpurot_rot=%u; full frame ROTATE %u (%u MB read + written): wall us min %llu avg %llu max %llu, GPU us min "
+			    "%llu avg %llu max %llu (%llu MB/s), %u blits\n", full270 ? full270 : small270, small270, full270,
+			    full270 ? full270 : small270, r, fsp * fh / 1048576, wmin, avg, wmax, gmin, gsum / n, gmax, mbs, n);
+		}
+	}
+	(void)core_faulted("gpurot probe");
+done:
+	/* nothing in flight here: the space back (its tables), then the buffers */
+	if (rot_space_down()) {
+		if (ssrc) {
+			kmem_free(kernel_map, ssrc, round_page(16384));
+		}
+		if (sdst) {
+			kmem_free(kernel_map, sdst, round_page(16384));
+		}
+		if (fsrc) {
+			kmem_free(kernel_map, fsrc, round_page((vm_size_t)fsp * fh));
+		}
+		if (fdst) {
+			kmem_free(kernel_map, fdst, round_page((vm_size_t)fdp * fw));
+		}
+	}
+	lck_mtx_unlock(&rot_lock);
+	say("gpurot probe: done (%u blits); GPU scratch buffers %s\n", rot_blits, rot_space == ~0u ? "freed" : "KEPT");
+	return true;
+hung:
+	rot_hung = true;
+	say("gpurot probe: fence %u NOT back in %u ms (GPU fence word %u): THE GPU IS HUNG; no recovery (ice_gpu_recover has "
+	    "none): the space and the scratch buffers are kept (never freed), no gpurot from here\n", f, ROT_PROBE_MS,
+	    fence_view ? fence_view[FENCE_OFF / 4] : 0);
+	core_state("gpurot probe");
+	(void)core_faulted("gpurot probe (hung)");
+	lck_mtx_unlock(&rot_lock);
+	return false;
+}
+
+/*
+ * 31hk2 (MiniIOMobileFramebuffer gpurot=1): the panel as the blit's destination and the frames' surfaces as its sources.
+ * The panel's memory (the boot framebuffer, outside the kernel's DRAM) is mapped into the rotation space read-write: THE
+ * GPU WRITES THE MEMORY THE DISPLAY SCANS (a new kind of write target) through a NEW GPU SMMU mapping of that range. Each
+ * blit is waited for by the caller (a fence and its interrupt); a slot is remapped only when no blit is in flight.
+ */
+bool hakios_iceland_gpurot_on(void);
+int hakios_iceland_gpurot_target(uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch);
+int hakios_iceland_gpurot_blit(const void *key, uint32_t sid, const uint8_t *pixels, uint64_t bytes, uint32_t w, uint32_t h,
+    uint32_t pitch, uint32_t rot, uint32_t *fence);
+int hakios_iceland_gpurot_wait(uint32_t fence, uint32_t ms, uint64_t *gpu_us);
+bool hakios_iceland_gpurot_done(uint32_t fence);
+
+bool
+hakios_iceland_gpurot_on(void)
+{
+	return redwood_on && api_up && aperture_ok && !rot_hung && !rot_down;
+}
+
+int
+hakios_iceland_gpurot_target(uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch)
+{
+	uint64_t bytes = (uint64_t)pitch * h;
+	int rc = -1;
+
+	if (!hakios_iceland_gpurot_on() || pa == 0 || (pa & 0xfff) || bytes == 0 || bytes > ROT_DST_BYTES) {
+		return -1;
+	}
+	lck_mtx_lock(&rot_lock);
+	if (rot_dst_mapped && rot_dst_pa == pa && rot_dst_w == w && rot_dst_h == h && rot_dst_pitch == pitch) {
+		rc = 0;
+	} else if (!rot_dst_mapped && rot_space_up()) {
+		if (space_map(rot_space, ROT_DST_IOVA, pa, (bytes + 0xfff) & ~0xfffull, false, true) == 0) {
+			rot_flush_tables();
+			rot_dst_mapped = true;
+			rot_dst_pa = pa;
+			rot_dst_w = w;
+			rot_dst_h = h;
+			rot_dst_pitch = pitch;
+			rc = 0;
+			say("gpurot: the panel %#llx (%llu KB, %ux%u, %u bytes a row) mapped at GPU %#llx in space %u (ASID %u), "
+			    "READ-WRITE: the GPU may write the memory the display scans\n", pa, bytes >> 10, w, h, pitch, ROT_DST_IOVA,
+			    rot_space, 2 + rot_space);
+		} else {
+			rot_flush_tables();
+		}
+	}
+	lck_mtx_unlock(&rot_lock);
+	return rc;
+}
+
+int
+hakios_iceland_gpurot_blit(const void *key, uint32_t sid, const uint8_t *pixels, uint64_t bytes, uint32_t w, uint32_t h,
+    uint32_t pitch, uint32_t rot, uint32_t *fence)
+{
+	vm_offset_t first = (vm_offset_t)pixels & ~(vm_offset_t)0xfff;
+	uint64_t off = (vm_offset_t)pixels & 0xfff, pa0;
+	uint32_t pages = (uint32_t)((off + bytes + 0xfff) >> 12), slot = ROT_SLOTS;
+	int rc = -1;
+
+	if (!hakios_iceland_gpurot_on() || pixels == NULL || off + bytes > ROT_SLOT_BYTES || (off & 63)) {
+		return -1;
+	}
+	lck_mtx_lock(&rot_lock);
+	if (!rot_dst_mapped || rot_space == ~0u || (rot_last_fence != 0 && fence_view != NULL &&
+	    (int32_t)(fence_view[FENCE_OFF / 4] - rot_last_fence) < 0)) {
+		goto out;                       /* (no panel, or the blit before still in flight: the caller copies) */
+	}
+	pa0 = kvtophys(first);
+	for (uint32_t i = 0; i < ROT_SLOTS && slot == ROT_SLOTS; i++) {
+		if (rot_slot[i].key == key && rot_slot[i].sid == sid && rot_slot[i].pa0 == pa0 && rot_slot[i].pages >= pages) {
+			slot = i;
+		}
+	}
+	if (slot == ROT_SLOTS) {
+		bool had;
+
+		slot = 0;
+		for (uint32_t i = 1; i < ROT_SLOTS; i++) {
+			slot = rot_slot[i].used < rot_slot[slot].used ? i : slot;
+		}
+		had = rot_slot[slot].pages != 0;
+		rot_slot[slot].pages = 0;
+		rot_slot[slot].key = NULL;
+		if (pa0 == 0 || !rot_map_kva(ROT_SLOT_IOVA(slot), first, (uint64_t)pages << 12, true)) {
+			goto out;
+		}
+		if (had) {
+			rot_clear(ROT_SLOT_IOVA(slot), pages, (uint32_t)(ROT_SLOT_BYTES >> 12));
+			rot_tlb_all();
+		}
+		rot_slot[slot].key = key;
+		rot_slot[slot].sid = sid;
+		rot_slot[slot].pa0 = pa0;
+		rot_slot[slot].pages = pages;
+		rot_slot_maps++;
+	}
+	rot_slot[slot].used = ++rot_use;
+	rc = rot_submit(ROT_SLOT_IOVA(slot) + off, w, h, pitch, ROT_DST_IOVA, rot_dst_w, rot_dst_h, rot_dst_pitch, rot, fence) ?
+	    0 : -1;
+out:
+	lck_mtx_unlock(&rot_lock);
+	return rc;
+}
+
+int
+hakios_iceland_gpurot_wait(uint32_t fence, uint32_t ms, uint64_t *gpu_us)
+{
+	int rc = hakios_iceland_gpu_wait(fence, ms);
+
+	if (gpu_us != NULL) {
+		*gpu_us = rc == 0 && rot_watch == fence ? rot_gpu_us() : 0;
+	}
+	return rc;
+}
+
+bool
+hakios_iceland_gpurot_done(uint32_t fence)
+{
+	volatile uint32_t *view = fence_view;
+
+	return view == NULL || !api_up || (int32_t)(view[FENCE_OFF / 4] - fence) >= 0;
+}
+
+/* the service's end (redwood_end): no blit taken from here; the last waited for (200 ms), the space given back */
+static void
+rot_down_all(void)
+{
+	lck_mtx_lock(&rot_lock);
+	rot_down = true;
+	if (rot_space != ~0u) {
+		if (rot_last_fence != 0 && hakios_iceland_gpu_wait(rot_last_fence, 200) != 0) {
+			say("gpurot: the last blit (fence %u) is not done at the way down: space %u kept\n", rot_last_fence, rot_space);
+		} else {
+			(void)rot_space_down();
+		}
+		say("gpurot: down: %u blits, %u slot maps\n", rot_blits, rot_slot_maps);
+	}
+	lck_mtx_unlock(&rot_lock);
+}
+
+/*
+ * 31bm1 / 31st1: kern.icebench_phase (world-writable int): the touch script's phase (libhakios.input.dylib inject_bench.c);
+ * MiniIOMobileFramebuffer.cpp reads hakios_icebench_phase each frame and splits its frame statistics by it.
+ */
+volatile int hakios_icebench_phase;
+volatile uint64_t hakios_icebench_at;
+
+static int
+sysctl_icebench_phase SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = hakios_icebench_phase, error, changed = 0;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value < 0 || value > 9999) {
+		return EINVAL;
+	}
+	hakios_icebench_at = mach_absolute_time();
+	hakios_icebench_phase = value;
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, icebench_phase, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_ANYBODY, NULL, 0,
+    sysctl_icebench_phase, "I", "31bm1: the touch benchmark's phase (frame statistics split by it)");
+
+/* ---- all of it ------------------------------------------------------------------------------------------------------ */
+
+/*
+ * S11 g6, the tablet probe (icegpu_early=1 on the UniXNU route, before the root): what the run reached, said in one line at its
+ * end ("icegpu: PROBE PASS ..." / "icegpu: PROBE FAIL ..."), for a grep of the log A3 brings back. Not with icegpu_persist.
+ */
+static const char *probe_stop;          /* why the run stopped before the GPU was up, or NULL */
+static bool probe_fw, probe_tables, probe_up, probe_clean = true, probe_core, probe_api, probe_cx_on;
+static uint32_t probe_differ = UINT32_MAX;
+
+static void
+probe_report(uint32_t stage, bool early)
+{
+	const char *at = NULL;
+	char why[48];
+
+	/* (short strings: the kernel's __TEXT has ~4 KB to spare in the collection's hole) */
+	why[0] = 0;
+	if (probe_stop != NULL) {
+		at = probe_stop;
+	} else if (stage < 2) {
+		at = !probe_fw ? "firmware" : !probe_tables ? "cmd-db tables" : NULL;
+	} else if (!probe_up) {
+		at = "GMU start";
+	} else if (stage >= 4 && !probe_core) {
+		at = "core (SQE, zap, CP init, fence)";
+	} else if (stage >= 6 && !probe_api) {
+		at = "API self-test";
+	} else if (stage >= 3 && !probe_clean) {
+		at = "clean way down";
+	} else if (probe_cx_on) {
+		at = "CX left on";
+	} else if (stage >= 3 && probe_differ != 0) {
+		snprintf(why, sizeof(why), "re-survey (%u differ)", probe_differ);
+		at = why;
+	}
+	if (at != NULL) {
+		say("PROBE FAIL stage %u%s: at %s; fw %s, tables %s\n", stage, early ? " early" : "", at, probe_fw ? "ok" : "NO",
+		    probe_tables ? "ok" : "NO");
+		return;
+	}
+	say("PROBE PASS stage %u%s: %s%s%s%s%s\n", stage, early ? " early" : "", stage < 2 ? "survey, fw, tables" : "GMU up",
+	    stage >= 4 ? ", SQE, zap, CP init, fence" : "", stage >= 5 ? ", IB + IRQ fence" : "",
+	    stage >= 6 ? ", spaces, submit, wait" : "", stage >= 3 ? ", down clean, all put back" : "");
+}
+
+static void
+icegpu_run(uint32_t stage)
+{
+	uint32_t hold = 10, speed = 1, binmask = 0x4;
+	uint32_t found_sysreset = 1, found_pwrclk = 3, serve = 0, selftest = 0, delay = 3000;
+	bool have_fw, have_tables, up = false, clean = true, memory = false, core_ok = false, api_ok = false;
+
+	PE_parse_boot_argn("icegpu_selftest", &selftest, sizeof(selftest));
+	PE_parse_boot_argn("icegpu_metal", &metal_arg, sizeof(metal_arg));
+	PE_parse_boot_argn("gpurot_probe", &rot_probe_arg, sizeof(rot_probe_arg));     /* 31hk1 */
+	PE_parse_boot_argn("icegpu_ubwcread", &ubwc_read_arg, sizeof(ubwc_read_arg));  /* 32vm4a */
+	if (persist) {
+		/*
+		 * ipad14m: the kit thread starts ~0.8 s before launchd (redwood_input_init) and the whole bring-up takes ~70 ms; only
+		 * the 3 s start delay put the service (07:30:49.1) after launchd (07:30:46.9). Without it the GPU serves before
+		 * launchd starts the render server. icegpu_delay=MS still sets it.
+		 */
+		delay = 0;
+	}
+	PE_parse_boot_argn("icegpu_delay", &delay, sizeof(delay));
+	PE_parse_boot_argn("icegpu_hold", &hold, sizeof(hold));
+	PE_parse_boot_argn("icegpu_speed", &speed, sizeof(speed));
+	PE_parse_boot_argn("icegpu_binmask", &binmask, sizeof(binmask));
+	PE_parse_boot_argn("icegpu_xo", &gmu_on_xo, sizeof(gmu_on_xo));
+	stage5 = stage >= 5;
+	stage6 = stage >= 6;
+	PE_parse_boot_argn("icegpu_serve", &serve, sizeof(serve));
+	PE_parse_boot_argn("icegpu_redwood", &serve_redwood, sizeof(serve_redwood));
+	scm_waitq = stage >= 5;
+	if (delay != 0) {
+		sleep_ms(delay);
+	}
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	gpu = ml_io_map(GPU_PHYS, GPU_SIZE);
+	smmu = ml_io_map(SMMU_PHYS, SMMU_SIZE);
+	cmd_db = (const uint8_t *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	if (!gcc || !gpu || !smmu || !cmd_db) {
+		say("cannot map the blocks\n");
+		probe_stop = "mapping";
+		return;
+	}
+	say("Adreno 840 survey kit, stage %u (hold %u s, speed index %u, bin mask %#x)%s\n", stage, hold, speed, binmask,
+	    persist ? ": PERSISTENT SERVICE (icegpu_persist=1)" : "");
+	if (persist) {
+		say("persist: coming up at %llu ms since boot (self-test %s, start delay %u ms)\n", ms_since_boot(), selftest ?
+		    "once, no hold" : "off", delay);
+		say_when("after the start delay");
+	}
+
+	/* 1: the survey */
+	say("survey: CX %s (GDSCR %#x status %#x), GMU block %s, SMMU %s\n", cx_on() ? "ON" : "off", CC(CX_GDSCR),
+	    CC(CX_GDS_HW_CTRL), gmu_readable() ? "readable" : "NOT read (CX or its clocks off)",
+	    smmu_readable() ? "readable" : "NOT read (CX or its clock off)");
+	survey(&found, false);
+	if (found.gmu) {
+		uint32_t slices = CXM(G8_CX_MISC_CX_MISC_SLICE_ENABLE_FINAL) & 7;
+
+		found_sysreset = G(G8_GMU_CM3_SYSRESET);
+		found_pwrclk = G(G8_GMU_PWR_CLK_STATUS);
+		say("survey: GMU sysreset %#x init %#x (%s), GX %s; slices %#x -> chip id %#x\n", found_sysreset,
+		    G(G8_GMU_CM3_FW_INIT_RESULT), (found_sysreset & 1) ? "held in reset" : "RUNNING",
+		    (found_pwrclk & 3) == 3 ? "off" : "ON", slices, DT_CHIP_ID | (uint32_t)__builtin_popcount(slices) << 4);
+	}
+	have_fw = fw_check();
+	have_tables = tables_build(binmask);
+	probe_fw = have_fw;
+	probe_tables = have_tables;
+	say("survey done: %u register writes so far (0 expected)\n", writes);
+	if (stage < 2) {
+		return;
+	}
+	if (!have_fw || !have_tables) {
+		say("stage %u needs the firmware and the tables: stopping after the survey\n", stage);
+		probe_stop = !have_fw ? "firmware" : "cmd-db tables";
+		return;
+	}
+	if (speed == 0 || speed >= n_gpu) {
+		say("icegpu_speed=%u is not a level 1..%u: stopping\n", speed, n_gpu - 1);
+		probe_stop = "icegpu_speed";
+		return;
+	}
+	if (!(found_sysreset & 1)) {
+		say("the GMU's CM3 is out of reset already: an earlier kernel or the boot chain left it; not starting over it\n");
+		probe_stop = "survey (GMU runs)";
+		return;
+	}
+	if ((found_pwrclk & 3) != 3) {
+		say("GX has power already: not starting over it\n");
+		probe_stop = "survey (GX on)";
+		return;
+	}
+
+	/* 2: up */
+	if (!memory_make()) {
+		memory_free();
+		probe_stop = "GMU memory";
+		return;
+	}
+	memory = true;
+	if (persist) {
+		say_when("survey, firmware and tables done");
+	}
+	up = power_up() && smmu_context_on() && gmu_up(speed);
+	if (persist) {
+		say_when(up ? "the GMU is up" : "the GMU did NOT come up");
+	}
+	if (up && stage >= 4) {      /* (stage 5: the same, plus its additions inside core_up) */
+		core_ok = core_up();
+		core_live = core_sqe_on;        /* (a panic's loader_return halts its bus from here: hakios_iceland_gpu_quiesce) */
+		if (persist) {
+			say_when(core_ok ? "the core is up (stage 5's checks done)" : "the core did NOT come up");
+		}
+		if (!core_ok) {
+			say("CORE FAILED: the GMU's way down follows (clean)\n");
+		} else if (stage6 && persist) {
+			/* the GPU kept for the system: no hold; the self-test only when asked, once, without its hold */
+			hold = 0;
+			api_ok = api_open() && aperture_ok && (!selftest || api_selftest(0));
+			if (api_ok && rot_probe_arg == 1) {
+				/* 31hk1: before RedwoodGPU; a hung blit leaves no GPU service (the way down halts the core's bus) */
+				(void)rot_probe("before the service");
+				api_ok = !rot_hung;
+			}
+			if (api_ok) {
+				dev_serve(0);   /* until the run's end (hakios_iceland_gpu_end / RedwoodGPUStop) */
+			} else {
+				say("persist: THE API DID NOT COME UP (%s): no service; the way down follows\n", !api_up ?
+				    "fence view not mapped" : !aperture_ok ? "TZ refused the SMMU aperture" : rot_hung ?
+				    "the gpurot probe's blit never finished: no recovery (ice_gpu_recover has none); the boot goes on without "
+				    "the GPU" : "self-test failed");
+			}
+			api_down();
+		} else if (stage6) {
+			api_ok = api_selftest(hold);
+			hold = 0;               /* (the self-test held the GPU with its submissions) */
+#if defined(XNU_TARGET_OS_OSX)
+			if (api_ok) {
+				/* g6b-1 (iceagx_client=1 iceagx_selftest=2): the ABI v2 client driven on this GPU, then withdrawn */
+				agx_probe_window();
+			}
+#endif
+			if (api_ok && serve) {
+				dev_serve(serve);
+			}
+			api_down();
+		}
+	}
+	if (up) {
+		for (uint32_t s = 1; s <= hold; s++) {
+			sleep_ms(1000);
+			heartbeat(s);
+		}
+	} else {
+		say("UP FAILED: back the short way\n");
+	}
+
+	/* down */
+	if (core_oob || core_sqe_on || zap_loaded) {
+		core_down();
+	}
+	if (gmu_readable() && (gmu_started || fw_loaded)) {
+		if (up && stage >= 3) {
+			clean = gmu_shutdown();
+		} else {
+			gmu_force_off();
+		}
+		gx_check();
+	}
+	if (gmu_readable() && G(G8_GMU_CM3_SYSRESET) != 1) {
+		say("THE GMU IS NOT IN RESET (%#x): its memory is kept (never freed)\n", G(G8_GMU_CM3_SYSRESET));
+		memory = false;
+	}
+	if (core_cb >= 0 && !smmu_readable()) {
+		say("the SMMU is not readable any more: the core's context is left (memory kept)\n");
+		memory = false;
+	}
+	core_smmu_off();
+	if (smmu_readable()) {
+		smmu_context_off();
+	} else if (ctx_cb >= 0) {
+		say("the SMMU is not readable any more: its context is left (memory kept)\n");
+		memory = false;
+	}
+	if (hfi != NULL) {
+		ml_io_unmap((vm_offset_t)hfi, HFI_SIZE);
+		hfi = NULL;
+	}
+	power_back();
+	if (memory) {
+		memory_free();
+	}
+	say("down: %s; CX %s, %u register writes in all\n", up ? (stage >= 3 ? (clean ? "clean" : "clean way FAILED, forced")
+	    : "forced (stage 2)") : "after a failure", cx_on() ? "STILL ON" : "off", writes);
+	if (up) {
+		say("RESULT: chip id %#x, GMU firmware %#x, always-on %u Hz, %u GPU levels, %u bus levels%s\n", chip_id, fw_version,
+		    ao_hz, n_gpu, n_bw, stage < 4 ? "" : !core_ok ? "; CORE FAILED" : persist ? (api_ok ? "; CORE OK, PERSISTENT SERVICE: served until the run's end" :
+		    "; CORE OK, PERSISTENT SERVICE FAILED") : stage6 ? (api_ok ? "; CORE OK, API: spaces, submit, wait, hold OK" : "; CORE OK, API FAILED") : stage5 ? "; CORE: SQE, zap, secure exit, FENCE OK, protect, hwcg, IB + FENCE 2 OK, TLBIVA OK" : "; CORE: SQE, zap, secure exit, FENCE OK");
+	}
+	probe_up = up;
+	probe_clean = clean;
+	probe_core = core_ok;
+	probe_api = api_ok;
+	probe_cx_on = cx_on();
+	if (stage >= 3) {
+		uint32_t differ;
+
+		survey(&after, true);
+		differ = survey_compare(&found, &after);
+		probe_differ = differ;
+		say("re-survey: %u registers differ from what was found%s\n", differ, differ ? "" : ": ALL PUT BACK");
+	}
+}
+
+static bool kit_early;                  /* icegpu_early=1: started from GenericARMPE, before the root */
+
+static void
+icegpu_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)parameter;
+
+	icegpu_run(stage);
+	if (persist) {
+		say("persist: the kit's thread is done at %llu ms since boot%s\n", ms_since_boot(), persist_stop ?
+		    " (the run's end is waiting for this)" : "");
+	} else {
+		probe_report(stage, kit_early);
+	}
+	kit_phase = 3;
+}
+
+void hakios_iceland_gpu_init_early(void);
+
+void
+hakios_iceland_gpu_init(void)
+{
+	static bool started;    /* (from GenericARMPE with icegpu_early=1, else from redwood_input_init: once) */
+	uint32_t stage = 0;
+	thread_t thread;
+
+	if (started || !PE_parse_boot_argn("icegpu", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	started = true;
+#if defined(XNU_TARGET_OS_OSX)
+	spaces = kalloc_data(SPACES_MAX * sizeof(*spaces), Z_WAITOK | Z_ZERO);
+	if (spaces == NULL) {
+		printf("icegpu: no memory for the %u address spaces; the GPU stays off\n",
+		    (unsigned)(SPACES_MAX * sizeof(*spaces)));
+		return;
+	}
+#endif
+	if (stage > 6) {
+		stage = 6;
+	}
+	PE_parse_boot_argn("icegpu_persist", &persist, sizeof(persist));
+	if (persist && stage != 6) {
+		say("icegpu_persist=1 needs icegpu=6 (stage %u): ignored\n", stage);
+		persist = 0;
+	}
+	kit_init_at = mach_absolute_time();
+	kit_phase = 1;
+	if (kernel_thread_start(icegpu_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		kit_phase = 3;
+	}
+}
+
+/*
+ * S11 g6, boot-arg icegpu_early=1 (with icegpu=N): the kit started from GenericARMPE once the processors are registered,
+ * before the root is mounted, so a tablet run that stops at the root wait (the UniXNU route, until S8's root) still runs it;
+ * A3's re-entry brings its lines back (reset-after; loader_return quiesces the core first). Without it the kit starts
+ * from redwood_input_init, after the root, as before. Nothing here reads or writes storage: the firmware is the images
+ * linked into the kernel (fw_image), and none of the stages touches a disk.
+ */
+void
+hakios_iceland_gpu_init_early(void)
+{
+	uint32_t early = 0, stage = 0;
+
+	if (!PE_parse_boot_argn("icegpu_early", &early, sizeof(early)) || early == 0 ||
+	    !PE_parse_boot_argn("icegpu", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	kit_early = true;
+	say("early start, stage %u: before the root\n", stage);
+	hakios_iceland_gpu_init();
+}
+
+/*
+ * gains1 (21 Nov): the GPU row of the memory telemetry (osfmk/arm64/hakios_memtel.c, icemem=). What this driver holds,
+ * read when asked, with no state of its own: the GPU spaces in use, the page-table memory they took (their table
+ * groups), the 4 KB pages their windows map (the valid entries of their level-3 tables -- every client's buffers,
+ * Turnip's and RedwoodGPU's, as the GPU sees them), and the icegpu device's buffers (kernel pages / imported, i.e.
+ * wired user pages). Under icegpu_submit_lock (the spaces) and icegpu_dev_lock (the buffers), each held only for its
+ * own walk.
+ */
+void hakios_iceland_gpu_mem_row(uint32_t *spaces_used, uint64_t *table_bytes, uint64_t *mapped_pages, uint64_t *dev_kernel,
+    uint64_t *dev_wired);
+
+void
+hakios_iceland_gpu_mem_row(uint32_t *spaces_used, uint64_t *table_bytes, uint64_t *mapped_pages, uint64_t *dev_kernel,
+    uint64_t *dev_wired)
+{
+	*spaces_used = 0;
+	*table_bytes = 0;
+	*mapped_pages = 0;
+	*dev_kernel = 0;
+	*dev_wired = 0;
+#if defined(XNU_TARGET_OS_OSX)
+	if (spaces == NULL) {
+		return;
+	}
+#endif
+	lck_mtx_lock(&icegpu_submit_lock);
+	for (uint32_t i = 0; i < SPACES_MAX; i++) {
+		const struct gspace *s = &spaces[i];
+
+		if (!s->used) {
+			continue;
+		}
+		(*spaces_used)++;
+		*table_bytes += (uint64_t)((s->n + TABLES_PER_GROUP - 1) / TABLES_PER_GROUP) * TABLES_PER_GROUP * TABLE_BYTES;
+		for (uint32_t k3 = 0; k3 < SPACE_L3; k3++) {
+			const uint64_t *t;
+
+			if (s->l3_at[k3] <= 0 || (unsigned)(s->l3_at[k3] - 1) >= s->n) {
+				continue;
+			}
+			t = s->t[s->l3_at[k3] - 1];
+			for (uint32_t e = 0; e < 512; e++) {
+				*mapped_pages += t[e] & 1;
+			}
+		}
+	}
+	lck_mtx_unlock(&icegpu_submit_lock);
+	lck_mtx_lock(&icegpu_dev_lock);
+	for (uint32_t h = 0; h < DEV_BOS; h++) {
+		if (dev_bo[h].va == 0) {
+			continue;
+		}
+		if (dev_bo[h].map != NULL) {
+			*dev_wired += dev_bo[h].size;
+		} else {
+			*dev_kernel += dev_bo[h].size;
+		}
+	}
+	lck_mtx_unlock(&icegpu_dev_lock);
+}
diff --git a/bsd/dev/hakios_iceland_harvest.c b/bsd/dev/hakios_iceland_harvest.c
new file mode 100644
index 0000000000000000000000000000000000000000..95d3c211b2e5c3304459cc328989758ba39e36b9
--- /dev/null
+++ b/bsd/dev/hakios_iceland_harvest.c
@@ -0,0 +1,14047 @@
+/*
+ * Harvest kits 18 / 19 (31 Oct 2026): items other ports of iOS to Qualcomm phones solved, each behind its own boot-arg,
+ * nothing at all without it. Lines "iceh: ", "icepath: ", "icedpu: ", "iceidle: " (the loader keeps "ice" lines).
+ *
+ *   icepathlog=NAME   (log only) every FAILED open/openat of a process called NAME (the first 400): path, flags,
+ *                     errno. After ShueiTsuki/data-a-live patches 0285/0323 (pathlog; same SoC, xnu-8796). For the
+ *                     poster store ("errno=-1"), cfprefsd and the daemons that crash-loop.
+ *   icedpu=1          (class B: reads only) the display controller (MDSS 0x09800000, DPU 13.0) as the bootloader left
+ *                     it: control paths, every source pipe with an address (format, sizes, stride, the address it
+ *                     fetches), mixers, DSI interfaces 1-2, a second look 100 ms later (frame counters move?), and
+ *                     the apps-SMMU route of the display stream (SID 0x800). Registers and offsets from data-a-live
+ *                     wsl/pandora_dpu.c (patch 0215, read-only probe on SM8850) = mainline dpu_13_0_kaanapali.h.
+ *                     Step 1 towards the display reading the GPU's frames itself (their 0217: 60 -> 110 fps, no CPU
+ *                     copy); the writes that would need are kit 19 material and NOT here.
+ *   iceidle=1         (class C stage 1: PSCI queries only) PSCI_VERSION and PSCI_FEATURES(CPU_SUSPEND /
+ *                     SET_SUSPEND_MODE / STAT_RESIDENCY) asked once, logged; nothing changed.
+ *   iceidle=2         (class C stage 2: NEW firmware call) idle cores enter the DT's "retention" state, PSCI
+ *                     CPU_SUSPEND(0x4) (standby, context kept, no entry point), when the next timer is >= 560 us
+ *                     (cpu 0-5) / 686 us (cpu 6-7) away; WFI otherwise; 8 refusals on a core -> WFI only again.
+ *                     After data-a-live wsl/pandora_cpu_idle.c (0215). Started 20 s after this init; a census every 30 s.
+ *   (icebl_ui=1: the brightness service, iokit/Kernel/HakiosIcelandBacklightUI.cpp)
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
