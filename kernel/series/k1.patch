+	lck_mtx_destroy(&pass.lock, &cs_native4k_pass_grp);
+	error = os_atomic_load(&pass.error, relaxed);
+	if (error != 0) {
+		goto out;
+	}
+
+	kr = mach_vm_protect(kernel_map, storage, allocation, FALSE, VM_PROT_READ);
+	if (kr != KERN_SUCCESS) {
+		error = EPERM;
+		goto out;
+	}
+	blob->csb_native4k_hashes = (const uint8_t *)storage;
+	blob->csb_native4k_hashes_size = allocation;
+	blob->csb_native4k_hash_count = count;
+	storage = 0;
+	os_atomic_inc(&cs_native4k_ready_blobs, relaxed);
+	error = 0;
+out:
+	if (storage) {
+		kmem_free(kernel_map, storage, allocation);
+	}
+	return error;
+}
+
+/*
+ * What loading signatures with 16 KiB hash pages costs on this kernel, for sysctl vm.cs_native4k_stats and a board's log.
+ * cs_native4k_prepare reads such an image up to its code limit and hashes it twice when its signature is added, in the
+ * thread that adds it. The classes say who waits: [0] an image activation (exec), [1] a library or bundle whose signature
+ * dyld registers (F_ADDFILESIGS), [2] either kind above CS_NATIVE4K_UNCACHED (the dyld shared cache files and any other
+ * image that large), read uncached and so read again when their pages fault. Each has its blobs, the bytes read and the
+ * ticks spent in the prepare.
+ * cs_native4k_touched counts the original 16 KiB blocks that had a page validated at least once ([1]: those of class 2
+ * blobs): a kernel that authenticated a block when one of its pages is first validated would have read and hashed only
+ * these. The table numbers are the wired bytes of derived hashes held now and at most. Nothing here changes what is read,
+ * accepted or refused.
+ * With cs-lazy=1 (below) a blob is counted in its class with its code limit and the time of its set-up only; the read
+ * and hash times, the bytes and the blocks hashed then are those of the blocks authenticated at their first use, and the
+ * table numbers are the tables of chunk pointers and the chunks allocated so far.
+ */
+struct cs_native4k_class {
+	uint64_t        blobs;
+	uint64_t        bytes;
+	uint64_t        ticks;
+};
+struct cs_native4k_class cs_native4k_classes[3];
+unsigned long cs_native4k_touched[2];
+unsigned long cs_native4k_table_bytes = 0;
+unsigned long cs_native4k_table_bytes_peak = 0;
+unsigned long cs_native4k_released_blobs = 0;
+unsigned long cs_native4k_refused_blobs = 0;
+/* The longest single prepare: its ticks, bytes and file name, under the lock. */
+static LCK_GRP_DECLARE(cs_native4k_lck_grp, "cs_native4k");
+static LCK_MTX_DECLARE(cs_native4k_longest_lock, &cs_native4k_lck_grp);
+static uint64_t cs_native4k_longest_ticks = 0;
+static uint64_t cs_native4k_longest_bytes = 0;
+static char cs_native4k_longest_name[32];
+
+/* One bit per original 16 KiB block of a blob with csb_native4k_hash_count derived hashes, in 32 bit words. */
+static vm_size_t
+cs_native4k_touched_words(vm_size_t hash_count)
+{
+	return (((hash_count + 3) >> 2) + 31) >> 5;
+}
+
+static int
+cs_native4k_prepare_measured(vnode_t vp, struct cs_blob *blob, bool image_activation)
+{
+	if (blob->csb_hash_pageshift <= PAGE_SHIFT) {
+		return 0;
+	}
+
+	const uint64_t start = mach_absolute_time();
+	int error = cs_native4k_lazy ? cs_native4k_lazy_prepare(vp, blob) : 0;
+	if (error == 0 && blob->csb_native4k_lazy == NULL) {
+		error = cs_native4k_prepare(vp, blob);
+	}
+	const uint64_t ticks = mach_absolute_time() - start;
+
+	if (error != 0 || (blob->csb_native4k_hashes == NULL && blob->csb_native4k_lazy == NULL)) {
+		os_atomic_inc(&cs_native4k_refused_blobs, relaxed);
+		return error;
+	}
+
+	const uint64_t bytes = ntohl(blob->csb_cd->codeLimit);
+	struct cs_native4k_class *counts =
+	    &cs_native4k_classes[bytes > CS_NATIVE4K_UNCACHED ? 2 : (image_activation ? 0 : 1)];
+	os_atomic_inc(&counts->blobs, relaxed);
+	os_atomic_add(&counts->bytes, bytes, relaxed);
+	os_atomic_add(&counts->ticks, ticks, relaxed);
+
+	/* A lazy blob has no such table; its own were counted when they were made. */
+	const unsigned long table_bytes =
+	    os_atomic_add(&cs_native4k_table_bytes, (unsigned long)blob->csb_native4k_hashes_size, relaxed);
+	if (table_bytes > os_atomic_load(&cs_native4k_table_bytes_peak, relaxed)) {
+		os_atomic_store(&cs_native4k_table_bytes_peak, table_bytes, relaxed);
+	}
+
+	/* Without the map the blob works the same and its blocks are not counted. */
+	blob->csb_native4k_touched = kalloc_data(
+		cs_native4k_touched_words(blob->csb_native4k_hash_count) * sizeof(uint32_t), Z_WAITOK | Z_ZERO);
+
+	if (ticks > os_atomic_load(&cs_native4k_longest_ticks, relaxed)) {
+		const char *name = vnode_getname(vp);
+		lck_mtx_lock(&cs_native4k_longest_lock);
+		if (ticks > cs_native4k_longest_ticks) {
+			os_atomic_store(&cs_native4k_longest_ticks, ticks, relaxed);
+			cs_native4k_longest_bytes = bytes;
+			strlcpy(cs_native4k_longest_name, name != NULL ? name : "?", sizeof(cs_native4k_longest_name));
+		}
+		lck_mtx_unlock(&cs_native4k_longest_lock);
+		if (name != NULL) {
+			vnode_putname(name);
+		}
+	}
+	return 0;
+}
+
+/* The blob's derived hashes are about to be freed: take them out of the count and free its map of touched blocks. */
+static void
+cs_native4k_forget(struct cs_blob *blob)
+{
+	os_atomic_sub(&cs_native4k_table_bytes, (unsigned long)blob->csb_native4k_hashes_size, relaxed);
+	os_atomic_inc(&cs_native4k_released_blobs, relaxed);
+	if (blob->csb_native4k_touched != NULL) {
+		kfree_data(blob->csb_native4k_touched,
+		    cs_native4k_touched_words(blob->csb_native4k_hash_count) * sizeof(uint32_t));
+		blob->csb_native4k_touched = NULL;
+	}
+}
+
+/* A page with this derived hash index is being validated: count its original block the first time. */
+static void
+cs_native4k_touch(const struct cs_blob *blob, vm_size_t index, bool uncached)
+{
+	uint32_t *map = blob->csb_native4k_touched;
+	const vm_size_t block = index >> 2;
+	const uint32_t bit = 1U << (block & 31);
+
+	if (map == NULL || (os_atomic_or_orig(&map[block >> 5], bit, relaxed) & bit) != 0) {
+		return;
+	}
+	os_atomic_inc(&cs_native4k_touched[0], relaxed);
+	if (uncached) {
+		os_atomic_inc(&cs_native4k_touched[1], relaxed);
+	}
+}
+
+/*
+ * The lazy form, boot argument cs-lazy=1 (fixed at boot, so a blob is of one form for its life). Adding a signature
+ * reads nothing. An original 16 KiB block is authenticated when one of its 4 KiB pages is first validated: its pages are
+ * paged in one after the other and copied into a private buffer, the buffer is hashed and compared with the block's
+ * slot of the code directory, and only on a match the hashes of its 4 KiB parts, made from that same buffer, are
+ * recorded and the block becomes ready. A page is then validated against its recorded hash, as in the eager form, so
+ * no byte is accepted that the signed 16 KiB hash does not cover: any buffer that matches the signed hash holds the
+ * signed bytes, whatever the file did meanwhile and however many threads authenticate the block at once. A block whose
+ * buffer does not match becomes bad, and its pages are answered tainted, unless another thread's buffer made it ready.
+ * A block that is neither is answered "not validated, not tainted", the answer for a page without a hash: nothing
+ * accepts the page, no page is marked, and the VM, which asks cs_native4k_lazy_pending before each validation,
+ * authenticates and comes back.
+ *
+ * The states and the derived hashes live in chunks of 31 blocks (one page for 496 KiB of the file), allocated when
+ * a block of theirs is first authenticated and found through a table of chunk pointers. Table and chunks are mapped
+ * read-only before they can be reached, as the eager table is, and are written through the physical aperture, the way
+ * the read-only zone allocator writes its elements on a kernel without a monitor (pmap_ro_zone_memcpy). The pointer to
+ * the table is a field of the blob, which is in that read-only zone.
+ *
+ * Instead of the eager form's refusal of a whole image at load: the structural checks are the same, an image shorter
+ * than its code limit is refused, and a block that does not match its signed hash is found when it is first used and
+ * taints its pages, which is what a kernel with native 16 KiB pages does page by page.
+ */
+#define CS_LAZY_BLOCK           16384
+#define CS_LAZY_SLOT            32      /* bytes kept per derived hash; a larger hash keeps the blob eager */
+/*
+ * One page per chunk. The blocks a boot authenticates are sparse inside the files of the dyld shared cache: with
+ * four-page chunks of 127 blocks, 43685 authenticated blocks held about 34 MiB of chunks, about 20 blocks per chunk,
+ * so more than 80 % of that wired memory held no answer. A smaller chunk holds the same answers with less unused.
+ */
+#define CS_LAZY_CHUNK_BLOCKS    31
+#define CS_LAZY_CHUNK_SIZE      4096
+#define CS_LAZY_UNKNOWN         0
+#define CS_LAZY_READY           1
+#define CS_LAZY_BAD             2
+/* The answer of cs_validate_hash for a block that is not authenticated, kept inside this file. */
+#define CS_VALIDATE_UNREADY     0x80000000
+
+struct cs_native4k_lazy_chunk {
+	_Atomic uint8_t state[CS_LAZY_CHUNK_BLOCKS + 1];
+	uint8_t         hash[CS_LAZY_CHUNK_BLOCKS][CS_LAZY_BLOCK / 4096][CS_LAZY_SLOT];
+	uint8_t         unused[CS_LAZY_CHUNK_SIZE - (CS_LAZY_CHUNK_BLOCKS + 1) -
+	    CS_LAZY_CHUNK_BLOCKS * (CS_LAZY_BLOCK / 4096) * CS_LAZY_SLOT];
+};
+_Static_assert(sizeof(struct cs_native4k_lazy_chunk) == CS_LAZY_CHUNK_SIZE, "a chunk is one page");
+
+struct cs_native4k_lazy {
+	vm_size_t       allocation;     /* bytes of this table */
+	uint32_t        blocks;         /* original blocks up to the code limit */
+	uint32_t        chunks;
+	struct cs_native4k_lazy_chunk *_Atomic chunk[];
+};
+
+TUNABLE(uint32_t, cs_native4k_lazy, "cs-lazy", 0);
+unsigned long cs_native4k_lazy_blobs = 0;       /* blobs added in the lazy form */
+unsigned long cs_native4k_lazy_blocks = 0;      /* blocks authenticated, ready */
+unsigned long cs_native4k_lazy_bad = 0;         /* blocks that did not match their signed hash */
+unsigned long cs_native4k_lazy_errors = 0;      /* authentications that could not read or allocate */
+unsigned long cs_native4k_lazy_unready = 0;     /* validations answered "not authenticated" */
+uint64_t cs_native4k_lazy_ticks = 0;            /* inside the authentications */
+unsigned long cs_native4k_lazy_counts[CS_LAZY_COUNTERS];
+/* Held only to record an answer, never across a read. */
+static LCK_MTX_DECLARE(cs_native4k_lazy_lock, &cs_native4k_lck_grp);
+
+void
+cs_native4k_lazy_count(unsigned int counter)
+{
+	if (counter < CS_LAZY_COUNTERS) {
+		os_atomic_inc(&cs_native4k_lazy_counts[counter], relaxed);
+	}
+}
+
+static void
+cs_native4k_lazy_wired(unsigned long bytes)
+{
+	const unsigned long table_bytes = os_atomic_add(&cs_native4k_table_bytes, bytes, relaxed);
+	if (table_bytes > os_atomic_load(&cs_native4k_table_bytes_peak, relaxed)) {
+		os_atomic_store(&cs_native4k_table_bytes_peak, table_bytes, relaxed);
+	}
+}
+
+/* Through the writable address of each page (vm_fault_cs_lazy_alias: the physical aperture). */
+static void
+cs_native4k_lazy_write(const void *address, const void *data, size_t length)
+{
+	const uint8_t *to = address, *from = data;
+
+	while (length != 0) {
+		const size_t part = MIN(length, (size_t)PAGE_SIZE - ((uintptr_t)to & PAGE_MASK));
+		memcpy(vm_fault_cs_lazy_alias(to), from, part);
+		to += part;
+		from += part;
+		length -= part;
+	}
+}
+
+static int
+cs_native4k_lazy_prepare(vnode_t vp, struct cs_blob *blob)
+{
+	const CS_CodeDirectory *cd = blob->csb_cd;
+	const struct cs_hash *md = blob->csb_hashtype;
+	vm_offset_t storage = 0;
+	vm_size_t allocation;
+	uint64_t limit;
+	off_t end, size = 0;
+	int error;
+
+	/* What cs_native4k_prepare requires of a signature. */
+	if (PAGE_SHIFT != 12 || blob->csb_hash_pageshift != 14 || cd == NULL || md == NULL ||
+	    md->cs_size == 0 || md->cs_size > CS_HASH_MAX_SIZE ||
+	    md->cs_digest_size > CS_HASH_MAX_SIZE || blob->csb_base_offset < 0 ||
+	    (blob->csb_base_offset & PAGE_MASK) || blob->csb_hash_firstlevel_pageshift ||
+	    ((ntohl(cd->version) >= CS_SUPPORTSSCATTER) && ntohl(cd->scatterOffset))) {
+		return ENOTSUP;
+	}
+	limit = ntohl(cd->codeLimit);
+	if (!limit || ((ntohl(cd->version) >= CS_SUPPORTSCODELIMIT64) &&
+	    ntohll(cd->codeLimit64) && ntohll(cd->codeLimit64) != limit) ||
+	    ntohl(cd->nCodeSlots) != ((limit + 16383) >> 14)) {
+		return ENOTSUP;
+	}
+	if (md->cs_size > CS_LAZY_SLOT) {
+		/* No slot holds this hash: the caller makes the eager table. */
+		return 0;
+	}
+	/* The eager read fails on an image that ends before its code limit. */
+	error = vnode_size(vp, &size, vfs_context_current());
+	if (error != 0) {
+		return error;
+	}
+	if (os_add_overflow(blob->csb_base_offset, (off_t)limit, &end) || end > size) {
+		return EIO;
+	}
+
+	const uint32_t blocks = (uint32_t)((limit + CS_LAZY_BLOCK - 1) / CS_LAZY_BLOCK);
+	const uint32_t chunks = (blocks + CS_LAZY_CHUNK_BLOCKS - 1) / CS_LAZY_CHUNK_BLOCKS;
+	allocation = round_page(sizeof(struct cs_native4k_lazy) + (vm_size_t)chunks * sizeof(struct cs_native4k_lazy_chunk *));
+	if (kmem_alloc(kernel_map, &storage, allocation, KMA_KOBJECT | KMA_ZERO, VM_KERN_MEMORY_SECURITY) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	struct cs_native4k_lazy *lazy = (struct cs_native4k_lazy *)storage;
+	lazy->allocation = allocation;
+	lazy->blocks = blocks;
+	lazy->chunks = chunks;
+	if (mach_vm_protect(kernel_map, storage, allocation, FALSE, VM_PROT_READ) != KERN_SUCCESS) {
+		kmem_free(kernel_map, storage, allocation);
+		return EPERM;
+	}
+	cs_native4k_lazy_wired((unsigned long)allocation);
+	blob->csb_native4k_lazy = lazy;
+	blob->csb_native4k_hash_count = (vm_size_t)((limit + PAGE_MASK) >> PAGE_SHIFT);
+	os_atomic_inc(&cs_native4k_lazy_blobs, relaxed);
+	return 0;
+}
+
+/* The blob is being freed and nothing can validate against it any more. */
+static void
+cs_native4k_lazy_free(struct cs_blob *blob)
+{
+	struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+	unsigned long bytes = (unsigned long)lazy->allocation;
+
+	for (uint32_t i = 0; i < lazy->chunks; i++) {
+		struct cs_native4k_lazy_chunk *chunk = os_atomic_load(&lazy->chunk[i], relaxed);
+		if (chunk != NULL) {
+			kmem_free(kernel_map, (vm_offset_t)chunk, CS_LAZY_CHUNK_SIZE);
+			bytes += CS_LAZY_CHUNK_SIZE;
+		}
+	}
+	kmem_free(kernel_map, (vm_offset_t)lazy, lazy->allocation);
+	os_atomic_sub(&cs_native4k_table_bytes, bytes, relaxed);
+	os_atomic_inc(&cs_native4k_released_blobs, relaxed);
+	if (blob->csb_native4k_touched != NULL) {
+		kfree_data(blob->csb_native4k_touched,
+		    cs_native4k_touched_words(blob->csb_native4k_hash_count) * sizeof(uint32_t));
+		blob->csb_native4k_touched = NULL;
+	}
+	blob->csb_native4k_lazy = NULL;
+	blob->csb_native4k_hash_count = 0;
+}
+
+/* The chunk of a block; with create, a new one is put in the table when there is none (NULL when there is no memory). */
+static struct cs_native4k_lazy_chunk *
+cs_native4k_lazy_chunk(const struct cs_native4k_lazy *lazy, uint32_t block, bool create)
+{
+	const uint32_t index = block / CS_LAZY_CHUNK_BLOCKS;
+	struct cs_native4k_lazy_chunk *chunk = os_atomic_load(&lazy->chunk[index], acquire);
+	vm_offset_t storage = 0;
+
+	if (chunk != NULL || !create) {
+		return chunk;
+	}
+	if (kmem_alloc(kernel_map, &storage, CS_LAZY_CHUNK_SIZE, KMA_KOBJECT | KMA_DATA | KMA_ZERO,
+	    VM_KERN_MEMORY_SECURITY) != KERN_SUCCESS) {
+		return NULL;
+	}
+	if (mach_vm_protect(kernel_map, storage, CS_LAZY_CHUNK_SIZE, FALSE, VM_PROT_READ) != KERN_SUCCESS) {
+		kmem_free(kernel_map, storage, CS_LAZY_CHUNK_SIZE);
+		return NULL;
+	}
+	struct cs_native4k_lazy_chunk *_Atomic *slot = vm_fault_cs_lazy_alias(&lazy->chunk[index]);
+	if (os_atomic_cmpxchgv(slot, NULL, (struct cs_native4k_lazy_chunk *)storage, &chunk, release)) {
+		cs_native4k_lazy_wired(CS_LAZY_CHUNK_SIZE);
+		os_atomic_inc(&cs_native4k_chunks_made, relaxed);
+		return (struct cs_native4k_lazy_chunk *)storage;
+	}
+	/* Another thread's chunk is in the table. */
+	kmem_free(kernel_map, storage, CS_LAZY_CHUNK_SIZE);
+	return chunk;
+}
+
+static uint8_t
+cs_native4k_lazy_state(const struct cs_native4k_lazy *lazy, uint32_t block)
+{
+	const struct cs_native4k_lazy_chunk *chunk = cs_native4k_lazy_chunk(lazy, block, false);
+
+	return chunk == NULL ? CS_LAZY_UNKNOWN : os_atomic_load(&chunk->state[block % CS_LAZY_CHUNK_BLOCKS], acquire);
+}
+
+/*
+ * Records the answer for a block: ready with its derived hashes, or bad. Ready is final and its hashes are written once,
+ * before the state; bad gives way to ready (another thread's buffer matched) and never replaces it.
+ */
+static void
+cs_native4k_lazy_record(struct cs_native4k_lazy_chunk *chunk, uint32_t block, const void *derived)
+{
+	const uint32_t at = block % CS_LAZY_CHUNK_BLOCKS;
+	_Atomic uint8_t *state = vm_fault_cs_lazy_alias(&chunk->state[at]);
+
+	lck_mtx_lock(&cs_native4k_lazy_lock);
+	const uint8_t now = os_atomic_load(state, relaxed);
+	if (now != CS_LAZY_READY && derived != NULL) {
+		cs_native4k_lazy_write(chunk->hash[at], derived, sizeof(chunk->hash[at]));
+		os_atomic_store(state, CS_LAZY_READY, release);
+		os_atomic_inc(&cs_native4k_lazy_blocks, relaxed);
+		os_atomic_inc(&cs_native4k_full_blocks, relaxed);
+	} else if (now == CS_LAZY_UNKNOWN) {
+		os_atomic_store(state, CS_LAZY_BAD, release);
+		os_atomic_inc(&cs_native4k_lazy_bad, relaxed);
+		os_atomic_inc(&cs_validate_page_bad_hash, relaxed);
+	}
+	lck_mtx_unlock(&cs_native4k_lazy_lock);
+}
+
+/*
+ * The blob that validates this page of the file, when it is a lazy one and the page has a derived hash; the choice of
+ * the blob is that of cs_validate_hash.
+ */
+static const struct cs_blob *
+cs_native4k_lazy_find(struct vnode *vp, memory_object_offset_t page_offset, uint32_t *block)
+{
+	if (!cs_native4k_lazy || vp == NULL) {
+		return NULL;
+	}
+	for (const struct cs_blob *blob = ubc_get_cs_blobs(vp); blob != NULL; blob = blob->csb_next) {
+		const off_t offset = (off_t)page_offset - blob->csb_base_offset;
+		if (offset < blob->csb_start_offset || offset >= blob->csb_end_offset ||
+		    blob->csb_mem_kaddr == NULL || blob->csb_cd == NULL) {
+			continue;
+		}
+		const struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+		if (lazy == NULL || blob->csb_hash_pageshift != 14 || (offset & PAGE_MASK) ||
+		    offset >= (off_t)ntohl(blob->csb_cd->codeLimit) || (uint64_t)offset / CS_LAZY_BLOCK >= lazy->blocks) {
+			return NULL;
+		}
+		*block = (uint32_t)((uint64_t)offset / CS_LAZY_BLOCK);
+		return blob;
+	}
+	return NULL;
+}
+
+boolean_t
+cs_native4k_lazy_pending(struct vnode *vp, memory_object_offset_t page_offset)
+{
+	uint32_t block = 0;
+	const struct cs_blob *blob = cs_native4k_lazy_find(vp, page_offset, &block);
+
+	return blob != NULL && cs_native4k_lazy_state(blob->csb_native4k_lazy, block) == CS_LAZY_UNKNOWN;
+}
+
+/* Authenticates one block that has no answer yet. */
+static kern_return_t
+cs_native4k_lazy_block(struct vnode *vp, const struct cs_blob *blob, uint32_t block)
+{
+	const struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+	const CS_CodeDirectory *cd = blob->csb_cd;
+	const struct cs_hash *md = blob->csb_hashtype;
+	const uint64_t start = (uint64_t)block * CS_LAZY_BLOCK;
+	const size_t length = (size_t)MIN((uint64_t)CS_LAZY_BLOCK, (uint64_t)ntohl(cd->codeLimit) - start);
+	const memory_object_offset_t position = (memory_object_offset_t)blob->csb_base_offset + start;
+	const memory_object_control_t control = ubc_getobject(vp, UBC_FLAGS_NONE);
+	const uint64_t read_start = mach_absolute_time();
+	uint8_t derived[CS_LAZY_BLOCK / 4096][CS_LAZY_SLOT];
+	uint8_t digest[CS_HASH_MAX_SIZE];
+	union cs_hash_union ctx;
+	kern_return_t kr = KERN_SUCCESS;
+	uint8_t *buffer;
+
+	if (control == MEMORY_OBJECT_CONTROL_NULL) {
+		return KERN_MEMORY_ERROR;
+	}
+	buffer = kalloc_data(CS_LAZY_BLOCK, Z_WAITOK);
+	if (buffer == NULL) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	/* One page at a time: no page is held busy while the next one is paged in. */
+	for (size_t sub = 0; sub < length && kr == KERN_SUCCESS; sub += PAGE_SIZE) {
+		kr = vm_fault_cs_lazy_fetch(control, position + sub, position, position + CS_LAZY_BLOCK, buffer + sub);
+	}
+	const uint64_t hash_start = mach_absolute_time();
+	os_atomic_add(&cs_native4k_read_ticks, hash_start - read_start, relaxed);
+	if (kr == KERN_SUCCESS) {
+		const char *lower = blob->csb_mem_kaddr;
+		const uint8_t *expected = hashes(cd, block, md->cs_size, lower, lower + blob->csb_mem_size);
+		bool matches = false;
+
+		os_atomic_add(&cs_native4k_bytes, (uint64_t)length, relaxed);
+		if (expected != NULL) {
+			struct cs_native4k_clock clock;
+			cs_native4k_clock_start(&clock);
+			md->cs_init(&ctx);
+			md->cs_update(&ctx, buffer, length);
+			md->cs_final(digest, &ctx);
+			matches = bcmp(expected, digest, md->cs_size) == 0;
+			if (matches) {
+				bzero(derived, sizeof(derived));
+				for (size_t sub = 0; sub < length; sub += PAGE_SIZE) {
+					md->cs_init(&ctx);
+					md->cs_update(&ctx, buffer + sub, MIN((size_t)PAGE_SIZE, length - sub));
+					md->cs_final(digest, &ctx);
+					memcpy(derived[sub >> PAGE_SHIFT], digest, md->cs_size);
+				}
+			}
+			cs_native4k_clock_stop(&clock, (matches ? 2 : 1) * (uint64_t)length);
+		}
+		const uint64_t chunk_start = mach_absolute_time();
+		struct cs_native4k_lazy_chunk *chunk = cs_native4k_lazy_chunk(lazy, block, true);
+		const uint64_t record_start = mach_absolute_time();
+		os_atomic_add(&cs_native4k_chunk_ticks, record_start - chunk_start, relaxed);
+		if (chunk == NULL) {
+			kr = KERN_RESOURCE_SHORTAGE;
+		} else {
+			cs_native4k_lazy_record(chunk, block, matches ? derived : NULL);
+			os_atomic_add(&cs_native4k_record_ticks, mach_absolute_time() - record_start, relaxed);
+		}
+	}
+	if (kr != KERN_SUCCESS) {
+		os_atomic_inc(&cs_native4k_lazy_errors, relaxed);
+	}
+	const uint64_t end = mach_absolute_time();
+	os_atomic_add(&cs_native4k_hash_ticks, end - hash_start, relaxed);
+	os_atomic_add(&cs_native4k_lazy_ticks, end - read_start, relaxed);
+	kfree_data(buffer, CS_LAZY_BLOCK);
+	return kr;
+}
+
+kern_return_t
+cs_native4k_lazy_authenticate(struct vnode *vp, memory_object_offset_t offset, vm_size_t length, unsigned int site)
+{
+	const memory_object_offset_t end = offset + length;
+
+	for (memory_object_offset_t page = offset & ~(memory_object_offset_t)PAGE_MASK; page < end; page += PAGE_SIZE) {
+		uint32_t block = 0;
+		const struct cs_blob *blob = cs_native4k_lazy_find(vp, page, &block);
+
+		if (blob == NULL || cs_native4k_lazy_state(blob->csb_native4k_lazy, block) != CS_LAZY_UNKNOWN) {
+			continue;
+		}
+		cs_native4k_lazy_count(site);
+		const kern_return_t kr = cs_native4k_lazy_block(vp, blob, block);
+		if (kr != KERN_SUCCESS) {
+			return kr;
+		}
+	}
+	return KERN_SUCCESS;
+}
+
+/*
+ * The derived hash of a page of a lazy blob for cs_validate_hash, or NULL with the answer: CS_VALIDATE_UNREADY for a
+ * block that is not authenticated, CS_VALIDATE_TAINTED for a bad block and for a page that has no derived hash.
+ */
+static const unsigned char *
+cs_native4k_lazy_hash(const struct cs_blob *blob, off_t offset, off_t limit, size_t hash_size, unsigned *answer)
+{
+	const struct cs_native4k_lazy *lazy = blob->csb_native4k_lazy;
+	const uint64_t block = (uint64_t)offset / CS_LAZY_BLOCK;
+
+	*answer = CS_VALIDATE_TAINTED;
+	if (offset < 0 || (offset & PAGE_MASK) || offset >= limit || block >= lazy->blocks || hash_size > CS_LAZY_SLOT) {
+		return NULL;
+	}
+	const struct cs_native4k_lazy_chunk *chunk = cs_native4k_lazy_chunk(lazy, (uint32_t)block, false);
+	const uint8_t state =
+	    chunk == NULL ? CS_LAZY_UNKNOWN : os_atomic_load(&chunk->state[block % CS_LAZY_CHUNK_BLOCKS], acquire);
+	if (state == CS_LAZY_READY) {
+		return chunk->hash[block % CS_LAZY_CHUNK_BLOCKS][((uint64_t)offset % CS_LAZY_BLOCK) >> PAGE_SHIFT];
+	}
+	if (state == CS_LAZY_UNKNOWN) {
+		*answer = CS_VALIDATE_UNREADY;
+		os_atomic_inc(&cs_native4k_lazy_unready, relaxed);
+	}
+	return NULL;
+}
+
+/*
+ * The counters as one line: per class blobs/size/ms, then the ms inside the reads and inside the hashing, the 16 KiB
+ * blocks hashed and the ones touched (of those, in class 2 blobs), the page validations served from derived hashes, the
+ * wired KiB of derived hashes now and at most, the blobs released and refused, and the longest prepare. Then the lazy
+ * form: whether it is on, its blobs, the blocks authenticated at first use, the bad ones, the authentications that
+ * failed to read or allocate and the ms inside all of them; "retry" is what each site did with a page whose block was
+ * not authenticated (page: vm_fault_page authenticated and the fault started again; fast: the fast path of vm_fault left
+ * it to the slow path; wire: vm_fault_wire_fast left it to vm_fault; load: header blocks at image activation; enter:
+ * vm_fault_enter gave the fault back); "unready" is the validations that met such a block all the same, in total and
+ * for entering or copying a page, a pager's source page, a text revalidation and cs_validate_range. These must be 0.
+ * Last the digests alone ("sha", cs_native4k_clock_stop), on efficiency cores and on the others: MiB hashed, ms of wall
+ * time and ms the threads ran; then the chunks made and the ms in making them and in recording answers.
+ */
+size_t cs_native4k_stats_text(char *text, size_t size);
+size_t
+cs_native4k_stats_text(char *text, size_t size)
+{
+	uint64_t class_ns[3], read_ns, hash_ns, longest_ns = 0, longest_bytes = 0;
+	char longest_name[sizeof(cs_native4k_longest_name)] = "";
+
+	for (unsigned int i = 0; i < 3; i++) {
+		absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_classes[i].ticks, relaxed), &class_ns[i]);
+	}
+	absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_read_ticks, relaxed), &read_ns);
+	absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_hash_ticks, relaxed), &hash_ns);
+	/* While a prepare is recording itself the line is printed without the longest one; the caller never waits here. */
+	if (lck_mtx_try_lock(&cs_native4k_longest_lock)) {
+		absolutetime_to_nanoseconds(cs_native4k_longest_ticks, &longest_ns);
+		longest_bytes = cs_native4k_longest_bytes;
+		strlcpy(longest_name, cs_native4k_longest_name, sizeof(longest_name));
+		lck_mtx_unlock(&cs_native4k_longest_lock);
+	}
+	const size_t length = (size_t)scnprintf(text, size,
+	           "exec %llu/%lluK/%llums lib %llu/%lluK/%llums large %llu/%lluM/%llums read %llums hash %llums "
+	           "blocks %lu touched %lu large %lu checks %lu table %luK peak %luK released %lu refused %lu "
+	           "longest %llums %lluK %s",
+	           os_atomic_load(&cs_native4k_classes[0].blobs, relaxed),
+	           os_atomic_load(&cs_native4k_classes[0].bytes, relaxed) >> 10, class_ns[0] / NSEC_PER_MSEC,
+	           os_atomic_load(&cs_native4k_classes[1].blobs, relaxed),
+	           os_atomic_load(&cs_native4k_classes[1].bytes, relaxed) >> 10, class_ns[1] / NSEC_PER_MSEC,
+	           os_atomic_load(&cs_native4k_classes[2].blobs, relaxed),
+	           os_atomic_load(&cs_native4k_classes[2].bytes, relaxed) >> 20, class_ns[2] / NSEC_PER_MSEC,
+	           read_ns / NSEC_PER_MSEC, hash_ns / NSEC_PER_MSEC,
+	           os_atomic_load(&cs_native4k_full_blocks, relaxed),
+	           os_atomic_load(&cs_native4k_touched[0], relaxed), os_atomic_load(&cs_native4k_touched[1], relaxed),
+	           os_atomic_load(&cs_native4k_page_checks, relaxed),
+	           os_atomic_load(&cs_native4k_table_bytes, relaxed) >> 10,
+	           os_atomic_load(&cs_native4k_table_bytes_peak, relaxed) >> 10,
+	           os_atomic_load(&cs_native4k_released_blobs, relaxed),
+	           os_atomic_load(&cs_native4k_refused_blobs, relaxed),
+	           longest_ns / NSEC_PER_MSEC, longest_bytes >> 10, longest_name);
+	uint64_t lazy_ns;
+	absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_lazy_ticks, relaxed), &lazy_ns);
+	const size_t lazy_length = (size_t)scnprintf(text + length, size - length,
+	           " lazy %u blobs %lu auth %lu bad %lu err %lu %llums retry page %lu fast %lu wire %lu load %lu enter %lu "
+	           "unready %lu map %lu pager %lu reval %lu range %lu",
+	           cs_native4k_lazy, os_atomic_load(&cs_native4k_lazy_blobs, relaxed),
+	           os_atomic_load(&cs_native4k_lazy_blocks, relaxed), os_atomic_load(&cs_native4k_lazy_bad, relaxed),
+	           os_atomic_load(&cs_native4k_lazy_errors, relaxed), lazy_ns / NSEC_PER_MSEC,
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_SITE_FAULT_PAGE], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_SITE_FAULT_FAST], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_SITE_WIRE_FAST], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_SITE_LOADER], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_SITE_ENTER], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_unready, relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_MISS_MAP], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_MISS_PAGER], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_MISS_REVALIDATE], relaxed),
+	           os_atomic_load(&cs_native4k_lazy_counts[CS_LAZY_MISS_RANGE], relaxed));
+	uint64_t wall_ns[2], cpu_ns[2], chunk_ns, record_ns;
+	for (unsigned int i = 0; i < 2; i++) {
+		absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_digest_wall[i], relaxed), &wall_ns[i]);
+		absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_digest_cpu[i], relaxed), &cpu_ns[i]);
+	}
+	absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_chunk_ticks, relaxed), &chunk_ns);
+	absolutetime_to_nanoseconds(os_atomic_load(&cs_native4k_record_ticks, relaxed), &record_ns);
+	return length + lazy_length + (size_t)scnprintf(text + length + lazy_length, size - length - lazy_length,
+	           " sha E %lluM/%llums/%llums P %lluM/%llums/%llums chunks %lu %llums record %llums",
+	           os_atomic_load(&cs_native4k_digest_bytes[0], relaxed) >> 20, wall_ns[0] / NSEC_PER_MSEC,
+	           cpu_ns[0] / NSEC_PER_MSEC,
+	           os_atomic_load(&cs_native4k_digest_bytes[1], relaxed) >> 20, wall_ns[1] / NSEC_PER_MSEC,
+	           cpu_ns[1] / NSEC_PER_MSEC,
+	           os_atomic_load(&cs_native4k_chunks_made, relaxed), chunk_ns / NSEC_PER_MSEC, record_ns / NSEC_PER_MSEC);
+}
