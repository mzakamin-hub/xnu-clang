+/* per swap, from show() with fLock held: true when the display was given S itself (no copy wanted) */
+static bool
+scn_frame(MiniIOSurface * s, uint32_t width, uint32_t height)
+{
+	uint64_t ns;
+
+	if (gIceScan < 2 || !scn.a_ok || s == NULL || s->kpixels == NULL || s->info.bytesPerElement != 4 ||
+	    s->info.planeCount != 0 || s->info.width != width || s->info.height != height ||
+	    s->info.bytesPerRow != (uint32_t)vinfo.v_rowbytes || ((uintptr_t)s->pixels() & 0xfff) != 0 ||
+	    (uint64_t)s->info.bytesPerRow * s->info.height > SCN_SLOT_BYTES) {
+		return false;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - scn.start, &ns);
+	if (!scn.b_done) {
+		/* 25b: one surface on the display for 2 s, at the first full-screen swap after 30 s */
+		if (!scn.b_shown && ns >= 30ull * NSEC_PER_SEC) {
+			int i = scn_slot(s);
+			uint32_t addr = (uint32_t)(SCN_SLOT_BASE + SCN_SLOT_BYTES * (uint64_t)(i < 0 ? 0 : i));
+
+			if (i < 0 || !scn_point(addr, true, 50000) || scn_fault("25b show")) {
+				IOLog("icescan: 25b FAIL: surface %u at %#x not taken (or a fault)\n", s->sid, addr);
+				scn_panel("25b failed");
+				scn.b_done = true;
+				return false;
+			}
+			scn.current = (uint32_t)i + 1;
+			scn.b_shown = true;
+			scn.b_at = mach_absolute_time();
+			IOLog("icescan: 25b: surface %u on the display from IOVA %#x, every pipe reading it\n", s->sid, addr);
+		} else if (scn.b_shown) {
+			uint64_t held;
+
+			absolutetime_to_nanoseconds(mach_absolute_time() - scn.b_at, &held);
+			if (held >= 2ull * NSEC_PER_SEC) {
+				bool fault = scn_fault("25b hold");
+
+				scn_panel("25b done");
+				scn.b_done = true;
+				scn.b_ok = !fault && scn.current == 0;
+				for (unsigned i = 0; i < SCN_SLOTS; i++) {
+					if (scn.slot[i] != NULL) {
+						scn_unmap(SCN_SLOT_BASE + SCN_SLOT_BYTES * (uint64_t)i, scn.slot_pages[i]);
+						MiniIOSurfaceDrop(scn.slot[i]);
+						scn.slot[i] = NULL;
+					}
+				}
+				IOLog("icescan: 25b %s\n", scn.b_ok ? "PASS: 2 s of the GPU's frame from the display's own fetch, no fault" :
+				    "FAIL");
+			}
+		}
+		return false;           /* (25b: the copy goes on meanwhile, the panel memory stays current) */
+	}
+	if (gIceScan < 3 || !scn.b_ok || scn.c_failed) {
+		return false;
+	}
+	/* 25c: every frame */
+	int i = scn_slot(s);
+	uint32_t addr = (uint32_t)(SCN_SLOT_BASE + SCN_SLOT_BYTES * (uint64_t)(i < 0 ? 0 : i));
+
+	if (i < 0 || !scn_point(addr, scn.shows < 2, 50000) || scn_fault("25c frame")) {
+		IOLog("icescan: 25c: frame %u: surface %u not taken (or a fault): the panel memory and the copy from now on\n",
+		    scn.shows, s->sid);
+		scn.c_failed = true;
+		scn_panel("25c failed");
+		return false;
+	}
+	if (scn.shows++ == 0) {
+		IOLog("icescan: 25c: the display shows the swapped surfaces itself from now on (first: surface %u)\n", s->sid);
+	}
+	/* iceinuse: the display's use moves from the surface it read to this one (both held in their slots) */
+	if (gIceInUse && scn.current != (uint32_t)i + 1) {
+		MiniIOSurfaceDisplayUse(scn.slot[i], 1);
+		if (scn.current != 0) {
+			MiniIOSurfaceDisplayUse(scn.slot[scn.current - 1], -1);
+		}
+		scn.inuse_marks++;
+	}
+	scn.current = (uint32_t)i + 1;
+	scn.cur_sid = s->sid;
+	return true;
+}
+
+static void
+scn_report(void)
+{
+	if (gIceScan != 0 && scn.dpu) {
+		uint64_t sync_ns = 0;
+
+		absolutetime_to_nanoseconds(scn.sync_abs, &sync_ns);
+		IOLog("icescan: 5 s: 25a %s, 25b %s, 25c %s; %u frames scanned out, %u faults, fsr %08x, pipes on %#x; "
+		    "%u swaps of the surface on the display at the SwapEnd before (drawn while read); icesync=%u: %u SwapEnds held to "
+		    "their flip (%llu us in all, %u past 700 ms); iceinuse=%u: %u display marks moved\n",
+		    scn.a_ok ? "on" : "off", scn.b_ok ? "PASS" : scn.b_done ? "FAIL" : "pending", scn.c_failed ? "FAILED" :
+		    scn.shows ? "on" : "off", scn.shows, scn.faults, scn.cb ? scn_rd(scn.cb, 0x58) : 0,
+		    scn_rd(scn.dpu, scn_pipe[0] + SCN_CURRENT0), scn.torn, gIceSync, scn.synced, sync_ns / 1000, scn.sync_late,
+		    gIceInUse, scn.inuse_marks);
+		if (gIceGate) {
+			uint64_t gate_ns = 0;
+
+			absolutetime_to_nanoseconds(gGateAbs, &gate_ns);
+			IOLog("icescan: icegate=%u: armed %u times, %u submissions of pid %d held to a flip (%llu us in all), %u past the cap\n",
+			    gIceGate, gGateArms, gGateHeld, gGatePid, gate_ns / 1000, gGateLate);
+		}
+	}
+}
+
+/* the run's end: the panel memory, translation off, bank 4 as found */
+static void
+scn_end(void)
+{
+	if (gIceScan == 0 || !scn.a_ok) {
+		return;
+	}
+	if (scn.current != 0 || scn_rd(scn.dpu, scn_pipe[0] + SCN_CURRENT0) != scn.panel) {
+		scn_panel("the run's end");
+	}
+	(void)scn_fault("the run's end");
+	scn_bank_back("the run's end");
+	IOLog("icescan: put back: bank %u sctlr %08x ttbr0 %08x%08x tcr %08x, pipes on %#x\n", scn.bank, scn_rd(scn.cb, 0x0),
+	    scn_rd(scn.cb, 0x24), scn_rd(scn.cb, 0x20), scn_rd(scn.cb, 0x30), scn_rd(scn.dpu, scn_pipe[0] + SCN_CURRENT0));
+}
