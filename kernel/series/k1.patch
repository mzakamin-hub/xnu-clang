+/*
+ * Never inline: its line, path and description buffers (about 1.9 KiB) would then sit in writev_internal's frame for the
+ * whole of every write, under the file system, the pager and the storage stack, with stderr-log off as well; that was the
+ * largest frame of the 16 KiB chain that overflowed logd_helper's kernel stack (run w2-stack-1).
+ */
+__attribute__((noinline)) static void
+stderr_log_write(struct proc *p, int fd, user_addr_t buf, user_size_t nbyte)
+{
+	uint64_t ns = 0;
+	uint64_t *second;
+	uint32_t *count;
+	uint32_t *dropped;
+	uint32_t limit;
+	int pid;
+	bool pid1_wide;
