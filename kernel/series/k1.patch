+		say("icepcie: 23e5 %s event context %u: intmod %08x ertype %08x msivec %08x rbase %08x_%08x rlen %08x rp %08x wp %08x\n",
+		    when, r, *(volatile uint32_t *)e, *(volatile uint32_t *)(e + 4), *(volatile uint32_t *)(e + 8),
+		    *(volatile uint32_t *)(e + 16), *(volatile uint32_t *)(e + 12), *(volatile uint32_t *)(e + 20),
+		    *(volatile uint32_t *)(e + 28), *(volatile uint32_t *)(e + 36));
+	}
+	if (cb != 0) {
+		static const char *const nm[9] = { "", "TF ", "AFF ", "PF ", "EF ", "TLBMCF ", "TLBLKF ", "ASF ", "UUT " };
+		fb[0] = 0;
+		for (int b = 1; b <= 8; b++) {
+			if ((f >> b) & 1) {
+				for (const char *s = nm[b]; *s && n < 60; s++) {
+					fb[n++] = *s;
+				}
+			}
+		}
+		if (((f >> 30) & 1) && n < 58) {
+			fb[n++] = 'S';
+			fb[n++] = 'S';
+			fb[n++] = ' ';
