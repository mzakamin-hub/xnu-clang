+/*
+ * iceufs_ownlist=1: the transfer request list in a page of the kernel's instead of U-Boot's (when U-Boot's memory may
+ * have become the kernel's: on the A3 route DarwinBoot's outside table can hand U-Boot's EfiBootServicesCode to the
+ * adoption). One kernel page, normal memory: the list at +0 (slot 0 used, U-Boot's layout: response at +512 B, 512 B;
+ * PRDT at +1024 B), the command descriptor at +4096; cleaned and invalidated around every command (desc_sync), as the
+ * data buffer is. The list base is changed only with the list stopped (UTRLRSR 0, UFSHCI 5.3), and U-Boot's is put
+ * back at the run's end (hakios_iceland_ufs_close). Host registers only: nothing is written to the unit.
+ */
+#define OWN_UCD                 4096
+static vm_offset_t own_va;
+static uint64_t own_pa;
+static uint32_t uboot_utrlba, uboot_utrlbau;
+
+static void
+desc_sync(void)
+{
+	if (own_va == 0) {
+		return;
+	}
+	for (vm_offset_t l = own_va; l < own_va + OWN_UCD + UCD_SIZE; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
