+// iceland w2-vsync: icegpu's fences (bsd/dev/hakios_iceland_gpu.c, the AGX client's calls): the last one submitted and the last one the
+// GPU wrote back, same numbering. False while icegpu's API is down (no GPU, QEMU): the display then has no fences, as before.
+bool native_adreno_fences(uint32_t *submitted, uint32_t *retired)
+{
+	if (!submitted || !retired || !hakios_iceland_gpu_agx_up()) {
+		return false;
+	}
+	*submitted = hakios_iceland_gpu_agx_last();
+	*retired = hakios_iceland_gpu_agx_retired();
+	return true;
+}
+
+// iceland w2-direct: the direct path asks this one first; the same fences, the detail words left as the caller set them
+bool native_adreno_fences_detail(uint32_t *submitted, uint32_t *retired, uint32_t *)
+{
+	return native_adreno_fences(submitted, retired);
+}
