+/* a pin as a GPIO input with the pull-up, its output latch 0: OE on pulls the line low */
+static void
+amp_pin_gpio(unsigned pin)
+{
+	uint32_t v = rd(AMP_CTL(pin)) & ~(0x3ffu);
+
+	wr(AMP_IO(pin), 0);
+	v |= AMP_PULL_UP | 0u << 2 | 0u << 6;   /* function 0 = GPIO, 2 mA (the DT's drive-strength) */
+	if (v & AMP_CTL_EGPIO_PRESENT) {
+		v |= AMP_CTL_EGPIO_ENABLE;
+	}
+	wr(AMP_CTL(pin), v);
+	settle();
+}
+
+static inline void
+amp_low(unsigned pin)
+{
+	wr(AMP_CTL(pin), rd(AMP_CTL(pin)) | AMP_CTL_OE);
+	settle();
+}
+
+static inline void
+amp_release(unsigned pin)
+{
+	wr(AMP_CTL(pin), rd(AMP_CTL(pin)) & ~AMP_CTL_OE);
+	settle();
+}
+
+static inline unsigned
+amp_level(unsigned pin)
+{
+	return rd(AMP_IO(pin)) & 1;
+}
+
+/* SCL released and allowed to rise (the slave may stretch it), at most 1 ms */
+static bool
+amp_scl_high(void)
+{
+	uint64_t until;
+
+	amp_release(amp_scl);
+	if (__improbable(amp_half_ticks == 0)) {
+		amp_set_khz(amp_khz);
+	}
+	until = mach_absolute_time() + amp_ms_ticks;
+	while (!amp_level(amp_scl)) {
+		if (mach_absolute_time() > until) {
+			return false;
+		}
+	}
+	amp_wait();
+	return true;
+}
+
+static void
+amp_start(void)
+{
+	amp_release(amp_sda);
+	(void)amp_scl_high();
+	amp_low(amp_sda);
+	amp_wait();
+	amp_low(amp_scl);
+	amp_wait();
+}
+
+static void
+amp_stop(void)
+{
+	amp_low(amp_sda);
+	amp_wait();
+	(void)amp_scl_high();
+	amp_release(amp_sda);
+	amp_wait();
+}
+
+/* one byte out, MSB first; true if the slave acknowledged */
+static bool
+amp_out(uint8_t b)
+{
+	bool ack;
+
+	for (int i = 7; i >= 0; i--) {
+		if (b >> i & 1) {
+			amp_release(amp_sda);
+		} else {
+			amp_low(amp_sda);
+		}
+		amp_wait();
+		if (!amp_scl_high()) {
+			return false;
+		}
+		amp_low(amp_scl);
+		amp_wait();
+	}
+	amp_release(amp_sda);
+	amp_wait();
+	if (!amp_scl_high()) {
+		return false;
+	}
+	ack = amp_level(amp_sda) == 0;
+	amp_low(amp_scl);
+	amp_wait();
+	return ack;
+}
+
+static uint8_t
+amp_in(bool ack)
+{
+	uint8_t b = 0;
+
+	amp_release(amp_sda);
+	for (int i = 7; i >= 0; i--) {
+		amp_wait();
+		(void)amp_scl_high();
+		b |= (uint8_t)(amp_level(amp_sda) << i);
+		amp_low(amp_scl);
+	}
+	if (ack) {
+		amp_low(amp_sda);
+	}
+	amp_wait();
+	(void)amp_scl_high();
+	amp_low(amp_scl);
+	amp_release(amp_sda);
+	amp_wait();
+	return b;
+}
+
+/* a 16-bit register read (tfa9865 regmap: 8-bit register, 16-bit value, MSB first); -1 if not acknowledged */
+static int32_t
+amp_read(unsigned addr, uint8_t reg)
+{
+	uint8_t hi, lo;
+
+	amp_start();
+	if (!amp_out((uint8_t)(addr << 1)) || !amp_out(reg)) {
+		amp_stop();
+		return -1;
+	}
+	amp_start();                            /* repeated start */
+	if (!amp_out((uint8_t)(addr << 1 | 1))) {
+		amp_stop();
+		return -1;
+	}
+	hi = amp_in(true);
+	lo = amp_in(false);
+	amp_stop();
+	return hi << 8 | lo;
+}
+
+/* a 16-bit register write, MSB first; true if every byte was acknowledged */
+static bool
+amp_write(unsigned addr, uint8_t reg, uint16_t val)
+{
+	bool ok;
+
+	amp_start();
+	ok = amp_out((uint8_t)(addr << 1)) && amp_out(reg) && amp_out((uint8_t)(val >> 8)) && amp_out((uint8_t)val);
+	amp_stop();
+	return ok;
+}
+
+static bool amp_log_writes = true;
+static unsigned amp_writes, amp_write_fails;
+
+static void
+amp_w(unsigned addr, uint8_t reg, uint16_t val)
+{
+	bool ok = amp_write(addr, reg, val);
+
+	amp_writes++;
+	amp_write_fails += !ok;
+	if (amp_log_writes || !ok) {
+		say("amp: %#x w %#04x = %#06x%s\n", addr, reg, val, ok ? "" : ": NOT ACKNOWLEDGED");
+	}
+}
