+/* ---- the console tap and its ring ------------------------------------------------------------------------- */
+static void
+iceusb_tap(char c)
+{
+	uint32_t h = ring_head;
+
+	if (h - os_atomic_load(&ring_tail, acquire) >= RING_BYTES) {
+		ring_drops++;
+		return;
+	}
+	ring[h & (RING_BYTES - 1)] = c;
+	os_atomic_store(&ring_head, h + 1, release);
+}
+
+static uint32_t
+ring_take(uint8_t *dst, uint32_t cap)
+{
+	uint32_t t = ring_tail, n = os_atomic_load(&ring_head, acquire) - t;
+
+	if (n > cap) {
+		n = cap;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		dst[i] = (uint8_t)ring[(t + i) & (RING_BYTES - 1)];
+	}
+	os_atomic_store(&ring_tail, t + n, release);
+	return n;
+}
+
+static uint32_t
+ring_used(void)
+{
+	return os_atomic_load(&ring_head, acquire) - ring_tail;
+}
+
+/* one line: printf (the console, so the ring and the loader log too), or straight into the loader log when quiet */
+static void note(const char *fmt, ...) __printflike(1, 2);
+static void
+note(const char *fmt, ...)
+{
+	char line[512];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	if (n >= (int)sizeof(line)) {
+		line[sizeof(line) - 2] = '\n';          /* cut, but still a line of its own */
+	}
+	if (u.quiet) {
+		loader_log_line(line);
+	} else {
+		printf("%s", line);
+	}
+}
+
+/* ---- MMIO, time, cache --------------------------------------------------------------------------------------- */
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	uint32_t v;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (v) : "r" (a) : "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (v), "r" (a) : "memory");
+}
+
+static inline void
+dsb(void)
+{
+	__asm__ volatile ("dsb sy" : : : "memory");
+}
+
+#define GCC(o)  (u.gcc + (o))
+#define DWC(o)  (u.dwc + ((o) - 0xc000u))
+#define QS(o)   (u.qs + (o))
+#define M31(o)  (u.m31 + (o))
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+/* the USB thread may sleep (delay() blocks there); inside loader_return() (quiet) only a busy wait on the timebase */
+static void
+wait_us(uint32_t us)
+{
+	uint64_t interval, deadline;
+
+	if (!u.quiet) {
+		delay(us);
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &interval);
+	deadline = mach_absolute_time() + interval;
+	while (mach_absolute_time() < deadline) {
+		__asm__ volatile ("yield" : : : "memory");
+	}
+}
+
+/* until (reg & mask) == want; false at the limit */
+static bool
+wait_bits(vm_offset_t reg, uint32_t mask, uint32_t want, uint32_t limit_us, uint32_t step_us)
+{
+	for (uint32_t t = 0; t <= limit_us; t += step_us) {
+		if ((rd(reg) & mask) == want) {
+			return true;
+		}
+		wait_us(step_us);
+	}
+	return (rd(reg) & mask) == want;
+}
+
+/* clean and invalidate [off, off + len) of the DMA region to the point of coherency */
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	uintptr_t a = ((uintptr_t)u.dma + off) & ~((uintptr_t)u.line - 1), end = (uintptr_t)u.dma + off + len;
+
+	for (; a < end; a += u.line) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a) : "memory");
+	}
+	dsb();
+}
+
+static vm_offset_t
+map4k(uint64_t pa)
+{
+	return ml_io_map_unmappable((vm_offset_t)pa, 0x1000, VM_WIMG_IO);
+}
+
+/* ---- census (read only) ---------------------------------------------------------------------------------------- */
+/* the core's registers may be read: GDSC on, the block not held in reset, the master and AXI branches running */
+static bool
+clocks_on(void)
+{
+	return (rd(GCC(G_GDSCR)) & (1u << 31)) && !(rd(GCC(G_BCR)) & 1u) && !(rd(GCC(G_MASTER)) & (1u << 31)) &&
+	       (!(rd(GCC(G_CFG_NOC)) & (1u << 31)) || (rd(GCC(G_CFG_NOC)) & 2u)) &&
+	       (!(rd(GCC(G_AGGRE)) & (1u << 31)) || (rd(GCC(G_AGGRE)) & 2u));
+}
