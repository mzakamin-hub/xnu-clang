+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland disp-1: NativeSoftGpu, the registry accelerator for macOS 27's Metal discovery without a GPU driver: a QEMU and bring-up
+// crutch only. It advertises a Metal plugin (MetalPluginName NativeSoftMetal, the NativeSoftMetal bundle in /Library/GPUBundles) and
+// nothing else: no hardware, no user client, no memory. The real path stays the Adreno 840's AGXAccelerator (iokit/Kernel).
+//
+// From piano (lenzhang/UniXNU-xiaomipad8pro b9b3649) package/NativeSoftGpu/NativeSoftGpu.cpp (itself macOS-DroidVM 11ac316b
+// overlay/kext/DroidVMGpuKext.cpp, BSD-2-Clause-Patent): an IOAccelerator on IOResources carrying MetalPluginName and
+// MetalPluginClassName, every open refused, the MetalPluginName readers logged. piano links it as a kext against IOGraphicsFamily;
+// here it is built in, and its class gets IOAccelerator as its superclass the way AGXAccelerator.cpp does (agx_base_find,
+// agx_class_register): C++-derived from IOService (IOAccelerator is IOService's direct subclass of IOService's size with no
+// operational overrides, UniXNU 9248bdac scripts/data/ioaccelerator-base-abi-26C5035r.json), its OSMetaClass made at run time with
+// IOAccelerator's metaclass, found by name once IOGraphicsFamily is loaded, as its superclass.
+//
+// Why: WindowServer will not run without a Metal device ("No suitable Metal devices present after 30 seconds", runs/s7b/adm
+// ADM-SERVICE.md). The plugin's device answers acceleratorPort 0, so SkyLight composites in software and Core Animation renders the
+// display with its software renderer; the frames reach the screen through the display's CPU copy (iokit/Native/GopFramebuffer).
+// piano soft-metal.md: this does not reach a visible login on macOS 27 (backdrop assertion, RenderBox); it does give WindowServer a
+// display to swap into.
+//
+// Boot-arg soft-gpu=1 publishes it (off by default: never on a kit whose GPU publishes AGXAccelerator; Metal takes the first
+// accelerator, SkyLight the first device's port). It refuses to run beside iceagx=1 or icegpu_metal=1. Lines start with "softgpu: ".
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <libkern/OSKextLib.h>
+#include <libkern/OSAtomic.h>
+#include <libkern/c++/OSMetaClass.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+#if defined(XNU_TARGET_OS_OSX) && XNU_TARGET_OS_OSX
+
+extern "C" void proc_selfname(char *buf, int size);
+extern "C" void native_soft_gpu_probe(void);
+
+static const char kSoftClassName[] = "NativeSoftAccelerator";
+static const char kSoftBaseName[] = "IOAccelerator";
+static const char kSoftBaseKext[] = "com.apple.iokit.IOGraphicsFamily";
+static const char kSoftPluginName[] = "NativeSoftMetal";
+static const char kSoftPluginClassName[] = "NativeSoftMetalDevice";
+
+class NativeSoftAccelerator : public IOService
+{
+public:
+	class MetaClass : public OSMetaClass
+	{
+public:
+		MetaClass(const OSMetaClass *base);
+		virtual OSObject *alloc() const APPLE_KEXT_OVERRIDE;
+	};
+	static MetaClass *gMeta;
+
+	NativeSoftAccelerator(void);
+	virtual const OSMetaClass *getMetaClass() const APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	using IOService::newUserClient;
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+	using IOService::copyProperty;
+	virtual OSObject *copyProperty(const OSSymbol *key) const APPLE_KEXT_OVERRIDE;
+	virtual OSObject *copyProperty(const OSString *key) const APPLE_KEXT_OVERRIDE;
+	virtual OSObject *copyProperty(const char *key) const APPLE_KEXT_OVERRIDE;
+protected:
+	virtual ~NativeSoftAccelerator() APPLE_KEXT_OVERRIDE;
+	_OS_ADD_OPERATOR_PROTO
+};
+
+NativeSoftAccelerator::MetaClass *NativeSoftAccelerator::gMeta;
+static uint8_t soft_meta_storage[sizeof(NativeSoftAccelerator::MetaClass)]
+__attribute__((aligned(alignof(NativeSoftAccelerator::MetaClass))));
+
+NativeSoftAccelerator::MetaClass::MetaClass(const OSMetaClass *base) : OSMetaClass(kSoftClassName, base, sizeof(NativeSoftAccelerator))
+{
+}
+
+OSObject *
+NativeSoftAccelerator::MetaClass::alloc() const
+{
+	return new NativeSoftAccelerator;
+}
+
+NativeSoftAccelerator::NativeSoftAccelerator(void) : IOService(gMeta)
+{
+	gMeta->instanceConstructed();
+}
+
+NativeSoftAccelerator::~NativeSoftAccelerator()
+{
+}
+
+const OSMetaClass *
+NativeSoftAccelerator::getMetaClass() const
+{
+	return gMeta;
+}
+
+OSDefineOperatorMethods(NativeSoftAccelerator)
+
+bool
+NativeSoftAccelerator::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	OSString *plugin = OSDynamicCast(OSString, getProperty("MetalPluginName"));
+	registerService();
+	IOLog("softgpu: Metal accelerator registered on %s (MetalPluginName %s, no GPU, no user client)\n", provider->getName(),
+	    plugin ? plugin->getCStringNoCopy() : "missing");
+	return true;
+}
+
+// Nothing to open: the plugin's device never asks (acceleratorPort 0). A client that tries anyway is named and refused.
+IOReturn
+NativeSoftAccelerator::newUserClient(task_t, void *, UInt32 type, OSDictionary *, IOUserClient **handler)
+{
+	static volatile SInt32 logged;
+	if (handler) {
+		*handler = nullptr;
+	}
+	if (OSIncrementAtomic(&logged) < 16) {
+		char name[20] = {};
+		proc_selfname(name, sizeof(name));
+		IOLog("softgpu: %s opens the accelerator, type %#x: refused (no GPU)\n", name, (unsigned)type);
+	}
+	return kIOReturnUnsupported;
+}
+
+// Who looks for the plugin (Metal's discovery reads MetalPluginName in every process that asks for a device): the first readers.
+static void
+soft_note_read(const char *key)
+{
+	static volatile SInt32 logged;
+	if (!key || strcmp(key, "MetalPluginName") || OSIncrementAtomic(&logged) >= 24) {
+		return;
+	}
+	char name[20] = {};
+	proc_selfname(name, sizeof(name));
+	IOLog("softgpu: %s reads MetalPluginName\n", name);
+}
+
+OSObject *
+NativeSoftAccelerator::copyProperty(const OSSymbol *key) const
+{
+	soft_note_read(key ? key->getCStringNoCopy() : nullptr);
+	return IORegistryEntry::copyProperty(key);
+}
+
+OSObject *
+NativeSoftAccelerator::copyProperty(const OSString *key) const
+{
+	soft_note_read(key ? key->getCStringNoCopy() : nullptr);
+	return IORegistryEntry::copyProperty(key);
+}
+
+OSObject *
+NativeSoftAccelerator::copyProperty(const char *key) const
+{
+	soft_note_read(key);
+	return IORegistryEntry::copyProperty(key);
+}
+
+static bool
+soft_set(OSDictionary *dictionary, const char *key, const char *value)
+{
+	const OSSymbol *v = OSSymbol::withCString(value);
+	bool ok = v != nullptr && dictionary->setObject(key, v);
+	OSSafeReleaseNULL(v);
+	return ok;
+}
+
+// (iokit/Native/GopFramebuffer/NativeGopDisplayProbe.cpp: the late class waits until launchd runs, after the SystemOS mount)
+extern "C" void native_wait_for_launchd(const char *who);
+
+static void
+soft_worker(void *, wait_result_t)
+{
+	native_wait_for_launchd("softgpu");
+	const char *why = nullptr;
+	const OSSymbol *name = OSSymbol::withCStringNoCopy(kSoftBaseName);
+	const OSMetaClass *base = name ? OSMetaClass::getMetaClassWithName(name) : nullptr;
+	if (name && !base) {
+		OSReturn r = OSKextLoadKextWithIdentifier(kSoftBaseKext);
+		base = OSMetaClass::getMetaClassWithName(name);
+		IOLog("softgpu: %s loaded now (%#x): %s %s\n", kSoftBaseKext, r, kSoftBaseName, base ? "found" : "MISSING");
+	}
+	OSSafeReleaseNULL(name);
+	OSDictionary *properties = nullptr;
+	NativeSoftAccelerator *accelerator = nullptr;
+	IOService *parent = IOService::getResourceService();
+	do {
+		if (!base) {
+			why = "no IOAccelerator class";
+			break;
+		}
+		// the shape AGXAccelerator checks too: IOService's direct subclass, IOService's size
+		if (base->getSuperClass() != IOService::metaClass || base->getClassSize() != sizeof(IOService) ||
+		    sizeof(NativeSoftAccelerator) != sizeof(IOService)) {
+			why = "IOAccelerator is not IOService's direct subclass of IOService's size";
+			break;
+		}
+		void *handle = OSMetaClass::preModLoad(kOSKextKernelIdentifier);
+		if (!handle) {
+			why = "preModLoad";
+			break;
+		}
+		NativeSoftAccelerator::MetaClass *meta = ::new (soft_meta_storage) NativeSoftAccelerator::MetaClass(base);
+		if (OSMetaClass::postModLoad(handle) != kOSReturnSuccess) {
+			why = "postModLoad";
+			break;
+		}
+		NativeSoftAccelerator::gMeta = meta;
+		properties = OSDictionary::withCapacity(4);
+		if (!properties || !soft_set(properties, "MetalPluginName", kSoftPluginName) ||
+		    !soft_set(properties, "MetalPluginClassName", kSoftPluginClassName) ||
+		    !soft_set(properties, kIOMatchCategoryKey, kSoftClassName)) {
+			why = "properties";
+			break;
+		}
+		accelerator = new NativeSoftAccelerator;
+		if (!accelerator || !parent || !accelerator->init(properties)) {
+			why = "init";
+			break;
+		}
+		if (!accelerator->attach(parent)) {
+			why = "attach";
+			break;
+		}
+		if (!accelerator->start(parent)) {
+			accelerator->detach(parent);
+			why = "start";
+			break;
+		}
+	} while (false);
+	OSSafeReleaseNULL(properties);
+	if (why) {
+		OSSafeReleaseNULL(accelerator);
+		IOLog("softgpu: not published (%s)\n", why);
+	} else {
+		OSDictionary *matching = IOService::serviceMatching(kSoftBaseName);
+		IOService *found = matching ? IOService::waitForMatchingService(matching, 5 * NSEC_PER_SEC) : nullptr;
+		IOLog("softgpu: IOServiceMatching(\"%s\") finds %s\n", kSoftBaseName,
+		    found ? found->getMetaClass()->getClassName() : "nothing in 5 s");
+		OSSafeReleaseNULL(found);
+		OSSafeReleaseNULL(matching);
+		accelerator->release();     // the registry holds it
+	}
+	thread_terminate(current_thread());
+}
+
+// the board entry (IOKitBSDInit, right after IOBSD is published, as piano's personality on IOResources matches)
+void
+native_soft_gpu_probe(void)
+{
+	uint32_t on = 0, agx = 0, metal = 0;
+	if (!PE_parse_boot_argn("soft-gpu", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if ((PE_parse_boot_argn("iceagx", &agx, sizeof(agx)) && agx) ||
+	    (PE_parse_boot_argn("icegpu_metal", &metal, sizeof(metal)) && metal)) {
+		IOLog("softgpu: left out: the GPU's own accelerator is asked for (iceagx/icegpu_metal)\n");
+		return;
+	}
+	thread_t thread = nullptr;
+	if (kernel_thread_start(soft_worker, nullptr, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/iokit/Native/SoftwareAES/NativeAES.cpp b/iokit/Native/SoftwareAES/NativeAES.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..41f0a8ef66a12ecb27430d1582ea3d0c6057d4c9
--- /dev/null
+++ b/iokit/Native/SoftwareAES/NativeAES.cpp
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iceland S7 item 8: UniXNU SoftwareAES (github.com/UniXNU/SoftwareAES) at da07dd5, the revision UniXNU dff2765 pins
+// (drivers/SoftwareAES), unchanged below this comment. Built into the kernel with -DNATIVE_AES_DARWIN26=1 against
+// OriginalAESABI.h as UniXNU-sheng 1108068 builds it for 26C5035r (scripts/build-gop-legacy-display-27.py:828-879): the
+// parent class's methods and metaclass are the collection's own (native_aes_*_26C5035r.s), and the object's static
+// initializer runs late, from SoftwareAesProbe.cpp (iokit/conf/Makefile.template NATIVE_LATE_FILES).
+#include "OriginalAESABI.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/crypto/aes.h>
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wextern-c-compat"
+#include <libkern/crypto/crypto_internal.h>
+#pragma clang diagnostic pop
+#include <corecrypto/cc.h>
+#include <kern/task.h>
+#include <libkern/crypto/sha2.h>
+#include <IOKit/IODeviceTreeSupport.h>
+
+extern "C" {
+volatile uint32_t native_aes_kat_status = 0;
+volatile uint32_t native_aes_registered = 0;
+volatile uint32_t native_aes_interface_status = 0;
+volatile uint32_t native_aes_completed = 0;
+volatile uint32_t native_aes_unsupported_key = 0;
+volatile uint32_t native_aes_nonce_key_uses = 0;
+// The bytes of the completed requests and the time spent in them (mach_absolute_time ticks), for a board's log: together with
+// native_aes_completed they show whether anything sends bulk data through this provider and at what rate it is served.
+volatile uint64_t native_aes_bytes = 0, native_aes_ticks = 0;
+}
+
+// Selector 0x8a4: the device key AppleImage4 entangles its boot nonce with (_darwin_el2_entangle_nonce: 128 bits, zero key bytes,
+// selector 0x8a4, CBC). On Apple hardware it is derived from the UID key; AppleImage4 panics when the request fails ("encryption
+// failed: 0xe00002c7", macOS run47, from a nonce sysctl as System Settings opened). This board has no hardware key, so the stand-in is
+// derived from /chosen/unique-chip-id: unique to the device and stable, but not secret from software, which the service's
+// NativeAESSoftwareKeysOnly property states. Every other hardware selector (the GID keys that decrypt firmware, the raw UID key) stays
+// unsupported: a made-up key there would hand back wrong plaintext instead of an error.
+enum : uint32_t { kNonceEntangleSelector = 0x8a4 };
+static bool nonceEntangleKey(IOAESKeyData *out)
+{
+  uint64_t chip = 0;
+  if (IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane)) {
+    OSData *id = OSDynamicCast(OSData, chosen->getProperty("unique-chip-id"));
+    if (id && id->getLength() >= sizeof(chip)) memcpy(&chip, id->getBytesNoCopy(), sizeof(chip));
+    chosen->release();
+  }
+  if (!chip) return false;
+  static const char label[] = "UniXNU software AES key 0x8a4";
+  unsigned char digest[SHA256_DIGEST_LENGTH];
+  SHA256_CTX context;
+  SHA256_Init(&context);
+  SHA256_Update(&context, label, sizeof(label));
+  SHA256_Update(&context, &chip, sizeof(chip));
+  SHA256_Final(digest, &context);
+  memset(out, 0, sizeof(*out));
+  out->bits = 128;
+  memcpy(out->bytes, digest, 16);
+  cc_clear(sizeof(digest), digest);
+  return true;
+}
+
+class NativeAES : public IOAESAccelerator {
+  OSDeclareDefaultStructors(NativeAES)
+public:
+  bool start(IOService *) override;
+  IOWorkLoop *getWorkLoop() const override { return IOService::getWorkLoop(); }
+  IOReturn callPlatformFunction(const OSSymbol *name, bool wait, void *a, void *b, void *c, void *d) override {
+    return IOService::callPlatformFunction(name, wait, a, b, c, d);
+  }
+  const char *getAlgorithmName() override { return "AES-CBC"; }
+  bool isKeySupported(unsigned selector) override { return selector == 0 || selector == kNonceEntangleSelector; }
+  unsigned getSupportedOptions() override { return 1; }
+  IOReturn performAES(void *, void *, task_t, unsigned long long, IOAESIV *,
+                     IOAESOperation, IOAESKeyData *, IOAESCompletion, void *) override;
+  IOReturn performAES(IOMemoryDescriptor *, IOMemoryDescriptor *, unsigned long long,
+                     IOAESIV *, IOAESOperation, IOAESKeyData *, unsigned long long,
+                     unsigned long long, IOAESCompletion, void *) override;
+};
+OSDefineMetaClassAndStructors(NativeAES, IOAESAccelerator)
+
+// No padding, hidden device keys, or change to the registered corecrypto modes.
+static int cbc(const unsigned char *input, unsigned char *output, size_t bytes,
+               unsigned char iv[16], const IOAESKeyData &key, IOAESOperation operation)
+{
+  union { aes_encrypt_ctx encrypt; aes_decrypt_ctx decrypt; } context;
+  unsigned char nextIV[16];
+  int result;
+  if (operation == IOAESDecrypt) {
+    memcpy(nextIV, input + bytes - 16, 16);
+    result = aes_decrypt_key(key.bytes, key.bits / 8, &context.decrypt);
+    if (!result) result = aes_decrypt_cbc(input, iv, static_cast<unsigned>(bytes / 16), output, &context.decrypt);
+  } else {
+    result = aes_encrypt_key(key.bytes, key.bits / 8, &context.encrypt);
+    if (!result) result = aes_encrypt_cbc(input, iv, static_cast<unsigned>(bytes / 16), output, &context.encrypt);
+    if (!result) memcpy(nextIV, output + bytes - 16, 16);
+  }
+  if (!result) memcpy(iv, nextIV, 16);
+  cc_clear(sizeof(context), &context);
+  cc_clear(sizeof(nextIV), nextIV);
+  return result;
+}
+
+// NIST SP800-38A F.2.1/F.2.2, four CBC blocks, then split/in-place decryption.
+static bool knownAnswerTest(NativeAES *provider)
+{
+  const unsigned char input[64] = {
+    0x6b,0xc1,0xbe,0xe2,0x2e,0x40,0x9f,0x96,0xe9,0x3d,0x7e,0x11,0x73,0x93,0x17,0x2a,
+    0xae,0x2d,0x8a,0x57,0x1e,0x03,0xac,0x9c,0x9e,0xb7,0x6f,0xac,0x45,0xaf,0x8e,0x51,
+    0x30,0xc8,0x1c,0x46,0xa3,0x5c,0xe4,0x11,0xe5,0xfb,0xc1,0x19,0x1a,0x0a,0x52,0xef,
+    0xf6,0x9f,0x24,0x45,0xdf,0x4f,0x9b,0x17,0xad,0x2b,0x41,0x7b,0xe6,0x6c,0x37,0x10};
+  const unsigned char expected[64] = {
+    0x76,0x49,0xab,0xac,0x81,0x19,0xb2,0x46,0xce,0xe9,0x8e,0x9b,0x12,0xe9,0x19,0x7d,
+    0x50,0x86,0xcb,0x9b,0x50,0x72,0x19,0xee,0x95,0xdb,0x11,0x3a,0x91,0x76,0x78,0xb2,
+    0x73,0xbe,0xd6,0xb8,0xe3,0xc1,0x74,0x3b,0x71,0x16,0xe6,0x9e,0x22,0x22,0x95,0x16,
+    0x3f,0xf1,0xca,0xa1,0x68,0x1f,0xac,0x09,0x12,0x0e,0xca,0x30,0x75,0x86,0xe1,0xa7};
+  IOAESKeyData key = {128, {0x2b,0x7e,0x15,0x16,0x28,0xae,0xd2,0xa6,
+                           0xab,0xf7,0x15,0x88,0x09,0xcf,0x4f,0x3c}, 0};
+  unsigned char iv[16], output[64];
+  for (unsigned i = 0; i < 16; ++i) iv[i] = static_cast<unsigned char>(i);
+  bool result = !cbc(input, output, 64, iv, key, IOAESEncrypt) && !memcmp(output, expected, 64) &&
+                !memcmp(iv, expected + 48, 16);
+  for (unsigned i = 0; i < 16; ++i) iv[i] = static_cast<unsigned char>(i);
+  result = result && !cbc(output, output, 16, iv, key, IOAESDecrypt) &&
+           !cbc(output + 16, output + 16, 48, iv, key, IOAESDecrypt) && !memcmp(output, input, 64) &&
+           !memcmp(iv, expected + 48, 16);
+  const IOAESKeyData wideKeys[2] = {
+    {192, {0x8e,0x73,0xb0,0xf7,0xda,0x0e,0x64,0x52,0xc8,0x10,0xf3,0x2b,0x80,0x90,0x79,0xe5,
+           0x62,0xf8,0xea,0xd2,0x52,0x2c,0x6b,0x7b}, 0},
+    {256, {0x60,0x3d,0xeb,0x10,0x15,0xca,0x71,0xbe,0x2b,0x73,0xae,0xf0,0x85,0x7d,0x77,0x81,
+           0x1f,0x35,0x2c,0x07,0x3b,0x61,0x08,0xd7,0x2d,0x98,0x10,0xa3,0x09,0x14,0xdf,0xf4}, 0}};
+  const unsigned char wideExpected[2][16] = {
+    {0x4f,0x02,0x1d,0xb2,0x43,0xbc,0x63,0x3d,0x71,0x78,0x18,0x3a,0x9f,0xa0,0x71,0xe8},
+    {0xf5,0x8c,0x4c,0x04,0xd6,0xe5,0xf1,0xba,0x77,0x9e,0xab,0xfb,0x5f,0x7b,0xfb,0xd6}};
+  for (unsigned n = 0; n < 2; ++n) {
+    for (unsigned i = 0; i < 16; ++i) iv[i] = static_cast<unsigned char>(i);
+    result = result && !cbc(input, output, 16, iv, wideKeys[n], IOAESEncrypt) && !memcmp(output, wideExpected[n], 16);
+    for (unsigned i = 0; i < 16; ++i) iv[i] = static_cast<unsigned char>(i);
+    result = result && !cbc(output, output, 16, iv, wideKeys[n], IOAESDecrypt) && !memcmp(output, input, 16);
+  }
+  IOBufferMemoryDescriptor *source = IOBufferMemoryDescriptor::withCapacity(128, kIODirectionInOut);
+  IOBufferMemoryDescriptor *destination = IOBufferMemoryDescriptor::withCapacity(128, kIODirectionInOut);
+  IOAESIV publicIV;
+  for (unsigned i = 0; i < 16; ++i) publicIV.bytes[i] = static_cast<unsigned char>(i);
+  struct Completion { unsigned count; int status; } completion = {};
+  auto callback = [](void *argument, int status) {
+    Completion *state = static_cast<Completion *>(argument);
+    state->count++;
+    state->status = status;
+  };
+  bool interface = source && destination && source->writeBytes(16, input, 64) == 64 &&
+    !provider->performAES(source, destination, 64, &publicIV, IOAESEncrypt, &key, 16, 32, callback, &completion) &&
+    destination->readBytes(32, output, 64) == 64 && !memcmp(output, expected, 64) &&
+    !memcmp(publicIV.bytes, expected + 48, 16) && completion.count == 1 && completion.status == 0;
+  key.selector = 2001; // Original hardware-key selector, deliberately unsupported.
+  interface = interface && provider->performAES(source, destination, 64, &publicIV,
+    IOAESEncrypt, &key, 16, 32, callback, &completion) == kIOReturnUnsupported && completion.count == 1 &&
+    destination->readBytes(32, output, 64) == 64 && !memcmp(output, expected, 64) &&
+    !memcmp(publicIV.bytes, expected + 48, 16) && !provider->isKeySupported(key.selector);
+  key.selector = 0;
+  interface = interface && provider->performAES(source, destination, 64, &publicIV,
+    IOAESEncrypt, &key, 16, 80, callback, &completion) == kIOReturnBadArgument && completion.count == 1;
+  for (unsigned i = 0; i < 16; ++i) publicIV.bytes[i] = static_cast<unsigned char>(i);
+  interface = interface && !provider->performAES(const_cast<unsigned char *>(input), output, kernel_task,
+    64, &publicIV, IOAESEncrypt, &key, nullptr, nullptr) && !memcmp(output, expected, 64);
+  for (unsigned i = 0; i < 16; ++i) publicIV.bytes[i] = static_cast<unsigned char>(i);
+  interface = interface && !provider->performAES(output, output, kernel_task, 64, &publicIV,
+    IOAESDecrypt, &key, nullptr, nullptr) && !memcmp(output, input, 64) && !memcmp(publicIV.bytes, expected + 48, 16);
+  native_aes_interface_status = interface ? 1 : 2;
+  if (source) source->release();
+  if (destination) destination->release();
+  result = result && interface;
+  cc_clear(sizeof(key), &key);
+  cc_clear(sizeof(output), output);
+  return result;
+}
+
+bool NativeAES::start(IOService *provider)
+{
+  if (!g_crypto_funcs || !g_crypto_funcs->ccaes_cbc_encrypt || !g_crypto_funcs->ccaes_cbc_decrypt ||
+      !IOService::start(provider)) return false;
+  native_aes_kat_status = knownAnswerTest(this) ? 1 : 2;
+  if (native_aes_kat_status != 1) return false;
+  setProperty("NativeAESSoftwareKeysOnly", true);
+  native_aes_registered = 1;
+  registerService();
+  return true;
+}
+
+IOReturn NativeAES::performAES(IOMemoryDescriptor *input, IOMemoryDescriptor *output,
+                              unsigned long long bytes, IOAESIV *iv, IOAESOperation operation,
+                              IOAESKeyData *key, unsigned long long inputOffset,
+                              unsigned long long outputOffset, IOAESCompletion callback, void *refcon)
+{
+  if (!input || !output || !key || !iv || !bytes || (bytes & 15) ||
+      (key->bits != 128 && key->bits != 192 && key->bits != 256)) return kIOReturnBadArgument;
+  IOAESKeyData derived = {};
+  if (key->selector == kNonceEntangleSelector && key->bits == 128 && nonceEntangleKey(&derived)) {
+    __atomic_fetch_add(&native_aes_nonce_key_uses, 1, __ATOMIC_RELAXED);
+    key = &derived;
+  }
+  if (key->selector || (operation != IOAESEncrypt && operation != IOAESDecrypt)) {
+    __atomic_fetch_add(&native_aes_unsupported_key, 1, __ATOMIC_RELAXED);
+    return kIOReturnUnsupported;
+  }
+  if (inputOffset > input->getLength() || bytes > input->getLength() - inputOffset ||
+      outputOffset > output->getLength() || bytes > output->getLength() - outputOffset) return kIOReturnBadArgument;
+  const uint64_t entered = mach_absolute_time();
+  unsigned char *buffer = static_cast<unsigned char *>(IOMalloc(4096));
+  if (!buffer) return kIOReturnNoMemory;
+  IOReturn result = input->prepare();
+  if (result) {
+    IOFree(buffer, 4096);
+    return result;
+  }
+  result = output->prepare();
+  if (result) {
+    input->complete();
+    IOFree(buffer, 4096);
+    return result;
+  }
+  unsigned char chaining[16];
+  memcpy(chaining, iv->bytes, 16);
+  for (unsigned long long done = 0; done < bytes; ) {
+    size_t count = static_cast<size_t>(bytes - done > 4096 ? 4096 : bytes - done);
+    if (input->readBytes(inputOffset + done, buffer, count) != count ||
+        cbc(buffer, buffer, count, chaining, *key, operation) ||
+        output->writeBytes(outputOffset + done, buffer, count) != count) {
+      result = kIOReturnIOError;
+      break;
+    }
+    done += count;
+  }
+  if (!result) {
+    memcpy(iv->bytes, chaining, 16);
+    __atomic_fetch_add(&native_aes_completed, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_aes_bytes, bytes, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_aes_ticks, mach_absolute_time() - entered, __ATOMIC_RELAXED);
+  }
+  cc_clear(4096, buffer);
+  IOFree(buffer, 4096);
+  cc_clear(sizeof(chaining), chaining);
+  cc_clear(sizeof(derived), &derived);
+  output->complete();
+  input->complete();
+  if (callback) {
+    callback(refcon, result);
+    return kIOReturnSuccess;
+  }
+  return result;
+}
+
+IOReturn NativeAES::performAES(void *input, void *output, task_t task, unsigned long long bytes,
+                              IOAESIV *iv, IOAESOperation operation, IOAESKeyData *key,
+                              IOAESCompletion callback, void *refcon)
+{
+  if (!task || !input || !output || !bytes) return kIOReturnBadArgument;
+  IOMemoryDescriptor *source = IOMemoryDescriptor::withAddressRange(
+      reinterpret_cast<mach_vm_address_t>(input), bytes, kIODirectionOut, task);
+  IOMemoryDescriptor *destination = IOMemoryDescriptor::withAddressRange(
+      reinterpret_cast<mach_vm_address_t>(output), bytes, kIODirectionIn, task);
+  if (!source || !destination) {
+    if (source) source->release();
+    if (destination) destination->release();
+    return kIOReturnNoMemory;
+  }
+  IOReturn result = performAES(source, destination, bytes, iv, operation, key, 0, 0, callback, refcon);
+  source->release();
+  destination->release();
+  return result;
+}
