+/*
+ * icewifi=2 (kit 23c2, CLASS C, after 23c: votes done, gpio16 high and read back, but gpio18 stayed 0): the rest of what
+ * Linux's pwrseq-qcom-wcn turns on for a wcn7850-class chip before its enable pin (vregs vdd, vddio, vddio1p2, vddaon,
+ * vdddig, vddrfa1p2, vddrfa1p8, then the clock, then wlan-enable, then 50 ms): ENABLE-ONLY votes (no MODE, no VOLTAGE
+ * command: whatever voltage the rail already has stays) for S1J_E1 (vddaon), S2J_E1 (vdddig), S7F_E0 (vddrfa1p2),
+ * S8F_E0 (vddrfa1p8), and the PMU's XO: rpmhcc RPMH_RF_CLK1 = "C1A_E0" (clk-rpmh.c kaanapali: VRM clock, ENABLE at +4 =
+ * 1, exactly what an enable-only vote sends). These are never released (shared rails; cmd-db has addresses only, no
+ * state, so whether the boot chain already votes them cannot be read: an enable vote adds, a release could take away).
+ * gpio18 / gpio104 (PCIe WAKE#) sampled at +50 ms, +1 s, +10 s.
+ */
+static void
+wifi_power(int level)
+{
+	static const struct {
+		const char *name;
+		int32_t mode;
+		uint32_t uv;
+		int level;          /* the icewifi level that votes it */
+		int releasable;     /* 1: released on a refusal / with icewifi_release=1; 0: never */
+	} rails[] = {
+		{ "L2G_E0", 5, 1800000, 1, 1 }, { "L3G_E0", 5, 1200000, 1, 1 },
+		{ "S1J_E1", -1, 0, 2, 0 }, { "S2J_E1", -1, 0, 2, 0 }, { "S7F_E0", -1, 0, 2, 0 }, { "S8F_E0", -1, 0, 2, 0 },
+		{ "C1A_E0", -1, 0, 2, 0 },
+	};
+	vm_offset_t p104 = ml_io_map_unmappable(TLMM_PA + 0x1000u * 104, PAGE_SIZE, VM_WIMG_IO);
+	vm_offset_t p16 = ml_io_map_unmappable(TLMM_PA + 0x1000u * 16, PAGE_SIZE, VM_WIMG_IO);
+	vm_offset_t p18 = ml_io_map_unmappable(TLMM_PA + 0x1000u * 18, PAGE_SIZE, VM_WIMG_IO);
+	int release = 0, voted = 0, hpm = 0, uvon = 0;
+	uint32_t ctl0, io0;
+	/*
+	 * 34ux2 (scan45, icewifi_uv=1; owner's yes 1 Nov ~22:30: a NEW write class, VOLTAGE votes on the four shared WCN
+	 * bucks). Linux / Fedora on this tablet (pwrseq-qcom-wcn + rpmh-regulator) and UniXNU's WifiProbe send each rail
+	 * VOLTAGE, then MODE, then ENABLE. The value is the consumer's request clipped into the DT's
+	 * [regulator-min-microvolt, regulator-max-microvolt]: the wcn7860-pmu consumers (vddcx = vreg_s1j_0p8, vdddig =
+	 * vreg_s2j_0p8, vddrfa1p2 = vreg_s7f_1p2, vddrfa1p8 = vreg_s8f_1p8) request no voltage (0 / 0 mV in Fedora's
+	 * regulator_summary), so the vote is the DT minimum - the voltage Fedora's regulator core votes for them (its
+	 * regulator modes list: s1j 400000, s2j 500000, s7f 1224000, s8f 1800000 uV, mode fast, enabled). Never above max.
+	 * Each vote is read back through 34ux1's SPMI observer path (the buck's STATUS1, VSET 0x40/0x41 in mV, MODE 0x45,
+	 * EN_CTL 0x46), before and after. Released (VOLTAGE 0 = no request from the apps DRV) exactly when the enables'
+	 * undo releases (icewifi_release=1, at gpio16's put-back or a refusal); never while the BT controller is resident.
+	 * The table and the release: ux2_r / ux2_release above.
+	 */
+
+	PE_parse_boot_argn("icewifi_release", &release, sizeof(release));
+	/*
+	 * 23e2j, icewifi_hpm=1: the four shared bucks get the MODE vote Linux sends for them - the DT's
+	 * regulator-initial-mode = RPMH_REGULATOR_MODE_HPM on vreg_s1j_0p8 / s2j_0p8 / s7f_1p2 / s8f_1p8 (pmh0104 /
+	 * pmh0110 smps = pmic5_ftsmps530: HPM -> REGULATOR_MODE_FAST -> PMIC5_SMPS_MODE_PWM = 7); rpmh-regulator sends it
+	 * at probe. Still no VOLTAGE vote (Linux's is the constraint minimum, a floor below what the rail has). A mode vote
+	 * is the kind 23c already sends (L2G / L3G MODE 5); RPMh takes the highest mode over all voters, so it can only
+	 * raise the rail's mode; never released (as the enable-only votes). UniXNU (SM8550 WCN7850): without the mode
+	 * request rails stayed off and the link never trained.
+	 */
+	PE_parse_boot_argn("icewifi_hpm", &hpm, sizeof(hpm));
+	PE_parse_boot_argn("icewifi_uv", &uvon, sizeof(uvon));
+	if (uvon) {
+		say("icewifi: 34ux2 icewifi_uv=%d: VOLTAGE, MODE, ENABLE on S1J_E1 / S2J_E1 / S7F_E0 / S8F_E0 (the request clipped "
+		    "into the DT range), each read back over SPMI\n", uvon);
+		u1_spmi();
+	}
+	if (p16 == 0 || p18 == 0) {
+		say("icewifi: TLMM not mapped: refused\n");
+		return;
+	}
+	ctl0 = io_rd(p16, 0);
+	io0 = io_rd(p16, 4);
+	if (hakios_iceland_omni(0x200)) {
+		/*
+		 * 46cn4b G6 (owner's yes 7 Nov): the MX ARC rail at Peach's level (pandora_wifi.c:292: "GCC's captured mx provider
+		 * has init-voltage-level=384" = RPMH_REGULATOR_LEVEL_TURBO; same SoC). Verified here: lmx.lvl is in this
+		 * tablet's cmd-db (the ADSP kit votes it). NOT done, unverifiable or not applicable on kaanapali: sheng's BCM SN7
+		 * (SM8750; kaanapali's PCIe BCM is SN4 - kaanapali.c icc-rpmh qns_pcie_gemnoc - which harvest already votes at
+		 * peak and keeps), Peach's CESTA / CRM PERF_OL writes (0x1d01000 / 0x1d05e00: not described by our device tree).
+		 */
+		say("icepcie: 46cn4b G6 lmx.lvl >= 384 -> %d (the level index sent, < 0 = not sent)\n",
+		    hakios_iceland_rpmh_arc("lmx.lvl", 384));
+	}
+	if (hakios_iceland_omni(0x1000)) {
+		/* 46cn4b G9 (owner's yes 7 Nov): L3K_E1 1200 mV, mode 7, enable, as Peach (pandora_wifi.c:220) / popsicle; our
+		 * device tree has no consumer for it. Not fatal: a resource missing from cmd-db sends nothing. */
+		say("icewifi: 46cn4b G9 L3K_E1 1200 mV mode 7 enable -> %d (0 done, -1 not in cmd-db, -2 not done)\n",
+		    hakios_iceland_rpmh_vote_vme("L3K_E1", 1200, 7, 1));
+	}
+	say("icewifi: as found: gpio16 ctl %08x io %08x; gpio18 (sw_ctrl) ctl %08x io %08x\n", ctl0, io0, io_rd(p18, 0),
+	    io_rd(p18, 4));
+	if (((ctl0 >> 2) & 0xf) != 0 || (((ctl0 >> 9) & 1) && ((io0 >> 1) & 1))) {
+		say("icewifi: gpio16 is not a plain GPIO left low (function %u, oe %u, out %u): REFUSED, nothing done\n",
+		    (ctl0 >> 2) & 0xf, (ctl0 >> 9) & 1, (io0 >> 1) & 1);
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		if (rails[i].level > level) {
+			continue;
+		}
+		int32_t mode = rails[i].mode;
+		if (hpm && mode < 0 && rails[i].name[0] == 'S') {
+			mode = 7;               /* 23e2j: PMIC5_SMPS_MODE_PWM = Linux's HPM */
+		}
+		int u = -1, r;
+		for (int q = 0; uvon && q < UX2_N; q++) {
+			if (strcmp(ux2_r[q].name, rails[i].name) == 0) {
+				u = q;
+			}
+		}
+		if (u >= 0) {
+			/* 34ux2: the request clipped into [min, max], in whole mV (the VRM's unit), never above max */
+			uint32_t v = ux2_r[u].req_uv < ux2_r[u].min_uv ? ux2_r[u].min_uv : ux2_r[u].req_uv;
+			v = v > ux2_r[u].max_uv ? ux2_r[u].max_uv : v;
+			uint32_t mv = v / 1000;
+			if (mv * 1000 < ux2_r[u].min_uv) {
+				mv++;
+			}
+			if (mv == 0 || mv * 1000 > ux2_r[u].max_uv) {
+				say("icewifi: 34ux2 %s: %u mV is outside the DT range: REFUSED, gpio16 not touched\n", rails[i].name, mv);
+				r = -3;
+			} else {
+				ux2_rb(rails[i].name, ux2_r[u].u1, "before");
+				say("icewifi: 34ux2 vote %s: VOLTAGE %u mV (request %u uV, DT min %u max %u uV), MODE %d, ENABLE 1\n",
+				    rails[i].name, mv, ux2_r[u].req_uv, ux2_r[u].min_uv, ux2_r[u].max_uv, mode);
+				r = hakios_iceland_rpmh_vote_vme(rails[i].name, mv, mode, 1);
+				ux2_voted[u] = r == 0 || r == -2;       /* -2: a command may have landed; released as a done one */
+				IOSleep(1);
+				ux2_rb(rails[i].name, ux2_r[u].u1, "after the vote");
+			}
+		} else {
+			r = hakios_iceland_rpmh_vote(rails[i].name, mode, rails[i].uv, true);
+		}
+		say("icewifi: vote %s %s%d %u uV enable -> %d%s%s\n", rails[i].name, mode < 0 ? "(enable only) mode " : "mode ",
+		    mode, rails[i].uv, r, mode != rails[i].mode ? " (23e2j icewifi_hpm=1: HPM/PWM as Linux)" : "",
+		    u >= 0 ? " (34ux2: voltage first)" : "");
+		if (r != 0) {
+			for (int j = (int)i - 1; j >= 0; j--) {
+				if (rails[j].releasable && rails[j].level <= level) {
+					say("icewifi: release %s -> %d\n", rails[j].name, hakios_iceland_rpmh_release(rails[j].name));
+				}
+			}
+			ux2_release(release, "a refusal");
+			say("icewifi: a vote was not done: REFUSED, gpio16 not touched (enable-only votes stay)\n");
+			return;
+		}
+		voted = (int)i + 1;
+	}
+	IOSleep(20);
+	*(volatile uint32_t *)(p16 + 4) = io0 | 2u;                 /* output value 1 */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(p16 + 0) = (ctl0 & ~(0xfu << 2)) | (1u << 9);   /* function 0, output enabled */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("icewifi: gpio16 high: wrote io %08x ctl %08x, read back ctl %08x io %08x\n", io0 | 2u,
+	    (ctl0 & ~(0xfu << 2)) | (1u << 9), io_rd(p16, 0), io_rd(p16, 4));
+	IOSleep(50);
+	say("icewifi: +50 ms: gpio18 (sw_ctrl) io %08x (in %u), gpio104 (wake) io %08x\n", io_rd(p18, 4), io_rd(p18, 4) & 1,
+	    p104 ? io_rd(p104, 4) : 0);
+	hw_probe();
+	if (f2_ready) {
+		if ((io_rd(p18, 4) & 1) && level >= 2) {
+			f2_bt();
+		} else {
+			say("icespmi: 23f2 REFUSED: 23c2's power-up did not hold (icewifi=%d, gpio18 io %08x): bt-enable not touched\n",
+			    level, io_rd(p18, 4));
+		}
+	}
+	if (icepcie) {
+		if ((io_rd(p18, 4) & 1) && level >= 2) {
+			say("icepcie: 23c2 held (gpio18 sw_ctrl 1, all votes done): PCIe0 power and clocks (23d1)\n");
+			pcie_d1();
+		} else {
+			say("icepcie: REFUSED: 23c2's power-up did not hold in this run (icewifi=%d, gpio18 io %08x)\n", level,
+			    io_rd(p18, 4));
+		}
+	}
+	IOSleep(950);
+	say("icewifi: +1 s: gpio18 io %08x (in %u), gpio104 io %08x\n", io_rd(p18, 4), io_rd(p18, 4) & 1, p104 ? io_rd(p104, 4) : 0);
+	IOSleep(9 * 1000);
+	say("icewifi: +10 s: gpio16 io %08x, gpio18 io %08x (in %u), gpio104 io %08x\n", io_rd(p16, 4), io_rd(p18, 4),
+	    io_rd(p18, 4) & 1, p104 ? io_rd(p104, 4) : 0);
+	if (icepcie_lx && iceland_ath12k_bar != 0) {
+		/* 46cn3y: the Linux driver owns the powered chip: gpio16 and every vote stay, as for a resident BT controller */
+		say("icepcie: 46cn3y harvest after handoff: gpio16 (WLAN_EN) stays high (io %08x) and the votes stay - the Linux "
+		    "ath12k driver owns the chip (route B; was put back low here before scan236)\n", io_rd(p16, 4));
+		return;
+	}
+	if (hr_on) {
+		/* scan40 (23bt3): the BT controller is resident on this power-up - gpio16 and every vote stay */
+		say("icewifi: gpio16 stays high and the votes stay: the BT controller is resident (23bt3)%s\n",
+		    ux2_voted[0] || ux2_voted[1] || ux2_voted[2] || ux2_voted[3] ? " - 34ux2's voltage votes too" : "");
+		return;
+	}
+	/* undo, in reverse */
+	*(volatile uint32_t *)(p16 + 4) = io0 & ~2u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(p16 + 0) = ctl0;
+	*(volatile uint32_t *)(p16 + 4) = io0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	IOSleep(10);
+	say("icewifi: gpio16 put back: ctl %08x io %08x (as found %08x %08x); gpio18 io %08x\n", io_rd(p16, 0), io_rd(p16, 4),
+	    ctl0, io0, io_rd(p18, 4));
+	for (int q = 0; q < UX2_N; q++) {
+		if (ux2_voted[q]) {
+			ux2_rb(ux2_r[q].name, ux2_r[q].u1, "at the undo");
+		}
+	}
+	ux2_release(release, "the undo (gpio16 put back)");
+	if (release) {
+		for (int j = voted - 1; j >= 0; j--) {
+			if (rails[j].releasable && rails[j].level <= level) {
+				say("icewifi: release %s -> %d\n", rails[j].name, hakios_iceland_rpmh_release(rails[j].name));
+			}
+		}
+	} else {
+		say("icewifi: the votes stay (icewifi_release=1 releases L2G_E0 / L3G_E0; the enable-only ones never)\n");
+	}
+	say("icewifi: done\n");
+}
+
+/*
+ * ---- icedsi=1 (kit 26a, class B: reads only) - the two DSI hosts (DT dsi@9ac0000, dsi@9ac3000, "qcom,kaanapali-dsi-ctrl")
+ * as the bootloader left them, the prerequisite of a screen off/on kit (25d). DSI 6G: the registers sit 4 bytes up
+ * (Linux msm dsi_host DSI_6G_REG_SHIFT): HW_VERSION +0x0, CTRL +0x4, STATUS0 +0x8, VID_CFG0 +0x10, CMD_CFG0 +0x40,
+ * TRIG_CTRL +0x84, LANE_STATUS +0xa8, LANE_CTRL +0xac, INTR_CTRL +0x110, CLK_CTRL +0x11c, CLK_STATUS +0x120. Read only
+ * while the display controller is on (it scans out the boot framebuffer: 18i's icedpu showed its frame counters
+ * running), at 20 s and 60 s.
+ */
+static void
+dsi_probe(const char *when)
+{
+	static const uint32_t base[2] = { 0x09ac0000u, 0x09ac3000u };
+
+	for (int n = 0; n < 2; n++) {
+		vm_offset_t d = ml_io_map_unmappable(base[n], PAGE_SIZE, VM_WIMG_IO);
+		if (d == 0) {
+			continue;
+		}
+		say("icedsi: %s: dsi%d %#x: version %08x ctrl %08x status0 %08x vid_cfg0 %08x cmd_cfg0 %08x trig %08x lane_status "
+		    "%08x lane_ctrl %08x intr %08x clk_ctrl %08x clk_status %08x\n", when, n, base[n], io_rd(d, 0x0), io_rd(d, 0x4),
+		    io_rd(d, 0x8), io_rd(d, 0x10), io_rd(d, 0x40), io_rd(d, 0x84), io_rd(d, 0xa8), io_rd(d, 0xac), io_rd(d, 0x110),
+		    io_rd(d, 0x11c), io_rd(d, 0x120));
+	}
+}
+
+/*
+ * ---- icespmi=1 (kit 23f1, class B: reads only) - where the WCN7860's bt-enable is: PMIC GPIO 5 of pmh0104 (DT
+ * pmic@9 -> gpio@8800, phandle 0xfe; GPIO n at peripheral 0x8800 + (n - 1) * 0x100: GPIO 5 = 0x8c00, PPID 0x98c) on
+ * the SPMI arbiter "qcom,kaanapali-spmi-pmic-arb" (glymur-class, v8): core 0xc400000 (VERSION +0), chnl_map 0xc403000
+ * (one word per APID, Linux spmi-pmic-arb.c apid_map_offset_v8 = 4 * n), bus 0 chnl_owner 0xc42a000 (owner EE in bits
+ * 2:0 per APID). Logged: the version, every map entry naming SID 9 (both encodings: bits 11:0 and 19:8), the APID of
+ * PPID 0x98c and its owner. Nothing written.
+ * icespmi=2 (23f1b, CLASS C-light: one write per read to the arbiter's OWN observer command register, an SPMI read on
+ * the bus, never a PMIC write): the GPIO's SUBTYPE 0x8c04/05, STATUS1 0x8c08, MODE_CTL 0x8c40, DIG_VIN 0x8c41,
+ * DIG_PULL 0x8c42, DIG_OUT_SRC 0x8c44, DIG_OUT 0x8c45, EN_CTL 0x8c46 through observer channel apid (obsrvr 0xc4c0000
+ * + 0x40000 * EE 0 + 0x20 * apid): CMD +0x0 = 1 << 27 (EXT_READL) | (addr & 0xff) << 4 | (bytes - 1), STATUS +0x8 bit 0
+ * polled, RDATA0 / 1 +0x18 / +0x1c.
+ */
+/*
+ * ---- icespmi=3 (kit 23f2, CLASS C: the first PMIC write - WCN7860 bt-enable = pmh0104 GPIO 5 high) -----------------
+ * Resolution (reads, at the thread's start), as Linux spmi-pmic-arb.c v8 for the bus the PMIC sits on (pmic@9 is under
+ * spmi@c437000 = bus 1): bus 1's APID range = [FEATURES(core + 0x4) & 0x1fff, + FEATURES(core + 0x8) & 0x1fff)
+ * (_pmic_arb_init_apid_v7 with PMIC_ARB_FEATURES_V8_PERIPH_MASK); every APID there whose chnl_map word (bits 12:0)
+ * names PPID 0x98c is logged with its owner from bus 1's chnl_owner table (0xc43b000 + 4 * (apid - base), bits 2:0 =
+ * EE, pmic_arb_apid_owner_v8); the APID chosen as _pmic_arb_read_apid_map does (the first mapping, overridden by one
+ * owned by EE 0). REFUSED unless that APID's owner is EE 0 (the apps; DT qcom,ee = <0>) - Linux would refuse the
+ * write too (pmic_arb_offset_v8: "disallowed SPMI write"). Write channel = chnls 0xc900000 + 0x200 * apid (global
+ * APID: 0x200 * 8192 = the DT's 0x400000; APID 2234 = +0x117400), observer = obsrvr 0xc4c0000 + 0x40000 * 0 + 0x20 *
+ * apid. Write = WDATA0 (+0x10) = byte, CMD (+0x0) = EXT_WRITEL (opcode 0) | (addr & 0xff) << 4 | 0 (one byte,
+ * fmt_cmd_v2), STATUS (+0x8) polled for 1 ms: 1 = done (bits 1/2/3 = failed / denied / dropped); every write read back
+ * through the observer.
+ * The write (f2_bt), only inside 23c2's power-up (icewifi=2: votes done, gpio16 high, gpio18 sw_ctrl read 1 - never a
+ * driven pin into an unpowered chip): REFUSED unless SUBTYPE 0x12 (GPIO_LV_VIN2: the LV/MV register layout), EN_CTL
+ * 0x80 and MODE_CTL 0 (an input: nobody drives it). Then the DT's bt_default state (pinctrl-spmi-gpio
+ * pmic_gpio_config_set order, lv_mv): DIG_VIN_CTL 0x8c41 = 1 (power-source 1), DIG_PULL_CTL 0x8c42 = 5 (bias-disable),
+ * MODE_CTL 0x8c40 = 1 (digital output, output-low), 10 ms, then bt-enable as pwrseq-qcom-wcn's gpiod_set_value:
+ * LV_MV_DIG_OUT_SOURCE_CTL 0x8c44 = 0x80 (OUTPUT_INVERT = output high, source 0). Held 3 s: RT_STS 0x8c10 / STATUS1
+ * 0x8c08 and the BT UART's pads (uart18 = qup3_se5: gpio24 CTS, 25 RTS, 26 TX, 27 RX; TLMM reads only, pads Linux
+ * uses) sampled at +50 ms, +500 ms, +3 s. Undo: DIG_OUT_SOURCE_CTL as found (low) first, 10 ms, then MODE_CTL /
+ * DIG_PULL_CTL / DIG_VIN_CTL as found, each read back.
+ */
+#define F2_PPID 0x98cu
+static vm_offset_t f2_obsv, f2_chnv;
+static int f2_apid = -1;
+
+static int
+f2_rd(uint16_t addr, uint32_t *stp)
+{
+	uint32_t st = 0;
+
+	*(volatile uint32_t *)(f2_obsv + 0x0) = 1u << 27 | (uint32_t)(addr & 0xff) << 4;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int t = 0; t < 100; t++) {
+		st = io_rd(f2_obsv, 0x8);
+		if (st & 1) {
+			break;
+		}
+		delay(10);
+	}
+	if (stp != NULL) {
+		*stp = st;
+	}
+	return st == 1 ? (int)(io_rd(f2_obsv, 0x18) & 0xff) : -1;
+}
+
+static bool
+f2_wr(const char *name, uint16_t addr, uint8_t val)
+{
+	uint32_t cmd = (uint32_t)(addr & 0xff) << 4, st = 0, ost = 0;
+	int rb;
+
+	*(volatile uint32_t *)(f2_chnv + 0x10) = val;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(f2_chnv + 0x0) = cmd;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int t = 0; t < 1000; t++) {
+		st = io_rd(f2_chnv, 0x8);
+		if (st & 1) {
+			break;
+		}
+		delay(1);
+	}
+	rb = f2_rd(addr, &ost);
+	say("icespmi: 23f2 write %s %#x <- %02x: cmd %08x status %08x (%s); observer read back %02x (status %08x)\n", name,
+	    addr, val, cmd, st, st == 1 ? "done" : "NOT done / failed / denied / dropped", (uint32_t)rb & 0xff, ost);
+	return st == 1 && rb == (int)val;
+}
+
+static void
+f2_resolve(vm_offset_t core, vm_offset_t map)
+{
+	uint32_t feat0 = io_rd(core, 0x4), feat1 = io_rd(core, 0x8), base = feat0 & 0x1fff, cnt = feat1 & 0x1fff, owner = ~0u;
+	vm_offset_t own1 = ml_io_map_unmappable(0x0c43b000u, 0x8000, VM_WIMG_IO), o, c;
+	int chosen = -1;
+
+	say("icespmi: 23f2: FEATURES %08x %08x %08x %08x: bus 0 = %u APIDs, bus 1 = APIDs %u..%u\n", feat0, feat1,
+	    io_rd(core, 0xc), io_rd(core, 0x10), base, base, base + cnt - 1);
+	if (own1 == 0 || cnt == 0 || base + cnt > 0x2000 || 4 * cnt > 0x8000) {
+		say("icespmi: 23f2 REFUSED: bus 1's APID range / owner table not usable\n");
+		return;
+	}
+	for (uint32_t n = base; n < base + cnt; n++) {
+		uint32_t v = io_rd(map, 4 * n), w;
+		if (v == 0 || (v & 0x1fff) != F2_PPID) {
+			continue;
+		}
+		w = io_rd(own1, 4 * (n - base));
+		say("icespmi: 23f2: APID %u maps PPID 0x98c (map %08x, irq owner %u), bus 1 owner word %08x = EE %u\n", n, v, v >> 31,
+		    w, w & 7);
+		if (chosen < 0 || (w & 7) == 0) {       /* _pmic_arb_read_apid_map: first mapping, or one for this EE */
+			chosen = (int)n;
+			owner = w;
+		}
+	}
+	if (chosen < 0) {
+		say("icespmi: 23f2 REFUSED: PPID 0x98c not mapped on bus 1\n");
+		return;
+	}
+	if ((owner & 7) != 0) {
+		say("icespmi: 23f2 REFUSED: APID %d is owned by EE %u, not the apps (EE 0): no write\n", chosen, owner & 7);
+		return;
+	}
+	o = 0x0c4c0000u + 0x20u * (uint32_t)chosen;
+	c = 0x0c900000u + 0x200u * (uint32_t)chosen;
+	f2_obsv = ml_io_map_unmappable(o & ~0xfffull, PAGE_SIZE, VM_WIMG_IO);
+	f2_chnv = ml_io_map_unmappable(c & ~0xfffull, PAGE_SIZE, VM_WIMG_IO);
+	if (f2_obsv == 0 || f2_chnv == 0) {
+		say("icespmi: 23f2 REFUSED: channels not mapped\n");
+		f2_obsv = f2_chnv = 0;
+		return;
+	}
+	f2_obsv += o & 0xfff;
+	f2_chnv += c & 0xfff;
+	f2_apid = chosen;
+	f2_ready = true;
+	say("icespmi: 23f2: APID %d owned by EE 0: write channel %#lx, observer %#lx; the write waits for 23c2's power-up "
+	    "(icewifi=2)\n", chosen, (unsigned long)c, (unsigned long)o);
+}
+
+static void
+f2_pins(const char *when)
+{
+	static const uint32_t pins[] = { 24, 25, 26, 27 };
+	uint32_t v[8] = { 0 };
+
+	for (int i = 0; i < 4; i++) {
+		vm_offset_t p = ml_io_map_unmappable(TLMM_PA + 0x1000u * pins[i], PAGE_SIZE, VM_WIMG_IO);
+		if (p != 0) {
+			v[2 * i] = io_rd(p, 0);
+			v[2 * i + 1] = io_rd(p, 4);
+		}
+	}
+	say("icespmi: 23f2 %s: RT_STS %02x STATUS1 %02x; uart18 pads gpio24 CTS ctl %08x in %u, gpio25 RTS ctl %08x in %u, "
+	    "gpio26 TX ctl %08x in %u, gpio27 RX ctl %08x in %u\n", when, (uint32_t)f2_rd(0x8c10, NULL) & 0xff,
+	    (uint32_t)f2_rd(0x8c08, NULL) & 0xff, v[0], v[1] & 1, v[2], v[3] & 1, v[4], v[5] & 1, v[6], v[7] & 1);
