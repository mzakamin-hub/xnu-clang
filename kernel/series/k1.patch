+/*
+ * The free memory outside the managed span (arm_vm_init.c, arm_vm_outside_init: runs of DRAM below and above the
+ * kernel's window) becomes VM pages, as pages below the page array do when ml_static_mfree returns them: each is
+ * mapped in the physical aperture and marked managed in the pmap, then gets a vm_page and goes to the free list. The
+ * pages were never wired or counted, so only the memory sizes grow. vm.outside_memory reports the pages adopted and
+ * the pages the pmap refused.
+ */
+uint32_t ml_outside_memory_pages;
+uint32_t ml_outside_memory_refused;
+
+/*
+ * Whether a load from a kernel address completes. Memory the firmware's map calls free can belong to another
+ * owner (a hypervisor guest, the secure world): a load from it is a synchronous external abort, which the
+ * platform error handler turns into this function's answer instead of a panic while the probe runs on this CPU.
+ */
+static volatile uint32_t ml_memory_probe_cpu;        /* the probing CPU's number plus one */
+static volatile uint32_t ml_memory_probe_faulted;
+static SIMPLE_LOCK_DECLARE(ml_memory_probe_lock, 0);
+
+bool
+ml_memory_probe_fault(void)
+{
+	if (ml_memory_probe_cpu != (uint32_t)cpu_number() + 1) {
+		return false;
+	}
+	ml_memory_probe_faulted = 1;
+	return true;
+}
+
+bool
+ml_memory_probe(vm_offset_t va)
+{
+	bool readable;
+
+	simple_lock(&ml_memory_probe_lock, LCK_GRP_NULL);     /* preemption is off until the unlock */
+	ml_memory_probe_faulted = 0;
+	ml_memory_probe_cpu = (uint32_t)cpu_number() + 1;
+	__asm__ volatile ("ldr x9, [%0]" : : "r"(va) : "x9", "memory");
+	__builtin_arm_isb(ISB_SY);
+	ml_memory_probe_cpu = 0;
+	readable = !ml_memory_probe_faulted;
+	simple_unlock(&ml_memory_probe_lock);
+	return readable;
+}
+
+/*
+ * The probe's guard around a whole page's loads or stores (outside-memtest): a synchronous external abort taken by
+ * any of them is skipped by the platform error handler (sleh.c arm64_platform_error), as the probe's one load is,
+ * and ml_memory_guard_end() says so. An asynchronous one (SError) is not caught.
+ */
+static void
+ml_memory_guard_begin(void)
+{
+	simple_lock(&ml_memory_probe_lock, LCK_GRP_NULL);     /* preemption is off until the unlock */
+	ml_memory_probe_faulted = 0;
+	ml_memory_probe_cpu = (uint32_t)cpu_number() + 1;
+}
+
+static bool
+ml_memory_guard_end(void)
+{
+	bool clean;
+
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+	ml_memory_probe_cpu = 0;
+	clean = !ml_memory_probe_faulted;
+	simple_unlock(&ml_memory_probe_lock);
+	return clean;
+}
+
+extern bool arm_vm_outside_range(unsigned int index, pmap_paddr_t *base, pmap_paddr_t *end);
+extern unsigned int arm_vm_outside_listed, arm_vm_outside_ignored;
+extern vm_map_address_t arm_vm_outside_va;
+
+/*
+ * outside-memtest=<s> (K3): a write-and-check test of the memory outside the span before the VM may use it. Without
+ * it (or with 0) nothing here runs. With it, ml_adopt_outside_memory adopts every page as before (mapped in the
+ * aperture and probed) but holds it back from the VM, and:
+ *   1. writes every 64-bit word of every adopted page with a pattern made from the word's own physical address
+ *      (ml_memtest_word: one value per address, so that two addresses or runs that alias show up), under the probe's
+ *      guard, so that a store into memory another owner keeps (a synchronous external abort) refuses that page
+ *      instead of panicking;
+ *   2. pass B: cleans and invalidates each page to the point of coherency, so that the check reads DRAM, not the
+ *      cache, then compares every word; a line per run (pages checked, bad, ms) and the first mismatches
+ *      (PA, expected, got);
+ *   3. pass C, from a thread call <s> seconds after the adoption began (loader_return_after counts from the same
+ *      point): the same clean, invalidate and check, a line per run with the time since pass B;
+ *   4. hands only the pages still good to the VM (vm_page_create_canonical, the runtime path ml_static_mfree uses),
+ *      grows max_mem and the other sizes by them then, and keeps the bad ones out of the pmap and the aperture;
+ *   5. one line: "outside memtest: pass B N pages, M bad; pass C after S s: N pages, M bad; handed over K pages ...".
+ * outside-memtest-poison=<pa> (a test of the test): flips the word at <pa> between pass B and pass C.
+ */
+#define ML_MEMTEST_KEY          0x5aa5c33c0ff0966dULL
+#define ML_MEMTEST_RUNS         16      /* arm_vm_init.c ARM_VM_OUTSIDE_RANGES */
+#define ML_MEMTEST_SHOWN        8       /* mismatching pages logged a pass */
+
+typedef struct {
+	pmap_paddr_t base;
+	pmap_paddr_t end;
+	uint32_t     first;                 /* the run's first page in ml_memtest_good */
+} ml_memtest_run_t;
+
+static ml_memtest_run_t ml_memtest_runs[ML_MEMTEST_RUNS];
+static unsigned int     ml_memtest_nruns;
+static uint64_t        *ml_memtest_good;       /* a bit a page: adopted, written, and good at every check so far */
+static vm_size_t        ml_memtest_good_size;
+static uint32_t         ml_memtest_adopted;
+static uint32_t         ml_memtest_seconds;
+static uint64_t         ml_memtest_t0;          /* the adoption's start */
+static uint64_t         ml_memtest_b_end;       /* pass B's end */
+static uint32_t         ml_memtest_b_pages, ml_memtest_b_bad, ml_memtest_write_faults;
+static uint64_t         ml_memtest_poison;
+static unsigned int     ml_memtest_shown;
+
+static inline uint64_t
+ml_memtest_word(pmap_paddr_t pa)
+{
+	return (uint64_t)pa ^ ((uint64_t)pa << 32) ^ ML_MEMTEST_KEY;
+}
+
+static inline bool
+ml_memtest_is_good(uint32_t bit)
+{
+	return (ml_memtest_good[bit / 64] >> (bit % 64)) & 1;
+}
+
+static uint64_t
+ml_memtest_ms_since(uint64_t start)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* Keep a page out: never handed to the VM, unmarked in the pmap, no aperture mapping. */
+static void
+ml_memtest_keep_out(uint32_t bit, pmap_paddr_t pa)
+{
+	ml_memtest_good[bit / 64] &= ~(1ULL << (bit % 64));
+	pmap_release_outside_page((ppnum_t)atop(pa));
+}
+
+/* Write the page's pattern; false when a store faulted. */
+static bool
+ml_memtest_fill(pmap_paddr_t pa)
+{
+	volatile uint64_t *p = (volatile uint64_t *)phystokv(pa);
+
+	ml_memory_guard_begin();
+	for (unsigned int i = 0; i < PAGE_SIZE / sizeof(uint64_t); i++) {
+		p[i] = ml_memtest_word(pa + i * sizeof(uint64_t));
+	}
+	return ml_memory_guard_end();
+}
+
+/* Clean and invalidate the page to the point of coherency, then compare every word with its pattern. */
+static bool
+ml_memtest_check(pmap_paddr_t pa, const char *pass)
+{
+	const vm_offset_t va = phystokv(pa);
+	volatile uint64_t *p = (volatile uint64_t *)va;
+	unsigned int bad = 0, first = 0;
+	uint64_t first_got = 0;
+	bool clean;
+
+	FlushPoC_DcacheRegion(va, PAGE_SIZE);
+	ml_memory_guard_begin();
+	for (unsigned int i = 0; i < PAGE_SIZE / sizeof(uint64_t); i++) {
+		const uint64_t got = p[i];
+
+		if (__improbable(got != ml_memtest_word(pa + i * sizeof(uint64_t)))) {
+			if (bad++ == 0) {
+				first = i;
+				first_got = got;
+			}
+		}
+	}
+	clean = ml_memory_guard_end();
+	if ((bad != 0 || !clean) && ml_memtest_shown < ML_MEMTEST_SHOWN) {
+		ml_memtest_shown++;
+		if (bad != 0) {
+			const pmap_paddr_t at = pa + first * sizeof(uint64_t);
+
+			printf("outside memtest: pass %s mismatch at 0x%llx: expected 0x%016llx, got 0x%016llx (%u words of the "
+			    "page bad)%s\n", pass, (unsigned long long)at, ml_memtest_word(at), first_got, bad,
+			    clean ? "" : "; a load faulted");
+		} else {
+			printf("outside memtest: pass %s: a load of the page at 0x%llx faulted\n", pass, (unsigned long long)pa);
+		}
+	}
+	return bad == 0 && clean;
+}
+
+/* One pass over the pages still good: each is checked, a bad one kept out; a line per run. */
+static void
+ml_memtest_pass(const char *pass, uint64_t after_s, uint32_t *checked_p, uint32_t *bad_p)
+{
+	ml_memtest_shown = 0;
+	*checked_p = *bad_p = 0;
+	for (unsigned int r = 0; r < ml_memtest_nruns; r++) {
+		const ml_memtest_run_t *run = &ml_memtest_runs[r];
+		const uint64_t start = mach_absolute_time();
+		uint32_t checked = 0, bad = 0, bit = run->first;
+
+		for (pmap_paddr_t pa = run->base; pa < run->end; pa += PAGE_SIZE, bit++) {
+			if (!ml_memtest_is_good(bit)) {
+				continue;
+			}
+			checked++;
+			if (!ml_memtest_check(pa, pass)) {
+				ml_memtest_keep_out(bit, pa);
+				bad++;
+			}
+		}
+		if (after_s == UINT64_MAX) {
+			printf("outside memtest: pass %s run %u 0x%llx + 0x%llx: %u pages checked, %u bad, %llu ms\n", pass, r,
+			    (unsigned long long)run->base, (unsigned long long)(run->end - run->base), checked, bad,
+			    ml_memtest_ms_since(start));
+		} else {
+			printf("outside memtest: pass %s run %u 0x%llx + 0x%llx: %u pages checked, %u bad, %llu ms, %llu s after "
+			    "pass B\n", pass, r, (unsigned long long)run->base, (unsigned long long)(run->end - run->base), checked,
+			    bad, ml_memtest_ms_since(start), after_s);
+		}
+		*checked_p += checked;
+		*bad_p += bad;
+	}
+}
+
+/* Pass C and the hand-over, from a thread call (not startup code: it runs long after startup). */
+static void
+ml_memtest_late(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	const uint64_t max_mem_before = max_mem;
+	uint32_t c_pages, c_bad, handed = 0;
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - ml_memtest_b_end, &ns);
+	const uint64_t after_s = ns / NSEC_PER_SEC;
+
+	ml_memtest_pass("C", after_s, &c_pages, &c_bad);
+	for (unsigned int r = 0; r < ml_memtest_nruns; r++) {
+		const ml_memtest_run_t *run = &ml_memtest_runs[r];
+		uint32_t bit = run->first;
+
+		for (pmap_paddr_t pa = run->base; pa < run->end; pa += PAGE_SIZE, bit++) {
+			if (ml_memtest_is_good(bit)) {
+				vm_page_create_canonical((ppnum_t)atop(pa));
+				handed++;
+			}
+		}
+	}
+	if (handed != 0) {
+		const uint64_t bytes = ptoa_64(handed);
+
+		max_mem += bytes;
+		max_mem_actual += bytes;
+		mem_actual += bytes;
+		sane_size += bytes;
+		machine_info.max_mem += bytes;
+	}
+	ml_outside_memory_pages = handed;
+	printf("outside memtest: pass B %u pages, %u bad; pass C after %llu s: %u pages, %u bad; handed over %u pages, "
+	    "%u kept out (%u write faults); max_mem 0x%llx -> 0x%llx\n", ml_memtest_b_pages, ml_memtest_b_bad, after_s,
+	    c_pages, c_bad, handed, ml_memtest_adopted - handed, ml_memtest_write_faults, max_mem_before, (uint64_t)max_mem);
+	kfree_data(ml_memtest_good, ml_memtest_good_size);
+	ml_memtest_good = NULL;
+}
+
+/* The runs and the page map, before the adoption; false leaves the adoption as it is without the test. */
+__startup_func
+static bool
+ml_memtest_setup(uint32_t seconds)
+{
+	pmap_paddr_t base, end;
+	uint32_t pages = 0;
+	unsigned int n;
+
+	for (n = 0; n < ML_MEMTEST_RUNS && arm_vm_outside_range(n, &base, &end); n++) {
+		ml_memtest_runs[n] = (ml_memtest_run_t){ .base = base, .end = end, .first = pages };
+		pages += (uint32_t)atop(end - base);
+	}
+	if (pages == 0) {
+		return false;
+	}
+	ml_memtest_good_size = ((pages + 63) / 64) * sizeof(uint64_t);
+	ml_memtest_good = kalloc_data(ml_memtest_good_size, Z_WAITOK | Z_ZERO);
+	if (ml_memtest_good == NULL) {
+		printf("outside memtest: no memory for the page map: the test is off\n");
+		return false;
+	}
+	ml_memtest_nruns = n;
+	ml_memtest_seconds = seconds;
+	ml_memtest_t0 = mach_absolute_time();
+	PE_parse_boot_argn("outside-memtest-poison", &ml_memtest_poison, sizeof(ml_memtest_poison));
+	printf("outside memtest: %u s, %u runs, %u pages: adopted, written and checked before the VM gets them\n", seconds,
+	    n, pages);
+	return true;
+}
+
+/* Steps 1 and 2 (the writes and pass B) at boot, the poison, and pass C's thread call. */
+__startup_func
+static void
+ml_memtest_boot(uint32_t adopted)
+{
+	uint64_t interval, deadline;
+
+	ml_memtest_adopted = adopted;
+	for (unsigned int r = 0; r < ml_memtest_nruns; r++) {
+		const ml_memtest_run_t *run = &ml_memtest_runs[r];
+		const uint64_t start = mach_absolute_time();
+		uint32_t written = 0, faults = 0, bit = run->first;
+
+		for (pmap_paddr_t pa = run->base; pa < run->end; pa += PAGE_SIZE, bit++) {
+			if (!ml_memtest_is_good(bit)) {
+				continue;
+			}
+			if (ml_memtest_fill(pa)) {
+				written++;
+			} else {
+				ml_memtest_keep_out(bit, pa);
+				faults++;
+			}
+		}
+		printf("outside memtest: write run %u 0x%llx + 0x%llx: %u pages written, %u write faults, %llu ms\n", r,
+		    (unsigned long long)run->base, (unsigned long long)(run->end - run->base), written, faults,
+		    ml_memtest_ms_since(start));
+		ml_memtest_write_faults += faults;
+	}
+	ml_memtest_pass("B", UINT64_MAX, &ml_memtest_b_pages, &ml_memtest_b_bad);
+	ml_memtest_b_end = mach_absolute_time();
+	if (ml_memtest_poison != 0) {
+		const pmap_paddr_t pa = ml_memtest_poison & ~(pmap_paddr_t)(sizeof(uint64_t) - 1);
+		bool done = false;
+
+		for (unsigned int r = 0; r < ml_memtest_nruns && !done; r++) {
+			const ml_memtest_run_t *run = &ml_memtest_runs[r];
+
+			if (pa >= run->base && pa < run->end && ml_memtest_is_good(run->first + (uint32_t)atop(pa - run->base))) {
+				volatile uint64_t *p = (volatile uint64_t *)phystokv(pa);
+				const uint64_t was = *p;
+
+				*p = ~was;
+				FlushPoC_DcacheRegion((vm_offset_t)p, sizeof(uint64_t));
+				printf("outside memtest: poison: the word at 0x%llx flipped, 0x%016llx -> 0x%016llx\n",
+				    (unsigned long long)pa, was, ~was);
+				done = true;
+			}
+		}
+		if (!done) {
+			printf("outside memtest: poison: 0x%llx is in no page held for the test: not done\n",
+			    (unsigned long long)ml_memtest_poison);
+		}
+	}
+	/* vm_page_create_canonical() after startup needs the page radix tree's root, made only during startup. */
+	vm_pages_radix_prepare();
+	nanoseconds_to_absolutetime((uint64_t)ml_memtest_seconds * NSEC_PER_SEC, &interval);
+	deadline = MAX(ml_memtest_t0 + interval, mach_absolute_time());
+	thread_call_enter_delayed(thread_call_allocate(ml_memtest_late, NULL), deadline);
+	printf("outside memtest: pass B %u pages, %u bad; %u write faults; %u pages held for pass C, %u s after the "
+	    "adoption began\n", ml_memtest_b_pages, ml_memtest_b_bad, ml_memtest_write_faults,
+	    ml_memtest_b_pages - ml_memtest_b_bad, ml_memtest_seconds);
+}
+
+__startup_func
+static void
+ml_adopt_outside_memory(void)
+{
+	pmap_paddr_t base, end;
+	uint32_t adopted = 0, refused = 0;
+	unsigned int runs = 0;
+	const uint64_t max_mem_before = max_mem;
