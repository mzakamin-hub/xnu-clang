+static void
+lx_poll(void)
+{
+}
+
+/* 46cn4a A2: the shape of a line = its first 40 characters with digits as '#'; > 30 of one shape in a 10 s window are
+ * counted, not printed; the counts are said when the window closes */
+#define OM_LIM_N 64
+static struct { char key[41]; uint32_t n, dropped; } om_lim[OM_LIM_N];
+static uint64_t om_lim_win;
+static uint32_t om_lim_total;
+
+static bool
+om_has(const char *s, const char *t)
+{
+	for (; *s; s++) {
+		const char *a = s, *b = t;
+
+		while (*a && *b && *a == *b) {
+			a++;
+			b++;
+		}
+		if (!*b) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+om_exempt(const char *line)
+{
+	return om_has(line, "46cn") || om_has(line, "W0 ") || om_has(line, "W1") || om_has(line, "W2") ||
+	       om_has(line, "QMIDUMP") || om_has(line, "stuck") || om_has(line, "rddm") || om_has(line, "timeout");
+}
+
+static void
+om_lim_flush(void)
+{
+	for (int i = 0; i < OM_LIM_N; i++) {
+		if (om_lim[i].dropped) {
+			printf("icepcie: ath12k: 46cn4a A2 %u lines like '%s' not printed in the last 10 s (%u printed)\n",
+			    om_lim[i].dropped, om_lim[i].key, om_lim[i].n - om_lim[i].dropped);
+		}
+	}
+	bzero(om_lim, sizeof(om_lim));
+}
+
+static bool
+om_limit(const char *line)
+{
+	char k[41];
+	int i, j, free_i = -1;
+	uint64_t now = lx_now_ms();
+
+	if (now - om_lim_win >= 10000) {
+		om_lim_flush();
+		om_lim_win = now;
+	}
+	for (i = 0; i < 40 && line[i]; i++) {
+		k[i] = (line[i] >= '0' && line[i] <= '9') ? '#' : line[i];
+	}
+	k[i] = 0;
+	for (j = 0; j < OM_LIM_N; j++) {
+		if (om_lim[j].key[0] == 0) {
+			if (free_i < 0) {
+				free_i = j;
+			}
+			continue;
+		}
+		if (strcmp(om_lim[j].key, k) == 0) {
+			break;
+		}
+	}
+	if (j == OM_LIM_N) {
+		if (free_i < 0) {
+			return false;   /* table full: printed */
+		}
+		j = free_i;
+		strlcpy(om_lim[j].key, k, sizeof(om_lim[j].key));
+	}
+	if (++om_lim[j].n > 30) {
+		om_lim[j].dropped++;
+		om_lim_total++;
+		return true;
+	}
+	return false;
+}
+
+/* 46cn4a: the run's timeline - the first time each step is seen in the driver's lines; said in a few lines at 285 s */
+static const struct {
+	const char *name, *pat;
+} om_tl_pat[] = {
+	{ "mhi-bhi", "BHIe programming" }, { "mhi-mission", "MHI_CB_EE_MISSION_MODE" }, { "qmi-hostcap", "QMIDUMP id 52 " },
+	{ "qmi-wlan-cfg", "QMIDUMP id 35 " }, { "qmi-wlan-mode", "QMIDUMP id 34 " }, { "htc-ready", "HTC_CONNECT: Control entry" },
+	{ "htt-connect-sent", "HTT Data request sent" }, { "htt-connect-resp", "HTT Data response" },
+	{ "wmi-connect-resp", "CONNECT_SERVICE_RESP" }, { "wmi-ready", " READY len" }, { "svc-ready-ext", "SERVICE_READY_EXT " },
+	{ "reg-chan-list", "REG_CHAN_LIST" }, { "first-scan", "scan starts" }, { "scan-failed", "scan request failed" },
+	{ "first-wmi-timeout", "wmi command" }, { "sys-err", "SYS_ERR" }, { "rddm", "MHI_CB_EE_RDDM" },
+};
+#define OM_TL_N (sizeof(om_tl_pat) / sizeof(om_tl_pat[0]))
+static uint64_t om_tl_ms[OM_TL_N];
+
+static int om_syserr_seen;      /* 46cn4e: 1 = seen, the loop dumps the record; 2 = dumped */
+
+static void
+om_timeline_tap(const char *line)
+{
+	if (!om_syserr_seen && (om_has(line, "MHI_CB_EE_RDDM") || om_has(line, "SYS_ERR"))) {
+		om_syserr_seen = 1;
+	}
+	for (unsigned i = 0; i < OM_TL_N; i++) {
+		if (om_tl_ms[i] == 0 && om_has(line, om_tl_pat[i].pat)) {
+			om_tl_ms[i] = lx_now_ms();
+		}
+	}
+}
+
+/* "hh:hh:hh:hh:hh:hh" starts at s */
+static bool
+lx_mac_at(const char *s)
+{
+	for (int i = 0; i < 17; i++) {
+		char c = s[i];
+
+		if (i % 3 == 2 ? c != ':' : !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * w3-net: the driver object names the access point in "wifi: connecting to <bssid> on N MHz" (runs/w3-net-2), and no
+ * Ethernet address may reach the log. A line with one is printed with every such address as xx:xx:xx:xx:xx:xx (on the
+ * stack: such lines are short; a longer one is cut at 255 characters).
+ */
+static void
+lx_print_masked(const char *line)
+{
+	char b[256];
+	size_t o = 0;
+	bool masked = false;
+
+	for (const char *p = line; *p; p++) {
+		if (lx_mac_at(p)) {
+			masked = true;
+			break;
+		}
+	}
+	if (!masked) {
+		printf("icepcie: ath12k: %s\n", line);
+		return;
+	}
+	for (const char *p = line; *p && o + 1 < sizeof(b);) {
+		if (lx_mac_at(p) && o + 17 < sizeof(b)) {
+			memcpy(b + o, "xx:xx:xx:xx:xx:xx", 17);
+			o += 17;
+			p += 17;
+		} else {
+			b[o++] = *p++;
+		}
+	}
+	b[o] = 0;
+	printf("icepcie: ath12k: %s\n", b);
+}
+
+static void
+lx_log(int level __unused, const char *line)
+{
+	om_timeline_tap(line);
+#if defined(XNU_TARGET_OS_OSX)
+	{
+		/*
+		 * macOS has one 1 MB message buffer for the whole run, and the driver's per-packet lines wrapped it
+		 * (runs/wifi-2/20261115-053935: 10747 icepcie lines, 8477 of them these four shapes; A2's limit is 30 a
+		 * shape in 10 s, and "event mgmt rx skb 0x..." is a new shape for every pointer). They are counted in the
+		 * 10 s line's "log lines held back", never printed; the stage, W2 per-second and summary lines stay.
+		 */
+		static const char *const chatter[] = { "rx ce pipe ", "tx ce pipe ", "event mgmt rx ", "mgmt rx event status" };
+
+		for (size_t k = 0; k < sizeof(chatter) / sizeof(chatter[0]); k++) {
+			if (om_has(line, chatter[k])) {
+				om_lim_total++;
+				return;
+			}
+		}
+	}
+#endif
+	if (hakios_iceland_omni(2) && !om_exempt(line) && om_limit(line)) {
+		return;
+	}
+	lx_print_masked(line);
+}
+
+static void
+lx_halt(void)
+{
+}
+
+static void *
+lx_alloc(size_t n)
+{
+	uint64_t total = n + 16;
+	uint8_t *p = kalloc_data((vm_size_t)total, Z_WAITOK | Z_ZERO);
+
+	if (p == NULL) {
+		return NULL;
+	}
+	memcpy(p, &total, 8);
+	return p + 16;
+}
+
+static void
+lx_free(void *p)
+{
+	uint64_t total;
+	uint8_t *base;
+
+	if (p == NULL) {
+		return;
+	}
+	base = (uint8_t *)p - 16;
+	memcpy(&total, base, 8);
+	kfree_data(base, (vm_size_t)total);
+}
+
+/*
+ * ---- W2 (46cn3a, bit 0x20): join, then DHCP, ARP and ping, in the kernel, through the runtime's station ----
+ * The network comes from the same private mechanism route A used (46cn1b2/1b3): md1 fw/wifi-pmk.bin, made on the PC
+ * from private-records, records of (FNV-1a hash of the SSID, 32 B PMK). A scanned network whose SSID hashes to a
+ * record is joined with that PMK (handed to the station as 64 hex digits, wiped after). Nothing identifying is logged:
+ * no SSID, BSSID, MAC, PMK; addresses as x.x.x.N. Everything here runs on the driver thread (nw_wifi_step's caller),
+ * which is also where the station's events arrive.
+ */
+static const char *const w2_names[] = {
+	"none", "driver started", "radio registered (WMI ready, services up)", "station interface up", "first scan done",
+	"test network found", "joined (keys in, port open)", "DHCP OFFER", "DHCP ACK: lease", "gateway ARP answered",
+	"gateway ping answered",
+};
+static struct {
+	int stage, st, joins, scans_asked, connect_result, connected;
+	uint32_t scan_mark;              /* the join waits for a scan finished after this count */
+	uint64_t t, t0, stage_ms[11];
+	uint8_t mac[6], gw_mac[6];
+	uint32_t xid, my_ip, srv_ip, gw_ip, prefix, lease;
+	uint32_t tries, ping_sent, ping_ok, rx, rx_ip, rx_arp, rx_bcast, rx_dhcp, tx, tx_fail;
+	uint32_t c_ucast, c_mcast, c_bcast, c_eapol, c_arp, c_ip, c_udp, c_dhcp, c_other;   /* 46cn4e: per-second rx classes */
+	uint32_t disc_sent, uni_sent;
+	uint64_t disc_first, sec_t;
+	int sec_lines;
+	uint64_t ping_at[8];
+	int summary_done;
+} w2;
+
+/*
+ * w3-net (icewifi_net=1, macOS only): after the join the station is en0's. State 8, "handed over": the frames go to
+ * macOS's stack (hakios_iceland_net.c) and configd asks for the lease, so the DHCP, ARP and ping below are left out
+ * (two DHCP clients behind one address would take each other's answers). A lost link scans and joins again.
+ */
+#define W2_NET  8
+static int
+w2_net(void)
+{
+#if defined(XNU_TARGET_OS_OSX)
+	return hakios_iceland_net_mode() == 1;
+#else
+	return 0;
+#endif
+}
+
+static void
+w2_stage(int s)
+{
+	if (s <= w2.stage) {
+		return;
+	}
+	w2.stage = s;
+	w2.stage_ms[s] = lx_now_ms();
+	printf("icepcie: ath12k: 46cn3a W2 stage %d: %s at %llu ms\n", s, w2_names[s], w2.stage_ms[s]);
+}
+
+static uint32_t
+w2_fnv(const uint8_t *b, uint32_t n)
+{
+	uint32_t h = 0x811c9dc5u;
+
+	for (uint32_t i = 0; i < n; i++) {
+		h = (h ^ b[i]) * 0x01000193u;
+	}
+	return h;
+}
+
+static void
+w2_be32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+
+static uint32_t
+w2_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static uint16_t
+w2_csum(const uint8_t *p, uint32_t n)
+{
+	uint32_t s = 0;
+
+	for (uint32_t i = 0; i + 1 < n; i += 2) {
+		s += (uint32_t)p[i] << 8 | p[i + 1];
+	}
+	if (n & 1) {
+		s += (uint32_t)p[n - 1] << 8;
+	}
+	while (s >> 16) {
+		s = (s & 0xffff) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+static uint32_t
+w2_eth(uint8_t *f, const uint8_t *dst, uint16_t type)
+{
+	memcpy(f, dst, 6);
+	memcpy(f + 6, w2.mac, 6);
+	f[12] = (uint8_t)(type >> 8);
+	f[13] = (uint8_t)type;
+	return 14;
+}
+
+static void
+w2_ip(uint8_t *ip, uint32_t src, uint32_t dst, uint8_t proto, uint32_t plen)
+{
+	uint16_t c;
+
+	bzero(ip, 20);
+	ip[0] = 0x45;
+	ip[2] = (uint8_t)((20 + plen) >> 8);
+	ip[3] = (uint8_t)(20 + plen);
+	ip[6] = 0x40;
+	ip[8] = 64;
+	ip[9] = proto;
+	w2_be32(ip + 12, src);
+	w2_be32(ip + 16, dst);
+	c = w2_csum(ip, 20);
+	ip[10] = (uint8_t)(c >> 8);
+	ip[11] = (uint8_t)c;
+}
+
+static void
+w2_send(const uint8_t *f, uint32_t n, const char *what)
+{
+	int r = nw_wifi_tx(f, n);
+
+	if (r == 0) {
+		w2.tx++;
+	} else {
+		w2.tx_fail++;
+	}
+	printf("icepcie: ath12k: 46cn3a W2 tx %s (%u B): %s at %llu ms\n", what, n, r == 0 ? "queued" : "REFUSED", lx_now_ms());
+}
+
+static const uint8_t w2_bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+
+static void
+w2_dhcp_send(int type)
+{
+	uint8_t f[400];
+	uint32_t o = w2_eth(f, w2_bcast, 0x0800), b = 240, n;
+	uint8_t *udp = f + o + 20, *bp = udp + 8;
+
+	bzero(udp, 8 + 300);
+	bp[0] = 1;
+	bp[1] = 1;
+	bp[2] = 6;
+	w2_be32(bp + 4, w2.xid);
+	bp[10] = hakios_iceland_grp(0x10) ? 0 : 0x80;   /* 46cn4g 0x10: no broadcast flag -> the server answers unicast */
+	memcpy(bp + 28, w2.mac, 6);
+	w2_be32(bp + 236, 0x63825363);
+	bp[b++] = 53; bp[b++] = 1; bp[b++] = (uint8_t)type;
+	if (type == 3) {
+		bp[b++] = 50; bp[b++] = 4; w2_be32(bp + b, w2.my_ip); b += 4;
+		bp[b++] = 54; bp[b++] = 4; w2_be32(bp + b, w2.srv_ip); b += 4;
+	}
+	bp[b++] = 55; bp[b++] = 3; bp[b++] = 1; bp[b++] = 3; bp[b++] = 6;
+	bp[b++] = 255;
+	if (b < 300) {
+		b = 300;
+	}
+	n = 8 + b;
+	udp[1] = 68;
+	udp[3] = 67;
+	udp[4] = (uint8_t)(n >> 8);
+	udp[5] = (uint8_t)n;
+	w2_ip(f + o, 0, 0xffffffffu, 17, n);
+	if (type == 1 && w2.disc_sent++ == 0) {
+		/* 46cn4e: the DISCOVER's bytes once (the address bytes of the station are the radio's own: kept in the private log) */
+		w2.disc_first = lx_now_ms();
+		for (uint32_t k = 0; k < o + 20 + n; k += 48) {
+			char hx[100];
+			int h = 0;
+
+			for (uint32_t j = k; j < o + 20 + n && j < k + 48; j++) {
+				h += snprintf(hx + h, sizeof(hx) - h, "%02x", f[j]);
+			}
+			printf("icepcie: ath12k: 46cn4e W2 DISCOVER +%u: %s\n", k, hx);
+		}
+	}
+	w2_send(f, o + 20 + n, type == 1 ? "DHCP DISCOVER" : "DHCP REQUEST");
+	if (type == 1 && w2.disc_first && lx_now_ms() - w2.disc_first >= 10000 && w2.uni_sent < 3 && nw_wifi_status_get != NULL) {
+		/* 46cn4e: no OFFER in 10 s: the same DISCOVER as a unicast frame to the AP (the pairwise-key TX path instead
+		 * of the group one). An ARP to the gateway needs the gateway's address, which only the lease gives. */
+		struct nw_wifi_status st;
+
+		bzero(&st, sizeof(st));
+		nw_wifi_status_get(&st);
+		memcpy(f, st.bssid, 6);
+		w2.uni_sent++;
+		w2_send(f, o + 20 + n, "DHCP DISCOVER unicast to the AP (46cn4e: no OFFER in 10 s)");
+	}
+}
+
+static void
+w2_arp_send(int op, const uint8_t *tha, uint32_t tip)
+{
+	uint8_t f[60];
+	uint32_t o = w2_eth(f, op == 1 ? w2_bcast : tha, 0x0806);
+	uint8_t *a = f + o;
+
+	bzero(f + o, sizeof(f) - o);
+	a[1] = 1; a[2] = 8; a[4] = 6; a[5] = 4; a[7] = (uint8_t)op;
+	memcpy(a + 8, w2.mac, 6);
+	w2_be32(a + 14, w2.my_ip);
+	if (op == 2) {
+		memcpy(a + 18, tha, 6);
+	}
+	w2_be32(a + 24, tip);
+	w2_send(f, 60, op == 1 ? "ARP request (gateway)" : "ARP reply");
+}
+
+static void
+w2_ping_send(void)
+{
+	uint8_t f[14 + 20 + 40];
+	uint32_t o = w2_eth(f, w2.gw_mac, 0x0800);
+	uint8_t *ic = f + o + 20;
+	uint16_t c;
+
+	bzero(ic, 40);
+	ic[0] = 8;
+	ic[4] = 0x3c; ic[5] = 0x0a;             /* identifier */
+	ic[7] = (uint8_t)(w2.ping_sent + 1);
+	for (int i = 8; i < 40; i++) {
+		ic[i] = (uint8_t)i;
+	}
+	c = w2_csum(ic, 40);
+	ic[2] = (uint8_t)(c >> 8);
+	ic[3] = (uint8_t)c;
+	w2_ip(f + o, w2.my_ip, w2.gw_ip, 1, 40);
+	if (w2.ping_sent < 8) {
+		w2.ping_at[w2.ping_sent] = hakios_iceland_us();
+	}
+	w2.ping_sent++;
+	w2_send(f, sizeof(f), "ICMP echo request (gateway)");
+}
+
+/* received frames, Ethernet header first (the station hands them up once its keys are in) */
+static void
+w2_rx(const uint8_t *e, size_t len)
+{
+	uint16_t type;
+
+	if (len < 14) {
+		return;
+	}
+	w2.rx++;
+	if (e[0] & 1) {
+		w2.rx_bcast++;
+	}
+	type = (uint16_t)(e[12] << 8 | e[13]);
+	/* 46cn4e: rx classes, counted per second (w2_poll's DHCP-window line) */
+	if (memcmp(e, w2_bcast, 6) == 0) {
+		w2.c_bcast++;
+	} else if (e[0] & 1) {
+		w2.c_mcast++;
+	} else {
+		w2.c_ucast++;
+	}
+	if (type == 0x888e) {
+		w2.c_eapol++;
+	} else if (type == 0x0806) {
+		w2.c_arp++;
+	} else if (type == 0x0800 && len >= 14 + 20) {
+		w2.c_ip++;
+		if (e[14 + 9] == 17) {
+			uint32_t ihl = (e[14] & 15) * 4u;
+
+			w2.c_udp++;
+			if (len >= 14 + ihl + 4 && (e[14 + ihl + 3] == 68 || e[14 + ihl + 3] == 67)) {
+				w2.c_dhcp++;
+			}
+		}
+	} else {
+		w2.c_other++;
+	}
+	if (w2.st == W2_NET) {
+		hakios_iceland_net_rx(e, len);  /* w3-net: en0's, as it came */
+		return;
+	}
+	if (type == 0x0806 && len >= 14 + 28) {
+		const uint8_t *a = e + 14;
+		uint32_t spa = w2_get32(a + 14), tpa = w2_get32(a + 24);
+
+		w2.rx_arp++;
+		if (a[7] == 2 && w2.gw_ip && spa == w2.gw_ip && w2.st == 5) {
+			memcpy(w2.gw_mac, a + 8, 6);
+			w2_stage(9);
+			if (hakios_iceland_grp(0x10)) {
+				/* 46cn4g: a gratuitous ARP (who-has our own address) so the gateway and the AP learn us */
+				w2_arp_send(1, w2_bcast, w2.my_ip);
+				printf("icepcie: ath12k: 46cn4g W2 gratuitous ARP for x.x.x.%u sent at %llu ms\n", w2.my_ip & 0xff, lx_now_ms());
+			}
+			w2.st = 6;
+			w2.t = 0;
+		} else if (a[7] == 1 && w2.my_ip && tpa == w2.my_ip) {
+			w2_arp_send(2, a + 8, spa);    /* the gateway asks who we are before it answers a ping */
+		}
+		return;
+	}
+	if (type != 0x0800 || len < 14 + 20) {
+		return;
+	}
+	w2.rx_ip++;
+	{
+		const uint8_t *ip = e + 14;
+		uint32_t ihl = (ip[0] & 15) * 4u;
+
+		if (len < 14 + ihl + 8) {
+			return;
+		}
+		if (ip[9] == 17 && ip[ihl + 2] == 0 && ip[ihl + 3] == 68) {     /* UDP to port 68: DHCP */
+			const uint8_t *bp = ip + ihl + 8;
+			uint32_t blen = (uint32_t)(len - 14 - ihl - 8), o = 240, mt = 0, srv = 0, gw = 0, mask = 0, lease = 0;
+
+			if (blen < 244 || bp[0] != 2 || w2_get32(bp + 4) != w2.xid || w2_get32(bp + 236) != 0x63825363) {
+				return;
+			}
+			w2.rx_dhcp++;
+			while (o + 2 <= blen && bp[o] != 255) {
+				uint8_t t = bp[o], l;
+
+				if (t == 0) {
+					o++;
+					continue;
+				}
+				l = bp[o + 1];
+				if (o + 2 + l > blen) {
+					break;
+				}
+				if (t == 53 && l >= 1) {
+					mt = bp[o + 2];
+				} else if (t == 54 && l >= 4) {
+					srv = w2_get32(bp + o + 2);
+				} else if (t == 3 && l >= 4) {
+					gw = w2_get32(bp + o + 2);
+				} else if (t == 1 && l >= 4) {
+					mask = w2_get32(bp + o + 2);
+				} else if (t == 51 && l >= 4) {
+					lease = w2_get32(bp + o + 2);
+				}
+				o += 2u + l;
+			}
+			if (mt == 2 && w2.st == 3) {
+				w2.my_ip = w2_get32(bp + 16);
+				w2.srv_ip = srv;
+				printf("icepcie: ath12k: 46cn3a W2 DHCP OFFER: address x.x.x.%u from server x.x.x.%u at %llu ms\n",
+				    w2.my_ip & 0xff, srv & 0xff, lx_now_ms());
+				w2_stage(7);
+				w2.st = 4;
+				w2.tries = 0;
+				w2.t = 0;
+			} else if (mt == 5 && w2.st == 4) {
+				uint32_t p = 0;
+
+				for (uint32_t m = mask; m & 0x80000000u; m <<= 1) {
+					p++;
+				}
+				w2.my_ip = w2_get32(bp + 16);
+				w2.gw_ip = gw;
+				w2.prefix = p;
+				w2.lease = lease;
+				printf("icepcie: ath12k: 46cn3a W2 DHCP ACK: LEASE address x.x.x.%u, gateway x.x.x.%u, prefix /%u, lease %u s at %llu ms\n",
+				    w2.my_ip & 0xff, gw & 0xff, p, lease, lx_now_ms());
+				w2_stage(8);
+				w2.st = gw ? 5 : 7;
+				w2.tries = 0;
+				w2.t = 0;
+			} else if (mt == 6) {
+				printf("icepcie: ath12k: 46cn3a W2 DHCP NAK at %llu ms: DISCOVER again\n", lx_now_ms());
+				w2.st = 3;
+				w2.t = 0;
+			}
+			return;
+		}
+		if (ip[9] == 1 && w2.gw_ip && w2_get32(ip + 12) == w2.gw_ip) {
+			const uint8_t *ic = ip + ihl;
+
+			if (ic[0] == 0 && ic[4] == 0x3c && ic[5] == 0x0a) {
+				uint32_t seq = ic[7];
+				uint64_t rtt = seq >= 1 && seq <= 8 ? hakios_iceland_us() - w2.ping_at[seq - 1] : 0;
+
+				w2.ping_ok++;
+				printf("icepcie: ath12k: 46cn3a W2 PING reply %u from the gateway x.x.x.%u: rtt %llu.%03llu ms\n", seq,
+				    w2.gw_ip & 0xff, rtt / 1000, rtt % 1000);
+				w2_stage(10);
+			} else if (ic[0] == 8) {
+				/* the gateway pinging us: answered by nobody here, counted only */
+			}
+		}
+	}
+}
+
+static void
+w2_connect_done(int result)
+{
+	w2.connect_result = result;
+	printf("icepcie: ath12k: 46cn3a W2 join result %d (%s) at %llu ms\n", result,
+	    result == 0 ? "OK" : result == 1 ? "not found" : result == 2 ? "timeout" : result == 3 ? "rejected" :
+	    result == 4 ? "bad key" : result == 5 ? "unsupported" : "failed", lx_now_ms());
+	if (result == 0) {
+		struct nw_wifi_status s;
+
+		nw_wifi_status_get(&s);
+		memcpy(w2.mac, s.mac, 6);
+		w2.connected = 1;
+		w2_stage(6);
+		if (w2_net()) {
+			w2.st = W2_NET;
+			hakios_iceland_net_joined(s.mac);
+			printf("icepcie: ath12k: w3-net W2 the station is handed to en0 (icewifi_net=1): no in-kernel DHCP at %llu ms\n",
+			    lx_now_ms());
+			return;
+		}
+		w2.st = 3;
+		w2.t = 0;
+		w2.tries = 0;
+		w2.xid = (uint32_t)mach_absolute_time() ^ 0x4e3a0001u;
+	} else {
+		w2.st = 0;                      /* scan again, then try again (at most 3 joins) */
+		w2.t = lx_now_ms();
+		w2.scan_mark = nw_wifi_stats.scans;
+		(void)nw_wifi_scan(NULL, 0);
+	}
+}
+
+static void
+w2_link_lost(int reason)
+{
+	printf("icepcie: ath12k: 46cn3a W2 link lost (reason %d) at %llu ms\n", reason, lx_now_ms());
+	w2.connected = 0;
+	if (w2.st == W2_NET) {
+		hakios_iceland_net_lost();      /* w3-net: en0's link down; then a scan and the join again (w2_poll, case 0) */
+		w2.st = 0;
+		w2.t = lx_now_ms();
+		w2.scan_mark = nw_wifi_stats.scans;
+		(void)nw_wifi_scan(NULL, 0);
+	} else if (w2.st < 7) {
+		w2.st = 0;
+		w2.t = lx_now_ms();
+	}
+}
+
+static void
+w2_scan_done(void)
+{
+}
+
+/*
+ * w3-net, boot-arg icewifi_band=2 (2.4 GHz), 5 (5 GHz) or 0 (any band, the strongest): which band W2 prefers. Absent:
+ * 2 with icewifi_net=1 (run w3-net-3: 2462 MHz, DNS answers and TCP to the internet), else 0. Run w3-net-2 joined 5180 MHz (VHT, 80 MHz, -75 dBm) and its unicast frames were never acknowledged (TQM release
+ * reason CMD_REMOVE_TX 45, 0 on 2462 MHz in wifi-2 and w3-net-1): no DNS answer, while 2462 MHz worked. With the
+ * preference, three scans look for the asked band before any band is taken.
+ */
+static uint32_t
+w2_band(void)
+{
+	static uint32_t band;
+	static bool read;
+
+	if (!read) {
+		read = true;
+		if (!PE_parse_boot_argn("icewifi_band", &band, sizeof(band))) {
+			/* until 5 GHz transmission is understood, icewifi_net's join prefers 2.4 GHz (icewifi_band=0: any band) */
+			band = w2_net() ? 2 : 0;
+		} else if (band != 2 && band != 5) {
+			band = 0;
+		}
+		if (band != 0) {
+			printf("icepcie: ath12k: w3-net W2 icewifi_band=%u: the join prefers %s\n", band, band == 2 ? "2.4 GHz" : "5 GHz");
+		}
+	}
+	return band;
+}
+
+static bool
+w2_band_ok(uint32_t mhz)
+{
+	return w2_band() == 2 ? mhz >= 2400 && mhz < 2500 : w2_band() == 5 ? mhz >= 4900 && mhz < 5900 : true;
+}
+
+/* the join: a scanned network whose SSID hashes to a record of fw/wifi-pmk.bin */
+static void
+w2_join(void)
+{
+	uint64_t size = 0;
+	int disk = -1, best = -1, n = nw_wifi_bss_count(), rec = -1;
+	int8_t best_sig = -128;
+#if defined(XNU_TARGET_OS_OSX)
+	/* macOS has no md1: the same records come from the private build's pack (hakios_iceland_pcie.c), or not at all */
+	const uint8_t *d = hakios_iceland_wifi_blob("wifi-pmk.bin", &size);
+#else
+	const uint8_t *d = redwood_image_file("fw", "wifi-pmk.bin", &size, &disk);
+#endif
+	static struct nw_bss_info b;
+	char hex[65];
+
+	if (d == NULL || size < 36 || size % 36) {
+		printf("icepcie: ath12k: 46cn3a W2 STOP: fw/wifi-pmk.bin not in md1 (or not 36 B records)\n");
+		w2.st = 7;
+		return;
+	}
+	for (int pass = w2_band() ? 0 : 1; pass < 2 && best < 0; pass++) {
+		/* icewifi_band: pass 0 takes only the asked band; pass 1 (or no icewifi_band) any band */
+		for (int i = 0; i < n; i++) {
+			if (nw_wifi_bss_get(i, &b) != 0 || b.ssid_len == 0 || b.ssid_len > 32 ||
+			    (pass == 0 && !w2_band_ok(b.freq_mhz))) {
+				continue;
+			}
+			uint32_t h = w2_fnv(b.ssid, b.ssid_len);
+
+			for (uint64_t o = 0; o + 36 <= size; o += 36) {
+				uint32_t r = d[o] | (uint32_t)d[o + 1] << 8 | (uint32_t)d[o + 2] << 16 | (uint32_t)d[o + 3] << 24;
+
+				if (r == h && (best < 0 || b.signal_dbm > best_sig)) {
+					best = i;
+					best_sig = b.signal_dbm;
+					rec = (int)(o / 36);
+				}
+			}
+		}
+		if (pass == 0 && best < 0 && w2.scans_asked < 3) {
+			printf("icepcie: ath12k: w3-net W2 icewifi_band=%u: no network of the private list on that band among %d "
+			    "scanned (scan %u): scanning again\n", w2_band(), n, w2.scans_asked);
+			w2.scans_asked++;
+			w2.scan_mark = nw_wifi_stats.scans;
+			(void)nw_wifi_scan(NULL, 0);
+			w2.t = lx_now_ms();
+			return;
+		}
+	}
+	if (best < 0) {
+		printf("icepcie: ath12k: 46cn3a W2 no network of the private list among %d scanned (scan %u): scanning again\n", n,
+		    w2.scans_asked);
+		if (w2.scans_asked++ < 6) {
+			w2.scan_mark = nw_wifi_stats.scans;
+			(void)nw_wifi_scan(NULL, 0);
+		} else {
+			w2.st = 7;
+		}
+		w2.t = lx_now_ms();
+		return;
+	}
+	(void)nw_wifi_bss_get(best, &b);
+	for (int i = 0; i < 32; i++) {
+		static const char x[] = "0123456789abcdef";
+		uint8_t v = d[(uint64_t)rec * 36 + 4 + (uint64_t)i];
+
+		hex[2 * i] = x[v >> 4];
+		hex[2 * i + 1] = x[v & 15];
+	}
+	hex[64] = 0;
+	w2_stage(5);
+	printf("icepcie: ath12k: 46cn3a W2 joining network %d of the private list: %u MHz, signal %d dBm, %u networks seen (join %d)\n",
+	    rec + 1, b.freq_mhz, b.signal_dbm, n, w2.joins + 1);
+	w2.joins++;
+	w2.st = 1;
+	w2.t = lx_now_ms();
+	/* icewifi_band: the access point chosen here, not the driver's own pick of the strongest of that name (any band) */
+	(void)nw_wifi_connect(b.ssid, b.ssid_len, w2_band() ? b.bssid : NULL, hex, 64);
+	bzero(hex, sizeof(hex));
+	bzero(&b, sizeof(b));
+}
+
+static void
+w2_summary(const char *why)
+{
+	char tx[200];
+
+	tx[0] = 0;
+	if (nw_wifi_tx_reasons != NULL) {
+		nw_wifi_tx_reasons(tx, sizeof(tx));
+	}
+	printf("icepcie: ath12k: 46cn3a summary (%s): furthest stage %d (%s); driver stage %u, scans %u, networks %u, last error %d; "
+	    "joins %d (result %d); rx %u (IPv4 %u, ARP %u, broadcast %u, DHCP %u); tx %u queued, %u refused; ping %u of %u\n",
+	    why, w2.stage, w2_names[w2.stage], nw_wifi_stats.stage, nw_wifi_stats.scans, nw_wifi_stats.bss_seen,
+	    nw_wifi_stats.last_err, w2.joins, w2.connect_result, w2.rx, w2.rx_ip, w2.rx_arp, w2.rx_bcast, w2.rx_dhcp, w2.tx,
+	    w2.tx_fail, w2.ping_ok, w2.ping_sent);
+	printf("icepcie: ath12k: 46cn3a tx completions: %s\n", tx);
+}
+
+/* once per driver loop pass */
+static void
+w2_poll(void)
+{
+	uint64_t now = lx_now_ms();
+	uint32_t s = nw_wifi_stats.stage;
+
+	if (s >= 3) {
+		w2_stage(2);
+	}
+	if (s >= 4) {
+		w2_stage(3);
+	}
+	if (nw_wifi_stats.scans >= 1) {
+		w2_stage(4);
+	}
+	if (!hakios_iceland_peach(0x20) || w2.summary_done || w2_ios_owns()) {
+		return;
+	}
+	if (w2.st >= 1 && w2.st <= 6 && now - w2.sec_t >= 1000 && w2.sec_lines < 90) {
+		/* 46cn4e: from the join to the pings, once a second (at most 90 lines): rx by class, tx, the driver's tx
+		 * completion reasons (release source / status / queue manager) */
+		char tr[160];
+
+		tr[0] = 0;
+		if (nw_wifi_tx_reasons != NULL) {
+			nw_wifi_tx_reasons(tr, sizeof(tr));
+		}
+		printf("icepcie: ath12k: 46cn4e W2 second (st %d): rx ucast %u mcast %u bcast %u eapol %u arp %u ipv4 %u udp %u dhcp %u "
+		    "other %u; tx %u fail %u; frames %u beacons %u; tx completions: %s\n", w2.st, w2.c_ucast, w2.c_mcast, w2.c_bcast,
+		    w2.c_eapol, w2.c_arp, w2.c_ip, w2.c_udp, w2.c_dhcp, w2.c_other, w2.tx, w2.tx_fail, nw_wifi_stats.frames,
+		    nw_wifi_stats.beacons, tr);
+		w2.c_ucast = w2.c_mcast = w2.c_bcast = w2.c_eapol = w2.c_arp = w2.c_ip = w2.c_udp = w2.c_dhcp = w2.c_other = 0;
+		w2.sec_t = now;
+		w2.sec_lines++;
+	}
+	switch (w2.st) {
+	case 0:         /* waiting for a finished scan */
+		if (nw_wifi_stats.scans > w2.scan_mark && now - w2.t >= 1500 && w2.joins < (w2_net() ? 12 : 3)) {
+			w2_join();
+		}
+		break;
+	case 1:         /* the station joins; connect_done moves on */
+		if (now - w2.t > 30000) {
+			printf("icepcie: ath12k: 46cn3a W2 join gave no result in 30 s\n");
+			w2.st = 0;
+			w2.t = now;
+			w2.scan_mark = nw_wifi_stats.scans;
+			(void)nw_wifi_scan(NULL, 0);
+		}
+		break;
+	case 3:         /* DISCOVER */
+	case 4:         /* REQUEST */
+		if (w2.t == 0 || now - w2.t >= 3000) {
+			if (w2.tries++ >= 10) {
+				printf("icepcie: ath12k: 46cn3a W2 no DHCP %s after 10 tries\n", w2.st == 3 ? "OFFER" : "ACK");
+				w2.st = 7;
+				break;
+			}
+			w2_dhcp_send(w2.st == 3 ? 1 : 3);
+			w2.t = now;
+		}
+		break;
+	case 5:         /* ARP for the gateway */
+		if (w2.t == 0 || now - w2.t >= 1000) {
+			if (w2.tries++ >= 8) {
+				printf("icepcie: ath12k: 46cn3a W2 the gateway never answered ARP\n");
+				w2.st = 7;
+				break;
+			}
+			w2_arp_send(1, w2_bcast, w2.gw_ip);
+			w2.t = now;
+		}
+		break;
+	case 6:         /* five pings, one a second */
+		if (w2.t == 0 || now - w2.t >= 1000) {
+			if (w2.ping_sent >= 5) {
+				w2.st = 7;
+				break;
+			}
+			w2_ping_send();
+			w2.t = now;
+		}
+		break;
+	default:
+		break;
+	}
+	if (w2.st == 7 && !w2.summary_done) {
+		w2.summary_done = 1;
+		printf("icepcie: ath12k: 46cn3a %s\n", w2.ping_ok ? "PASS: lease + gateway ping" : "W2 ended before a gateway ping");
+		w2_summary("W2 done");
+	}
+}
+
+/* 46cn4a A1 / C: counters since the last summary, every 10 s (only the moving ones) */
+static void
+om_summary(void)
+{
+	static unsigned int ext[16], extp[16], extw[16], svc[16], rx[16], tx[16], calls[64], hist[6];
+	char b[400];
+	int o;
+
+	if (&nw_wifi_om_ext[0] == NULL || &nw_wifi_om_irq_calls[0] == NULL) {
+		return;
+	}
+	o = snprintf(b, sizeof(b), "ext-irq/poll/work by group:");
+	for (int g = 0; g < 16; g++) {
+		if (nw_wifi_om_ext[g] != ext[g] || nw_wifi_om_ext_poll[g] != extp[g]) {
+			o += snprintf(b + o, sizeof(b) - o, " g%d %u/%u/%u", g, nw_wifi_om_ext[g] - ext[g], nw_wifi_om_ext_poll[g] - extp[g],
+			    nw_wifi_om_ext_work[g] - extw[g]);
+		}
+		ext[g] = nw_wifi_om_ext[g];
+		extp[g] = nw_wifi_om_ext_poll[g];
+		extw[g] = nw_wifi_om_ext_work[g];
+	}
+	printf("icepcie: ath12k: 46cn4a 10s %s\n", b);
+	o = snprintf(b, sizeof(b), "ce service/rx/tx:");
+	for (int c = 0; c < 16; c++) {
+		if (nw_wifi_om_ce_svc[c] != svc[c]) {
+			o += snprintf(b + o, sizeof(b) - o, " ce%d %u/%u/%u", c, nw_wifi_om_ce_svc[c] - svc[c], nw_wifi_om_ce_rx[c] - rx[c],
+			    nw_wifi_om_ce_tx[c] - tx[c]);
+		}
+		svc[c] = nw_wifi_om_ce_svc[c];
+		rx[c] = nw_wifi_om_ce_rx[c];
+		tx[c] = nw_wifi_om_ce_tx[c];
+	}
+	printf("icepcie: ath12k: 46cn4a 10s %s\n", b);
+	o = snprintf(b, sizeof(b), "handler calls by vector:");
+	for (int i = 0; i < 64 && o < (int)sizeof(b) - 24; i++) {
+		if (nw_wifi_om_irq_calls[i] != calls[i]) {
+			o += snprintf(b + o, sizeof(b) - o, " %u%s %u", nw_wifi_om_irq_num[i], nw_wifi_om_irq_dp[i] ? "dp" : "",
+			    nw_wifi_om_irq_calls[i] - calls[i]);
+		}
+		calls[i] = nw_wifi_om_irq_calls[i];
+	}
+	printf("icepcie: ath12k: 46cn4a 10s %s\n", b);
+	printf("icepcie: ath12k: 46cn4a 10s step us <50 %u <200 %u <1000 %u <5000 %u <20000 %u more %u (max %llu); wmi cmds %u events %u "
+	    "quiet %u; log lines held back %u\n", nw_wifi_om_step_hist[0] - hist[0], nw_wifi_om_step_hist[1] - hist[1],
+	    nw_wifi_om_step_hist[2] - hist[2], nw_wifi_om_step_hist[3] - hist[3], nw_wifi_om_step_hist[4] - hist[4],
+	    nw_wifi_om_step_hist[5] - hist[5], nw_wifi_om_step_max, nw_wifi_om_cmds, nw_wifi_om_evts, nw_wifi_om_quiet, om_lim_total);
+	for (int i = 0; i < 6; i++) {
+		hist[i] = nw_wifi_om_step_hist[i];
+	}
+}
+
+static void
+om_timeline(const char *when)
+{
+	char b[400];
+	int o = 0, k = 0;
+
+	for (unsigned i = 0; i < OM_TL_N; i++) {
+		if (om_tl_ms[i] == 0) {
+			continue;
+		}
+		o += snprintf(b + o, sizeof(b) - o, " %s %llu", om_tl_pat[i].name, om_tl_ms[i]);
+		if (++k == 6) {
+			printf("icepcie: ath12k: 46cn4a timeline (%s, ms):%s\n", when, b);
+			o = k = 0;
+		}
+	}
+	if (k) {
+		printf("icepcie: ath12k: 46cn4a timeline (%s, ms):%s\n", when, b);
+	}
+	o = snprintf(b, sizeof(b), "station stages:");
+	for (int s = 1; s < (int)(sizeof(w2.stage_ms) / sizeof(w2.stage_ms[0])); s++) {
+		if (w2.stage_ms[s]) {
+			static const char *const sn[11] = { "", "drv", "radio", "iface", "scan", "found", "joined", "offer", "ack", "arp",
+				                            "ping" };
+			o += snprintf(b + o, sizeof(b) - o, " %d-%s %llu", s, sn[s], w2.stage_ms[s]);
+		}
+	}
+	printf("icepcie: ath12k: 46cn4a timeline (%s, ms): %s; never seen:%s%s%s%s\n", when, b,
+	    om_tl_ms[9] ? "" : " wmi-ready", om_tl_ms[12] ? "" : " first-scan", om_tl_ms[7] ? "" : " htt-connect-resp",
+	    om_tl_ms[1] ? "" : " mhi-mission");
+}
+
+/* ---- the driver: set up and pump ---- */
+static void
+iceland_ath12k_driver(void)
+{
+	static const struct lx_platform plat = {
+		lx_now_ms, lx_sleep_ms, lx_poll, lx_log, lx_halt, lx_alloc, lx_free,
+		lx_dma_alloc, lx_dma_free, lx_dma_map, lx_dma_sync, lx_fw_get,
+	};
+	static struct nw_board board;
+	uint32_t cap, guard;
+
+	if (nw_wifi_start == NULL) {
+		printf("icepcie: ath12k: the driver's object is not in this kernel (tools/mk-ath12k.sh)\n");
+		return;
+	}
+#if defined(XNU_TARGET_OS_OSX)
+	/* the live-block table and its sorted copy: without the table no DMA block is ever given back (om_take) */
+	if (om_h == NULL) {
+		om_h = kalloc_data(OM_H * sizeof(*om_h), Z_WAITOK | Z_ZERO);
+		om_sorted = kalloc_data(OM_H * sizeof(*om_sorted), Z_WAITOK | Z_ZERO);
+	}
+	if (om_h == NULL) {
+		printf("icepcie: ath12k: no memory for the DMA block table: not started\n");
+		return;
+	}
+#endif
+	/* wait for the harvest driver's link-up (iceland_ath12k_link, from its thread after the PCIe link is up) */
+	for (uint32_t waited = 0; iceland_ath12k_bar == 0 && waited < 120; waited++) {
+		IOSleep(1000);
+	}
+	if (iceland_ath12k_bar == 0 || iceland_ath12k_conf == 0) {
+		printf("icepcie: ath12k: the link never came up (icepcie_lx needs icewifi / icepcie in the same run)\n");
+		return;
+	}
+	/* the configuration-space capability list: the MSI capability (0x05) and the PCI Express capability (0x10) */
+	cap = *(volatile uint32_t *)(iceland_ath12k_conf + 0x34) & 0xff;
+	for (guard = 0; cap >= 0x40 && cap + 4 <= 0x1000 && guard < 48; guard++) {
+		uint32_t w = *(volatile uint32_t *)(iceland_ath12k_conf + cap);
+
+		if ((w & 0xff) == 0x05) {
+			board.msi_cap = (uint16_t)cap;
+		} else if ((w & 0xff) == 0x10) {
+			lx_cfg_pcie = (uint16_t)cap;
+		}
+		cap = (w >> 8) & 0xff;
+	}
+	board.bar = (void *)iceland_ath12k_bar;
+	board.bar_len = 0x200000;       /* 2 MB, the endpoint's BAR (matches the Fedora BAR 0 size) */
+	board.device_id = 0x110e;
+	board.irq_base = 1;
+	board.cfg_read = lx_cfg_read;
+	board.cfg_write = lx_cfg_write;
+	board.msi_target = lx_msi_target;
+	board.map_phys = lx_map_phys;
+	printf("icepcie: ath12k: start (BAR msi %#x pcie %#x, dma %u KB at %#llx)\n",
+	    board.msi_cap, lx_cfg_pcie, iceland_ath12k_dma_size >> 10, iceland_ath12k_dma_pa);
+	if (!ice_pcie_linkup()) {               /* 46cn3p: dadawifi_pcie, Fedora's link settings at link-up */
+		return;
+	}
+	ice_probe_start();                      /* 46cn3x: dadawifi_cfgprobe, read-only config-access probe */
+	(void)hakios_iceland_peach(0);          /* 46cn3a: the mask said once, before the driver asks */
+	(void)hakios_iceland_grp(0);            /* 46cn4g: the group-RX switches said once */
+#if !defined(XNU_TARGET_OS_OSX)
+	(void)om_stop_ms();
+#endif
+	if (nw_wifi_set_events != NULL && !w2_ios_owns()) {
+		static const struct nw_wifi_events ev = { w2_scan_done, w2_connect_done, w2_link_lost, w2_rx };
+
+		nw_wifi_set_events(&ev);
+	}
+	hakios_iceland_wlan_events();   /* K2: scan / join / link / frames to en0 and Apple80211 (before the start) */
+	(void)hakios_iceland_omni(0);           /* 46cn4a: the switches said once */
+	(void)hakios_iceland_poll_ms();
+	if (nw_wifi_start(&plat, &board) != 0) {
+		printf("icepcie: ath12k: start failed (stage %u, last error %d)\n",
+		    nw_wifi_stats.stage, nw_wifi_stats.last_err);
+		return;
+	}
+	w2_stage(1);
+	for (;;) {
+#if defined(XNU_TARGET_OS_OSX)
+		if (hakios_iceland_pcie_stopping()) {   /* the run's end (reset-after): stop cleanly, then the PCIe undo */
+			break;
+		}
+#else
+		if (lx_now_ms() >= om_stop_ms()) {     /* 46cn4g: 15 s before loader_return_after */
+			break;  /* the loader hard-resets back to Fedora at ~300 s; stop cleanly first */
+		}
+#endif
+		int moved = nw_wifi_step();
+
+		w2_poll();
+		hakios_iceland_wlan_poll();     /* K2: the station attached once the driver's interface is up */
+#if defined(XNU_TARGET_OS_OSX)
+		hakios_iceland_net_poll();      /* w3-net: what the join / the loss asked of en0's link, and en0's state */
+#endif
+		{
+			static uint64_t om_last;
+			static int om_mapped;
+			uint64_t t = lx_now_ms();
+
+			if (t - om_last >= 10000) {     /* 46cn4a: the counters every 10 s */
+				om_last = t;
+				if (hakios_iceland_omni(1)) {
+					om_summary();
+				}
+				om_dma_stats();         /* 46cn4e */
+			}
+			{
+				static int map120, mapout;
+
+				if (!map120 && t >= 120000) {
+					map120 = 1;
+					om_arena_map_why("at 120 s");
+				}
+				if (!mapout && om_dma_out_first) {
+					mapout = 1;
+					om_arena_map_why("at the first DMA out");
+				}
+				if (om_syserr_seen == 1) {
+					om_syserr_seen = 2;
+					wl_dump("first SYS_ERR / RDDM");
+				}
+			}
+			if (!om_mapped && &nw_wifi_om_ready_us != NULL && nw_wifi_om_ready_us != 0 && hakios_iceland_omni(0x40)) {
+				om_mapped = 1;
+				om_arena_map();         /* 46cn4a G2: once after WMI READY */
+			}
+		}
+		if (!moved) {
+			IOSleep(1);
+		}
+	}
+	if (!w2.summary_done) {
+		w2.summary_done = 1;
+		w2_summary("at 285 s");
+	}
+	om_lim_flush();
+	if (hakios_iceland_omni(1)) {
+		om_summary();
+	}
+	om_timeline("at 285 s");
+	om_dma_stats();
+	om_arena_map_why("at 285 s");
+	wl_dump("at 285 s");
+	hakios_iceland_wlan_stop();     /* K2: link down and the Apple80211 summary before the driver stops */
+#if defined(XNU_TARGET_OS_OSX)
+	hakios_iceland_net_stop();      /* w3-net: en0's link down before the station goes */
+#endif
+	nw_wifi_stop();
+	printf("icepcie: ath12k: stopped cleanly at ~%llu ms\n", lx_now_ms());
+}
+
+#if defined(XNU_TARGET_OS_OSX)
+/* macOS: one thread, the PCIe0 / WCN7860 bring-up (hakios_iceland_pcie.c) and then the driver on what it handed over */
+static void
+iceland_ath12k_macos(void)
+{
+	if (hakios_iceland_pcie_up()) {
+		iceland_ath12k_driver();
+	}
+	hakios_iceland_pcie_driver_done();
+}
+#endif
+
+/* ---- init, gated on icepcie_lx=1 (default off: nothing is mapped, allocated or started) ---- */
+void
+hakios_iceland_ath12k_init(void)
+{
+	uint32_t lx = 0;
+	thread_t thread;
+
+#if defined(XNU_TARGET_OS_OSX)
+	hakios_iceland_net_init();      /* w3-net: boot-arg icewifi_net (default off: returns at once); =2 needs no radio */
+#endif
+	if (!PE_parse_boot_argn("icepcie_lx", &lx, sizeof(lx)) || lx == 0) {
+		return;
+	}
+#if defined(XNU_TARGET_OS_OSX)
+	if (kernel_thread_start((thread_continue_t)iceland_ath12k_macos, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+#else
+	hakios_iceland_wlan_early();    /* K2 (icewifi_ios=1): en0 now, before iPadOS's Wi-Fi side looks for it */
+	if (kernel_thread_start((thread_continue_t)iceland_ath12k_driver, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+#endif
+}
diff --git a/bsd/dev/hakios_iceland_backlight.c b/bsd/dev/hakios_iceland_backlight.c
new file mode 100644
index 0000000000000000000000000000000000000000..773b895f4f5b119f211590ddab48cc83dd4ddb3c
--- /dev/null
+++ b/bsd/dev/hakios_iceland_backlight.c
@@ -0,0 +1,1116 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") backlight: two Kinetic KTZ8869 (master + slave, I2C address 0x11
+ * on two buses), the brightness only. Only with boot-arg icebl=N; without it nothing here touches the hardware.
+ *
+ * Every value is the Pad's own (q90t tree):
+ *   kaanapali-oneplus-iceland.dts  &i2c14 { backlight@11 "kinetic,ktz8869a" (master), enable-gpios <&tlmm 1> },
+ *                                  &i2c15 { backlight@11 "kinetic,ktz8869b" (slave) }
+ *   kaanapali.dtsi                 i2c14 = QUP3 SE1 (0x1984000), qup_i2c14_data_clk: SDA gpio8, SCL gpio9;
+ *                                  i2c15 = QUP3 SE2 (0x1988000), qup_i2c15_data_clk: SDA gpio12, SCL gpio13; 2 mA,
+ *                                  bias-pull-up; none in gpio-reserved-ranges
+ *   drivers/video/backlight/ktz8869_iceland.c  BL_BRT_LSB 0x04 = level & 0xf, BL_BRT_MSB 0x05 = level >> 4 (12-bit,
+ *                                  0..4095; stock's manual range ends at 3542, above is its sunlight boost;
+ *                                  default 1417), BACKLIGHT_ENABLE 0x01 = 1 on / 0 off, written to both ICs; DEVICE_ID
+ *                                  0x00. Everything else (the LCD bias, the strings, the boost) ABL has configured and
+ *                                  this driver never writes: the master's bias registers feed the panel.
+ *
+ * The bus: the four pins as GPIOs, I2C driven by hand (open drain: a line is pulled low by enabling the output at 0,
+ * released by disabling it; the internal pull-up as the DT has, plus the board's), ~100 kHz, clock stretching honoured.
+ * The QUP serial engines and their clocks are not touched. The enable line (gpio1) is left as ABL drives it.
+ *
+ *   icebl=1         read only: each IC's DEVICE_ID, BACKLIGHT_ENABLE and brightness registers
+ *   icebl=2         ... and from then on the brightness can be set: sysctl kern.icebl_level (0..icebl_max), 0 = the
+ *                   backlight off (BACKLIGHT_ENABLE 0; the panel keeps running), and the kernel function
+ *                   hakios_iceland_backlight_set() for a display driver; nothing is written until somebody sets it
+ *   icebl=3         ... and a test at the start: 1417 (stock's default), 400, 3000, 0 (off 1 s), back to what was found,
+ *                   2 s each, with a read-back after every write
+ *   icebl_max=N     the highest level accepted (default 3542, stock's manual range; at most 4095)
+ *   icebl_auto=1    ... and the level follows the ambient light (w4-auto, below; needs icebl=2 or 3)
+ *   icebl_auto_test=1  (with icebl_dry=1) a made-up light through the same entry, one PASS / FAIL line (w4-auto)
+ *
+ * w3-keys (macOS): the brightness as a control.
+ *   hakios_iceland_backlight_step(n)   n steps up (n > 0) or down a ladder of 13 levels, 200 .. 3542, each 1.27 times the
+ *                   one before (an even step for the eye); never off, never above icebl_max. For the HID keyboard's
+ *                   brightness keys (iokit/Native/IcelandHid/IcelandHidProbe.cpp, icebl_keys=1), UniXNU-piano's method
+ *                   (docs/drivers/backlight.md §5 at 613a209: the keys step the backlight in the kernel).
+ *   hakios_iceland_backlight_power()   (below, the display's off / on) is also the power key's light off and on again on
+ *                   macOS (IcelandHidProbe.cpp, icehid_power=4).
+ *   hakios_iceland_backlight_restore() the level and on/off state found at the start, written back if anything here
+ *                   changed them: the run's end (osfmk/arm64/loader_return.c).
+ *   icebl_dry=1     no hardware (QEMU): no pin is mapped or moved, the ICs are a model that holds what is written to it
+ *                   (found: on, 1417); everything above runs against it. With it the real ICs are never read or written.
+ *
+ * w4-auto (boot-arg icebl_auto=1, or kern.icebl_auto=1 at run time): the level follows the ambient light.
+ *   The light: the sensor hub's STK36C01 through the sensors client (hakios_iceland_sensors.c, icesns=1), which hands
+ *   every sample to hakios_iceland_backlight_lux(mlux, accuracy) on the DSP's pump thread. That side only drops the
+ *   sample into a ring of 5 and returns: no I2C, no icebl_lock (it is held across the bit-banged writes -- whole
+ *   milliseconds), nothing that sleeps, and a lock of its own (icebl_auto_lock) that is only ever held for a handful of
+ *   stores. Samples with accuracy < 2 or a negative value are dropped.
+ *   The work: one thread call every 250 ms (auto_tick, the fade's pattern). Per tick, if a sample came: the median of
+ *   the ring, filtered += (median - filtered) / 8 (the first sample sets it), the curve below (milli-lux to permille),
+ *   the user's offset, the ladder's own rungs (geometric, 200 at 4 % to icebl_max at 100 %), a hysteresis of 3 %
+ *   (30 permille) on the target, then one ramp step: at most 4 % of the level it is at, 4 counts at least -- so a
+ *   doubling takes 4.3 s and the whole 200 .. 3542 swing about 18 s.
+ *   Nothing is written while the light is off: hakios_iceland_backlight_power(0) leaves level_now 0 and the level in
+ *   level_kept, and the tick skips its write at 0 and picks up from level_kept when the light comes back.
+ *   The manual controls while it is on: hakios_iceland_backlight_step() moves a user offset of one ladder rung a press
+ *   (80 permille, -480 .. +480) instead of the level; a write to kern.icebl_level turns auto off first; the run's end
+ *   (hakios_iceland_backlight_restore) turns it off and stops the thread call before it puts anything back.
+ *   Lines "icebl: auto ...": on / off at each switch, and the target's moves, at most one every 5 s.
+ *   kern.icebl_auto (0 / 1, read and write), kern.icebl_auto_lux (the filtered light, milli-lux, 0: no sample yet),
+ *   kern.icebl_auto_target (the level the curve asks for now, 0: not evaluated yet).
+ *   icebl_auto_test=1 (with icebl_dry=1 only: on the Pad it would move the real light) runs the whole thing from a
+ *   made-up light: 6.5 lux for 8 s, 1234.5 lux for 12 s, 6.5 lux again for 12 s, then one sample of accuracy 0; the
+ *   level once a second, and one "icebl: auto test PASS|FAIL: ..." line with the numbers it checked.
+ * Lines go to the kernel log, prefixed "icebl:".
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+#define say(...) printf("icebl: " __VA_ARGS__)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+void hakios_iceland_backlight_init(void);
+int hakios_iceland_backlight_set(uint32_t level);
+void hakios_iceland_backlight_lux(int mlux, int accuracy);     /* w4-auto: from the DSP's pump thread */
+
+static vm_offset_t tlmm;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x10000UL               /* gpio0..15 */
+#define PIN_CTL(n)              (tlmm + 0x1000UL * (n))
+#define PIN_IO(n)               (tlmm + 0x1000UL * (n) + 4)
+#define CTL_OE                  (1u << 9)
+#define CTL_EGPIO_PRESENT       (1u << 11)
+#define CTL_EGPIO_ENABLE        (1u << 12)
+#define PULL_UP                 3
+
+#define KTZ_ADDR                0x11
+#define REG_DEVICE_ID           0x00
+#define REG_BL_ENABLE           0x01
+#define REG_BRT_LSB             0x04
+#define REG_BRT_MSB             0x05
+
+static const struct i2c_bus {
+	const char *name;
+	unsigned sda, scl;
+} buses[2] = { { "master (i2c14)", 8, 9 }, { "slave (i2c15)", 12, 13 } };
+
+static uint32_t found_ctl[2][2];
+static uint64_t quarter_ticks;          /* a quarter of a 100 kHz period, in timebase ticks */
+static uint32_t level_max = 3542, level_now, found_level;
+static bool ready, found_on;
+static bool dry;                        /* icebl_dry=1: a model instead of the ICs */
+static uint32_t writes, write_errors;   /* level writes since ready (each is both ICs) */
+
+static LCK_GRP_DECLARE(icebl_lck_grp, "icebl");
+static LCK_MTX_DECLARE(icebl_lock, &icebl_lck_grp);
+/* w4-auto: the pump thread's ring (a handful of stores, never held across an I2C write; see the state's comment) */
+static LCK_MTX_DECLARE(icebl_auto_lock, &icebl_lck_grp);
+
+static inline void
+quarter(void)
+{
+	uint64_t until = mach_absolute_time() + quarter_ticks;
+
+	while (mach_absolute_time() < until) {
+	}
+}
+
+/* open drain: low = output enabled at 0, high = released (input, pulled up) */
+static inline void
+line(unsigned pin, bool high)
+{
+	uint32_t v = rd(PIN_CTL(pin));
+
+	wr(PIN_CTL(pin), high ? v & ~CTL_OE : v | CTL_OE);
+	(void)rd(PIN_CTL(pin));
+}
+
+static inline bool
+level(unsigned pin)
+{
+	return rd(PIN_IO(pin)) & 1;
+}
+
+static bool
+scl_high(const struct i2c_bus *b)
+{
+	uint64_t limit, start = mach_absolute_time();
+
+	line(b->scl, true);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &limit);
+	while (!level(b->scl)) {                /* the slave may stretch the clock */
+		if (mach_absolute_time() - start > limit) {
+			return false;
+		}
+	}
+	quarter();
+	return true;
+}
+
+static void
+pins_setup(const struct i2c_bus *b, unsigned i)
+{
+	unsigned pins[2] = { b->sda, b->scl };
+
+	for (unsigned k = 0; k < 2; k++) {
+		uint32_t v;
+
+		found_ctl[i][k] = rd(PIN_CTL(pins[k]));
+		wr(PIN_IO(pins[k]), 0);                         /* the output value stays 0: only OE moves */
+		v = (found_ctl[i][k] & ~0x3ffu) | PULL_UP | (0u << 2) | ((2 / 2 - 1) << 6);
+		if (v & CTL_EGPIO_PRESENT) {
+			v |= CTL_EGPIO_ENABLE;
+		}
+		wr(PIN_CTL(pins[k]), v);                        /* function gpio, input (released), pull-up, 2 mA */
+	}
+}
+
+static void
+i2c_start(const struct i2c_bus *b)
+{
+	line(b->sda, true);
+	scl_high(b);
+	line(b->sda, false);
+	quarter();
+	line(b->scl, false);
+	quarter();
+}
+
+static void
+i2c_stop(const struct i2c_bus *b)
+{
+	line(b->sda, false);
+	quarter();
+	scl_high(b);
+	line(b->sda, true);
+	quarter();
+}
+
+/* a byte out; true if the slave acknowledged it */
+static bool
+i2c_out(const struct i2c_bus *b, uint8_t byte)
+{
+	bool ack;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		line(b->sda, (byte >> bit) & 1);
+		quarter();
+		if (!scl_high(b)) {
+			return false;
+		}
+		line(b->scl, false);
+		quarter();
+	}
+	line(b->sda, true);
+	quarter();
+	if (!scl_high(b)) {
+		return false;
+	}
+	ack = !level(b->sda);
+	line(b->scl, false);
+	quarter();
+	return ack;
+}
+
+static uint8_t
+i2c_in(const struct i2c_bus *b, bool ack)
+{
+	uint8_t byte = 0;
+
+	line(b->sda, true);
+	for (int bit = 7; bit >= 0; bit--) {
+		quarter();
+		scl_high(b);
+		byte = (uint8_t)(byte << 1 | level(b->sda));
+		line(b->scl, false);
+		quarter();
+	}
+	line(b->sda, !ack);
+	quarter();
+	scl_high(b);
+	line(b->scl, false);
+	quarter();
+	line(b->sda, true);
+	return byte;
+}
+
+static bool
+reg_write(const struct i2c_bus *b, uint8_t reg, uint8_t val)
+{
+	bool ok;
+
+	i2c_start(b);
+	ok = i2c_out(b, KTZ_ADDR << 1) && i2c_out(b, reg) && i2c_out(b, val);
+	i2c_stop(b);
+	return ok;
+}
+
+static bool
+reg_read(const struct i2c_bus *b, uint8_t reg, uint8_t *val)
+{
+	bool ok;
+
+	i2c_start(b);
+	ok = i2c_out(b, KTZ_ADDR << 1) && i2c_out(b, reg);
+	if (ok) {
+		i2c_start(b);                   /* repeated start */
+		ok = i2c_out(b, KTZ_ADDR << 1 | 1);
+		if (ok) {
+			*val = i2c_in(b, false);
+		}
+	}
+	i2c_stop(b);
+	return ok;
+}
+
+static bool
+ic_state(unsigned i, uint8_t *id, uint8_t *en, uint32_t *lvl)
+{
+	uint8_t lsb = 0, msb = 0;
+	bool ok = reg_read(&buses[i], REG_DEVICE_ID, id) && reg_read(&buses[i], REG_BL_ENABLE, en) &&
+	    reg_read(&buses[i], REG_BRT_LSB, &lsb) && reg_read(&buses[i], REG_BRT_MSB, &msb);
+
+	*lvl = (uint32_t)msb << 4 | (lsb & 0xf);
+	return ok;
+}
+
+/* with icebl_lock held; level 0 = off */
+static int
+set_locked(uint32_t lvl)
+{
+	bool ok = true;
+
+	if (lvl > level_max) {
+		lvl = level_max;
+	}
+	writes++;
+	for (unsigned i = 0; i < 2 && !dry; i++) {
+		ok &= reg_write(&buses[i], REG_BRT_LSB, lvl & 0xf);
+		ok &= reg_write(&buses[i], REG_BRT_MSB, (lvl >> 4) & 0xff);
+		ok &= reg_write(&buses[i], REG_BL_ENABLE, lvl ? 0x01 : 0x00);
+	}
+	level_now = lvl;
+	if (!ok) {
+		write_errors++;
+	}
+	return ok ? 0 : EIO;
+}
+
+/*
+ * w3-keys: the brightness keys' ladder. 200 * 1.2706^k, k = 0..12 (200 is 5 % of the 12-bit range; 3542 is the end of
+ * stock's manual range, icebl_max's default). All inside what hw-1 set and read back on the tablet (400 .. 3000) or
+ * stock's own range (1 .. 3542).
+ */
+static const uint16_t ladder[] = { 200, 254, 323, 410, 521, 662, 841, 1069, 1358, 1726, 2193, 2786, 3542 };
+#define LADDER_N        (sizeof(ladder) / sizeof(ladder[0]))
+
+/*
+ * w4-auto: the automatic brightness's state, its curve, and the arithmetic the tick and the self-test share (the
+ * feature itself is below, after hakios_iceland_backlight_power(); here only what hakios_iceland_backlight_step()
+ * looks at).
+ *
+ * The ring (mlux, n, next, fresh) is icebl_auto_lock's: the pump thread's side, written with a try lock and never
+ * holding it for more than a few stores. Everything else is icebl_lock's: the tick, the keys, the sysctls. No path
+ * holds both and waits for the other (auto_set_locked and the tests are the only places with both, always
+ * icebl_lock then icebl_auto_lock; the tick copies the ring out first and takes icebl_lock afterwards).
+ */
+#define AUTO_TICK_MS    250                     /* the thread call's period */
+#define AUTO_SAMPLES    5                       /* the ring: the median of at most this many */
+#define AUTO_STEP_PM    80                      /* one brightness-key press: one ladder rung, permille */
+#define AUTO_OFFSET_MAX 480                     /* the keys' reach either way, permille (six rungs) */
+#define AUTO_PM_MIN     40                      /* the curve's bottom, 4 % of full */
+#define AUTO_PM_MAX     1000
+#define AUTO_HYST       30                      /* a new target needs more than 3 % from the one now */
+#define AUTO_RAMP       25                      /* 1 / 25 of the level a tick: 4 % */
+#define AUTO_RAMP_MIN   4                       /* ... and at least this many counts */
+#define AUTO_SAID_MS    5000                    /* at most one "the target moved" line this often */
+#define AUTO_SETTLE     32                      /* the self-test: at most this many ticks after a phase, for the ramp */
+
+/*
+ * Milli-lux to permille of full brightness, piecewise linear between the points. The two ends are UniXNU-piano's
+ * SensorsPolicy curve (0 lux 4 %, 10000 lux 100 %; docs/drivers/sensors.md at 613a209); the seven points between are
+ * this driver's first guess -- the Pad's panel has not been measured -- so they are the first thing to tune.
+ */
+static const struct {
+	int mlux, permille;
+} lux_curve[] = {
+	{        0,   40 }, {     5000,   90 }, {    20000,  160 }, {    50000,  240 }, {   100000,  320 },
+	{   300000,  470 }, {  1000000,  660 }, {  3000000,  850 }, { 10000000, 1000 },
+};
+#define LUX_CURVE_N     (sizeof(lux_curve) / sizeof(lux_curve[0]))
+
+static struct {
+	int mlux[AUTO_SAMPLES];         /* the ring's samples, milli-lux */
+	uint8_t n, next;                /* how many of them are valid, where the next one goes */
+	uint8_t fresh, valid, force;    /* a sample came since the last tick; filtered has a value; no hysteresis once */
+	int filtered;                   /* the exponential average, milli-lux */
+	int offset;                     /* the brightness keys, permille */
+	int permille;                   /* the permille behind target */
+	int target;                     /* the level the curve asks for now */
+	uint32_t evals;                 /* ticks that did the work (the self-test's ramp check) */
+	uint32_t errors;                /* writes that failed since auto came on */
+	uint64_t said_at;               /* when the last "the target moved" line was said */
+} ab;
+static volatile bool auto_on;           /* read without the lock on the pump thread: a stale 1 costs one sample */
+static bool auto_want, auto_test;       /* boot-args icebl_auto=1, icebl_auto_test=1 (with icebl_dry=1) */
+static thread_call_t auto_call;
+
+static void auto_tick(thread_call_param_t p0, thread_call_param_t p1);
+static void auto_set(bool on, const char *why);
+static void auto_set_locked(bool on, const char *why);
+
+/* the curve, clamped at both ends: milli-lux in, permille out */
+static int
+lux_permille(int mlux)
+{
+	unsigned i;
+
+	if (mlux <= lux_curve[0].mlux) {
+		return lux_curve[0].permille;
+	}
+	for (i = 1; i < LUX_CURVE_N; i++) {
+		if (mlux < lux_curve[i].mlux) {
+			int a = lux_curve[i - 1].permille, b = lux_curve[i].permille;
+			int width = lux_curve[i].mlux - lux_curve[i - 1].mlux;
+
+			return a + (b - a) * (mlux - lux_curve[i - 1].mlux) / width;
+		}
+	}
+	return lux_curve[LUX_CURVE_N - 1].permille;
+}
+
+/* the curve and the user's offset, 40 .. 1000 permille */
+static int
+auto_permille(int mlux, int offset)
+{
+	int pm = lux_permille(mlux) + offset;
+
+	return pm < AUTO_PM_MIN ? AUTO_PM_MIN : pm > AUTO_PM_MAX ? AUTO_PM_MAX : pm;
+}
+
+/*
+ * Permille to a level on the ladder's own rungs: 12 equal geometric steps, so 40 permille is rung 0 (200) and 1000 is
+ * rung 12 (3542); linear between two rungs, in sixteenths of a rung. Never above icebl_max (with icebl_max above the
+ * ladder's top the curve still ends there: the top rung is the table's).
+ */
+static uint32_t
+permille_level(int permille)
+{
+	unsigned u, i, f;
+	uint32_t lvl;
+
+	if (permille <= AUTO_PM_MIN) {
+		return (uint32_t)ladder[0] > level_max ? level_max : ladder[0];
+	}
+	if (permille > AUTO_PM_MAX) {
+		permille = AUTO_PM_MAX;
+	}
+	u = (unsigned)(permille - AUTO_PM_MIN) * 12u * 16u / 960u;      /* 0 .. 192: rung * 16 + fraction */
+	i = u / 16u;
+	f = u % 16u;
+	if (i >= LADDER_N - 1) {
+		lvl = ladder[LADDER_N - 1];
+	} else {
+		lvl = ladder[i] + (uint32_t)(ladder[i + 1] - ladder[i]) * f / 16u;
+	}
+	return lvl > level_max ? level_max : lvl;
+}
+
+/* one ramp step from where the level is: 4 % of it a tick, 4 counts at least */
+static uint32_t
+ramp_from(uint32_t from)
+{
+	uint32_t step = from / AUTO_RAMP;
+
+	return step < AUTO_RAMP_MIN ? AUTO_RAMP_MIN : step;
+}
+
+/* the furthest ticks ramp steps from from could climb (the self-test's bound; a handful of ticks is all it sees) */
+static uint32_t
+ramp_bound(uint32_t from, uint32_t ticks)
+{
+	for (uint32_t k = 0; k < ticks && k < 8; k++) {
+		from += ramp_from(from);
+	}
+	return from;
+}
+
+int hakios_iceland_backlight_step(int steps);
+int hakios_iceland_backlight_restore(void);
+
+/* n steps up or down the ladder from where the light is (off: from the level kept); the level set, or -errno */
+int
+hakios_iceland_backlight_step(int steps)
+{
+	uint32_t from, to;
+	int at = 0, error, asked = steps;
+
+	if (!ready) {
+		return -ENODEV;
+	}
+	lck_mtx_lock(&icebl_lock);
+	if (auto_on) {                          /* w4-auto: the keys move the offset, the curve the level */
+		int offset = ab.offset + steps * AUTO_STEP_PM;
+
+		offset = offset < -AUTO_OFFSET_MAX ? -AUTO_OFFSET_MAX : offset > AUTO_OFFSET_MAX ? AUTO_OFFSET_MAX : offset;
+		ab.offset = offset;
+		ab.force = 1;                   /* the next tick looks again at once: no hysteresis this once */
+		to = level_now;
+		lck_mtx_unlock(&icebl_lock);
+		say("step %+d: auto on: offset %+d permille (%+d rungs); level %u is the curve's\n", asked, offset,
+		    offset / AUTO_STEP_PM, to);
+		return (int)to;
+	}
+	from = level_now != 0 ? level_now : (found_level != 0 ? found_level : 1417);
+	/* the rung at or just under the level now; a step up from between two rungs lands on the upper one */
+	for (unsigned i = 0; i < LADDER_N; i++) {
+		if (ladder[i] <= from) {
+			at = (int)i;
+		}
+	}
+	if (steps < 0 && from > ladder[at]) {
+		steps++;                        /* down from between two rungs: the lower one is the first step */
+	}
+	at += steps;
+	at = at < 0 ? 0 : at >= (int)LADDER_N ? (int)LADDER_N - 1 : at;
+	to = ladder[at] > level_max ? level_max : ladder[at];
+	error = to == level_now ? 0 : set_locked(to);
+	lck_mtx_unlock(&icebl_lock);
+	say("step %+d: level %u -> %u (rung %d of %u)%s\n", asked, from, to, at + 1, (unsigned)LADDER_N, error ? ": WRITE FAILED" : "");
+	return error ? -error : (int)to;
+}
+
+/* the run's end: what was found at the start, if this driver wrote anything since */
+int
+hakios_iceland_backlight_restore(void)
+{
+	uint32_t want;
+	int error = 0;
+
+	if (!ready) {
+		return ENODEV;
+	}
+	auto_set(false, "the run's end");       /* w4-auto: off, and a tick still queued goes */
+	lck_mtx_lock(&icebl_lock);
+	want = found_on ? found_level : 0;
+	if (writes != 0 && level_now != want) {
+		error = set_locked(want);
+		say("the run's end: level back to %u as found (%d); %u writes, %u failed\n", want, error, writes, write_errors);
+	} else {
+		say("the run's end: level %u as found, nothing to put back; %u writes, %u failed\n", level_now, writes, write_errors);
+	}
+	lck_mtx_unlock(&icebl_lock);
+	return error;
+}
+
+int
+hakios_iceland_backlight_set(uint32_t lvl)
+{
+	int error;
+
+	if (!ready) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&icebl_lock);
+	error = set_locked(lvl);
+	lck_mtx_unlock(&icebl_lock);
+	return error;
+}
+
+/* the level set now (0 before icebl>=2 found the ICs); for iokit/Kernel/HakiosIcelandBacklightUI.cpp (icebl_ui=1) */
+uint32_t hakios_iceland_backlight_level(void);
+uint32_t
+hakios_iceland_backlight_level(void)
+{
+	return ready ? level_now : 0;
+}
+
+/*
+ * For the display's power requests (MiniIOMobileFramebuffer, selector 12): off = the backlight off, the level kept;
+ * on = the kept level back. ENODEV unless icebl>=2 found the ICs.
+ *
+ * 25ap1, boot-arg icebl_fade=MS (100..1000; 0 / absent = off): "off" fades the light out over MS ms in 16 steps on a
+ * thread call instead of cutting it, and returns at once - so with 25hot1's fb_panelpower=1 (display-off right after
+ * this call) the picture goes black at once and the light fades behind it, apollo's order; "on" stops a fade still
+ * running and puts the kept level back. Lines "icebl: fade ...". After aTechGeekDev/ios-apollo c0b4400
+ * xnu/patches/0149-apollo-fb-blank-not-fade.patch and 0151-apollo-backlight-fade-cpumask.patch (MIT; written here).
+ */
+static uint32_t level_kept;
+static uint32_t fade_ms, fade_from;
+static volatile uint32_t fade_gen;
+static thread_call_t fade_call;
+
+static void
+fade_step(thread_call_param_t p0 __unused, thread_call_param_t p1)
+{
+	uint32_t gen = (uint32_t)(uintptr_t)p1, from = fade_from, last = from;
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	for (uint32_t s = 1; s <= 16; s++) {
+		delay_for_interval(fade_ms / 16, NSEC_PER_MSEC);
+		lck_mtx_lock(&icebl_lock);
+		if (fade_gen != gen) {
+			lck_mtx_unlock(&icebl_lock);
+			say("fade: stopped at step %u (level %u): the display came back on\n", s, last);
+			return;
+		}
+		last = from * (16 - s) / 16;
+		(void)set_locked(last);
+		lck_mtx_unlock(&icebl_lock);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	say("fade: from %u to 0 in %llu ms\n", from, ns / NSEC_PER_MSEC);
+}
+
+int hakios_iceland_backlight_power(int on);
+
+int
+hakios_iceland_backlight_power(int on)
+{
+	int error;
+
+	if (!ready) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&icebl_lock);
+	if (fade_ms != 0 && fade_call != NULL) {        /* 25ap1 */
+		fade_gen++;                             /* a fade still running stops at its next step */
+		if (!on) {
+			if (level_now != 0) {
+				level_kept = level_now;
+			}
+			fade_from = level_now;
+			error = 0;
+			if (level_now != 0) {
+				thread_call_enter1(fade_call, (thread_call_param_t)(uintptr_t)fade_gen);
+			}
+		} else {
+			error = set_locked(level_kept != 0 ? level_kept : (level_now != 0 ? level_now : 1417));
+		}
+		lck_mtx_unlock(&icebl_lock);
+		say("power %s: level %u, fade %u ms (%d)\n", on ? "on" : "off", on ? level_now : fade_from, fade_ms, error);
+		return error;
+	}
+	if (!on) {
+		if (level_now != 0) {
+			level_kept = level_now;
+		}
+		error = set_locked(0);
+	} else {
+		error = set_locked(level_now != 0 ? level_now : (level_kept != 0 ? level_kept : 1417));
+	}
+	lck_mtx_unlock(&icebl_lock);
+	say("power %s: level %u (%d)\n", on ? "on" : "off", level_now, error);
+	return error;
+}
+
+/*
+ * ---- w4-auto: the level follows the ambient light ----------------------------------------------------------------
+ * The switch, with icebl_lock held. "on" empties the ring, so nothing is written until the light is known. "off" stops
+ * a tick still queued; a tick running at it is inside this same lock, so it finishes its one write (a few
+ * milliseconds) and then sees auto_on false and does not arm again -- which is what keeps the thread call from being
+ * left armed.
+ */
+static void
+auto_set_locked(bool on, const char *why)
+{
+	uint64_t deadline;
+
+	if (!on) {
+		if (!auto_on) {
+			return;
+		}
+		auto_on = false;
+		if (auto_call != NULL) {
+			thread_call_cancel(auto_call);
+		}
+		say("auto: off (%s): level %u, offset %+d, %u write%s failed\n", why, level_now, ab.offset, ab.errors,
+		    ab.errors == 1 ? "" : "s");
+		return;
+	}
+	if (auto_on) {
+		return;
+	}
+	if (auto_call == NULL) {
+		say("auto: on (%s) refused: no thread call\n", why);
+		return;
+	}
+	lck_mtx_lock(&icebl_auto_lock);
+	ab.n = 0;
+	ab.next = 0;
+	ab.fresh = 0;
+	ab.valid = 0;
+	ab.force = 0;
+	ab.filtered = 0;
+	lck_mtx_unlock(&icebl_auto_lock);
+	ab.offset = 0;
+	ab.permille = 0;
+	ab.target = 0;
+	ab.errors = 0;
+	ab.said_at = 0;
+	auto_on = true;
+	clock_interval_to_deadline(AUTO_TICK_MS, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(auto_call, deadline);
+	say("auto: on (%s): %u ms a tick, the median of %u samples, the curve from 40 permille, offset 0\n", why,
+	    (unsigned)AUTO_TICK_MS, (unsigned)AUTO_SAMPLES);
+}
+
+static void
+auto_set(bool on, const char *why)
+{
+	lck_mtx_lock(&icebl_lock);
+	auto_set_locked(on, why);
+	lck_mtx_unlock(&icebl_lock);
+}
+
+/*
+ * The tick, every 250 ms while auto is on. The ring is copied out under its own lock first, then everything else
+ * happens under icebl_lock -- the one the bit-banged write needs anyway, so a tick's write and a key's are never at
+ * once.
+ */
+static void
+auto_tick(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	int s[AUTO_SAMPLES], median, want, error;
+	uint32_t n, i, j, now, step;
+	bool fresh, forced;
+	uint64_t deadline, said_every;
+
+	lck_mtx_lock(&icebl_auto_lock);
+	n = ab.n;
+	for (i = 0; i < n; i++) {
+		s[i] = ab.mlux[i];
+	}
+	fresh = ab.fresh != 0;
+	ab.fresh = 0;
+	lck_mtx_unlock(&icebl_auto_lock);
+
+	lck_mtx_lock(&icebl_lock);
+	if (!auto_on || !ready) {
+		lck_mtx_unlock(&icebl_lock);
+		return;                         /* no arm: the switch said off */
+	}
+	ab.evals++;                             /* the ramp runs on every tick: this is what it may move by */
+	if (n != 0 && fresh) {
+		for (i = 1; i < n; i++) {               /* an insertion sort of at most five */
+			for (j = i; j > 0 && s[j - 1] > s[j]; j--) {
+				int t = s[j - 1];
+
+				s[j - 1] = s[j];
+				s[j] = t;
+			}
+		}
+		median = s[n / 2];
+		if (!ab.valid) {
+			ab.filtered = median;           /* the first sample is the average */
+			ab.valid = 1;
+		} else {
+			ab.filtered += (median - ab.filtered) / 8;
+		}
+	}
+	forced = ab.force != 0;
+	ab.force = 0;
+	if (ab.valid) {                         /* a sample has been filtered: the curve, the offset, the hysteresis */
+		want = auto_permille(ab.filtered, ab.offset);
+		if (forced || ab.target == 0 || want > ab.permille + AUTO_HYST || want < ab.permille - AUTO_HYST) {
+			int was = ab.target;
+
+			ab.permille = want;
+			ab.target = (int)permille_level(want);
+			nanoseconds_to_absolutetime((uint64_t)AUTO_SAID_MS * NSEC_PER_MSEC, &said_every);
+			if (mach_absolute_time() - ab.said_at >= said_every) {
+				ab.said_at = mach_absolute_time();
+				say("auto: %d.%03d lux -> %d.%d %%, level %d (was %d), offset %+d\n", ab.filtered / 1000,
+				    ab.filtered % 1000, want / 10, want % 10, ab.target, was, ab.offset);
+			}
+		}
+	}
+	/*
+	 * The ramp. level_now 0 is the light off -- hakios_iceland_backlight_power(0) left the level to come back to in
+	 * level_kept; nothing is written then, and when the light comes back the ramp carries on from there.
+	 */
+	now = level_now;
+	if (now != 0 && ab.target != 0 && (uint32_t)ab.target != now) {
+		uint32_t to = (uint32_t)ab.target;
+
+		step = ramp_from(now);
+		if (to > now) {
+			now = to - now <= step ? to : now + step;
+		} else {
+			now = now - to <= step ? to : now - step;
+		}
+		error = set_locked(now);
+		if (error != 0) {
+			ab.errors++;
+			if (ab.errors == 1) {
+				say("auto: a write failed (%d): counted, said once (the count is in the off line)\n", error);
+			}
+		}
+	}
+	if (auto_on) {
+		clock_interval_to_deadline(AUTO_TICK_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(auto_call, deadline);
+	}
+	lck_mtx_unlock(&icebl_lock);
+}
+
+/*
+ * The light, from the DSP's pump thread (hakios_iceland_sensors.c), about four times a second. It must not sleep, must
+ * not touch the bus and must not wait for icebl_lock (held across the bit-banged writes), so: the cheap checks, then
+ * a try lock on the ring's own mutex, a few stores, and back. If a tick holds the ring the sample is dropped -- the
+ * next one is 250 ms away.
+ */
+void
+hakios_iceland_backlight_lux(int mlux, int accuracy)
+{
+	if (!auto_on || !ready || accuracy < 2 || mlux < 0) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&icebl_auto_lock)) {
+		return;
+	}
+	ab.mlux[ab.next] = mlux;
+	ab.next = (uint8_t)((ab.next + 1) % AUTO_SAMPLES);
+	if (ab.n < AUTO_SAMPLES) {
+		ab.n++;
+	}
+	ab.fresh = 1;
+	lck_mtx_unlock(&icebl_auto_lock);
+}
+
+/* the level, the filtered light, the target and the tick count at once (the self-test's reads) */
+static void
+auto_read(uint32_t *lvl, int *filtered, int *target, int *permille, uint32_t *evals)
+{
+	lck_mtx_lock(&icebl_lock);
+	*lvl = level_now;
+	*filtered = ab.filtered;
+	*target = ab.target;
+	*permille = ab.permille;
+	*evals = ab.evals;
+	lck_mtx_unlock(&icebl_lock);
+}
+
+/* within pct % of want (the self-test's tolerances) */
+static bool
+auto_near(int have, int want, int pct)
+{
+	int diff = have > want ? have - want : want - have;
+
+	return diff * 100 <= want * pct;
+}
+
+/*
+ * A phase's check: the level at the curve's answer for that light, within pct % -- or, since the target may by design
+ * sit up to one hysteresis step (30 permille) short of the curve's permille, the level at that target.
+ */
+static bool
+auto_ok(int lvl, int curve_level, int pct, int target_level, int target_pm, int curve_pm)
+{
+	if (auto_near(lvl, curve_level, pct)) {
+		return true;
+	}
+	return lvl == target_level && curve_pm - target_pm <= AUTO_HYST && target_pm - curve_pm <= AUTO_HYST;
+}
+
+/*
+ * icebl_auto_test=1 (with icebl_dry=1): a made-up light through the same entry the pump thread uses, so the curve, the
+ * filter, the hysteresis, the ramp and the write all run, without a DSP. The level starts at the ladder's bottom (200)
+ * rather than where the model found it (1417): the ramp's 4 % a tick needs 45 ticks (11.25 s) to come down to 237 and
+ * phase 1 is 8 s long, so from 1417 the first check could only fail.
+ * Each phase is as long as it says, but its check is taken when the ramp has arrived (at most AUTO_SETTLE ticks more):
+ * phase 2's swing (237 -> 1358) is 46 ticks of pure geometric travel, and 12 s holds only 48. One line a second while
+ * it runs, one at the end.
+ */
+static void
+auto_test_thread(void *parameter __unused, __unused wait_result_t result)
+{
+	static const int test_mlux[3] = { 6500, 1234500, 6500 };
+	int filtered = 0, target = 0, permille = 0, curve_pm, curve_level;
+	int at[3] = { 0, 0, 0 }, settled[3] = { 0, 0, 0 }, bad_target = 0, bad_target2 = 0;
+	uint32_t phase, i, samples, secs, lvl = 0, prev, ticks = 0, last = 0, climb = 0, down = 0, extra = 0;
+	uint32_t bad_lvl = 0, bad_lvl2 = 0;
+	uint64_t t0, ns;
+	bool ok, pass[3] = { false, false, false };
+
+	(void)hakios_iceland_backlight_set(ladder[0]);
+	delay_for_interval(AUTO_TICK_MS, NSEC_PER_MSEC);
+	prev = ladder[0];
+	t0 = mach_absolute_time();
+	say("auto test: from level %u: %d.%03d lux 8 s, %d.%03d lux 12 s, %d.%03d lux 12 s, then accuracy 0\n", prev,
+	    test_mlux[0] / 1000, test_mlux[0] % 1000, test_mlux[1] / 1000, test_mlux[1] % 1000, test_mlux[2] / 1000,
+	    test_mlux[2] % 1000);
+	for (phase = 0; phase < 3; phase++) {
+		curve_pm = auto_permille(test_mlux[phase], 0);
+		curve_level = (int)permille_level(curve_pm);
+		samples = (phase == 0 ? 8u : 12u) * 1000u / AUTO_TICK_MS;
+		extra = 0;
+		for (i = 0; i < samples + AUTO_SETTLE; i++) {
+			hakios_iceland_backlight_lux(test_mlux[phase], 3);
+			delay_for_interval(AUTO_TICK_MS, NSEC_PER_MSEC);
+			auto_read(&lvl, &filtered, &target, &permille, &ticks);
+			if (phase == 1) {               /* the ramp's law, and not a step back down */
+				if (lvl > ramp_bound(prev, ticks - last)) {
+					climb++;
+				}
+				if (lvl < prev) {
+					down++;
+				}
+			}
+			prev = lvl;
+			last = ticks;
+			if ((i + 1) % (1000 / AUTO_TICK_MS) == 0) {
+				absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+				secs = (uint32_t)(ns / NSEC_PER_SEC);
+				say("auto test: t %u s, %d.%03d lux in, filtered %d.%03d, target %d, level %u\n", secs,
+				    test_mlux[phase] / 1000, test_mlux[phase] % 1000, filtered / 1000, filtered % 1000, target,
+				    lvl);
+			}
+			if (i + 1 >= samples && auto_ok((int)lvl, curve_level, phase == 0 ? 3 : 5, target, permille,
+			    curve_pm)) {
+				extra = i + 1 - samples;
+				break;
+			}
+		}
+		at[phase] = (int)lvl;
+		settled[phase] = (int)extra;
+		pass[phase] = auto_ok(at[phase], curve_level, phase == 0 ? 3 : 5, target, permille, curve_pm);
+	}
+	auto_read(&bad_lvl, &filtered, &bad_target, &permille, &ticks);
+	hakios_iceland_backlight_lux(50000000, 0);              /* accuracy 0: dropped before the ring */
+	delay_for_interval(4 * AUTO_TICK_MS, NSEC_PER_MSEC);
+	auto_read(&bad_lvl2, &filtered, &bad_target2, &permille, &ticks);
+	curve_pm = auto_permille(test_mlux[0], 0);
+	curve_level = (int)permille_level(curve_pm);
+	ok = pass[0] && pass[1] && pass[2] && climb == 0 && down == 0 && bad_lvl2 == bad_lvl && bad_target2 == bad_target;
+	say("auto test %s: 8 s level %d (the curve %d, +-3 %%, +%d ticks), ramps over the bound %u, down %u, 20 s level %d "
+	    "(the curve %d, +-5 %%, +%d ticks), 32 s level %d (the curve %d, +-5 %%, +%d ticks), the accuracy-0 sample: "
+	    "level %u -> %u, target %d -> %d\n", ok ? "PASS" : "FAIL", at[0], curve_level, settled[0], climb, down, at[1],
+	    (int)permille_level(auto_permille(test_mlux[1], 0)), settled[1], at[2], curve_level, settled[2], bad_lvl,
+	    bad_lvl2, bad_target, bad_target2);
+}
+
+/* the driver is ready: the two boot-args get their say (icebl_auto_test=1 only with icebl_dry=1: it moves the light) */
+static void
+auto_start(void)
+{
+	thread_t thread;
+
+	if (!ready) {
+		return;
+	}
+	if (auto_test) {
+		auto_set(true, "icebl_auto_test=1");
+		if (kernel_thread_start(auto_test_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	} else if (auto_want) {
+		auto_set(true, "icebl_auto=1");
+	}
+}
+
+static int
+sysctl_icebl_auto SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = auto_on ? 1 : 0, error, changed = 0;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value != 0 && value != 1) {
+		return EINVAL;
+	}
+	if (!ready) {
+		return ENODEV;
+	}
+	auto_set(value != 0, "kern.icebl_auto was written");
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, icebl_auto, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_ANYBODY, NULL, 0,
+    sysctl_icebl_auto, "I", "the Pad 4's backlight follows the ambient light, 1 = on (icebl_auto=1)");
+SYSCTL_INT(_kern, OID_AUTO, icebl_auto_lux, CTLFLAG_RD | CTLFLAG_LOCKED, &ab.filtered, 0,
+    "the Pad 4's filtered ambient light for the automatic backlight, milli-lux (0: no sample yet)");
+SYSCTL_INT(_kern, OID_AUTO, icebl_auto_target, CTLFLAG_RD | CTLFLAG_LOCKED, &ab.target, 0,
+    "the level the automatic backlight's curve asks for now (0: not evaluated yet)");
+
+static int
+sysctl_icebl_level SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = (int)level_now, error, changed = 0;
+
+	error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (value < 0) {
+		return EINVAL;
+	}
+	auto_set(false, "kern.icebl_level was written");        /* w4-auto: the level asked for by hand wins */
+	return hakios_iceland_backlight_set((uint32_t)value);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, icebl_level, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_ANYBODY, NULL, 0,
+    sysctl_icebl_level, "I", "the Pad 4's backlight level, 0 (off) .. icebl_max (icebl=2)");
+
+static void
+report(const char *when)
+{
+	for (unsigned i = 0; i < 2; i++) {
+		uint8_t id = 0, en = 0;
+		uint32_t lvl = 0;
+
+		if (ic_state(i, &id, &en, &lvl)) {
+			say("%s: %s: DEVICE_ID %#x, BACKLIGHT_ENABLE %#x, level %u\n", when, buses[i].name, id, en, lvl);
+		} else {
+			say("%s: %s: no acknowledge from 0x11 (SDA %u, SCL %u)\n", when, buses[i].name, level(buses[i].sda),
+			    level(buses[i].scl));
+		}
+	}
+}
+
+static void
+icebl_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)parameter;
+	uint8_t id, en;
+	uint32_t lvl;
+	bool any = false;
+
+	nanoseconds_to_absolutetime(2500, &quarter_ticks);      /* 2.5 us: 100 kHz */
+	if (quarter_ticks == 0) {
+		quarter_ticks = 1;
+	}
+	PE_parse_boot_argn("icebl_max", &level_max, sizeof(level_max));
+	if (level_max == 0 || level_max > 4095) {
+		level_max = 3542;
+	}
+	if (dry) {                              /* w3-keys: the model; no pin, no IC */
+		found_level = level_now = 1417;
+		found_on = true;
+		ready = stage >= 2;
+		say("icebl_dry=1: NO HARDWARE, a model of the two ICs (found on, level 1417); %s, max %u\n",
+		    ready ? "ready" : "icebl=1: read only", level_max);
+		auto_start();                   /* w4-auto: icebl_auto=1 / icebl_auto_test=1 */
+		return;
+	}
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	if (tlmm == 0) {
+		return;
+	}
+	say("stage %u; pins as found: gpio8 %#x, gpio9 %#x, gpio12 %#x, gpio13 %#x; enable gpio1 %#x/%u\n", stage,
+	    rd(PIN_CTL(8)), rd(PIN_CTL(9)), rd(PIN_CTL(12)), rd(PIN_CTL(13)), rd(PIN_CTL(1)), rd(PIN_IO(1)) & 3);
+	lck_mtx_lock(&icebl_lock);
+	for (unsigned i = 0; i < 2; i++) {
+		pins_setup(&buses[i], i);
+		i2c_stop(&buses[i]);            /* a clean idle bus */
+	}
+	report("as found");
+	for (unsigned i = 0; i < 2; i++) {
+		if (ic_state(i, &id, &en, &lvl)) {
+			if (!any) {
+				found_level = lvl;
+				found_on = en & 1;
+			}
+			any = true;
+		}
+	}
+	if (!any || stage < 2) {
+		/* the pins back to the serial engines */
+		for (unsigned i = 0; i < 2; i++) {
+			wr(PIN_CTL(buses[i].sda), found_ctl[i][0]);
+			wr(PIN_CTL(buses[i].scl), found_ctl[i][1]);
+		}
+		lck_mtx_unlock(&icebl_lock);
+		say("%s; pins put back\n", any ? "icebl=1: read only, stopping" : "no KTZ8869 answers: no backlight control");
+		return;
+	}
+	level_now = found_on ? found_level : 0;
+	ready = true;
+	lck_mtx_unlock(&icebl_lock);
+	say("ready: level %u (%s), max %u; sysctl kern.icebl_level\n", level_now, found_on ? "on" : "off", level_max);
+	if (stage >= 3) {
+		static const uint32_t steps[] = { 1417, 400, 3000, 0 };
+
+		for (unsigned s = 0; s < sizeof(steps) / sizeof(steps[0]); s++) {
+			int error = hakios_iceland_backlight_set(steps[s]);
+
+			lck_mtx_lock(&icebl_lock);
+			report(steps[s] ? "test" : "test off");
+			lck_mtx_unlock(&icebl_lock);
+			say("test: level %u set (%d)\n", steps[s], error);
+			delay_for_interval(steps[s] ? 2000 : 1000, NSEC_PER_MSEC);
+		}
+		hakios_iceland_backlight_set(found_on ? found_level : 0);
+		say("test over: back to level %u\n", level_now);
+	}
+	auto_start();                           /* w4-auto: icebl_auto=1, after icebl=3's own test */
+}
+
+void
+hakios_iceland_backlight_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icebl", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	if (stage > 3) {
+		stage = 3;
+	}
+	{
+		uint32_t d = 0;
+
+		dry = PE_parse_boot_argn("icebl_dry", &d, sizeof(d)) && d == 1;
+	}
+	if (PE_parse_boot_argn("icebl_fade", &fade_ms, sizeof(fade_ms)) && fade_ms != 0) {     /* 25ap1 */
+		fade_ms = fade_ms < 100 ? 100 : fade_ms > 1000 ? 1000 : fade_ms;
+		fade_call = thread_call_allocate(fade_step, NULL);
+		say("fade: display off fades the light over %u ms\n", fade_ms);
+	}
+	{
+		uint32_t a = 0, t = 0;
+
+		/* w4-auto: the call is made whatever the boot-args say, so kern.icebl_auto can turn it on at run time */
+		auto_want = PE_parse_boot_argn("icebl_auto", &a, sizeof(a)) && a == 1;
+		auto_test = PE_parse_boot_argn("icebl_auto_test", &t, sizeof(t)) && t == 1;
+		if (auto_test && !dry) {
+			auto_test = false;
+			say("icebl_auto_test=1 without icebl_dry=1: refused, it would move the real light\n");
+		}
+		if (auto_test) {
+			auto_want = true;       /* the test implies it */
+		}
+		auto_call = thread_call_allocate(auto_tick, NULL);
+	}
+	if (kernel_thread_start(icebl_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_battery.c b/bsd/dev/hakios_iceland_battery.c
new file mode 100644
index 0000000000000000000000000000000000000000..42ad2cd08c2c5a5f7d09d6e1ca90471c65d2ffa0
--- /dev/null
+++ b/bsd/dev/hakios_iceland_battery.c
@@ -0,0 +1,2035 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") battery, as its charger firmware tells it: the SoCCP (the charger
+ * and USB-PD co-processor, started by the boot chain; Linux only attaches) runs the battery manager, reached over
+ * GLINK in shared memory on the channel PMIC_RTR_SOCCP_APPS (pmic_glink). Only with boot-arg icebatt=N; without it
+ * nothing here is touched. Up to icebatt=4 it only ASKS the charger (property / gauge reads): no set, no limit, no
+ * notice; icebatt=5 (below) may raise the charger's limits.
+ *
+ * Every value is the Pad's own (q90t tree):
+ *   kaanapali.dtsi   smem@81d00000 (0x200000, qcom,smem; hwlock tcsr_mutex 3 -- never taken here: nothing is allocated);
+ *                    remoteproc_soccp: remoteproc@d00000 { glink-edge { mboxes = <&ipcc IPCC_MPROC_SOCCP (13)
+ *                    IPCC_MPROC_SIGNAL_GLINK_QMP (0)>; qcom,remote-pid = <19>; label = "soccp" } };
+ *                    ipcc: mailbox@1106000 (qcom-ipcc.c: SEND_ID 0x0c = client << 16 | signal)
+ *   qcom_smem.c      the partition table at the region's end - 4 KB ("$TOC"), a partition ("$PRT") per host pair, here
+ *                    0 (us) and 19; items uncached from the header up, cached from the top down
+ *   qcom_glink_smem.c items 478 (descriptor, 32 bytes: our queue's tail, head; theirs tail, head), 479 (our queue,
+ *                    16 KB), 480 (theirs); on attach Linux sets their tail and our head to 0, then speaks
+ *   qcom_glink_native.c the commands (version 1, feature intent-reuse), open / open-ack, intents, data, done
+ *   pmic_glink.c     "PMIC_RTR_SOCCP_APPS" (no PDR on this edge)
+ *   qcom_battmgr.c   header owner 32778 (battmgr), type 1 (request / response); the OPLUS variant's gauge read
+ *                    (opcode 0x10000, size 512) answered with 128 words: [0] temperature 0.1 C, [1] current mA
+ *                    (Linux reports -value), [2] voltage mV, [3] state of charge 0.01 %, [5] cycles, [6] full charge
+ *                    mAh, [8] health %; property gets 0x30 (battery) / 0x32 (USB) with battery 0, property, 0 ->
+ *                    property, value, result. Design capacity 13380 mAh (the DT's battery node).
+ * The method (shared-memory items, the GLINK queues, polled, no interrupt) follows HakiOS's redwood_adsp.c / redwood_wifi.c.
+ *
+ *   icebatt=1  read only: the SMEM partition with processor 19, its items, GLINK's descriptor and queue sizes
+ *   icebatt=2  ... and what waits in the SoCCP's queue (the first message headers), still not consumed
+ *   icebatt=3  ... and GLINK spoken: their tail / our head reset as Linux does, version, the channel opened (answering
+ *              theirs, or opening ours after 3 s), our intents; channel list and states logged
+ *   icebatt=4  ... and the battery asked every icebatt_s seconds (default 30): the gauge, the battery status, USB
+ *              online; reported to the kernel's battery state (redwood_battery_report() -> iOS's power source)
+ *
+ * w4-battery (16 Nov), still reads only with icebatt=4:
+ *   - the gauge is also read every 5 s between the rounds (stock's gauge period, oplus,topic-update-interval 5000 ms),
+ *     and a round gives the mean, lowest and highest current of its samples: one 1 Hz reading every 30 s said little
+ *     (-1.0 .. -3.1 A within one run, runs/w3-power-wake/20261115-215228);
+ *   - a second line per round, "icebatt: power N: ...": what the USB port gives (voltage, current, the input limit in
+ *     force, the source's maximum, the type and the adapter type: USB property gets 1, 3, 5, 4, 6, 7) and what the
+ *     charger is allowed (battery property gets 10, the charge current limit, and 3, the charge type); from them the
+ *     power in, the power into or out of the battery, and their difference: what the tablet takes;
+ *   - the status handed to the power source follows the mean current, as the owner's Linux driver does (charger in and
+ *     100 % -> full; mean above +20 mA -> charging; below -20 mA -> discharging; else not charging): the firmware's
+ *     status says "charging" whenever a cable is in, also at -3 A.
+ *   icebatt_load=S  S seconds after the first round, once: the mean current over 15 s, the same with the backlight
+ *              off (hakios_iceland_backlight_power(0), the display sleep's own call), the same with it on again:
+ *              "icebatt: load: ..." names what the backlight takes. Only with icebl>=2 and a lit backlight. The one
+ *              write is the backlight's level (i2c14 / i2c15, the kind icebl=2 and the display sleep make).
+ *   icebatt=5  ... and the charger's limits RAISED where the source gives more than the firmware took; never lowered
+ *              (the rule and its facts: hakios_iceland_charger_plan.h; the first icebatt=5 set every limit from a
+ *              table as Linux does, and on stage A's port that would have taken the input from the firmware's
+ *              2000 mA down to 500 mA). On a computer's port, a plain charger, an unknown or "BrickID" source:
+ *              NO WRITE, one line says why. On a Type-C or PD source, requests to the charger firmware over the
+ *              channel that is already open (no register, no bus): for PD at 5 V with the battery under 4.5 V the
+ *              9 V request (0x300 / 71 = 9000; never 12 V), taken back (= 5000) if it does not hold; the input
+ *              current limit up in stock's steps (0x300 / 5) to what the source gives, at most 2000 mA. Every 5 s:
+ *              USB online and the adapter type again (a new attach or a changed type is looked at again, at most 5
+ *              changes an attach), and this driver's own guard: outside 12 .. 45 C no raise, and its own raises
+ *              taken back; no charging below -10 C, from 53 C, above 4508 mV at the battery or 11 V at the port
+ *              (0x300 / 70 = 0), on again inside. Nothing is put back at the run's end: the firmware starts every
+ *              attach with its defaults.
+ *   icebatt=6  (w6-charge) ... and charging turned ON, which nobody did under macOS: stock's hardware init and the
+ *              owner's Linux set OPLUS 70 = 1 at every boot / attach, and every icebatt=4 run showed the battery flat
+ *              at -3 .. -8 mA with charge type 1 (none) while the port had room. At every attach, the charge enable
+ *              is read as found (0x301 / 70), then set (0x300 / 70 = 1) and read back, but only inside the owner's
+ *              stage B guard (hakios_iceland_charger_plan.h icechg_enable_want(): 12 .. 45 C, battery <= 4508 mV,
+ *              VBUS <= 11 V, on a fresh gauge reading). The guard then runs every 5 s, and one reading out of range
+ *              or not answered sets 70 = 0. The charge current limit is LOWERED to stock's row for the type
+ *              (0x31 / 10: SDP 600, CDP 1600, PD 3300, else 2200 mA) where the firmware's is above it, then read
+ *              back. icebatt=5's 9 V and its raise-only input limit stay as they are; its wider -10 / 53 C stop
+ *              guard gives way to this one.
+ * Lines go to the kernel log, prefixed "icebatt:".
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+#include "hakios_iceland_charger_plan.h"
+
+#define say(...) printf("icebatt: " __VA_ARGS__)
+#define LESSER(a, b) ((a) < (b) ? (a) : (b))
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+void hakios_iceland_battery_init(void);
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- shared memory ------------------------------------------------------------------------------------------- */
+
+#define SMEM_PHYS               0x81d00000UL
+#define SMEM_SIZE               0x00200000u
+#define HOST_APPS               0
+#define HOST_SOCCP              19
+#define SMEM_CANARY             0xa5a5
+#define ITEM_GLINK_DESCRIPTOR   478
+#define ITEM_GLINK_OUR_QUEUE    479
+#define ITEM_GLINK_THEIR_QUEUE  480
+
+static vm_offset_t smem;
+
+/*
+ * SMEM is the SoC's own memory, never pages the kernel manages. On the Pad it lies outside DarwinBoot's window and
+ * outside the adopted runs. On QEMU's A3 route (DarwinBoot's window 0x53804000 + 3 GiB) 0x81d00000 is plain RAM:
+ * ml_io_map would leave a permanent kernel mapping (Device-GRE, attr 7) on pages the VM hands out, and
+ * pmap_assert_free panics when one of them is recycled (runs/s8 182651 and 184004, at fsck's start).
+ */
+extern boolean_t pmap_valid_page(ppnum_t pn);
+
+static bool
+kernel_memory(uint64_t pa, uint64_t size)
+{
+	for (uint64_t page = trunc_page_64(pa); page < pa + size; page += PAGE_SIZE) {
+		if (pmap_valid_page((ppnum_t)atop_64(page))) {
+			return true;
+		}
+	}
+	return false;
+}
+
+struct toc_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+};
+struct partition_header {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, free_uncached, free_cached, reserved[3];
+};
+struct item_header {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_header;
+	uint32_t reserved;
+};
+
+static void
+peek(uint32_t offset, void *to, uint32_t size)
+{
+	for (uint32_t i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = offset + i < SMEM_SIZE ? *(volatile uint8_t *)(smem + offset + i) : 0;
+	}
+}
+
+static uint32_t
+word(uint32_t offset)
+{
+	return rd(smem + offset);
+}
+
+static void
+poke(uint32_t offset, uint32_t value)
+{
+	wr(smem + offset, value);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint32_t part_offset, part_size, part_cacheline;
+
+static bool
+find_partition(void)
+{
+	uint8_t magic[4];
+	uint32_t version, count;
+
+	peek(SMEM_SIZE - 0x1000, magic, 4);
+	version = word(SMEM_SIZE - 0x1000 + 4);
+	count = word(SMEM_SIZE - 0x1000 + 8);
+	if (memcmp(magic, "$TOC", 4) != 0 || version != 1 || count > 64) {
+		say("no partition table (magic %02x%02x%02x%02x, version %u, %u entries)\n", magic[0], magic[1], magic[2], magic[3],
+		    version, count);
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		struct toc_entry e;
+		struct partition_header h;
+
+		peek(SMEM_SIZE - 0x1000 + 32 + i * (uint32_t)sizeof(e), &e, sizeof(e));
+		if (e.offset == 0 || e.size == 0) {
+			continue;
+		}
+		if (!((e.host0 == HOST_APPS && e.host1 == HOST_SOCCP) || (e.host0 == HOST_SOCCP && e.host1 == HOST_APPS))) {
+			continue;
+		}
+		peek(e.offset, &h, sizeof(h));
+		if ((uint64_t)e.offset + e.size > SMEM_SIZE - 0x1000 || memcmp(h.magic, "$PRT", 4) != 0 || h.size != e.size) {
+			say("partition entry %u for 0/19 at %#x is not a partition\n", i, e.offset);
+			return false;
+		}
+		part_offset = e.offset;
+		part_size = e.size;
+		part_cacheline = e.cacheline;
+		say("partition 0/19: entry %u of %u, at %#lx, %#x bytes, cacheline %#x; free uncached %#x cached %#x\n", i, count,
+		    SMEM_PHYS + e.offset, e.size, e.cacheline, h.free_uncached, h.free_cached);
+		return true;
+	}
+	say("no partition for us (0) and the SoCCP (19) among %u\n", count);
+	return false;
+}
+
+/* an item of the 0/19 partition: where, and its size; 0 if not there. With `list`, every item said. */
+static uint32_t
+find_item(uint32_t want, uint32_t *size, bool list)
+{
+	struct partition_header h;
+	struct item_header e;
+	uint32_t at, found = 0;
+	char line[200];
+	int n = 0;
+
+	peek(part_offset, &h, sizeof(h));
+	if (h.free_uncached > h.size || h.free_cached > h.size) {
+		return 0;
+	}
+	line[0] = 0;
+	for (at = sizeof(h); at + sizeof(e) <= h.free_uncached;) {
+		peek(part_offset + at, &e, sizeof(e));
+		if (e.canary != SMEM_CANARY || e.size > h.size) {
+			break;
+		}
+		if (list && n < (int)sizeof(line) - 20) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %u(%u)", e.item, e.size - e.padding_data);
+		}
+		if (e.item == want && found == 0) {
+			found = part_offset + at + (uint32_t)sizeof(e) + e.padding_header;
+			*size = e.size - e.padding_data;
+		}
+		at += (uint32_t)sizeof(e) + e.padding_header + e.size;
+	}
+	if (part_cacheline != 0 && !(part_cacheline & (part_cacheline - 1))) {
+		uint32_t back = ((uint32_t)sizeof(e) + part_cacheline - 1) & ~(part_cacheline - 1);
+
+		for (at = h.size - back; at > h.free_cached && at < h.size;) {
+			peek(part_offset + at, &e, sizeof(e));
+			if (e.canary != SMEM_CANARY || e.size > at) {
+				break;
+			}
+			if (list && n < (int)sizeof(line) - 20) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " %u(%u)c", e.item, e.size - e.padding_data);
+			}
+			if (e.item == want && found == 0) {
+				found = part_offset + at - e.size;
+				*size = e.size - e.padding_data;
+			}
+			if (e.size + back > at) {
+				break;
+			}
+			at -= e.size + back;
+		}
+	}
+	if (list) {
+		say("items (bytes):%s\n", line);
+	}
+	return found;
+}
+
+/* ---- the doorbell ------------------------------------------------------------------------------------------------ */
+
+#define IPCC_PHYS               0x01106000UL
+#define IPCC_SEND_ID            0x0c
+#define IPCC_CLIENT_SOCCP       13
+#define IPCC_SIGNAL_GLINK       0
+
+static vm_offset_t ipcc;
+
+static void
+ring(void)
+{
+	wr(ipcc + IPCC_SEND_ID, IPCC_CLIENT_SOCCP << 16 | IPCC_SIGNAL_GLINK);
+}
+
+/* ---- GLINK ------------------------------------------------------------------------------------------------------- */
+
+#define D_OUR_TAIL              0
+#define D_OUR_HEAD              4
+#define D_THEIR_TAIL            8
+#define D_THEIR_HEAD            12
+#define RESERVE                 16
+
+enum {
+	G_VERSION = 0, G_VERSION_ACK = 1, G_OPEN = 2, G_CLOSE = 3, G_OPEN_ACK = 4, G_INTENT = 5, G_DONE = 6,
+	G_INTENT_REQUEST = 7, G_INTENT_REQUEST_ACK = 8, G_DATA = 9, G_CLOSE_ACK = 11, G_DATA_MORE = 12, G_READ_NOTIFY = 13,
+	G_DONE_REUSE = 14, G_SIGNALS = 15,
+};
+#define FEATURE_INTENT_REUSE    1u
+#define CHANNEL_NAME            "PMIC_RTR_SOCCP_APPS"
+#define OUR_CHANNEL             1
+#define INTENTS                 6
+#define INTENT_SIZE             0x400
+
+struct gmsg {
+	uint16_t command, param1;
+	uint32_t param2;
+};
+
+static uint32_t desc, ours, ours_size, theirs, theirs_size;
+static uint32_t features = FEATURE_INTENT_REUSE, said, heard, trace = 40;
+static bool agreed, broken, asked, acked, open;
+static uint32_t their_channel;
+static struct {
+	uint32_t id, size;
+	bool there, in_use;
+} their_intents[32];
+static uint8_t our_buf[INTENTS][INTENT_SIZE];
+static uint32_t our_fill[INTENTS];
+static bool offered;
+static char others[4][33];
+
+/* the answer the battery thread waits for */
+static uint8_t answer[INTENT_SIZE];
+static uint32_t answer_length, answers;
+
+static const char *
+gname(unsigned c)
+{
+	static const char *const n[] = { "version", "version-ack", "open", "close", "open-ack", "intent", "done",
+		                         "intent-req", "intent-req-ack", "data", "10", "close-ack", "data-more", "read-notify",
+		                         "done-reuse", "signals" };
+
+	return c < 16 ? n[c] : "?";
+}
+
+static uint32_t
+waiting(void)
+{
+	uint32_t head = word(desc + D_THEIR_HEAD), tail = word(desc + D_THEIR_TAIL);
+
+	if (head >= theirs_size || tail >= theirs_size) {
+		return 0;
+	}
+	return head >= tail ? head - tail : theirs_size - tail + head;
+}
+
+static void
+gpeek(void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (word(desc + D_THEIR_TAIL) + offset) % theirs_size;
+
+	for (uint32_t i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = *(volatile uint8_t *)(smem + theirs + (at + i) % theirs_size);
+	}
+}
+
+static void
+gadvance(uint32_t count)
+{
+	poke(desc + D_THEIR_TAIL, (word(desc + D_THEIR_TAIL) + count) % theirs_size);
+}
+
+static uint32_t
+room(void)
+{
+	uint32_t head = word(desc + D_OUR_HEAD), tail = word(desc + D_OUR_TAIL), r;
+
+	if (head >= ours_size || tail >= ours_size) {
+		return 0;
+	}
+	r = tail <= head ? ours_size - head + tail : tail - head;
+	return r < RESERVE ? 0 : r - RESERVE;
+}
+
+static bool
+gput(const void *a, uint32_t al, const void *b, uint32_t bl)
+{
+	uint32_t head = word(desc + D_OUR_HEAD), len = al + bl, padded = (len + 7) & ~7u;
+
+	if (room() < padded) {
+		return false;
+	}
+	for (uint32_t i = 0; i < padded; i++) {
+		uint8_t v = i < al ? ((const uint8_t *)a)[i] : i < len ? ((const uint8_t *)b)[i - al] : 0;
+
+		*(volatile uint8_t *)(smem + ours + (head + i) % ours_size) = v;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	poke(desc + D_OUR_HEAD, (head + padded) % ours_size);
+	ring();
+	said++;
+	return true;
+}
+
+static void
+gsay(unsigned command, uint32_t p1, uint32_t p2, const void *more, uint32_t more_len)
+{
+	struct gmsg m = { (uint16_t)command, (uint16_t)p1, p2 };
+	bool sent = gput(&m, sizeof(m), more, more_len);
+
+	if (trace > 0 || !sent) {
+		trace -= trace > 0;
+		say("> %s %u %#x%s\n", gname(command), p1, p2, sent ? "" : ": NO ROOM, not sent");
+	}
+}
+
+static void
+send_open(void)
+{
+	char name[40];
+	uint32_t len = (uint32_t)strlen(CHANNEL_NAME) + 1;
+
+	bzero(name, sizeof(name));
+	strlcpy(name, CHANNEL_NAME, sizeof(name));
+	gsay(G_OPEN, OUR_CHANNEL, len, name, (len + 7) & ~7u);
+	asked = true;
+}
+
+/* ---- icetypec=1 (w7-usb, 18 Nov): stage H0 of survey/USB-C-HOST-OTG-DP-2026-11-17.md ----
+ * Linux's pmic_glink multiplexes every client on this one GLINK channel: each message's 8-byte header (the
+ * reassembled intent's first bytes) carries the owner — 32778 = the battery manager, 32779 = UCSI (the Type-C
+ * connector state machine), 32780 = the altmode/PAN side. The SoCCP sends the other owners' messages whenever
+ * it decides to (a plug, a role switch, a partner's altmodes); until now they were reassembled, swallowed by
+ * the request loop and forgotten. With this: another owner's completed message is counted, and with the gate
+ * decoded — type, length, and the first payload bytes, one line per message class (rate-limited). Nothing is
+ * answered, nothing is written, the battery manager's own answers never pass through here: stage H0 observes
+ * only. The counts are said at the run's end. */
+static bool typec_read;
+static int typec_on;
+static uint32_t typec_msgs, typec_ucsi, typec_pan, typec_other, typec_said;
+static uint32_t typec_rd_len;           /* gains1 (U2): the length of the last UCSI read-buffer answer (0 none) */
+static uint32_t usbh_bits;              /* lane E: iceusbh= (0: none of it; below icebatt_thread) */
+static bool usbh_queue(const uint8_t *p, uint32_t n, uint32_t owner, uint32_t type, uint32_t opcode);
+static void usbh_service(void);
+
+static bool
+typec_gate(void)
+{
+	if (!typec_read) {
+		typec_read = true;
+		(void)PE_parse_boot_argn("icetypec", &typec_on, sizeof(typec_on));
+		if (typec_on == 1) {
+			say("icetypec=1: the Type-C owners' traffic (UCSI 32779, altmode 32780) is decoded; nothing is answered\n");
+		} else if (typec_on >= 2) {
+			say("icetypec=%d: the Type-C owners' traffic is decoded, and UCSI and the altmode side are ASKED once the "
+			    "channel is open (UCSI read, PPM_RESET, SET_NOTIFICATION_ENABLE, GET_CONNECTOR_STATUS 1; PAN enable)\n",
+			    typec_on);
+		}
+	}
+	return typec_on;
+}
+
+/*
+ * gains1: the message header is Linux's struct pmic_glink_hdr -- __le32 owner, __le32 type, __le32 opcode (12 bytes,
+ * include/linux/soc/qcom/pmic_glink.h; the battery code's own requests and its answer checks use the same layout:
+ * q[] = { OWNER_BATTMGR, TYPE_REQUEST, opcode, ... }, the opcode at +8). The w7-usb observer read the owner at +4 (the
+ * TYPE word) and so took EVERY battery-manager answer (owner 32778 = 0x800a, type 1) for "an owner this does not know
+ * (1): type 10" and swallowed it before the battery code saw it: the "35 rounds, zero answers" since 18 Nov (the
+ * w7-usb-1 and diag captures carry exactly that line). Now the owner is read at +0; a message shorter than the header
+ * goes to the battery code as before.
+ */
+static bool
+typec_seen(const uint8_t *p, uint32_t n)
+{
+	uint32_t owner, type, opcode;
+
+	if (n < 12) {
+		return false;
+	}
+	memcpy(&owner, p, 4);
+	memcpy(&type, p + 4, 4);
+	memcpy(&opcode, p + 8, 4);
+	if (owner == 32778u) {
+		return usbh_bits != 0 && usbh_queue(p, n, owner, type, opcode);        /* lane E VBUS: its notifications */
+	}
+	typec_msgs++;
+	if (usbh_bits != 0 && (owner == 32779u || owner == 32780u) && usbh_queue(p, n, owner, type, opcode) &&
+	    typec_on == 0) {
+		if (owner == 32779u) {
+			typec_ucsi++;
+		} else {
+			typec_pan++;
+		}
+		return true;                    /* lane E's (iceusbh TC / DP): acted on by usbh_service() */
+	}
+	if (owner == 32779u) {
+		typec_ucsi++;
+		if (opcode == 0x11) {
+			typec_rd_len = n;       /* a read-buffer answer: its size says the UCSI version's buffer (v1 / v2) */
+		}
+	} else if (owner == 32780u) {
+		typec_pan++;
+	} else {
+		typec_other++;
+		if (typec_other <= 3) {
+			say("icetypec: an owner this does not know (%u): type %u opcode %#x, %u bytes (counted, left alone)\n",
+			    owner, type, opcode, n);
+		}
+		return true;                    /* observed, skipped, not the battery's answer */
+	}
+	if (typec_gate() && typec_said < (typec_on >= 2 ? 80u : 40u)) {
+		char hex[3 * 16 + 1];
+		uint32_t j = 0, first = n - 12 < 16 ? n - 12 : 16;
+
+		typec_said++;
+		for (uint32_t i = 0; i < first; i++) {
+			j += (uint32_t)snprintf(hex + j, sizeof(hex) - j, "%s%02x", i ? " " : "", p[12 + i]);
+		}
+		say("icetypec: < %s type %u opcode %#x%s, %u bytes: %s%s\n", owner == 32779u ? "UCSI" : "PAN", type, opcode,
+		    owner == 32779u ? (opcode == 0x11 ? " (read buffer)" : opcode == 0x12 ? " (write answer)" :
+		    opcode == 0x13 ? " (notify)" : "") : (opcode == 0x15 ? " (command answer)" : opcode == 0x16 ? " (notify)" : ""),
+		    n, first ? hex : "(no payload)", n - 12 > first ? " ..." : "");
+		if (owner == 32779u && opcode == 0x11 && n >= 12 + 8) {
+			uint16_t version;
+			uint32_t cci;
+
+			memcpy(&version, p + 12, 2);
+			memcpy(&cci, p + 16, 4);
+			say("icetypec: UCSI version %x.%x, CCI %#x (connector %u, length %u%s%s%s%s%s)\n", version >> 8,
+			    (version >> 4) & 0xf, cci, (cci >> 1) & 0x7f, (cci >> 8) & 0xff, cci & (1u << 31) ? ", command complete" : "",
+			    cci & (1u << 30) ? ", ERROR" : "", cci & (1u << 27) ? ", reset complete" : "", cci & (1u << 28) ? ", busy" : "",
+			    cci & (1u << 25) ? ", not supported" : "");
+		}
+	}
+	return true;
+}
+
+static void
+offer_intents(void)
+{
+	for (uint32_t i = 0; i < INTENTS; i++) {
+		uint32_t w[2] = { INTENT_SIZE, i + 1 };
+
+		our_fill[i] = 0;
+		gsay(G_INTENT, OUR_CHANNEL, 1, w, sizeof(w));
+	}
+	offered = true;
+}
+
+/* what the SoCCP has queued, acted on (qcom_glink_native_rx) */
+static void
+pump(void)
+{
+	while (!broken) {
+		struct gmsg m;
+		uint32_t w[2] = { 0, 0 }, avail = waiting(), len = sizeof(m);
+		char name[33];
+
+		if (avail < sizeof(m)) {
+			return;
+		}
+		gpeek(&m, 0, sizeof(m));
+		if (m.command == G_OPEN) {
+			len += m.param2;
+		} else if (m.command == G_INTENT) {
+			len += 8 * m.param2;
+		} else if (m.command == G_DATA || m.command == G_DATA_MORE) {
+			if (avail < 16) {
+				return;
+			}
+			gpeek(w, 8, 8);
+			len = 16 + w[0];
+		}
+		len = (len + 7) & ~7u;
+		if (len > theirs_size - 8) {
+			say("a message of %u bytes (%s %u %#x): not believed; nothing more is read\n", len, gname(m.command),
+			    m.param1, m.param2);
+			broken = true;
+			return;
+		}
+		if (avail < len) {
+			return;
+		}
+		heard++;
+		if (trace > 0 && m.command != G_DATA && m.command != G_INTENT) {
+			trace--;
+			say("< %s %u %#x\n", gname(m.command), m.param1, m.param2);
+		}
+		switch (m.command) {
+		case G_VERSION:
+			gadvance(len);
+			if (m.param1 == 1) {
+				features &= m.param2;
+			}
+			gsay(G_VERSION_ACK, 1, features, NULL, 0);
+			break;
+		case G_VERSION_ACK:
+			gadvance(len);
+			if (m.param1 == 1 && m.param2 == features) {
+				agreed = true;
+			} else if (m.param1 != 0) {
+				features &= m.param2;
+				gsay(G_VERSION, 1, features, NULL, 0);
+			}
+			break;
+		case G_OPEN:
+			bzero(name, sizeof(name));
+			gpeek(name, sizeof(m), m.param2 < sizeof(name) - 1 ? m.param2 : sizeof(name) - 1);
+			gadvance(len);
+			if (strcmp(name, CHANNEL_NAME) != 0) {
+				say("the SoCCP opens \"%s\" (its %u): not ours, left unanswered\n", name, m.param1);
+				for (unsigned i = 0; i < 4; i++) {
+					if (others[i][0] == 0) {
+						strlcpy(others[i], name, sizeof(others[i]));
+						break;
+					}
+				}
+				break;
+			}
+			say("the SoCCP opens \"%s\" as its channel %u: acknowledged\n", name, m.param1);
+			their_channel = m.param1;
+			gsay(G_OPEN_ACK, their_channel, 0, NULL, 0);
+			if (!asked) {
+				send_open();
+			}
+			break;
+		case G_OPEN_ACK:
+			gadvance(len);
+			if (m.param1 == OUR_CHANNEL) {
+				acked = true;
+			}
+			break;
+		case G_INTENT:
+			for (uint32_t i = 0; m.param1 == their_channel && i < m.param2; i++) {
+				uint32_t iw[2];
+
+				gpeek(iw, 8 + 8 * i, 8);
+				for (unsigned n = 0; n < 32; n++) {
+					if (!their_intents[n].there || their_intents[n].id == iw[1]) {
+						their_intents[n].there = true;
+						their_intents[n].in_use = false;
+						their_intents[n].size = iw[0];
+						their_intents[n].id = iw[1];
+						break;
+					}
+				}
+			}
+			gadvance(len);
+			break;
+		case G_DONE:
+		case G_DONE_REUSE:
+			for (unsigned n = 0; m.param1 == their_channel && n < 32; n++) {
+				if (their_intents[n].there && their_intents[n].id == m.param2) {
+					their_intents[n].in_use = false;
+					their_intents[n].there = m.command == G_DONE_REUSE;
+				}
+			}
+			gadvance(len);
+			break;
+		case G_INTENT_REQUEST:
+			gadvance(len);
+			/* all our intents are offered at the start; a request for more is refused */
+			gsay(G_INTENT_REQUEST_ACK, OUR_CHANNEL, 0, NULL, 0);
+			break;
+		case G_DATA:
+		case G_DATA_MORE: {
+			uint32_t intent = m.param2 - 1;
+
+			if (m.param1 != their_channel || intent >= INTENTS || w[0] > INTENT_SIZE - our_fill[intent]) {
+				say("< data of %u bytes on %u for intent %u: not ours or too much, dropped\n", w[0], m.param1, m.param2);
+				gadvance(len);
+				break;
+			}
+			gpeek(our_buf[intent] + our_fill[intent], 16, w[0]);
+			our_fill[intent] += w[0];
+			gadvance(len);
+			if (w[1] == 0) {
+				if (typec_seen(our_buf[intent], our_fill[intent])) {
+					/* the message is another owner's (UCSI / altmode): observed, not the battery manager's answer */
+					our_fill[intent] = 0;
+					gsay(G_DONE_REUSE, OUR_CHANNEL, m.param2, NULL, 0);
+					break;
+				}
+				memcpy(answer, our_buf[intent], our_fill[intent]);
+				answer_length = our_fill[intent];
+				answers++;
+				our_fill[intent] = 0;
+				gsay(G_DONE_REUSE, OUR_CHANNEL, m.param2, NULL, 0);
+			}
+			break;
+		}
+		case G_READ_NOTIFY:
+			gadvance(len);
+			ring();
+			break;
+		case G_CLOSE:
+			gadvance(len);
+			gsay(G_CLOSE_ACK, m.param1, 0, NULL, 0);
+			if (m.param1 == their_channel) {
+				say("THE SoCCP CLOSES \"%s\"\n", CHANNEL_NAME);
+				their_channel = 0;
+				open = false;
+			}
+			break;
+		case G_CLOSE_ACK:
+		case G_SIGNALS:
+		case G_INTENT_REQUEST_ACK:
+			gadvance(len);
+			break;
+		default:
+			say("a command this does not know (%u, %u, %#x): nothing more is read\n", m.command, m.param1, m.param2);
+			broken = true;
+			return;
+		}
+		if (their_channel != 0 && acked && !open) {
+			open = true;
+			say("\"%s\" IS OPEN both ways (ours %u, theirs %u): offering %u intents of %u bytes\n", CHANNEL_NAME,
+			    OUR_CHANNEL, their_channel, INTENTS, INTENT_SIZE);
+			if (!offered) {
+				offer_intents();
+			}
+		}
+	}
+}
+
+/*
+ * gains1 (N7), icebatt_reask=1 (built in for the gains kit; icebatt_reask=0 on a line turns it off): Reixo0's kaanapali
+ * lesson (nx809j-mainline patches 0285/0286, pmic_glink altmode and UCSI): the SoCCP firmware can hold a request that
+ * arrives just after its GLINK channel opens until ANOTHER message arrives, and then answers both. Here a request with
+ * no answer in its time is sent once more -- the same read-only request (a property get or the gauge read), on
+ * another of the SoCCP's intents -- and the channel is watched for the same time again. The messages that come are
+ * counted and said: none (the firmware is silent, re-asked or not), one, or two (the held first and the second: the
+ * 0285 ordering). The Type-C owners' messages a second message might release are counted by icetypec's own counters
+ * (typec_seen; the UCSI side asks nothing here, so it has nothing to re-ask). Lines "icebatt: re-ask ...".
+ */
+static uint32_t reask_n, reask_none, reask_one, reask_two;
+
+static bool
+reask_on(void)
+{
+	uint32_t v = 0;
+
+	return PE_parse_boot_argn("icebatt_reask", &v, sizeof(v)) && v != 0;
+}
+
+static bool
+request_again(const void *data, uint32_t length, uint32_t want_opcode, uint32_t ms)
+{
+	struct {
+		struct gmsg m;
+		uint32_t size, left;
+	} h = { { G_DATA, OUR_CHANNEL, 0 }, length, 0 };
+	int found = -1;
+	uint32_t at, last, came;
+	bool mine = false;
+
+	reask_n++;
+	for (unsigned n = 0; n < 32; n++) {
+		if (their_intents[n].there && !their_intents[n].in_use && their_intents[n].size >= length &&
+		    (found < 0 || their_intents[n].size < their_intents[found].size)) {
+			found = (int)n;
+		}
+	}
+	if (found < 0 || room() < ((length + sizeof(h) + 7) & ~7u)) {
+		reask_none++;
+		if (reask_n <= 20 || reask_n % 20 == 0) {
+			say("re-ask %u: opcode %#x silent %u ms; no free intent of the SoCCP's for a second message (so far: none %u, "
+			    "one %u, two %u)\n", reask_n, want_opcode, ms, reask_none, reask_one, reask_two);
+		}
+		return false;
+	}
+	their_intents[found].in_use = true;
+	h.m.param2 = their_intents[found].id;
+	at = answers;
+	last = at;
+	gput(&h, sizeof(h), data, length);
+	for (uint32_t t = 0; t < ms && answers - at < 2; t++) {
+		pump();
+		if (answers != last) {
+			mine = mine || (answer_length >= 12 && *(uint32_t *)(answer + 8) == want_opcode);
+			last = answers;
+		}
+		sleep_ms(1);
+	}
+	came = answers - at;
+	if (came == 0) {
+		reask_none++;
+	} else if (came == 1) {
+		reask_one++;
+	} else {
+		reask_two++;
+	}
+	if (reask_n <= 20 || reask_n % 20 == 0 || came >= 2) {
+		say("re-ask %u: opcode %#x silent %u ms, asked again: %u message%s after it%s (so far: none %u, one %u, two %u)\n",
+		    reask_n, want_opcode, ms, came, came == 1 ? "" : "s", mine ? ", the asked opcode among them" : "",
+		    reask_none, reask_one, reask_two);
+	}
+	return mine;
+}
+
+/* one request on the channel and its answer (pumping meanwhile); false if none within `ms` */
+static bool
+request(const void *data, uint32_t length, uint32_t want_opcode, uint32_t ms)
+{
+	struct {
+		struct gmsg m;
+		uint32_t size, left;
+	} h = { { G_DATA, OUR_CHANNEL, 0 }, length, 0 };
+	int found = -1;
+	uint32_t before = answers;
+
+	for (uint32_t t = 0; t < ms; t++) {
+		pump();
+		if (!open || broken) {
+			return false;
+		}
+		found = -1;
+		for (unsigned n = 0; n < 32; n++) {
+			if (their_intents[n].there && !their_intents[n].in_use && their_intents[n].size >= length &&
+			    (found < 0 || their_intents[n].size < their_intents[found].size)) {
+				found = (int)n;
+			}
+		}
+		if (found >= 0 && room() >= ((length + sizeof(h) + 7) & ~7u)) {
+			break;
+		}
+		found = -1;
+		sleep_ms(1);
+	}
+	if (found < 0) {
+		say("no intent of the SoCCP's for %u bytes\n", length);
+		return false;
+	}
+	their_intents[found].in_use = true;
+	h.m.param2 = their_intents[found].id;
+	gput(&h, sizeof(h), data, length);
+	for (uint32_t t = 0; t < ms; t++) {
+		pump();
+		if (answers != before) {
+			uint32_t op = answer_length >= 12 ? *(uint32_t *)(answer + 8) : 0;
+
+			if (op == want_opcode) {
+				return true;
+			}
+			if (answer_length >= 12) {
+				say("< a message of opcode %#x (type %u, %u bytes) while waiting for %#x\n", op, *(uint32_t *)(answer + 4),
+				    answer_length, want_opcode);
+			}
+			before = answers;
+		}
+		sleep_ms(1);
+	}
+	/* gains1 (N7): reads only -- the battery / USB property gets (0x30, 0x32), the OPLUS get (0x301) and the OPLUS gauge
+	 * read (0x10000), never a set (icebatt=5/6's 0x31 / 0x300 go out once, as before) */
+	if (open && !broken && (want_opcode == 0x30 || want_opcode == 0x32 || want_opcode == 0x301 || want_opcode == 0x10000) &&
+	    reask_on()) {
+		return request_again(data, length, want_opcode, ms);
+	}
+	return false;
+}
+
+/* ---- the battery manager --------------------------------------------------------------------------------------- */
+
+#define OWNER_BATTMGR           32778
+#define TYPE_REQUEST            1
+#define OP_BAT_PROPERTY_GET     0x30
+#define OP_USB_PROPERTY_GET     0x32
+#define OP_OPLUS_GAUGE_READ     0x10000
+#define GAUGE_WORDS             128
+#define BATT_STATUS             0
+#define USB_ONLINE              0
+#define DESIGN_UAH              13380000
+
+static bool
+get_property(uint32_t opcode, uint32_t property, uint32_t *value)
+{
+	uint32_t q[6] = { OWNER_BATTMGR, TYPE_REQUEST, opcode, 0, property, 0 };
+
+	if (!request(q, sizeof(q), opcode, 1000) || answer_length != 24) {      /* (Linux: exactly property, value, result) */
+		return false;
+	}
+	/* hdr, property, value, result */
+	if (*(uint32_t *)(answer + 12) != property || *(uint32_t *)(answer + 20) != 0) {
+		say("property %u of %#x: answered property %u, result %u\n", property, opcode, *(uint32_t *)(answer + 12),
+		    *(uint32_t *)(answer + 20));
+		return false;
+	}
+	*value = *(uint32_t *)(answer + 16);
+	return true;
+}
+
+/* the channel pumped for `ms` (a sleep that keeps reading what the SoCCP sends) */
+static void
+wait_pumping(uint32_t ms)
+{
+	for (uint32_t t = 0; t < ms; t += 10) {
+		pump();
+		if (usbh_bits != 0) {
+			usbh_service();         /* lane E (iceusbh=): its queued UCSI / PAN messages */
+		}
+		sleep_ms(10);
+	}
+}
+
+/*
+ * gains1 (U2), icetypec=2 (a line word; icetypec=1 still only listens): we ASK the Type-C owners, as Linux's clients do
+ * at service-up -- the SoCCP does not talk UCSI or altmode to a host that never registered (UKE-PIANO-SWEEP U2: uke's
+ * DP alt-mode on XNU works only after the host acts as the OPM). The messages, from Linux's ucsi_glink.c and
+ * pmic_glink_altmode.c (facts only) and Allenwdk/QcomDwc3 QcomUcsi.h (BSD-2-Clause-Patent):
+ *   UCSI (owner 32779, type 1): read buffer = opcode 0x11, the header alone; the answer carries VERSION (+0), CCI (+4),
+ *     MESSAGE_IN (+16) and a ret_code. Write buffer = opcode 0x12, the header + the UCSI buffer (48 B for UCSI 1.x,
+ *     528 B for 2.x: picked by the read answer's size, as Linux picks it) + a reserved word, the 64-bit command at
+ *     CONTROL (+8): PPM_RESET 0x01; SET_NOTIFICATION_ENABLE 0x05 | UCSI_ENABLE_NTFY_ALL 0xdbe70000; then
+ *     GET_CONNECTOR_STATUS 0x12 | connector 1 << 16; after each completed command ACK_CC_CI 0x04 | command complete
+ *     (bit 17). After every write the buffer is read again (the CCI).
+ *   altmode (owner 32780, type 1): opcode 0x15 (USBC_CMD_WRITE_REQ), cmd 0x10 (PAN enable), arg 0, reserved 0.
+ * Every answer is logged by typec_seen ("icetypec: < UCSI ..."; the CCI decoded). Nothing else is written; the
+ * charger is not touched. This also answers whether the SoCCP takes writes at all on this channel.
+ */
+static bool
+glink_send(const void *data, uint32_t length)
+{
+	struct {
+		struct gmsg m;
+		uint32_t size, left;
+	} h = { { G_DATA, OUR_CHANNEL, 0 }, length, 0 };
+	int found = -1;
+
+	for (uint32_t t = 0; t < 1000 && found < 0; t++) {
+		pump();
+		for (unsigned n = 0; n < 32; n++) {
+			if (their_intents[n].there && !their_intents[n].in_use && their_intents[n].size >= length &&
+			    (found < 0 || their_intents[n].size < their_intents[found].size)) {
+				found = (int)n;
+			}
+		}
+		if (found >= 0 && room() < ((length + sizeof(h) + 7) & ~7u)) {
+			found = -1;
+		}
+		if (found < 0) {
+			sleep_ms(1);
+		}
+	}
+	if (found < 0) {
+		return false;
+	}
+	their_intents[found].in_use = true;
+	h.m.param2 = their_intents[found].id;
+	return gput(&h, sizeof(h), data, length);
+}
+
+static void
+typec_ucsi_read(const char *why)
+{
+	const uint32_t q[3] = { 32779u, 1, 0x11 };
+	const uint32_t before = typec_ucsi;
+
+	say("icetypec: > UCSI read buffer (%s): %s\n", why, glink_send(q, sizeof(q)) ? "sent" : "NOT sent (no intent)");
+	wait_pumping(1500);
+	say("icetypec: %u UCSI message%s in 1.5 s\n", typec_ucsi - before, typec_ucsi - before == 1 ? "" : "s");
+}
+
+static void
+typec_ucsi_command(uint64_t command, const char *what, bool v2)
+{
+	struct {
+		uint32_t hdr[3];
+		uint8_t buf[528];
+		uint32_t reserved;
+	} w;
+	const uint32_t buf_len = v2 ? 528u : 48u, before = typec_ucsi;
+
+	bzero(&w, sizeof(w));
+	w.hdr[0] = 32779u;
+	w.hdr[1] = 1;
+	w.hdr[2] = 0x12;
+	memcpy(w.buf + 8, &command, sizeof(command));              /* UCSI_CONTROL; the reserved word after the buffer stays 0 */
+	say("icetypec: > UCSI %s (command %#llx, %u-byte buffer): %s\n", what, command, buf_len,
+	    glink_send(&w, 12 + buf_len + 4) ? "sent" : "NOT sent (no intent)");
+	wait_pumping(1500);
+	say("icetypec: %u UCSI message%s in 1.5 s after %s\n", typec_ucsi - before, typec_ucsi - before == 1 ? "" : "s", what);
+	typec_ucsi_read(what);
+}
+
+static void
+typec_ask(void)
+{
+	(void)typec_gate();
+	if (typec_on < 2) {
+		return;
+	}
+	const uint32_t at_ucsi = typec_ucsi, at_pan = typec_pan;
+	const uint32_t pan[6] = { 32780u, 1, 0x15, 0x10, 0, 0 };
+	uint32_t before;
+	bool v2;
+
+	typec_rd_len = 0;
+	typec_ucsi_read("version and CCI");
+	v2 = typec_rd_len > 12 + 48 + 4;
+	say("icetypec: the read answer is %u bytes: UCSI %s buffers\n", typec_rd_len, typec_rd_len == 0 ? "1.x (no answer: assumed)" :
+	    v2 ? "2.x (528-byte)" : "1.x (48-byte)");
+	typec_ucsi_command(0x01, "PPM_RESET", v2);
+	typec_ucsi_command(0xdbe70005ull, "SET_NOTIFICATION_ENABLE (all)", v2);
+	typec_ucsi_command(0x20004ull, "ACK_CC_CI (command complete)", v2);
+	typec_ucsi_command(0x06ull, "GET_CAPABILITY", v2);  /* (piano 97ac828's PPM init order, PAD8PRO-SWEEP P5) */
+	typec_ucsi_command(0x20004ull, "ACK_CC_CI (command complete)", v2);
+	typec_ucsi_command(0x12ull | 1ull << 16, "GET_CONNECTOR_STATUS 1", v2);
+	typec_ucsi_command(0x20004ull, "ACK_CC_CI (command complete)", v2);
+	before = typec_pan;
+	say("icetypec: > PAN enable (owner 32780, opcode 0x15, cmd 0x10): %s\n", glink_send(pan, sizeof(pan)) ? "sent" :
+	    "NOT sent (no intent)");
+	wait_pumping(3000);
+	say("icetypec: asked: %u UCSI and %u PAN message%s came back (%u PAN in the 3 s after the enable)\n",
+	    typec_ucsi - at_ucsi, typec_pan - at_pan, typec_ucsi - at_ucsi + typec_pan - at_pan == 1 ? "" : "s",
+	    typec_pan - before);
+}
+
+/* ---- the gauge, and the mean of its current -------------------------------------------------------------------- */
+
+static uint32_t gauge[GAUGE_WORDS], gauge_bytes;
+static bool gauge_ok;   /* the last read_gauge() was answered (icebatt=6's guard needs a fresh reading) */
+static struct {
+	int64_t sum;
+	int32_t low, high;
+	uint32_t n;
+} mean;
+
+static bool
+read_gauge(void)
+{
+	uint32_t q[4] = { OWNER_BATTMGR, TYPE_REQUEST, OP_OPLUS_GAUGE_READ, GAUGE_WORDS * 4 };
+	int32_t ma;
+
+	gauge_ok = false;
+	if (!request(q, sizeof(q), OP_OPLUS_GAUGE_READ, 1000) || answer_length < 12 + 9 * 4) {
+		return false;
+	}
+	gauge_ok = true;
+	bzero(gauge, sizeof(gauge));
+	memcpy(gauge, answer + 12, LESSER(answer_length - 12, sizeof(gauge)));
+	gauge_bytes = answer_length;
+	ma = -(int32_t)gauge[1];
+	if (mean.n == 0 || ma < mean.low) {
+		mean.low = ma;
+	}
+	if (mean.n == 0 || ma > mean.high) {
+		mean.high = ma;
+	}
+	mean.sum += ma;
+	mean.n++;
+	return true;
+}
+
+/* the mean current of `n` gauge readings `every_ms` apart, mA (charging > 0) */
+static int32_t
+mean_of(unsigned n, uint32_t every_ms)
+{
+	int64_t sum = 0;
+	unsigned got = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		wait_pumping(every_ms);
+		if (read_gauge()) {
+			sum += -(int32_t)gauge[1];
+			got++;
+		}
+	}
+	return got != 0 ? (int32_t)(sum / got) : 0;
+}
+
+/* ---- the charger (icebatt=5) ----------------------------------------------------------------------------------- */
+
+/*
+ * The decision is hakios_iceland_charger_plan.h's (its head has the rule, stage A's numbers and the adapter types):
+ * the firmware's own limits stand, nothing of them is lowered, and a limit goes up only for a Type-C or PD source,
+ * up to what the firmware says the source gives. Here are the reads, the writes and this driver's guard.
+ *
+ * WRITES, each a request to the charger firmware over the open channel, and only these:
+ *   0x300 / 71 = 9000    9 V from a PD source (never 12 V), when the plan says so
+ *   0x300 / 71 = 5000    that request taken back: 9 V did not come or did not hold (2 s later VBUS under 7500 mV, a
+ *                        VBUS collapse, the source naming less current than the limit in force, or a value not
+ *                        answered); the guard; the battery at 4500 mV; a changed adapter type
+ *   0x300 / 5  = uA      the input limit one of stock's steps up (500 900 1200 1350 1500 1750 2000 mA), 50 ms a step,
+ *                        each step checked (no VBUS collapse, VBUS at or above the point); a step that does not hold:
+ *                        the last one that did, or the firmware's own value, again
+ *   0x300 / 70 = 0, 1    the guard only: charging off below -10 C, from 53 C, above 4508 mV at the battery or 11 V
+ *                        at the port twice in a row; on again inside
+ * icebatt=6 adds, and only these:
+ *   0x300 / 70 = 1       charging on: at every attach and when the guard lets it go on again (icechg_enable_want())
+ *   0x300 / 70 = 0       charging off: one reading out of 12 .. 45 C / 4508 mV / 11 V, or a value not answered
+ *   0x31  / 10 = uA      the charge current limit LOWERED to stock's row for the type (icechg_fcc_lower_ma())
+ *   each followed by a read-back (0x301 / 70, 0x30 / 10)
+ * Never written: the charge current limit at icebatt=5, or above the firmware's own; the input unsuspend word
+ * (0xffffffff; an input the firmware suspended is left alone); an input limit below the firmware's; 12 V.
+ * This driver's own guard (not stock's, not Linux's): outside 12 .. 45 C nothing is raised and what was raised here
+ * is taken back.
+ */
+#define OP_BAT_PROPERTY_SET     0x31
+#define OP_OPLUS_SET            0x300
+#define OP_OPLUS_GET            0x301
+#define BATT_CHG_TYPE           3
+#define BATT_CHG_CTRL_LIM       10
+#define BATT_TTF_AVG            19
+#define BATT_TTE_AVG            20
+#define USB_VOLT_NOW            1
+#define USB_CURR_NOW            3
+#define USB_CURR_MAX            4
+#define USB_INPUT_CURR_LIMIT    5
+#define USB_TYPE                6
+#define USB_ADAP_TYPE           7
+#define OPLUS_INPUT_CURR_LIMIT  5
+#define OPLUS_VBUS_COLLAPSE     9
+#define OPLUS_CHG_EN            70
+#define OPLUS_SET_PDO           71
+#define TYPE_CHANGES_MAX        5
+
+static struct {
+	bool seen;              /* this attach was looked at */
+	bool stopped, low;      /* the guard: charging off; no raise */
+	bool ours_9v;           /* 9 V is in force by this driver's request */
+	bool failed_9v;         /* a 9 V request of this attach did not hold */
+	uint32_t ours_icl_ma;   /* not 0: the input limit this driver raised it to */
+	uint32_t fw_icl_ua;     /* the firmware's own input limit, as read before any raise */
+	uint32_t adapter, changes, writes, refused, over, vbus_uv;
+	/* icebatt=6 */
+	bool en_done;           /* the charge enable was set in this attach (to !stopped) */
+	bool stop_mv;           /* the guard stopped charging for the battery's voltage */
+	uint32_t en_writes;     /* charge enable writes this boot, both ways */
+} chg;
+
+static uint32_t chg_stage;      /* the icebatt= stage, 5 or 6 here */
+
+/* the adapter type as the power source's type: 0-9 as they are, VOOC .. SVOOC as DCP */
+static uint32_t
+usb_type_of(uint32_t adapter)
+{
+	return adapter <= 9 ? adapter : adapter <= 13 ? 2 : 0;
+}
+
+static bool
+set_property(uint32_t opcode, uint32_t property, uint32_t value, const char *what)
+{
+	uint32_t q[6] = { OWNER_BATTMGR, TYPE_REQUEST, opcode, 0, property, value };
+
+	chg.writes++;
+	if (!request(q, sizeof(q), opcode, 1000)) {
+		chg.refused++;
+		say("charger: %s (%#x / %u = %u): NO ANSWER\n", what, opcode, property, value);
+		return false;
+	}
+	/* stock: a reply of property, value, result with a result other than 0 is an error */
+	if (answer_length == 24 && *(uint32_t *)(answer + 20) != 0) {
+		chg.refused++;
+		say("charger: %s (%#x / %u = %u): REFUSED by the firmware, result %u\n", what, opcode, property, value,
+		    *(uint32_t *)(answer + 20));
+		return false;
+	}
+	say("charger: WRITE %s (%#x / %u = %u)\n", what, opcode, property, value);
+	return true;
+}
+
+/* what the firmware has in force; the input limit also as it was read (uA), the rest for the log only */
+static void
+read_state(struct icechg_state *s, uint32_t *icl_ua, uint32_t *fcc_ma, uint32_t *usb_type)
+{
+	uint32_t v = 0;
+	bool have = read_gauge();
+
+	bzero(s, sizeof(*s));
+	s->batt_mv = have ? gauge[2] : 0;
+	have = get_property(OP_USB_PROPERTY_GET, USB_ADAP_TYPE, &s->adapter) && have;
+	if (get_property(OP_USB_PROPERTY_GET, USB_VOLT_NOW, &v)) {
+		s->vbus_mv = v / 1000;
+	} else {
+		have = false;
+	}
+	if (get_property(OP_USB_PROPERTY_GET, USB_CURR_MAX, &v)) {
+		s->source_ma = v / 1000;
+	} else {
+		have = false;
+	}
+	*icl_ua = 0;
+	if (get_property(OP_USB_PROPERTY_GET, USB_INPUT_CURR_LIMIT, icl_ua)) {
+		s->icl_ma = *icl_ua / 1000;
+	} else {
+		have = false;
+	}
+	*fcc_ma = get_property(OP_BAT_PROPERTY_GET, BATT_CHG_CTRL_LIM, &v) ? v / 1000 : 0;
+	*usb_type = get_property(OP_USB_PROPERTY_GET, USB_TYPE, &v) ? v : 0;
+	s->have = have;
+	s->hold = chg.low || chg.stopped;
+	s->tried_9v = chg.ours_9v || chg.failed_9v;
+}
+
+/* the step just written holds: no VBUS collapse, and VBUS at or above the point */
+static bool
+step_held(uint32_t point_mv, bool *collapse_asked, uint32_t *mv)
+{
+	uint32_t v = 0;
+
+	wait_pumping(50);
+	if (*collapse_asked) {
+		if (!get_property(OP_OPLUS_GET, OPLUS_VBUS_COLLAPSE, &v)) {
+			*collapse_asked = false;        /* not answered: not asked again in this ladder */
+		} else if (v != 0) {
+			return false;
+		}
+	}
+	if (!get_property(OP_USB_PROPERTY_GET, USB_VOLT_NOW, &v)) {
+		return false;                           /* VBUS not readable: the step does not count */
+	}
+	*mv = v / 1000;
+	return *mv >= point_mv;
+}
+
+/* this driver's own raises taken back: the firmware's input limit and 5 V again */
+static void
+take_back(const char *why)
+{
+	if (chg.ours_icl_ma == 0 && !chg.ours_9v) {
+		return;
+	}
+	say("charger: this driver's raise is taken back (%s)\n", why);
+	if (chg.ours_icl_ma != 0) {
+		(void)set_property(OP_OPLUS_SET, OPLUS_INPUT_CURR_LIMIT, chg.fw_icl_ua, "input current limit, the firmware's own again");
+		chg.ours_icl_ma = 0;
+	}
+	if (chg.ours_9v) {
+		(void)set_property(OP_OPLUS_SET, OPLUS_SET_PDO, ICECHG_5V_MV, "5 V again");
+		chg.ours_9v = false;
+	}
+}
+
+/* 9 V asked of a PD source; 2 s later it holds, or the request is taken back */
+static void
+ask_9v(void)
+{
+	uint32_t v = 0, collapse = 0, source = 0, icl = 0;
+	enum icechg_9v outcome = ICECHG_9V_TAKE_BACK;
+	bool seen;
+
+	(void)set_property(OP_OPLUS_SET, OPLUS_SET_PDO, ICECHG_9V_MV, "9 V request");
+	wait_pumping(2000);
+	(void)get_property(OP_OPLUS_GET, OPLUS_VBUS_COLLAPSE, &collapse);
+	seen = get_property(OP_USB_PROPERTY_GET, USB_VOLT_NOW, &v);
+	seen = get_property(OP_USB_PROPERTY_GET, USB_CURR_MAX, &source) && seen;
+	seen = get_property(OP_USB_PROPERTY_GET, USB_INPUT_CURR_LIMIT, &icl) && seen;
+	if (seen) {
+		outcome = icechg_9v_outcome(v / 1000, collapse != 0, source / 1000, icl / 1000);
+	}
+	say("charger: 2 s after the 9 V request: VBUS %u mV, collapse %u, source max %u mA, input limit %u mA%s: %s\n", v / 1000,
+	    collapse, source / 1000, icl / 1000, seen ? "" : " (a value NOT ANSWERED)",
+	    outcome == ICECHG_9V_HELD ? "9 V HOLDS" : outcome == ICECHG_9V_STAYED_5V ? "the source stayed at 5 V" :
+	    "9 V does NOT hold");
+	if (outcome == ICECHG_9V_HELD) {
+		chg.ours_9v = true;
+		return;
+	}
+	chg.failed_9v = true;
+	(void)set_property(OP_OPLUS_SET, OPLUS_SET_PDO, ICECHG_5V_MV, "5 V again (the 9 V request taken back)");
+}
+
+/* the input limit up from the firmware's value towards `to_ma`, in stock's steps, each one checked */
+static void
+raise_input(const struct icechg_state *s, uint32_t icl_ua, uint32_t to_ma)
+{
+	uint32_t point = icechg_hold_mv(s->vbus_mv, s->batt_mv), held = s->icl_ma, step, mv = 0;
+	bool collapse_asked = true, ok = true;
+
+	for (step = icechg_next_step(held, to_ma); step != 0; step = icechg_next_step(step, to_ma)) {
+		ok = set_property(OP_OPLUS_SET, OPLUS_INPUT_CURR_LIMIT, step * 1000, "input current limit, a step up") &&
+		    step_held(point, &collapse_asked, &mv);
+		if (!ok) {
+			break;
+		}
+		held = step;
+	}
+	if (!ok) {
+		/* back to the last step that held; if none did, to the value that was in force */
+		(void)set_property(OP_OPLUS_SET, OPLUS_INPUT_CURR_LIMIT, held == s->icl_ma ? icl_ua : held * 1000,
+		    "input current limit, the last one that held");
+	}
+	if (held != s->icl_ma) {
+		chg.ours_icl_ma = held;
+	}
+	say("charger: the input limit %u -> %u mA (asked %u mA; the point %u mV, VBUS at the last step %u mV)\n", s->icl_ma, held,
+	    to_ma, point, mv);
+}
+
+/* icebatt=6: the charge current limit lowered to stock's row for the type, where the firmware's is above it */
+static void
+fcc_lower(uint32_t adapter, uint32_t fw_fcc_ma)
+{
+	uint32_t to_ma = icechg_fcc_lower_ma(adapter, fw_fcc_ma), v = 0;
+	bool back;
+
+	if (to_ma == 0) {
+		say("charger: fcc %u mA stands (row %u)\n", fw_fcc_ma, icechg_fcc_row_ma(adapter));
+		return;
+	}
+	(void)set_property(OP_BAT_PROPERTY_SET, BATT_CHG_CTRL_LIM, to_ma * 1000, "fcc down");
+	back = get_property(OP_BAT_PROPERTY_GET, BATT_CHG_CTRL_LIM, &v);
+	say("charger: fcc %u -> %u mA, back %u%s\n", fw_fcc_ma, to_ma, v / 1000, back ? "" : " ?");
+}
+
+/*
+ * icebatt=6: the charge enable set to `on`, the firmware's value read before (the first time in an attach) and after.
+ * True if the firmware took the set.
+ */
+static bool
+charge_enable(bool on, const char *why)
+{
+	uint32_t before = 0, after = 0;
+	bool have_before = false, have_after, ok;
+
+	if (!chg.en_done) {
+		have_before = get_property(OP_OPLUS_GET, OPLUS_CHG_EN, &before);
+	}
+	ok = set_property(OP_OPLUS_SET, OPLUS_CHG_EN, on ? 1 : 0, "chg_en");
+	chg.en_writes++;
+	have_after = get_property(OP_OPLUS_GET, OPLUS_CHG_EN, &after);
+	say("charger: CHARGING %s (%s): found %d, set %s, back %d (%u)\n", on ? "ON" : "OFF", why,
+	    chg.en_done ? -2 : have_before ? (int)before : -1, ok ? "ok" : "NOT TAKEN", have_after ? (int)after : -1,
+	    chg.en_writes);
+	return ok;
+}
+
+/* an attach, a changed type, or the guard's end: what the firmware has, and what (if anything) is raised */
+static void
+charger_decide(void)
+{
+	struct icechg_state s;
+	struct icechg_plan p;
+	uint32_t icl_ua = 0, fcc_ma = 0, usb_type = 0, writes = chg.writes;
+
+	read_state(&s, &icl_ua, &fcc_ma, &usb_type);
+	if (s.have && chg.ours_icl_ma == 0) {
+		chg.fw_icl_ua = icl_ua;
+	}
+	chg.seen = true;
+	chg.adapter = s.adapter;
+	say("charger: AS FOUND: adapter %u (%s), usb type %u, VBUS %u mV, source max %u mA, input limit %u mA, charge limit "
+	    "%u mA, battery %u mV%s\n", s.adapter, icechg_adapter_name(s.adapter), usb_type, s.vbus_mv, s.source_ma, s.icl_ma,
+	    fcc_ma, s.batt_mv, s.have ? "" : " (a value NOT ANSWERED)");
+	if (chg_stage >= 6) {
+		fcc_lower(s.adapter, fcc_ma);
+	}
+	icechg_plan(&s, &p);
+	if (p.ask_9v) {
+		say("charger: %s\n", p.why);
+		ask_9v();
+		read_state(&s, &icl_ua, &fcc_ma, &usb_type);
+		icechg_plan(&s, &p);
+	}
+	if (p.icl_ma != 0 && !p.ask_9v) {
+		say("charger: %s\n", p.why);
+		raise_input(&s, icl_ua, p.icl_ma);
+	}
+	if (chg.writes == writes) {
+		say("charger: NO WRITE: %s\n", p.why);
+	} else {
+		say("charger: DONE: 9 V %s, the input limit %s (the firmware's own %u mA); %u writes so far, %u not taken; then: %s\n",
+		    chg.ours_9v ? "in force by this driver" : chg.failed_9v ? "asked and taken back" : "not asked",
+		    chg.ours_icl_ma != 0 ? "raised" : "as the firmware has it", chg.fw_icl_ua / 1000, chg.writes, chg.refused, p.why);
+	}
+}
+
+/* every 5 s, after a gauge reading: a new attach, a changed type, and the guard */
+static void
+charger_poll(void)
+{
+	uint32_t online = 0, adapter = 0, v = 0;
+	int32_t t = (int32_t)gauge[0];          /* 0.1 C */
+	bool stop, low, have_v, again = false;
+
+	if (!get_property(OP_USB_PROPERTY_GET, USB_ONLINE, &online)) {
+		/* icebatt=6: a value not answered is out of range: charging off if this driver has it on */
+		if (chg_stage >= 6 && chg.en_done && !chg.stopped) {
+			take_back("online ?");
+			if (charge_enable(false, "online ?")) {
+				chg.stopped = true;
+				chg.stop_mv = false;
+			}
+		}
+		return;
+	}
+	if (!online) {
+		if (chg.seen) {
+			say("charger: gone (after %u type changes); the firmware starts the next attach with its defaults\n", chg.changes);
+		}
+		chg.seen = chg.stopped = chg.low = chg.ours_9v = chg.failed_9v = chg.en_done = chg.stop_mv = false;
+		chg.ours_icl_ma = chg.fw_icl_ua = chg.changes = chg.over = 0;
+		return;
+	}
+	/* too much at the battery or at the port twice in a row counts, a single reading does not */
+	have_v = get_property(OP_USB_PROPERTY_GET, USB_VOLT_NOW, &v);
+	if (!have_v) {
+		v = chg.vbus_uv;                /* not answered: the last reading stands (icebatt=6: out of range) */
+	}
+	chg.vbus_uv = v;
+	chg.over = icechg_guard_over(gauge[2], v / 1000) ? chg.over + 1 : 0;
+	stop = chg_stage >= 6 ? chg.stopped : icechg_guard_stop(chg.stopped, t, gauge[2], v / 1000, chg.over);
+	low = icechg_guard_low(chg.low, t);
+	if (stop != chg.stopped) {
+		chg.stopped = stop;
+		say("charger: guard: charging %s (battery %d.%u C, %u mV; VBUS %u mV)\n", stop ? "OFF" : "on again", t / 10,
+		    (uint32_t)(t < 0 ? -t : t) % 10, gauge[2], v / 1000);
+		if (stop) {
+			take_back("the guard stops charging");
+		}
+		(void)set_property(OP_OPLUS_SET, OPLUS_CHG_EN, !stop, "charge enable");
+		again = !stop;
+	}
+	if (low != chg.low) {
+		chg.low = low;
+		say("charger: guard: %s (battery %d.%u C)\n", low ? "NO RAISE outside 12 .. 45 C" : "inside 14 .. 43 C again", t / 10,
+		    (uint32_t)(t < 0 ? -t : t) % 10);
+		if (low) {
+			take_back("the battery's temperature");
+		} else {
+			again = true;
+		}
+	}
+	if (chg.ours_9v && gauge[2] >= ICECHG_9V_BATT_MV) {
+		take_back("the battery is at 4500 mV: stock's end of 9 V");
+	}
+	if (get_property(OP_USB_PROPERTY_GET, USB_ADAP_TYPE, &adapter) && chg.seen && adapter != chg.adapter) {
+		if (icechg_kind_of(adapter) != icechg_kind_of(chg.adapter)) {
+			take_back("the adapter type changed");
+			chg.failed_9v = false;
+		}
+		if (chg.changes < TYPE_CHANGES_MAX) {
+			chg.changes++;
+			say("charger: the adapter type changed, %u -> %u (change %u of this attach)\n", chg.adapter, adapter, chg.changes);
+			again = true;
+		}
+		chg.adapter = adapter;
+	}
+	if (!chg.seen) {
+		wait_pumping(500);              /* stock's and Linux's grace after an attach */
+		again = true;
+	}
+	if (chg_stage >= 6) {
+		/* the owner's stage B guard; at the attach's first poll the charge enable is set either way */
+		bool fresh = gauge_ok && have_v;
+		bool want = icechg_enable_want(chg.stopped, chg.stop_mv, fresh, t, gauge[2], v / 1000);
+
+		if (!chg.en_done || want == chg.stopped) {
+			bool was_stopped = chg.stopped, by_mv = fresh && gauge[2] > ICECHG_EN_BATT_MV;
+
+			say("charger: guard %s (%d.%u C, %u mV, VBUS %u mV%s)\n", want ? "in" : "OUT", t / 10,
+			    (uint32_t)(t < 0 ? -t : t) % 10, gauge[2], v / 1000, fresh ? "" : ", a value ?");
+			if (!want) {
+				take_back("guard");
+			}
+			if (charge_enable(want, !chg.en_done ? "attach" : "guard")) {
+				chg.en_done = true;
+				chg.stopped = !want;
+				chg.stop_mv = !want && by_mv;
+				again = again || (want && was_stopped);
+			}
+		}
+	}
+	if (again) {
+		charger_decide();
+	}
+}
+
+/* ---- what the backlight takes (icebatt_load=S) ------------------------------------------------------------------ */
+
+extern uint32_t hakios_iceland_backlight_level(void);
+extern int hakios_iceland_backlight_power(int on);
+
+static void
+load_test(void)
+{
+	uint32_t level = hakios_iceland_backlight_level();
+	int32_t with, without, again;
+	int error;
+	__typeof__(mean) kept = mean;           /* the round's mean does not take the dark seconds */
+
+	if (level == 0) {
+		say("load: the backlight is off or not driven (icebl=2 needed): no test\n");
+		return;
+	}
+	with = mean_of(10, 1500);
+	if (hakios_iceland_backlight_level() == 0 || (error = hakios_iceland_backlight_power(0)) != 0) {
+		say("load: the backlight went off by itself or cannot be turned off: no test\n");
+		mean = kept;
+		return;
+	}
+	wait_pumping(3000);
+	without = mean_of(10, 1500);
+	error = hakios_iceland_backlight_power(1);
+	wait_pumping(3000);
+	again = mean_of(10, 1500);
+	mean = kept;
+	say("load: backlight level %u: battery %d mA with it, %d mA without it, %d mA with it again (15 s each, %u mV; "
+	    "back on: %d): the backlight takes about %d mW; the rest of the load moved by %d mA meanwhile\n", level, with,
+	    without, again, gauge[2], error, (int32_t)((int64_t)(without - (with + again) / 2) * gauge[2] / 1000), again - with);
+}
+
+/* ---- a round ----------------------------------------------------------------------------------------------------- */
+
+static void
+battery_round(unsigned round)
+{
+	uint32_t status = 0, online = 0, usb_uv = 0, usb_ua = 0, usb_max = 0, usb_limit = 0, usb_type = 0, adapter = 0;
+	uint32_t fcc = 0, chg_type = 0, n;
+	bool have_gauge, have_status, have_online, have_v, have_i, have_adapter;
+	int32_t now_ma, mean_ma, low, high, in_mw, batt_mw;
+	struct redwood_battery_state b;
+	const uint32_t *g = gauge;
+
+	have_gauge = read_gauge();
+	have_status = get_property(OP_BAT_PROPERTY_GET, BATT_STATUS, &status);
+	have_online = get_property(OP_USB_PROPERTY_GET, USB_ONLINE, &online);
+	if (!have_gauge) {
+		say("round %u: no gauge answer (status %s %u, usb online %s %u)\n", round, have_status ? "" : "?", status,
+		    have_online ? "" : "?", online);
+		return;
+	}
+	now_ma = -(int32_t)g[1];
+	n = mean.n;
+	mean_ma = (int32_t)(mean.sum / (int64_t)n);
+	low = mean.low;
+	high = mean.high;
+	mean.sum = 0;
+	mean.n = 0;
+	say("round %u: gauge (%u bytes): %u.%02u %%, %u mV, %d mA (charging > 0), %d.%u C, full %u mAh, cycles %u, "
+	    "health %u %%; status %u%s, usb online %u%s\n", round, gauge_bytes, g[3] / 100, g[3] % 100, g[2],
+	    now_ma, (int32_t)g[0] / 10, (uint32_t)((int32_t)g[0] < 0 ? -(int32_t)g[0] : (int32_t)g[0]) % 10, g[6], g[5], g[8],
+	    status, have_status ? "" : "?", online,
+	    have_online ? "" : "?");
+	if (round <= 1) {
+		say("gauge words 0-15: %u %u %u %u %u %u %u %u %u %u %u %u %u %u %u %u\n", g[0], g[1], g[2], g[3], g[4], g[5],
+		    g[6], g[7], g[8], g[9], g[10], g[11], g[12], g[13], g[14], g[15]);
+	}
+	/* what the port gives and what the charger may take: gets only */
+	have_v = get_property(OP_USB_PROPERTY_GET, USB_VOLT_NOW, &usb_uv);
+	have_i = get_property(OP_USB_PROPERTY_GET, USB_CURR_NOW, &usb_ua);
+	(void)get_property(OP_USB_PROPERTY_GET, USB_INPUT_CURR_LIMIT, &usb_limit);
+	(void)get_property(OP_USB_PROPERTY_GET, USB_CURR_MAX, &usb_max);
+	(void)get_property(OP_USB_PROPERTY_GET, USB_TYPE, &usb_type);
+	have_adapter = get_property(OP_USB_PROPERTY_GET, USB_ADAP_TYPE, &adapter);
+	(void)get_property(OP_BAT_PROPERTY_GET, BATT_CHG_CTRL_LIM, &fcc);
+	(void)get_property(OP_BAT_PROPERTY_GET, BATT_CHG_TYPE, &chg_type);
+	in_mw = have_v && have_i ? (int32_t)((int64_t)(usb_uv / 1000) * (int32_t)usb_ua / 1000000) : 0;
+	batt_mw = (int32_t)((int64_t)mean_ma * g[2] / 1000);
+	say("power %u: usb %u mV, %d mA%s (limit %u mA, source max %u mA, type %u, adapter %u) = %d mW in; battery mean "
+	    "%d mA of %u samples (%d .. %d) = %d mW; the tablet takes %d mW; charge limit %u mA, charge type %u\n", round,
+	    usb_uv / 1000, (int32_t)usb_ua / 1000, have_v && have_i ? "" : " ?", usb_limit / 1000, usb_max / 1000, usb_type,
+	    adapter, in_mw, mean_ma, n, low, high, batt_mw, in_mw - batt_mw, fcc / 1000, chg_type);
+	if (round <= 3) {
+		/*
+		 * The firmware's own time estimates (battery properties 19 and 20; Linux reads them as seconds): only
+		 * said, to learn whether this firmware answers them and in what unit. The power source's times stay
+		 * RedwoodBattery's, from the charge and the mean current (none within 10 mA of zero).
+		 */
+		uint32_t to_full = 0, to_empty = 0;
+		bool have_full = get_property(OP_BAT_PROPERTY_GET, BATT_TTF_AVG, &to_full);
+		bool have_empty = get_property(OP_BAT_PROPERTY_GET, BATT_TTE_AVG, &to_empty);
+
+		say("times %u: the firmware's time to full %u%s, to empty %u%s (properties 19, 20, as answered)\n", round, to_full,
+		    have_full ? "" : " ?", to_empty, have_empty ? "" : " ?");
+	}
+	bzero(&b, sizeof(b));
+	b.size = sizeof(b);
+	b.percent_hundredths = (int32_t)LESSER(g[3], 10000u);
+	b.voltage_uv = (int32_t)g[2] * 1000;
+	b.current_ua = mean_ma * 1000;
+	b.temperature_hundredths = (int32_t)g[0] * 10;
+	b.present = 1;
+	b.external = have_online ? (online != 0) : (mean_ma > 0);
+	/* as the owner's Linux driver: the status follows the mean current, with 20 mA either side of 0 as "not charging" */
+	b.status = !b.external ? 2 : g[3] >= 10000 ? 4 : mean_ma > 20 ? 1 : mean_ma < -20 ? 2 : 3;
+	b.full_uah = (int32_t)g[6] * 1000;
+	b.charge_uah = (int32_t)((uint64_t)g[6] * LESSER(g[3], 10000u) / 10);
+	b.design_uah = DESIGN_UAH;
+	b.cycles = (int32_t)g[5];
+	if (b.external) {
+		b.usb_type = have_adapter ? (int32_t)usb_type_of(adapter) : 0;
+		b.usb_voltage_uv = have_v ? (int32_t)usb_uv : 0;
+		b.usb_current_ua = have_i ? (int32_t)usb_ua : 0;
+	}
+	redwood_battery_report(&b);
+}
+
+/*
+ * ---- lane E (24 Nov): iceusbh= TC / DP / VBUS on this channel (bsd/dev/hakios_iceland_usbh.h names every bit) ----------
+ * Why w7-usb's usbh0 (20 Nov) saw no Type-C message: (1) its observer read the owner at +4 (the type word): every message
+ * was "an owner this does not know (1)" (the three such lines of that run were battery answers; gains1 fixed it), and
+ * (2) the SoCCP's port manager sends UCSI only to an OPM that has reset it and enabled notifications (Linux ucsi.c:
+ * ucsi_init), and the PAN side only after PAN enable: icetypec=1 only listened, and icetypec=2 never ran on the tablet.
+ * Here, with iceusbh's TC bit, the OPM is the UCSI state machine of hakios_iceland_ucsi.h (UniXNU QcomDwc3's, BSD-2-
+ * Clause-Patent), run from this thread: the SoCCP's UCSI / PAN messages (and, with VBUS, the battery manager's
+ * notifications) are queued by typec_seen() from inside pump() and acted on by usbh_service() between pumps.
+ * Messages sent (all of them GLINK requests to the charger firmware on the already open channel; nothing else):
+ *   TC   UCSI owner 32779 type 1: read buffer (0x11); write buffer (0x12) with PPM_RESET 0x01,
+ *        SET_NOTIFICATION_ENABLE 0x05 (0, then 0xdbe70000), ACK_CC_CI 0x04 (bit 16 change, bit 17 command),
+ *        GET_CONNECTOR_STATUS 0x12 (connector 1)
+ *   DP   owner 32780 type 1 opcode 0x15: cmd 0x10 PAN enable (once), cmd 0x11 PAN ack (port) after each notification
+ *   VBUS owner 32778: type 2 opcode 4 (notification request, as Linux's enable worker); OPLUS sets 0x300: 12 OTG AP
+ *        enable = 1 (at start and as the attach retry, at most 3 an attach), 59 boost current = iceusbh_ma, 19 VBUS enable
+ *        = 1 / 0, 13 OTG switch = 0 (detach); gets 0x301 / 16 (cable), 0x32 / 0 (USB online), the gauge
+ * Linux facts (GPL-2.0, facts only, linux a2e1ea44d3c3): drivers/power/supply/qcom_battmgr.c:116-175 (OPLUS properties
+ * and notifications 0x50 OTG enable / 0x51 disable / 0x53 cable), :2006-2018, :3172-3290 (the OTG rules: the boost only
+ * after 0x50 -- earlier "wedges the port controller until reboot" --, off with a charger or no cable, the attach retry
+ * 3 x 3 s), :583-610 (the notification request); drivers/soc/qcom/pmic_glink_altmode.c:1-80 (PAN messages and layout).
+ */
+#include <kern/kalloc.h>
+#include "hakios_iceland_ucsi.h"
+#include "hakios_iceland_usbh.h"
+
+#define USBH_SLOTS      4
+#define OPLUS_OTG_AP_ENABLE     12
+#define OPLUS_OTG_SWITCH        13
+#define OPLUS_CID_STATUS        16
+#define OPLUS_OTG_VBUS_ENABLE   19
+#define OPLUS_OTG_BOOST_MA      59
+
+static struct usbh_mem {
+	struct { uint8_t b[UCSI_KEEP]; uint32_t kept, len; } slot[USBH_SLOTS];
+	uint8_t out[UCSI_MAX_MESSAGE];
+	struct iceland_ucsi ucsi;
+} *usbh;
+static uint32_t usbh_head, usbh_tail, usbh_lost, usbh_busy, usbh_ticks, usbh_restarts, usbh_said_gen = ~0u, usbh_said_status;
+static uint32_t usbh_notif;             /* VBUS: battery manager notifications seen (bits: 0 OTG enable, 1 disable, 2 cable) */
+static uint64_t usbh_last_rx;
+static struct {
+	uint32_t ma, limit_s, on_s, retries;
+	bool started, on, sourcing, released, refused;
+} vb;
+
+static uint64_t
+usbh_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000;
+}
+
+/* from typec_seen(), inside pump(): a message of the UCSI or PAN owner, or a battery manager notification, kept */
+static bool
+usbh_queue(const uint8_t *p, uint32_t n, uint32_t owner, uint32_t type, uint32_t opcode)
+{
+	if (usbh == NULL) {
+		return false;
+	}
+	if (owner == 32778u) {
+		if (!(usbh_bits & ICEUSBH_VBUS) || type != 2 || opcode != 7 || n < 16) {
+			return false;
+		}
+		uint32_t code = p[12];
+
+		usbh_notif |= code == 0x50 ? 1u : code == 0x51 ? 2u : code == 0x53 ? 4u : 0u;
+		if (code == 0x50) {
+			vb.sourcing = true;
+		} else if (code == 0x51) {
+			vb.sourcing = false;
+		}
+		return true;
+	}
+	if ((owner == 32779u && !(usbh_bits & ICEUSBH_TC)) || (owner == 32780u && !(usbh_bits & ICEUSBH_DP))) {
+		return false;
+	}
+	if (usbh_head - usbh_tail >= USBH_SLOTS) {
+		usbh_lost++;
+		return true;
+	}
+	struct usbh_mem *m = usbh;
+	uint32_t s = usbh_head % USBH_SLOTS, k = n < UCSI_KEEP ? n : UCSI_KEEP;
+
+	memcpy(m->slot[s].b, p, k);
+	m->slot[s].kept = k;
+	m->slot[s].len = n;
+	usbh_head++;
+	(void)opcode;
+	return true;
+}
+
+static void
+usbh_send(uint32_t n)
+{
+	if (n != 0 && !glink_send(usbh->out, n)) {
+		say("iceusbh: no intent (%u B)\n", n);
+	}
+}
+
+static void
+usbh_pan(const uint8_t *p, uint32_t n)
+{
+	uint32_t opcode = ucsi_get32(p + 8);
+
+	if (opcode != 0x16 || n < 12 + 16) {
+		return;
+	}
+	/* struct usbc_notify: port, orientation, mux (0 none, 1 USB3, 2 DP 4 lanes, 3 USB3 + DP), res, vid, svid, dp byte */
+	say("iceusbh: pan port %u orient %u mux %u vid %04x svid %04x pin %u hpd %u irq %u\n", p[12], p[13], p[14],
+	    p[16] | p[17] << 8, p[18] | p[19] << 8, p[20] & 0x3f, (p[20] >> 6) & 1, p[20] >> 7);
+	const uint32_t ack[6] = { 32780u, 1, 0x15, 0x11, p[12], 0 };
+
+	if (!glink_send(ack, sizeof(ack))) {
+		say("iceusbh: no intent (%u B)\n", (uint32_t)sizeof(ack));
+	}
+}
+
+/* between pumps (wait_pumping): the queued messages, the UCSI poll every 20 ms and its 2 s watchdog */
+static void
+usbh_service(void)
+{
+	struct usbh_mem *m = usbh;
+
+	if (m == NULL || usbh_busy) {
+		return;
+	}
+	usbh_busy = 1;
+	while (usbh_tail != usbh_head) {
+		uint32_t s = usbh_tail % USBH_SLOTS;
+
+		usbh_tail++;
+		usbh_last_rx = usbh_ms();
+		if (ucsi_get32(m->slot[s].b) == 32780u) {
+			usbh_pan(m->slot[s].b, m->slot[s].len);
+		} else {
+			usbh_send(ucsi_receive(&m->ucsi, m->slot[s].b, m->slot[s].kept, m->slot[s].len, m->out));
+		}
+	}
+	if ((usbh_bits & ICEUSBH_TC) && m->ucsi.state != UCSI_IDLE && (++usbh_ticks & 1) == 0) {
+		if (m->ucsi.state != UCSI_READY && m->ucsi.state != UCSI_FAILED && !m->ucsi.polling &&
+		    usbh_ms() - usbh_last_rx > 2000) {
+			m->ucsi.polling = 1;                    /* an answer lost (queue full, or never sent): read again */
+			usbh_last_rx = usbh_ms();
+		}
+		usbh_send(ucsi_tick(&m->ucsi, m->out));
+	}
+	usbh_busy = 0;
+}
+
+/* the channel is open: the OPM and PAN starts */
+static void
+usbh_start(void)
+{
+	static const uint32_t pan_en[6] = { 32780u, 1, 0x15, 0x10, 0, 0 };
+	static const uint32_t notif_req[7] = { OWNER_BATTMGR, 2, 4, 0, 0, 0, 0 };
+
+	usbh = kalloc_data(sizeof(*usbh), Z_WAITOK | Z_ZERO);
+	if (usbh == NULL) {
+		say("iceusbh: no memory\n");
+		return;
+	}
+	say("iceusbh: %#x on the channel\n", usbh_bits);
+	if (usbh_bits & ICEUSBH_TC) {
+		usbh_last_rx = usbh_ms();
+		usbh_send(ucsi_start(&usbh->ucsi, usbh->out));
+	}
+	if ((usbh_bits & ICEUSBH_DP) && !glink_send(pan_en, sizeof(pan_en))) {
+		say("iceusbh: no intent (%u B)\n", (uint32_t)sizeof(pan_en));
+	}
+	if ((usbh_bits & ICEUSBH_VBUS) && !glink_send(notif_req, sizeof(notif_req))) {
+		say("iceusbh: no intent (%u B)\n", (uint32_t)sizeof(notif_req));
+	}
+	wait_pumping(1000);
+}
+
+/* VBUS out, every 5 s: every rule of the header; any doubt -> off */
+static void
+usbh_vbus(void)
+{
+	uint32_t cid = 0, online = 1, mv, soc;
+	int32_t dc;
+	bool have, ok;
+
+	if (!vb.started) {
+		vb.started = true;
+		vb.ma = 500;
+		vb.limit_s = 1200;
+		PE_parse_boot_argn("iceusbh_ma", &vb.ma, sizeof(vb.ma));
+		PE_parse_boot_argn("iceusbh_vbus_s", &vb.limit_s, sizeof(vb.limit_s));
+		vb.ma = vb.ma < 100 ? 100 : vb.ma > 1500 ? 1500 : vb.ma;
+		vb.limit_s = vb.limit_s > 3600 ? 3600 : vb.limit_s;
+		(void)set_property(OP_OPLUS_SET, OPLUS_OTG_AP_ENABLE, 1, "otg ap");
+	}
+	have = get_property(OP_OPLUS_GET, OPLUS_CID_STATUS, &cid) && get_property(OP_USB_PROPERTY_GET, USB_ONLINE, &online);
+	have = read_gauge() && have;
+	mv = gauge[2];
+	soc = gauge[3] / 100;
+	dc = (int32_t)gauge[0] / 10;
+	{
+		struct iceusbh_vbus_in in = {
+			.have = have, .cid = (int)cid, .online = (int)online, .sourcing = vb.sourcing, .refused = vb.refused,
+			/* a computer or a charger on the other end (UCSI DFP): never */
+			.partner_dfp = (usbh_bits & ICEUSBH_TC) && usbh->ucsi.status_valid && usbh->ucsi.connected &&
+		            usbh->ucsi.partner == UCSI_PARTNER_DFP,
+			.mv = (int)mv, .soc = (int)soc, .deg_c = dc, .on_s = vb.on_s, .limit_s = vb.limit_s,
+		};
+
+		ok = iceusbh_vbus_ok(&in);
+	}
+	if (ok && !vb.on) {
+		vb.on = set_property(OP_OPLUS_SET, OPLUS_OTG_BOOST_MA, vb.ma, "boost ma") &&
+		    set_property(OP_OPLUS_SET, OPLUS_OTG_VBUS_ENABLE, 1, "vbus on");
+		vb.refused = !vb.on;
+		vb.released = false;
+	} else if (!ok && vb.on) {
+		(void)set_property(OP_OPLUS_SET, OPLUS_OTG_VBUS_ENABLE, 0, "vbus off");
+		vb.on = false;
+	}
+	if (vb.on) {
+		vb.on_s += 5;
+	}
+	if (have && cid != 1) {
+		vb.on_s = 0;
+		vb.retries = 0;
+		vb.refused = false;
+		vb.sourcing = false;
+		if (!vb.released) {             /* (the firmware keeps an earlier kernel's boost: Linux releases it at no cable) */
+			(void)set_property(OP_OPLUS_SET, OPLUS_OTG_VBUS_ENABLE, 0, "vbus off");
+			(void)set_property(OP_OPLUS_SET, OPLUS_OTG_SWITCH, 0, "otg switch");
+			vb.released = true;
+		}
+	} else if (have && online == 0 && !vb.sourcing && vb.retries < 3) {
+		vb.retries++;                   /* the firmware's source attach again (Linux: 3 times, 3 s apart) */
+		(void)set_property(OP_OPLUS_SET, OPLUS_OTG_AP_ENABLE, 1, "otg ap");
+	}
+	{
+		static uint32_t said = ~0u;
+		uint32_t now = (uint32_t)vb.on | cid << 1 | online << 3 | (uint32_t)vb.sourcing << 5 | usbh_notif << 6 |
+		    (uint32_t)vb.refused << 10;
+
+		if (now != said || (vb.on && vb.on_s % 60 == 0)) {
+			said = now;
+			say("iceusbh: vbus %u cid %u on %u src %u n %x ref %u %u mV %u%% %d C %u/%u s %u mA\n", vb.on, cid, online,
+			    vb.sourcing, usbh_notif, vb.refused, mv, soc, dc, vb.on_s, vb.limit_s, vb.ma);
+		}
+	}
+}
+
+/* every 5 s of the battery thread */
+static void
+usbh_tick5(void)
+{
+	struct iceland_ucsi *c;
+
+	if (usbh == NULL) {
+		return;
+	}
+	c = &usbh->ucsi;
+	if (usbh_bits & ICEUSBH_TC) {
+		if (c->state == UCSI_FAILED && usbh_restarts < 3) {
+			say("iceusbh: ucsi failed (cci %08x), restart\n", c->cci);
+			usbh_restarts++;
+			usbh_last_rx = usbh_ms();
+			usbh_send(ucsi_start(c, usbh->out));
+		} else if (c->status_valid && (c->generation != usbh_said_gen || c->status != usbh_said_status)) {
+			say("iceusbh: tc v%x gen %u con %u partner %u usb %u src %u mode %u rdo %08x chg %u err %u lost %u\n",
+			    c->version, c->generation, c->connected, c->partner, c->usb, c->source, c->opmode, c->rdo, c->changes,
+			    c->errors, usbh_lost);
+			usbh_said_gen = c->generation;
+			usbh_said_status = c->status;
+		}
+		hakios_iceland_usbh_cable(ucsi_wants_host(c), c->partner, c->generation);
+	}
+	if (usbh_bits & ICEUSBH_VBUS) {
+		usbh_vbus();
+	}
+}
+
+/* ---- all of it together ---------------------------------------------------------------------------------------- */
+
+static void
+icebatt_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)parameter, size = 0, every_s = 30, load_s = 0, waited_s = 0;
+
+	PE_parse_boot_argn("icebatt_s", &every_s, sizeof(every_s));
+	if (every_s < 5 || every_s > 3600) {
+		every_s = 30;
+	}
+	every_s -= every_s % 5;
+	PE_parse_boot_argn("icebatt_load", &load_s, sizeof(load_s));
+	(void)PE_parse_boot_argn("iceusbh", &usbh_bits, sizeof(usbh_bits));
+	usbh_bits &= ICEUSBH_TC | ICEUSBH_DP | ICEUSBH_VBUS;   /* (this thread's bits; VBUS needs the rounds: icebatt>=4) */
+	if (stage < 4) {
+		usbh_bits &= ~ICEUSBH_VBUS;
+	}
+	sleep_ms(3000);
+	if (kernel_memory(SMEM_PHYS, SMEM_SIZE)) {
+		say("stage %u: %#lx is kernel RAM here: not mapped\n", stage, SMEM_PHYS);
+		return;
+	}
+	smem = ml_io_map(SMEM_PHYS, SMEM_SIZE);
+	if (smem == 0) {
+		say("cannot map the shared memory\n");
+		return;
+	}
+	say("stage %u: shared memory %#lx (%#x bytes)\n", stage, SMEM_PHYS, SMEM_SIZE);
+	if (!find_partition()) {
+		return;
+	}
+	(void)find_item(0, &size, true);
+	desc = find_item(ITEM_GLINK_DESCRIPTOR, &size, false);
+	if (desc == 0 || size != 32) {
+		say("GLINK's descriptor (item %u) is not there (or %u bytes): Linux would allocate it; not done here\n",
+		    ITEM_GLINK_DESCRIPTOR, size);
+		return;
+	}
+	ours = find_item(ITEM_GLINK_OUR_QUEUE, &ours_size, false);
+	theirs = find_item(ITEM_GLINK_THEIR_QUEUE, &theirs_size, false);
+	say("GLINK descriptor at %#lx: our queue tail %#x head %#x, theirs tail %#x head %#x; our queue %#lx (%u bytes), "
+	    "theirs %#lx (%u bytes)\n", SMEM_PHYS + desc, word(desc + D_OUR_TAIL), word(desc + D_OUR_HEAD),
+	    word(desc + D_THEIR_TAIL), word(desc + D_THEIR_HEAD), SMEM_PHYS + ours, ours_size, SMEM_PHYS + theirs,
+	    theirs_size);
+	if (ours == 0 || theirs == 0 || ours_size < 1024 || theirs_size < 1024 || (ours_size & 7) || (theirs_size & 7)) {
+		say("the queues are not usable: stopping\n");
+		return;
+	}
+	if (stage < 2) {
+		return;
+	}
+	{
+		uint32_t avail = waiting(), off = 0;
+
+		say("the SoCCP's queue holds %u bytes not read by anybody\n", avail);
+		for (unsigned n = 0; n < 8 && off + 8 <= avail; n++) {
+			struct gmsg m;
+
+			gpeek(&m, off, sizeof(m));
+			say("  waiting %u at +%u: %s %u %#x\n", n, off, gname(m.command), m.param1, m.param2);
+			if (m.command == G_OPEN) {
+				off += (uint32_t)(sizeof(m) + m.param2 + 7) & ~7u;
+			} else if (m.command == G_INTENT) {
+				off += (uint32_t)(sizeof(m) + 8 * m.param2 + 7) & ~7u;
+			} else if (m.command == G_DATA || m.command == G_DATA_MORE) {
+				uint32_t dw[2];
+
+				gpeek(dw, off + 8, 8);
+				off += (16 + dw[0] + 7) & ~7u;
+			} else {
+				off += 8;
+			}
+		}
+	}
+	if (stage < 3) {
+		return;
+	}
+	ipcc = ml_io_map(IPCC_PHYS, 0x1000);
+	say("GLINK: their tail and our head set to 0 (as Linux's attach), then version 1 with intent reuse\n");
+	poke(desc + D_THEIR_TAIL, 0);
+	poke(desc + D_OUR_HEAD, 0);
+	gsay(G_VERSION, 1, features, NULL, 0);
+	for (uint32_t ms = 0; ms < 6000 && !open && !broken; ms++) {
+		pump();
+		if (ms == 3000 && !asked && agreed) {
+			say("no open from the SoCCP in 3 s: opening \"%s\" ourselves\n", CHANNEL_NAME);
+			send_open();
+		}
+		sleep_ms(1);
+	}
+	say("after 6 s: versions %s (features %#x), channel %s (theirs %u, our open %s, acked %s); %u sent, %u heard; "
+	    "others opened: %s %s %s %s\n", agreed ? "agreed" : "NOT agreed", features, open ? "OPEN" : "NOT open",
+	    their_channel, asked ? "sent" : "not sent", acked ? "yes" : "no", said, heard, others[0], others[1], others[2],
+	    others[3]);
+	say("icetypec: %u other-owner message%s so far (UCSI %u, PAN/altmode %u, other %u)%s\n", typec_msgs,
+	    typec_msgs == 1 ? "" : "s", typec_ucsi, typec_pan, typec_other,
+	    typec_msgs == 0 ? ": none seen (the SoCCP sends them on a plug or its own schedule)" : "");
+	if (open && !broken && usbh_bits != 0) {
+		usbh_start();                   /* lane E: iceusbh= TC / DP / VBUS */
+	}
+	if (open && !broken && !(usbh_bits & ICEUSBH_TC)) {
+		typec_ask();                    /* gains1 (U2): icetypec>=2 only (lane E's TC is the OPM instead) */
+	}
+	if (open && stage < 4 && usbh != NULL && !(usbh_bits & ICEUSBH_VBUS)) {
+		while (open && !broken) {       /* lane E at icebatt=3: the channel kept, no battery rounds */
+			wait_pumping(5000);
+			usbh_tick5();
+		}
+	}
+	if (!open || stage < 4) {
+		/* left as it is: Linux resets both marks again on its next attach */
+		return;
+	}
+	chg_stage = stage;
+	if (stage >= 5) {
+		say("stage 5: the charger's limits may be raised from here, never lowered (requests to the charger firmware only)\n");
+	}
+	if (stage >= 6) {
+		say("stage 6: charging on inside 12..45 C, <= %u mV, VBUS <= %u mV\n", ICECHG_EN_BATT_MV, ICECHG_EN_VBUS_MV);
+	}
+	for (unsigned round = 1;; round++) {
+		battery_round(round);
+		if (stage >= 5) {
+			charger_poll();         /* (the first one decides, right after the first round's lines) */
+		}
+		for (uint32_t s = 5; s <= every_s; s += 5) {
+			wait_pumping(5000);
+			if (usbh_bits != 0) {
+				usbh_tick5();           /* lane E */
+			}
+			waited_s += 5;
+			if (load_s != 0 && waited_s >= load_s) {
+				load_s = 0;
+				load_test();
+			}
+			if (s + 5 <= every_s) {         /* (the round itself reads the last one) */
+				bool got = read_gauge();
+
+				/* icebatt=6 also polls without an answer: its guard turns charging off on one */
+				if (stage >= 6 || (got && stage >= 5)) {
+					charger_poll();
+				}
+			}
+		}
+		if (broken || !open) {
+			say("the link is %s: stopping\n", broken ? "broken" : "closed");
+			return;
+		}
+	}
+}
+
+void
+hakios_iceland_battery_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icebatt", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	if (stage > 6) {
+		stage = 6;
+	}
+	if (kernel_thread_start(icebatt_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_bt.c b/bsd/dev/hakios_iceland_bt.c
new file mode 100644
index 0000000000000000000000000000000000000000..f438f2dfe0711367169998dc0578bff29f903403
--- /dev/null
+++ b/bsd/dev/hakios_iceland_bt.c
@@ -0,0 +1,4490 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * hakios_iceland_bt.c - macOS: the Bluetooth half of the Pad 4's WCN7860, up to a working HCI link, and put back.
+ *
+ * Boot-arg icebt=N (default 0: nothing here is mapped, read or written):
+ *   icebt=1  (a) bt-enable high, the BT UART (uart18) at 115200: HCI_Reset, QCA version, board id, build string,
+ *            HCI Read_Local_Version; then everything put back, bt-enable low
+ *   icebt=2  (b) ... then 3.2 Mbaud, the rampatch and the NVM file downloaded (volatile: the chip's RAM), HCI_Reset,
+ *            the patched build string and Read_Local_Version again
+ *   icebt=3  (c) ... then the controller set up as a host stack does and one 10 s PASSIVE LE scan: advertising reports
+ *            counted (never an address, a name or AD data in the log), scan off, HCI_Reset
+ *   icebt=4  (d) a and b, then the controller stays up for macOS's bluetoothd: /dev/cu.BLTH and the service
+ *            "bluetooth" (see "(d)" below); no scan of our own; everything put back at the run's end
+ *   icebt_delay=S  seconds after the thread's start before the first read (default 45: after the Wi-Fi bring-up of
+ *            icepcie_lx=1, which then has the chip powered in the order the iPadOS target proved)
+ *   bt1 (code defaults, so __DATA is unchanged; each word on a line wins): icebt_retry=2 (a failed bring-up undone and
+ *            tried again), icebt_pinout=1 (bt-enable found as an output is taken), icebt_ev59=1 (event 0x59 framed)
+ * Lines "icebt: ". This is the iPadOS target's sequence (hakios_iceland_harvest.c, kits 23f2 bt-enable, 23h / 23h3 the
+ * serial engine and the download, 23bt1 the scan; all under !XNU_TARGET_OS_OSX there), in one thread, with macOS's
+ * private pack instead of md1's fw/ files. No command of stages a to c makes the radio transmit; in stage d the
+ * daemon's commands do (active scans, connections, advertising: what Bluetooth is).
+ *
+ * Hardware facts (the owner's mainline Linux a2e1ea44d3c3, read by object; nothing copied):
+ *   kaanapali-oneplus-iceland.dts:500-563   wcn7860-pmu: wlan-enable tlmm 16, bt-enable pmh0104_j_e1 GPIO 5, supplies
+ *                                           L3G 1.2 V, L2G 1.8 V, S2J, S7F, S8F, S1J; clock RPMH_RF_CLK1
+ *   kaanapali-oneplus-iceland.dts:1787-1797 bt_default: gpio5, function normal, output low, bias-disable, power-source 1
+ *   kaanapali-oneplus-iceland.dts:2475-2500 uart18 -> bluetooth "qcom,wcn7860-bt", max-speed 3200000
+ *   kaanapali.dtsi:2262-2282                uart18: serial@1994000 (QUP wrapper 3 at 0x19c0000, SE5), GIC_SPI 587,
+ *                                           GCC_QUPV3_WRAP3_S5_CLK
+ *   kaanapali.dtsi:6033-6047                pads gpio26 TX / gpio27 RX (pull-up), gpio24 CTS / gpio25 RTS (pull-down),
+ *                                           function qup3_se5, 2 mA
+ *   pmh0104-kaanapali.dtsi:39-62            PMH0104 "J_E1": spmi_bus1, SID 9, gpio@8800 (GPIO 5 = 0x8c00, PPID 0x98c)
+ *   gcc-kaanapali.c:967, 2502, 2727-2750    S5 RCG 0xa8640, branch 0xa8630 voted by 0x52018 bit 17; wrap3 m_ahb / s_ahb
+ *                                           / core / core_2x 0x233f0 / 0x233f4 / 0x233f8 / 0x2340c, bits 8-11
+ *   pwrseq-qcom-wcn.c:434-448               WCN7860: regulators, clock, then bt-enable; 100 ms power-up delay; the
+ *                                           Bluetooth and WLAN enables are independent
+ *   hci_qca.c:1558-1600, 2054-2075, btqca.c:822-829, 922-928   WCN7860: version at 115200, peripheral + HCI baud to the
+ *                                           operating speed, 20 ms of RX discarded, qca/brhbtfw20.mbn in 243-byte
+ *                                           segments, board id, qca/brhbtnv20.b<bid> (else .bin), each NVM segment answered
+ *
+ * What is shared with the Wi-Fi half (hakios_iceland_pcie.c, icepcie_lx=1) and how:
+ *   the PMU's input rails and RF clock (L2G, L3G, S1J, S2J, S7F, S8F, C1A): one list, in pcie.c, taken and given
+ *     back with a count (hakios_iceland_wcn_rails_get / _put; "wcnpmu:" lines). Each half takes them before its enable
+ *     pin goes high and gives them back after the pin is low; the votes themselves stay even at a count of 0 (a
+ *     release could take the boot chain's vote with it, harvest.c:10598-10607), so no undo of either side can take a
+ *     rail from the other, in either order.
+ *   WLAN_EN (tlmm gpio16) is the Wi-Fi side's alone and is never read or written here; bt-enable (PMIC GPIO 5) is this
+ *     file's alone. The PMU keeps each half's supplies while its own enable is high (Linux switches them separately).
+ *   the firmware pack (__BOOTDATA, XNU_WIFI_PACK_OBJECT): one object, read through hakios_iceland_wifi_blob();
+ *     pcie.c keeps it for icepcie_lx=1 or icebt>=2.
+ *   nothing else: no PCIe, SMMU, gpio16 / 18 / 102 register is touched here (uart18 uses the engine's FIFO, no DMA, so
+ *     no SMMU stream), and the Wi-Fi side touches no register listed below.
+ *
+ * Written (each logged with the value before, the value written and the read-back; all put back at the end, on
+ * reset-after and on the way back to the loader, except the rail votes):
+ *   RPMh    the seven votes above (kept; the count goes back down)
+ *   SPMI    PMH0104 GPIO 5, through its own arbiter channel: DIG_VIN_CTL 0x41 = 1, DIG_PULL_CTL 0x42 = 5, MODE_CTL
+ *           0x40 = 1, DIG_OUT_SOURCE_CTL 0x44 = 0x80 (high); refused unless the channel's owner is EE 0 and the pin is
+ *           found as an enabled LV GPIO left as an input
+ *   GCC     0x52018 bit 17 (the S5 branch vote); with DFS off, the S5 RCG's CFG / M / N / D + CMD update
+ *   QUP     SE5's GENI registers (FIFO mode UART: the list in se_regs[]), saved first
+ *   TLMM    gpio24-27 CTL: function 1 (qup3_se5) and the DT's bias
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/param.h>
