+					const int32_t rise = t > t100 ? t - t100 : 0;   /* (no reading, -1000: no rise) */
+					const int32_t pred = t + rise;
+					const uint32_t top = dom[d].top_sustained;
+					const uint32_t low = ceil_floor[d] > top ? top : ceil_floor[d];
+					uint32_t want;
+
+					ceil_hist[d][ceil_hist_at] = t;
+					if (pred <= (int32_t)soft_deci) {
+						want = top;
+					} else if (pred >= (int32_t)hot_deci) {
+						want = low;
+					} else {
+						const uint32_t span = hot_deci - soft_deci;
+
+						want = top - ((uint32_t)(pred - (int32_t)soft_deci) * (top - low) + span - 1) / span;
+					}
+					if (want < low) {
+						want = low;
+					} else if (want > top) {
+						want = top;
+					}
+					if (want < pceil[d]) {
+						pceil[d] = want;        /* a lower ceiling at once: the vote below obeys it this tick */
+					} else if (want > pceil[d] && now - ceil_up[d] >= ceil_interval) {
+						pceil[d]++;             /* one level up every 100 ms */
+						ceil_up[d] = now;
+					}
+				}
+				ceil_hist_at = (ceil_hist_at + 1) % CEIL_TICKS;
+				if (ceil_hist_n < CEIL_TICKS) {
+					ceil_hist_n++;
+				}
+			}
+			if (base) {
+				/* w4-perf: the pressure level (its trips: see its block above), after the caps, on the 100 ms check */
+				int32_t hottest = temp_now_deci[0];
+				const int32_t soc = hakios_iceland_tsens_soc_deci();
+
+				if (temp_now_deci[1] > hottest) {
+					hottest = temp_now_deci[1];
+				}
+				if (soc > hottest) {
+					hottest = soc;
+				}
+				ice_die_level = pressure_step(hottest, ice_die_level, ice_die_trip, ice_die_hyst);
+				if (tick % 250 == 0) {          /* every 50th 100 ms check: 5 s, the battery's temperature changes slowly */
+					const int t = redwood_battery_temperature();
+
+					battery_c = t;
+					/*
+					 * w5-thermal, icecpu_gears=1: with stock's gears the shell level comes from the gear (below), not
+					 * from the battery's own 41 / 45 / 51 C trips.
+					 */
+					if (gears == 0) {
+						ice_shell_level = t <= -273 ? 0 :
+						    pressure_step(t * 10, ice_shell_level, ice_shell_trip, ice_shell_hyst);
+					}
+					/* w4-perf: ice_shutdown=1: 70 C battery (Linux's skin critical trip) on two readings in a row */
+					if (shutdown != 0 && !shutdown_done) {
+						battery_hot = t >= 70 ? battery_hot + 1 : 0;
+						if (battery_hot >= 2) {
+							shutdown_why = 2;       /* acted on by the per-tick check below */
+						}
+					}
+				}
+				if (gears != 0) {
+					/*
+					 * w5-thermal, icecpu_gears=1: the shell is stock's own fallback, the battery + 2.0 C (bat_bias,
+					 * icecpu_shell_bias in tenths), or the lab switch icecpu_shell_test=D. Read on every 100 ms check
+					 * from the last battery reading (the gauge itself is read every 5 s above), so the test value acts
+					 * from the first check. No reading and no test: no gear change (the gear stays).
+					 */
+					int32_t front = -1000;
+
+					if (shell_front != 0) {
+						/*
+						 * w5-shell, icecpu_shell=1: stock's "front" shell model (horae, build/wf/thermal/REPORT.md
+						 * section 1c, the steady-state row): 0.38 skin - 0.08 wlan + 0.70 board + 0.02 chg_cp - 1.4 C,
+						 * from the PMIC ADC's thermistors (iceskin=2 arms them; hakios_iceland_buttons.c converts with
+						 * Linux's adcmap7_100k). chg_cp is not armed: its 0.02 goes to board, its nearest neighbour.
+						 * Any of the three missing: the battery fallback below, as before.
+						 */
+						const int32_t skin = hakios_iceland_skin_deci(0), board = hakios_iceland_skin_deci(1);
+						const int32_t wlan = hakios_iceland_skin_deci(3);
+
+						if (skin > -1000 && board > -1000 && wlan > -1000) {
+							front = (380 * skin - 80 * wlan + 720 * board) / 1000 - 14;
+						}
+						if ((front > -1000) != shell_front_live || tick % 1500 == 0) {
+							char a[16], b[16], c[16], s[16];
+
+							shell_front_live = front > -1000;
+							if (shell_lines++ < 60) {
+								say("shell: %s %s C (skin %s, board %s, wlan %s; battery %d C)\n",
+								    shell_front_live ? "front model" : "no thermistors: battery +",
+								    deci_str(s, sizeof(s), shell_front_live ? front : (int32_t)shell_bias),
+								    deci_str(a, sizeof(a), skin), deci_str(b, sizeof(b), board),
+								    deci_str(c, sizeof(c), wlan), battery_c);
+							}
+						}
+					}
+					if (shell_test != 0) {
+						gear_shell_deci = (int32_t)shell_test;
+					} else if (front > -1000) {
+						gear_shell_deci = front;
+					} else {
+						gear_shell_deci = battery_c <= -273 ? -1000 : battery_c * 10 + (int32_t)shell_bias;
+					}
+					if (gear_shell_deci > -1000) {
+						const int g = gears_step(gear, gear_shell_deci);
+
+						if (g != gear) {
+							char s[16];
+
+							gear = g;
+							for (uint32_t d = 0; d < domains; d++) {
+								gear_level[d] = gears_level(d, gear, dom[d].top_sustained);
+							}
+							if (gear_lines++ < 100) {
+								say("gear %d (shell %s C): d0 <= %u MHz, d1 <= %u MHz\n", gear,
+								    deci_str(s, sizeof(s), gear_shell_deci), dom[0].khz[gear_level[0]] / 1000,
+								    dom[1].khz[gear_level[1]] / 1000);
+							}
+						}
+					}
+					/* Android's MODERATE 8 / SEVERE 10 / CRITICAL 13 on the gear, as the shell level */
+					ice_shell_level = gear >= 13 ? 3 : gear >= 10 ? 2 : gear >= 8 ? 1 : 0;
+				}
+				if (yield != 0) {               /* ice_floor_yield=1: every change of the level, up to 100 lines */
+					const uint32_t p = hakios_iceland_pressure();
+
+					if (p != pressure_seen && pressure_lines++ < 100) {
+						say("pressure: level %u (die %d.%d C, battery %d C): ui floor d0 %s\n", p, hottest / 10,
+						    hottest < 0 ? -hottest % 10 : hottest % 10, battery_c,
+						    p >= 2 ? "off" : p == 1 ? "at most 1996 MHz" : "as set");
+					}
+					pressure_seen = p;
+				}
+			}
+#if defined(XNU_TARGET_OS_OSX)
+			if (tick == 5) {
+				(void)hakios_iceland_thermal_level_publish();   /* w3-power: once, with the first temperatures */
+			}
+#endif
+		}
+		/*
+		 * w4-perf, ice_shutdown=1 (see shutdown_off above): on every 20 ms tick the hottest die sensor -- the two CPU
+		 * domains' cores and the rest of the SoC (hakios_iceland_tsens_soc_deci) -- at or above the threshold five
+		 * ticks in a row (100 ms), or the battery's 70 C on two of the 5 s readings above (shutdown_why = 2).
+		 */
+		if (shutdown != 0 && !shutdown_done) {
+			int32_t hottest = domain_temp(0);
+			const int32_t soc = hakios_iceland_tsens_soc_deci();
+
+			if (domains > 1) {
+				const int32_t t = domain_temp(1);
+
+				if (t > hottest) {
+					hottest = t;
+				}
+			}
+			if (soc > hottest) {
+				hottest = soc;
+			}
+			die_hot_ticks = hottest >= (int32_t)shutdown_deci ? die_hot_ticks + 1 : 0;
+			if (die_hot_ticks >= 5 && shutdown_why == 0) {
+				shutdown_why = 1;
+			}
+			if (shutdown_why != 0) {
+				shutdown_done = true;
+				shutdown_latched = true;        /* no hook, or the call came back: the caps stay at 0 */
+				shutdown_off(domains, shutdown_why == 2, hottest, battery_c);
+				for (uint32_t k = 0; k < domains; k++) {
+					cur[k] = 0;             /* the levels the vote below follows from here */
+					cap[k] = 0;
+					quiet[k] = 0;
+				}
+			}
+		}
+		const uint32_t pressure = yield != 0 ? hakios_iceland_pressure() : 0;   /* w4-perf: ice_floor_yield=1 */
+		for (uint32_t d = 0; d < domains; d++) {
+			uint64_t khz = dom[d].khz[cur[d]], want = khz * busiest[d] * head / 100000;
+			uint32_t next = 0, lim;
+
+			if (shutdown_latched) {
+				cap[d] = 0;                     /* ice_shutdown: no hook, or it returned: the caps stay at 0 */
+			}
+			/*
+			 * w5-thermal (B4): this tick's ceiling is the thermal cap and, with icecpu_ceil=1 / icecpu_gears=1, the
+			 * lower of the predictive ceiling and the gear's cap. Only the vote below follows lim; cap[d] and its
+			 * rules above are untouched.
+			 */
+			lim = cap[d];
+			if (ceil_on != 0 && pceil[d] < lim) {
+				lim = pceil[d];
+			}
+			if (gears != 0 && gear >= 3 && gear_level[d] < lim) {
+				lim = gear_level[d];
+			}
+			if (booting && sticky[d] < lim) {
+				lim = sticky[d];                /* icecpu_bootcap: the sticky boot ceiling */
+			}
+			limits[d] = lim;                        /* w5-thermal: icecpu_tstat=1's line shows it */
+			if (busiest[d] > 900 && want < 2 * khz) {
+				want = 2 * khz;                 /* nearly always busy: at least twice the clock at once */
+			}
+			while (next < lim && dom[d].khz[next] < want) {
+				next++;
+			}
+			/* 20q: the screen is being drawn: not below the ui floor (under the thermal cap); 20u (icecpu_touch=1): also
+			 * while a finger is down or was in the last 200 ms -- before the first frame of a gesture is swapped */
+			const uint64_t win = d == 1 ? ui_window1 : ui_window;  /* r6g: domain 1 held longer (icecpu_hold1) */
+			bool drawing = hakios_ui_swap_at != 0 && now - hakios_ui_swap_at < win;
+			bool touching = touch_floor && hakios_ui_touch_at != 0 && now - hakios_ui_touch_at < win;
+
+			if (uifloor[d] != 0 && (drawing || touching)) {
+				uint32_t f = uifloor[d] < lim ? uifloor[d] : lim;
+
+				/* w4-perf, ice_floor_yield=1: at pressure level 1 a floor is at most 1996.8 MHz, from level 2 there is none */
+				if (yield != 0) {
+					if (pressure >= 2) {
+						f = 0;
+					} else if (pressure == 1 && f > yield_floor[d]) {
+						f = yield_floor[d];
+					}
+				}
+				if (f != 0 && next < f) {
+					next = f;
+					touch_floors += touching && !drawing;
+					if (ui_floors++ % 500 == 0) {
+						say("ui floor: domain %u held at level %u (%u MHz) while drawing (%u times, %u of them by touch alone)\n", d, f,
+						    (uint32_t)(dom[d].khz[f] / 1000), ui_floors, touch_floors);
+					}
+				}
+			}
+			if (boost_until != 0 && now < boost_until) {
+				next = lim;                     /* icecpu_boost: the ceiling sets the level, not the load */
+			}
+			if (next > lim) {
+				next = lim;
+			}
+			/* w4-perf, icecpu_rise=N (the block of its boot-arg, above): above 80.0 C a domain goes up at most N levels
+			 * a tick, whichever way asked (the load, the ui floor, icecpu_boost). It only lowers a vote. */
+			if (rise != 0 && temp_now_deci[d] > 800 && next > cur[d] + rise) {
+				const uint32_t was = next;
+
+				next = cur[d] + rise;
+				rise_limited++;
+				if (rise_limited == 1) {
+					say("rise: domain %u at %d.%d C: up %u levels a tick at most above 80 C (icecpu_rise=%u), level %u -> "
+					    "%u instead of %u\n", d, temp_now_deci[d] / 10, temp_now_deci[d] % 10, rise, rise, cur[d], next, was);
+				} else if (rise_limited % 2000 == 0) {
+					say("rise: %u steps limited so far\n", rise_limited);
+				}
+			}
+			if (next < cur[d] && cur[d] > lim && (ceil_on != 0 || gears != 0 || booting)) {
+				quiet[d] = 0;                   /* w5-thermal: a ceiling that fell below the level now is obeyed at once */
+			} else if (next < cur[d] && ++quiet[d] < 4) {
+				next = cur[d];                  /* down only when four windows in a row want less */
+			} else if (next >= cur[d]) {
+				quiet[d] = 0;
+			}
+			if (next != cur[d]) {
+				fc_set(d, next);
+				cur[d] = next;
+				gov_level[d] = next;            /* w4-perf: for the top line */
+				quiet[d] = 0;
+			}
+		}
+		if (tstat != 0) {
+			/*
+			 * w5-thermal, icecpu_tstat=1: the die's peaks at the 20 ms resolution the 2 s governor lines cannot show
+			 * (runs/w4-perf-2b-trips-yield: 99.6 C for under 400 ms, the 2 s lines at most 86.9 C). The window's peak
+			 * and the milliseconds at or above 90.0 / 95.0 C, and the run's; every tick at or above 90.0 C is a line,
+			 * with the four ticks before it on the episode's first one.
+			 */
+			uint64_t ns = 0;
+			unsigned group = 0;
+			const int32_t hottest = hakios_iceland_tsens_hottest(&group);
+			const bool hot = hottest >= 900;
+
+			absolutetime_to_nanoseconds(span, &ns);
+			const uint32_t ms = (uint32_t)(ns / NSEC_PER_MSEC);
+
+			tstat_ring_at = (tstat_ring_at + 1) % (TRACE_PRE + 1);
+			tstat_ring[tstat_ring_at].hot = hottest;
+			tstat_ring[tstat_ring_at].group = group;
+			for (uint32_t d = 0; d < domains; d++) {
+				tstat_ring[tstat_ring_at].t[d] = temp_now_deci[d];
+				tstat_ring[tstat_ring_at].lv[d] = cur[d];
+				tstat_ring[tstat_ring_at].lim[d] = limits[d];
+				tstat_ring[tstat_ring_at].busy[d] = busiest[d];
+			}
+			if (tstat_ring_n < TRACE_PRE + 1) {
+				tstat_ring_n++;
+			}
+			if (hottest > tstat_peak) {
+				tstat_peak = hottest;
+				tstat_peak_group = group;
+			}
+			if (hottest > tstat_run_peak) {
+				tstat_run_peak = hottest;
+				tstat_run_peak_group = group;
+				uint64_t up = 0;
+
+				absolutetime_to_nanoseconds(now, &up);  /* uptime: mach time starts at 0 on macOS */
+				tstat_run_peak_ms = up / NSEC_PER_MSEC;
+			}
+			if (hot) {
+				tstat_win90 += ms;
+				tstat_run90 += ms;
+			}
+			if (hottest >= 950) {
+				tstat_win95 += ms;
+				tstat_run95 += ms;
+			}
+			if (hot && tstat_lines < 300) {
+				if (!tstat_was_hot) {
+					/* the episode's first hot tick: the four before it, oldest first (they show the rise) */
+					for (uint32_t k = tstat_ring_n - 1; k >= 1; k--) {
+						const uint32_t i = (tstat_ring_at + (TRACE_PRE + 1) - k) % (TRACE_PRE + 1);
+
+						tstat_hot_line("pre", tstat_ring[i].hot, tstat_ring[i].group, tstat_ring[i].t,
+						    tstat_ring[i].lv, tstat_ring[i].lim, tstat_ring[i].busy, domains);
+					}
+				}
+				tstat_hot_line("hot", hottest, group, tstat_ring[tstat_ring_at].t, tstat_ring[tstat_ring_at].lv,
+				    tstat_ring[tstat_ring_at].lim, tstat_ring[tstat_ring_at].busy, domains);
+				if (++tstat_lines == 300) {
+					say("hot: 300 lines: the hot trace stops here (the 2 s lines go on)\n");
+				}
+			}
+			tstat_was_hot = hot;
+		}
+		if (bootcap_until != 0 && now >= bootcap_until) {
+			bootcap_until = 0;
+			say("bootcap: over at %u s (d0 %u, d1 %u, %u steps): by the other limits from here\n", bootcap_s, sticky[0],
+			    sticky[1], sticky_steps);
+		}
+		if (boost_until != 0 && now >= boost_until) {
+			boost_until = 0;
+			say("boost: over at %u s (d0 level %u, cap %u); by load from here\n", boost_s, cur[0], cap[0]);
+		}
+		own_ticks += mach_absolute_time() - work_at;     /* this thread's own work in the window */
+		own_windows++;
+		if (own_windows == 500) {               /* once, after 10 s */
+			uint64_t own_ns = 0;
+
+			absolutetime_to_nanoseconds(own_ticks, &own_ns);
+			/* It is part of whichever CPU's non-idle time: the per-CPU idle counters do not account per thread, and
+			 * binding this thread to a CPU to subtract it would change what is measured. Said, so the figure is known. */
+			/* (w3-power: in hundredths, by integers: the kernel's printf has no %f and printed "f %") */
+			const uint64_t own_c = own_ns * 10000 / (own_windows * 20 * 1000000ull);
+
+			say("governor: this thread costs %llu us over %llu windows (%llu.%02llu %% of one CPU, included in busy; not subtracted)\n",
+			    own_ns / 1000 / own_windows, own_windows, own_c / 100, own_c % 100);
+		}
+		if (tick % 100 == 0) {                  /* every 2 s */
+			say("governor: d0 level %u (%u MHz, busy %llu.%llu%%, %d.%d C, cap %u)  d1 level %u (%u MHz, busy %llu.%llu%%, %d.%d C, cap %u)%s\n",
+			    cur[0], dom[0].khz[cur[0]] / 1000, busiest[0] / 10, busiest[0] % 10, domain_temp(0) / 10, domain_temp(0) % 10 < 0 ? -domain_temp(0) % 10 : domain_temp(0) % 10, cap[0],
+			    cur[1], dom[1].khz[cur[1]] / 1000, busiest[1] / 10, busiest[1] % 10, domain_temp(1) / 10, domain_temp(1) % 10 < 0 ? -domain_temp(1) % 10 : domain_temp(1) % 10, cap[1],
+			    load_cpu >= 0 ? " [test load]" : "");
+			if (tstat != 0) {
+				char a[16], b[16];
+
+				say("tstat: 2s peak %s %s >=90 %u >=95 %u ms; lim %u/%u gear %d; run peak %s %s at %llu.%llu s >=90 %u >=95 %u ms\n",
+				    deci_str(a, sizeof(a), tstat_peak), hakios_iceland_tsens_group_name(tstat_peak_group),
+				    tstat_win90, tstat_win95, limits[0], domains > 1 ? limits[1] : 0, gear,
+				    deci_str(b, sizeof(b), tstat_run_peak), hakios_iceland_tsens_group_name(tstat_run_peak_group),
+				    tstat_run_peak_ms / 1000, (tstat_run_peak_ms % 1000) / 100, tstat_run90, tstat_run95);
+				tstat_peak = -1000;             /* the next window */
+				tstat_peak_group = 0;
+				tstat_win90 = tstat_win95 = 0;
+			}
+		}
+	}
+}
+
+static void
+icecpu_thread(void *arg, wait_result_t w __unused)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)arg, out[32], n = 0, in[2], version, domains;
+	int r;
+
+	delay_for_interval(15000, NSEC_PER_MSEC);
+	mbox = ml_io_map(PDP0_MBOX_TX_PHYS, 0x1000);
+	/* as Linux's mailbox startup: the channels' receive side enabled (0 = tx completion, 1 = rx); clear old status */
+	/*
+	 * (2026-10-30: the first runs had reg[0]/reg[1] swapped. icecpu1b rang 0x17610104, a register of the RX block:
+	 * no answer. icecpu1c also did a 64-bit read-modify-write at 0x19980000 + 0x4c00 - inside the TX block - and wrote
+	 * 0x17610100 (RX): Qualcomm crash-dump mode (USB 05c6:900e). Now: one write to the TX doorbell, nothing else.)
+	 */
+	clocks("as the boot left them");
+	/*
+	 * The PDP SRAM is the SoC's, never a page the kernel manages. On QEMU's A3 route (DarwinBoot's window 0x53804000
+	 * + 3 GiB) 0x81f08000 is RAM the VM hands out: the mapping would stay on it (pmap_assert_free when it is recycled,
+	 * as icebatt's SMEM did) and scmi() below would write its request into somebody's page.
+	 */
+	if (pmap_valid_page((ppnum_t)atop_64(PDP_SRAM_PHYS))) {
+		say("%#lx is kernel RAM here: no SCMI, governor OFF\n", PDP_SRAM_PHYS);
+		return;
+	}
+	sram = ml_io_map(PDP_SRAM_PHYS, 0x1000);
+	shmem = sram + PDP_TX_OFF;
+	r = scmi(SCMI_PERF, 0, NULL, 0, out, 32, &n);
+	if (r || n < 2 || out[0] != 0) {
+		say("SCMI performance protocol: no answer (%d, %u words, status %d; channel %#x)\n", r, n,
+		    n ? (int)out[0] : 0, rd(shmem + 4));
+		say("shmem after: hdr %#x len %#x flags %#x\n", rd(shmem + 0x18), rd(shmem + 0x14), rd(shmem + 0x10));
+		/*
+		 * G3: with no SCMI answer there is nothing this driver can set. The fast channels are learned through SCMI
+		 * (DESCRIBE_FASTCHANNEL), so without an answer there is no level table and no channel address that is not a
+		 * guess, and the other CPU control (CPU_SUSPEND / the idle driver) is not a thermal limit. The firmware's own
+		 * thermal trips are what protects the SoC then; say so, loudly, instead of running as if a ceiling were set.
+		 */
+		say("governor: OFF: no SCMI answer, so no clock ceiling from this driver; the firmware's own thermal trips apply\n");
+		return;
+	}
+	version = out[1];
+	r = scmi(SCMI_PERF, 1, NULL, 0, out, 32, &n);
+	domains = (!r && n >= 2 && out[0] == 0) ? MIN(out[1] & 0xffff, DOMAINS_MAX) : 0;
+	say("SCMI performance protocol %#x: %u domains (Pad 4 DT: 0 = cpu0-5, 1 = cpu6-7)\n", version, domains);
+	for (uint32_t d = 0; d < domains; d++) {
+		uint32_t index = 0, entry = (version >> 16) >= 4 ? 5 : 3, now, sustained_level = ~0u, indexing = 0;
+		char name[17] = { 0 };
+
+		in[0] = d;
+		r = scmi(SCMI_PERF, 3, in, 1, out, 32, &n);
+		if (!r && n >= 9 && out[0] == 0) {
+			memcpy(name, &out[5], 16);
+		}
+
+		dom[d].sustained_khz = (!r && n > 3) ? out[3] : 0;
+		/* v4 DOMAIN_ATTRIBUTES: bit 25 = level indexing mode (LEVEL_SET / LEVEL_GET take level indices); word 4 =
+		 * the sustained performance level (an index then). The Pad's PDP0 says 0xea000000: indexing on. */
+		indexing = (!r && n > 1 && (version >> 16) >= 4) ? (out[1] >> 25) & 1 : 0;
+		sustained_level = (!r && n > 4) ? out[4] : ~0u;
+		for (int guard = 0; guard < (int)LEVELS_MAX && index < LEVELS_MAX; guard++) {     /* (PDP0 returns one level a reply) */
+			in[0] = d;
+			in[1] = index;
+			r = scmi(SCMI_PERF, 4, in, 2, out, 32, &n);
+			if (r || n < 2 || out[0] != 0) {
+				break;
+			}
+			uint32_t got = out[1] & 0xfff, left = out[1] >> 16;
+
+
+			for (uint32_t i = 0; i < got && 2 + (i + 1) * entry <= n && index + i < LEVELS_MAX; i++) {
+				const uint32_t *e = &out[2 + i * entry];
+
+				dom[d].level[index + i] = entry == 5 && indexing ? e[4] : e[0];
+				dom[d].khz[index + i] = entry == 5 ? e[3] : e[0];
+			}
+			index += got;
+			if (!left || !got) {
+				break;
+			}
+		}
+		dom[d].levels = MIN(index, LEVELS_MAX);
+		dom[d].top_sustained = 0;
+		for (uint32_t l = 0; l < dom[d].levels; l++) {
+			if (indexing ? dom[d].level[l] == sustained_level :
+			    (dom[d].khz[l] <= dom[d].sustained_khz || dom[d].sustained_khz == 0)) {
+				dom[d].top_sustained = l;
+			}
+		}
+		in[0] = d;
+		r = scmi(SCMI_PERF, 8, in, 1, out, 32, &n);
+		now = (!r && n > 1 && out[0] == 0) ? out[1] : ~0u;
+		uint32_t now_khz = 0;
+
+		for (uint32_t l = 0; l < dom[d].levels; l++) {
+			if (dom[d].level[l] == now) {
+				now_khz = dom[d].khz[l];
+			}
+		}
+		say("domain %u '%s': %u levels (%s), %u .. %u kHz, sustained %u kHz = level %u, now level %d = %u kHz\n", d,
+		    name, dom[d].levels, indexing ? "indexed" : "by value", dom[d].khz[0],
+		    dom[d].levels ? dom[d].khz[dom[d].levels - 1] : 0, dom[d].sustained_khz, dom[d].level[dom[d].top_sustained],
+		    (int)now, now_khz);
+	}
+	/*
+	 * The fast channels the firmware offers (DESCRIBE_FASTCHANNEL, msg 0xb: domain, message id) for LEVEL_SET (7) and
+	 * LEVEL_GET (8) - Linux on the tablet gets them for 7 and 8 (only 5/6, the limits, fail: dmesg "Failed to get FC
+	 * for protocol 13 [MSG_ID:6/5]") and sets levels through them. A query only: nothing is written to a channel here.
+	 * Answer: status, attributes, rate limit, chan addr low/high, chan size, doorbell addr low/high, set mask low/high,
+	 * preserve mask low/high.
+	 */
+	for (uint32_t d = 0; d < domains; d++) {
+		for (uint32_t m = 7; m <= 8; m++) {
+			char line[160];
+			int at = 0;
+
+			in[0] = d;
+			in[1] = m;
+			r = scmi(SCMI_PERF, 0xb, in, 2, out, 32, &n);
+			if (!r && m == 7 && n >= 9 && out[0] == 0 && out[4] == 0 && out[7] == 0 && out[5] >= 4) {
+				fc_chan[d] = out[3];
+				fc_db[d] = (out[1] & 1) ? out[6] : 0;
+				fc_db_set[d] = out[8];
+			}
+			for (uint32_t i = 0; i < n && i < 12; i++) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %08x", out[i]);
+			}
+			line[at] = 0;
+			say("domain %u fast channel for msg %u: %d, %u words:%s\n", d, m, r, n, line);
+		}
+	}
+	if (stage < 2) {
+		return;
+	}
+	if (stage == 5) {
+		governor(domains);              /* (does not return while it runs) */
+		return;
+	}
+	for (uint32_t d = 0; d < domains; d++) {
+		if (!dom[d].levels) {
+			continue;
+		}
+		in[0] = d;
+		r = scmi(SCMI_PERF, 6, in, 1, out, 32, &n);    /* PERFORMANCE_LIMITS_GET: max, min */
+		say("domain %u limits: %d, status %d, max %u min %u\n", d, r, n ? (int)out[0] : 0, n > 1 ? out[1] : 0,
+		    n > 2 ? out[2] : 0);
+		in[0] = d;
+		in[1] = dom[d].level[dom[d].top_sustained];
+		r = scmi(SCMI_PERF, 7, in, 2, out, 32, &n);
+		say("domain %u: LEVEL_SET %u (%u kHz): %d, status %d\n", d, in[1], dom[d].khz[dom[d].top_sustained], r,
+		    n ? (int)out[0] : 0);
+	}
+	delay_for_interval(100, NSEC_PER_MSEC);
+	clocks("at the sustained levels, 100 ms");
+	for (uint32_t d = 0; d < domains; d++) {
+		in[0] = d;
+		r = scmi(SCMI_PERF, 8, in, 1, out, 32, &n);    /* LEVEL_GET */
+		say("domain %u: LEVEL_GET after the set: %d, status %d, level %d\n", d, r, n ? (int)out[0] : 0,
+		    n > 1 ? (int)out[1] : -1);
+	}
+	delay_for_interval(1000, NSEC_PER_MSEC);
+	clocks("at the sustained levels, 1 s");
+	if (stage == 4) {
+		/*
+		 * icecpu=4: levels through the fast channels, as Linux sets them: the level (index) into the channel, then the
+		 * set mask into the doorbell. Checked with SCMI LEVEL_GET over pdp_tx (the FC read registers are in the
+		 * mailbox's RX block, which is not touched) and the clock gauge.
+		 */
+		static const uint32_t want[DOMAINS_MAX] = { 20, 26 };  /* cluster 0: 20 (2880 MHz, a change from 27); prime: 26 */
+		for (uint32_t d = 0; d < domains; d++) {
+			uint32_t level, got;
+			vm_offset_t page;
+
+			if (fc_chan[d] != fc_known_chan[d] || fc_db[d] != fc_known_db[d] || fc_db_set[d] != 0xf ||
+			    want[d] >= dom[d].levels) {
+				say("domain %u: fast channel %#x / doorbell %#x / set %#x not the known one: skipped\n", d, fc_chan[d],
+				    fc_db[d], fc_db_set[d]);
+				continue;
+			}
+			level = dom[d].level[want[d]];
+			page = ml_io_map(fc_chan[d] & ~0xfffu, 0x1000);
+			wr(page + (fc_chan[d] & 0xfff), level);
+			__builtin_arm_dsb(0xf);
+			wr(page + (fc_db[d] & 0xfff), fc_db_set[d]);
+			delay_for_interval(50, NSEC_PER_MSEC);
+			in[0] = d;
+			got = (!scmi(SCMI_PERF, 8, in, 1, out, 32, &n) && n > 1 && out[0] == 0) ? out[1] : ~0u;
+			say("domain %u: fast channel level %u (%u kHz) -> LEVEL_GET %d\n", d, level, dom[d].khz[want[d]], (int)got);
+		}
+		clocks("after the fast-channel sets");
+		return;
+	}
+	if (stage < 3 || domains < 2) {
+		return;
+	}
+	/* icecpu=3: does the prime domain (1) follow a plain LEVEL_SET at all, and up to which level? */
+	static const uint32_t sweep[] = { 4, 9, 14, 20, 26 };
+	for (uint32_t i = 0; i < sizeof(sweep) / sizeof(sweep[0]); i++) {
+		uint32_t l = sweep[i], got;
+
+		if (l >= dom[1].levels) {
+			continue;
+		}
+		in[0] = 1;
+		in[1] = dom[1].level[l];
+		r = scmi(SCMI_PERF, 7, in, 2, out, 32, &n);
+		int st = n ? (int)out[0] : 0;
+		delay_for_interval(50, NSEC_PER_MSEC);
+		in[0] = 1;
+		got = (!scmi(SCMI_PERF, 8, in, 1, out, 32, &n) && n > 1 && out[0] == 0) ? out[1] : ~0u;
+		say("prime sweep: LEVEL_SET %u (%u kHz): %d status %d -> LEVEL_GET %d\n", dom[1].level[l], dom[1].khz[l], r, st,
+		    (int)got);
+		clocks("prime sweep");
+	}
+}
+
+void hakios_iceland_cpu_init(void);
+
+void
+hakios_iceland_cpu_init(void)
+{
+	static bool started;
+	uint32_t stage = 0;
+	thread_t thread;
+
+	/* from GenericARMPE::start (before the root is mounted) and from redwood_input_init: once */
+	/*
+	 * w4-perf: before anything here, the sensors the trips and the thermal level read (bsd/dev/hakios_iceland_tsens.c).
+	 * It starts nothing without icetsens / icecpu_trips / icegpu_thermal / thermal-level, and its thread waits 2 s, so
+	 * the governor's own tables are read first either way.
+	 */
+	hakios_iceland_tsens_init();
+	if (started) {
+		return;
+	}
+	if (!PE_parse_boot_argn("icecpu", &stage, sizeof(stage))) {
+		DTEntry entry;
+		void const *type = NULL;
+		unsigned int size = 0;
+
+		/* the Pad's default: the governor (the loader names the board in /arm-io device_type) */
+		if (SecureDTLookupEntry(NULL, "/arm-io", &entry) == kSuccess &&
+		    SecureDTGetProperty(entry, "device_type", &type, &size) == kSuccess && size >= 8 &&
+		    strncmp((const char *)type, "iceland", 8) == 0) {
+			stage = 5;
+		}
+	}
+	if (stage == 0) {
+		uint32_t every = 0;
+
+		/* w3-power: icecpu_top=N without the governor (QEMU, icecpu=0): the top lines from a thread of their own */
+		if (PE_parse_boot_argn("icecpu_top", &every, sizeof(every)) && every != 0) {
+			every = every < 2 || every > 60 ? 5 : every;
+			top_on = 1;
+			started = true;
+			if (kernel_thread_start(top_thread, (void *)(uintptr_t)every, &thread) == KERN_SUCCESS) {
+				thread_deallocate(thread);
+			}
+		}
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(icecpu_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_iceland_dpu.c b/bsd/dev/hakios_iceland_dpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..32525030a09af233c8e2655bd4f39883e85e5e9c
--- /dev/null
+++ b/bsd/dev/hakios_iceland_dpu.c
@@ -0,0 +1,997 @@
+/*
+ * iceland w2-direct, boot-arg dpu-direct=1 (default 0: nothing here runs): the SM8850 display scans the compositor's
+ * surfaces out itself, through its own SMMU bank, instead of the CPU copying every frame into the panel memory.
+ *
+ * What the boot loader leaves (tablet run w2-vsync-1, dpu-scanout-probe=1, iokit/Native/GopFramebuffer probeDpu):
+ *   - DPU 13.0 in MDSS 0x9800000; CTL0 drives INTF1; VIG0..3 each fetch a quarter of the 3392 x 2400 panel from the
+ *     panel memory at 0xfc800000 (REC0 SRC0_ADDR = that address, YSTRIDE0 13568, SRC_XY x = n * 848); ~120 Hz.
+ *   - the display's stream (SID 0x800 mask 2, DT qcom,smmu_sde_unsec_cb) matches SMR 5 -> S2CR 4 -> context bank 4,
+ *     CBAR 0x1f000 (stage 1, stage 2 bypassed), SCTLR 0xe0: translation off, so the pipes read physical addresses
+ *     (32 bits). The compositor's surfaces are 7950 pages of 4 KiB ending near 38 GiB: out of reach without tables.
+ * Register facts: linux a2e1ea44d3c3 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_sspp_v13.c:43-77 (REC block: SRC0_ADDR 0x4c,
+ * YSTRIDE0 0x5c, CURRENT_SRC0_ADDR 0x64), dpu_hw_ctl.c:51,194-204 (CTL_FLUSH 0x18: VIG0 bit 0, VIG1 1, VIG2 2,
+ * VIG3 18, CTL 17), drivers/iommu/arm/arm-smmu/arm-smmu.h:100-246 (SMMUv2 registers). The bank's programming is the
+ * one icepcie already makes on this SMMU from EL1 (bsd/dev/hakios_iceland_pcie.c smmu_on): same TCR2 / TCR / MAIR /
+ * SCTLR values, 4 KB tables cleaned to the point of coherency.
+ *
+ * Written, nothing else (the owner's yes for new hardware-write kinds; the list went to the orchestrator first):
+ *   - SMMU context bank B only (B read from the S2CR of the SMR that matches the display's stream, never assumed):
+ *     TCR2 (only when CBA2R.VA64 reads 1), TTBR0, TCR, MAIR0, MAIR1, TLBIALL + TLBSYNC, FSR (clear), SCTLR. Never an
+ *     SMR, S2CR, CBAR, CBA2R, sCR0, a global TLB command or another bank. Undone to the values found.
+ *   - DPU: VIG0..3 REC0 SRC0_ADDR and CTL0 FLUSH (VIG0-3 and CTL bits). Stride, size, format: never (a surface whose
+ *     stride is not the panel's is copied as before).
+ * Tables: one level-1, two level-2 tables; the panel memory identity-mapped (so the switch to translation is seamless
+ * and the undo is too); kSlots slots of 32 MiB from 0x80000000 for the surfaces, read-only for the display.
+ * Checks: the UFS's route (SMR 0, S2CR 0, bank 0 SCTLR / TTBR0) read before the first write and after the undo,
+ * refused when it reads all-ones; the bank's FSR watched for 100 ms after the switch and at each latch: any fault puts
+ * the pipes back on the panel memory and translation off, and the display copies as before. QEMU (psci_smp_hvc) and
+ * any other panel: refused before the first mapping.
+ * The run's end (reset-after) and loader_return undo it; a panic first puts the pipes back on the panel memory only,
+ * so its screen stays visible (hakios_iceland_dpu_panic_show).
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+#include <kern/kalloc.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void IOSleep(unsigned int milliseconds);
+extern uint32_t psci_smp_hvc;                                    /* osfmk/arm64/psci_smp.c: 1 = QEMU's virt, not the Pad */
+
+bool hakios_iceland_dpu_direct_start(uint64_t panel_pa, uint32_t width, uint32_t height, uint32_t stride);
+uint32_t native_ufs_dpu_map(unsigned slot, const uint64_t *pages, unsigned count);
+bool hakios_iceland_dpu_flip(uint32_t iova);
+bool hakios_iceland_dpu_flushed(void);
+bool hakios_iceland_dpu_faulted(void);
+uint32_t hakios_iceland_dpu_panel_iova(void);
+bool hakios_iceland_dpu_refresh_probe(void);
+bool hakios_iceland_dpu_refresh(uint32_t *frame, uint64_t *since_ns, uint32_t *since_q16);
+void hakios_iceland_dpu_stop(void);
+void hakios_iceland_dpu_panic_show(void);
+void hakios_iceland_dpu_quiesce(void);
+void hakios_iceland_dpu_trace_next(uint64_t id, uint64_t buf);
+void hakios_iceland_dpu_trace_latch(uint64_t id, bool latched, uint32_t us);
+bool hakios_iceland_dpu_fix(void);
+void hakios_iceland_dpu_trace_samples(uint64_t buf, const uint64_t *pa, uint32_t n);
+static void dtr_flip(uint32_t iova);
+
+/* bit 31: the surfaces can be scanned out (NativeLegacyDisplay's direct path); low bits: the bank */
+volatile uint32_t native_ufs_dpu_state = 0;
+
+#define MDSS_PA         0x9800000ull
+#define MDSS_SIZE       0x1c9000u
+#define CTL0_FLUSH      0x20018u
+#define FLUSH_BITS      (1u << 0 | 1u << 1 | 1u << 2 | 1u << 18 | 1u << 17)    /* VIG0..3, CTL */
+#define REC_ADDR        0x4cu
+#define REC_STRIDE      0x5cu
+#define REC_SIZE        0x14u
+#define REC_XY          0x18u
+#define SMMU_PA         0x15000000ull
+#define DISPLAY_SID     0x800u
+#define FSR_FAULT       (0x1feu | 1u << 30 | 1u << 31)                 /* TF..UUT, SS, MULTI; 10:9 is the format */
+#define SCTLR_ON        (1u << 12 | 1u << 5 | 1u << 2 | 1u << 1 | 1u << 0)  /* ASIDPNE CFRE AFE TRE M (as icepcie) */
+#define TCR_32BIT       (1u << 23 | 3u << 12 | 1u << 10 | 1u << 8 | 32u)    /* EPD1, inner shareable WB walks, 4 KB, T0SZ 32 */
+#define TCR_LPAE        (1u << 31 | 1u << 23 | 3u << 12 | 1u << 10 | 1u << 8)  /* the same in the AArch32 long format */
+#define TCR2_40BIT      (2u | 7u << 15)                                /* PASIZE 40 bits, SEP upstream */
+#define MAIR0           (0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24)  /* index 0: normal non-cacheable */
+#define ASID            0x2du
+#define SLOT_BASE       0x80000000u
+#define SLOT_BYTES      (32u << 20)
+#define SLOTS           4u
+/* leaf: page | AF | outer shareable | read-only, any level | AttrIndx 0 | nG | XN (icepcie's, read-only) */
+#define LEAF(pa)        (((pa) & 0xfffffffff000ull) | 3 | 1ull << 10 | 2ull << 8 | 3ull << 6 | 1ull << 11 | 3ull << 53)
+
+static const uint32_t rec0[4] = { 0x2d000, 0x36000, 0x3f000, 0x48000 };    /* VIG0..3 REC0 (MDSS offsets) */
+
+static struct {
+	vm_offset_t mdss, gr0, gr1, cb, cb0;
+	uint32_t bank, panel, stride, height, flush_mask;
+	bool live, va64, failed;
+	uint32_t found[8];              /* TCR2, TTBR0 lo, hi, TCR, MAIR0, MAIR1, SCTLR, ACTLR (read only) */
+	uint32_t ufs[4];
+	vm_offset_t tables;             /* L1, L2 (slots), L2 (panel), then the level-3 tables */
+	uint32_t panel_l3;              /* level-3 tables for the panel memory */
+	uint32_t faults;
+} d;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* a set-up or undo write: named, with the value before and the read-back */
+static void
+pw(vm_offset_t b, const char *n, uint32_t o, uint32_t v)
+{
+	uint32_t was = rd(b, o);
+
+	wr(b, o, v);
+	printf("icedpu: %s %08x > %08x = %08x\n", n, was, v, rd(b, o));
+}
+
+static void
+clean(vm_offset_t va, vm_size_t size)
+{
+	for (vm_offset_t l = va & ~63ul; l < va + size; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+tlb_all(void)
+{
+	wr(d.cb, 0x618, 0);             /* TLBIALL (this bank) */
+	wr(d.cb, 0x7f0, 0);             /* TLBSYNC */
+	for (int i = 0; i < 1000 && (rd(d.cb, 0x7f4) & 1); i++) {
+		delay(10);
+	}
+}
+
+static void
+ufs_census(const char *when, bool compare)
+{
+	uint32_t v[4] = { rd(d.gr0, 0x800), rd(d.gr0, 0xc00), d.cb0 ? rd(d.cb0, 0x0) : 0, d.cb0 ? rd(d.cb0, 0x20) : 0 };
+
+	printf("icedpu: UFS %s: SMR0 %08x S2CR0 %08x bank0 SCTLR %08x TTBR0 %08x%s\n", when, v[0], v[1], v[2], v[3],
+	    !compare ? "" : memcmp(v, d.ufs, sizeof(v)) == 0 ? " (unchanged)" : " (CHANGED)");
+	if (!compare) {
+		memcpy(d.ufs, v, sizeof(v));
+	}
+}
+
+static uint64_t *
+table(uint32_t n)
+{
+	return (uint64_t *)(d.tables + (vm_offset_t)n * 0x1000);
+}
+
+/* the pipes back on the panel memory (identity-mapped: right with translation on or off); true once CTL0 took it */
+static bool
+pipes_to_panel(bool wait)
+{
+	for (unsigned p = 0; p < 4; p++) {
+		wr(d.mdss, rec0[p] + REC_ADDR, d.panel);
+	}
+	wr(d.mdss, CTL0_FLUSH, d.flush_mask);
+	for (int i = 0; wait && i < 100; i++) {         /* at most 50 ms: six frames at 120 Hz */
+		if ((rd(d.mdss, CTL0_FLUSH) & d.flush_mask) == 0) {
+			return true;
+		}
+		delay(500);
+	}
+	return (rd(d.mdss, CTL0_FLUSH) & d.flush_mask) == 0;
+}
+
+/* translation off and the bank's values as found (the pipes read the panel memory first: the caller) */
+static void
+bank_back(bool say)
+{
+	if (say) {
+		pw(d.cb, "SCTLR (as found)", 0x0, d.found[6]);
+	} else {
+		wr(d.cb, 0x0, d.found[6]);
+	}
+	tlb_all();
+	wr(d.cb, 0x58, rd(d.cb, 0x58));
+	wr(d.cb, 0x20, d.found[1]);
+	wr(d.cb, 0x24, d.found[2]);
+	wr(d.cb, 0x30, d.found[3]);
+	wr(d.cb, 0x38, d.found[4]);
+	wr(d.cb, 0x3c, d.found[5]);
+	if (d.va64) {
+		wr(d.cb, 0x10, d.found[0]);
+	}
+}
+
+bool
+hakios_iceland_dpu_direct_start(uint64_t panel_pa, uint32_t width, uint32_t height, uint32_t stride)
+{
+	uint32_t on = 0, id0, id1, nsmr, ncb, page, numpage, smr_n = ~0u, s2cr = 0, cbar;
+	uint64_t panel_bytes;
+
+	if (!PE_parse_boot_argn("dpu-direct", &on, sizeof(on)) || on != 1 || d.live || d.failed) {
+		return false;
+	}
+	d.failed = true;                /* one try a boot */
+	/* only on the Pad's panel as the boot loader leaves it; QEMU's virt never */
+	if (psci_smp_hvc != 0 || panel_pa != 0xfc800000ull || width != 3392 || height != 2400 || stride != 13568) {
+		printf("icedpu: not the Pad's panel (%#llx %ux%u, %u B a row%s): off\n", panel_pa, width, height, stride,
+		    psci_smp_hvc ? ", QEMU" : "");
+		return false;
+	}
+	d.mdss = ml_io_map_unmappable((vm_offset_t)MDSS_PA, MDSS_SIZE, VM_WIMG_IO);
+	d.gr0 = ml_io_map_unmappable((vm_offset_t)SMMU_PA, 0x1000, VM_WIMG_IO);
+	if (d.mdss == 0 || d.gr0 == 0) {
+		printf("icedpu: REFUSED: not mapped\n");
+		return false;
+	}
+	d.panel = (uint32_t)panel_pa;
+	d.stride = stride;
+	d.height = height;
+	d.flush_mask = FLUSH_BITS;
+	/* the pipes as the boot loader left them, or nothing */
+	for (unsigned p = 0; p < 4; p++) {
+		const uint32_t r = rec0[p];
+
+		if (rd(d.mdss, r + REC_ADDR) != d.panel || (rd(d.mdss, r + REC_STRIDE) & 0xffff) != stride ||
+		    rd(d.mdss, r + REC_SIZE) != (height << 16 | width / 4) || rd(d.mdss, r + REC_XY) != p * (width / 4)) {
+			printf("icedpu: REFUSED: VIG%u not as the boot loader leaves it (addr %08x stride %08x)\n", p,
+			    rd(d.mdss, r + REC_ADDR), rd(d.mdss, r + REC_STRIDE));
+			return false;
+		}
+	}
+	/* the display stream's route: read, never written */
+	id0 = rd(d.gr0, 0x20);
+	id1 = rd(d.gr0, 0x24);
+	nsmr = id0 & 0xff;
+	ncb = id1 & 0xff;
+	page = (id1 & (1u << 31)) ? 0x10000 : 0x1000;
+	numpage = 1u << (((id1 >> 28) & 7) + 1);
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		const uint32_t smr = rd(d.gr0, 0x800 + 4 * i);
+
+		if ((smr >> 31) && ((DISPLAY_SID ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+			if (smr_n != ~0u) {
+				printf("icedpu: REFUSED: two SMRs match the display's stream (%u, %u)\n", smr_n, i);
+				return false;
+			}
+			smr_n = i;
+			s2cr = rd(d.gr0, 0xc00 + 4 * i);
+		}
+	}
+	if (smr_n == ~0u || ((s2cr >> 16) & 3) != 0 || (s2cr & 0xff) >= ncb) {
+		printf("icedpu: REFUSED: no translating route for the display's stream (SMR %d, S2CR %08x)\n", (int)smr_n, s2cr);
+		return false;
+	}
+	d.bank = s2cr & 0xff;
+	d.gr1 = ml_io_map_unmappable((vm_offset_t)(SMMU_PA + page), 0x1000, VM_WIMG_IO);
+	d.cb = ml_io_map_unmappable((vm_offset_t)(SMMU_PA + (uint64_t)(numpage + d.bank) * page), 0x1000, VM_WIMG_IO);
+	if (d.gr1 == 0 || d.cb == 0) {
+		printf("icedpu: REFUSED: bank not mapped\n");
+		return false;
+	}
+	/* the UFS's bank (S2CR 0's), for the census */
+	if (((rd(d.gr0, 0xc00) >> 16) & 3) == 0 && (rd(d.gr0, 0xc00) & 0xff) < ncb && (rd(d.gr0, 0xc00) & 0xff) != d.bank) {
+		d.cb0 = ml_io_map_unmappable((vm_offset_t)(SMMU_PA + (uint64_t)(numpage + (rd(d.gr0, 0xc00) & 0xff)) * page),
+		    0x1000, VM_WIMG_IO);
+	}
+	cbar = rd(d.gr1, 4 * d.bank);
+	d.va64 = rd(d.gr1, 0x800 + 4 * d.bank) & 1;
+	d.found[0] = rd(d.cb, 0x10);
+	d.found[1] = rd(d.cb, 0x20);
+	d.found[2] = rd(d.cb, 0x24);
+	d.found[3] = rd(d.cb, 0x30);
+	d.found[4] = rd(d.cb, 0x38);
+	d.found[5] = rd(d.cb, 0x3c);
+	d.found[6] = rd(d.cb, 0x0);
+	d.found[7] = rd(d.cb, 0x4);
+	printf("icedpu: as found: SMR %u S2CR %08x -> bank %u: CBAR %08x VA64 %u SCTLR %08x TCR %08x TTBR0 %08x%08x FSR %08x "
+	    "(%u SMRs, %u banks)\n", smr_n, s2cr, d.bank, cbar, d.va64, d.found[6], d.found[3], d.found[2], d.found[1],
+	    rd(d.cb, 0x58), nsmr, ncb);
+	if (((cbar >> 16) & 3) != 1 || (d.found[6] & 1)) {
+		printf("icedpu: REFUSED: bank %u is not stage 1 with translation off\n", d.bank);
+		return false;
+	}
+	/* tables: L1, L2 for 0x80000000-0xbfffffff (slots), L2 for 0xc0000000-0xffffffff (panel), level-3 tables */
+	panel_bytes = (uint64_t)stride * height;
+	d.panel_l3 = (uint32_t)((((d.panel & 0x1fffff) + panel_bytes) + 0x1fffff) >> 21);
+	const uint32_t slot_l3 = SLOTS * (SLOT_BYTES >> 21), n = 3 + slot_l3 + d.panel_l3;
+	if ((d.panel & 0xfff) || d.panel < 0xc0000000u ||
+	    kmem_alloc(kernel_map, &d.tables, (vm_size_t)n * 0x1000, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		printf("icedpu: REFUSED: no tables\n");
+		return false;
+	}
+	table(0)[SLOT_BASE >> 30] = kvtophys(d.tables + 0x1000) | 3;
+	table(0)[d.panel >> 30] = kvtophys(d.tables + 0x2000) | 3;
+	for (uint32_t k = 0; k < slot_l3; k++) {
+		table(1)[((SLOT_BASE >> 21) & 0x1ff) + k] = kvtophys(d.tables + (vm_offset_t)(3 + k) * 0x1000) | 3;
+	}
+	for (uint32_t k = 0; k < d.panel_l3; k++) {
+		table(2)[((d.panel >> 21) & 0x1ff) + k] = kvtophys(d.tables + (vm_offset_t)(3 + slot_l3 + k) * 0x1000) | 3;
+	}
+	{
+		uint64_t *l3 = table(3 + slot_l3);
+		const uint32_t first = (d.panel >> 12) & 0x1ff;
+
+		for (uint64_t off = 0; off < panel_bytes; off += 0x1000) {
+			l3[first + (off >> 12)] = LEAF(d.panel + off);      /* (consecutive level-3 tables: one array) */
+		}
+	}
+	clean(d.tables, (vm_size_t)n * 0x1000);
+	ufs_census("before", false);
+	if (d.ufs[0] == 0xffffffffu || d.ufs[1] == 0xffffffffu || (d.cb0 && (d.ufs[2] == 0xffffffffu || d.ufs[3] == 0xffffffffu))) {
+		printf("icedpu: REFUSED: the UFS census reads all-ones: nothing written\n");
+		return false;
+	}
+	/* the bank (its own context registers only), then translation on */
+	if (d.va64) {
+		pw(d.cb, "TCR2", 0x10, TCR2_40BIT);
+	}
+	pw(d.cb, "TTBR0 lo", 0x20, (uint32_t)kvtophys(d.tables));
+	pw(d.cb, "TTBR0 hi", 0x24, (uint32_t)(kvtophys(d.tables) >> 32) | ASID << 16);
+	pw(d.cb, "TCR", 0x30, d.va64 ? TCR_32BIT : TCR_LPAE);
+	pw(d.cb, "MAIR0", 0x38, MAIR0);
+	pw(d.cb, "MAIR1", 0x3c, 0);
+	tlb_all();
+	pw(d.cb, "FSR", 0x58, rd(d.cb, 0x58));
+	const uint32_t frame0 = rd(d.mdss, 0x18f0ac);
+	pw(d.cb, "SCTLR", 0x0, SCTLR_ON);
+	d.live = true;
+	/* 100 ms: any fault, and the pipes still fetching (the frame counter moves) */
+	for (int i = 0; i < 100; i++) {
+		IOSleep(1);
+		if (rd(d.cb, 0x58) & FSR_FAULT) {
+			break;
+		}
+	}
+	const uint32_t fsr = rd(d.cb, 0x58), frame1 = rd(d.mdss, 0x18f0ac);
+	if ((fsr & FSR_FAULT) || frame1 == frame0) {
+		printf("icedpu: FAULT or no frames after the switch: FSR %08x FAR %08x%08x frames %u -> %u: back off\n", fsr,
+		    rd(d.cb, 0x64), rd(d.cb, 0x60), frame0, frame1);
+		d.live = false;
+		bank_back(true);
+		ufs_census("after the undo", true);
+		return false;
+	}
+	ufs_census("after", true);
+	printf("icedpu: the display reads through bank %u's tables (panel memory identity-mapped, %u slots of 32 MiB at %#x); "
+	    "frames %u -> %u in 100 ms\n", d.bank, SLOTS, SLOT_BASE, frame0, frame1);
+	native_ufs_dpu_state = 1u << 31 | d.bank;
+	return true;
+}
+
+/* COUNT pages of 4 KiB into slot SLOT (never the one on screen or the one waiting: the caller); its IOVA, or 0 */
+uint32_t
+native_ufs_dpu_map(unsigned slot, const uint64_t *pages, unsigned count)
+{
+	if (!d.live || slot >= SLOTS || count == 0 || count > SLOT_BYTES / 0x1000) {
+		return 0;
+	}
+	uint64_t *l3 = table(3 + slot * (SLOT_BYTES >> 21));      /* (the slot's level-3 tables are consecutive) */
+	for (unsigned i = 0; i < SLOT_BYTES / 0x1000; i++) {
+		l3[i] = i < count ? LEAF(pages[i]) : 0;
+	}
+	clean((vm_offset_t)l3, SLOT_BYTES / 0x1000 * 8);
+	tlb_all();
+	return SLOT_BASE + slot * SLOT_BYTES;
+}
+
+/* the pipes to IOVA, latched at the next frame; false when off (a fault since: the caller goes back to the copy) */
+bool
+hakios_iceland_dpu_flip(uint32_t iova)
+{
+	if (!d.live || hakios_iceland_dpu_faulted()) {
+		return false;
+	}
+	dtr_flip(iova);                 /* gains2: icedtr (and icedtr_fix's wait for a flush still pending) */
+	for (unsigned p = 0; p < 4; p++) {
+		wr(d.mdss, rec0[p] + REC_ADDR, iova);
+	}
+	wr(d.mdss, CTL0_FLUSH, d.flush_mask);
+	return true;
+}
+
+bool
+hakios_iceland_dpu_flushed(void)
+{
+	return !d.live || (rd(d.mdss, CTL0_FLUSH) & d.flush_mask) == 0;
+}
+
+uint32_t
+hakios_iceland_dpu_panel_iova(void)
+{
+	return d.panel;
+}
+
+/*
+ * w6-perf, boot-arg vsync-lock=1 (iokit/Native/GopFramebuffer/NativeLegacyDisplay.cpp's refresh tick; default 0: nothing
+ * here runs): where the panel's refresh stands, READ ONLY. The panel refreshes at about 120 Hz as the boot loader leaves it
+ * (tablet run w2-vsync-1: 12 frames in IOSleep(100); the "frames in 100 ms" line above counts over 100 x IOSleep(1), some
+ * 110-117 ms, hence 13-14), dual DSI; Linux drives this panel in video mode (linux a2e1ea44d3c3
+ * drivers/gpu/drm/panel/panel-novatek-nt36536.c:914, MIPI_DSI_MODE_VIDEO; its 120 Hz mode :820-831). No interrupt tells the
+ * CPU a refresh began, so the tick reads the display interfaces' counters, whichever the boot loader's mode runs:
+ *   - INTF_FRAME_COUNT (+0x0ac): frames sent (the caller measures the period over seconds);
+ *   - video mode: the timing engine (INTF_TIMING_ENGINE_EN +0x000 bit 0) and its line counter INTF_LINE_COUNT (+0x0b0),
+ *     out of INTF_VSYNC_PERIOD_F0 (+0x00c, pixels a frame) / INTF_HSYNC_CTL[31:16] (+0x008, pixels a line) lines a frame:
+ *     the fraction of the frame scanned since its vsync;
+ *   - command mode: the tear check's read pointer, INTF_TEAR_INT_COUNT_VAL (+0x298) bits 15:0, which the vsync counter loads
+ *     with INTF_TEAR_VSYNC_INIT_VAL (+0x294) at the TE and counts up one line every INTF_TEAR_SYNC_CONFIG_VSYNC[15:0]
+ *     (+0x288) ticks of the 19.2 MHz vsync clock (bit 19: the counter runs); INTF_TEAR_TEAR_CHECK_EN (+0x284) bit 0.
+ * Registers: linux a2e1ea44d3c3 drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c:17-50,80-93 (offsets), :128-135,167,243-244
+ * (the timing engine's periods), :360-370 (get_line_count), :382-412 (the tear counter's fields), :483-508
+ * (dpu_hw_intf_get_vsync_info); INTF_1 at MDSS +0x18e000, INTF_2 at +0x18f000 (catalog/dpu_13_0_kaanapali.h:399-409).
+ * Nothing is written. Never on QEMU (no DPU there: psci_smp_hvc).
+ */
+#define INTF1_OFF       0x18e000u
+#define INTF_COUNT      2u
+#define INTF_STEP       0x1000u
+#define INTF_ENGINE     0x000u
+#define INTF_HSYNC      0x008u
+#define INTF_VPERIOD    0x00cu
+#define INTF_FRAMES     0x0acu
+#define INTF_LINES      0x0b0u
+#define TEAR_EN         0x284u
+#define TEAR_VSYNC      0x288u
+#define TEAR_INIT       0x294u
+#define TEAR_RDPTR      0x298u
+#define TEAR_AUTOREF    0x2b4u
+
+static struct {
+	vm_offset_t intf;               /* INTF_1 and INTF_2, mapped for reads only */
+	uint32_t frames;                /* offset (from intf) of the frame counter that moves */
+	uint32_t tear;                  /* offset of the interface whose tear check counts lines; ~0u: none */
+	uint32_t line_ticks, init;      /* vsync clock ticks a line; the read pointer's value at the TE */
+	uint32_t video, vtotal;         /* offset of the interface whose timing engine counts lines (~0u: none); lines a frame */
+	bool probed, ok;
+} rr;
+
+/* once, from the display's start (may sleep 25 ms): true when a frame counter moves; logs what it found */
+bool
+hakios_iceland_dpu_refresh_probe(void)
+{
+	uint32_t lock = 0, f0[INTF_COUNT], l0[INTF_COUNT], v0[INTF_COUNT];
+
+	if (rr.probed) {
+		return rr.ok;
+	}
+	rr.probed = true;
+	rr.tear = ~0u;
+	rr.video = ~0u;
+	if (!PE_parse_boot_argn("vsync-lock", &lock, sizeof(lock)) || lock == 0) {
+		return false;
+	}
+	if (psci_smp_hvc != 0) {
+		printf("icedpu: refresh lock: QEMU, no DPU: the tick keeps its own clock\n");
+		return false;
+	}
+	rr.intf = ml_io_map_unmappable((vm_offset_t)(MDSS_PA + INTF1_OFF), INTF_COUNT * INTF_STEP, VM_WIMG_IO);
+	if (rr.intf == 0) {
+		printf("icedpu: refresh lock: the interfaces not mapped\n");
+		return false;
+	}
+	for (unsigned i = 0; i < INTF_COUNT; i++) {
+		f0[i] = rd(rr.intf, i * INTF_STEP + INTF_FRAMES);
+		l0[i] = rd(rr.intf, i * INTF_STEP + TEAR_RDPTR);
+		v0[i] = rd(rr.intf, i * INTF_STEP + INTF_LINES);
+	}
+	IOSleep(25);                    /* three refreshes at 120 Hz */
+	rr.frames = ~0u;
+	for (unsigned i = 0; i < INTF_COUNT; i++) {
+		const vm_offset_t b = rr.intf + i * INTF_STEP;
+		const uint32_t en = rd(b, TEAR_EN), cfg = rd(b, TEAR_VSYNC), init = rd(b, TEAR_INIT), ptr = rd(b, TEAR_RDPTR);
+		const uint32_t f1 = rd(b, INTF_FRAMES), engine = rd(b, INTF_ENGINE), hsync = rd(b, INTF_HSYNC), vper = rd(b, INTF_VPERIOD);
+		const uint32_t line = rd(b, INTF_LINES), htotal = hsync >> 16, vtotal = htotal ? vper / htotal : 0;
+
+		printf("icedpu: refresh lock: intf%u frames %u -> %u in 25 ms; engine %08x, hsync %08x, vsync period %08x (%u x %u), "
+		    "line %u -> %u; tear check %08x, vsync %08x, init %08x, read pointer %08x -> %08x, autorefresh %08x\n", i + 1, f0[i],
+		    f1, engine, hsync, vper, htotal, vtotal, v0[i], line, en, cfg, init, l0[i], ptr, rd(b, TEAR_AUTOREF));
+		if (f1 == 0xffffffffu || en == 0xffffffffu || engine == 0xffffffffu) {
+			continue;
+		}
+		if (rr.frames == ~0u && f1 != f0[i]) {
+			rr.frames = i * INTF_STEP;
+		}
+		if (rr.video == ~0u && (engine & 1) && vtotal >= 1000 && vtotal <= 16384 && line != v0[i]) {
+			rr.video = i * INTF_STEP;
+			rr.vtotal = vtotal;
+		}
+		if (rr.tear == ~0u && (en & 1) && (cfg & (1u << 19)) && (cfg & 0xffff) != 0 && ptr != l0[i]) {
+			rr.tear = i * INTF_STEP;
+			rr.line_ticks = cfg & 0xffff;
+			rr.init = init & 0xffff;
+		}
+	}
+	rr.ok = rr.frames != ~0u;
+	printf("icedpu: refresh lock: %s, %s\n", !rr.ok ? "no frame counter moves: off" : rr.frames ? "frames from intf2" :
+	    "frames from intf1", !rr.ok ? "-" : rr.video != ~0u ? "the phase from the video timing engine's line counter" :
+	    rr.tear != ~0u ? "the phase from the tear check's read pointer" : "no line counter moves: the period only");
+	return rr.ok;
+}
+
+/*
+ * The frames sent, and where the current refresh stands: *since_ns the time since it began (tear check), or *since_q16 the
+ * fraction of the frame scanned since its vsync, in 1/65536 (video mode); each ~0 when not known. False when the probe found
+ * nothing.
+ */
+bool
+hakios_iceland_dpu_refresh(uint32_t *frame, uint64_t *since_ns, uint32_t *since_q16)
+{
+	*since_ns = UINT64_MAX;
+	*since_q16 = ~0u;
+	if (!rr.ok) {
+		return false;
+	}
+	if (rr.video != ~0u) {
+		const uint32_t line = rd(rr.intf, rr.video + INTF_LINES);
+
+		if (line < rr.vtotal) {
+			*since_q16 = (uint32_t)(((uint64_t)line << 16) / rr.vtotal);
+		}
+	} else if (rr.tear != ~0u) {
+		const uint32_t ptr = rd(rr.intf, rr.tear + TEAR_RDPTR) & 0xffff;
+		const uint64_t ns = (uint64_t)((ptr - rr.init) & 0xffff) * rr.line_ticks * 625u / 12u;
+
+		if (ns < 20000000ull) {         /* longer than a 50 Hz frame: the counter is not what the probe took it for */
+			*since_ns = ns;
+		}
+	}
+	*frame = rd(rr.intf, rr.frames + INTF_FRAMES);
+	return true;
+}
+
+/*
+ * gains2, boot-arg icedtr (built in as icedtr=1; icedtr=0 on a line turns it off): the presentation, traced. The owner's
+ * 21 Nov video shows the whole frame (Dock and windows) jump sideways by tens of pixels between frames, with no GPU
+ * OOM(Device) at all, so the question is the display's own: which buffer each refresh scanned, and when. READ ONLY
+ * (nothing here writes a register): at each flip (NativeLegacyDisplay's direct path, the swap's id and buffer handed in
+ * first by hakios_iceland_dpu_trace_next) and at each latch (hakios_iceland_dpu_trace_latch) it reads the panel
+ * interface's frame and line counters (INTF FRAME_COUNT +0x0ac, LINE_COUNT +0x0b0, FRAME_LINE_COUNT_EN +0x0a8: the
+ * probe's interface above; Snapintosh compat/dpu-intf.h / AdrenoDisplayBeam.h use the same offsets, STATE 0z125), the
+ * four pipes' CURRENT_SRC0_ADDR (REC +0x64, dpu_hw_sspp_v13.c) and the MDP top INTR_STATUS (mdp 0x9801000 + 0x014,
+ * linux a2e1ea44d3c3 drivers/gpu/drm/msm/disp/dpu1/dpu_hwio.h:15) whose bits 26 and 28 are INTF_1's and INTF_2's
+ * underrun (catalog/dpu_13_0_kaanapali.h:404,413; nothing clears them here, so a bit that turns on is a first underrun).
+ * Anomalies, each one line (the first 200; "late" and "same" at most 20 lines each, counted beyond):
+ *   order    the swap id is not above the previous flip's
+ *   same     the same buffer flipped twice in a row (a different swap)
+ *   pending  a flip written while the previous flush has not latched yet (the four addresses could straddle a refresh)
+ *   late     more than one refresh between the flip and its latch (the frame counter jumped > 1)
+ *   scanout  at the latch a pipe fetches outside the flipped buffer: another slot, or none of the swap chain's (the four
+ *            32 MiB slots and the panel memory); the four pipes disagreeing is a quarter of the frame from elsewhere
+ *   underrun an underrun bit turned on (video mode: a lost line start shows as the picture moved sideways)
+ *   counter  the frame counter went backwards or jumped by thousands (the counter is not what the probe took it for)
+ * Every 5 s a summary: flips, latches and their mean / longest time, refreshes and the rate, the counters, the status
+ * word and the anomaly counts. State: one heap block (no __DATA beyond its pointer).
+ *
+ * gains2, boot-arg icedtr_fix=1 (default 0, for the A/B; works with icedtr=0 too): (1) a flip waits (at most 10 ms) for
+ * a flush still pending before it writes the four addresses, so they latch together; (2) NativeLegacyDisplay keeps the
+ * slot the panel memory replaces (directToBoot) out of reuse until that flush latched, so its tables are never
+ * rewritten under a frame still fetching from it. Both cases were read in the code as possible, neither is measured.
+ */
+/*
+ * perf1, boot-arg icedtr_scanw=1 (default 0; read only with icedtr=1 on the line; laneA: icedtr=3 is both): is the buffer on the screen
+ * written while the pipes still fetch it? The owner's video shows whole-desktop jumps that are already in the frames the
+ * pipes fetch (icedtr: scanout 0, underrun 0, same ~0 during movement), so this asks the one question icedtr cannot: does
+ * the compositor (through the GPU) draw into a buffer between its latch and the latch of the one replacing it? That
+ * happens if a swap's buffer goes back to WindowServer's pool when the swap retires at its own latch
+ * (NativeLegacyDisplay::latchTick -> finishTransfer) rather than when the next swap replaces it on the screen, and it
+ * would show as parts of a newer frame torn into the shown one. NativeLegacyDisplay hands each flip SCANW_N physical
+ * addresses spread over the surface (one 8-byte word in each of 16 evenly spaced pages, a different column in each);
+ * at a latch the words of the buffer now shown are read (each line cleaned and invalidated first: the GPU writes behind
+ * the processor's cache) and read again (1) right before the next flip is written ("before the flip") and (2) at the
+ * next latch ("by its latch", which includes (1) and may also catch writes up to one latch poll, ~0.5 ms, after the real
+ * latch). Read only: no register, no surface byte is written; ~32 cache lines read a flip. Lines "icedtr: scan-write"
+ * every 5 s with the summary, and "icedtr: SCANW" for the first 20 frames that changed. A changed word is proof of a
+ * write (or of the pages being reused); an unchanged one is no proof of none (a redraw may write the same pixels).
+ */
+#define SCANW_N         16
+#define TOP_INTR_STATUS 0x1014u
+#define TOP_UNDERRUN    (1u << 26 | 1u << 28)
+#define REC_CURRENT     0x64u
+#define INTF_COUNT_EN   0x0a8u
+#define DTR_OFF         ((struct dtr *)(uintptr_t)1)
+
+struct dtr {
+	uint32_t on, fix;
+	uint64_t next_id, next_buf, flip_id, flip_buf, prev_id, prev_buf, flip_at, sum_at, t0;
+	uint32_t flip_iova, flip_frame, flip_line, top_last, sum_frames;
+	bool have_flip, have_frames;
+	uint32_t flips, boot_flips, latches, lat_sum, lat_max;          /* this window */
+	uint32_t anom, lines, n_order, n_same, n_pending, n_late, n_scan, n_under, n_counter, l_late, l_same;
+	/* render1 r6g: refreshes between consecutive flips this window (the panel's frame counter): 0 (same refresh), 1, 2, 3,
+	 * 4-7, 8-30; longer gaps (> 250 ms at 120 Hz) are idle spells, counted apart */
+	uint32_t gap[6], gap_idle;
+	/* perf1, icedtr_scanw=1 (see hakios_iceland_dpu_trace_samples): the next flip's samples, the flipped buffer's, and the
+	 * buffer on the screen's with the words read at its latch; this window's and the run's counts */
+	uint32_t sw_on, sw_next_n, sw_flip_n, sw_cur_n;
+	uint64_t sw_next_buf, sw_cur_buf, sw_cur_id;
+	uint64_t sw_next_pa[SCANW_N], sw_flip_pa[SCANW_N], sw_cur_pa[SCANW_N], sw_cur_sig[SCANW_N];
+	uint32_t sw_checked, sw_early_f, sw_early_s, sw_late_f, sw_late_s, sw_lines;
+	uint64_t sw_tot_checked, sw_tot_late_f, sw_tot_early_f;
+};
+static struct dtr *dtr;                 /* NULL: not read yet; DTR_OFF: off (or no memory) */
+
+static struct dtr *
+dtr_get(void)
+{
+	uint32_t on = 0, fix = 0;
+	struct dtr *t;
+
+	if (dtr != NULL) {
+		return dtr == DTR_OFF ? NULL : dtr;
+	}
+	(void)PE_parse_boot_argn("icedtr", &on, sizeof(on));
+	(void)PE_parse_boot_argn("icedtr_fix", &fix, sizeof(fix));
+	t = (on || fix) ? kalloc_data(sizeof(*t), Z_NOWAIT | Z_ZERO) : NULL;
+	if (t == NULL) {
+		dtr = DTR_OFF;
+		return NULL;
+	}
+	t->on = on;
+	t->fix = fix;
+	(void)PE_parse_boot_argn("icedtr_scanw", &t->sw_on, sizeof(t->sw_on));         /* perf1 */
+	/* laneA: icedtr=3 (bit 2 of icedtr) is the trace with the scan-write check, so a gesture test line has it without the
+	 * 15 bytes of icedtr_scanw=1 (since install65 icedtr is no longer built in and the test line is at 952 usable bytes) */
+	t->sw_on = on && (t->sw_on == 1 || (on & 2) != 0);
+	t->t0 = t->sum_at = mach_absolute_time();
+	t->top_last = d.mdss ? rd(d.mdss, TOP_INTR_STATUS) : 0;
+	dtr = t;
+	printf("icedtr: presentation trace %s, latch-safe flips %s; the panel's frame counter %s; top status %08x at the start\n",
+	    on ? "on" : "off", fix ? "ON (icedtr_fix=1)" : "off", rr.ok ? "read" : "not found (vsync-lock=0?)", t->top_last);
+	if (t->sw_on) {
+		printf("icedtr: scan-write check ON (icedtr_scanw=1 or icedtr=3): %u words of each shown buffer read at its latch, before the next "
+		    "flip and at the next latch\n", SCANW_N);
+	}
+	return t;
+}
+
+/* perf1, icedtr_scanw: one word of memory as the GPU left it (the line cleaned and invalidated first, then read) */
+extern void flush_dcache64(addr64_t addr, unsigned count, int phys);
+
+static uint64_t
+scanw_read(uint64_t pa)
+{
+	flush_dcache64((addr64_t)pa, 8, 1);
+	return ml_phys_read_double_64((addr64_t)pa);
+}
+
+/* the words of the buffer on the screen that differ from what they were at its latch */
+static uint32_t
+scanw_changed(struct dtr *t)
+{
+	uint32_t n = 0;
+
+	for (uint32_t i = 0; i < t->sw_cur_n; i++) {
+		n += scanw_read(t->sw_cur_pa[i]) != t->sw_cur_sig[i];
+	}
+	return n;
+}
+
+/* NativeLegacyDisplay, right before hakios_iceland_dpu_trace_next for a flip of buffer BUF: N sample addresses in it */
+void
+hakios_iceland_dpu_trace_samples(uint64_t buf, const uint64_t *pa, uint32_t n)
+{
+	struct dtr *t = d.live ? dtr_get() : NULL;
+
+	if (t == NULL || !t->sw_on) {
+		return;
+	}
+	n = n > SCANW_N ? SCANW_N : n;
+	memcpy(t->sw_next_pa, pa, n * sizeof(pa[0]));
+	t->sw_next_n = n;
+	t->sw_next_buf = buf;
+}
+
+static uint64_t
+dtr_us(uint64_t since)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - since, &ns);
+	return ns / 1000;
+}
+
+/* the buffer the address is in: 0..SLOTS-1 a slot, SLOTS the panel memory, -1 none of the swap chain's */
+static int
+dtr_buffer_of(uint32_t a)
+{
+	if (a >= SLOT_BASE && a < SLOT_BASE + SLOTS * SLOT_BYTES) {
+		return (int)((a - SLOT_BASE) / SLOT_BYTES);
+	}
+	if (a >= d.panel && a < d.panel + d.stride * d.height) {
+		return SLOTS;
+	}
+	return -1;
+}
+
+static void
+dtr_anomaly(struct dtr *t, const char *kind, uint32_t latch_frame, const uint32_t *cur, uint32_t top)
+{
+	t->anom++;
+	if (t->lines >= 200) {
+		return;
+	}
+	t->lines++;
+	printf("icedtr: ANOMALY %u %s: swap %llu buf %#llx iova %#x (prev swap %llu buf %#llx); frames flip %u latch %u; line %u "
+	    "at the flip; pipes %08x %08x %08x %08x; top %08x; t %llu ms\n", t->anom, kind, t->flip_id, t->flip_buf >> 12, t->flip_iova,
+	    t->prev_id, t->prev_buf >> 12, t->flip_frame, latch_frame, t->flip_line, cur ? cur[0] : 0, cur ? cur[1] : 0,
+	    cur ? cur[2] : 0, cur ? cur[3] : 0, top, dtr_us(t->t0) / 1000);
+}
+
+static void
+dtr_summary(struct dtr *t)
+{
+	const uint64_t us = dtr_us(t->sum_at);
+	uint32_t frame = 0, line = 0, en = 0;
+
+	if (us < 5000000ull || !t->on) {
+		return;
+	}
+	if (rr.ok) {
+		frame = rd(rr.intf, rr.frames + INTF_FRAMES);
+		line = rd(rr.intf, rr.frames + INTF_LINES);
+		en = rd(rr.intf, rr.frames + INTF_COUNT_EN);
+	}
+	const uint32_t frames = t->have_frames ? frame - t->sum_frames : 0;
+	const uint32_t mhz = (uint32_t)((uint64_t)frames * 1000000000ull / us);       /* refreshes a second, x1000 */
+	printf("icedtr: %llu s: flips %u (panel memory %u), latched %u (%u us mean, %u max); refreshes %u (%u.%03u Hz); intf "
+	    "count_en %08x frame %u line %u; top status %08x; anomalies %u (order %u same %u pending %u late %u scanout %u underrun "
+	    "%u counter %u)\n", us / 1000000ull, t->flips, t->boot_flips, t->latches, t->latches ? t->lat_sum / t->latches : 0,
+	    t->lat_max, frames, mhz / 1000, mhz % 1000, en, frame, line, d.mdss ? rd(d.mdss, TOP_INTR_STATUS) : 0, t->anom,
+	    t->n_order, t->n_same, t->n_pending, t->n_late, t->n_scan, t->n_under, t->n_counter);
+	printf("icedtr: %llu s: refreshes between flips 0/1/2/3/4-7/8-30: %u %u %u %u %u %u; idle gaps %u\n", us / 1000000ull,
+	    t->gap[0], t->gap[1], t->gap[2], t->gap[3], t->gap[4], t->gap[5], t->gap_idle);
+	if (t->sw_on) {
+		printf("icedtr: %llu s: scan-write: %u shown buffers checked; written while on the screen: before the next flip %u (%u "
+		    "words), by its latch %u (%u words); run %llu of %llu (before the flip %llu)\n", us / 1000000ull, t->sw_checked,
+		    t->sw_early_f, t->sw_early_s, t->sw_late_f, t->sw_late_s, t->sw_tot_late_f, t->sw_tot_checked, t->sw_tot_early_f);
+		t->sw_checked = t->sw_early_f = t->sw_early_s = t->sw_late_f = t->sw_late_s = 0;
+	}
+	bzero(t->gap, sizeof(t->gap));
+	t->gap_idle = 0;
+	t->sum_at = mach_absolute_time();
+	t->sum_frames = frame;
+	t->have_frames = rr.ok;
+	t->flips = t->boot_flips = t->latches = t->lat_sum = t->lat_max = 0;
+}
+
+/* the next flip's swap id and buffer (the surface's first physical page); 0, 0: the panel memory */
+void
+hakios_iceland_dpu_trace_next(uint64_t id, uint64_t buf)
+{
+	struct dtr *t = d.live ? dtr_get() : NULL;
+
+	if (t != NULL) {
+		t->next_id = id;
+		t->next_buf = buf;
+	}
+}
+
+/* true: icedtr_fix=1 (NativeLegacyDisplay keeps the slot the panel memory replaces until the flush latched) */
+bool
+hakios_iceland_dpu_fix(void)
+{
+	struct dtr *t = d.live ? dtr_get() : NULL;
+
+	return t != NULL && t->fix != 0;
+}
+
+/* in hakios_iceland_dpu_flip, before the four addresses are written */
+static void
+dtr_flip(uint32_t iova)
+{
+	struct dtr *t = dtr_get();
+
+	if (t == NULL) {
+		return;
+	}
+	const bool pending = (rd(d.mdss, CTL0_FLUSH) & d.flush_mask) != 0;
+	if (pending && t->fix) {
+		for (int i = 0; i < 100 && (rd(d.mdss, CTL0_FLUSH) & d.flush_mask) != 0; i++) {
+			delay(100);
+		}
+	}
+	if (t->sw_on) {                         /* perf1, icedtr_scanw: the buffer on the screen, from its latch to now */
+		if (t->sw_cur_n != 0) {
+			const uint32_t c = scanw_changed(t);
+
+			t->sw_early_s += c;
+			t->sw_early_f += c != 0;
+			t->sw_tot_early_f += c != 0;
+		}
+		t->sw_flip_n = t->next_buf != 0 && t->sw_next_buf == t->next_buf ? t->sw_next_n : 0;
+		memcpy(t->sw_flip_pa, t->sw_next_pa, sizeof(t->sw_flip_pa));
+		t->sw_next_n = 0;
+		t->sw_next_buf = 0;
+		if (t->sw_flip_n == 0) {
+			t->sw_cur_n = 0;                /* the panel memory (no traced latch follows): the old buffer is let go now */
+		}
+	}
+	t->prev_id = t->flip_id;
+	t->prev_buf = t->flip_buf;
+	t->flip_id = t->next_id;
+	t->flip_buf = t->next_buf;
+	t->next_id = t->next_buf = 0;
+	t->flip_iova = iova;
+	t->flip_at = mach_absolute_time();
+	{
+		const uint32_t frame = rr.ok ? rd(rr.intf, rr.frames + INTF_FRAMES) : 0;
+
+		if (rr.ok && t->have_flip) {
+			const uint32_t g = frame - t->flip_frame;       /* refreshes since the previous flip (r6g) */
+
+			if (g > 30) {
+				t->gap_idle++;
+			} else {
+				t->gap[g <= 3 ? g : g <= 7 ? 4 : 5]++;
+			}
+		}
+		t->flip_frame = frame;
+	}
+	t->flip_line = rr.ok && rr.video != ~0u ? rd(rr.intf, rr.video + INTF_LINES) : ~0u;
+	t->flips++;
+	t->boot_flips += t->flip_id == 0;
+	if (!t->on) {
+		t->have_flip = true;
+		return;
+	}
+	if (pending) {
+		t->n_pending++;
+		dtr_anomaly(t, t->fix ? "pending (waited)" : "pending", 0, NULL, rd(d.mdss, TOP_INTR_STATUS));
+	}
+	if (t->have_flip && t->flip_id != 0 && t->prev_id != 0 && t->flip_id <= t->prev_id) {
+		t->n_order++;
+		dtr_anomaly(t, "order", 0, NULL, rd(d.mdss, TOP_INTR_STATUS));
+	}
+	if (t->have_flip && t->flip_buf != 0 && t->flip_buf == t->prev_buf && t->flip_id != t->prev_id) {
+		t->n_same++;
+		if (t->l_same++ < 20) {
+			dtr_anomaly(t, "same", 0, NULL, rd(d.mdss, TOP_INTR_STATUS));
+		}
+	}
+	t->have_flip = true;
+	dtr_summary(t);
+}
+
+/* NativeLegacyDisplay's latch (the flush bits cleared, or 50 ms passed: LATCHED false) of swap ID after US */
+void
+hakios_iceland_dpu_trace_latch(uint64_t id, bool latched, uint32_t us)
+{
+	struct dtr *t = d.live ? dtr_get() : NULL;
+	uint32_t cur[4], frame = 0;
+
+	if (t == NULL || !t->on || !t->have_flip) {
+		return;
+	}
+	t->latches++;
+	t->lat_sum += us;
+	if (us > t->lat_max) {
+		t->lat_max = us;
+	}
+	for (unsigned p = 0; p < 4; p++) {
+		cur[p] = rd(d.mdss, rec0[p] + REC_CURRENT);
+	}
+	const uint32_t top = rd(d.mdss, TOP_INTR_STATUS);
+	if (rr.ok) {
+		frame = rd(rr.intf, rr.frames + INTF_FRAMES);
+		const uint32_t delta = frame - t->flip_frame;
+
+		if (delta > 5000u) {
+			t->n_counter++;
+			dtr_anomaly(t, "counter", frame, cur, top);
+		} else if (delta > 1 && latched) {
+			t->n_late++;
+			if (t->l_late++ < 20) {
+				dtr_anomaly(t, "late", frame, cur, top);
+			}
+		}
+	}
+	if (id != t->flip_id) {
+		/* the latch of another flip than the last one traced (a panel-memory flip came between): no buffer check */
+	} else if (latched) {
+		const int want = dtr_buffer_of(t->flip_iova);
+		bool off = false;
+
+		for (unsigned p = 0; p < 4; p++) {
+			off = off || dtr_buffer_of(cur[p]) != want || want < 0;
+		}
+		if (off) {
+			t->n_scan++;
+			dtr_anomaly(t, "scanout", frame, cur, top);
+		}
+	}
+	if ((top & ~t->top_last) & TOP_UNDERRUN) {
+		t->n_under++;
+		dtr_anomaly(t, "underrun", frame, cur, top);
+	}
+	t->top_last = top;
+	if (t->sw_on) {                         /* perf1, icedtr_scanw: the buffer this latch took off the screen, then the new one */
+		if (t->sw_cur_n != 0 && latched && id == t->flip_id) {
+			const uint32_t c = scanw_changed(t);
+
+			t->sw_checked++;
+			t->sw_tot_checked++;
+			t->sw_late_s += c;
+			t->sw_late_f += c != 0;
+			t->sw_tot_late_f += c != 0;
+			if (c != 0 && t->sw_lines < 20) {
+				t->sw_lines++;
+				printf("icedtr: SCANW %llu: swap %llu buf %#llx: %u of %u words changed while it was on the screen (next swap %llu "
+				    "latched after %u us); t %llu ms\n", t->sw_tot_late_f, t->sw_cur_id, t->sw_cur_buf >> 12, c, t->sw_cur_n,
+				    id, us, dtr_us(t->t0) / 1000);
+			}
+		}
+		if (latched && id == t->flip_id && t->sw_flip_n != 0) {
+			t->sw_cur_n = t->sw_flip_n;
+			t->sw_cur_buf = t->flip_buf;
+			t->sw_cur_id = t->flip_id;
+			memcpy(t->sw_cur_pa, t->sw_flip_pa, sizeof(t->sw_cur_pa));
+			for (uint32_t i = 0; i < t->sw_cur_n; i++) {
+				t->sw_cur_sig[i] = scanw_read(t->sw_cur_pa[i]);
+			}
+		} else {
+			t->sw_cur_n = 0;                /* the panel memory, no samples, or not known to have latched: nothing watched */
+		}
+	}
+	dtr_summary(t);
+}
+
+/* a fault in the bank: the pipes back on the panel memory, translation off, the copy from now on */
+bool
+hakios_iceland_dpu_faulted(void)
+{
+	if (!d.live) {
+		return d.faults != 0;
+	}
+	const uint32_t fsr = rd(d.cb, 0x58);
+	if (!(fsr & FSR_FAULT)) {
+		return false;
+	}
+	d.faults++;
+	printf("icedpu: FAULT: FSR %08x FAR %08x%08x FSYNR0 %08x: back to the panel memory and the copy\n", fsr, rd(d.cb, 0x64),
+	    rd(d.cb, 0x60), rd(d.cb, 0x68));
+	(void)pipes_to_panel(true);
+	d.live = false;
+	native_ufs_dpu_state = 0;
+	bank_back(true);
+	return true;
+}
+
+/* the run's end (reset-after's thread): the pipes back, then the bank as found, the census */
+void
+hakios_iceland_dpu_stop(void)
+{
+	if (!d.live) {
+		return;
+	}
+	const bool taken = pipes_to_panel(true);
+	d.live = false;
+	native_ufs_dpu_state = 0;
+	bank_back(true);
+	ufs_census("after the undo", true);
+	printf("icedpu: stopped: the pipes on the panel memory (%s), translation off\n", taken ? "latched" : "NOT latched in 50 ms");
+}
+
+/* a panic: the pipes back on the panel memory before anything else (the tables stay: no walk changes), so the panic's
+ * screen, drawn there, is what the panel shows; loader_return undoes the rest */
+void
+hakios_iceland_dpu_panic_show(void)
+{
+	if (d.live) {
+		(void)pipes_to_panel(false);
+	}
+}
+
+/* loader_return (interrupts off, no printing): as hakios_iceland_dpu_stop, quietly */
+void
+hakios_iceland_dpu_quiesce(void)
+{
+	if (!d.live) {
+		return;
+	}
+	(void)pipes_to_panel(true);
+	d.live = false;
+	native_ufs_dpu_state = 0;
+	bank_back(false);
+}
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/bsd/dev/hakios_iceland_dsi.c b/bsd/dev/hakios_iceland_dsi.c
new file mode 100644
index 0000000000000000000000000000000000000000..bc513e8708d994e2e42ec37ff96a88ed7c165da7
--- /dev/null
+++ b/bsd/dev/hakios_iceland_dsi.c
@@ -0,0 +1,462 @@
+/*
+ * The OnePlus Pad 4's ("iceland") DSI command path: kit 25d1, one DCS read from the panel (CSOT XN251 / NT36536), the
+ * prerequisite of a screen off / on kit (25d2: display-off 0x28 + sleep-in 0x10, then sleep-out 0x11 + display-on 0x29).
+ *
+ * What is there (26a, icedsi=1, reads): both DSI hosts (DT dsi@9ac0000, dsi@9ac3000, "qcom,kaanapali-dsi-ctrl", 6G
+ * v2.10, version 0x200a0000) in video mode, CTRL 0x1f7 (enable, video and command mode, 4 lanes, clock), TRIG_CTRL
+ * 0x80000004 (DMA trigger by software), lanes 0x1f1f / 0x1f00: the boot chain left the panel streaming the boot
+ * framebuffer in video mode, the two links bonded and synchronized (DT qcom,dual-dsi-mode, qcom,sync-dual-dsi).
+ *
+ * How Linux sends a command in video mode (drivers/gpu/drm/msm/dsi/dsi_host.c, registers dsi.xml, all 4 bytes up on
+ * 6G, DSI_6G_REG_SHIFT): the packet goes into memory in the controller's own format (dsi_cmd_dma_add: param 0, param 1,
+ * data type | virtual channel << 6, then 0x80 last | 0x40 long | 0x20 a read: a bus turn-around follows), DMA_BASE /
+ * DMA_LEN name it, TRIG_DMA = 1 sends it in the next blanking (TRIG_CTRL BLOCK_DMA_WITHIN_FRAME holds it out of the
+ * active lines), INTR_CTRL bit 0 (CMD_DMA_DONE) says it went; a read is preceded by SET_MAXIMUM_RETURN_PACKET_SIZE
+ * (0x37) and RDBK_DATA_CTRL's clear, and the answer is in RDBK_DATA0..3 (big-endian bytes: data type 0x21 = DCS short
+ * read response, 1 byte).
+ *
+ * Where the packet can be: the display's reads go through the apps SMMU's display bank, which the boot chain leaves
+ * untranslating; the hypervisor lets the display reach the continuous-splash region alone (DT splash_region 0xfc800000,
+ * 0x2b00000; dada's finding, hakios_dada_dpu.c). The boot framebuffer takes its first 32.56 MB (3392 x 2400 x 4); its
+ * last 4 KB page (0xff2ff000) is outside what anyone draws or scans out: the packet goes there. Only without icescan
+ * (which turns that bank's translation on with the framebuffer alone mapped): refused otherwise.
+ *
+ * Boot-args (none: nothing): icedcs=1 (25d1 dry): the registers as found, the buffer page as found, nothing written.
+ * icedcs=2 (25d1, class C: DSI host registers only, the panel is only read): at icedcs_at s (default 60), on dsi0 alone
+ * (the master link; its partner keeps streaming): TRIG_CTRL += BLOCK_DMA_WITHIN_FRAME, CMD_DMA_CTRL = FROM_FRAME_BUFFER |
+ * LOW_POWER (Linux's setting), the two packets, then CMD_DMA_CTRL and TRIG_CTRL put back as found; INTR_CTRL's enables
+ * are never changed (only its DMA-done status cleared, as Linux's handler does). Each step waits for DMA-done at most 100
+ * ms; a timeout stops the kit (registers put back). Lines "icedcs: ..."; the answer "icedcs: 25d1 get_power_mode 0x0a ->
+ * 0x.." (expected 0x9c: booster, sleep out, normal mode, display on) or the acknowledge-error word.
+ *
+ * icedcs=3 (25d2, after 25d1's PASS: get_power_mode 0x9c, DMA done in 74 / 77 us): the screen off and on again through
+ * the same path, on both links (DT dsi@9ac3000 at +0x3000, inside dsi0's 16 KB mapping; the bonded panel takes its
+ * commands on both, as Linux's dual-link Novatek panels send them), each link set up and put back as in 25d1:
+ *   get_power_mode (dsi0) -> display-off 0x28 (both), 20 ms, sleep-in 0x10 (both), 120 ms -> get_power_mode (dsi0;
+ *   expected 0x08: booster on only, i.e. bits sleep-out / display-on clear) -> icedcs_off ms dark (default 1000, at
+ *   most 3000) -> sleep-out 0x11 (both), 120 ms, display-on 0x29 (both), 20 ms -> get_power_mode (dsi0; 0x9c again).
+ * DCS short writes without a parameter (data type 0x05), low-power mode, sent in the blanking. The screen-on half is
+ * always sent once the screen-off half began, also after a failed step. A link not in the state 25d1 found (enabled,
+ * command mode allowed, software DMA trigger) refuses the whole kit before anything is sent. INTR_CTRL: only the
+ * DMA-done status is cleared now (25d1 also cleared VIDEO_DONE, bit 16, by writing back what it read).
+ * Lines "icedcs: 25d2 ..."; the verdict "icedcs: 25d2 PASS|FAIL: before 0x.., off 0x.., after 0x.., N of 8 writes done".
+ * 25d2 PASSED (1 Nov 11:40: before 0x9c, off 0x08, after 0x9c, 8 of 8, both links put back, frames went on).
+ *
+ * 25hot1 (boot-arg fb_panelpower=1, MiniIOMobileFramebuffer selector 12 = backboardd's display power request, the
+ * power button / auto-lock; after IOS-26-Hot's 0079-sweet-display-power, which only blanks the picture): the panel
+ * really off and on with 25d2's commands - hakios_iceland_dsi_panel(0): display-off 0x28 (both links), 20 ms,
+ * sleep-in 0x10 (both), 120 ms, get_power_mode; (1): sleep-out 0x11 (both), 120 ms, display-on 0x29 (both), 20 ms,
+ * get_power_mode. Each call sets both links up as 25d2 and puts them back; a request for the state the panel is
+ * already in sends nothing; refused with icescan (as 25d1). Lines "icedcs: 25hot1 panel off|on: ...".
+ * icelock_at=S (25hot1's test; 0 = off): S s after start a press of the power (lock) key is posted as the key would
+ * (redwood_touch_post: down, 150 ms, up), and icelock_wake (default 20) s later a second one: backboardd locks and asks
+ * the display off, then wakes it. Lines "icedcs: 25hot1 lock key ...".
+ */
+/*
+ * macOS: the kernel is prelinked into Apple's collection, whose __TEXT had no room for this iPadOS-only driver (M2). Since
+ * w3-power the panel off / on of 25hot1 (hakios_iceland_dsi_panel, with send / power_mode / both) is built for macOS too, for
+ * the display's power requests (iokit/Native/GopFramebuffer/NativeLegacyDisplay.cpp, disp-sleep=2); the kits 25d1 / 25d2 and
+ * the lock-key test stay iPadOS-only (the __TEXT check of the build still has 300 KB of the collection's hole left).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <vm/memory_types.h>
+#include <kern/locks.h>
+#include <sys/redwood_input.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
+extern void IOSleep(unsigned int milliseconds);
+
+#define say(...) printf("icedcs: " __VA_ARGS__)
+
+#define DSI0_PHYS               0x09ac0000u
+#define SPLASH_PHYS             0xfc800000ull
+#define SPLASH_SIZE             0x2b00000ull
+#define PKT_PHYS                (SPLASH_PHYS + SPLASH_SIZE - 0x1000ull)     /* 0xff2ff000 */
+#define FB_BYTES                (3392ull * 2400ull * 4ull)
+
+/* 6G: dsi.xml offsets + 4 */
+#define R_CTRL                  0x004
+#define R_STATUS0               0x008
+#define R_FIFO_STATUS           0x00c
+#define R_CMD_DMA_CTRL          0x03c
+#define R_DMA_BASE              0x048
+#define R_DMA_LEN               0x04c
+#define R_ACK_ERR               0x068
+#define R_RDBK(i)               (0x06c + 4 * (i))
+#define R_TRIG_CTRL             0x084
+#define R_TRIG_DMA              0x090
+#define R_INTR_CTRL             0x110
+#define R_CLK_STATUS            0x120
+#define R_RDBK_CTRL             0x1d4
+
+#define DMA_FROM_FB             (1u << 28)
+#define DMA_LOW_POWER           (1u << 26)
+#define TRIG_BLOCK_DMA          (1u << 12)
+#define IRQ_DMA_DONE            (1u << 0)
+#define IRQ_STATUS_BITS         0x01110101u     /* CMD_DMA_DONE, CMD_MDP_DONE, VIDEO_DONE, BTA_DONE, ERROR: write 1 clears */
+#define DSI1_OFFSET             0x3000u         /* dsi@9ac3000, in dsi0's 16 KB page */
+
+static vm_offset_t dsi, pkt, dsi0;
+static const char *tag = "25d1";
+
+static inline uint32_t
+rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(dsi + off);
+}
+
+static inline void
+wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(dsi + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+#if !defined(XNU_TARGET_OS_OSX)
+static void
+show(const char *when)
+{
+	say("%s: ctrl %08x status0 %08x fifo %08x cmd_dma_ctrl %08x dma_base %08x len %08x ack_err %08x rdbk %08x %08x %08x "
+	    "%08x trig %08x intr %08x clk_status %08x rdbk_ctrl %08x\n", when, rd(R_CTRL), rd(R_STATUS0), rd(R_FIFO_STATUS),
+	    rd(R_CMD_DMA_CTRL), rd(R_DMA_BASE), rd(R_DMA_LEN), rd(R_ACK_ERR), rd(R_RDBK(0)), rd(R_RDBK(1)), rd(R_RDBK(2)),
+	    rd(R_RDBK(3)), rd(R_TRIG_CTRL), rd(R_INTR_CTRL), rd(R_CLK_STATUS), rd(R_RDBK_CTRL));
+}
+#endif /* !XNU_TARGET_OS_OSX */
+
+/* one packet of 4 bytes (the controller's format) sent; true when DMA-done came within 100 ms */
+static bool
+send(const char *what, uint8_t p0, uint8_t p1, uint8_t dt, uint8_t flags)
+{
+	uint64_t t0, now, ns;
+
+	*(volatile uint32_t *)pkt = (uint32_t)p0 | (uint32_t)p1 << 8 | (uint32_t)dt << 16 | (uint32_t)flags << 24;
+	*(volatile uint32_t *)(pkt + 4) = 0xffffffffu;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(R_INTR_CTRL, (rd(R_INTR_CTRL) & ~IRQ_STATUS_BITS) | IRQ_DMA_DONE);  /* (write 1: clear a stale done, only it) */
+	wr(R_DMA_BASE, (uint32_t)PKT_PHYS);
+	wr(R_DMA_LEN, 4);
+	t0 = mach_absolute_time();
+	wr(R_TRIG_DMA, 1);
+	for (;;) {
+		uint32_t intr = rd(R_INTR_CTRL);
+
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - t0, &ns);
+		if (intr & IRQ_DMA_DONE) {
+			wr(R_INTR_CTRL, (intr & ~IRQ_STATUS_BITS) | IRQ_DMA_DONE);
+			say("%s %s: %02x %02x %02x %02x sent, DMA done after %llu us (status0 %08x ack_err %08x)\n", tag, what, p0, p1,
+			    dt, flags, ns / 1000, rd(R_STATUS0), rd(R_ACK_ERR));
+			return true;
+		}
+		if (ns > 100 * NSEC_PER_MSEC) {
+			say("%s %s: NO DMA DONE in 100 ms (intr %08x status0 %08x fifo %08x)\n", tag, what, intr, rd(R_STATUS0),
+			    rd(R_FIFO_STATUS));
+			return false;
+		}
+		delay(50);
+	}
+}
+
+/* 25d2: get_power_mode on dsi0: the value, or -1 (no DMA done / no DCS answer) */
+static int
+power_mode(const char *when)
+{
+	uint32_t r0;
+
+	dsi = dsi0;
+	if (!send("max return packet size 1", 0x01, 0x00, 0x37, 0x80)) {
+		return -1;
+	}
+	wr(R_RDBK_CTRL, 1);
+	wr(R_RDBK_CTRL, 0);
+	if (!send("DCS read 0x0a", 0x0a, 0x00, 0x06, 0x80 | 0x20)) {
+		return -1;
+	}
+	IOSleep(2);
+	r0 = rd(R_RDBK(0));
+	say("25d2 get_power_mode %s: rdbk0 %08x ack_err %08x\n", when, r0, rd(R_ACK_ERR));
+	return (r0 >> 24) == 0x21 ? (int)((r0 >> 16) & 0xff) : -1;
+}
+
+/* 25d2: one DCS short write without a parameter on both links; how many went */
+static unsigned
+both(const char *what, uint8_t cmd)
+{
+	unsigned done = 0;
+
+	for (unsigned l = 0; l < 2; l++) {
+		dsi = dsi0 + l * DSI1_OFFSET;
+		done += send(what, cmd, 0x00, 0x05, 0x80) ? 1 : 0;
+	}
+	dsi = dsi0;
+	return done;
+}
+
+#if !defined(XNU_TARGET_OS_OSX)
+static void
+screen_off_on(void)
+{
+	uint32_t off_ms = 1000;
+	unsigned done = 0;
+	int before, during, after;
+
+	(void)PE_parse_boot_argn("icedcs_off", &off_ms, sizeof(off_ms));
+	off_ms = off_ms < 100 ? 100 : off_ms > 3000 ? 3000 : off_ms;
+	before = power_mode("before");
+	if (before < 0) {
+		say("25d2 FAIL: no get_power_mode answer before: nothing sent\n");
+		return;
+	}
+	done += both("display off 0x28", 0x28);
+	IOSleep(20);
+	done += both("sleep in 0x10", 0x10);
+	IOSleep(120);
+	during = power_mode("off");
+	IOSleep(off_ms);
+	/* the screen-on half: always, whatever went before */
+	done += both("sleep out 0x11", 0x11);
+	IOSleep(120);
+	done += both("display on 0x29", 0x29);
+	IOSleep(20);
+	after = power_mode("after");
+	say("25d2 %s: before %#x, off %#x%s, after %#x, %u of 8 writes done, dark %u ms (-1 / 0xffffffff: no answer)\n",
+	    done == 8 && after == 0x9c ? "PASS" : "FAIL", (unsigned)before, (unsigned)during,
+	    during >= 0 && (during & 0x14) == 0 ? " (sleep in, display off: seen)" : " (off state not seen)", (unsigned)after,
+	    done, off_ms);
+}
+
+static void
+icedcs_thread(void *arg, wait_result_t w __unused)
+{
+	uint32_t mode = (uint32_t)(uintptr_t)arg, at = 60, scan = 0;
+
+	(void)PE_parse_boot_argn("icedcs_at", &at, sizeof(at));
+	at = at < 20 ? 20 : at > 280 ? 280 : at;
+	IOSleep(at * 1000);
+	dsi = ml_io_map_unmappable(DSI0_PHYS, PAGE_SIZE, VM_WIMG_IO);
+	pkt = ml_io_map_unmappable((vm_offset_t)PKT_PHYS, PAGE_SIZE, VM_WIMG_IO);
+	if (dsi == 0 || pkt == 0) {
+		say("25d1: no mapping (dsi %lx, page %lx)\n", (unsigned long)dsi, (unsigned long)pkt);
+		return;
+	}
+	dsi0 = dsi;
+	if (mode >= 3) {
+		tag = "25d2";
+	}
+	{
+		uint32_t nonzero = 0;
+
+		for (uint32_t i = 0; i < PAGE_SIZE / 4; i++) {
+			nonzero += *(volatile uint32_t *)(pkt + 4 * i) != 0;
+		}
+		say("25d1: packet page %#llx (splash region's last; the framebuffer ends at %#llx): %u of %u words not 0, first "
+		    "%08x %08x\n", PKT_PHYS, SPLASH_PHYS + FB_BYTES, nonzero, (uint32_t)(PAGE_SIZE / 4), *(volatile uint32_t *)pkt,
+		    *(volatile uint32_t *)(pkt + 4));
+	}
+	show("as found");
+	if (mode < 2) {
+		say("25d1 dry (icedcs=1): nothing written\n");
+		return;
+	}
+	if (PE_parse_boot_argn("icescan", &scan, sizeof(scan)) && scan != 0) {
+		say("25d1 REFUSED: icescan=%u turns the display bank's translation on (the packet page is not mapped there)\n", scan);
+		return;
+	}
+	if (mode >= 3) {
+		uint32_t c[2], d[2], t[2];
+
+		for (unsigned l = 0; l < 2; l++) {
+			dsi = dsi0 + l * DSI1_OFFSET;
+			c[l] = rd(R_CTRL);
+			d[l] = rd(R_CMD_DMA_CTRL);
+			t[l] = rd(R_TRIG_CTRL);
+			if (l == 1) {
+				show("dsi1 as found");
+			}
+			if ((c[l] & 0x5) != 0x5 || (t[l] & 0x7) != 4) {
+				say("25d2 REFUSED: dsi%u ctrl %08x (enable + command mode wanted) trig %08x (software DMA trigger wanted)\n",
+				    l, c[l], t[l]);
+				dsi = dsi0;
+				return;
+			}
+		}
+		for (unsigned l = 0; l < 2; l++) {
+			dsi = dsi0 + l * DSI1_OFFSET;
+			wr(R_TRIG_CTRL, t[l] | TRIG_BLOCK_DMA);
+			wr(R_CMD_DMA_CTRL, DMA_FROM_FB | DMA_LOW_POWER);
+		}
+		dsi = dsi0;
+		screen_off_on();
+		for (unsigned l = 0; l < 2; l++) {
+			dsi = dsi0 + l * DSI1_OFFSET;
+			wr(R_CMD_DMA_CTRL, d[l]);
+			wr(R_TRIG_CTRL, t[l]);
+			show(l == 0 ? "dsi0 after (put back)" : "dsi1 after (put back)");
+		}
+		dsi = dsi0;
+		return;
+	}
+	uint32_t ctrl = rd(R_CTRL), dma_ctrl = rd(R_CMD_DMA_CTRL), trig = rd(R_TRIG_CTRL);
+
+	if ((ctrl & 0x5) != 0x5 || (trig & 0x7) != 4) {
+		say("25d1 REFUSED: ctrl %08x (enable + command mode wanted) trig %08x (software DMA trigger wanted)\n", ctrl, trig);
+		return;
+	}
+	wr(R_TRIG_CTRL, trig | TRIG_BLOCK_DMA);
+	wr(R_CMD_DMA_CTRL, DMA_FROM_FB | DMA_LOW_POWER);
+	/* SET_MAXIMUM_RETURN_PACKET_SIZE 1; then the read buffer cleared; then DCS read 0x0a (get_power_mode) with a turn-around */
+	if (send("max return packet size 1", 0x01, 0x00, 0x37, 0x80)) {
+		wr(R_RDBK_CTRL, 1);
+		wr(R_RDBK_CTRL, 0);
+		if (send("DCS read 0x0a", 0x0a, 0x00, 0x06, 0x80 | 0x20)) {
+			IOSleep(2);
+			uint32_t r0 = rd(R_RDBK(0)), ack = rd(R_ACK_ERR), cnt = (rd(R_RDBK_CTRL) >> 16) & 0xff;
+			/* RDBK_DATA0 big-endian: byte 0 the response's data type, byte 1 its first value */
+			uint8_t type = (uint8_t)(r0 >> 24), value = (uint8_t)(r0 >> 16);
+
+			say("25d1 get_power_mode 0x0a -> rdbk0 %08x (type %#x value %#x), count %u, ack_err %08x: %s\n", r0, type,
+			    value, cnt, ack, type == 0x21 ? (value == 0x9c ? "PASS (0x9c: booster, sleep out, normal, display on)" :
+			    "PASS (an answer)") : type == 0x02 ? "the panel answered an acknowledge-error report" : "no DCS answer");
+		}
+	}
+	wr(R_CMD_DMA_CTRL, dma_ctrl);
+	wr(R_TRIG_CTRL, trig);
+	show("after (put back)");
+}
+
+#endif /* !XNU_TARGET_OS_OSX: the kits */
+
+/* ---- 25hot1: the panel off / on for the display's power requests ---- */
+static LCK_GRP_DECLARE(icedcs_grp, "icedcs");
+static LCK_MTX_DECLARE(icedcs_panel_lock, &icedcs_grp);
+static int panel_is_on = 1;     /* (the boot chain left it on) */
+
+int hakios_iceland_dsi_panel(int on);
+
+int
+hakios_iceland_dsi_panel(int on)
+{
+	uint32_t scan = 0, c[2], d[2], t[2];
+	unsigned done = 0;
+	int mode = -1;
+
+	tag = "25hot1";
+	if (PE_parse_boot_argn("icescan", &scan, sizeof(scan)) && scan != 0) {
+		say("25hot1 panel %s: REFUSED with icescan=%u (the packet page is not mapped in the display's bank)\n",
+		    on ? "on" : "off", scan);
+		return -1;
+	}
+	lck_mtx_lock(&icedcs_panel_lock);
+	if ((on != 0) == (panel_is_on != 0)) {
+		lck_mtx_unlock(&icedcs_panel_lock);
+		say("25hot1 panel %s: already %s, nothing sent\n", on ? "on" : "off", on ? "on" : "off");
+		return 0;
+	}
+	if (dsi0 == 0) {
+		dsi0 = ml_io_map_unmappable(DSI0_PHYS, PAGE_SIZE, VM_WIMG_IO);
+	}
+	if (pkt == 0) {
+		pkt = ml_io_map_unmappable((vm_offset_t)PKT_PHYS, PAGE_SIZE, VM_WIMG_IO);
+	}
+	if (dsi0 == 0 || pkt == 0) {
+		lck_mtx_unlock(&icedcs_panel_lock);
+		say("25hot1 panel %s: no mapping\n", on ? "on" : "off");
+		return -1;
+	}
+	for (unsigned l = 0; l < 2; l++) {
+		dsi = dsi0 + l * DSI1_OFFSET;
+		c[l] = rd(R_CTRL);
+		d[l] = rd(R_CMD_DMA_CTRL);
+		t[l] = rd(R_TRIG_CTRL);
+		if ((c[l] & 0x5) != 0x5 || (t[l] & 0x7) != 4) {
+			dsi = dsi0;
+			lck_mtx_unlock(&icedcs_panel_lock);
+			say("25hot1 panel %s: REFUSED: dsi%u ctrl %08x trig %08x\n", on ? "on" : "off", l, c[l], t[l]);
+			return -1;
+		}
+	}
+	for (unsigned l = 0; l < 2; l++) {
+		dsi = dsi0 + l * DSI1_OFFSET;
+		wr(R_TRIG_CTRL, t[l] | TRIG_BLOCK_DMA);
+		wr(R_CMD_DMA_CTRL, DMA_FROM_FB | DMA_LOW_POWER);
+	}
+	dsi = dsi0;
+	if (!on) {
+		done += both("display off 0x28", 0x28);
+		IOSleep(20);
+		done += both("sleep in 0x10", 0x10);
+		IOSleep(120);
+	} else {
+		done += both("sleep out 0x11", 0x11);
+		IOSleep(120);
+		done += both("display on 0x29", 0x29);
+		IOSleep(20);
+	}
+	mode = power_mode(on ? "on" : "off");
+	for (unsigned l = 0; l < 2; l++) {
+		dsi = dsi0 + l * DSI1_OFFSET;
+		wr(R_CMD_DMA_CTRL, d[l]);
+		wr(R_TRIG_CTRL, t[l]);
+	}
+	dsi = dsi0;
+	panel_is_on = on;
+	lck_mtx_unlock(&icedcs_panel_lock);
+	say("25hot1 panel %s: %u of 4 writes done, power mode %#x: %s\n", on ? "on" : "off", done, (unsigned)mode,
+	    done == 4 && (on ? mode == 0x9c : (mode >= 0 && (mode & 0x14) == 0)) ? "PASS" : "FAIL");
+	return done == 4 ? 0 : -1;
+}
+
+#if !defined(XNU_TARGET_OS_OSX)
+static void
+icelock_press(const char *why)
+{
+	say("25hot1 lock key: pressed (%s)\n", why);
+	redwood_touch_post(REDWOOD_BUTTON_DOWN, REDWOOD_BUTTON_LOCK, 0, 0);
+	IOSleep(150);
+	redwood_touch_post(REDWOOD_BUTTON_UP, REDWOOD_BUTTON_LOCK, 0, 0);
+}
+
+static void
+icelock_thread(void *arg, wait_result_t w __unused)
+{
+	uint32_t at = (uint32_t)(uintptr_t)arg, wake = 20;
+
+	(void)PE_parse_boot_argn("icelock_wake", &wake, sizeof(wake));
+	wake = wake < 5 ? 5 : wake > 120 ? 120 : wake;
+	IOSleep(at * 1000);
+	icelock_press("lock: the display should go off");
+	IOSleep(wake * 1000);
+	icelock_press("wake: the display should come on");
+	IOSleep(5000);
+	say("25hot1 lock key: done; the panel is %s\n", panel_is_on ? "on" : "off");
+}
+
+void hakios_iceland_dsi_init(void);
+
+void
+hakios_iceland_dsi_init(void)
+{
+	uint32_t mode = 0, lock_at = 0;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("icelock_at", &lock_at, sizeof(lock_at)) && lock_at != 0) {
+		lock_at = lock_at < 30 ? 30 : lock_at > 290 ? 290 : lock_at;
+		if (kernel_thread_start(icelock_thread, (void *)(uintptr_t)lock_at, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+
+	if (!PE_parse_boot_argn("icedcs", &mode, sizeof(mode)) || mode == 0) {
+		return;
+	}
+	if (kernel_thread_start(icedcs_thread, (void *)(uintptr_t)mode, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* !defined(XNU_TARGET_OS_OSX) */
diff --git a/bsd/dev/hakios_iceland_gpu.c b/bsd/dev/hakios_iceland_gpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..ffbd3515f84aeb24ede7bd6a4cf4487031624f8c
--- /dev/null
+++ b/bsd/dev/hakios_iceland_gpu.c
@@ -0,0 +1,6648 @@
+/*
+ * The OnePlus Pad 4's (iceland, SM8850P "kaanapali") GPU, an Adreno 840 (Linux a8xx_catalog.c: chip id 0x44050a01,
+ * ADRENO_8XX_GEN2, GMU firmware gen80200_gmu.bin): a survey kit. Only with boot-arg icegpu=N; without it nothing here is
+ * touched. No command submission: the 3D core's command processor, its SQE / AQE microcode and the zap shader are not
+ * loaded (Linux needs none of them for what is done here: a6xx_gmu_resume brings the GMU up and the GPU's power is the
+ * GMU's "OOB GPU" answer; the SQE and zap only come in a8xx_hw_init).
+ *
+ *   icegpu=1  read only. gpucc (always reachable: its bus clock gcc_gpu_cfg_ahb is critical) and GCC's GPU votes and
+ *             clocks; then, only if the CX power switch reads on AND the GMU's clocks run, the GMU, its RSCC, cx_misc and
+ *             the GX switch; only if CX is on AND the SMMU's clock runs, the GPU's SMMU (globals, stream matching, context
+ *             banks). RPMh: cmd-db's levels of gfx / mx / cx / gmxc / gbx and the bus managers SH0 / MC0 / ACV / CN0 (read
+ *             only; nothing is voted). The GMU firmware in md1's fw/ checked (block layout, version word).
+ *   icegpu=2  ... and powered up the way Linux's a6xx_gmu_resume does it for a8xx: CX switch, GPLL0 vote, PLL0 for the
+ *             GMU's 475 MHz, the hub at 150 MHz, the GMU's clocks, an SMMU context for the GMU's stream 5, TrustZone's
+ *             gpu_init_regs, the GMU's firmware, its start, HFI, the perf and bus tables, "start", a speed vote, then the
+ *             GPU's power asked for ("OOB GPU set") and the chip id read (cx_misc SLICE_ENABLE_FINAL: Linux's
+ *             a8xx_gpu_get_slice_info adds the slice count to the DT's 0x44050a01; Fedora reports 0x44050a31, 3 slices)
+ *             with the 3D core's first registers; OOB cleared; held icegpu_hold s (default 10, a line a second); then
+ *             the GMU stopped the short way (Linux's a6xx_gmu_force_off) and everything put back as the survey found it
+ *   icegpu=3  as 2, but the way down is Linux's clean one (a6xx_gmu_shutdown: idle wait, PREPARE_SLUMBER, busy wait, HFI
+ *             stopped, CM3 reset, the RSCC put to sleep, GX checked off and collapsed if stuck), then every clock / PLL /
+ *             RCG / switch / SMMU register put back, then a second survey compared register by register with the first
+ *   icegpu=4  as 3, and before the hold the 3D core (a8xx_gpu.c hw_init): OOB GPU set again, the core's own SMMU
+ *             context (bank 0, streams 0 and 1, ACTLR 0x303, HUPCF), the register init (kaanapali_nonctxt_regs, UBWC
+ *             6.0 / hbb 16, bicubic weights, APRIV), fw/gen80200_sqe.fw into memory and the SQE started, CP_ME_INIT,
+ *             the zap shader fw/gen80200_zap.mbn through TrustZone (PAS 13, gpu_microcode_mem 0x9959a000),
+ *             CP_SET_SECURE_MODE 0, GMEM protection, then a first fence: CP_NOP, CP_MEM_WRITE of a word, CP_EVENT_WRITE7
+ *             (CACHE_CLEAN, user 32-bit to memory) of fence 1. On the way down: GBIF halted, SQE off, the zap given up
+ *             (PAS shutdown 13), OOB cleared, then stage 3's clean way down and bank 0 put back like the GMU's.
+ *             Still no protection table, clock gating, preemption, interrupts, AQE or IB.
+ *   icegpu=5  as 4, plus (data-a-live's Adreno 8xx rules, values from the Pad's Linux): TrustZone's wait-queue answer 2
+ *             resumed (WAITQ_RESUME, as the ADSP kit) under the shared SCM lock; the CP protect table
+ *             (kaanapali_protect_regs, SoC table) in hw_init's order; hardware clock gating (a8xx_set_hwcg) after the zap;
+ *             the completion interrupt (GIC SPI 300 = INTID 332, level; RBBM_INT_0_MASK RB_DONE_TS | CACHE_FLUSH_TS,
+ *             polling kept as the fallback and the log says which saw it); after the first fence one indirect buffer
+ *             (CP_INDIRECT_BUFFER to a CP_MEM_WRITE) and a second fence with CP_EVENT_WRITE7's IRQ bit; then the IB's
+ *             page unmapped with a per-page TLB invalidation (TLBIVA + sync). GX_BW_PERF_VOTE before OOB GPU set was
+ *             already the order (a6xx_gmu_resume, as Linux on this tablet). ArmSmmu4K-style tables: left for stage 6.
+ *   icegpu=6  as 5, then the kernel API (the base of a later IOKit user client / Turnip back end) instead of the plain
+ *             hold: TrustZone opens the CP's SMMU aperture for bank 0; two per-process address spaces (own tables and
+ *             ASID, a 4 GB window at 4 GB, the kernel's 0..2 GB shared); one IB per space writing to the same GPU
+ *             address -> two different pages (the CP switches tables with CP_SMMU_TABLE_UPDATE); 64 submissions
+ *             alternating spaces, each fence waited on the interrupt; one submission a second for icegpu_hold s (the
+ *             GPU kept powered between them); an unmap with per-page TLBIVA for that ASID; the spaces destroyed (ring
+ *             back on the kernel's tables first). Then stage 5's way down. Idle power collapse (IFPC) is stage 7.
+ *             icegpu_serve=S (with 6): after a passed self-test /dev/icegpu serves one userland client for S s (its own space,
+ *             buffers by ioctl, submit, wait; userland-ipad icegpu_test, GPUTEST=1), then the same way down.
+ *             icegpu_redwood=1 (with serve): RedwoodGPU (dada's msm-like IOUserClient) started on the Adreno 840 for the
+ *             serve window: Turnip's darwin KMD (gpu2) and vkfill_test (userland-ipad, VKTEST=1) use it.
+ *             icegpu_persist=1 (with 6): the GPU as a service for the whole run (the base for Metal / CoreAnimation):
+ *             brought up as stage 6 does (stage 5's short core checks kept), then no self-test and no hold (boot-arg
+ *             icegpu_selftest=1 runs the self-test once, without its hold), RedwoodGPU and /dev/icegpu served until the
+ *             run ends; the run's orderly end (redwood_adreno_stop: loader_return_after, "xl stop", five fingers) asks
+ *             for the way down and waits for it (RedwoodGPU stopped, clients torn down, stage 5's clean way down,
+ *             re-survey); a panic's loader_return halts the core's bus (hakios_iceland_gpu_quiesce). icegpu_serve and
+ *             icegpu_redwood are not needed (RedwoodGPU is always started). Levels 1-6 without it are unchanged.
+ *             With icegpu_persist the start delay defaults to 0 (icegpu_delay=MS sets it): the service is up before
+ *             launchd. icegpu_metal=1 (with persist): the kernel names the Metal plug-in on IOAcceleratorES
+ *             (MetalPluginName RedwoodMetal, MetalPluginClassName NativeAdrenoMetalDevice) as RedwoodGPU starts, and
+ *             takes the names away again on the way down (Metal kit 3: the render server through Metal).
+ * Any failure stops at once and takes the way down (force-off + put back). Every register write is logged
+ * ("icegpu: w NAME @PA: old -> new"); the GMU's TCM words (thousands) and memory contents are counted, not listed.
+ * Other boot-args: icegpu_hold=S (default 10), icegpu_speed=I (perf index, default 1 = 160 MHz; 0 is "off"),
+ * icegpu_binmask=M (opp-supported-hw mask, default 0x4: the Pad's stock speed bin 0xfc = Linux's speedbin index 2),
+ * icegpu_xo=1 (no PLL0: the GMU stays on its XO root, the way data-a-live first booted the same GMU).
+ *
+ * Cross-checked against two ports that run the same Adreno 840 (SM8850) under XNU (method only, read only):
+ * data-a-live (ShueiTsuki, APSL-2.0 kernel patches 0162-0170: CX collapsed at boot with waits / RETAIN_FF preset, 24 SMRs
+ * free, GMU in reset; GMU boot, HFI, perf / bw tables, GX vote, OOB GPU set, GX on, RBBM_STATUS read) and songyuan
+ * (UniXNU, BSD-2-Clause-Patent, MyronGpuPower.cpp: the same Linux order including PLL0 / RCGs). Their deltas taken over
+ * (each re-derived from the Pad's Linux): the GMU context bank's ACTLR (arm-smmu-qcom.c: 0x303 for qcom,adreno-gmu),
+ * GMU2HOST mask ~CM3_FAULT before the vote and OOB, the GX-on poll after the OOB ack. No code of theirs is copied.
+ *
+ * Every value is the Pad's own (q90t tree; recorded Fedora state in iceland-mainline docs/tests: area-audio-1 genpd
+ * summary has gpu_cc_cx_gdsc off at idle; area-display-1 msm params chip_id 0xfc44050a31; arm-smmu 3da0000: 24 stream
+ * match groups, 21 context banks, stage 1 48-bit VA -> 36-bit IPA):
+ *   kaanapali.dtsi    gpu@3d00000 (0x6c000) + cx_mem 0x3d9e000 (0x2000); gmu@3d37000 (0x68000), clocks gpucc ahb,
+ *                     cx_gmu, cxo, gcc gpu_gemnoc_gfx, gpucc hub_cx_int; power-domains gpucc CX_GDSC, gxclkctl GX_GDSC;
+ *                     iommus adreno_smmu 5 (the GPU: 0, 1); gmu OPPs 475/575/700/725/750 MHz; gxclkctl@3d64000 (GX on
+ *                     rpmhpd GFX + GMXC + CX GDSC); gpucc@3d90000 (0x9800; parents bi_tcxo_div2, GCC GPLL0, GPLL0_DIV);
+ *                     adreno_smmu iommu@3da0000 (0x40000, clock gpucc GPU_SMMU_VOTE, CX GDSC, dma-coherent);
+ *                     gpu_opp_table (+ kaanapali-oneplus-iceland.dts: 1000/1050 MHz at 16500000 kBps, 1100 MHz TURBO_L2)
+ *   gpucc-kaanapali.c PLL0 Taycan EKO_T (= Taycan ELU layout) 950 MHz: L 0x31 cal_l 0x48 alpha 0x7aaa, config
+ *                     0x25c400e7 / 0x0a8062e0 / 0xf51dea20, user 0x408 / 0x2; gmu_clk_src 0x9318 (475 MHz = PLL0 even,
+ *                     src 2 div 1), hub_clk_src 0x93f0 (150 MHz = GPLL0_DIV src 6 div 2), both hw_clk_ctrl; branches ahb
+ *                     0x90bc, cx_gmu 0x90d4, cxo 0x90e4, hub_cx_int 0x90e8, gpu_smmu_vote 0x7000; CX GDSC 0x9080, hw ctrl
+ *                     status 0x9094, VOTABLE, RETAIN_FF, waits 2/2/8; gxclkctl-kaanapali.c GX GDSC 0x4024 (POLL_CFG_GDSCR)
+ *   gcc-kaanapali.c   gcc@100000: gpu_gpll0_div vote 0x52000 bit 16 (the hub's parent), gpu_gemnoc_gfx 0x71010,
+ *                     gpu_cfg_ahb 0x71004 critical
+ *   a8xx_catalog.c    0x44050a01: gmu_chipid 0x8020100, a840_gbif (QSB_SIDE0-3 0x00071e20, CX_CONFIG 0x20023000),
+ *                     bcms SH0 /16, MC0 /4, ACV fixed perfmode bit 2 from 10687500 kBps; speedbins 252 -> index 2
+ *   a6xx_gmu.c        resume / fw_start / fw_load / start / hfi_start, force_off / shutdown / rpmh_stop (a840: RSCC
+ *                     status bit 30), arc / dep / bw votes, memory layout (icache 0x4000 16M-16K, dummy 0x60000000 16K,
+ *                     debug 0x60400000 28K, log + hfi 16K each); RSCC at the GPU's base + 0x50000; a6xx_hfi.c
+ *                     (a8xx perf table, bw table, core fw start, start, GX_BW_PERF_VOTE, PREPARE_SLUMBER)
+ *   qcom_scm.c        gpu_init_regs: SIP service 0x28 command 1, ALWAYS_EN | TSENSE_EN
+ *   arm-smmu.h        sCR0 / IDR0 / IDR1 / SMR / S2CR / CB layout
+ * Register numbers: hakios_gen8_regs.h (generated from Linux's a6xx.xml / a6xx_gmu.xml; a8xx-generic, not chip data).
+ * The method follows HakiOS's hakios_dada_gpu.c phases 1-4 (no value of dada's is used).
+ * Not done (as Linux does, left out here): the boot bandwidth vote of the GPU's interconnect path (DDR is up for the
+ * CPUs; the GMU votes its own from the bus table), ACD (opp-acd-level + AOSS "gpu acd"), IFPC / BCL / CLX features, the
+ * GMU interrupts (masked; the kit polls), the GBIF halt (no command ever reached the core).
+ * Lines go to the kernel log, prefixed "icegpu:".
+ */
