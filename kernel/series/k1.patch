+	    "ctl %08x in %u\n", when, (uint32_t)spmi_rd(0x10) & 0xff, rd(pad[0], 0), rd(pad[0], 4) & 1, rd(pad[1], 0),
+	    rd(pad[1], 4) & 1, rd(pad[2], 0), rd(pad[2], 4) & 1, rd(pad[3], 0), rd(pad[3], 4) & 1);
+}
