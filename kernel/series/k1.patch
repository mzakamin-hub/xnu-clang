+/* 17r1b's up list (stops at the first step not read back as wanted) */
+static bool
+mic_cdc_up(const struct mic_blk *swr, unsigned dev)
+{
+	const struct mic_cdc_step *up = mic_cdc_up_list;
+	bool ok = true;
+
+	for (size_t i = 0; i < sizeof(mic_cdc_up_list) / sizeof(mic_cdc_up_list[0]) && ok; i++) {
+		if (up[i].mask == 0) {
+			delay_for_interval(up[i].name[1] == '1' && up[i].name[2] == '0' ? 10 : 1, NSEC_PER_MSEC);
+			continue;
+		}
+		if (up[i].reg == 0x3029) {              /* round 6: the bandgap trim (see the list) */
+			uint32_t vbg = 1;
+			int32_t id1 = mic_cmd_read(swr, dev, 0x3402), was = mic_cmd_read(swr, dev, 0x3029);
+			unsigned bad = mic_cdc_bad;
+
+			PE_parse_boot_argn("icemic_vbg", &vbg, sizeof(vbg));
+			if (vbg == 0 || id1 <= 0) {
+				mic("%s: BIAS_VBG_FINE_ADJ 0x3029 found %#x: NOT written (%s)\n", mic_tag, was < 0 ? 0 : (uint32_t)was,
+				    vbg == 0 ? "icemic_vbg=0" : "DIGITAL_CHIP_ID1 0 or not read: version 1.0 or unknown");
+				continue;
+			}
+			if (!mic_cdc_field(swr, dev, up[i].reg, up[i].name, up[i].mask, up[i].field)) {
+				mic_cdc_bad = bad;              /* (not one of the path's own writes: the bring-up goes on) */
+				mic("%s: BIAS_VBG_FINE_ADJ did not read back as written: left, the bring-up goes on\n", mic_tag);
+			}
+			continue;
+		}
+		ok &= mic_cdc_field(swr, dev, up[i].reg, up[i].name, up[i].mask, up[i].field);
+	}
+	return ok;
+}
+
+/* 17r1b's down list (every step, whatever the earlier ones gave) */
+static void
+mic_cdc_down(const struct mic_blk *swr, unsigned dev)
+{
+	const struct mic_cdc_step *down = mic_cdc_down_list;
+
+	for (size_t i = 0; i < sizeof(mic_cdc_down_list) / sizeof(mic_cdc_down_list[0]); i++) {
+		(void)mic_cdc_field(swr, dev, down[i].reg, down[i].name, down[i].mask, down[i].field);
+	}
+}
+
+static bool
+mic_cdc_bringup(const struct mic_blk *swr, unsigned dev)
+{
+	bool ok = true;
+
+	mic_tag = "r1b";
+	mic_cdc_writes = mic_cdc_bad = 0;
+	mic("r1b: the WCD9395 brought up for AMIC1 -> ADC1 (io_init, micbias data, MIC BIAS1 2.7 V on, ADC1 MUX, ADC1, "
+	    "ADC1 REQ), held 500 ms, down again; no SoundWire port, no capture\n");
+	ok = mic_cdc_up(swr, dev);
+	if (ok) {
+		int32_t micb = 0, mux = 0, mode = 0, clk = 0, ana = 0;
+
+		delay_for_interval(500, NSEC_PER_MSEC);
+		micb = mic_cmd_read(swr, dev, 0x3022);
+		mux = mic_cmd_read(swr, dev, 0x3127);
+		mode = mic_cmd_read(swr, dev, 0x3410);
+		clk = mic_cmd_read(swr, dev, 0x3409);
+		ana = mic_cmd_read(swr, dev, 0x3408);
+		mic("r1b: after 500 ms: ANA_MICB1 %#x (enable %u, VOUT %#x), CH12_MUX %#x, TX_ANA_MODE_0_1 %#x, DIG_CLK_CTL %#x, "
+		    "ANA_CLK_CTL %#x\n", micb, ((uint32_t)micb >> 6) & 3, (uint32_t)micb & 0x3f, mux, mode, clk, ana);
+	} else {
+		mic("r1b: a step up did not read back as wanted: going down now\n");
+	}
+	mic_cdc_down(swr, dev);
+	mic("r1b %s: %u codec writes, %u not as wanted; MICBIAS1 off; the codec goes back into reset next\n", ok &&
+	    mic_cdc_bad == 0 ? "PASS" : "FAIL", mic_cdc_writes, mic_cdc_bad);
+	return ok && mic_cdc_bad == 0;
+}
