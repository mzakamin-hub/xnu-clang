+	    "tracked, %u seed changes, %u pushed here; %u of 64 points not 0, %u with alpha, middle %08x\n", what, ms / NSEC_PER_MSEC,
+	    pid, s->sid, s->info.width, s->info.height, (int) (s->info.pixelFormat >> 24 & 0xff),
+	    (int) (s->info.pixelFormat >> 16 & 0xff), (int) (s->info.pixelFormat >> 8 & 0xff), (int) (s->info.pixelFormat & 0xff),
+	    s->makerName[0] ? s->makerName : "kernel", s->makerPid, (int32_t) pid == s->makerPid ? "its own" : "ANOTHER's",
