+/*
+ * icebt_marker=1 (default off): the empty file /etc/bluetool/SkipBluetoothFirmwareBoot, a path the 26C5035r BlueTool and bluetoothd
+ * both name; what they do when it exists is what the boot-arg is there to find out (icebt=4: the stock BlueTool has no boot script
+ * for this board and leaves without opening /dev/cu.BLTH). /etc is a link to private/etc and /private is one of the
+ * firmlinks of native_owner_data_firmlinks (which requires it: /etc, /var and /tmp resolve through it), so the directory is the owner
+ * Data volume's; nothing of the sealed system volume is written. Missing directories below it are made by native_gpu_addon_parents, the
+ * file by native_gpu_addon_write with the kernel's own credentials. Never fatal; one line per step, "icebt: marker: ...". Stage: 1
+ * directory made, 2 file made (0644, root), 3 the marker found through /etc.
+ */
+static void
+native_owner_macos_icebt_marker(proc_t p, user_addr_t scratch)
+{
+	static const char directory[] = "/private/etc/bluetool";
+	static const char path[] = "/private/etc/bluetool/SkipBluetoothFirmwareBoot";
+	static const char visible[] = "/etc/bluetool/SkipBluetoothFirmwareBoot";
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("icebt_marker", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	int stage = 0;
+	vfs_context_t ctx = vfs_context_current();
+	int error = native_gpu_addon_parents(p, scratch, path);
+	printf("icebt: marker: directory %s: %d\n", directory, error);
+	if (error) {
+		printf("icebt: marker: NOT shown: the directories of %s (error %d)\n", directory, error);
+		return;
+	}
+	stage = 1;
+	error = native_gpu_addon_write(path, (const uint8_t *)"", 0, 0644, ctx);
+	printf("icebt: marker: file %s %s: %d\n", path, error < 0 ? "already the same" : "written", error);
+	if (error > 0) {
+		printf("icebt: marker: NOT shown: %s not written (error %d)\n", path, error);
+		return;
+	}
+	stage = 2;
+	vnode_t probe = NULLVP;
+	error = vnode_lookup(visible, 0, &probe, ctx);
+	if (!error) {
+		vnode_put(probe);
+		stage = 3;
+	}
+	if (error) {
+		printf("icebt: marker: NOT shown: %s (error %d)\n", visible, error);
+	} else {
+		printf("icebt: marker: %s shown (stage %d)\n", visible, stage);
+	}
+}
