+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOUserClient);
+
+bool
+AGXDeviceUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	bzero(name_, sizeof(name_));
+	proc_selfname(name_, sizeof(name_));
+	pid_ = proc_selfpid();
+	refused_ = 0;
+	task_ = owningTask;
+	lock_ = IOLockAlloc();
+	space_ = ~0u;
+	fg_ = bg_ = -1;
+	wcscan_ = 0;
+	(void)PE_parse_boot_argn("iceagx_wcscan", &wcscan_, sizeof(wcscan_));   /* render1: see the submission's walk */
