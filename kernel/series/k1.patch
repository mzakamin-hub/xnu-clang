+/* w5-bt: icebt_log=1 lets bluetoothd's own fd 1 / fd 2 lines reach the log with stderr-log off (off by default) */
+static bool
+stderr_log_btd(void)
+{
+	static int btd = -1;
+
+	if (btd < 0) {
+		int v = 0;
+
+		(void)PE_parse_boot_argn("icebt_log", &v, sizeof(v));
+		btd = v == 1;
+	}
