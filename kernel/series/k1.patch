+static TUNABLE(uint32_t, ice_wl_seconds, "icewl", 0);
+#define ICE_WL_PROCS    24
+#define ICE_WL_PATHS    24
+#define ICE_WL_VCACHE   32
+#define ICE_WL_PREFIX   56
+struct ice_wl_state {
+	struct { int pid; uint32_t ops; uint64_t bytes, last; char name[18]; } procs[ICE_WL_PROCS];
+	struct { uint32_t ops; uint64_t bytes, last; char prefix[ICE_WL_PREFIX]; } paths[ICE_WL_PATHS];
+	struct { vnode_t vp; uint32_t vid; int32_t path; } vcache[ICE_WL_VCACHE];
