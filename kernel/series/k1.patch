+/*
+ * A read that is retried (at most 3 tries, the bus cleared between them). ipad17g (31 Oct): the first transaction
+ * after each amp_bus_take of a bus that had been given back before -- always 0x34, the first on each bus -- was not
+ * acknowledged, every later one was; tfa9865.c's regmap never meets that (the GENI controller owns its pins).
+ */
+static int32_t
+amp_read_retry(unsigned addr, uint8_t reg)
+{
+	int32_t v = -1;
+
+	for (int t = 0; t < 3; t++) {
+		v = amp_read(addr, reg);
+		if (v >= 0) {
+			if (t > 0) {
+				say("amp: %#x r %#04x: answered on try %d (after a bus clear)\n", addr, reg, t + 1);
+			}
+			break;
+		}
+		amp_bus_clear();
+	}
+	return v;
+}
+
+/* regmap_update_bits: the read retried; nothing is written from a failed read */
+static int32_t
+amp_update(unsigned addr, uint8_t reg, uint16_t mask, uint16_t bits)
+{
+	int32_t v = amp_read_retry(addr, reg);
+
+	if (v < 0) {
+		say("amp: %#x r %#04x: NO ANSWER after 3 tries (update not done)\n", addr, reg);
+		return -1;
+	}
+	amp_w(addr, reg, (uint16_t)((v & ~mask) | (bits & mask)));
+	return v;
+}
+
+/* STATUS2's manager state polled (regmap_read_poll_timeout: 50 us there; here up to 20 reads, ~10 ms) */
+static int32_t
+amp_poll_state(unsigned addr, bool want_nonzero)
+{
+	int32_t v = -1;
+
+	for (int i = 0; i < 20; i++) {
+		v = amp_read(addr, 0x12);
+		if (v >= 0 && ((v & 0xf) != 0) == want_nonzero) {
+			break;
+		}
+	}
+	return v;
+}
