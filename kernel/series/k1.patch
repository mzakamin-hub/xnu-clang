+static void
+sv_summary(const char *when)
+{
+	char line[700];
+	int at = 0;
+
+	say("(d) %s: opens %u closes %u; commands %u (sent %u, answered here %u), ACL out %u in %u, other out %u; events %u (CC %u, "
+	    "of them not status 0 %u, CS %u), refusals turned into status 0 %u, 0x2001 widened %u, resets answered %u, scan-enable "
+	    "commands %u, advertising reports %u from %u distinct advertisers\n", when, sd.opens, sd.closes, sd.cmd, sd.cmd_sent,
+	    sd.cmd_local, sd.acl_tx, sd.acl_rx, sd.other_tx, sd.ev, sd.cc, sd.cc_bad, sd.cs, sd.rewritten, sd.mask_or, sd.reset_ok,
+	    sd.scan_on, sd.adv, hb_distinct);
+	say("(d) %s: link: stray bytes in %u out %u, oversize %u, dropped for the client %u, HW errors %u, UART errors %u, TX "
+	    "failed %u; Supported Commands patched %u, legacy edits %u, kicks %u\n", when, sd.stray, sd.h_stray, sd.big, sd.dropped,
+	    sd.hwerr, sd.uart_err, sd.tx_fail, sd.sup_patched, sd.legacy, sd.kicked);
+	if (PR_ON) {
+		say("(d) %s: pair: lines %u (+%u over icebt_pair_max); SMP frames in %u out %u, SMP failures %u; Link_Key_Request %u, "
+		    "Link_Key_Notification %u, encryption changes %u\n", when, PR->lines, PR->hidden, PR->smp_in, PR->smp_out,
+		    PR->smpfail, PR->keyreq, PR->keynote, PR->encchg);
+		if (PR->lediag) {
+			say("(d) %s: pair: last LE link handle %#x: ACL out %u in %u, completed for it %u; all links: completed %u of ACL "
+			    "out %u (buffers ACL %u, LE %u); ATT out %u in %u; LE signalling %u\n", when, PR->le_handle ?
+			    PR->le_handle - 1 : 0xfffu, PR->le_out, PR->le_in, PR->le_done, PR->done_all, sd.acl_tx, PR->buf_acl,
+			    PR->buf_le, PR->att_out, PR->att_in, PR->sig);
+		}
+	}
+	if (LS_ON) {
+		say("(d) %s: lesec: wait %u ms, code %#x; errors handed to the host %u, late responses dropped %u\n", when,
+		    LS->wait_ms, LS->err & 0xff, LS->injected, LS->dropped);
+	}
+	if (ops != NULL && (LP->pb || LP->fix || RX->on || RX->iso2acl)) {     /* laneD: only with the kit's words */
+		say("(d) %s: lepb %u: LE ACL from the host by PB: 00 %u, 01 %u, 10 %u, 11 %u; sent as 00 %u; lefix %#x\n", when,
+		    LP->pb, LP->pbn[0], LP->pbn[1], LP->pbn[2], LP->pbn[3], LP->rewritten, LP->fix);
+		rx_summary();                           /* bt3 */
+	}
+	if (ops != NULL) {
+		if (B4->on || B4->nvm_done || B4->fell) {
+			say("(d) %s: ibs %u (nvm %#x): wakes out %u (again %u), acks in %u, max %u ms; chip wakes %u, acks out %u, "
+			    "chip sleeps %u; sleeps out %u; off after no ack %u\n", when, B4->on, B4->nvm_done, B4->wake_out, B4->again,
+			    B4->ack_in, B4->max_ms, B4->wake_in, B4->ack_out, B4->slp_in, B4->slp_out, B4->fell);
+		}
+	}
+	/* every opcode the client sent: count, the last status (ff none), how (1 sent, 2 answered here, 4 refusal softened) */
+	for (uint32_t i = 0; i < ops_n; i++) {
+		at += scnprintf(line + at, sizeof(line) - (size_t)at, " %04x*%u:%x/%u", ops[i].op, ops[i].n, ops[i].st, ops[i].how);
+		if (at > 600 || i + 1 == ops_n) {
+			say("(d) ops%s\n", line);
+			at = 0;
+		}
+	}
+}
