+/* ---- the platform callbacks ---- */
+static uint64_t
+lx_now_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000ull;
+}
+
+static void
+lx_sleep_ms(unsigned int n)
+{
+	IOSleep(n ? n : 1);
+}
