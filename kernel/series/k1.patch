+IcelandCamera::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setName("IcelandCamera");
+	setProperty("IOUserClientClass", "IcelandCameraUserClient");
+	setProperty("IcelandCameraABI", (unsigned long long)kABI, 32);
+	registerService();              /* the client's IOServiceNameMatching("IcelandCamera") must find it */
+	return true;
+}
+
+class IcelandCameraUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IcelandCameraUserClient)
+
+	int pid_;                       /* the opening task's, for the log (the task itself may be gone by the last use) */
+	SInt32 streaming_;              /* 1 from a successful selector 0 until this client has asked for its stop */
+
+	/* the swap makes the stop "once per client" even when close, death and free all arrive; why: 0 its stop call, 1 its close, 2 a termination, 3 its release (said in the log: which of them ended a stream) */
+	void
+	releaseStream(unsigned why)
+	{
+		if (OSCompareAndSwap(1, 0, &streaming_)) {
+			hakios_iceland_camera_note(pid_, ~1ull, why, 0);
+			hakios_iceland_camera_stop();
+		}
+	}
+	static IOReturn
+	sStart(OSObject *target, void *, IOExternalMethodArguments *args)
+	{
+		IcelandCameraUserClient *uc = OSDynamicCast(IcelandCameraUserClient, target);
+
+		if (uc == nullptr) {
+			return kIOReturnBadArgument;
+		}
+		/* a client streams once: a second start of the same client is answered from the first */
+		if (!OSCompareAndSwap(0, 1, &uc->streaming_)) {
+			args->scalarOutput[0] = 0;
+			return kIOReturnSuccess;
+		}
+		const int error = hakios_iceland_camera_start();
+
+		if (error != 0) {
+			(void)OSCompareAndSwap(1, 0, &uc->streaming_);
+		}
+		args->scalarOutput[0] = (uint64_t)(uint32_t)error;
+		return kIOReturnSuccess;        /* the C result is the answer, not an IOReturn */
+	}
+	static IOReturn
+	sStop(OSObject *target, void *, IOExternalMethodArguments *)
+	{
+		IcelandCameraUserClient *uc = OSDynamicCast(IcelandCameraUserClient, target);
+
+		if (uc != nullptr) {
+			uc->releaseStream(0);
+		}
+		return kIOReturnSuccess;
+	}
+	static IOReturn
+	sWait(OSObject *, void *, IOExternalMethodArguments *args)
+	{
+		uint64_t out[8] = {};
+		uint32_t timeout = (uint32_t)args->scalarInput[1];
+
+		if (timeout > kMaxWaitMs) {
+			timeout = kMaxWaitMs;
+		}
+		const int result = hakios_iceland_camera_wait((uint32_t)args->scalarInput[0], timeout, out);
+		for (unsigned i = 0; i < 8; i++) {
+			args->scalarOutput[i] = out[i];
+		}
+		return result == 0 ? kIOReturnSuccess : result == 1 ? kIOReturnTimeout : kIOReturnNotReady;
+	}
+	static IOReturn
+	sInfo(OSObject *, void *, IOExternalMethodArguments *args)
+	{
+		uint64_t out[8] = {};
+		hakios_iceland_camera_info(out);
+		for (unsigned i = 0; i < 8; i++) {
+			args->scalarOutput[i] = out[i];
+		}
+		return kIOReturnSuccess;
+	}
+	static IOReturn
+	sNote(OSObject *target, void *, IOExternalMethodArguments *args)
+	{
+		IcelandCameraUserClient *uc = OSDynamicCast(IcelandCameraUserClient, target);
+
+		/* kinds are small numbers: ~0, the open's own, cannot be asked for from outside */
+		if (uc != nullptr && args->scalarInput[0] < 64) {
+			hakios_iceland_camera_note(uc->pid_, args->scalarInput[0], args->scalarInput[1], args->scalarInput[2]);
+		}
+		return kIOReturnSuccess;
+	}
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) override;
+	bool start(IOService *provider) override;
+	void stop(IOService *provider) override;
+	void free(void) override;
+	IOReturn clientClose(void) override;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) override;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *dispatch,
+	    OSObject *target, void *reference) override;
+};
+
+OSDefineMetaClassAndStructors(IcelandCameraUserClient, IOUserClient)
+
+bool
+IcelandCameraUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	/* before the base init: free() may run on an object whose init then fails */
+	pid_ = owningTask != nullptr ? task_pid(owningTask) : -1;
+	streaming_ = 0;
+	return IOUserClient::initWithTask(owningTask, securityID, type);
+}
+
+bool
+IcelandCameraUserClient::start(IOService *provider)
+{
+	if (OSDynamicCast(IcelandCamera, provider) == nullptr || !IOUserClient::start(provider)) {
+		return false;
+	}
+	hakios_iceland_camera_note(pid_, ~0ull, 0, 0);       /* "client pid N opened" */
+	return true;
+}
+
+void
+IcelandCameraUserClient::stop(IOService *provider)
+{
+	releaseStream(2);               /* a termination without a close gives the stream back here */
+	IOUserClient::stop(provider);
+}
+
+void
+IcelandCameraUserClient::free(void)
+{
+	releaseStream(3);               /* released without a close ever arriving */
+	IOUserClient::free();
+}
+
+IOReturn
+IcelandCameraUserClient::clientClose(void)
+{
+	releaseStream(1);
+	if (getProvider() != nullptr) {
+		terminate();            /* as AGXDeviceUserClient::clientClose; stop() then finds nothing left to stop */
+	}
+	return kIOReturnSuccess;
+}
+
+/* type 0: all frame buffers, mapped read-only (the client never writes a frame) */
+IOReturn
+IcelandCameraUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	if (memory == nullptr || options == nullptr) {
+		return kIOReturnBadArgument;
+	}
+	*memory = nullptr;
+	if (type != kBufType || gBuffers == nullptr) {
+		return kIOReturnBadArgument;
+	}
+	gBuffers->retain();             /* the caller releases the descriptor it is handed */
+	*memory = gBuffers;
+	*options = kIOMapReadOnly;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IcelandCameraUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args, IOExternalMethodDispatch *,
+    OSObject *, void *)
+{
+	/* the scalar counts (and no structures) IOUserClient::externalMethod checks before calling a handler */
+	static const IOExternalMethodDispatch methods[kSelCount] = {
+		{&IcelandCameraUserClient::sStart, 0, 0, 1, 0},
+		{&IcelandCameraUserClient::sStop, 0, 0, 0, 0},
+		{&IcelandCameraUserClient::sWait, 2, 0, 8, 0},
+		{&IcelandCameraUserClient::sInfo, 0, 0, 8, 0},
+		{&IcelandCameraUserClient::sNote, 3, 0, 0, 0},
+	};
+
+	if (selector >= kSelCount) {
+		return kIOReturnUnsupported;
+	}
+	return IOUserClient::externalMethod(selector, args, const_cast<IOExternalMethodDispatch *>(&methods[selector]), this, nullptr);
+}
+
+/*
+ * From the camera's thread (hakios_iceland_camera_svc.h) when boot-arg icecam >= 5: the frame buffers, then the service.
+ * 0 = published and *va is the buffers' kernel address; 1 = no platform expert yet, ask again; < 0 = failed for good.
+ */
+extern "C" int
+iceland_camera_publish(vm_size_t bytes, vm_offset_t *va)
+{
+	IOService *platform = IOService::getPlatform();
+
+	if (platform == nullptr) {
+		return 1;
+	}
+	if (gBuffers == nullptr) {
+		/* one physical range, page aligned, anywhere: the SMMU window names it by its own address */
+		gBuffers = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryKernelUserShared, bytes, ~0ULL);
+		if (gBuffers == nullptr) {
+			return -1;
+		}
+		bzero(gBuffers->getBytesNoCopy(), bytes);
+	}
+	IcelandCamera *service = OSTypeAlloc(IcelandCamera);
+
+	if (service == nullptr || !service->init()) {
+		OSSafeReleaseNULL(service);
+		return -2;
+	}
+	if (!service->attach(platform)) {
+		service->release();
+		return -3;
+	}
+	if (!service->start(platform)) {        /* start() sets the properties and registers it */
+		service->detach(platform);
+		service->release();
+		return -4;
+	}
+	service->release();                     /* the platform's attachment keeps it */
+	*va = (vm_offset_t)gBuffers->getBytesNoCopy();
+	return 0;
+}
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/iokit/Kernel/MiniAppleKeyStore.cpp b/iokit/Kernel/MiniAppleKeyStore.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..67d793668ee762b84f83f8564b54cc0884e53a27
--- /dev/null
+++ b/iokit/Kernel/MiniAppleKeyStore.cpp
@@ -0,0 +1,613 @@
+/*
+ * MiniAppleKeyStore: a stand-in for Apple's AppleKeyStore (the kernel side of the keybag,
+ * which on real hardware talks to the Secure Enclave), as seen by MobileKeyBag.framework
+ * and libaks.
+ *
+ * It describes one fixed situation: a device that has no passcode -- never locked, unlocked
+ * since boot. No keys exist here. The keychain (securityd) gives every item a key of its own and
+ * has it wrapped by the key of the item's protection class (kAKSWrapKey) before it stores it, and
+ * unwrapped (kAKSUnwrapKey) to read the item: that is answered, so that the keychain works -- but
+ * with nothing secret to wrap with, the "wrapping" is a reversible transformation and protects
+ * nothing (and the keychain lives in /private/var, in memory, and is gone at the next start).
+ * Requests that would need real keys or bags otherwise (creating or loading bags, keys kept in the
+ * key store) are refused, logged once.
+ *
+ * The protocol was worked out from the user-space side of iOS 16.5: selectors, and the
+ * DER-encoded answers ("SET of SEQUENCE { UTF8String key, INTEGER value }").
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+#include "MiniDrivers.h"
+
+enum {
+	kAKSOpenCheck           = 0x00,
+	kAKSHandshakeProbe      = 0x04,         /* aks_ext (G3): aks_unload_keybag in the real kext's dispatch (AppleKeyStore::unload_keybag); loginwindow's exact ask is 0x4, answered success with no outputs */
+	kAKSHandshakeSet        = 0x05,         /* aks_ext (G3): as 0x4 */
+	kAKSGetLockState        = 0x07,         /* in: handle; out: state flags */
+	kAKSLockDevice          = 0x08,
+	kAKSUnlockDevice        = 0x09,
+	kAKSWrapKey             = 0x0a,         /* in: handle, class; a key; out: the class, the key wrapped */
+	kAKSUnwrapKey           = 0x0b,         /* in: handle, class; a wrapped key; out: the key */
+	kAKSUnlockBag           = 0x0c,
+	kAKSBagBookkeep         = 0x0d,         /* aks_ext (G3): bag bookkeeping, no outputs */
+	kAKSGetSystem           = 0x0e,         /* out: the handle of the system keybag */
+	kAKSGetDeviceState      = 0x11,         /* in: handle; out: DER */
+	kAKSGetBagUUID          = 0x17,         /* out: 16 bytes */
+	kAKSAssertHold          = 0x1a,
+	kAKSAssertDrop          = 0x1b,
+	kAKSGetConfiguration    = 0x1f,         /* in: handle; out: DER (a big buffer, so out of line) */
+	kAKSLockDeviceNow       = 0x20,
+	kAKSGetExtendedState    = 0x23,         /* as kAKSGetDeviceState */
+	kAKSNotifyBookkeep      = 0x37,         /* aks_ext (G3): notify bookkeeping, no outputs */
+	kAKSGeneration          = 0x28,
+	kAKSVerifyPassword      = 0x2a,         /* aks_ext (w9): the "device verify" the real kext gates on com.apple.keystore.device.verify (AppleKeyStore::verify_password); 5 scalars in, no outputs */
+	kAKSFVGetSize           = 0x4e,         /* aks_ext (w9): fv_get_size, the FileVault group (com.apple.keystore.filevault); 1 scalar in, 1 scalar out */
+	kAKSFVSetProtection      = 0x54,         /* aks_ext (w9): fv_set_protection, the FileVault group; 4 scalars in, a DER blob out */
+	kAKSAssertPromote       = 0x64,
+	kAKSAssertConsume       = 0x65,
+	kAKSNotifyStateSet      = 0x66,         /* "the first-unlock notification has been posted" */
+	kAKSNotifyStateIsSet    = 0x67,
+	kAKSPrewarm             = 0x73,
+	kAKSGetInternalState    = 0x8e,         /* aks_ext (w9): get_internal_state, gated on com.apple.keystore.info in the real kext; 1 scalar in, a DER blob out */
+	kAKSEnableCacheFlow     = 0xa0,         /* aks_enable_cache_flow (G3): succeed, no outputs */
+};
+
+/* state flags: bit 1 no passcode, bit 2 unlocked since boot */
+#define kAKSStateFlags          0x6
+/* lock state: 0 unlocked, 1 locked, 2 locking, 3 disabled (no passcode) */
+#define kAKSLockStateDisabled   3
+
+static uint64_t gAKSLogged[4];          /* selectors already reported */
+static bool     gAKSNotifyState;
+
+/*
+ * aks_ext=1 (w8-gains, G3 of survey/GAINS-DEEP-SCAN-2026-11-19.md): answer the five selectors UniXNU's
+ * AppleKeyStoreState answers for the same environment - 0x4, 0x05, 0x0d, 0x37, 0xa0 - as success with no
+ * outputs ("open handshake, bag/assertion/notify bookkeeping", NativeKeyStoreEvents.cpp:240-243 of
+ * UniXNU/AppleKeyStoreState@6ff4f11). Ours already answered the rest of that set (0, 9, 12, 26, 27, 101,
+ * 102) plus the state queries, but 0x4 is the exact line in our archive - loginwindow[174] selector 0x4
+ * not implemented - and libaks reopens its connection on a failed handshake call. The selectors need no
+ * keys and no bag (their outputs are empty), so the software key-wrap does not change; the full
+ * AppleKeyStoreState key-wrap (the aks=1 lead) stays a follow-on. Without the gate every one of the five
+ * keeps the not-implemented answer and its one log line, exactly as before.
+ *
+ * w9-aks extends the same gate with the four selectors the macOS 27.3 session asks on top (the cam14
+ * archive, runs/w5-camera-14/console-run1.txt): loginwindow's auto-login loop dies with every
+ * WindowServer holding the AKS "unsupported" error - agx: WindowServer text (report): P0 ee00002c7,
+ * 0x2c7 being exactly this file's not-implemented answer mapped through libaks into 0xE00002C7 (the
+ * kAksUnsupported of NativeKeyStoreEvents.cpp:38). The selectors are identified from the real thing our
+ * stand-in impersonates, com.apple.driver.AppleSEPKeyStore of the macOS 27.3 kernelcache
+ * (kernelcache.release.Mac17,6_7_8_9_10_11_12_13_14_15_16 of UniversalMac_27.3_26C5035r,
+ * AppleKeyStoreUserClient::handleUserClientSelector's dispatch, selector-1 indexed, 169 entries):
+ *   0x4  aks_unload_keybag: effective_bag_handle_actual then AppleKeyStore::unload_keybag, no outputs
+ *        (loginwindow; AppleKeyStoreState 6ff4f11 also answers 0x4 as bookkeeping success, no outputs)
+ *   0x2a the device verify: gated on com.apple.keystore.device.verify, two packed secret items then
+ *        AppleKeyStore::verify_password, no outputs (authorizationhost asks 5 scalars in)
+ *   0x4e fv_get_size: handle_filevault's group (gated on com.apple.keystore.filevault) decodes the DER
+ *        fv_params and returns AppleKeyStore::fv_get_size's size in scalarOutput[0] (opendirectoryd asks
+ *        1 scalar in, 1 out; WindowServer's ask is the silent repeat of the already-logged selector)
+ *   0x54 fv_set_protection: 4 scalars in, the DER fv_data blob the operation wrapped, out (opendirectoryd
+ *        sizes its 4096-byte buffer for it)
+ *   0x8e get_internal_state: gated on com.apple.keystore.info, a DER state blob out (ReportCrashService)
+ * The w9 answers follow the stand-in's one fixed situation - no passcode, no keybag, no FileVault: the
+ * verify succeeds with nothing to verify against, the FileVault sizes and blobs are empty (there is no
+ * FV state on this device, so fv_get_size says 0 and fv_set_protection returns a zero-length blob), and
+ * the internal state is the same DER the device-state queries answer.
+ */
+static bool
+aks_ext_gate(void)
+{
+	static bool read;
+	static bool on;
+
+	if (!read) {
+		uint32_t ext = 0;
+
+		read = true;
+		(void)PE_parse_boot_argn("aks_ext", &ext, sizeof(ext));
+		on = ext == 1;
+		if (on) {
+			IOLog("MiniAppleKeyStore: aks_ext=1: selectors 0x4, 0x5, 0xd, 0x37, 0xa0 answered, no outputs "
+			    "(AppleKeyStoreState 6ff4f11); 0x2a, 0x4e, 0x54, 0x8e answered with the no-passcode, "
+			    "no-keybag, no-FileVault responses (w9-aks)\n");
+		}
+	}
+	return on;
+}
+
+/*
+ * The w9 answer lines: name the operation, so the tablet console tells which answer was given and by
+ * whom. Capped like the wrap/unwrap reports (a loop may re-ask many times; the first 48 calls are
+ * logged, the rest pass silently) - one 4-byte static, against the __DATA ceiling.
+ */
+static void
+aks_w9_say(uint32_t selector, const char * what)
+{
+	static unsigned calls;
+
+	if (calls++ < 48) {
+		char procname[32] = "?";
+
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniAppleKeyStore: %s[%d] selector 0x%x answered, %s (aks_ext)\n", procname, proc_selfpid(),
+		    selector, what);
+	}
+}
+
+/* laneD: aks_peruser= on the line, else the lane's umbrella word's '5' (no static: __DATA is at its ceiling) */
+extern "C" int PE_iceland_laned(char id);
+
+static bool
+aks_peruser_on(void)
+{
+	uint32_t v = 0;
+
+	if (!PE_parse_boot_argn("aks_peruser", &v, sizeof(v))) {
+		v = PE_iceland_laned('5') ? 1 : 0;
+	}
+	return v == 1;
+}
+
+/* one line per answered selector, in the shape of the not-implemented report it replaces */
+static void
+aks_ext_say(uint32_t selector)
+{
+	static uint64_t said;
+
+	if (!(said & (1ULL << (selector % 64)))) {
+		char procname[32] = "?";
+
+		said |= 1ULL << (selector % 64);
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniAppleKeyStore: %s[%d] selector 0x%x answered, no outputs (aks_ext)\n", procname, proc_selfpid(),
+		    selector);
+	}
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } for a value below 128; returns the new length. */
+static size_t
+derPut(uint8_t * buf, size_t length, const char * key, uint8_t value)
+{
+	size_t keyLength = strlen(key);
+
+	buf[length++] = 0x30;
+	buf[length++] = (uint8_t) (keyLength + 5);
+	buf[length++] = 0x0c;
+	buf[length++] = (uint8_t) keyLength;
+	memcpy(buf + length, key, keyLength);
+	length += keyLength;
+	buf[length++] = 0x02;
+	buf[length++] = 0x01;
+	buf[length++] = value;
+	return length;
+}
+
+/* The answer to "device state": every field zero, except the two that say "no passcode, unlocked". */
+static size_t
+deviceState(uint8_t * buf)
+{
+	size_t length = 2;
+
+	length = derPut(buf, length, "sb", 0);          /* backoff */
+	length = derPut(buf, length, "sr", 0);
+	length = derPut(buf, length, "ss", kAKSStateFlags);
+	length = derPut(buf, length, "sas", 0);         /* assertion set */
+	length = derPut(buf, length, "sfa", 0);         /* failed attempts */
+	length = derPut(buf, length, "sgs", 0);         /* generation state */
+	length = derPut(buf, length, "sls", kAKSLockStateDisabled);
+	length = derPut(buf, length, "sgpe", 0);        /* grace period enabled */
+	length = derPut(buf, length, "srcd", 0);        /* recovery countdown */
+	buf[0] = 0x31;
+	buf[1] = (uint8_t) (length - 2);
+	return length;
+}
+
+/*
+ * Append SEQUENCE { UTF8String key, INTEGER value } for 0 <= value <= 0x7fffffff, the INTEGER in its shortest
+ * positive DER form (1 to 4 bytes; the top bit of the first byte clear); returns the new length.
+ */
+static size_t
+derPutU31(uint8_t * buf, size_t length, const char * key, uint32_t value)
+{
+	size_t keyLength = strlen(key);
+	size_t n = 1;
+
+	value &= 0x7fffffffU;
+	while (n < 4 && value >= (1U << (8 * n - 1))) {
+		n++;
+	}
+	buf[length++] = 0x30;
+	buf[length++] = (uint8_t) (keyLength + 4 + n);
+	buf[length++] = 0x0c;
+	buf[length++] = (uint8_t) keyLength;
+	memcpy(buf + length, key, keyLength);
+	length += keyLength;
+	buf[length++] = 0x02;
+	buf[length++] = (uint8_t) n;
+	while (n-- > 0) {
+		buf[length++] = (uint8_t) (value >> (8 * n));
+	}
+	return length;
+}
+
+/*
+ * install66 (23 Nov, the idle lock): the keybag's grace period - the time the screen may stay asleep or locked before
+ * the password is asked again - is what loginwindow uses for "require the password after the display sleeps"
+ * (its readAskForPasswordSettings: "current keybag graceperiod setting: %d", _preferredScreenLockDelay; the
+ * askForPassword / askForPasswordDelay preferences only feed a one-time migration into the keybag and are then
+ * erased). This stand-in answered gp = 0, i.e. "immediately": every display sleep locked the session (i64t / i64u /
+ * i65t, ~5 s after the display's power state 0). There is no passcode and no real keybag here, so the answer is now
+ * INT_MAX, the value loginwindow itself sets for accounts that never ask ("password delay to INT_MAX"): the display
+ * still dims and sleeps, the session is not locked. aks_gp=<seconds> on the line answers that value instead
+ * (aks_gp=0 = the old "immediately"). Read on every ask (rare: a few per login), no static (the __DATA ceiling).
+ */
+static uint32_t
+aks_grace_period(void)
+{
+	uint32_t gp = 0x7fffffffU;
+
+	(void)PE_parse_boot_argn("aks_gp", &gp, sizeof(gp));
+	return gp > 0x7fffffffU ? 0x7fffffffU : gp;
+}
+
+static size_t
+configuration(uint8_t * buf, uint32_t gp)
+{
+	size_t length = 2;
+
+	length = derPut(buf, length, "bd", 0);          /* backoff delay */
+	length = derPutU31(buf, length, "gp", gp);      /* grace period (install66: INT_MAX = never, unless aks_gp=) */
+	length = derPut(buf, length, "mua", 10);        /* maximum unlock attempts */
+	buf[0] = 0x31;
+	buf[1] = (uint8_t) (length - 2);
+	return length;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class AppleKeyStore : public IOService
+{
+	OSDeclareDefaultStructors(AppleKeyStore);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	setName("AppleKeyStore");
+	registerService();
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+
+	static IOReturn answer(IOExternalMethodArguments * args, const uint8_t * bytes, size_t length);
+
+public:
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* keybagd asks to be told about keys to back up and bags to save; there never are any. */
+IOReturn
+AppleKeyStoreUserClient::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
+{
+	releaseNotificationPort(port);
+	return kIOReturnSuccess;
+}
+
+/*
+ * kAKSWrapKey and kAKSUnwrapKey. A wrapped key is 8 bytes longer than the key, as with AES key
+ * wrap (RFC 3394), which is what callers size their buffers for: a mark, the class, and the key
+ * mixed with a fixed pattern. Not encryption: there is no secret here to encrypt with.
+ */
+static const uint8_t kWrapMark[4] = { 'H', 'K', 'w', 'r' };
+
+static void
+wrapMix(uint8_t * bytes, size_t length)
+{
+	for (size_t i = 0; i < length; i++) {
+		bytes[i] ^= (uint8_t)(0x5a + 37 * i);
+	}
+}
+
+/* A structure answer; a big buffer on the other side arrives as a memory descriptor. */
+IOReturn
+AppleKeyStoreUserClient::answer(IOExternalMethodArguments * args, const uint8_t * bytes, size_t length)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		IOMemoryDescriptor * out = args->structureOutputDescriptor;
+		IOReturn ret;
+
+		if (out->getLength() < length) {
+			return kIOReturnNoSpace;
+		}
+		ret = out->prepare();
+		if (ret == kIOReturnSuccess) {
+			out->writeBytes(0, bytes, length);
+			out->complete();
+			args->structureOutputDescriptorSize = (uint32_t) length;
+		}
+		return ret;
+	}
+	if (args->structureOutput == NULL || args->structureOutputSize < length) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, bytes, length);
+	args->structureOutputSize = (uint32_t) length;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	static const uint8_t bagUUID[16] = { 0x72, 0x65, 0x64, 0x77, 0x6f, 0x6f, 0x64, 0x00, 0x6b, 0x65, 0x79, 0x62, 0x61, 0x67, 0x00, 0x01 };
+	uint8_t der[128];
+	uint64_t * out = args->scalarOutput;
+
+	switch (selector) {
+	case kAKSHandshakeProbe:
+	case kAKSHandshakeSet:
+	case kAKSBagBookkeep:
+	case kAKSNotifyBookkeep:
+	case kAKSEnableCacheFlow:
+		/* aks_ext=1 (G3): the five AppleKeyStoreState selectors, succeed with no outputs; off: as before */
+		if (aks_ext_gate()) {
+			aks_ext_say(selector);
+			return kIOReturnSuccess;
+		}
+		break;
+
+	case kAKSOpenCheck:
+	case kAKSLockDevice:
+	case kAKSLockDeviceNow:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSAssertPromote:
+	case kAKSAssertConsume:
+	case kAKSPrewarm:
+		return kIOReturnSuccess;
+
+	case kAKSGetLockState:
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = kAKSStateFlags;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kAKSGetSystem:
+	case kAKSGeneration:
+		if (args->scalarOutputCount >= 1) {
+			out[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		return kIOReturnSuccess;
+
+	case kAKSGetDeviceState:
+	case kAKSGetExtendedState:
+		/*
+		 * laneD: aks_peruser=1 (or iceld=<ids> holding '5'), OFF by default - UniXNU AppleKeyStoreState PR #2
+		 * (a6f1434d): macOS's MobileKeyBag asks the device state of the per-user session keybag with -uid (-501);
+		 * there is no per-user keybag here, so that handle (< -3; 0 is the system's, -3 the device's) gets
+		 * kIOReturnNotFound (MobileKeyBag -8, LACKeyBagState NotFound) and LocalAuthentication checks the password
+		 * through OpenDirectory instead (coreauthd / coreautha: the GUI password prompts, with the ACM collection).
+		 */
+		if (args->scalarInputCount == 1 && args->scalarInput != NULL && (int32_t)args->scalarInput[0] < -3 &&
+		    aks_peruser_on()) {
+			aks_w9_say(selector, "a per-user handle: kIOReturnNotFound (aks_peruser)");
+			return kIOReturnNotFound;
+		}
+		return answer(args, der, deviceState(der));
+
+	case kAKSGetInternalState:
+		/*
+		 * aks_ext (w9): ReportCrashService's ask while it writes a crash report - the real kext
+		 * returns AppleKeyStore::get_internal_state's DER blob (gated on com.apple.keystore.info).
+		 * The stand-in's internal state is the same DER the device-state queries answer.
+		 */
+		if (aks_ext_gate()) {
+			aks_w9_say(selector, "get_internal_state, the state DER");
+			return answer(args, der, deviceState(der));
+		}
+		break;
+
+	case kAKSVerifyPassword:
+		/*
+		 * aks_ext (w9): authorizationhost's ask (5 scalars in, no outputs) - the real kext's
+		 * "device verify": two packed secret items to AppleKeyStore::verify_password, gated on
+		 * com.apple.keystore.device.verify. This device has no passcode, so there is nothing to
+		 * verify against: the answer is the real success shape, no outputs.
+		 */
+		if (aks_ext_gate()) {
+			aks_w9_say(selector, "verify_password ok (no passcode)");
+			args->scalarOutputCount = 0;
+			return kIOReturnSuccess;
+		}
+		break;
+
+	case kAKSFVGetSize:
+		/*
+		 * aks_ext (w9): the FileVault size query (1 scalar in: the blob type; 1 scalar out).
+		 * The real kext answers AppleKeyStore::fv_get_size's size of the blob it would return.
+		 * There is no FileVault state on this device, so every type sizes 0 - the answer that
+		 * matches fv_set_protection's empty blob below.
+		 */
+		if (aks_ext_gate()) {
+			if (args->scalarOutputCount < 1 || out == NULL) {
+				return kIOReturnBadArgument;
+			}
+			aks_w9_say(selector, "fv_get_size 0 (no FileVault state)");
+			out[0] = 0;
+			args->scalarOutputCount = 1;
+			return kIOReturnSuccess;
+		}
+		break;
+
+	case kAKSFVSetProtection:
+		/*
+		 * aks_ext (w9): the FileVault protect-and-wrap operation (4 scalars in, a DER fv_data
+		 * blob out, sized by the caller through fv_get_size). The real kext returns the blob the
+		 * SEP wrapped; this device has none to wrap, so the answer is a zero-length output (the
+		 * caller's 4096-byte buffer stays empty), which is what the size 0 above announced.
+		 */
+		if (aks_ext_gate()) {
+			aks_w9_say(selector, "fv_set_protection, no blob (no FileVault state)");
+			if (args->structureOutputDescriptor != NULL) {
+				args->structureOutputDescriptorSize = 0;
+			} else {
+				args->structureOutputSize = 0;
+			}
+			return kIOReturnSuccess;
+		}
+		break;
+
+	case kAKSGetConfiguration: {
+		uint32_t gp = aks_grace_period();
+
+		/* install66: one line per boot naming the first asker and the grace period given (the bit of 0x1f in the
+		 * not-implemented bitmap, never set otherwise: this selector is implemented) */
+		if (!(gAKSLogged[kAKSGetConfiguration / 64] & (1ULL << (kAKSGetConfiguration % 64)))) {
+			char procname[32] = "?";
+
+			gAKSLogged[kAKSGetConfiguration / 64] |= 1ULL << (kAKSGetConfiguration % 64);
+			proc_selfname(procname, sizeof(procname));
+			IOLog("MiniAppleKeyStore: %s[%d] configuration answered: grace period %u%s\n", procname, proc_selfpid(),
+			    gp, gp == 0x7fffffffU ? " (never: no screen lock after display sleep; aks_gp= to change)" : " (aks_gp)");
+		}
+		return answer(args, der, configuration(der, gp));
+	}
+
+	case kAKSGetBagUUID:
+		return answer(args, bagUUID, sizeof(bagUUID));
+
+	case kAKSNotifyStateSet:
+		gAKSNotifyState = true;
+		return kIOReturnSuccess;
+
+	case kAKSWrapKey: {
+		static unsigned wraps;
+
+		if (wraps++ < 20) {     /* 46cn4h (design 7): the keychain's wrap calls arrive (no "selector not implemented") */
+			char procname[64] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			IOLog("MiniAppleKeyStore: %s[%d] wrap key (class %llu, %u B)\n", procname, proc_selfpid(),
+			    args->scalarInputCount >= 2 ? (unsigned long long)args->scalarInput[1] : 0ull, args->structureInputSize);
+		}
+		uint8_t wrapped[8 + 64];
+		size_t length = args->structureInputSize;
+
+		if (args->structureInput == NULL || length == 0 || length > 64 || args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(wrapped, kWrapMark, sizeof(kWrapMark));
+		wrapped[4] = (uint8_t)args->scalarInput[1];
+		wrapped[5] = wrapped[6] = wrapped[7] = 0;
+		memcpy(wrapped + 8, args->structureInput, length);
+		wrapMix(wrapped + 8, length);
+		if (args->scalarOutputCount >= 1) {
+			out[0] = args->scalarInput[1];
+			args->scalarOutputCount = 1;
+		}
+		return answer(args, wrapped, 8 + length);
+	}
+
+	case kAKSUnwrapKey: {
+		static unsigned unwraps;
+
+		if (unwraps++ < 20) {   /* 46cn4h (design 7) */
+			char procname[64] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			IOLog("MiniAppleKeyStore: %s[%d] unwrap key (%u B)\n", procname, proc_selfpid(), args->structureInputSize);
+		}
+		uint8_t key[64];
+		const uint8_t * wrapped = (const uint8_t *)args->structureInput;
+		size_t length = args->structureInputSize;
+
+		if (wrapped == NULL || length <= 8 || length > 8 + sizeof(key) || memcmp(wrapped, kWrapMark, sizeof(kWrapMark)) != 0) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(key, wrapped + 8, length - 8);
+		wrapMix(key, length - 8);
+		return answer(args, key, length - 8);
+	}
+
+	case kAKSNotifyStateIsSet:
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = gAKSNotifyState;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	default:
+		break;
+	}
+
+	if (selector < 256 && !(gAKSLogged[selector / 64] & (1ULL << (selector % 64)))) {
+		char procname[32] = "?";
+
+		gAKSLogged[selector / 64] |= 1ULL << (selector % 64);
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniAppleKeyStore: %s[%d] selector 0x%x not implemented (scalars %u in, %u out; structure %u in, %u out)\n",
+		    procname, proc_selfpid(), selector, args->scalarInputCount, args->scalarOutputCount, args->structureInputSize,
+		    args->structureOutputSize);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniAppleKeyStoreStart(void)
+{
+	/* user space looks for it by class, and by the path IOService:/IOResources/AppleKeyStore */
+	IOService * resources = IOService::getResourceService();
+	AppleKeyStore * store = OSTypeAlloc(AppleKeyStore);
+
+	if (resources == NULL || store == NULL || !store->init() || !store->attach(resources)) {
+		OSSafeReleaseNULL(store);
+		IOLog("MiniAppleKeyStore: cannot create the service\n");
+		return;
+	}
+	if (!store->start(resources)) {
+		store->detach(resources);
+	}
+	store->release();
+}
diff --git a/iokit/Kernel/MiniDrivers.h b/iokit/Kernel/MiniDrivers.h
new file mode 100644
index 0000000000000000000000000000000000000000..05bf05c9d282e468d08d4bdd4d69f3f364638a60
--- /dev/null
+++ b/iokit/Kernel/MiniDrivers.h
@@ -0,0 +1,24 @@
+/*
+ * Stand-ins for Apple's closed kernel extensions: just enough of each for the stock iOS
+ * user space to work on a machine without Apple hardware. The platform expert
+ * (GenericARMPE) starts them once the registry is up.
+ *
+ *   MiniIOSurface.cpp              IOSurface: pixel buffers shared between processes
+ *   MiniIOMobileFramebuffer.cpp    IOMobileFramebuffer: the display (the boot framebuffer)
+ *   MiniAppleKeyStore.cpp          AppleKeyStore: the keybag of a device without a passcode
+ *   MiniIONetworkStack.cpp         IONetworkStack: what configd's interface namer waits for
+ *   HakiosIcelandAMFI.cpp          AppleMobileFileIntegrity: the trust-cache query answered (iceamfi=1)
+ */
+#ifndef _IOKIT_MINIDRIVERS_H
+#define _IOKIT_MINIDRIVERS_H
+
+#include <IOKit/IOService.h>
+
+void MiniIOSurfaceStart(IOService * provider);
+void MiniIOMobileFramebufferStart(IOService * provider);
+void MiniAppleKeyStoreStart(void);
+void MiniIONetworkStackStart(void);
+void HakiosIcelandAMFIStart(void);          /* HakiosIcelandAMFI.cpp, boot-arg iceamfi=1 (kit 29hot1) */
+void HakiosIcelandBacklightUIStart(IOService * provider);    /* HakiosIcelandBacklightUI.cpp, boot-arg icebl_ui=1 */
+
+#endif /* _IOKIT_MINIDRIVERS_H */
diff --git a/iokit/Kernel/MiniDriversMacOS.cpp b/iokit/Kernel/MiniDriversMacOS.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a4ab666bcae0e72e48982cd7146942e1c2e7e322
--- /dev/null
+++ b/iokit/Kernel/MiniDriversMacOS.cpp
@@ -0,0 +1,31 @@
+/*
+ * MiniDriversMacOS: the two symbols of the iOS display stand-ins that code shared by both targets still
+ * names, for the macOS kernel only.
+ *
+ * MiniIOSurface.cpp and MiniIOMobileFramebuffer.cpp are built for the iOS target alone (the prelinked
+ * collection's Apple kexts own those classes on macOS), but the hardware code around them is the same in
+ * both kernels: the CPU and GPU governors read hakios_ui_swap_at -- the time of the last SwapEnd, their
+ * "the window server is drawing" hint -- and osfmk/arm64/hakios_prof.c calls hakios_fb_timing() once a
+ * second for the "icefbt: " line. With no iPadOS display there is never a swap, so the time stays 0, which
+ * is what those readers already treat as "nothing is being drawn"; the timing line has nothing to report
+ * and its own counters live in the file that is not built.
+ *
+ * The declarations the callers and the profiler use (extern volatile uint64_t hakios_ui_swap_at;
+ * extern "C" void hakios_fb_timing(uint64_t now);) are unchanged, so those files build as they are.
+ */
+#if defined(XNU_TARGET_OS_OSX)
+
+#include <mach/mach_types.h>
+
+extern "C" {
+/* (bsd/dev/hakios_iceland_cpu.c, bsd/dev/hakios_iceland_gpu.c: 0 = no frame has been swapped) */
+volatile uint64_t hakios_ui_swap_at;
+}
+
+extern "C" void
+hakios_fb_timing(uint64_t now)
+{
+	(void) now;
+}
+
+#endif /* XNU_TARGET_OS_OSX */
diff --git a/iokit/Kernel/MiniIOMobileFramebuffer.cpp b/iokit/Kernel/MiniIOMobileFramebuffer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..36b15fdccc02aa4551ca304fa99103de42cdad44
--- /dev/null
+++ b/iokit/Kernel/MiniIOMobileFramebuffer.cpp
@@ -0,0 +1,5210 @@
+/*
+ * MiniIOMobileFramebuffer: a stand-in for Apple's display driver family, as seen by
+ * IOMobileFramebuffer.framework (and through it by CoreAnimation's window server).
+ *
+ * The display is the framebuffer the boot loader left us (the one the kernel's text console
+ * draws on). There is no hardware behind it that we drive: a "swap" copies the pixels of the
+ * surfaces of its layers into that memory, and "vsync" is a timer.
+ *
+ * The protocol (selectors and the layout of the swap request) was worked out from the
+ * user-space side of iOS 16.5. Everything not implemented is logged once.
+ */
+
+/*
+ * The iOS window server's view of this class is the stand-in's; the macOS kernel takes the same class
+ * from Apple's kext in the prelinked collection (com.apple.iokit.IOSurface,
+ * com.apple.iokit.IOMobileGraphicsFamily, com.apple.driver.AppleMobileFileIntegrity,
+ * com.apple.iokit.IONetworkingFamily, com.apple.driver.AppleARMPlatform), and a second registration of
+ * the class name would make that kext fail to load. So the body is built for the iOS target only; the
+ * file stays in the build (nothing but these two lines), because the hardware code that calls into it is
+ * the same in both and is gated where it calls (see RedwoodGPU.cpp, redwood_adreno.c,
+ * osfmk/arm64/loader_return.c).
+ */
+#if !defined(XNU_TARGET_OS_OSX)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSymbol.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <kern/thread_call.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+extern "C" {
+#include <console/video_console.h>
+extern struct vc_info vinfo;            /* the boot framebuffer, as the text console knows it */
+}
+
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+#include "MiniIOSurface.h"
+
+extern "C" void redwood_tl(const char * format, ...) __printflike(1, 2);
+/* dada: the display controller showing the frames from buffers of its own (bsd/dev/hakios_dada_dpu.c, dadascan=1) */
+extern "C" {
+int hakios_dada_scanout_init(uint64_t fb, uint32_t panel_w, uint32_t panel_h, uint32_t row_bytes, uint32_t frame_bytes);
+uint8_t * hakios_dada_scanout_buffer(uint32_t bytes);
+bool hakios_dada_scanout_show(uint32_t stride, uint32_t w, uint32_t h);
+void hakios_dada_scanout_panel(void);
+void hakios_dada_scanout_end(uint8_t * fb, uint32_t row_bytes);
+int hakios_iceland_backlight_power(int on);     /* the Pad's backlight (bsd/dev/hakios_iceland_backlight.c, icebl>=2) */
+int hakios_iceland_dsi_panel(int on);           /* 25hot1: the panel off / on by DCS (bsd/dev/hakios_iceland_dsi.c) */
+uint64_t kvtophys(vm_offset_t va);
+}
+static TUNABLE(uint32_t, gPanelPower, "fb_panelpower", 0);     /* 25hot1 */
+/* hakios: once user space owns the console the kernel's IOLog reaches no log we can read: say it in the loader's */
+#define IOLog(...) redwood_tl(__VA_ARGS__)
+
+/*
+ * iceland, boot-arg icescan=N: the display controller scans out the GPU's frames itself (kits 25a-25c), after
+ * ShueiTsuki/data-a-live wsl/pandora_dpu.c (same SoC SM8850, DPU 13.0; patches 0215/0217/0218; credited, written here) and
+ * mainline Linux dpu1 (catalog dpu_13_0_kaanapali.h, dpu_hw_sspp_v13.c, dpu_hw_ctl.c). What ABL left (run 18i, icedpu=1):
+ * CTL0 -> INTF1+INTF2 (dual DSI, video mode, 120 Hz), fetch/pipes VIG0..VIG3 (0x000f0000), each REC0 848x2400 from
+ * x 0/848/1696/2544 of one address, the boot framebuffer 0xfc800000, stride 0x3500 (13568); the display stream SID
+ * 0x800 (mask 2) -> SMR 5 -> S2CR translate -> apps-SMMU bank 4 (CBAR 0x1f000: stage 1, stage 2 bypass; CBA2R VA64;
+ * SCTLR 0xe0: translation OFF, so the pipes read physical addresses).
+ *   icescan=1 (25a): bank 4 gets 4K stage-1 tables (T0SZ 32) that map the boot framebuffer at its own address and its
+ *     translation is turned on; 200 ms later: no fault, the frame counter running, the pipes still reading 0xfc800000.
+ *     Writes (bank 4's page only; never CBAR / CBA2R / SMR / S2CR): TCR2, TTBR0 (lo, hi with ASID 9), TCR, MAIR0,
+ *     MAIR1, TLBIASID + TLBSYNC, FSR (clear), SCTLR (found | M | ASIDPNE). Any fault: back to the found values.
+ *   icescan=2 (25b, needs 25a's PASS in the same run): at the first full-screen swap after 30 s the swapped surface's
+ *     pages are mapped at IOVA 0x80000000 and the four pipes' SRC0_ADDR (REC0 + 0x4c) point there, CTL0 FLUSH (+0x18)
+ *     = VIG0 | VIG1 | VIG2 | VIG3 (bits 0, 1, 2, 18) | CTL (bit 17); checked: the flush taken and every pipe's current
+ *     address the IOVA, no fault; 2 s later the pipes back on 0xfc800000 (flush, checked), the surface unmapped.
+ *   icescan=3 (25c, needs 25b's PASS in the same run): every full-screen swap is shown so -- up to 4 surfaces mapped
+ *     (32 MB slots from 0x80000000), SRC0_ADDR x4 + flush per frame, the flush waited for (the surface before is no
+ *     longer read when the swap returns) -- and the processor's copy into the panel memory is skipped; any fault or a
+ *     flush not taken in 50 ms: the panel memory again and the copy for the rest of the run.
+ * At the run's end (MiniIOMobileFramebufferEnd): the pipes on the panel memory, translation off, bank 4's registers as
+ * found. Lines "icescan: ".
+ */
+#include <vm/vm_kern_xnu.h>
+#ifndef VM_WIMG_IO
+#define VM_WIMG_IO              0x7     /* osfmk/arm/memory_types.h: coherent | not cacheable | guarded */
+#endif
+extern "C" vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+static TUNABLE(uint32_t, gIceScan, "icescan", 0);
+
+#define SCN_MDSS_PA     0x09800000u
+#define SCN_MDSS_LEN    0x001c8800u
+#define SCN_MDP         0x1000u
+#define SCN_CTL0        (SCN_MDP + 0x1f000u)
+#define SCN_CTL_FLUSH   0x18u
+#define SCN_CTL_FETCH   0xfcu
+#define SCN_INTF1_FRAME (SCN_MDP + 0x18d000u + 0x1000u + 0xacu)
+#define SCN_REC0        0x1000u
+#define SCN_SRC0_ADDR   0x4cu
+#define SCN_SRC_YSTRIDE 0x5cu
+#define SCN_CURRENT0    0x64u
+#define SCN_FLUSH_BITS  ((1u << 0) | (1u << 1) | (1u << 2) | (1u << 18) | (1u << 17))
+#define SCN_SMMU_PA     0x15000000u
+#define SCN_SMMU_LEN    0x100000u
+#define SCN_SID         0x800u
+#define SCN_ASID        9u
+#define SCN_FSR_FAULT   (0x1feu | (1u << 30) | (1u << 31))
+#define SCN_TABLES      128u
+#define SCN_SLOT_BASE   0x80000000ull
+#define SCN_SLOT_BYTES  0x2000000ull
+#define SCN_SLOTS       4u
+
+static const uint32_t scn_pipe[4] = { SCN_MDP + 0x2b000u + SCN_REC0, SCN_MDP + 0x34000u + SCN_REC0,
+	                              SCN_MDP + 0x3d000u + SCN_REC0, SCN_MDP + 0x46000u + SCN_REC0 };
+static struct {
+	vm_offset_t dpu, smmu, cb;
+	uint32_t bank, panel;           /* bank 4 (as found); the boot framebuffer's address the pipes read */
+	uint32_t found[8];              /* SCTLR, TCR2, TTBR0 lo, TTBR0 hi, TCR, MAIR0, MAIR1, FSR */
+	vm_offset_t pool;               /* SCN_TABLES 4K tables */
+	uint32_t used;
+	uint64_t *l1, *l2[4];
+	uint64_t *l3[4][512];
+	bool a_ok, b_done, b_ok, b_shown, c_failed;
+	uint64_t b_at;
+	MiniIOSurface *slot[SCN_SLOTS];
+	uint32_t slot_pages[SCN_SLOTS], current;        /* (current: the slot the pipes read + 1, 0: the panel) */
+	uint32_t shows, faults, said;
+	uint64_t start;
+	/*
+	 * 20f/20g: CoreAnimation draws a frame ahead into the surface the pipes still read -- the owner's "lot of glitches" of
+	 * 20e4, two surfaces in turn. Counted (20g): swaps of the surface that was on the display when the SwapEnd before
+	 * returned, i.e. drawn while the display read it. (20f counted changes of the surface's `drawn`, but Turnip names every
+	 * buffer in every submission: 3531 of 3532, meaningless.) Two cures: icesync=1 (20f): SwapEnd returns only once its
+	 * frame is on the display -- it held the frame rate to ~25 a second (35-50 ms a frame); iceinuse=1 (20g): the display's
+	 * use in the surfaces' use count (MiniIOSurfaceDisplayUse) from SwapEnd until replaced, so CoreAnimation takes another.
+	 */
+	uint32_t cur_sid, torn, synced, sync_late, inuse_marks;
+	uint64_t sync_abs;
+} scn;
+static TUNABLE(uint32_t, gIceSync, "icesync", 0);
+static TUNABLE(uint32_t, gIceInUse, "iceinuse", 0);
+
+/*
+ * 20l, icegate=N (ms): the GPU, not the render server's thread, waits for the flip. 20k: CoreAnimation asks for no
+ * notification of ours (no Notifications call at all; SwapWait is not called either), so it has no completion to throttle
+ * on, and holding SwapEnd (icesync) also held its CPU work: ~25 frames a second. Instead: once the swap being shown has its
+ * GPU work in (show()'s wait for a newer submission is over), the render server's next submissions -- its next frame, into
+ * the surface the display still reads -- wait in RedwoodGPU's submit until the flip is taken (at most N ms), and run then.
+ * Its CPU side goes on. Lines in the icescan report: "icegate".
+ */
+static TUNABLE(uint32_t, gIceGate, "icegate", 0);
+/* 20q: when the last SwapEnd came (the CPU governor's ui floor, bsd/dev/hakios_iceland_cpu.c) */
+extern "C" {
+volatile uint64_t hakios_ui_swap_at;
+}
+static IOLock *gGateLock;
+static volatile bool gGateArmed;
+static volatile int gGatePid = -1;
+static uint32_t gGateHeld, gGateLate, gGateArms;
+static uint64_t gGateAbs;
+
+void
+MiniIOMobileFramebufferGate(void)
+{
+	uint64_t began, deadline;
+	bool held = false;
+
+	if (gIceGate == 0 || gGateLock == NULL || !gGateArmed || proc_selfpid() != gGatePid) {
+		return;
+	}
+	began = mach_absolute_time();
+	clock_interval_to_deadline(gIceGate, kMillisecondScale, &deadline);
+	IOLockLock(gGateLock);
+	while (gGateArmed) {
+		held = true;
+		if (IOLockSleepDeadline(gGateLock, (void *)&gGateArmed, deadline, THREAD_UNINT) == THREAD_TIMED_OUT && gGateArmed) {
+			gGateLate++;
+			break;
+		}
+	}
+	if (held) {
+		gGateHeld++;
+		gGateAbs += mach_absolute_time() - began;
+	}
+	IOLockUnlock(gGateLock);
+}
+
+static void
+gate_set(bool armed)
+{
+	if (gGateLock == NULL) {
+		return;
+	}
+	IOLockLock(gGateLock);
+	gGateArmed = armed;
+	gGateArms += armed;
+	if (!armed) {
+		IOLockWakeup(gGateLock, (void *)&gGateArmed, false);
+	}
+	IOLockUnlock(gGateLock);
+}
+
+static inline uint32_t scn_rd(vm_offset_t base, uint32_t off) { return *(volatile uint32_t *)(base + off); }
+
+static void
+scn_wr(vm_offset_t base, uint32_t off, uint32_t v, const char *name, bool say)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (say) {
+		IOLog("icescan: w %s = %#x\n", name, v);
+	}
+}
+
+static void
+scn_clean(vm_offset_t va, vm_size_t size)
+{
+	for (vm_offset_t l = va & ~63ul; l < va + size; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint64_t *
+scn_table(uint64_t *pa)
+{
+	if (scn.used >= SCN_TABLES) {
+		return NULL;
+	}
+	vm_offset_t va = scn.pool + 0x1000ul * scn.used++;
+	*pa = kvtophys(va);
+	return (uint64_t *)va;
+}
+
+static void
+scn_tlb(void)
+{
+	scn_wr(scn.cb, 0x610, SCN_ASID, "CB_TLBIASID", false);
+	scn_wr(scn.cb, 0x7f0, 0, "CB_TLBSYNC", false);
+	for (int i = 0; i < 1000 && (scn_rd(scn.cb, 0x7f4) & 1); i++) {
+		IODelay(10);
+	}
+}
+
+/* NPAGES 4K pages at IOVA: page i is PA (contiguous) or the kernel VA's page (KVA != 0); read-only, normal NC */
+static bool
+scn_map(uint64_t iova, uint64_t pa, vm_offset_t kva, uint32_t npages)
+{
+	for (uint32_t i = 0; i < npages; i++) {
+		uint64_t va = iova + 0x1000ull * i, page = kva ? kvtophys(kva + 0x1000ul * i) : pa + 0x1000ull * i, tpa;
+		unsigned i1 = (unsigned)(va >> 30) & 3, i2 = (unsigned)(va >> 21) & 511, i3 = (unsigned)(va >> 12) & 511;
+
+		if (scn.l2[i1] == NULL) {
+			if ((scn.l2[i1] = scn_table(&tpa)) == NULL) {
+				return false;
+			}
+			scn.l1[i1] = tpa | 3;
+		}
+		if (scn.l3[i1][i2] == NULL) {
+			if ((scn.l3[i1][i2] = scn_table(&tpa)) == NULL) {
+				return false;
+			}
+			scn.l2[i1][i2] = tpa | 3;
+		}
+		/* page | AF | inner shareable | read-only | AttrIndx 0 (NC) | nG | XN */
+		scn.l3[i1][i2][i3] = (page & 0xfffffffff000ull) | 3 | 1ull << 10 | 3ull << 8 | 1ull << 7 | 1ull << 6 | 1ull << 11 |
+		    3ull << 53;
+	}
+	scn_clean(scn.pool, SCN_TABLES * 0x1000ul);
+	return true;
+}
+
+static void
+scn_unmap(uint64_t iova, uint32_t npages)
+{
+	for (uint32_t i = 0; i < npages; i++) {
+		uint64_t va = iova + 0x1000ull * i;
+		uint64_t *l3 = scn.l3[(va >> 30) & 3][(va >> 21) & 511];
+
+		if (l3 != NULL) {
+			l3[(va >> 12) & 511] = 0;
+		}
+	}
+	scn_clean(scn.pool, SCN_TABLES * 0x1000ul);
+	scn_tlb();
+}
+
+/* all four pipes to ADDR, CTL0 flushed, and until taken (flush bits clear, every pipe's current address ADDR) */
+static bool
+scn_point(uint32_t addr, bool say, uint32_t limit_us)
+{
+	for (uint32_t w = 0; (scn_rd(scn.dpu, SCN_CTL0 + SCN_CTL_FLUSH) & SCN_FLUSH_BITS) != 0; w += 100) {
+		if (w > limit_us) {
+			return false;
+		}
+		IODelay(100);
+	}
+	for (unsigned p = 0; p < 4; p++) {
+		scn_wr(scn.dpu, scn_pipe[p] + SCN_SRC0_ADDR, addr, "VIGn REC0 SRC0_ADDR", say);
+	}
+	scn_wr(scn.dpu, SCN_CTL0 + SCN_CTL_FLUSH, SCN_FLUSH_BITS, "CTL0 FLUSH", say);
+	for (uint32_t w = 0;; w += 100) {
+		bool taken = (scn_rd(scn.dpu, SCN_CTL0 + SCN_CTL_FLUSH) & SCN_FLUSH_BITS) == 0;
+
+		for (unsigned p = 0; taken && p < 4; p++) {
+			taken = scn_rd(scn.dpu, scn_pipe[p] + SCN_CURRENT0) == addr;
+		}
+		if (taken) {
+			return true;
+		}
+		if (w > limit_us) {
+			return false;
+		}
+		IODelay(100);
+	}
+}
+
+static bool
+scn_fault(const char *when)
+{
+	uint32_t fsr = scn_rd(scn.cb, 0x58);
+
+	if (!(fsr & SCN_FSR_FAULT)) {
+		return false;
+	}
+	scn.faults++;
+	IOLog("icescan: FAULT %s: bank %u fsr %08x far %08x%08x fsynr0 %08x\n", when, scn.bank, fsr, scn_rd(scn.cb, 0x64),
+	    scn_rd(scn.cb, 0x60), scn_rd(scn.cb, 0x68));
+	if (fsr & (1u << 30)) {         /* SS: the bank stalls on a fault (SCTLR.CFCFG as ABL left it): end the transaction */
+		scn_wr(scn.cb, 0x8, 1, "CB_RESUME (terminate the stalled transaction)", true);
+	}
+	scn_wr(scn.cb, 0x58, fsr, "CB_FSR (clear)", true);
+	return true;
+}
+
+/* bank 4's registers as found: translation off first */
+static void
+scn_bank_back(const char *why)
+{
+	static const char *const names[] = { "CB_SCTLR", "CB_TCR2", "CB_TTBR0 lo", "CB_TTBR0 hi", "CB_TCR", "CB_MAIR0", "CB_MAIR1" };
+	static const uint32_t offs[] = { 0x0, 0x10, 0x20, 0x24, 0x30, 0x38, 0x3c };
+
+	IOLog("icescan: bank %u back as found (%s)\n", scn.bank, why);
+	scn_wr(scn.cb, 0x0, scn.found[0], names[0], true);
+	scn_tlb();
+	for (unsigned i = 1; i < 7; i++) {
+		scn_wr(scn.cb, offs[i], scn.found[i], names[i], true);
+	}
+	scn.a_ok = false;
+}
+
+/* 25a, at the framebuffer's start */
+static void
+scn_init(void)
+{
+	if (gIceScan == 0) {
+		return;
+	}
+	scn.start = mach_absolute_time();
+	scn.dpu = ml_io_map_unmappable(SCN_MDSS_PA, SCN_MDSS_LEN, VM_WIMG_IO);
+	scn.smmu = ml_io_map_unmappable(SCN_SMMU_PA, SCN_SMMU_LEN, VM_WIMG_IO);
+	if (!scn.dpu || !scn.smmu) {
+		IOLog("icescan: REFUSED: MDSS / SMMU not mapped\n");
+		return;
+	}
+	/* the display as 18i found it: CTL0 fetching VIG0..3, all four from one address, its stride the framebuffer's */
+	uint32_t fetch = scn_rd(scn.dpu, SCN_CTL0 + SCN_CTL_FETCH), a = scn_rd(scn.dpu, scn_pipe[0] + SCN_SRC0_ADDR);
+	bool same = a != 0 && a == (uint32_t)kvtophys((vm_offset_t)vinfo.v_baseaddr);
+
+	for (unsigned p = 0; p < 4; p++) {
+		same = same && scn_rd(scn.dpu, scn_pipe[p] + SCN_SRC0_ADDR) == a &&
+		    (scn_rd(scn.dpu, scn_pipe[p] + SCN_SRC_YSTRIDE) & 0xffff) == (uint32_t)vinfo.v_rowbytes;
+	}
+	if ((fetch & 0x000f0000u) != 0x000f0000u || !same) {
+		IOLog("icescan: REFUSED: display not as 18i found it (ctl0 fetch %08x, vig0 %08x, framebuffer %#llx)\n", fetch, a,
+		    (uint64_t)kvtophys((vm_offset_t)vinfo.v_baseaddr));
+		return;
+	}
+	scn.panel = a;
+	/* the stream's route: SMR for SID 0x800 mask 2 -> S2CR translate -> its bank, translation off, CBAR stage 1 */
+	uint32_t id0 = scn_rd(scn.smmu, 0x20), id1 = scn_rd(scn.smmu, 0x24), nsmr = id0 & 0xff, smr = ~0u, s2cr = 0;
+	uint32_t page = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		uint32_t s = scn_rd(scn.smmu, 0x800 + 4 * i);
+
+		if ((s >> 31) && (s & 0x7fff) == SCN_SID && ((s >> 16) & 0x7fff) == 2) {
+			smr = i;
+			s2cr = scn_rd(scn.smmu, 0xc00 + 4 * i);
+		}
+	}
+	scn.bank = s2cr & 0xff;
+	if (smr == ~0u || ((s2cr >> 16) & 3) != 0 || npage * page + (scn.bank + 1) * page > SCN_SMMU_LEN) {
+		IOLog("icescan: REFUSED: no translating stream match for %#x (SMR %u, S2CR %08x)\n", SCN_SID, smr, s2cr);
+		return;
+	}
+	scn.cb = scn.smmu + npage * page + scn.bank * page;
+	uint32_t cbar = scn_rd(scn.smmu, page + 4 * scn.bank), cba2r = scn_rd(scn.smmu, page + 0x800 + 4 * scn.bank);
+	static const uint32_t offs[] = { 0x0, 0x10, 0x20, 0x24, 0x30, 0x38, 0x3c, 0x58 };
+
+	for (unsigned i = 0; i < 8; i++) {
+		scn.found[i] = scn_rd(scn.cb, offs[i]);
+	}
+	if ((scn.found[0] & 1) || ((cbar >> 16) & 3) != 1 || !(cba2r & 1)) {
+		IOLog("icescan: REFUSED: bank %u sctlr %08x cbar %08x cba2r %08x (want translation off, stage 1, VA64)\n", scn.bank,
+		    scn.found[0], cbar, cba2r);
+		return;
+	}
+	if (kmem_alloc(kernel_map, &scn.pool, SCN_TABLES * 0x1000ul, (kma_flags_t)(KMA_KOBJECT | KMA_ZERO | KMA_DATA),
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		IOLog("icescan: REFUSED: no memory for the tables\n");
+		return;
+	}
+	uint64_t l1pa;
+
+	scn.l1 = scn_table(&l1pa);
+	uint32_t fbpages = (uint32_t)(((uint64_t)vinfo.v_rowbytes * vinfo.v_height + 0xfff) >> 12);
+
+	if (!scn_map(scn.panel & ~0xfffull, scn.panel & ~0xfffull, 0, fbpages)) {
+		IOLog("icescan: REFUSED: table pool too small\n");
+		return;
+	}
+	uint32_t f0 = scn_rd(scn.dpu, SCN_INTF1_FRAME);
+
+	IOLog("icescan: 25a: SMR %u -> bank %u (cbar %08x cba2r %08x sctlr %08x tcr %08x ttbr0 %08x%08x): the boot framebuffer "
+	    "%#x (%u pages) mapped at its own address, %u tables (L1 %#llx); turning translation on\n", smr, scn.bank, cbar, cba2r,
+	    scn.found[0], scn.found[4], scn.found[3], scn.found[2], scn.panel, fbpages, scn.used, l1pa);
+	/*
+	 * TCR2: PASIZE 40 bit and SEP = 7 ("upstream": no sign extension), as Linux arm-smmu always writes it. Run 25a (31 Oct)
+	 * wrote PASIZE alone: with SEP 0 an IOVA with bit 31 set -- the boot framebuffer at 0xfc800000 -- is taken as the
+	 * TTBR1 half, which EPD1 disables: translation fault (fsr 40000402, far 0xfe62ce00, the stream stalled). The ADSP's C2
+	 * (IOVA 0x10000000) never had bit 31 set.
+	 */
+	scn_wr(scn.cb, 0x10, 2u | 7u << 15, "CB_TCR2 (PASIZE 40 bit, SEP upstream)", true);
+	scn_wr(scn.cb, 0x20, (uint32_t)l1pa, "CB_TTBR0 lo", true);
+	scn_wr(scn.cb, 0x24, (uint32_t)(l1pa >> 32) | SCN_ASID << 16, "CB_TTBR0 hi (ASID 9)", true);
+	scn_wr(scn.cb, 0x30, 1u << 23 | 3u << 12 | 1u << 10 | 1u << 8 | 32u, "CB_TCR (EPD1, 4K, inner WBWA, T0SZ 32)", true);
+	scn_wr(scn.cb, 0x38, 0x44u | 0xffu << 8 | 0x04u << 16 | 0xf4u << 24, "CB_MAIR0", true);
+	scn_wr(scn.cb, 0x3c, 0, "CB_MAIR1", true);
+	scn_tlb();
+	scn_wr(scn.cb, 0x58, scn_rd(scn.cb, 0x58), "CB_FSR (clear)", true);
+	scn_wr(scn.cb, 0x0, scn.found[0] | 1u | 1u << 12, "CB_SCTLR (M, ASIDPNE)", true);
+	IOSleep(200);
+	uint32_t f1 = scn_rd(scn.dpu, SCN_INTF1_FRAME), fsr = scn_rd(scn.cb, 0x58);
+	bool cur = true;
+
+	for (unsigned p = 0; p < 4; p++) {
+		cur = cur && scn_rd(scn.dpu, scn_pipe[p] + SCN_CURRENT0) == scn.panel;
+	}
+	IOLog("icescan: 25a: 200 ms on: fsr %08x far %08x%08x fsynr0 %08x fsynr1 %08x, frames %u -> %u, pipes on %#x: %s\n", fsr,
+	    scn_rd(scn.cb, 0x64), scn_rd(scn.cb, 0x60), scn_rd(scn.cb, 0x68), scn_rd(scn.cb, 0x6c), f0, f1, scn.panel,
+	    cur ? "yes" : "NO");
+	if ((fsr & SCN_FSR_FAULT) || f1 == f0 || !cur) {
+		/* what our tables say for the faulting address (the CPU's view of each level) */
+		uint64_t far = scn_rd(scn.cb, 0x60) | (uint64_t)scn_rd(scn.cb, 0x64) << 32;
+		uint64_t d1 = scn.l1[(far >> 30) & 3], d2 = 0, d3 = 0;
+		uint64_t *l3 = scn.l3[(far >> 30) & 3][(far >> 21) & 511];
+
+		if (scn.l2[(far >> 30) & 3] != NULL) {
+			d2 = scn.l2[(far >> 30) & 3][(far >> 21) & 511];
+		}
+		if (l3 != NULL) {
+			d3 = l3[(far >> 12) & 511];
+		}
+		IOLog("icescan: 25a: our tables for %#llx: L1 %016llx L2 %016llx L3 %016llx; tcr2 %08x tcr %08x\n", far, d1, d2, d3,
+		    scn_rd(scn.cb, 0x10), scn_rd(scn.cb, 0x30));
+		if (fsr & (1u << 30)) {
+			scn_wr(scn.cb, 0x8, 1, "CB_RESUME (terminate the stalled transaction)", true);
+		}
+		scn_wr(scn.cb, 0x58, fsr, "CB_FSR (clear)", true);
+		scn_bank_back("25a FAILED");
+		IOLog("icescan: 25a FAIL\n");
+		return;
+	}
+	scn.a_ok = true;
+	IOLog("icescan: 25a PASS: the display reads through bank %u's tables, no fault\n", scn.bank);
+}
+
+/* the slot of S (mapped now if need be), or -1 */
+static int
+scn_slot(MiniIOSurface * s)
+{
+	int free = -1;
+
+	for (unsigned i = 0; i < SCN_SLOTS; i++) {
+		if (scn.slot[i] != NULL && scn.slot[i]->sid == s->sid) {
+			return (int)i;
+		}
+		if (scn.slot[i] == NULL && free < 0) {
+			free = (int)i;
+		}
+	}
+	if (free < 0) {
+		/* the oldest slot the pipes are not reading (the order slots were filled in) */
+		for (unsigned i = 0; i < SCN_SLOTS && free < 0; i++) {
+			if (scn.current != i + 1) {
+				free = (int)i;
+			}
+		}
+		scn_unmap(SCN_SLOT_BASE + SCN_SLOT_BYTES * (uint64_t)free, scn.slot_pages[free]);
+		MiniIOSurfaceDrop(scn.slot[free]);
+		scn.slot[free] = NULL;
+	}
+	uint32_t pages = (uint32_t)(((uint64_t)s->info.bytesPerRow * s->info.height + 0xfff) >> 12);
+	MiniIOSurface * held = MiniIOSurfaceCopy(s->sid);
+
+	if (held == NULL) {
+		return -1;
+	}
+	if (!scn_map(SCN_SLOT_BASE + SCN_SLOT_BYTES * (uint64_t)free, 0, (vm_offset_t)s->pixels(), pages)) {
+		MiniIOSurfaceDrop(held);
+		return -1;
+	}
+	scn_tlb();
+	scn.slot[free] = held;
+	scn.slot_pages[free] = pages;
+	if (scn.said++ < 12) {
+		IOLog("icescan: surface %u (%u pages) mapped at IOVA %#llx\n", s->sid, pages, SCN_SLOT_BASE + SCN_SLOT_BYTES *
+		    (uint64_t)free);
+	}
+	return free;
+}
+
+static void
+scn_panel(const char *why)
+{
+	bool back = scn_point(scn.panel, true, 50000);
+
+	if (gIceInUse && scn.current != 0) {
+		MiniIOSurfaceDisplayUse(scn.slot[scn.current - 1], -1);
+	}
+	scn.current = 0;
+	scn.cur_sid = 0;
+	IOLog("icescan: pipes back on the panel memory %#x (%s): %s\n", scn.panel, why, back ? "taken" : "NOT taken in 50 ms");
+}
