+/*
+ * ---- 34ux1 (icepcie_ux1=1; kit 34ux1 = 23e7's args + icepcie_ux1=1): a READ-ONLY census of the AMSS window -----------
+ * 23e7 (the bucks' HPM mode votes) still went AMSS -> RDDM ~29 ms after mission mode, same SFR ("wdog or kernel error
+ * suspected", QURT fatal); 23e7x's x1 cap did not train. UniXNU-sheng's WCN7850 bring-up differs from ours in the rail
+ * votes (mode + VOLTAGE + enable), a PMIC sleep-clock pin, and the image it keeps for the firmware's demand pager. From the
+ * BHIe doorbell until 200 ms after the first EXECENV AMSS (or after RDDM / SYS_ERR if no AMSS), every 2 ms of wall time,
+ * change-only lines of:
+ *  (a) the four shared WCN bucks through the 23f1b observer path (the arbiter's EE 0 observer channel of the peripheral's
+ *      APID: CMD = EXT_READL, STATUS polled, RDATA0/1 - an SPMI bus READ; the votes themselves go through RPMh):
+ *      S1J_E1 / S2J_E1 = pmh0104 (SID 9, bus 1) SMPS1 / SMPS2, S7F_E0 / S8F_E0 = pmh0110 (SID 5, bus 0) SMPS7 / SMPS8, at
+ *      the classic SMPS control address 0x1400 + 0x300 (n - 1) (Linux qcom_spmi-regulator's tables). Read only if the
+ *      arbiter's channel map has an APID for that PPID and its TYPE (0x04) is a buck (0x03 / 0x1c / 0x22), else skipped
+ *      (the PPIDs the map has for SIDs 9 / 5 / 0 are listed once - arbiter MMIO, no bus traffic - for the next kit).
+ *      Registers: STATUS1-4 0x08-0x0b, RT_STS 0x10, 0x40-0x46 (VOLTAGE LSB/MSB = mV on FTSMPS426 and later, MODE 0x45,
+ *      ENABLE 0x46).
+ *  (b) the sleep-clock pin. The DT names none for the WCN7860 PMU (its pinctrl: wlan-en = TLMM gpio16, bt-default =
+ *      pmh0104 gpio5; its clock: rpmhcc RF_CLK1 = the XO) and pmk8850 gpio@b800 configures only gpio1 / gpio2 (camera
+ *      MCLKs). The candidate is pmk8850 GPIO3 (0xba00: SID 0, bus 0) as SM8550 QRD's pmk8550_sleep_clk (gpio3, func1)
+ *      and UniXNU's (0x42 = 5, 0x41 = 0, 0x44 = 2, 0x40 = 1, 0x46 = 0x80): STATUS1, RT_STS (bit 0 = the pin level, not
+ *      compared), MODE_CTL..EN_CTL 0x40-0x46. "32 kHz out" = EN_CTL bit 7, mode output, DIG_OUT_SOURCE func1 (2); the
+ *      level sampled 16 times at the start and counted at every sample.
+ *  (c) the BHIe image in host memory (the 8 MB arena, Normal NC): per sample one 64-bit word per 4 KB page (a rotating
+ *      slot) and a rolling 64 KB window compared with amss.bin, the vector table and bank 9's level-3 tables for the
+ *      arena (e3_tables: an unmap would show there) checksummed; a full per-segment checksum of the file at the doorbell
+ *      and of the arena at the first RDDM / SYS_ERR and at the end.
+ *  (d) PCIe: the root port's LnkSta and AER (uncorrectable / correctable / root error status) through DBI; the endpoint's
+ *      DevSta, LnkSta and AER only while the root port reads DLLLA (config reads over the live link, as 23e5's).
+ * No new writes. The RDDM upload (icepcie_rddm=2) waits for the window's end (~170 ms; the device holds RDDM until read).
+ */
+#define U1_NP           5
+#define U1_LINES        400u
+static bool u1_crash, u1_atcrash;
+static uint64_t u1_t0;
+static int64_t u1_amss_us = -1, u1_crash_us = -1, u1_last_us = -1000000, u1_gap_us;
+static vm_offset_t u1_bar, u1_cb;
+static uint32_t u1_bhi, u1_nseg, u1_n, u1_lines, u1_supp, u1_roll, u1_pass, u1_bad, u1_lbad, u1_badoff = ~0u;
+static uint32_t u1_rexp, u1_raer, u1_eexp, u1_eaer, u1_g1, u1_gn;
+static const uint8_t *u1_img;
+static uint64_t u1_len, u1_vsum0, u1_tsum0;
+static char u1_prev[640];
+static struct {
+	const char *name;
+	uint16_t ppid;
+	uint8_t bus;
+	bool gpio;
+	int apid;
+	int errs;
+	bool ok;
+	vm_offset_t obs;
+	uint8_t v[12];          /* 0x08-0x0b, 0x10, 0x40-0x46 */
+} u1_p[U1_NP] = {
+	{ "S1J", 0x914, 1, false, -1, 0, false, 0, { 0 } }, { "S2J", 0x917, 1, false, -1, 0, false, 0, { 0 } },
+	{ "S7F", 0x526, 0, false, -1, 0, false, 0, { 0 } }, { "S8F", 0x529, 0, false, -1, 0, false, 0, { 0 } },
+	{ "G3", 0x0ba, 0, true, -1, 0, false, 0, { 0 } },
+};
+
+static int64_t
+u1_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - u1_t0, &ns);
+	return (int64_t)(ns / 1000);
+}
+
+/* one observer read of n (1-8) bytes at the peripheral's addr; 0 = done */
+static int
+u1_rd(vm_offset_t obs, uint8_t addr, uint32_t n, uint8_t *out)
+{
+	uint32_t st = 0, d0, d1;
+
+	*(volatile uint32_t *)(obs + 0x0) = 1u << 27 | (uint32_t)addr << 4 | (n - 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int t = 0; t < 250; t++) {
+		st = io_rd(obs, 0x8);
+		if (st & 1) {
+			break;
+		}
+		delay(1);
+	}
+	if (st != 1) {
+		return -1;
+	}
+	d0 = io_rd(obs, 0x18);
+	d1 = n > 4 ? io_rd(obs, 0x1c) : 0;
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = (uint8_t)((i < 4 ? d0 >> (8 * i) : d1 >> (8 * (i - 4))) & 0xff);
+	}
+	return 0;
+}
+
+static bool
+u1_read_p(int k)
+{
+	uint8_t *v = u1_p[k].v;
+
+	if (!u1_p[k].ok) {
+		return false;
+	}
+	if (u1_rd(u1_p[k].obs, 0x08, 4, v) != 0 || u1_rd(u1_p[k].obs, 0x10, 1, v + 4) != 0 ||
+	    u1_rd(u1_p[k].obs, 0x40, 7, v + 5) != 0) {
+		if (++u1_p[k].errs >= 8) {
+			u1_p[k].ok = false;
+			say("icepcie: 34ux1 %s: 8 observer reads not done: no more reads of it\n", u1_p[k].name);
+		}
+		return false;
+	}
+	return true;
+}
+
+static uint64_t
+u1_sum(const volatile uint8_t *p, uint64_t n)
+{
+	uint64_t h = 0xcbf29ce484222325ull, w, i = 0;
+
+	for (; i + 8 <= n; i += 8) {
+		memcpy(&w, (const void *)(uintptr_t)(p + i), 8);
+		h = (h ^ w) * 0x100000001b3ull;
+	}
+	for (; i < n; i++) {
+		h = (h ^ p[i]) * 0x100000001b3ull;
+	}
+	return h ^ (h >> 32);
+}
+
+/* full per-segment checksums: the file's (arena = false) or the arena's against the file's */
+static void
+u1_full(const char *when, bool arena)
+{
+	char b[300];
+	int o = 0;
+	uint32_t diff = 0;
+
+	for (uint32_t i = 0; i < u1_nseg && o < (int)sizeof(b) - 12; i++) {
+		uint64_t n = u1_len - (uint64_t)i * E3_SEG < E3_SEG ? u1_len - (uint64_t)i * E3_SEG : E3_SEG;
+		uint32_t f = (uint32_t)u1_sum(u1_img + (uint64_t)i * E3_SEG, n), a = f;
+		if (arena) {
+			a = (uint32_t)u1_sum((const volatile uint8_t *)(e3_va + (vm_offset_t)i * E3_SEG), n);
+			if (a != f) {
+				diff |= 1u << i;
+			}
+		}
+		o += snprintf(b + o, sizeof(b) - (size_t)o, " %08x", a);
+	}
+	say("icepcie: 34ux1 %s: %s per-segment checksums (%u x 512 KB):%s%s; vector table %s, bank 9 level-3 tables %s\n",
+	    when, arena ? "ARENA" : "file", u1_nseg, b, arena ? (diff ? " - DIFFER from the file in mask" : " = the file's") : "",
+	    u1_sum((const volatile uint8_t *)(e3_va + (vm_offset_t)u1_nseg * E3_SEG), u1_nseg * 16) == u1_vsum0 ? "as at the doorbell" :
+	    "CHANGED", e3_tables == 0 ? "not mapped" : u1_sum((const volatile uint8_t *)e3_tables, PAGE_SIZE) == u1_tsum0 ?
+	    "as at the doorbell" : "CHANGED");
+	if (diff) {
+		say("icepcie: 34ux1 %s: segment mask %05x differs\n", when, diff);
+	}
+}
+
+/*
+ * scan45: 34ux1's SPMI part (arbiter map, the four bucks' and G3's observer channels, the G3 sleep-clock read) on its
+ * own, done once: 34ux2 (icewifi_uv=1) runs it before its rail votes for their readback; u1_start runs it otherwise.
+ */
+static bool u1_spmi_up;
+
+static void
+u1_spmi(void)
+{
+	vm_offset_t core, map, own0, own1;
+	uint32_t b1 = 0, n1 = 0, lvl = 0;
+	static const uint8_t sids[3] = { 9, 5, 0 };
+
+	if (u1_spmi_up) {
+		return;
+	}
+	u1_spmi_up = true;
+	core = ml_io_map_unmappable(0x0c400000u, 0x3000, VM_WIMG_IO);
+	map = ml_io_map_unmappable(0x0c403000u, 0x8000, VM_WIMG_IO);
+	own0 = ml_io_map_unmappable(0x0c42a000u, 0x8000, VM_WIMG_IO);
+	own1 = ml_io_map_unmappable(0x0c43b000u, 0x8000, VM_WIMG_IO);
+	if (core != 0 && map != 0) {
+		b1 = io_rd(core, 0x4) & 0x1fff;
+		n1 = io_rd(core, 0x8) & 0x1fff;
+	}
+	if (core == 0 || map == 0 || own0 == 0 || own1 == 0 || b1 == 0 || b1 + n1 > 0x2000) {
+		say("icepcie: 34ux1 SPMI: arbiter not mapped / FEATURES not usable (bus 1 = %u + %u): no PMIC reads\n", b1, n1);
+	} else {
+		/* the PPIDs the channel map has for SIDs 9 (bus 1), 5 and 0 (bus 0): arbiter MMIO only */
+		for (int s = 0; s < 3; s++) {
+			char l[420];
+			int o = 0, cnt = 0, last = -1;
+			uint32_t lo = sids[s] == 9 ? b1 : 0, hi = sids[s] == 9 ? b1 + n1 : b1;
+			l[0] = 0;
+			for (uint32_t n = lo; n < hi && o < (int)sizeof(l) - 4; n++) {
+				uint32_t v = io_rd(map, 4 * n);
+				if (v == 0 || ((v >> 8) & 0xf) != sids[s] || (int)(v & 0xff) == last) {
+					continue;
+				}
+				last = (int)(v & 0xff);
+				o += snprintf(l + o, sizeof(l) - (size_t)o, " %02x", v & 0xff);
+				cnt++;
+			}
+			say("icepcie: 34ux1 SPMI map SID %u (bus %u): %d peripherals:%s\n", sids[s], sids[s] == 9 ? 1 : 0, cnt, l);
+		}
+		for (int k = 0; k < U1_NP; k++) {
+			uint32_t lo = u1_p[k].bus ? b1 : 0, hi = u1_p[k].bus ? b1 + n1 : b1, w = 0, ob;
+			uint8_t id[2] = { 0, 0 };
+			for (uint32_t n = lo; n < hi; n++) {
+				uint32_t v = io_rd(map, 4 * n);
+				/* _pmic_arb_read_apid_map: the first mapping, overridden by the IRQ owner's (bit 31) */
+				if (v != 0 && (v & 0xfff) == u1_p[k].ppid && (u1_p[k].apid < 0 || (v >> 31))) {
+					u1_p[k].apid = (int)n;
+				}
+			}
+			if (u1_p[k].apid < 0) {
+				say("icepcie: 34ux1 %s PPID %#05x: NO APID in the channel map - not readable from the apps, skipped\n",
+				    u1_p[k].name, u1_p[k].ppid);
+				continue;
+			}
+			w = u1_p[k].bus ? io_rd(own1, 4 * ((uint32_t)u1_p[k].apid - b1)) : io_rd(own0, 4 * (uint32_t)u1_p[k].apid);
+			ob = 0x0c4c0000u + 0x20u * (uint32_t)u1_p[k].apid;
+			u1_p[k].obs = ml_io_map_unmappable(ob & ~0xfffu, PAGE_SIZE, VM_WIMG_IO);
+			if (u1_p[k].obs == 0) {
+				continue;
+			}
+			u1_p[k].obs += ob & 0xfffu;
+			if (u1_rd(u1_p[k].obs, 0x04, 2, id) != 0) {
+				say("icepcie: 34ux1 %s PPID %#05x APID %d (owner EE %u): the identity read was not done: skipped\n",
+				    u1_p[k].name, u1_p[k].ppid, u1_p[k].apid, w & 7);
+				continue;
+			}
+			u1_p[k].ok = u1_p[k].gpio ? id[0] == 0x10 : (id[0] == 0x03 || id[0] == 0x1c || id[0] == 0x22);
+			say("icepcie: 34ux1 %s PPID %#05x (addr %#x) APID %d owner EE %u: TYPE %02x SUBTYPE %02x -> %s\n", u1_p[k].name,
+			    u1_p[k].ppid, (u1_p[k].ppid & 0xff) << 8, u1_p[k].apid, w & 7, id[0], id[1], u1_p[k].ok ? (u1_p[k].gpio ?
+			    "a GPIO: read every sample" : "a buck: read every sample") : "NOT the expected type: no further reads");
+		}
+		if (u1_read_p(4)) {
+			const uint8_t *g = u1_p[4].v;
+			uint32_t mode = g[5] & 3, src = g[9] & 0xf;
+			uint8_t lv[1];
+			for (int i = 0; i < 16; i++) {
+				if (u1_rd(u1_p[4].obs, 0x10, 1, lv) == 0) {
+					lvl = lvl << 1 | (lv[0] & 1);
+				}
+			}
+			say("icepcie: 34ux1 G3 (pmk8850 GPIO3, the sleep-clock candidate): STATUS1 %02x RT_STS %02x MODE_CTL %02x (%s) "
+			    "DIG_VIN %02x DIG_PULL %02x DIG_IN %02x DIG_OUT_SRC %02x (source %u = %s%s) DIG_OUT %02x EN_CTL %02x; level x16 "
+			    "%04x -> 32 kHz sleep-clock OUTPUT %s\n", g[0], g[4], g[5], mode == 0 ? "input" : mode == 1 ? "output" : mode == 2 ?
+			    "in+out" : "analog", g[6], g[7], g[8], g[9], src, src == 0 ? "normal" : src == 1 ? "paired" : src == 2 ? "func1" :
+			    src == 3 ? "func2" : "other", (g[9] >> 7) ? ", inverted" : "", g[10], g[11], lvl & 0xffff, (g[11] >> 7) &&
+			    (mode == 1 || mode == 2) && src == 2 ? ((lvl & 0xffff) != 0 && (lvl & 0xffff) != 0xffff ? "ON (func1, toggling)" :
+			    "SET UP (func1) but the level did not toggle in 16 reads") : "NOT set up");
+		}
+	}
+}
+
+static void
+u1_start(vm_offset_t bar, uint32_t bhi, vm_offset_t cb, const uint8_t *img, uint64_t len, uint32_t nseg)
+{
+	u1_bar = bar;
+	u1_bhi = bhi;
+	u1_cb = cb;
+	u1_img = img;
+	u1_len = len;
+	u1_nseg = nseg;
+	u1_spmi();
+	if (e2_dbi != 0) {
+		u1_rexp = e5_cap(e2_dbi, 0x10);
+		u1_raer = e5_extcap(e2_dbi, 0x0001);
+	}
+	if (e2_cfg != 0) {
+		u1_eexp = e5_cap(e2_cfg, 0x10);
+		u1_eaer = e5_extcap(e2_cfg, 0x0001);
+	}
+	u1_vsum0 = u1_sum((const volatile uint8_t *)(e3_va + (vm_offset_t)nseg * E3_SEG), nseg * 16);
+	u1_tsum0 = e3_tables ? u1_sum((const volatile uint8_t *)e3_tables, PAGE_SIZE) : 0;
+	say("icepcie: 34ux1 PCIe: root port express %#x AER %#x, endpoint express %#x AER %#x; image %llu B in %u segments\n",
+	    u1_rexp, u1_raer, u1_eexp, u1_eaer, len, nseg);
+	u1_full("at the doorbell", false);
+	u1_prev[0] = 0;
+	u1_live = true;
+	u1_t0 = mach_absolute_time();
+}
+
+static void
+u1_image(void)
+{
+	uint64_t pages = (u1_len + 0xfff) >> 12, slot = (uint64_t)((u1_n * 67u) % 512u) * 8, a, f, n;
+
+	for (uint64_t p = 0; p < pages; p++) {
+		uint64_t o = (p << 12) + slot;
+		if (o + 8 > u1_len) {
+			continue;
+		}
+		memcpy(&a, (const void *)(e3_va + (vm_offset_t)o), 8);
+		memcpy(&f, u1_img + o, 8);
+		if (a != f) {
+			u1_bad |= 1u << (o / E3_SEG);
+			if (u1_badoff == ~0u) {
+				u1_badoff = (uint32_t)o;
+			}
+		}
+	}
+	n = u1_len - u1_roll < 0x10000 ? u1_len - u1_roll : 0x10000;
+	if (memcmp((const void *)(e3_va + (vm_offset_t)u1_roll), u1_img + u1_roll, (size_t)n) != 0) {
+		for (uint64_t i = 0; i < n; i++) {
+			if (*(volatile uint8_t *)(e3_va + (vm_offset_t)(u1_roll + i)) != u1_img[u1_roll + i]) {
+				u1_bad |= 1u << ((u1_roll + i) / E3_SEG);
+				if (u1_badoff == ~0u || u1_roll + i < u1_badoff) {
+					u1_badoff = (uint32_t)(u1_roll + i);
+				}
+				break;
+			}
+		}
+	}
+	u1_roll += (uint32_t)n;
+	if (u1_roll >= u1_len) {
+		u1_roll = 0;
+		u1_pass++;
+		if (u1_pass == 1 || u1_bad != u1_lbad) {
+			say("icepcie: 34ux1 +%lld ms: rolling compare pass %u of the whole image: %s (mask %05x, first differing byte "
+			    "%#x)\n", u1_us() / 1000, u1_pass, u1_bad ? "DIFFERS from amss.bin" : "equal to amss.bin", u1_bad, u1_badoff);
+			u1_lbad = u1_bad;
+		}
+	}
+}
+
+/*
+ * scan52: the census ends silently at the first crash sample; its END line waits until after the RDDM upload
+ * (pcie_e4_watch prints it), so nothing stands between the main loop's RDDM read and the doorbell.
+ */
+static bool u1_endlate;
+
+static void
+u1_bail(void)
+{
+	if (!u1_crash) {
+		u1_crash = true;
+		u1_crash_us = u1_us();
+	}
+	u1_atcrash = true;
+	u1_live = false;
+	u1_endlate = true;
+}
+
+/* two MHI register reads: RDDM (EXECENV 3) or SYS_ERR now */
+static bool
+u1_crashed_now(void)
+{
+	uint32_t ee = io_rd(u1_bar, u1_bhi + 0x28), ms = io_rd(u1_bar, 0x48);
+
+	return ee == 3 || (ms != 0xffffffffu && (((ms >> 2) & 1) || ((ms >> 8) & 0xff) == 0xff));
+}
+
+static void
+u1_tick(void)
+{
+	int64_t now = u1_us(), rel;
+	uint32_t ee, ms, rl = 0, ru = 0, rc = 0, rs = 0, el = 0, ed = 0, eu = 0, ec = 0;
+	bool force = false, crash;
+	char cur[640], rb[24];
+	int o = 0;
+
+	if (now - u1_last_us < 2000) {
+		return;
+	}
+	if (u1_n > 0 && now - u1_last_us > u1_gap_us) {
+		u1_gap_us = now - u1_last_us;
+	}
+	u1_last_us = now;
+	ee = io_rd(u1_bar, u1_bhi + 0x28);
+	ms = io_rd(u1_bar, 0x48);
+	if (ee == 2 && u1_amss_us < 0) {
+		u1_amss_us = now;
+		force = true;
+	}
+	crash = ee == 3 || (ms != 0xffffffffu && (((ms >> 2) & 1) || ((ms >> 8) & 0xff) == 0xff));
+	if (crash && !u1_crash) {
+		u1_crash = true;
+		u1_crash_us = now;
+		force = true;
+	}
+	if (crash) {
+		/*
+		 * scan52 (34ux1d): at the first crash sample NOTHING more in the tick - no SPMI / PCIe / image reads and no log line
+		 * (the END line is printed after the RDDM upload). In 34ux1c the main loop already read EXECENV 3 at +19 ms, then
+		 * this tick took ~7 ms (reads + a console line) before the RDDM branch; by then the device had posted ERRCODE 0x3086
+		 * + RXVECSTATUS ffff0000 and ignored the doorbells. 23e7 (no census) rang ~1 ms after RDDM with ERRCODE still 0.
+		 */
+		u1_bail();
+		return;
+	}
+	if (u1_n == 0) {
+		force = true;
+	}
+	for (int k = 0; k < U1_NP; k++) {
+		const uint8_t *v = u1_p[k].v;
+		if (!u1_p[k].ok) {
+			o += snprintf(cur + o, sizeof(cur) - (size_t)o, "%s - ", u1_p[k].name);
+			continue;
+		}
+		if (!u1_read_p(k)) {
+			o += snprintf(cur + o, sizeof(cur) - (size_t)o, "%s rd! ", u1_p[k].name);
+			continue;
+		}
+		if (u1_p[k].gpio) {
+			u1_gn++;
+			u1_g1 += v[4] & 1;
+			o += snprintf(cur + o, sizeof(cur) - (size_t)o, "G3 s%02x m%02x v%02x p%02x i%02x o%02x d%02x e%02x | ",
+			    v[0] & 0xfe, v[5], v[6], v[7], v[8], v[9], v[10], v[11]);
+		} else {
+			o += snprintf(cur + o, sizeof(cur) - (size_t)o, "%s %02x%02x%02x%02x/%02x %umV m%02x e%02x [%02x%02x%02x] ",
+			    u1_p[k].name, v[0], v[1], v[2], v[3], v[4], (uint32_t)v[6] << 8 | v[5], v[10], v[11], v[7], v[8], v[9]);
+		}
+	}
+	if (e2_dbi != 0 && u1_rexp != 0) {
+		rl = io_rd(e2_dbi, u1_rexp + 0x10) >> 16;
+	}
+	if (e2_dbi != 0 && u1_raer != 0) {
+		ru = io_rd(e2_dbi, u1_raer + 0x4);
+		rc = io_rd(e2_dbi, u1_raer + 0x10);
+		rs = io_rd(e2_dbi, u1_raer + 0x30);
+	}
+	if ((rl >> 13) & 1) {
+		/* the endpoint only over a live link (DLLLA) */
+		if (u1_eexp != 0) {
+			ed = io_rd(e2_cfg, u1_eexp + 0x8) >> 16;
+			el = io_rd(e2_cfg, u1_eexp + 0x10) >> 16;
+		}
+		if (u1_eaer != 0) {
+			eu = io_rd(e2_cfg, u1_eaer + 0x4);
+			ec = io_rd(e2_cfg, u1_eaer + 0x10);
+		}
+		o += snprintf(cur + o, sizeof(cur) - (size_t)o, "rp %04x u%08x c%08x r%08x ep %04x ds%04x u%08x c%08x | ", rl, ru, rc,
+		    rs, el, ed, eu, ec);
+	} else {
+		o += snprintf(cur + o, sizeof(cur) - (size_t)o, "rp %04x u%08x c%08x r%08x ep - (no DLLLA) | ", rl, ru, rc, rs);
+	}
+	if (u1_crashed_now()) {
+		/* scan52: a crash during this tick's reads - no image compare and no line: the RDDM branch comes first */
+		u1_bail();
+		return;
+	}
+	if (e3_va != 0) {
+		u1_image();
+		o += snprintf(cur + o, sizeof(cur) - (size_t)o, "img %s%05x vec %s tab %s", u1_bad ? "BAD " : "ok ", u1_bad,
+		    u1_sum((const volatile uint8_t *)(e3_va + (vm_offset_t)u1_nseg * E3_SEG), u1_nseg * 16) == u1_vsum0 ? "ok" : "CHANGED",
+		    e3_tables == 0 ? "-" : u1_sum((const volatile uint8_t *)e3_tables, PAGE_SIZE) == u1_tsum0 ? "ok" : "CHANGED");
+	}
+	(void)o;
+	u1_n++;
+	if (force || strcmp(cur, u1_prev) != 0) {
+		if (u1_amss_us < 0) {
+			snprintf(rb, sizeof(rb), "pre-AMSS");
+		} else {
+			rel = (now - u1_amss_us) / 1000;
+			snprintf(rb, sizeof(rb), "A+%lld", rel);
+		}
+		if (u1_lines < U1_LINES) {
+			u1_lines++;
+			say("icepcie: 34ux1 +%lld.%lld ms %s EE%u %s: %s\n", now / 1000, (now / 100) % 10, rb, ee, e3_state(ms), cur);
+		} else {
+			u1_supp++;
+		}
+		strlcpy(u1_prev, cur, sizeof(u1_prev));
+	}
+	if ((u1_amss_us >= 0 && now > u1_amss_us + 200000) || (u1_amss_us < 0 && u1_crash_us >= 0 && now > u1_crash_us + 200000) ||
+	    now > 30000000) {
+		u1_finish(u1_amss_us >= 0 ? "200 ms after AMSS" : u1_crash_us >= 0 ? "200 ms after the crash (no AMSS)" : "30 s");
+	}
+}
+
+static void
+u1_finish(const char *why)
+{
+	int64_t now = u1_us();
+
+	if (!u1_live && !u1_endlate) {
+		return;
+	}
+	u1_live = false;
+	u1_endlate = false;
+	if (e3_va != 0 && !e5_rddm_done && !u1_atcrash) {
+		u1_full("at the end", true);
+	}
+	say("icepcie: 34ux1 END (%s) at +%lld ms: %u samples, largest gap %lld us, %u lines (%u suppressed); AMSS at %s%lld ms, "
+	    "crash at %s%lld ms; G3 level 1 in %u of %u samples; image %s (mask %05x, first differing byte %#x, %u full rolling "
+	    "passes); SPMI read errors S1J %d S2J %d S7F %d S8F %d G3 %d\n", why, now / 1000, u1_n, u1_gap_us, u1_lines, u1_supp,
+	    u1_amss_us >= 0 ? "+" : "never ", u1_amss_us >= 0 ? u1_amss_us / 1000 : 0, u1_crash_us >= 0 ? "+" : "never ",
+	    u1_crash_us >= 0 ? u1_crash_us / 1000 : 0, u1_g1, u1_gn, u1_bad ? "DIFFERED from amss.bin" : "equal to amss.bin at every "
+	    "sample", u1_bad, u1_badoff, u1_pass, u1_p[0].errs, u1_p[1].errs, u1_p[2].errs, u1_p[3].errs, u1_p[4].errs);
+}
+
+/* LTR_L1.2_THRESHOLD of a Control 1 word in ns (scale 0-5: 1, 32, 1024, 32768, 1048576, 33554432 ns; else invalid) */
+static uint64_t
+e5_thr_ns(uint32_t ctl1)
+{
+	uint32_t v = (ctl1 >> 16) & 0x3ff, s = (ctl1 >> 29) & 7;
+
+	return s > 5 ? 0 : (uint64_t)v << (5 * s);
+}
+
+/* a T_POWER_ON (scale 2 bits, value 5 bits) in us; 0 = reserved scale */
+static uint32_t
+e5_pwron_us(uint32_t scale, uint32_t value)
+{
+	static const uint32_t mul[4] = { 2, 10, 100, 0 };
+
+	return mul[scale & 3] * value;
+}
+
+static void
+e5_portdiag(const char *when, const char *who, vm_offset_t base)
+{
+	uint32_t exp = e5_cap(base, 0x10), l1 = e5_extcap(base, 0x1e), ltr = e5_extcap(base, 0x18);
+	uint32_t lc = exp ? io_rd(base, exp + 0x10) & 0xffff : 0, dc2 = exp ? io_rd(base, exp + 0x24) : 0;
+	uint32_t dctl2 = exp ? io_rd(base, exp + 0x28) & 0xffff : 0;
+	uint32_t cap = l1 ? io_rd(base, l1 + 4) : 0, c1 = l1 ? io_rd(base, l1 + 8) : 0, c2 = l1 ? io_rd(base, l1 + 0xc) : 0;
+	uint32_t lat = ltr ? io_rd(base, ltr + 4) : 0;
+
+	say("icepcie: 23e5 %s %s: LnkCtl %04x (ASPM %u) DevCap2 %08x (LTR supported %u) DevCtl2 %04x (LTR enable %u); L1SS %s%#x "
+	    "cap %08x (PCI-PM L1.2 %u L1.1 %u ASPM L1.2 %u L1.1 %u, CM restore %u us, T_POWER_ON %u us) ctl1 %08x (enables %x, CM "
+	    "restore %u us, LTR_L1.2_THRESHOLD %llu ns%s) ctl2 %08x (T_POWER_ON %u us); LTR cap %s%#x max snoop %04x no-snoop %04x\n",
+	    when, who, lc, lc & 3, dc2, (dc2 >> 11) & 1, dctl2, (dctl2 >> 10) & 1, l1 ? "at +" : "NOT FOUND ", l1, cap, cap & 1,
+	    (cap >> 1) & 1, (cap >> 2) & 1, (cap >> 3) & 1, (cap >> 8) & 0xff, e5_pwron_us((cap >> 16) & 3, (cap >> 19) & 0x1f), c1,
+	    c1 & 0xf, (c1 >> 8) & 0xff, e5_thr_ns(c1), e5_thr_ns(c1) == 0 ? " = ZERO: the firmware's 'Invalid LTR threshold'" : "",
+	    c2, e5_pwron_us(c2 & 3, (c2 >> 3) & 0x1f), ltr ? "at +" : "NOT FOUND ", ltr, lat & 0xffff, lat >> 16);
+}
+
+static void
+e5_diag_all(const char *when, vm_offset_t cfg, vm_offset_t bar, uint32_t bhi, vm_offset_t buf, vm_offset_t cb)
+{
+	uint32_t bhie = io_rd(bar, 0x2c), dbg = io_rd(bar, 0x30), chdb = io_rd(bar, 0x18), m = e5_cap(cfg, 0x05);
+	uint32_t fsr = cb ? io_rd(cb, 0x58) : 0, f = fsr & ~0x600u;
+	char fb[64];
+	int n = 0;
+
+	if (!e5_diag) {
+		return;
+	}
+	e5_portdiag(when, "endpoint", cfg);
+	if (e2_dbi != 0) {
+		e5_portdiag(when, "root port", e2_dbi);
+	}
+	if (m != 0) {
+		uint32_t ctl = io_rd(cfg, m) >> 16;
+		bool is64 = (ctl >> 7) & 1, pvm = (ctl >> 8) & 1;
+		uint32_t d = is64 ? 0xc : 8;
+		say("icepcie: 23e5 %s endpoint MSI at +%#x: ctl %04x (enable %u, MMC %u = %u vectors capable, MME %u = %u enabled, %s, "
+		    "per-vector mask %u) address %08x_%08x data %04x mask %08x pending %08x; MSI sink word %08x\n", when, m, ctl, ctl & 1,
+		    (ctl >> 1) & 7, 1u << ((ctl >> 1) & 7), (ctl >> 4) & 7, 1u << ((ctl >> 4) & 7), is64 ? "64-bit" : "32-bit", pvm,
+		    is64 ? io_rd(cfg, m + 8) : 0, io_rd(cfg, m + 4), io_rd(cfg, m + d) & 0xffff, pvm ? io_rd(cfg, m + d + 4) : 0,
+		    pvm ? io_rd(cfg, m + d + 8) : 0, *(volatile uint32_t *)(buf + 0xf0000));
+	}
+	say("icepcie: 23e5 %s MHI: REGLEN %08x VER %08x CFG %08x CHDBOFF %08x ERDBOFF %08x BHIOFF %08x BHIEOFF %08x MISCOFF %08x "
+	    "DEBUGOFF %08x MHICTRL %08x MHISTATUS %08x\n", when, io_rd(bar, 0x0), io_rd(bar, 0x8), io_rd(bar, 0x10), chdb,
+	    io_rd(bar, 0x20), bhi, bhie, io_rd(bar, 0x24), dbg, io_rd(bar, 0x38), io_rd(bar, 0x48));
+	if (bhi != 0 && bhi < 0xf00 && !(bhi & 3)) {
