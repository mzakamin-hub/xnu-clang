+/* a8xx_set_cp_protect: PROT_EN | FAULT_ON_VIOL_EN | LAST_SPAN_INF_RANGE | HALT_SQE_RANGE, BR and BV; the table; last span */
+static void
+cp_protect(void)
+{
+	const uint32_t cntl = 1u << 0 | 1u << 1 | 1u << 3 | 0xffffu << 16;
+
+	aperture(PIPE_BR);
+	W_G(G8_CP_PROTECT_CNTL_PIPE, cntl);
+	aperture(PIPE_BV);
+	W_G(G8_CP_PROTECT_CNTL_PIPE, cntl);
+	aperture(PIPE_NONE);
+	for (unsigned i = 0; i < PROTECTS; i++) {
+		W_GR(G8_CP_PROTECT_GLOBAL(i), "CP_PROTECT_GLOBAL", protect[i]);
+	}
+	aperture(PIPE_BR);
+	W_GR(G8_CP_PROTECT_PIPE(15), "CP_PROTECT_PIPE(15)", protect[PROTECTS - 1]);
+	aperture(PIPE_BV);
+	W_GR(G8_CP_PROTECT_PIPE(15), "CP_PROTECT_PIPE(15)", protect[PROTECTS - 1]);
+	aperture(PIPE_NONE);
+	say("core: CP protection on: %u ranges, last span from %#x\n", (unsigned)PROTECTS, protect[PROTECTS - 1] & 0x3ffff);
+}
