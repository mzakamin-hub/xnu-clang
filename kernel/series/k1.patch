+/* audioreach_alloc_graph_pkt for one capture sub-graph / container (sizes as audioreach.c's PSIZE macros) */
+static uint32_t
+r2_graph(uint8_t *b, uint32_t sg, uint32_t n, const uint32_t (*mods)[4], uint32_t nconn, const uint32_t (*conn)[4])
+{
+	uint8_t *o = b;
+	uint32_t ml = 32 + 8 * n, mp = (20 + 24 * n + 7) & ~7u, mc = (20 + 16 * nconn + 7) & ~7u;
+
+	bzero(b, 64 + 80 + ml + mp + mc);
+	au_param(&o, APM_IID, 0x08001001, 64 - 16);                    /* sub-graph */
+	au_put(&o, 1);
+	au_put(&o, sg); au_put(&o, 3);
+	au_put(&o, 0x0800100E); au_put(&o, 4); au_put(&o, AU_PERF_LOW_LATENCY);
+	au_put(&o, 0x0800100F); au_put(&o, 4); au_put(&o, 1);          /* direction TX */
+	au_put(&o, 0x08001010); au_put(&o, 4); au_put(&o, 2);          /* scenario: capture */
+	au_param(&o, APM_IID, 0x08001000, 80 - 16);                    /* container (id = the sub-graph's, topology) */
+	au_put(&o, 1);
+	au_put(&o, sg); au_put(&o, 4);
+	au_put(&o, 0x08001011); au_put(&o, 8); au_put(&o, 1); au_put(&o, AU_CONT_TYPE_GC);
+	au_put(&o, 0x08001012); au_put(&o, 4); au_put(&o, 4);                          /* graph position 0x4 (topology) */
+	au_put(&o, 0x08001013); au_put(&o, 4); au_put(&o, 8192);                       /* stack size */
+	au_put(&o, 0x08001014); au_put(&o, 4); au_put(&o, 2);                          /* processor domain: ADSP */
+	au_param(&o, APM_IID, 0x08001002, ml - 16);                    /* module list */
+	au_put(&o, 1);
+	au_put(&o, sg); au_put(&o, sg); au_put(&o, n);
+	for (uint32_t i = 0; i < n; i++) {
+		au_put(&o, mods[i][0]); au_put(&o, mods[i][1]);
+	}
+	au_param(&o, APM_IID, 0x08001003, mp - 16);                    /* module properties: port info */
+	au_put(&o, n);
+	for (uint32_t i = 0; i < n; i++) {
+		au_put(&o, mods[i][1]); au_put(&o, 1); au_put(&o, 0x08001015); au_put(&o, 8); au_put(&o, mods[i][2]);
+		au_put(&o, mods[i][3]);
+	}
+	o = b + 64 + 80 + ml + mp;
+	au_param(&o, APM_IID, 0x08001004, mc - 16);                    /* connections */
+	au_put(&o, nconn);
+	for (uint32_t i = 0; i < nconn; i++) {
+		au_put(&o, conn[i][0]); au_put(&o, conn[i][1]); au_put(&o, conn[i][2]); au_put(&o, conn[i][3]);
+	}
+	return 64 + 80 + ml + mp + mc;
+}
+
+static bool
+r2_call(struct gchan *apps, uint32_t opcode, const uint8_t *b, uint32_t n, const char *what)
+{
+	int32_t s = gpr_call(apps, APM_IID, opcode, b, n, 0xffffffffu, what);
+
+	mic("r2: APM %s: %s (status %d)\n", what, s == 0 ? "OK" : "REFUSED / NO ANSWER", (int)s);
+	return s == 0;
+}
+
+/* audioreach_logging_set_media_format's pair: PARAM_ID_MODULE_ENABLE, then PARAM_ID_DATA_LOGGING_CONFIG */
+static bool
+r2_log(struct gchan *apps, uint32_t iid, uint32_t code, const char *what)
+{
+	uint8_t b[32], *o = b;
+	bool ok;
+
+	au_param(&o, iid, 0x08001026, 4);
+	au_put(&o, 1);
+	ok = r2_call(apps, APM_CMD_SET_CFG_, b, 20, what);
+	o = b;
+	au_param(&o, iid, 0x08001031, 12);
+	au_put(&o, code); au_put(&o, 1); au_put(&o, 0);
+	return ok && r2_call(apps, APM_CMD_SET_CFG_, b, 28, what);
+}
+
+/* audioreach_pcm_set_media_format: PARAM_ID_PCM_OUTPUT_FORMAT_CFG, 16 bit, interleaved (topology), 1 ch FL */
+static bool
+r2_pcm(struct gchan *apps, uint32_t iid, const char *what)
+{
+	uint8_t b[48], *o = b;
+
+	bzero(b, sizeof(b));
+	au_param(&o, iid, 0x08001008, 48 - 16);
+	au_put(&o, 1); au_put(&o, 0x09001000); au_put(&o, 20);
+	au_put16(&o, 16); au_put16(&o, 1); au_put16(&o, 16); au_put16(&o, 15);
+	au_put16(&o, 1); au_put16(&o, 1); au_put16(&o, 0); au_put16(&o, 1);
+	*o++ = 1;                                                       /* FL */
+	return r2_call(apps, APM_CMD_SET_CFG_, b, 48, what);
+}
+
+/* q6apm_read: one period to the RD_SHARED_MEM_EP (header + data_cmd_rd_sh_mem_ep_data_buffer_v2) */
+static bool
+r2_read(struct gchan *apps, uint32_t slot, uint32_t handle)
+{
+	uint32_t w[14];
+	uint64_t a = C2_DSP_ADDR + (uint64_t)slot * R2_PERIOD;     /* tagged as q6apm-dai's prtd->phys */
+
+	bzero(w, sizeof(w));
+	w[0] = 0 | 6u << 4 | (uint32_t)sizeof(w) << 8;
+	w[1] = GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8;
+	w[2] = R2_PORT;
+	w[3] = R2_FE_IID_RDSH;
+	w[4] = slot;                    /* token: the buffer index */
+	w[5] = DATA_CMD_RD_SH_V2;
+	w[6] = (uint32_t)a;
+	w[7] = (uint32_t)(a >> 32);
+	w[8] = handle;
+	w[9] = R2_PERIOD;
+	return g_tx_data(apps, w, sizeof(w));
+}
+
+/*
+ * 17r2c: the DSP side in Linux's DPCM capture order, interleaved with 17r1c's codec side (17r2b ran the whole DSP side
+ * after the codec side was up and got no buffer):
+ *   startup: q6apm_dai_pcm_new's map, q6apm_lpass_dai_startup (back end GRAPH_OPEN), q6apm_dai_open (stream
+ *     GRAPH_OPEN) -- before hw_params / prepare;
+ *   back end prepare (__soc_pcm_prepare of the BE): snd_soc_link_prepare = qcom_snd_sdw_prepare (SoundWire prepare +
+ *     enable: 17r1c), then q6apm_lpass_dai_prepare (codec DMA / LOG media formats, GRAPH_PREPARE), then the DAPM stream
+ *     event (the decimator, tx_swr_ctrl) and mute_stream(0);
+ *   front end prepare (q6apm_dai_prepare: media formats, GRAPH_PREPARE, GRAPH_START, the reads);
+ *   trigger START: the back end's GRAPH_START (q6apm_lpass_dai_trigger);
+ *   then the meter (the TX macro's 300 ms HPF work runs inside it), then the close (DSP side first: no SMMU-mapped DMA
+ *   while anything else changes).
+ */
+static struct {
+	uint32_t handle, fsr0, secs, got, bad, late, sent, pk_all, want, gpr_lines;
+	uint64_t sumsq_all, cnt_all;
+	bool c2, mapped, be_open, fe_open, be_started, fe_started, closed, svc;
+	const char *why;
+} r2;
+
+/*
+ * ---- 17s: the capture SERVICE (boot-arg icemic_svc=1, only with icemic_cmd=4 and only once its path came up) -------
+ * 17r2d's whole path and graphs stay up for icemic_secs (60 by default, at most 3600, and always ending 20 s before
+ * loader_return_after), the RD_SHARED_MEM_EP buffers read continuously; what the microphone hears goes to userland
+ * through /dev/redwood-mic with the interface of dada's (hakios_dada_audio.c dadamic=3, after redwood_mic.c), so the
+ * ported plug-in's input side (userland-ipad audio_plugin.c codec_read: open("/dev/redwood-mic", O_RDONLY |
+ * O_NONBLOCK), read(fd, samples, frames * 2)) works unchanged: 16-bit signed little-endian samples, ONE channel, 48 kHz
+ * (the graph's own format: no conversion); no ioctl; read() never waits -- it gives what has come, keeping the reader
+ * about 40 ms (1920 frames) behind the DSP, 0 bytes until that much has come (and again after it ran dry), and the
+ * oldest is skipped when more than 100 ms waits; open / close only count (the path runs for the whole service window,
+ * whether anything reads or not; nothing is kept beyond the 341 ms ring, and the ring is zeroed at the end). The node
+ * is made at the first service (never if boot-arg mic= or dadaaudio= is given: their drivers make the same node); after
+ * the service a read gives 0 bytes. Log: one line a second (peak / RMS dBFS of that second, buffers, frames read,
+ * skipped / short reads) instead of one per 80 ms buffer. No hardware write beyond 17r2d.
+ */
+#define MSV_RING_FRAMES         16384           /* 341 ms; a power of two (dada's MRING_FRAMES) */
+#define MSV_KEEP                1920            /* 40 ms behind the DSP */
+#define MSV_MOST                4800            /* more than 100 ms waiting: the oldest is skipped */
+static int16_t *msv_ring;
+static volatile uint64_t msv_written;
+static uint64_t msv_read, msv_skipped, msv_dry, msv_taken;
+static volatile uint32_t msv_live, msv_opens;
+/*
+ * w4-audio round 7: the two numbers behind the IOAudio2 microphone's stop line (iokit/Native/IcelandAudio). msv_take's
+ * overrun clamp drops two very different things: frames the reader was too slow for (a loss while it is reading,
+ * ice_icemic_skipped) and, at its first read after priming, the backlog that had piled up before it read at all (that one
+ * said 1749120 frames in a 30 s recording, though nothing was lost: the DSP had been filling the ring). msv_skipped keeps
+ * the same meaning as ice_icemic_skipped now; the backlog is counted apart, for information.
+ */
+volatile uint64_t ice_icemic_skipped;   /* frames the clamp dropped while the reader was already primed */
+volatile uint64_t ice_icemic_backlog;   /* frames the clamp dropped at the reader's first read (the priming clamp) */
+/* 17t2: userland sees when the microphone (and later the speaker service) is live: sysctl kern.icemic_live / icesnd_live */
+static int ice_mic_live, ice_snd_live;
+SYSCTL_INT(_kern, OID_AUTO, icemic_live, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_mic_live, 0, "iceland mic service live");
+SYSCTL_INT(_kern, OID_AUTO, icesnd_live, CTLFLAG_RD | CTLFLAG_LOCKED, &ice_snd_live, 0, "iceland sound service live");
+static bool msv_primed, msv_node;
+
+static int
+msv_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint64_t written = __atomic_load_n(&msv_written, __ATOMIC_ACQUIRE), avail, want;
+	int error = 0;
+
+	if (msv_ring == NULL || !msv_live || uio_resid(uio) < 2) {
+		return 0;
+	}
+	want = (uint64_t)uio_resid(uio) / 2;
+	avail = written - msv_read;
+	if (avail > MSV_MOST) {
+		msv_skipped += avail - MSV_KEEP;
+		msv_read = written - MSV_KEEP;
+		avail = MSV_KEEP;
+	}
+	if (!msv_primed) {
+		if (avail < MSV_KEEP) {
+			return 0;
+		}
+		msv_primed = true;
+	}
+	if (avail < want) {
+		msv_dry++;
+		msv_primed = false;
+	}
+	while (want > 0 && avail > 0 && error == 0) {
+		uint64_t at = msv_read % MSV_RING_FRAMES, n = want < avail ? want : avail;
+
+		n = n < MSV_RING_FRAMES - at ? n : MSV_RING_FRAMES - at;
+		error = uiomove((caddr_t)&msv_ring[at], (int)(n * 2), uio);
+		msv_read += n;
+		msv_taken += n;
+		want -= n;
+		avail -= n;
+	}
+	return error;
+}
+
+/*
+ * w4-audio (macOS): the same ring for a kernel reader -- redwood-audio's capture source (redwood_audio_set_source), which
+ * the IOAudio2 "Mic" device asks one 5 ms period at a time (iokit/Native/IcelandAudio, icesnddev=2). The DSP gives 80 ms
+ * buffers (R2_PERIOD), so this reader keeps more than msv_dev_read's 40 ms: nothing until 120 ms have come (and again
+ * after it ran dry), which leaves it 80 to 160 ms behind the DSP; the oldest is skipped when more than 240 ms wait.
+ * Round 7: the clamp's drop counts as skipped only while the reader is primed (the first read's backlog is told apart), and
+ * only an empty ring un-primes -- a short-but-nonzero read is not a gap.
+ */
+#define MSV_TAKE_PRIME          5760u           /* 120 ms */
+#define MSV_TAKE_MOST           11520u          /* 240 ms */
+static uint32_t
+msv_take(int16_t *mono, uint32_t count)
+{
+	uint64_t written = __atomic_load_n(&msv_written, __ATOMIC_ACQUIRE), avail;
+	uint32_t given = 0;
+
+	if (msv_ring == NULL || !msv_live) {
+		return 0;
+	}
+	avail = written - msv_read;
+	if (avail > MSV_TAKE_MOST) {
+		uint64_t dropped = avail - MSV_TAKE_PRIME;
+
+		if (msv_primed) {
+			msv_skipped += dropped;
+			ice_icemic_skipped += dropped;
+		} else {
+			ice_icemic_backlog = dropped;
+		}
+		msv_read = written - MSV_TAKE_PRIME;
+		avail = MSV_TAKE_PRIME;
+	}
+	if (!msv_primed) {
+		if (avail < MSV_TAKE_PRIME) {
+			return 0;
+		}
+		msv_primed = true;
+	}
+	if (avail == 0) {
+		/* a gap, not a short read: 120 ms have to come again before this reader is served (round 7: a short-but-nonzero
+		 * read used to un-prime here too, and the next calls gave 0 until the ring had 120 ms in it) */
+		msv_dry++;
+		msv_primed = false;
+	}
+	while (given < count && avail > 0) {
+		mono[given++] = msv_ring[msv_read % MSV_RING_FRAMES];
+		msv_read++;
+		avail--;
+	}
+	msv_taken += given;
+	return given;
+}
+
+static int
+msv_dev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	msv_opens++;
+	return 0;
+}
+
+static int
+msv_dev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw msv_cdevsw = {
+	.d_open = msv_dev_open, .d_close = msv_dev_close, .d_read = msv_dev_read, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* the ring and /dev/redwood-mic (once); false: no service */
+static bool
+msv_make(void)
+{
+	uint32_t other = 0;
+	int major;
+
+	if (PE_parse_boot_argn("mic", &other, sizeof(other)) || PE_parse_boot_argn("dadaaudio", &other, sizeof(other))) {
+		mic("r2: service REFUSED: boot-arg mic= / dadaaudio= given (their drivers make /dev/redwood-mic): meter only\n");
+		return false;
+	}
+	if (msv_ring == NULL) {
+		msv_ring = (int16_t *)kalloc_data(MSV_RING_FRAMES * sizeof(int16_t), Z_WAITOK | Z_ZERO);
+	}
+	if (msv_ring == NULL) {
+		mic("r2: service REFUSED: no memory for the ring\n");
+		return false;
+	}
+	if (!msv_node) {
+		major = cdevsw_add(-1, &msv_cdevsw);
+		if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-mic") == NULL) {
+			mic("r2: service REFUSED: /dev/redwood-mic cannot be made\n");
+			return false;
+		}
+		msv_node = true;
+	}
+	msv_read = msv_skipped = msv_dry = msv_taken = 0;
+	ice_icemic_skipped = 0;
+	msv_primed = false;
+	__atomic_store_n(&msv_written, 0, __ATOMIC_RELEASE);
+	return true;
+}
+
+/* startup: C2, the map, both GRAPH_OPENs */
+static bool
+r2_startup(struct gchan *apps, bool svc)
+{
+	static const uint32_t be_mods[2][4] = {
+		{ 0x07001024u, R2_BE_IID_CDMA, 0, 1 }, { 0x0700101Au, R2_BE_IID_LOG, 1, 1 },
+	}, be_conn[1][4] = {
+		{ R2_BE_IID_CDMA, 1, R2_BE_IID_LOG, 2 },
+	}, fe_mods[5][4] = {
+		{ 0x0700101Au, R2_FE_IID_LOG, 1, 1 }, { 0x07001015u, R2_FE_IID_MFC, 1, 1 }, { 0x07001003u, R2_FE_IID_CNV, 1, 1 },
+		{ 0x07001004u, R2_FE_IID_ENC, 1, 1 }, { 0x07001001u, R2_FE_IID_RDSH, 1, 0 },
+	}, fe_conn[5][4] = {
+		{ R2_BE_IID_LOG, 1, R2_FE_IID_LOG, 2 }, { R2_FE_IID_LOG, 1, R2_FE_IID_MFC, 2 }, { R2_FE_IID_MFC, 1, R2_FE_IID_CNV, 2 },
+		{ R2_FE_IID_CNV, 1, R2_FE_IID_ENC, 2 }, { R2_FE_IID_ENC, 1, R2_FE_IID_RDSH, 2 },
+	};
+	uint8_t b[560];
+	uint32_t n;
+
+	bzero(&r2, sizeof(r2));
+	r2.closed = true;
+	r2.svc = svc;
+	r2.secs = svc ? (ice_rec() ? 150 : 60) : 10;
+	PE_parse_boot_argn("icemic_secs", &r2.secs, sizeof(r2.secs));
+	if (r2.secs < 1 || r2.secs > (svc ? 3600u : 30u)) {
+		r2.secs = svc ? 60 : 10;
+	}
+	if (svc) {
+		uint32_t lra = 0, up = (uint32_t)(now_us() / 1000000ull);
+
+		/* the service ends 20 s before loader_return_after (the teardown, level E's put-back, the loader); on macOS the
+		 * run's end is reset-after's */
+		if ((PE_parse_boot_argn("loader_return_after", &lra, sizeof(lra)) ||
+		    PE_parse_boot_argn("reset-after", &lra, sizeof(lra))) && lra != 0) {
+			uint32_t room = lra > up + 20 ? lra - up - 20 : 1;
+
+			if (r2.secs > room) {
+				mic("r2: service: icemic_secs %u cut to %u (the run ends at %u s, now %u s)\n", r2.secs, room, lra, up);
+				r2.secs = room;
+			}
+		}
+	}
+	r2.want = r2.secs * 1000u / 80u;
+	mic("r2: 17r2c: the DSP's capture graphs (back end 0x4009 TX_CODEC_DMA_TX_3, stream 0x4003 MultiMedia3 -> "
+	    "RD_SHARED_MEM_EP) in Linux's DPCM order with 17r1c; %s, %u s\n", svc ? "17s SERVICE: the microphone to "
+	    "/dev/redwood-mic, a level line a second" : "LEVEL METER ONLY, 20 ms windows, nothing stored", r2.secs);
+	if (!c2_setup()) {
+		mic("r2 REFUSED: C2's apps-SMMU bank was not set up (see the c2 lines): nothing sent to the DSP\n");
+		return false;
+	}
+	r2.c2 = true;
+	c2_map_token = R2_FE_GRAPH_ID;
+	r2.handle = c2_dsp_map(apps);
+	c2_fault_report("r2 after the map");
+	r2.fsr0 = rd(c2.cb + 0x58);
+	if (r2.handle == 0) {
+		mic("r2 REFUSED: the DSP did not map C2's buffer: no graph\n");
+		return false;
+	}
+	r2.mapped = true;
+	mic("r2: buffer map handle %#x (IOVA %#llx | 1 << 32, 64 KB, token %u), bank %u FSR %#x\n", r2.handle, C2_IOVA,
+	    R2_FE_GRAPH_ID, c2.bank, r2.fsr0);
+	mic_rd_in = mic_rd_out = 0;
+	n = r2_graph(b, R2_BE_SG, 2, be_mods, 1, be_conn);
+	r2.be_open = r2_call(apps, APM_CMD_GRAPH_OPEN_, b, n,
+	    "GRAPH_OPEN back end 0x4009 (CODEC_DMA_SOURCE 0x6090 -> LOG 24721) (q6apm_lpass_dai_startup)");
+	if (!r2.be_open) {
+		return false;
+	}
+	n = r2_graph(b, R2_FE_SG, 5, fe_mods, 5, fe_conn);
+	r2.fe_open = r2_call(apps, APM_CMD_GRAPH_OPEN_, b, n, "GRAPH_OPEN stream 0x4003 (LOG -> MFC -> CNV -> ENC -> RD_SH "
+	    "24612) + FE-BE 24721:1 -> 0x6020:2 (q6apm_dai_open)");
+	return r2.fe_open;
+}
+
+/* q6apm_lpass_dai_prepare (after qcom_snd_sdw_prepare, before the DAPM stream event) */
+static bool
+r2_be_prepare(struct gchan *apps)
+{
+	uint8_t b[112], *o;
+	uint32_t n;
+	bool ok;
+
+	bzero(b, sizeof(b));
+	o = b;
+	au_param(&o, R2_BE_IID_CDMA, 0x08001017, 32 - 16);             /* PARAM_ID_HW_EP_MF_CFG */
+	au_put(&o, 48000); au_put16(&o, 16); au_put16(&o, 1); au_put(&o, 1);
+	o = b + 32;
+	au_param(&o, R2_BE_IID_CDMA, 0x08001018, 24 - 16);             /* PARAM_ID_HW_EP_FRAME_SIZE_FACTOR */
+	au_put(&o, 1);
+	o = b + 56;
+	au_param(&o, R2_BE_IID_CDMA, 0x08001063, 32 - 16);             /* PARAM_ID_CODEC_DMA_INTF_CFG */
+	au_put(&o, 1); au_put(&o, 4); au_put(&o, 0x1);
+	o = b + 88;
+	au_param(&o, R2_BE_IID_CDMA, 0x08001176, 24 - 16);             /* PARAM_ID_HW_EP_POWER_MODE_CFG */
+	au_put(&o, 0);
+	ok = r2_call(apps, APM_CMD_SET_CFG_, b, 112, "SET_CFG back end codec DMA: 48 kHz / 16 bit / 1 ch, frame factor 1, "
+	    "RXTX TX3 channels 0x1, power mode 0");
+	ok = ok && r2_log(apps, R2_BE_IID_LOG, 0x19ab, "back end LOG 24721 enable / code 0x19ab tap 1");
+	if (ok) {
+		n = au_mgmt(b, R2_BE_SG);
+		ok = r2_call(apps, APM_CMD_GRAPH_PREPARE_, b, n, "GRAPH_PREPARE back end 0x4009");
+	}
+	if (!ok) {
+		r2.why = "the back end's prepare was refused";
+	}
+	return ok;
+}
+
+/* q6apm_dai_prepare (media formats, PREPARE, START, the reads), then trigger START: the back end's GRAPH_START */
+static bool
+r2_fe_start(struct gchan *apps)
+{
+	uint8_t b[48], *o;
+	uint32_t n;
+	bool ok;
+
+	ok = r2_log(apps, R2_FE_IID_LOG, 0x19af, "stream LOG 0x6020 enable / code 0x19af tap 1");
+	if (ok) {
+		bzero(b, sizeof(b));
+		o = b;
+		au_param(&o, R2_FE_IID_MFC, 0x08001024, 12);
+		au_put(&o, 48000); au_put16(&o, 16); au_put16(&o, 1); au_put16(&o, 1);
+		ok = r2_call(apps, APM_CMD_SET_CFG_, b, 28, "SET_CFG stream MFC 24609 output 48 kHz / 16 bit / 1 ch FL");
+	}
+	ok = ok && r2_pcm(apps, R2_FE_IID_CNV, "SET_CFG stream PCM converter 24610: 16 bit, interleaved, 1 ch FL");
+	ok = ok && r2_pcm(apps, R2_FE_IID_ENC, "SET_CFG stream PCM encoder 24611: 16 bit, interleaved, 1 ch FL");
+	if (ok) {
+		n = au_mgmt(b, R2_FE_SG);
+		ok = r2_call(apps, APM_CMD_GRAPH_PREPARE_, b, n, "GRAPH_PREPARE stream 0x4003");
+	}
+	if (ok) {
+		n = au_mgmt(b, R2_FE_SG);
+		r2.fe_started = r2_call(apps, APM_CMD_GRAPH_START_, b, n, "GRAPH_START stream 0x4003");
+		ok = r2.fe_started;
+	}
+	for (uint32_t s = 0; ok && s < R2_PERIODS; s++) {      /* "Queue the buffers for Capture ONLY after graph is started" */
+		ok = r2_read(apps, s, r2.handle);
+		r2.sent += ok;
+	}
+	if (ok) {
+		n = au_mgmt(b, R2_BE_SG);
+		r2.be_started = r2_call(apps, APM_CMD_GRAPH_START_, b, n, "GRAPH_START back end 0x4009 (trigger START)");
+		ok = r2.be_started;
+	}
+	if (!ok) {
+		r2.why = "a front end / start step was refused (see the APM lines)";
+	}
+	return ok;
+}
+
+/* the level meter; the TX macro's HPF work (tx_macro_tx_hpf_corner_freq_callback) runs at t_en + 300 ms inside it */
+static bool
+r2_meter(struct gchan *apps, const struct mic_blk *txm, uint64_t t_en, bool *hpf_done, bool *dec_ok)
+{
+	uint64_t t0, t_last, t_sec, s_sq = 0, s_cnt = 0;
+	uint32_t seq = gpr_rx_seq, s_pk = 0, s_bufs = 0, s_n = 0;
+	bool ok = true;
+
+	if (r2.svc && msv_make()) {
+		msv_live = 1;
+		ice_mic_live = 1;
+		mic("r2: SPEAK NOW: the microphone is live (kern.icemic_live = 1)\n");
+		mic("r2: SERVICE: /dev/redwood-mic is the microphone for %u s (16-bit, 1 channel, 48 kHz; non-blocking read, 40 ms "
+		    "behind)\n", r2.secs);
+		redwood_audio_set_source("the microphone (iceland: ADSP capture graph, icemic_svc)", msv_take);
+	} else if (r2.svc) {
+		r2.svc = false;
+		if (r2.secs > 30) {
+			r2.secs = 10;
+			r2.want = r2.secs * 1000u / 80u;
+		}
+	}
+	mic("r2: THE CAPTURE GRAPHS RUN: %u reads of %u bytes queued; %s %u s\n", r2.sent, R2_PERIOD, r2.svc ? "service for" :
+	    "metering", r2.secs);
+	g_quiet = true;
+	t0 = t_last = t_sec = now_us();
+	while (ok && now_us() - t0 < r2.secs * 1000000ull && !g_broken && !adsp_stop_req) {   /* (w4: or the run ends) */
+		g_pump();
+		if (r2.svc && now_us() - t_sec >= 1000000ull) {         /* one line a second */
+			t_sec += 1000000ull;
+			mic("r2: service %u s: %u buffers, peak/RMS %d/%d dBFS; /dev/redwood-mic: %u opens, %llu frames read, %llu "
+			    "skipped, %llu short reads\n", ++s_n, s_bufs, mic_dbfs(s_pk), mic_dbfs(s_cnt ? mic_isqrt(s_sq / s_cnt) : 0),
+			    msv_opens, msv_taken, msv_skipped, msv_dry);
+			s_pk = s_bufs = 0;
+			s_sq = s_cnt = 0;
+		}
+		if (!*hpf_done && now_us() - t_en >= 300000ull) {
+			*hpf_done = true;
+			*dec_ok &= mic_dec_hpf_work(txm);
+		}
+		if (gpr_rx_seq != seq) {                /* any other DSP packet while capturing (an error event, ...) */
+			seq = gpr_rx_seq;
+			if (r2.gpr_lines++ < 8) {
+				mic("r2: DSP packet while capturing: opcode %#x, words %#x %#x\n", gpr_rx_opcode, gpr_rx_w0, gpr_rx_w1);
+			}
+		}
+		while (mic_rd_out != mic_rd_in) {
+			uint32_t k = mic_rd_out % 32, slot = mic_rd_ring[k].token, size = mic_rd_ring[k].size,
+			    off = mic_rd_ring[k].offset, fsr = rd(c2.cb + 0x58), frames, pos = 0;
+			char line[200];
+			int ln;
+
+			mic_rd_out++;
+			if (fsr != 0 && fsr != r2.fsr0) {
+				mic("r2: bank %u FSR %#x (FAR %#x_%08x FSYNR0 %#x): a DSP access faulted -- no further read\n", c2.bank,
+				    fsr, rd(c2.cb + 0x64), rd(c2.cb + 0x60), rd(c2.cb + 0x68));
+				r2.why = "an SMMU fault on bank 7 while capturing";
+				ok = false;
+				break;
+			}
+			if (slot >= R2_PERIODS || mic_rd_ring[k].lsw != (uint32_t)(C2_IOVA + (uint64_t)slot * R2_PERIOD) ||
+			    mic_rd_ring[k].status != 0) {
+				if (r2.bad++ == 0) {
+					mic("r2: unexpected read done: token %u, address %#x_%08x, status %#x, size %u, offset %u\n", slot,
+					    mic_rd_ring[k].msw, mic_rd_ring[k].lsw, mic_rd_ring[k].status, size, off);
+				}
+				continue;
+			}
+			if (r2.got == 0) {
+				mic("r2: first buffer: token %u, %u bytes at offset %u, %u frames, flags %#x, after %llu ms\n", slot, size,
+				    off, mic_rd_ring[k].frames, mic_rd_ring[k].flags, (now_us() - t0) / 1000);
+			}
+			if (off > R2_PERIOD) {
+				off = 0;
+			}
+			if (size > R2_PERIOD - off) {
+				size = R2_PERIOD - off;
+			}
+			frames = size / 2;
+			c2_clean(c2.buf + (vm_offset_t)slot * R2_PERIOD, R2_PERIOD);   /* the DSP wrote it: drop stale lines */
+			ln = snprintf(line, sizeof(line), "r2: meter %5llu ms, buffer %u (%u frames): 20 ms peak/RMS dBFS:",
+			    (now_us() - t0) / 1000, slot, frames);
+			while (pos < frames) {
+				const int16_t *pcm = (const int16_t *)(c2.buf + (vm_offset_t)slot * R2_PERIOD + off) + pos;
+				uint32_t cnt = LESSER(R2_WIN, frames - pos), pk = 0;
+				uint64_t sq = 0;
+
+				for (uint32_t f = 0; f < cnt; f++) {
+					int32_t v = pcm[f];
+					uint32_t m = (uint32_t)(v < 0 ? -v : v);
+
+					pk = GREATER(pk, m);
+					sq += (uint64_t)((int64_t)v * v);
+				}
+				r2.pk_all = GREATER(r2.pk_all, pk);
+				r2.sumsq_all += sq;
+				r2.cnt_all += cnt;
+				s_pk = GREATER(s_pk, pk);
+				s_sq += sq;
+				s_cnt += cnt;
+				if (ln > 0 && ln < (int)sizeof(line) - 12) {
+					ln += snprintf(line + ln, sizeof(line) - (size_t)ln, " %d/%d", mic_dbfs(pk),
+					    mic_dbfs(mic_isqrt(sq / cnt)));
+				}
+				pos += cnt;
+			}
+			if (r2.svc) {
+				/* 17s: into /dev/redwood-mic's ring (16-bit, one channel, 48 kHz: as the graph gives it) */
+				const int16_t *pcm = (const int16_t *)(c2.buf + (vm_offset_t)slot * R2_PERIOD + off);
+				uint64_t at = msv_written;
+
+				for (uint32_t f = 0; f < frames; f++) {
+					msv_ring[(at + f) % MSV_RING_FRAMES] = pcm[f];
+				}
+				__atomic_store_n(&msv_written, at + frames, __ATOMIC_RELEASE);
+				s_bufs++;
+			} else {
+				mic("%s\n", line);
+			}
+			r2.got++;
+			t_last = now_us();
+			if (!r2_read(apps, slot, r2.handle)) {          /* event_handler: q6apm_read while running */
+				r2.why = "a read could not be queued again";
+				ok = false;
+				break;
+			}
+			r2.sent++;
+		}
+		if (ok && now_us() - t_last > 1000000ull) {
+			r2.why = "the DSP filled no buffer for 1 s";
+			ok = false;
+		}
+		sleep_ms(2);
+	}
+	g_quiet = false;
+	if (r2.svc) {
+		msv_live = 0;                           /* reads give 0 bytes from now on */
+		ice_mic_live = 0;
+		redwood_audio_set_source("nothing (iceland icemic_svc ended)", NULL);
+		delay_for_interval(5, NSEC_PER_MSEC);
+		bzero(msv_ring, MSV_RING_FRAMES * sizeof(int16_t));
+		mic("r2: SERVICE ended: /dev/redwood-mic %u opens, %llu frames read (%llu ms), %llu skipped, %llu short reads; ring "
+		    "zeroed\n", msv_opens, msv_taken, msv_taken * 1000 / 48000, msv_skipped, msv_dry);
+	}
+	if (!*hpf_done) {
+		*hpf_done = true;
+		*dec_ok &= mic_dec_hpf_work(txm);
+	}
+	return ok;
+}
+
+/* the close: back end (q6apm_lpass_dai_shutdown) then stream (q6apm_dai_close), late answers, unmap, C2 put back */
+static bool
+r2_close(struct gchan *apps, bool metered)
+{
+	uint8_t b[32];
+	uint32_t n;
+	bool ok;
+
+	if (r2.be_started) {
+		n = au_mgmt(b, R2_BE_SG);
+		r2.closed &= r2_call(apps, APM_CMD_GRAPH_STOP_, b, n, "GRAPH_STOP back end 0x4009");
+	}
+	if (r2.be_open) {
+		n = au_mgmt(b, R2_BE_SG);
+		r2.closed &= r2_call(apps, APM_CMD_GRAPH_CLOSE_, b, n, "GRAPH_CLOSE back end 0x4009");
+	}
+	if (r2.fe_started) {
+		n = au_mgmt(b, R2_FE_SG);
+		r2.closed &= r2_call(apps, APM_CMD_GRAPH_STOP_, b, n, "GRAPH_STOP stream 0x4003");
+	}
+	if (r2.fe_open) {
+		n = au_mgmt(b, R2_FE_SG);
+		r2.closed &= r2_call(apps, APM_CMD_GRAPH_CLOSE_, b, n, "GRAPH_CLOSE stream 0x4003");
+	}
+	for (int i = 0; i < 100 && !g_broken; i++) {
+		g_pump();
+		sleep_ms(1);
+	}
+	while (mic_rd_out != mic_rd_in) {               /* 17r2c: each late answer shown (17r2b: 8 came back at the stop) */
+		uint32_t k = mic_rd_out % 32;
+
+		if (r2.late++ < 8) {
+			mic("r2: answer after the stop: token %u, address %#x_%08x, status %#x, %u bytes at offset %u, %u frames, "
+			    "flags %#x\n", mic_rd_ring[k].token, mic_rd_ring[k].msw, mic_rd_ring[k].lsw, mic_rd_ring[k].status,
+			    mic_rd_ring[k].size, mic_rd_ring[k].offset, mic_rd_ring[k].frames, mic_rd_ring[k].flags);
+		}
+		mic_rd_out++;
+	}
+	if (r2.c2) {
+		c2_fault_report("r2 before the unmap");
+		if (r2.mapped) {
+			c2_dsp_unmap(apps, r2.handle);
+		}
+		c2_teardown();
+		bzero((void *)c2.buf, C2_BUF_SIZE);     /* nothing of the capture kept in memory */
+		c2_clean(c2.buf, C2_BUF_SIZE);
+	}
+	c2_map_token = 1;
+	mic("r2: %u buffers metered (%u expected in %u s), %u not as expected, %u answers after the stop, %u other DSP "
+	    "packets while capturing; overall peak %u (%d dBFS), RMS %u (%d dBFS); graphs %s; buffer unmapped, SMMU put "
+	    "back, buffer zeroed\n", r2.got, r2.want, r2.secs, r2.bad, r2.late, r2.gpr_lines, r2.pk_all, mic_dbfs(r2.pk_all),
+	    r2.cnt_all ? mic_isqrt(r2.sumsq_all / r2.cnt_all) : 0,
+	    mic_dbfs(r2.cnt_all ? mic_isqrt(r2.sumsq_all / r2.cnt_all) : 0), r2.closed ? "stopped and closed" :
+	    "NOT ALL CLOSED (see above)");
+	ok = metered && r2.closed && r2.bad == 0 && r2.got >= r2.want * 9 / 10;
+	if (!ok && r2.why == NULL) {
+		r2.why = !metered ? "not metered" : r2.got < r2.want * 9 / 10 ? "fewer buffers than real time" : r2.bad ?
+		    "unexpected read answers" : "a graph did not stop / close cleanly";
+	}
+	mic("r2 %s%s\n", ok ? "PASS: the DSP captured the microphone through TX_CODEC_DMA_TX_3 into our buffer (level meter "
+	    "above)" : "FAIL: ", ok ? "" : r2.why);
+	return ok;
+}
+
+/*
+ * 17r2c: tx_macro_component_probe's init, which 17r1c / 17r2b never made (Linux makes it once when the card binds, and
+ * tx_macro_mclk_enable's regcache_sync writes it to the hardware again on every MCLK enable): TX0_TX_PATH_SEC7 [5:0] =
+ * 0x0a (DEC0's register; reset value 0x25), CDC_TX_TOP_CSR_SWR_AMIC0_CTL / AMIC1_CTL = CDC_TX_SWR_MIC_CLK_DEFAULT 0
+ * ("Enable swr mic0 and mic1 clock" -- the clock of the SoundWire AMIC inputs the SWR_MIC0 mux feeds DEC0 from).
+ * Found values back at the end.
+ */
+#define TXM_SWR_AMIC0_CTL               0x0d0u
+#define TXM_SWR_AMIC1_CTL               0x0d4u
+#define TXM_TX0_PATH_SEC7               0x42cu
+static struct {
+	uint32_t sec7, amic0, amic1, va_mic[3];
+	bool done, va_done;
+} mp;
+
+/*
+ * 17r2d: va_macro_probe's init, also never made by our kits (17r2c: still no buffer). This DT's VA macro is
+ * "qcom,kaanapali-lpass-va-macro", "qcom,sm8550-lpass-va-macro" -> sm8550_va_data: has_swr_master = true, so Linux
+ * sets at probe "default CLK div to 1": CDC_VA_TOP_CSR_SWR_MIC_CTL0 / CTL1 / CTL2 (VA +0xd0 / +0xd4 / +0xd8)
+ * [mask 0xee] = 0xcc (CDC_VA_SWR_MIC_CLK_SEL_0_1_DIV1; reset / regcache default 0xee), and regcache_sync_region writes
+ * them again on every va_macro_mclk_enable (fsgen). They are the clock selects of the SoundWire mic inputs (two per
+ * register: SWR_MIC0 / 1 in CTL0, the input DEC0 is muxed to); 0xee = both fields 0b111, the value no Linux path ever
+ * leaves on this board. Found values back at the end. (va_macro_probe's VA SoundWire reset pulse is not made: this
+ * board has no VA SoundWire master in use, and level E already runs the VA SWR clock.)
+ */
+static bool
+mic_va_probe_init(const struct mic_blk *va)
+{
+	static const char *const nm[3] = { "VA SWR_MIC_CTL0 [0xee] = 0xcc DIV1 (va_macro_probe)",
+		"VA SWR_MIC_CTL1 [0xee] = 0xcc DIV1 (va_macro_probe)", "VA SWR_MIC_CTL2 [0xee] = 0xcc DIV1 (va_macro_probe)" };
+	bool ok = true;
+
+	if (va == NULL || va->va == 0) {
+		mic("r1c: the VA macro is not mapped (icemic_fsgen=0): VA SWR_MIC_CTL0-2 NOT set (Linux sets them at probe)\n");
+		return true;
+	}
+	for (uint32_t i = 0; i < 3; i++) {
+		mp.va_mic[i] = mic_rd(va, 0xd0u + 4u * i);
+	}
+	mp.va_done = true;
+	mic("r1c: vamacro (va_macro_probe init) found: SWR_MIC_CTL0 %#x, CTL1 %#x, CTL2 %#x, SWR_CTRL %#x\n", mp.va_mic[0],
+	    mp.va_mic[1], mp.va_mic[2], mic_rd(va, 0xdc));
+	for (uint32_t i = 0; i < 3; i++) {
+		ok &= mic_upd(va, 0xd0u + 4u * i, nm[i], 0xee, 0xcc);
+	}
+	return ok;
+}
+
+static void
+mic_va_probe_back(const struct mic_blk *va)
+{
+	if (!mp.va_done) {
+		return;
+	}
+	for (uint32_t i = 3; i-- > 0;) {
+		(void)mic_upd(va, 0xd0u + 4u * i, "VA SWR_MIC_CTLn back", 0xff, mp.va_mic[i]);
+	}
+	mp.va_done = false;
+}
+
+static bool
+mic_txm_probe_init(const struct mic_blk *txm)
+{
+	bool ok = true;
+
+	mp.sec7 = mic_rd(txm, TXM_TX0_PATH_SEC7);
+	mp.amic0 = mic_rd(txm, TXM_SWR_AMIC0_CTL);
+	mp.amic1 = mic_rd(txm, TXM_SWR_AMIC1_CTL);
+	mp.done = true;
+	mic("r1c: txmacro (component probe init) found: TX0_PATH_SEC7 %#x, SWR_AMIC0_CTL %#x, SWR_AMIC1_CTL %#x\n", mp.sec7,
+	    mp.amic0, mp.amic1);
+	ok &= mic_upd(txm, TXM_TX0_PATH_SEC7, "TX0_PATH_SEC7 [5:0] = 0x0a (tx_macro_component_probe)", 0x3f, 0x0a);
+	ok &= mic_wr(txm, TXM_SWR_AMIC0_CTL, "SWR_AMIC0_CTL = 0 (swr mic0 clock, tx_macro_component_probe)", 0, 0xff);
+	ok &= mic_wr(txm, TXM_SWR_AMIC1_CTL, "SWR_AMIC1_CTL = 0 (swr mic1 clock, tx_macro_component_probe)", 0, 0xff);
+	return ok;
+}
+
+static void
+mic_txm_probe_back(const struct mic_blk *txm)
+{
+	if (!mp.done) {
+		return;
+	}
+	(void)mic_wr(txm, TXM_SWR_AMIC1_CTL, "SWR_AMIC1_CTL back", mp.amic1, 0xff);
+	(void)mic_wr(txm, TXM_SWR_AMIC0_CTL, "SWR_AMIC0_CTL back", mp.amic0, 0xff);
+	(void)mic_upd(txm, TXM_TX0_PATH_SEC7, "TX0_PATH_SEC7 back", 0xff, mp.sec7);
+	mp.done = false;
+}
+
+/* 17r1c (+ 17r2 interleaved in Linux's order): see the comments above mic_sdw_w and r2 */
+static bool
+mic_r1c(const struct mic_blk *swr, const struct mic_blk *txm, const struct mic_blk *va, unsigned dev, uint32_t cmd,
+    struct gchan *apps)
+{
+	uint32_t params = mic_rd(swr, SWR_COMP_PARAMS), din = (params >> 5) & 0x1f, hold = 1000, bc1 = 1, svc = 0;
+	unsigned bad0 = mic_bad;
+	int32_t f_ch1;
+	uint64_t t_en;
+	bool ok = true, stream = false, dec = false, down, r2_ok = false, swr_tried = false, dec_tried = false;
+	bool dsp = false, dsp_tried = false, metered = false, hpf_done = false;
+
+	PE_parse_boot_argn("icemic_hold", &hold, sizeof(hold));
+	PE_parse_boot_argn("icemic_bc1", &bc1, sizeof(bc1));
+	PE_parse_boot_argn("icemic_svc", &svc, sizeof(svc));
+	if (svc && cmd < 4) {
+		mic("r2: service REFUSED: icemic_svc=1 runs only on icemic_cmd=4's path (here icemic_cmd=%u)\n", cmd);
+		svc = 0;
+	}
+	if (hold < 300 || hold > 5000) {
+		hold = 1000;
+	}
+	mic_tag = "r1c";
+	mic("r1c: the SoundWire capture stream for ADC1 (WCD9395 TX port 1 -> swr2 port 2, lane 2) and the TX macro's DEC0 "
+	    "(SWR_MIC0)%s; swr2 COMP_PARAMS %#x (%u din ports)\n", cmd >= 4 ? ", with 17r2c's DSP graphs in Linux's DPCM order" :
+	    ", held", params, din);
+	if (din < MIC_M_PORT) {
+		mic("r1c REFUSED: swr2 has no port %u (din ports %u): nothing written\n", MIC_M_PORT, din);
+		return false;
+	}
+	bzero(&mr, sizeof(mr));
+	mr.bc1 = bc1 != 0;
+	mr.curr = mr.start = mic_rd(swr, SWR_MCP_STATUS) & 1;
+	for (uint32_t b = 0; b < 2; b++) {
+		mr.f_pc[b] = mic_rd(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, b));
+		mr.f_pc2[b] = mic_rd(swr, SWR_DP_PORT_CTRL_2(MIC_M_PORT, b));
+		mr.f_hc[b] = mic_rd(swr, SWR_DP_HCTRL(MIC_M_PORT, b));
+		mr.f_frame[b] = mic_rd(swr, SWR_FRAME_CTRL_BANK(b));
+	}
+	mr.f_bc1 = mic_rd(swr, SWR_DP_BLOCK_CTRL_1_NUM0);
+	mic("r1c: swr2 found: bank %u, DP2 PORT_CTRL %#x / %#x, PORT_CTRL_2 %#x / %#x, HCTRL %#x / %#x, BLOCK_CTRL_1(2) %#x, "
+	    "0x102c %#x, FRAME_CTRL_BANK %#x / %#x, INT_STATUS %#x; Linux's 0x102c write %s\n", mr.curr, mr.f_pc[0], mr.f_pc[1],
+	    mr.f_pc2[0], mr.f_pc2[1], mr.f_hc[0], mr.f_hc[1], mic_rd(swr, 0x122c), mr.f_bc1, mr.f_frame[0], mr.f_frame[1],
+	    mic_rd(swr, SWR_INT_STATUS), mr.bc1 ? "ON" : "OFF (icemic_bc1=0)");
+	f_ch1 = mic_cmd_read(swr, dev, 0x300e);
+	if (f_ch1 < 0) {
+		mic("r1c REFUSED: ANA_TX_CH1 not read: nothing written\n");
+		return false;
+	}
+	/* the TX macro's component-probe init (card bind), the mixer control (a), the TX macro's kcontrols + hw_params (b) */
+	ok &= mic_va_probe_init(va);
+	ok &= mic_txm_probe_init(txm);
+	mic_gain_args();
+	mic_gain_log(swr, txm, dev, "found");
+	mic("gain: wanted: ADC1 Volume %u (+%u.%u dB analog), TX_DEC0 Volume %u (+%u dB), MICBIAS1 2.7 V; Linux 0.28-4's UCM: "
+	    "ADC1 14 (+21 dB), TX_DEC0 84 (0 dB); Linux 0.27r6 - 0.28-3 / stock's codec + DSP total: TX_DEC0 98 (+14 dB); "
+	    "capped at stock (ADC1 <= 14, TX_DEC0 <= +14 dB)\n", mic_adcvol, mic_adcvol * 15 / 10, mic_adcvol * 15 % 10,
+	    84 + mic_decvol, mic_decvol);
+	ok &= mic_cdc_field(swr, dev, 0x300e, mic_adcvol_name, 0x1f, (uint8_t)mic_adcvol);
+	ok &= mic_dec_mux(txm);
+	/* [17r2c] startup: map + both GRAPH_OPENs (pcm_new / q6apm_lpass_dai_startup / q6apm_dai_open: before prepare) */
+	if (cmd >= 4) {
+		if (ok && mic_cdc_bad == 0 && mic_bad == bad0) {
+			dsp_tried = true;
+			dsp = r2_startup(apps, svc != 0);
+		} else {
+			mic("r2 REFUSED: 17r1c's set-up did not read back as wanted: no SMMU write, no graph\n");
+		}
+	}
+	/* c: the BE link's prepare: qcom_snd_sdw_prepare (sdw_prepare_stream + sdw_enable_stream) */
+	if (ok) {
+		swr_tried = true;
+		stream = mic_swr_up(swr, dev);
+		mic("r1c: the SoundWire stream %s (bank %u)\n", stream ? "PREPARED AND ENABLED: port 2 / DP1 on" : "NOT UP",
+		    mr.curr);
+	}
+	/* [17r2c] q6apm_lpass_dai_prepare */
+	if (dsp) {
+		dsp = stream && r2_be_prepare(apps);
+	}
+	/* d: the DAPM stream event (decimator, then the codec's ADC1_MIXER tx_swr_ctrl), then mute_stream(0) */
+	if (ok && stream) {
+		dec_tried = true;
+		dec = mic_dec_up(txm, va);
+		dec &= mic_cdc_field(swr, dev, 0x3405, "SWR_TX_CLK_RATE current bank 9.6 MHz (tx_swr_ctrl)", mr.curr ? 0xf0 : 0x0f,
+		    0);
+		dec &= mic_cdc_field(swr, dev, 0x3405, "SWR_TX_CLK_RATE other bank 9.6 MHz (tx_swr_ctrl)", mr.curr ? 0x0f : 0xf0,
+		    0);
+		dec &= mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL PGA_MUTE 0 (tx_macro_digital_mute 0)", 0x10, 0);
+		mic_gain_log(swr, txm, dev, "as written (decimator running, unmuted)");
+	}
+	t_en = now_us();
+	if (cmd >= 4) {
+		/* [17r2c] the front end's prepare + trigger START, then the meter (the HPF work inside it) */
+		if (dsp && dec && mic_cdc_bad == 0 && mic_bad == bad0 && mr.switch_bad == 0) {
+			if (r2_fe_start(apps)) {
+				metered = r2_meter(apps, txm, t_en, &hpf_done, &dec);
+			}
+			mic_r1c_status(swr, txm, dev, "after the meter");
+			mic_gain_log(swr, txm, dev, "after the meter");
+		} else if (dsp_tried) {
+			mic("r2: the stream / decimator / back end did not come up as wanted: no front end, no meter\n");
+		}
+		if (dsp_tried) {
+			r2_ok = r2_close(apps, metered);
+		}
+	} else if (ok && stream && dec) {
+		while (now_us() - t_en < 300000ull) {
+			g_pump();
+			sleep_ms(5);
+		}
+		dec &= mic_dec_hpf_work(txm);
+		while (now_us() - t_en < (uint64_t)hold * 1000ull) {
+			g_pump();
+			sleep_ms(5);
+		}
+		mic_r1c_status(swr, txm, dev, "held");
+	}
+	/* f: down (each part only if its up part was started) */
+	if (dec_tried) {
+		(void)mic_upd(txm, TXM_TX0_PATH_CTL, "TX0_PATH_CTL PGA_MUTE 1 (tx_macro_digital_mute 1)", 0x10, 0x10);
+	}
+	down = swr_tried ? mic_swr_down(swr, dev) : true;
+	if (dec_tried) {
+		(void)mic_cdc_field(swr, dev, 0x3405, "SWR_TX_CLK_RATE other bank (tx_swr_ctrl POST_PMD)", mr.curr ? 0x0f :
+		    0xf0, 0);
+		(void)mic_cdc_field(swr, dev, 0x3405, "SWR_TX_CLK_RATE current bank (tx_swr_ctrl POST_PMD)", mr.curr ? 0xf0 :
+		    0x0f, 0);
+	}
+	mic_dec_down(txm, dec_tried);
+	mic_txm_probe_back(txm);
+	mic_va_probe_back(va);
+	(void)mic_cdc_field(swr, dev, 0x300e, "ANA_TX_CH1 ADC1 Volume back", 0x1f, (uint8_t)(f_ch1 & 0x1f));
+	for (uint32_t b = 0; b < 2 && swr_tried; b++) {
+		char n[48];
+
+		snprintf(n, sizeof(n), "DP2 PORT_CTRL_BANK(%u) back", b);
+		(void)mic_wr(swr, SWR_DP_PORT_CTRL(MIC_M_PORT, b), n, mr.f_pc[b], 0xffffffffu);
+		snprintf(n, sizeof(n), "DP2 PORT_CTRL_2_BANK(%u) back", b);
+		(void)mic_wr(swr, SWR_DP_PORT_CTRL_2(MIC_M_PORT, b), n, mr.f_pc2[b], 0xff);
+		snprintf(n, sizeof(n), "DP2 PORT_HCTRL_BANK(%u) back", b);
+		(void)mic_wr(swr, SWR_DP_HCTRL(MIC_M_PORT, b), n, mr.f_hc[b], 0xff);
+	}
+	if (mr.bc1 && swr_tried) {
+		(void)mic_wr(swr, SWR_DP_BLOCK_CTRL_1_NUM0, "0x102c back", mr.f_bc1, 0);
+		mic("r1c:   swr2 0x102c reads %#x (found %#x)\n", mic_rd(swr, SWR_DP_BLOCK_CTRL_1_NUM0), mr.f_bc1);
+	}
+	if (!swr_tried) {
+		/* (no bank switch was made: the frame control registers were not written) */
+	} else if (mr.curr == mr.start) {
+		char n[48];
+
+		snprintf(n, sizeof(n), "MCP_FRAME_CTRL_BANK(%u) back (the idle bank)", mr.start ^ 1u);
+		(void)mic_wr(swr, SWR_FRAME_CTRL_BANK(mr.start ^ 1u), n, mr.f_frame[mr.start ^ 1u], 0xff);
+	} else {
+		mic("r1c: the bus ended in bank %u, not %u: MCP_FRAME_CTRL_BANK left as the switches set them\n", mr.curr,
+		    mr.start);
+	}
+	mic_r1c_status(swr, txm, dev, "after the down path");
+	ok = ok && stream && dec && down && mic_cdc_bad == 0 && mic_bad == bad0 && mr.switch_bad == 0 &&
+	    mr.curr == mr.start;
+	mic("r1c %s: %u codec / SoundWire writes (incl. the 17r1b up list), %u not as wanted; %u bank switches, %u not done; "
+	    "%u MMIO writes not as wanted in 17r1c; the bus back in bank %u (started %u)%s\n", ok ? "PASS" : "FAIL",
+	    mic_cdc_writes, mic_cdc_bad, mr.switches, mr.switch_bad, mic_bad - bad0, mr.curr, mr.start, cmd >= 4 ? (r2_ok ?
+	    "; 17r2 PASS" : "; 17r2 NOT PASSED") : "");
+	return ok;
+}
+
+static const unsigned mic_lpi_pins[4] = { 0, 1, 2, 14 };
+static const uint32_t mic_lpi_pull[4] = { 0, 2, 2, 2 };       /* clock: bias off; data: bus-hold (keeper) */
+
+static bool
+mic_level_e(struct gchan *apps)
+{
+	struct mic_blk txm = { "txmacro", MIC_TXM_PHYS, 0 }, va = { "vamacro", MIC_VA_PHYS, 0 },
+	    swr = { "swr2", MIC_SWR_PHYS, 0 }, lpi = { "lpi_tlmm", MIC_LPI_PHYS, 0 };
+	uint32_t fsgen = 0, pins = 1, poll_ms = 500, version = 0, mcp_status, slv, last_slv = 0xffffffffu, lpi_found[4] = { 0 };
+	uint32_t f_txm[4] = { 0 }, f_va[4] = { 0 }, f_comp_cfg = 0, f_ee = 0, f_fifo_cfg = 0, f_enum = 0, f_frame = 0,
+	    f_mcp_cfg = 0, f_clk = 0, f_cpu_en = 0, f_link = 0;
+	bool v_macro = false, v_dcodec = false, v_mclk = false, clocks = false, sane = false, inited = false, frames = false,
+	    pins_set = false, found_tx = false, put_back = true, running = false;
+	unsigned attached = 0, seen = 0;
+	vm_offset_t tlmm161;
+	uint64_t t0;
+	uint32_t power = 0, f161_ctl = 0, f161_io = 0, cmd = 0;
+	unsigned tx_dev = 0;
+	bool powered = false;
+
+	PE_parse_boot_argn("icemic_power", &power, sizeof(power));
+	PE_parse_boot_argn("icemic_cmd", &cmd, sizeof(cmd));
+	if (cmd && !power) {
+		mic("r1a: icemic_cmd=1 needs icemic_power=1 (the codec out of reset): not done\n");
+		cmd = 0;
+	}
+	PE_parse_boot_argn("icemic_fsgen", &fsgen, sizeof(fsgen));
+	PE_parse_boot_argn("icemic_pins", &pins, sizeof(pins));
+	PE_parse_boot_argn("icemic_ms", &poll_ms, sizeof(poll_ms));
+	if (poll_ms < 50 || poll_ms > 2000) {
+		poll_ms = 500;
+	}
+	mic_writes = mic_bad = 0;
+	mark(M_AUDIO, MARK_BUSY);
+	mic("level E: the microphones' bus (swr2 + the WCD9395 TX device), reads beyond the votes only; fsgen %s, pads %s, "
+	    "poll %u ms; no codec register, no capture, no SMMU\n", fsgen ? "ON (icemic_fsgen=1)" : "off", pins ? "swr_tx" :
+	    "untouched (icemic_pins=0)", poll_ms);
+
+	/* the codec's reset pad (main TLMM, not a reserved range): read; [icemic_power=1] the codec powered up */
+	tlmm161 = mic_map(MIC_TLMM161_PAGE, 0x4000);
+	if (tlmm161 != 0) {
+		uint32_t ctl = rd(tlmm161 + 0x1000), io = rd(tlmm161 + 0x1004);
+
+		mic("WCD9395 reset gpio161 (%s): ctl %#x (function %u, pull %u, %u mA, OE %u), io %#x (in %u, out %u): "
+		    "the codec is %s\n", power ? "icemic_power=1" : "read only", ctl, (ctl >> 2) & 0xf, ctl & 3,
+		    ((ctl >> 6) & 7) * 2 + 2, (ctl >> 9) & 1, io, io & 1, (io >> 1) & 1, (io & 1) ? "OUT OF RESET (pad high)" :
+		    "HELD IN RESET (pad low): no device can attach");
+		if (power) {
+			if (io & 1) {
+				mic("power: the codec is already out of reset: icemic_power does nothing (no vote, no pad write)\n");
+			} else {
+				powered = mic_codec_power(tlmm161, &f161_ctl, &f161_io);
+			}
+		}
+		if (!powered) {
+			ml_io_unmap(tlmm161, 0x4000);
+			tlmm161 = 0;
+		}
+	}
+
+	/* 1: the PRM votes */
+	v_macro = mic_prm(apps, true, PARAM_ID_RSC_HW_CORE, MIC_HW_LPASS, 0, "LPASS_HW_MACRO_VOTE (hw block 1)") == 0;
+	if (v_macro) {
+		v_dcodec = mic_prm(apps, true, PARAM_ID_RSC_HW_CORE, MIC_HW_DCODEC, 0, "LPASS_HW_DCODEC_VOTE (hw block 2)") == 0;
+	}
+	if (v_dcodec) {
+		v_mclk = mic_prm(apps, true, PARAM_ID_RSC_AUDIO_HW_CLK, MIC_CLK_TX_CORE_MCLK, MIC_MCLK_HZ,
+		    "TX_CORE_MCLK 0x30c 19.2 MHz") == 0;
+	}
+	if (!v_mclk) {
+		mic("E FAIL: a PRM vote was not granted: no LPASS register touched\n");
+		goto release;
+	}
+	txm.va = mic_map(MIC_TXM_PHYS, 0x4000);
+	swr.va = mic_map(MIC_SWR_PHYS, 0x10000);
+	lpi.va = pins ? mic_map(MIC_LPI_PHYS, 0x10000) : 0;
+	va.va = fsgen ? mic_map(MIC_VA_PHYS, 0x4000) : 0;
+	if (txm.va == 0 || swr.va == 0 || (pins && lpi.va == 0) || (fsgen && va.va == 0)) {
+		mic("E FAIL: no mapping: no LPASS register touched\n");
+		goto unmap;
+	}
+
+	/* 2: [the VA macro's fsgen] */
+	if (fsgen) {
+		f_va[0] = mic_rd(&va, TXM_MCLK_CONTROL);
+		f_va[1] = mic_rd(&va, TXM_FS_CNT_CONTROL);
+		f_va[2] = mic_rd(&va, TXM_SWR_CONTROL);
+		f_va[3] = mic_rd(&va, TXM_TOP_CFG0);
+		mic("vamacro found: MCLK_CONTROL %#x, FS_CNT_CONTROL %#x, SWR_CONTROL %#x, TOP_CFG0 %#x\n", f_va[0], f_va[1],
+		    f_va[2], f_va[3]);
+		(void)mic_upd(&va, TXM_MCLK_CONTROL, "MCLK_CONTROL", 0x1, 0x1);
+		(void)mic_wr(&va, TXM_FS_CNT_CONTROL, "FS_CNT_CONTROL (enable + counter clear)", (f_va[1] & ~3u) | 3u, 0x1);
+		(void)mic_upd(&va, TXM_FS_CNT_CONTROL, "FS_CNT_CONTROL (clear off)", 0x3, 0x1);
+		(void)mic_upd(&va, TXM_TOP_CFG0, "TOP_CFG0 FS_BROADCAST_EN", 0x2, 0x2);
+		(void)mic_upd(&va, TXM_SWR_CONTROL, "SWR_CONTROL clock", 0x1, 0x1);
+	}
+
+	/* 3: the TX macro (probe, then swr2's iface clock) */
+	f_txm[0] = mic_rd(&txm, TXM_MCLK_CONTROL);
+	f_txm[1] = mic_rd(&txm, TXM_FS_CNT_CONTROL);
+	f_txm[2] = mic_rd(&txm, TXM_SWR_CONTROL);
+	f_txm[3] = mic_rd(&txm, TXM_FREQ_MCLK);
+	mic("txmacro found: MCLK_CONTROL %#x, FS_CNT_CONTROL %#x, SWR_CONTROL %#x, FREQ_MCLK %#x, TOP_CFG0 %#x\n", f_txm[0],
+	    f_txm[1], f_txm[2], f_txm[3], mic_rd(&txm, TXM_TOP_CFG0));
+	(void)mic_upd(&txm, TXM_SWR_CONTROL, "SWR_CONTROL reset on (probe)", 0x2, 0x2);
+	(void)mic_upd(&txm, TXM_SWR_CONTROL, "SWR_CONTROL clock on (probe)", 0x1, 0x1);
+	(void)mic_upd(&txm, TXM_SWR_CONTROL, "SWR_CONTROL reset off (probe)", 0x2, 0x0);
+	/* (17q3 / 17r1a: bit 0 always reads back 0 -- write-only here; the bus ran regardless: not checked) */
+	(void)mic_wr(&txm, TXM_FREQ_MCLK, "FREQ_MCLK bit 0 (swclk gate, write-only)", f_txm[3] | 1u, 0);
+	(void)mic_upd(&txm, TXM_MCLK_CONTROL, "MCLK_CONTROL enable (swclk gate)", 0x1, 0x1);
+	(void)mic_upd(&txm, TXM_FS_CNT_CONTROL, "FS_CNT_CONTROL enable (swclk gate)", 0x1, 0x1);
+	(void)mic_upd(&txm, TXM_SWR_CONTROL, "SWR_CONTROL clock on (swclk gate)", 0x1, 0x1);
+	clocks = (mic_rd(&txm, TXM_MCLK_CONTROL) & 1) && (mic_rd(&txm, TXM_SWR_CONTROL) & 3) == 1;
+	if (!clocks) {
+		mic("E FAIL: the TX macro's MCLK / SoundWire clock did not read back enabled: swr2 not read\n");
+		goto put_back;
+	}
+
+	/* 4: swr2: one version read; the rest only if it is v2.x */
+	version = mic_rd(&swr, SWR_HW_VERSION);
+	sane = (version >> 24) == 2;
+	mic("swr2 COMP_HW_VERSION %#x: %s\n", version, sane ? "v2.x, as the DT's soundwire-v2.2.0: SANE" :
+	    "NOT a v2.x master: nothing more read or written on swr2");
+	if (!sane) {
+		goto put_back;
+	}
+	f_comp_cfg = mic_rd(&swr, SWR_COMP_CFG);
+	f_ee = mic_rd(&swr, SWR_LINK_MANAGER_EE);
+	f_fifo_cfg = mic_rd(&swr, SWR_CMD_FIFO_CFG);
+	f_enum = mic_rd(&swr, SWR_ENUMERATOR_CFG);
+	f_frame = mic_rd(&swr, SWR_FRAME_CTRL_BANK0);
+	f_mcp_cfg = mic_rd(&swr, SWR_MCP_CFG);
+	f_cpu_en = mic_rd(&swr, SWR_INT_CPU_EN);
+	f_clk = mic_rd(&swr, SWR_CLK_CTRL);
+	f_link = mic_rd(&swr, SWR_LINK_STATUS);
+	mcp_status = mic_rd(&swr, SWR_MCP_STATUS);
+	mic("swr2 found: COMP_CFG %#x, LINK_MANAGER_EE %#x, COMP_PARAMS %#x, MASTER_ID %#x, CMD_FIFO_CFG %#x, ENUMERATOR_CFG "
+	    "%#x, FRAME_CTRL_BANK0 %#x, MCP_CFG %#x, MCP_STATUS %#x (bank %u), MCP_SLV_STATUS %#x, INT_STATUS %#x, "
+	    "INT_CPU_EN %#x, CMD_FIFO_STATUS %#x, CLK_CTRL %#x, LINK_STATUS %#x\n", f_comp_cfg, f_ee,
+	    mic_rd(&swr, SWR_COMP_PARAMS), mic_rd(&swr, SWR_COMP_MASTER_ID), f_fifo_cfg, f_enum, f_frame, f_mcp_cfg,
+	    mcp_status, mcp_status & 1, mic_rd(&swr, SWR_MCP_SLV_STATUS), mic_rd(&swr, SWR_INT_STATUS), f_cpu_en,
+	    mic_rd(&swr, SWR_CMD_FIFO_STATUS), f_clk, f_link);
+	running = (f_comp_cfg & 1) || (f_link & 1) || (f_clk & 1);
+	if (running) {
+		mic("swr2 is ALREADY RUNNING (someone else's set-up): no init, no write on swr2; its devices read only\n");
+	}
+
+	if (pins && !running) {
+		bool usable = true;
+
+		for (unsigned i = 0; i < 4; i++) {
+			uint32_t fn;
+
+			lpi_found[i] = rd(lpi.va + 0x1000UL * mic_lpi_pins[i]);
+			fn = (lpi_found[i] >> 2) & 0xf;
+			usable &= fn == 0 || fn == 1;
+		}
+		mic("lpi_tlmm found: gpio0 %#x, gpio1 %#x, gpio2 %#x, gpio14 %#x%s\n", lpi_found[0], lpi_found[1], lpi_found[2],
+		    lpi_found[3], usable ? "" : ": a pad has another function: pads LEFT ALONE");
+		if (usable) {
+			for (unsigned i = 0; i < 4; i++) {
+				char reg[40];
+				/* set_mux: function 1 (swr_tx_*); config_set: pull, 2 mA (0), OE 0; slew 1 at bit 11 (same register) */
+				uint32_t v = (lpi_found[i] & ~(0x3ffu | 3u << 11)) | mic_lpi_pull[i] | 1u << 2 | 1u << 11;
+
+				snprintf(reg, sizeof(reg), "gpio%u CFG -> swr_tx_%s", mic_lpi_pins[i], i == 0 ? "clk" : "data");
+				(void)mic_wr(&lpi, 0x1000u * mic_lpi_pins[i], reg, v, 0x3ffu | 3u << 11);
+			}
+			pins_set = true;
+		}
+	}
+
+	if (!running) {
+		/* qcom_swrm_init, v2 (no audio_cgcr reset in the DT; no interrupt mask register on v2) */
+		(void)mic_wr(&swr, SWR_FRAME_CTRL_BANK0, "MCP_FRAME_CTRL_BANK(0) rows 50 (index 1) cols 16 (index 7)",
+		    1u << 3 | 7u, 0xff);
+		(void)mic_wr(&swr, SWR_ENUMERATOR_CFG, "ENUMERATOR_CFG auto enumeration", 1, 0x1);
+		(void)mic_wr(&swr, SWR_MCP_CFG, "MCP_CFG max no-ping commands 0x1f", (f_mcp_cfg & ~(0x1fu << 17)) | 0x1fu << 17,
+		    0x1fu << 17);
+		(void)mic_wr(&swr, SWR_LINK_MANAGER_EE, "LINK_MANAGER_EE = CPU", 1, 0x3);
+		(void)mic_wr(&swr, SWR_CLK_CTRL, "V2 CLK_CTRL clock start", 1, 0x1);
+		(void)mic_wr(&swr, SWR_CMD_FIFO_CFG, "CMD_FIFO_CFG 7 retries | continue on ignore", 7u | 1u << 31,
+		    0x80000007u);
+		(void)mic_wr(&swr, SWR_COMP_CFG, "COMP_CFG enable", 1, 0x3);
+		(void)mic_wr(&swr, SWR_COMP_CFG, "COMP_CFG irq pulse", 2, 0x3);
+		(void)mic_wr(&swr, SWR_INT_CLEAR, "INTERRUPT_CLEAR all", 0xffffffffu, 0);
+		mic("  swr2 INTERRUPT_CPU_EN left at %#x (Linux: 0x1ffff; here no handler: status polled)\n", f_cpu_en);
+		(void)mic_wr(&swr, SWR_COMP_CFG, "COMP_CFG irq pulse | enable", 3, 0x3);
+		inited = true;
+		for (unsigned i = 0; i <= 100 && !frames; i++) {   /* swrm_wait_for_frame_gen_enabled: 100 x 0.5 ms */
+			frames = mic_rd(&swr, SWR_LINK_STATUS) & 1;
+			if (!frames) {
+				delay_for_interval(500, NSEC_PER_USEC);
+			}
+		}
+		mic("swr2 frame generator %s (LINK_STATUS %#x), COMP_PARAMS %#x, MCP_STATUS %#x, INT_STATUS %#x\n", frames ?
+		    "ENABLED: THE BUS RUNS" : "NOT ENABLED after 50 ms", mic_rd(&swr, SWR_LINK_STATUS),
+		    mic_rd(&swr, SWR_COMP_PARAMS), mic_rd(&swr, SWR_MCP_STATUS), mic_rd(&swr, SWR_INT_STATUS));
+	} else {
+		frames = true;
+	}
+
+	/* the enumeration: auto enumeration assigns device numbers; we read the attached devices' ids */
+	t0 = now_us();
+	while (now_us() - t0 < poll_ms * 1000ull && !g_broken) {
+		slv = mic_rd(&swr, SWR_MCP_SLV_STATUS);
+		if (slv != last_slv) {
+			mic("swr2 MCP_SLV_STATUS %#x at %llu ms (INT_STATUS %#x)\n", slv, (now_us() - t0) / 1000,
+			    mic_rd(&swr, SWR_INT_STATUS));
+			last_slv = slv;
+		}
+		for (unsigned m = 1; m <= 11; m++) {
+			uint32_t st = (slv >> (2 * m)) & 3, id1, id2;
+			uint64_t addr;
+
+			if (st == 0 || (seen & (1u << m))) {
+				continue;
+			}
+			seen |= 1u << m;
+			attached++;
+			id1 = mic_rd(&swr, SWR_DEV_ID_1(m));
+			id2 = mic_rd(&swr, SWR_DEV_ID_2(m));
+			addr = (uint64_t)((id2 >> 8) & 0xff) | (uint64_t)(id2 & 0xff) << 8 | (uint64_t)((id1 >> 24) & 0xff) << 16 |
+			    (uint64_t)((id1 >> 16) & 0xff) << 24 | (uint64_t)((id1 >> 8) & 0xff) << 32 | (uint64_t)(id1 & 0xff) << 40;
+			{
+				uint32_t sver = (uint32_t)(addr >> 44) & 0xf, uniq = (uint32_t)(addr >> 40) & 0xf,
+				    mfg = (uint32_t)(addr >> 24) & 0xffff, part = (uint32_t)(addr >> 8) & 0xffff,
+				    cls = (uint32_t)addr & 0xff;
+				bool tx = mfg == WCD_SDW_MFG && part == WCD_SDW_PART && uniq == WCD_SDW_TX_UNIQUE;
+
+				found_tx |= tx;
+				if (tx) {
+					tx_dev = m;
+				}
+				mic("swr2 device %u: status %u (%s), DEV_ID_1 %#x DEV_ID_2 %#x -> SoundWire %u, unique %u, "
+				    "manufacturer %#06x, part %#06x, class %#x%s\n", m, st, st == 1 ? "attached" : st == 2 ? "alert" :
+				    "reserved", id1, id2, sver, uniq, mfg, part, cls, tx ? ": THE WCD9395 TX DEVICE (sdw20217010e00 unique 3)" :
+				    "");
+			}
+		}
+		if (found_tx && now_us() - t0 > 100000ull) {
+			break;
+		}
+		g_pump();
+		sleep_ms(2);
+	}
+	mic("enumeration after %llu ms: %u device(s) attached; WCD9395 TX %s\n", (now_us() - t0) / 1000, attached,
+	    found_tx ? "FOUND" : "NOT FOUND");
+	/* 17r1a (icemic_cmd=1): the codec's registers read over swr2's command FIFO -- reads only */
+	if (cmd && found_tx && tx_dev != 0 && !running) {
+		bool reads = mic_cmd_reads(&swr, tx_dev);
+
+		if (reads && cmd >= 3) {
+			/* 17r1c / 17r2: 17r1b's up list, kept up while the stream runs, then 17r1b's down list */
+			mic_tag = "r1b";
+			mic_cdc_writes = mic_cdc_bad = 0;
+			mic("r1b (for 17r1c%s): the WCD9395 up for AMIC1 -> ADC1 as 17r1b, KEPT UP for the stream\n", cmd >= 4 ?
+			    " + 17r2" : "");
+			if (mic_cdc_up(&swr, tx_dev) && mic_cdc_bad == 0) {
+				(void)mic_r1c(&swr, &txm, &va, tx_dev, cmd, apps);
+			} else {
+				mic("r1c REFUSED: 17r1b's up list did not read back as wanted in this run: no SoundWire port, no "
+				    "decimator, no DSP graph\n");
+			}
+			mic_tag = "r1b";
+			mic_cdc_down(&swr, tx_dev);
+			mic("r1b down list done (MICBIAS1 off, ADC1 off); %u codec / SoundWire writes in all, %u not as wanted; the "
+			    "codec goes back into reset next\n", mic_cdc_writes, mic_cdc_bad);
+		} else if (reads && cmd == 2) {
+			(void)mic_cdc_bringup(&swr, tx_dev);
+		} else if (cmd >= 2) {
+			mic("r1b REFUSED: 17r1a's reads did not pass in this run: no codec write\n");
+		}
+	} else if (cmd) {
+		mic("r1a REFUSED: no WCD9395 TX device enumerated by us in this run (or swr2 was someone else's)\n");
+	}
+
+put_back:
+	/* 5: everything back, swr2 first (while its clock still runs), then the pads, the TX macro, the VA macro */
+	if (inited) {
+		(void)mic_wr(&swr, SWR_COMP_CFG, "COMP_CFG back", f_comp_cfg, 0x3);
+		(void)mic_wr(&swr, SWR_INT_CLEAR, "INTERRUPT_CLEAR all", 0xffffffffu, 0);
+		(void)mic_wr(&swr, SWR_CMD_FIFO_CFG, "CMD_FIFO_CFG back", f_fifo_cfg, 0x80000007u);
+		/* (CLK_START stays 1 once the frames run -- 17q3 / 17r1a; Linux never clears it; the TX macro's clock gate
+		 * and the MCLK release below stop the bus: not checked) */
+		(void)mic_wr(&swr, SWR_CLK_CTRL, "V2 CLK_CTRL back (sticky start bit)", f_clk, 0);
+		(void)mic_wr(&swr, SWR_LINK_MANAGER_EE, "LINK_MANAGER_EE back", f_ee, 0x3);
+		(void)mic_wr(&swr, SWR_MCP_CFG, "MCP_CFG back", f_mcp_cfg, 0x1fu << 17);
+		(void)mic_wr(&swr, SWR_ENUMERATOR_CFG, "ENUMERATOR_CFG back", f_enum, 0x1);
+		(void)mic_wr(&swr, SWR_FRAME_CTRL_BANK0, "MCP_FRAME_CTRL_BANK(0) back", f_frame, 0xff);
+		mic("swr2 after: LINK_STATUS %#x, MCP_SLV_STATUS %#x, INT_STATUS %#x\n", mic_rd(&swr, SWR_LINK_STATUS),
+		    mic_rd(&swr, SWR_MCP_SLV_STATUS), mic_rd(&swr, SWR_INT_STATUS));
+	}
+	if (pins_set) {
+		for (unsigned i = 4; i-- > 0;) {
+			char reg[32];
+
+			snprintf(reg, sizeof(reg), "gpio%u CFG back", mic_lpi_pins[i]);
+			(void)mic_wr(&lpi, 0x1000u * mic_lpi_pins[i], reg, lpi_found[i], 0x3ffu | 3u << 11);
+		}
+	}
+	(void)mic_wr(&txm, TXM_SWR_CONTROL, "SWR_CONTROL back", f_txm[2], 0x3);
+	(void)mic_wr(&txm, TXM_FS_CNT_CONTROL, "FS_CNT_CONTROL back", f_txm[1], 0x1);
+	(void)mic_wr(&txm, TXM_MCLK_CONTROL, "MCLK_CONTROL back", f_txm[0], 0x1);
+	(void)mic_wr(&txm, TXM_FREQ_MCLK, "FREQ_MCLK back", f_txm[3], 0x1);
+	if (fsgen) {
+		(void)mic_wr(&va, TXM_SWR_CONTROL, "SWR_CONTROL back", f_va[2], 0x3);
+		(void)mic_wr(&va, TXM_MCLK_CONTROL, "MCLK_CONTROL back", f_va[0], 0x1);
+		(void)mic_wr(&va, TXM_FS_CNT_CONTROL, "FS_CNT_CONTROL back", f_va[1], 0x1);
+		(void)mic_wr(&va, TXM_TOP_CFG0, "TOP_CFG0 back", f_va[3], 0x2);
+	}
+unmap:
+	if (txm.va != 0) {
+		ml_io_unmap(txm.va, 0x4000);
+	}
+	if (swr.va != 0) {
+		ml_io_unmap(swr.va, 0x10000);
+	}
+	if (lpi.va != 0) {
+		ml_io_unmap(lpi.va, 0x10000);
+	}
+	if (va.va != 0) {
+		ml_io_unmap(va.va, 0x4000);
+	}
+release:
+	/* [icemic_power] the codec's reset pad back as found (the bus is already put back): CTL first (OE back), then IO */
+	if (powered) {
+		mic("power: W tlmm gpio161 CTL %#x -> %#x, IO -> %#x (as found: the codec held in reset again)\n",
+		    rd(tlmm161 + 0x1000), f161_ctl, f161_io & 2);
+		wr(tlmm161 + 0x1000, f161_ctl);
+		settle();
+		wr(tlmm161 + 0x1004, f161_io & 2);
+		settle();
+		mic("power: gpio161 back: ctl %#x io %#x; the RPMh votes for L15B / BOB1 / L1G stay (not released)\n",
+		    rd(tlmm161 + 0x1000), rd(tlmm161 + 0x1004));
+		put_back &= rd(tlmm161 + 0x1000) == f161_ctl;
+		ml_io_unmap(tlmm161, 0x4000);
+		tlmm161 = 0;
+	}
+	/* no LPASS register is read from here on */
+	if (v_mclk) {
+		put_back &= mic_prm(apps, false, PARAM_ID_RSC_AUDIO_HW_CLK, MIC_CLK_TX_CORE_MCLK, 0, "TX_CORE_MCLK released") == 0;
+	}
+	if (v_dcodec) {
+		put_back &= mic_prm(apps, false, PARAM_ID_RSC_HW_CORE, MIC_HW_DCODEC, 0, "LPASS_HW_DCODEC_VOTE released") == 0;
+	}
+	if (v_macro) {
+		put_back &= mic_prm(apps, false, PARAM_ID_RSC_HW_CORE, MIC_HW_LPASS, 0, "LPASS_HW_MACRO_VOTE released") == 0;
+	}
+	put_back &= mic_bad == 0;
+	mic("%u register writes, %u not read back as wanted; votes %s\n", mic_writes, mic_bad, put_back ?
+	    "all given back" : "NOT ALL GIVEN BACK / a write not as wanted");
+	if (v_mclk && clocks && sane && frames && found_tx && put_back) {
+		mic("E PASS: votes granted, TX macro clocks on, swr2 v%u.%u.%u (%#x), frames running, THE WCD9395 TX DEVICE "
+		    "ENUMERATED; everything put back\n", version >> 24, (version >> 16) & 0xff, version & 0xffff, version);
+	} else {
+		mic("E FAIL: votes %s, clocks %s, swr2 version %#x %s, frames %s, WCD9395 TX %s, put back %s\n", v_mclk ? "ok" :
+		    "NOT GRANTED", clocks ? "on" : "NOT ON", version, sane ? "sane" : "not read / NOT SANE", frames ? "running" :
+		    "NOT RUNNING", found_tx ? "found" : "NOT FOUND", put_back ? "ok" : "NOT ALL");
+	}
+	mark(M_AUDIO, v_mclk && clocks && sane && frames && found_tx && put_back ? MARK_OK : MARK_FAIL);
+	return found_tx && put_back;
+}
+
+/* levels 7-11: attach, listen `seconds`, (8) answer and open, (9) QRTR, (10) GPR, (11) SNS; then the summary */
+static bool
+glink_listen(uint32_t level, uint32_t seconds)
+{
+	uint64_t t0 = now_us(), hello_wait = 0, gpr_at = 0;
+	char list[600];
+	int n = 0;
+	struct gchan *ipcrtr = NULL, *apps = NULL;
+	uint32_t gpr_step = 0, prm_wanted = 1, sns_step = 0, rate_hz = 10, audio_wanted = 0, smmu_wanted = 0, tone_wanted = 0;
+	uint32_t sns_stream_s = 5, lux_wanted = 0;
+	uint32_t mic_wanted = 0, frpc_wanted = 0, mic_then_snd = 0, mic_at_s = 0, mic_cue = 0;
+	bool audio_done = false, smmu_done = false, mic_done = true, frpc_done = true, snd_then_mic = false;
+	uint64_t sns_at = 0;
+	bool ok;
+
+	PE_parse_boot_argn("icedsp_prm", &prm_wanted, sizeof(prm_wanted));
+	PE_parse_boot_argn("icedsp_rate", &rate_hz, sizeof(rate_hz));
+	PE_parse_boot_argn("icesns_secs", &sns_stream_s, sizeof(sns_stream_s));    /* 28a: how long accel streams */
+	PE_parse_boot_argn("icelux", &lux_wanted, sizeof(lux_wanted));             /* the light sensor too (kern.icelux) */
+	PE_parse_boot_argn("iceaudio", &audio_wanted, sizeof(audio_wanted));
+	PE_parse_boot_argn("icesmmu", &smmu_wanted, sizeof(smmu_wanted));
+	/*
+	 * laneD: the installed line lost icetone=1 in install-6.2 (room), so since then the speakers' sound service (icesnd=1
+	 * runs only inside level D) never starts: the DSP is stopped after the 30 s look + 15 s hold, and IcelandAudio's
+	 * "Speaker" plays into nothing (i65u console: no "snd: SERVICE UP", "stopping after the hold" at 167 s). iceld=<ids>
+	 * holding '4' gives icetone its install-5 value 1; icetone= on the line still wins.
+	 */
+	if (!PE_parse_boot_argn("icetone", &tone_wanted, sizeof(tone_wanted))) {
+		tone_wanted = PE_iceland_laned('4') ? 1 : 0;
+	}
+	PE_parse_boot_argn("icemic", &mic_wanted, sizeof(mic_wanted));
+	if (rate_hz == 0 || rate_hz > 100) {
+		rate_hz = 10;
+	}
+	/* icemic=1 (microphone level E, OFF by default): alone, at exactly icedsp=10, with PRM asked */
+	/*
+	 * 17t: icemic_then_snd=1 lets level E (with its capture service) run FIRST and level D's sound service (icesnd=1,
+	 * iceaudio=1 icesmmu=1 icetone=1) AFTER it has put everything back -- never both at once (they share bank 7 / SMR
+	 * 9-10): the tone block below waits for mic_done.
+	 */
+	PE_parse_boot_argn("icemic_then_snd", &mic_then_snd, sizeof(mic_then_snd));
+	PE_parse_boot_argn("icemic_at", &mic_at_s, sizeof(mic_at_s));
+	PE_parse_boot_argn("icemic_cue", &mic_cue, sizeof(mic_cue));
+	/* round 6: icerec=1 (see ice_rec): the sound service first, the microphone after it */
+	if (ice_rec()) {
+		if (tone_wanted == 1 && audio_wanted == 1 && smmu_wanted == 1 && (mic_wanted == 0 || mic_wanted == 1) &&
+		    !mic_then_snd) {
+			snd_then_mic = true;
+			mic_wanted = 1;
+			if (!PE_parse_boot_argn("icemic_at", &mic_at_s, sizeof(mic_at_s))) {
+				mic_at_s = 255;
+			}
+			mic("icerec=1: the sound service first, then the microphone's capture service from %u s of uptime\n",
+			    mic_at_s);
+		} else {
+			mic("icerec=1 needs iceaudio=1 icesmmu=1 icetone=1 and no icemic_then_snd: ignored\n");
+		}
+	}
+	if (mic_then_snd && !(mic_wanted == 1 && tone_wanted == 1 && audio_wanted == 1 && smmu_wanted == 1)) {
+		mic("17t: icemic_then_snd=1 needs icemic=1 iceaudio=1 icesmmu=1 icetone=1: ignored\n");
+		mic_then_snd = 0;
+	}
+	if (mic_wanted != 0) {
+		if (mic_wanted != 1 || level != 10 || !prm_wanted || ((audio_wanted || smmu_wanted || tone_wanted) &&
+		    !mic_then_snd && !snd_then_mic)) {
+			mic("E REFUSED: icemic=1 runs only with icedsp=10, the PRM asked (icedsp_prm not 0) and none of iceaudio / "
+			    "icesmmu / icetone (here icemic=%u, icedsp=%u, icedsp_prm=%u, iceaudio=%u, icesmmu=%u, icetone=%u): "
+			    "nothing touched\n", mic_wanted, level, prm_wanted, audio_wanted, smmu_wanted, tone_wanted);
+		} else {
+			mic_done = false;
+		}
+	}
+	/*
+	 * icefrpc=1 (sensor level 22a, OFF by default): at icedsp=10 or 11, not with icemic. With iceaudio / icesmmu /
+	 * icetone since the shared ADSP layer: FastRPC's bank 8 (SMR 11/12) and audio's bank 7 (SMR 9/10) are separate
+	 * (fx_setup refuses 7 and 9/10), both inside the UFS census, the blocks below run one after the other on this one
+	 * thread, and the stop hook puts both back after the DSP's shutdown.
+	 */
+	PE_parse_boot_argn("icefrpc", &frpc_wanted, sizeof(frpc_wanted));
+	if (frpc_wanted != 0) {
+		if (frpc_wanted > 3 || (level != 10 && level != 11) || mic_wanted) {
+			say("frpc: REFUSED: icefrpc=1..3 runs only with icedsp=10 or 11 and not with icemic "
+			    "(here icefrpc=%u, icedsp=%u, icemic=%u): nothing touched\n", frpc_wanted, level, mic_wanted);
+		} else {
+			frpc_done = false;
+			if (frpc_wanted >= 2) {         /* the DSP's FastRPC channel answered: 4 of IPCRTR's 24 intents */
+				g_wanted[0].intents = 20;
+				g_wanted[3].intents = 4;
+			}
+		}
+	}
+	/* laneD: the share (iceadsp_share=1) wants IPCRTR and FastRPC's intents as the service's own life does */
+	if (svc_shared()) {
+		g_wanted[0].intents = 20;
+		g_wanted[3].intents = 4;
+		if (mic_wanted) {
+			svc_shared_no_frpc();
+		}
+		say("service: SHARED: the kit's GLINK stays up until the run's end (not %u s)\n", seconds);
+	}
+	g_level = level;
+	mark(M_GLINK, MARK_BUSY);
+	if (!g_attach()) {
+		mark(M_GLINK, MARK_FAIL);
+		return false;
+	}
+	if (level >= 9) {
+		mark(M_QRTR, MARK_BUSY);
+	}
+	while ((now_us() - t0 < seconds * 1000000ull || svc_shared()) && !g_broken && !adsp_stop_req) {
+		g_pump();
+		if (level >= 9 && !q_hello_sent) {
+			if (ipcrtr == NULL) {
+				for (unsigned i = 0; i < g_nchan; i++) {
+					if (strcmp(g_chan[i].name, "IPCRTR") == 0 && g_chan[i].offered && !g_chan[i].closed) {
+						ipcrtr = &g_chan[i];
+						hello_wait = now_us();
+					}
+				}
+			}
+			/* (as qrtr_hello_work: ours goes out at once; the DSP's node, if its HELLO came first) */
+			if (ipcrtr != NULL && (q_hello_heard || now_us() - hello_wait > 200000ull)) {
+				if (!qrtr_hello(ipcrtr)) {
+					q_hello_sent = true;    /* (tried once) */
+				}
+			}
+		}
+		/* level 10: APM state (asked again after 1 s), then PRM; steps 0 ask, 1/2 wait, 4 PRM, 5 wait, 9 done */
+		if (level >= 10 && gpr_step != 9) {
+			if (apps == NULL) {
+				for (unsigned i = 0; i < g_nchan; i++) {
+					bool known = false;
+
+					for (unsigned r = 0; r < G_REMOTE_INTENTS; r++) {
+						known |= g_chan[i].ri[r].there;
+					}
+					if (strcmp(g_chan[i].name, "adsp_apps") == 0 && g_chan[i].offered && !g_chan[i].closed && known) {
+						apps = &g_chan[i];
+					}
+				}
+			}
+			if (apps != NULL) {
+				uint64_t since = now_us() - gpr_at;
+
+				if (gpr_step == 0) {
+					mark(M_GPR, MARK_BUSY);
+					gpr_step = gpr_apm_query(apps) ? 1 : 9;
+					gpr_at = now_us();
+				} else if ((gpr_step == 1 || gpr_step == 2) && gpr_apm_answers != 0) {
+					gpr_step = 4;
+				} else if (gpr_step == 1 && since > 1000000ull) {
+					say("GPR: no answer from the APM in 1 s: asked again (the first is often lost)\n");
+					gpr_step = gpr_apm_query(apps) ? 2 : 9;
+					gpr_at = now_us();
+				} else if (gpr_step == 2 && since > 2000000ull) {
+					say("GPR: no answer from the APM to the second query either\n");
+					gpr_step = 9;
+				} else if (gpr_step == 4) {
+					gpr_step = prm_wanted && gpr_prm_query(apps) ? 5 : 9;
+					gpr_at = now_us();
+				} else if (gpr_step == 5 && (gpr_prm_answers != 0 || since > 1500000ull)) {
+					gpr_step = 9;
+				}
+			}
+		}
+		/* laneD: the share's clients, once GPR is settled (before the sound service, which then polls them itself) */
+		if (level >= 9 && gpr_step == 9 && svc_shared()) {
+			svc_shared_poll(ipcrtr);
+		}
+		/*
+		 * icetone=1/2 (audio level D, OFF by default): only together with iceaudio=1 and icesmmu=1 (C2, the owner's
+		 * yes) -- audio_tone refuses otherwise; it runs C2's setup, C1's back end and the tone in one go
+		 */
+		if (tone_wanted && !audio_done && level >= 10 && gpr_step == 9 && gpr_apm_answers && gpr_apm_state != 0 &&
+		    apps != NULL && (!mic_then_snd || mic_done)) {
+			if (mic_then_snd) {
+				mic("17t: the mic's part is over (everything put back): the sound service starts now\n");
+			}
+			audio_done = smmu_done = true;
+			(void)audio_tone(apps, tone_wanted, audio_wanted, smmu_wanted);
+		}
+		/* iceaudio=1 (audio level C1): once the APM has said it is ready */
+		if (audio_wanted && !audio_done && level >= 10 && gpr_step == 9 && gpr_apm_answers && gpr_apm_state != 0 &&
+		    apps != NULL && !mic_then_snd) {
+			audio_done = true;
+			(void)audio_c1(apps, 0, NULL);
+		}
+		/* icesmmu=1 (audio level C2, OFF by default: only with the owner's yes) */
+		if (smmu_wanted == 1 && !smmu_done && (!audio_wanted || audio_done) && level >= 10 && gpr_step == 9 &&
+		    gpr_apm_answers && gpr_apm_state != 0 && apps != NULL && !mic_then_snd) {
+			smmu_done = true;
+			(void)audio_c2(apps);
+		}
+		/* icemic=1 (microphone level E): once the APM is ready and the PRM has answered; refused otherwise */
+		/* 17t2: icemic_at=N holds the mic's start until N s of uptime (userland up); icemic_cue=1 plays level D's tone
+		 * (-40 dBFS, 1 s) right before, as the cue to speak */
+		if (!mic_done && level == 10 && gpr_step == 9 && now_us() >= (uint64_t)mic_at_s * 1000000ull &&
+		    (!snd_then_mic || audio_done)) {
+			mic_done = true;
+			if (snd_then_mic) {
+				mic("icerec=1: the sound service's part is over (everything put back): the microphone starts now, at "
+				    "%llu s\n", now_us() / 1000000ull);
+			}
+			if (mic_cue && mic_then_snd && apps != NULL && gpr_apm_answers && gpr_apm_state != 0) {
+				mic("17t2: the cue beep (level D's tone) at %llu s, then the microphone\n", now_us() / 1000000ull);
+				snd_force_tone = true;
+				(void)audio_tone(apps, 1, 1, 1);
+				snd_force_tone = false;
+			}
+			if (apps != NULL && gpr_apm_answers && gpr_apm_state != 0 && gpr_prm_answers) {
+				(void)mic_level_e(apps);
+			} else {
+				mic("E REFUSED: GPR not ready (adsp_apps %s, APM %s state %d, PRM %s): nothing touched\n", apps ? "open" :
+				    "NOT OPEN", gpr_apm_answers ? "answers," : "SILENT,", (int)gpr_apm_state, gpr_prm_answers ? "answers" :
+				    "SILENT");
+				mark(M_AUDIO, MARK_FAIL);
+			}
+		}
+		/* icefrpc=1 (sensor level 22a): once GPR is up (the DSP runs); alone */
+		if (!frpc_done && (level == 10 || level == 11) && gpr_step == 9) {
+			frpc_done = true;
+			(void)frpc_level_22a(frpc_wanted);
+		}
+		/* level 11: SNS (steps 0 find the service, 1/2 SUIDs, 3 samples, 4 disabled, 5 done) */
+		if (level >= 11 && sns_step != 5 && frpc_done) {        /* (22d: after the file server, when asked) */
+			uint64_t since = now_us() - sns_at;
+
+			if (q_resume_due != 0) {
+				q_resume_due = 0;
+				qrtr_resume(q_resume_node, q_resume_port);
+			}
+			if (sns_step == 0 && ipcrtr != NULL && q_hello_sent) {
+				for (unsigned i = 0; i < q_nsrv; i++) {
+					if (q_srv[i].service == SSC_QMI_SERVICE && !q_srv[i].gone) {
+						s_ch = ipcrtr;
+						s_port = q_srv[i].port;
+					}
+				}
+				if (s_ch != NULL) {
+					mark(M_SNS, MARK_BUSY);
+					say("SNS: the sensors' client service at node %u port %u; our port %#x\n", q_remote, s_port,
+					    QRTR_OUR_PORT);
+					sns_step = ssc_suid("accel") ? 1 : 5;
+					sns_at = now_us();
+				}
+			} else if (sns_step == 1 && (s_suids >= 1 || since > 2000000ull)) {
+				sns_step = ssc_suid("ambient_light") ? 2 : 5;
+				sns_at = now_us();
+			} else if (sns_step == 2 && (s_suids >= 2 || since > 2000000ull)) {
+				bool accel_on = false;
+
+				if (s_accel) {
+					uint8_t m[5] = { 0x0d };
+					uint32_t r = rate_hz, e = 31 - (uint32_t)__builtin_clz(r), bits;
+
+					bits = (127 + e) << 23 | ((e <= 23 ? r << (23 - e) : r >> (e - 23)) & 0x7fffff);
+					pb_fixed(m + 1, bits, 4);
+					accel_on = ssc_request(s_accel_low, s_accel_high, SSC_REQ_ENABLE, m, 5, "accel enable");
+				} else {
+					say("SNS: no accelerometer found: %s\n", lux_wanted ? "not enabled" : "nothing enabled");
+				}
+				/* icelux=1: the light sensor too, reporting on change (no body); kern.icelux follows its samples */
+				if (lux_wanted && s_light) {
+					s_light_on = ssc_request(s_light_low, s_light_high, SSC_REQ_ON_CHANGE, NULL, 0,
+					    "light enable (on change)");
+				} else if (lux_wanted) {
+					say("SNS: no ambient light sensor found: not enabled\n");
+				}
+				sns_step = accel_on || s_light_on ? 3 : 5;
+				sns_at = now_us();
+			} else if (sns_step == 3 && since > (uint64_t)sns_stream_s * 1000000ull) {   /* 28a: icesns_secs */
+				if (s_accel) {
+					(void)ssc_request(s_accel_low, s_accel_high, SSC_REQ_DISABLE, NULL, 0, "accel disable");
+				}
+				if (s_light_on) {
+					(void)ssc_request(s_light_low, s_light_high, SSC_REQ_DISABLE, NULL, 0, "light disable");
+					s_light_on = false;
+				}
+				sns_step = 4;
+				sns_at = now_us();
+			} else if (sns_step == 4 && since > 500000ull) {
+				/* af_qrtr.c qrtr_port_remove: DEL_CLIENT for our port, to the control port */
+				uint32_t pkt[5] = { QRTR_TYPE_DEL_CLIENT, QRTR_OUR_NODE, QRTR_OUR_PORT, 0, 0 };
+
+				(void)qrtr_send(QRTR_TYPE_DEL_CLIENT, QRTR_OUR_PORT, q_remote, QRTR_PORT_CTRL, pkt, sizeof(pkt));
+				say("SNS > DEL_CLIENT for our port %#x\n", QRTR_OUR_PORT);
+				sns_step = 5;
+			}
+		}
+		sleep_ms(2);
+	}
+	/*
+	 * The run ends (adsp_stop_req) while the sensors stream: their client stops first, as at the end of icesns_secs --
+	 * accel and light disabled, DEL_CLIENT for our port -- with 500 ms at most for the DSP's answers; then GLINK closes
+	 * below, and the caller stops the DSP.
+	 */
+	if (adsp_stop_req && level >= 11 && (sns_step == 3 || sns_step == 4)) {
+		uint32_t pkt[5] = { QRTR_TYPE_DEL_CLIENT, QRTR_OUR_NODE, QRTR_OUR_PORT, 0, 0 };
+		uint64_t t1 = now_us();
+
+		say("stop: the run ends: the sensors' client stops first (500 ms at most)\n");
+		if (sns_step == 3 && s_accel) {
+			(void)ssc_request(s_accel_low, s_accel_high, SSC_REQ_DISABLE, NULL, 0, "accel disable");
+		}
+		if (sns_step == 3 && s_light_on) {
+			(void)ssc_request(s_light_low, s_light_high, SSC_REQ_DISABLE, NULL, 0, "light disable");
+			s_light_on = false;
+		}
+		(void)qrtr_send(QRTR_TYPE_DEL_CLIENT, QRTR_OUR_PORT, q_remote, QRTR_PORT_CTRL, pkt, sizeof(pkt));
+		say("SNS > DEL_CLIENT for our port %#x\n", QRTR_OUR_PORT);
+		sns_step = 5;
+		while (now_us() - t1 < 500000ull && !g_broken) {
+			g_pump();
+			sleep_ms(2);
+		}
+	}
+	svc_shared_end(g_broken);               /* laneD: the share's clients stop (or hear of the crash) before GLINK closes */
+	list[0] = 0;
+	for (unsigned i = 0; i < g_nchan && n < (int)sizeof(list) - 64; i++) {
+		n += snprintf(list + n, sizeof(list) - (size_t)n, " \"%s\"(%u%s%s)", g_chan[i].name, g_chan[i].rcid,
+		    g_chan[i].offered ? ", OPEN" : g_chan[i].lcid ? ", answered, not acked" : "", g_chan[i].closed ? ", closed" :
+		    "");
+	}
+	say("GLINK after %u s: version %s, %u messages heard, %u sent, the DSP's channels (%u):%s\n", seconds,
+	    g_agreed ? "agreed" : "NOT AGREED", g_heard, g_said, g_nchan, g_nchan ? list : " none");
+	ok = g_agreed && !g_broken;
+	for (unsigned i = 0; level >= 8 && i < g_nchan; i++) {
+		if (g_chan[i].lcid != 0) {
+			unsigned known = 0;
+
+			for (unsigned r = 0; r < G_REMOTE_INTENTS; r++) {
+				known += g_chan[i].ri[r].there;
+			}
+			say("GLINK: \"%s\": %s, %u messages from the DSP, %u of its intents known\n", g_chan[i].name,
+			    g_chan[i].offered ? "open" : "NOT OPEN (our OPEN not acknowledged)", g_chan[i].messages, known);
+			ok &= g_chan[i].offered;
+		}
+	}
+	if (level >= 9) {
+		say("QRTR: %u packets, HELLO %s / %s, the DSP is node %#x; %u services:\n", q_packets, q_hello_sent ? "sent" :
+		    "NOT SENT", q_hello_heard ? "heard" : "NOT HEARD", q_remote, q_nsrv);
+		for (unsigned i = 0; i < q_nsrv; i++) {
+			say("QRTR:   service %3u (%#x) instance %#x node %u port %u%s\n", q_srv[i].service, q_srv[i].service,
+			    q_srv[i].instance, q_srv[i].node, q_srv[i].port, q_srv[i].gone ? " (gone again)" : "");
+		}
+		mark(M_QRTR, q_hello_heard && q_hello_sent && q_nsrv > 0 ? MARK_OK : MARK_FAIL);
+	}
+	if (level >= 10) {
+		say("GPR: %u packets on adsp_apps; APM %s (state %d, %u answers); PRM %s (opcode %#x, status %#x)\n", gpr_packets,
+		    gpr_apm_answers ? "ANSWERS" : apps ? "silent" : "not asked (adsp_apps not open)", (int)gpr_apm_state,
+		    gpr_apm_answers, !prm_wanted ? "not asked" : gpr_prm_answers ? "ANSWERS" : "silent", gpr_prm_opcode,
+		    gpr_prm_status);
+		mark(M_GPR, gpr_apm_answers && gpr_apm_state != 0 && (!prm_wanted || gpr_prm_answers) ? MARK_OK : MARK_FAIL);
+	}
+	if (level >= 11) {
+		say("SNS: %u responses (%u not ok), %u indications, SUID answers %u: accel %s, ambient_light %s; enable %s; "
+		    "%u ACCEL SAMPLES at %u Hz asked\n", s_responses, s_results_bad, s_indications, s_suids, s_accel ? "found" :
+		    "NOT FOUND", s_light ? "found" : "not found", s_enabled_ack ? "confirmed" : "not confirmed", s_samples,
+		    rate_hz);
+		if (lux_wanted) {
+			say("SNS: light (icelux=1): enable %s, %u LIGHT SAMPLES, the last %d.%03d lux\n", s_light_ack ? "answered" :
+			    "not answered", s_light_samples, ice_lux / 1000, ice_lux % 1000);
+		}
+		mark(M_SNS, s_samples > 0 ? MARK_OK : MARK_FAIL);
+	}
+	/* qcom_glink_native_remove -> the endpoints' close: CLOSE for each channel of ours, its CLOSE_ACK awaited 300 ms */
+	if (level >= 8) {
+		uint64_t t1 = now_us();
+
+		g_closing = true;
+
+		for (unsigned i = 0; i < g_nchan; i++) {
+			if (g_chan[i].lcid != 0 && !g_chan[i].close_acked) {
+				(void)g_send(GC_CLOSE, g_chan[i].lcid, 0, NULL, 0);
+			}
+		}
+		while (now_us() - t1 < 300000ull && !g_broken) {
+			g_pump();
+			sleep_ms(2);
+		}
+	}
+	mark(M_GLINK, ok ? MARK_OK : MARK_FAIL);
+	return ok;
+}
+
+static bool started, dtb_started;
+
+static void
+dsp_stop(void)
+{
+	struct smp2p w;
+	uint64_t t0 = now_us(), answer = 0;
+	uint32_t state = 0;
+	bool was_up = their_words(&w) && (slave_kernel(&w) & DSP_READY);
+
+	if (our_item != 0 && was_up) {
+		mark(M_STOP, MARK_BUSY);
+		our_stop_bit(true);
+		while (now_us() - t0 < 5000000) {
+			if (their_words(&w) && ((state = slave_kernel(&w)) & (DSP_STOP_ACK | DSP_FATAL))) {
+				break;
+			}
+			sleep_ms(1);
+		}
+		say("stop asked: %s after %llu ms (slave-kernel %#x)\n", (state & DSP_STOP_ACK) ? "acknowledged" :
+		    "NOT ACKNOWLEDGED", (now_us() - t0) / 1000, state);
+		our_stop_bit(false);
+		mark(M_STOP, (state & DSP_STOP_ACK) ? MARK_OK : MARK_FAIL);
+	}
+	mark(M_SHUTDOWN, MARK_BUSY);
+	(void)crypto_vote(true);        /* (qcom_scm_pas_shutdown votes it too) */
+	/*
+	 * adsp.mbn's shutdown only if TrustZone took its init image this boot, or the DSP reads as running (a start of an
+	 * earlier boot): run w3-audio-1's never-initialised id 1 answered -3145800.
+	 */
+	if (main_image.pas_init || was_up) {
+		scm("shutdown", SCM_PAS_SHUTDOWN, 1, PAS_ADSP, 0, 0, &answer);
+	} else {
+		say("shutdown: adsp.mbn never reached TrustZone (no init image) and the DSP is not up: no PAS shutdown of id 1\n");
+	}
+	if (dtb_started) {
+		scm("shutdown dtb", SCM_PAS_SHUTDOWN, 1, PAS_ADSP_DTB, 0, 0, &answer);
+	}
+	main_image.pas_init = dtb_image.pas_init = false;
+	mark(M_SHUTDOWN, MARK_OK);
+	mark(M_POWER_DOWN, MARK_BUSY);
+	qmp_send("{class: image, res: load_state, name: adsp, val: off}");
+	if (rails_held) {
+		rails(false);
+	}
+	(void)lpass_bus_vote(false);
+	(void)crypto_vote(false);
+	mark(M_POWER_DOWN, MARK_OK);
+	started = dtb_started = false;
+}
+
+/* the end of a level short of a start: the crypto vote given back, the metadata pages freed, the last mark */
+static void
+finish(bool ok)
+{
+	(void)lpass_bus_vote(false);
+	(void)crypto_vote(false);
+	image_done(&main_image);
+	image_done(&dtb_image);
+	mark(M_DONE, ok ? MARK_OK : MARK_FAIL);
+}
+
+/*
+ * ---- the run's end: the stop hook ------------------------------------------------------------------------------------
+ *   hakios_iceland_adsp_stop()     from a thread at the run's end (reset-after, loader_return_after, "xl stop"): the
+ *                                  thread that runs the DSP is asked to end (adsp_stop_req) and waited for up to 8 s:
+ *                                  its clients stop first (the sensors: disables + DEL_CLIENT, 500 ms at most), GLINK
+ *                                  closes, the DSP is stopped (stop bit, stop-ack, PAS shutdown, AOSS off, votes back),
+ *                                  then bank 8, then bank 7. A DSP left running (icedsp_keep=1) or a thread that does not
+ *                                  end in time is stopped from here.
+ *   hakios_iceland_adsp_quiesce()  from loader_return() (a panic's end, A3 re-entry), before U-Boot's UFS slot is given
+ *                                  back and before pcie_quiesce: a panic's rules -- no message on any channel, no sleep,
+ *                                  no lock waited for: the stop bit and 500 ms of spinning for the stop-ack, the PAS
+ *                                  shutdown only if TrustZone's lock is free (scm_do try_only), then banks 8 and 7 put
+ *                                  back. The AOSS "off" and the RPMh votes are left (a mailbox lock and the shared
+ *                                  rails; the next boot's firmware takes them over, as icepcie keeps its rail votes).
+ * Each does its part once (adsp_down_once); without icedsp= neither touches anything.
+ */
+static volatile uint32_t adsp_used;             /* icedsp= was given: there is a thread that may start the DSP */
+static volatile uint32_t adsp_thread_live;      /* that thread runs */
+static volatile uint32_t adsp_down_once;
+
+static void
+dsp_stop_quiet(void)
+{
+	struct smp2p w;
+	uint64_t t0 = now_us(), answer = 0;
+	uint32_t state = 0;
+	bool was_up;
+
+	if (smem == 0 || ipcc == 0) {
+		return;
+	}
+	was_up = their_words(&w) && (slave_kernel(&w) & DSP_READY);
+	if (our_item != 0 && was_up) {
+		our_stop_bit(true);
+		while (now_us() - t0 < 500000ull) {
+			if (their_words(&w) && ((state = slave_kernel(&w)) & (DSP_STOP_ACK | DSP_FATAL))) {
+				break;
+			}
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+		our_stop_bit(false);
+		say("quiesce: stop %s after %llu ms (slave-kernel %#x)\n", (state & DSP_STOP_ACK) ? "acknowledged" :
+		    "NOT ACKNOWLEDGED", (now_us() - t0) / 1000, state);
+	}
+	if (main_image.pas_init || was_up) {
+		(void)scm_do("shutdown (quiesce)", SCM_PAS_SHUTDOWN, 1, PAS_ADSP, 0, 0, &answer, true);
+	}
+	if (dtb_started) {
+		(void)scm_do("shutdown dtb (quiesce)", SCM_PAS_SHUTDOWN, 1, PAS_ADSP_DTB, 0, 0, &answer, true);
+	}
+	main_image.pas_init = dtb_image.pas_init = false;
+	started = dtb_started = false;
+}
+
+/* after the DSP's shutdown: the banks it could reach put back, FastRPC's first, then audio's (each only if set) */
+static void
+banks_down(void)
+{
+	fx_teardown();
+	c2_teardown();
+}
+
+static void
+adsp_down(const char *why, bool quiet)
+{
+	bool was = started || dtb_started;
+
+	if (!__sync_bool_compare_and_swap(&adsp_down_once, 0, 1)) {
+		return;
+	}
+	if (was) {
+		if (quiet) {
+			dsp_stop_quiet();
+		} else {
+			dsp_stop();
+		}
+	}
+	if (fx.live || c2.live || was) {
+		banks_down();
+		say("stop (%s): the DSP %s; banks 8 / 7 put back where they were set\n", why, was ? "stopped" :
+		    "was not running");
+	}
+}
+
+void
+hakios_iceland_adsp_stop(void)
+{
+	adsp_stop_req = 1;              /* first: a start that has not begun yet must not begin after this */
+	if (!adsp_used) {
+		return;
+	}
+	for (int i = 0; i < 160 && adsp_thread_live; i++) {
+		sleep_ms(50);
+	}
+	if (adsp_thread_live) {
+		say("stop: the DSP's thread has not ended in 8 s: stopped from here with a panic's rules\n");
+		adsp_down("stop, the thread did not end", true);
+		return;
+	}
+	adsp_down("stop", false);
+}
+
+void
+hakios_iceland_adsp_quiesce(void)
+{
+	adsp_stop_req = 1;
+	if (!adsp_used) {
+		return;
+	}
+	adsp_down("quiesce", true);
+}
+
+/*
+ * Level 2's reads, shared by the kit's levels and the service: the blocks mapped (once), SMEM partition 0/2 and the
+ * DSP's SMP2P item, its last words, cmd-db (lcx, lmx, CE0, LP0), the RSC id and layout, AOSS. Reads only.
+ */
+static bool
+adsp_reads(void)
+{
+	uint32_t size = 0, id;
+	struct smp2p w;
+	char list[200], levels[120];
+
+	mark(M_SMEM, MARK_BUSY);
+	if (smem == 0) {
+		smem = ml_io_map(SMEM_PHYS, SMEM_SIZE);
+		ipcc = ml_io_map(IPCC_PHYS, 0x1000);
+		aoss = ml_io_map(AOSS_PHYS, 0x1000);
+		rsc = ml_io_map(RSC_PHYS, 0x10000);
+		mutex = ml_io_map(MUTEX_PHYS, 0x1000);
+		cmd_db = (const uint8_t *)ml_io_map_unmappable(CMD_DB_PHYS, CMD_DB_SIZE, VM_WIMG_WCOMB);
+	}
+	if (!smem || !ipcc || !aoss || !rsc || !mutex || !cmd_db) {
+		say("cannot map the blocks\n");
+		mark(M_SMEM, MARK_FAIL);
+		return false;
+	}
+	if (!find_partition()) {
+		say("no SMEM partition 0/2: nothing more\n");
+		mark(M_SMEM, MARK_FAIL);
+		return false;
+	}
+	list[0] = 0;
+	(void)find_item_in(part_offset, part_cacheline, 0, &size, list, sizeof(list));
+	say("partition 0/2 at %#lx, items:%s\n", SMEM_PHYS + part_offset, list);
+	if (their_words(&w)) {
+		show_words("the DSP's item 443 (it has run since power-on)", &w);
+	} else {
+		say("the DSP's item 443: not there (it has not run since power-on)\n");
+	}
+	crash_reason();
+	lcx_addr = cmd_db_lookup("lcx.lvl", &lcx_top, levels, sizeof(levels));
+	say("cmd-db lcx.lvl at %#x, levels%s (highest at position %d)\n", lcx_addr, levels, lcx_top);
+	lmx_addr = cmd_db_lookup("lmx.lvl", &lmx_top, levels, sizeof(levels));
+	say("cmd-db lmx.lvl at %#x, levels%s (highest at position %d)\n", lmx_addr, levels, lmx_top);
+	ce0_addr = cmd_db_lookup("CE0", NULL, NULL, 0);
+	lp0_addr = cmd_db_lookup("LP0", NULL, NULL, 0);
+	say("cmd-db CE0 (the crypto engine's bus clock) at %#x, LP0 (LPASS's bus to DDR) at %#x\n", ce0_addr, lp0_addr);
+	mark(M_SMEM, MARK_OK);
+	mark(M_RSC_AOSS, MARK_BUSY);
+	id = rd(rsc);
+	if ((id >> 16 & 0xff) >= 3) {
+		tcs.wait = 0x20; tcs.control = 0x24; tcs.status = 0x28; tcs.enable = 0x2c; tcs.cmd = 0x34; tcs.stride = 24;
+	}
+	say("RSC drv-2 id %#x (layout v%u): TCS 0 status %#x control %#x; AOSS magic %#x version %u, our link %#x channel "
+	    "%#x\n", id, (id >> 16 & 0xff) >= 3 ? 3 : 2, rd(TCS(tcs.status)), rd(TCS(tcs.control)), rd(aoss), rd(aoss + 4),
+	    rd(aoss + QMP_OUR_LINK), rd(aoss + QMP_OUR_CHANNEL));
+	mark(M_RSC_AOSS, MARK_OK);
+	return true;
+}
+
+/*
+ * Level 3's start, shared by the kit and the service: the rails and CE0 must be in cmd-db; a DSP that reads as running
+ * is stopped first; the crypto engine's vote; then adsp_dtb.mbn to TrustZone (init image + mem setup), copied in with
+ * copy.
+ */
+static bool
+adsp_prepare(bool copy)
+{
+	struct smp2p w;
+
+	if (lcx_addr == 0 || lmx_addr == 0 || lcx_top < 0 || lmx_top < 0 || (ce_wanted && ce0_addr == 0)) {
+		say("the rails or CE0 are not in cmd-db: stopping\n");
+		return false;
+	}
+	if (their_words(&w) && (slave_kernel(&w) & DSP_READY)) {
+		say("the DSP reads as running (slave-kernel %#x): asked to stop and shut down first\n", slave_kernel(&w));
+		(void)our_item_ready();
+		dsp_stop();
+	}
+	mark(M_CE_UP, MARK_BUSY);
+	if (!crypto_vote(true)) {
+		mark(M_CE_UP, MARK_FAIL);
+		return false;
+	}
+	mark(M_CE_UP, MARK_OK);
+	return image_load(&dtb_image, copy, M_DTB_INIT, M_DTB_MEM, M_DTB_COPY);
+}
+
+/*
+ * Level 6's start, shared by the kit and the service, as qcom_pas_start: our SMP2P item, AOSS "on", the rails, the dtb's
+ * auth and reset, adsp.mbn loaded and its auth and reset, then "ready" watched (10 s; with glink_next, ended 1 s after
+ * ready or at the handover). Needs adsp_reads() and the dtb image loaded (image_load) before. Returns -1 if the DSP was
+ * not started (everything given back but finish's part), else 1 if it said ready, 0 if not.
+ */
+static int
+adsp_start(bool glink_next)
+{
+	struct smp2p w;
+
+	mark(M_ITEM, MARK_BUSY);
+	if (!our_item_ready()) {
+		mark(M_ITEM, MARK_FAIL);
+		return -1;
+	}
+	mark(M_ITEM, MARK_OK);
+	mark(M_AOSS_ON, MARK_BUSY);
+	if (!lpass_bus_vote(true) || !qmp_send("{class: image, res: load_state, name: adsp, val: on}")) {
+		mark(M_AOSS_ON, MARK_FAIL);
+		return -1;
+	}
+	mark(M_AOSS_ON, MARK_OK);
+	mark(M_RAILS_UP, MARK_BUSY);
+	if (!rails(true)) {
+		mark(M_RAILS_UP, MARK_FAIL);
+		qmp_send("{class: image, res: load_state, name: adsp, val: off}");
+		return -1;
+	}
+	mark(M_RAILS_UP, MARK_OK);
+	mark(M_DTB_AUTH, MARK_BUSY);
+	dtb_started = scm_ok("auth and reset dtb", SCM_PAS_AUTH_AND_RESET, 1, PAS_ADSP_DTB, 0, 0);
+	mark(M_DTB_AUTH, dtb_started ? MARK_OK : MARK_FAIL);
+	if (dtb_started && image_load(&main_image, true, M_MAIN_INIT, M_MAIN_MEM, M_MAIN_COPY)) {
+		mark(M_MAIN_AUTH, MARK_BUSY);
+		started = scm_ok("auth and reset", SCM_PAS_AUTH_AND_RESET, 1, PAS_ADSP, 0, 0);
+		mark(M_MAIN_AUTH, started ? MARK_OK : MARK_FAIL);
+	}
+	if (!started) {
+		say("the DSP is not started\n");
+		dsp_stop();
+		return -1;
+	}
+	(void)crypto_vote(false);       /* (Linux gives it back after each call) */
+	mark(M_READY, MARK_BUSY);
+	{
+		uint64_t t0 = now_us(), ready = 0;
+		struct smp2p last_words;
+		bool have = false, handed = false;
+		unsigned changes = 0;
+
+		bzero(&last_words, sizeof(last_words));
+		say("TrustZone has started the DSP: watching its SMP2P item for 10 s\n");
+		while (now_us() - t0 < (ready ? 13000000ull : 10000000ull) && !adsp_stop_req) {
+			/* level 7: GLINK as Linux's subdevice start, right after "ready" (and the handover, if it comes soon) */
+			if (glink_next && ready && (handed || now_us() - ready > 1000000ull)) {
+				break;
+			}
+			if (their_words(&w) && (!have || memcmp(&w, &last_words, sizeof(w)) != 0)) {
+				uint32_t s = slave_kernel(&w);
+				char when[64];
+
+				snprintf(when, sizeof(when), "+%llu ms: their item %s", (now_us() - t0) / 1000, have ? "changes" : "appears");
+				if (changes++ < 20) {
+					show_words(when, &w);
+				}
+				last_words = w;
+				have = true;
+				if ((s & DSP_READY) && !ready) {
+					ready = now_us();
+					say("THE ADSP IS UP (slave-kernel %#x) %llu ms after its start\n", s, (ready - t0) / 1000);
+				}
+				if ((s & DSP_HANDOVER) && !handed) {
+					handed = true;
+					say("handover: the DSP has its own votes; ours given back\n");
+					if (rails_held) {
+						rails(false);
+					}
+					(void)lpass_bus_vote(false);    /* (qcom_q6v5_handover_interrupt) */
+				}
+				if (s & DSP_FATAL) {
+					say("THE ADSP HAS GIVEN UP\n");
+					crash_reason();
+					break;
+				}
+			}
+			sleep_ms(1);
+		}
+		if (!ready) {
+			say("%s\n", have ? "the DSP runs but has not said ready" : "not a word from the DSP");
+			crash_reason();
+		}
+		return ready != 0;
+	}
+}
+
+/*
+ * The levels (icedsp=N), each one adding the next riskier kind of access:
+ *   1  RAM only: /chosen's two images and their ELF headers (no register, no SMEM)
+ *   2  + reads: SMEM (partition 0/2, the DSP's SMP2P item, last words), cmd-db (lcx, lmx, CE0), RSC id + TCS 0, AOSS
+ *   3  + the first writes: RPMh CE0 vote, TZ PAS init image + mem setup for adsp_dtb.mbn only (nothing copied)
+ *   4  + adsp_dtb.mbn copied in (read back), adsp.mbn init image + mem setup + copied in (read back); not started
+ *   5  + the power path without a start: our SMP2P item, AOSS "adsp on", lcx/lmx up, 2 s, rails back, AOSS "off"
+ *   7  as 6, and once the DSP is up: GLINK over SMEM (version, the DSP's channels listed, icedsp_glink_s (8) s; mark 21)
+ *   8  + "IPCRTR", "adsp_apps", "glink_ssr" opened both ways, 48 receive intents offered (24/16/8), closed at the end
+ *   9  + QRTR on IPCRTR: HELLO both ways, the DSP's NEW_SERVER list (mark 22)
+ *  10  + GPR on adsp_apps: APM_CMD_GET_SPF_STATE (asked again after 1 s), then a PRM GET_CFG (mark 23; icedsp_glink_s 12)
+ *  11  + sensors over SNS (QMI 400): SUID accel / ambient_light, accel at icedsp_rate (10) Hz for 5 s, disabled (mark 24; 22 s)
+ *   6  + the start as Linux's qcom_pas_start: power, dtb auth and reset, adsp.mbn init + copy + auth and reset,
+ *        "ready" watched 10 s, held icedsp_hold (15) s, stopped (icedsp_keep=1: left running)
+ * Before run ipad16 (01:43, hung) there were three: 1 = today's 2, 2 = today's 4 (without the CE0 vote), 3 = 6.
+ * icedsp_ce=0: no CE0 vote (as ipad16); icedsp_ddr=0: no LP0 vote (levels 5, 6; mark 9 covers it with AOSS "on").
+ * All TZ calls under hakios_iceland_scm_lock (shared with the GPU kit). The thread runs bound to the highest-numbered processor, never the boot
+ * processor (which loader_return_after's end of the run needs).
+ */
+static void
+icedsp_levels(void *parameter)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)parameter, hold_s = 15, keep = 0, ce = 1, ddr = 1;
+	int last = ml_get_max_cpu_number();
+	struct smp2p w;
+
+	PE_parse_boot_argn("icedsp_hold", &hold_s, sizeof(hold_s));
+	PE_parse_boot_argn("icedsp_keep", &keep, sizeof(keep));
+	PE_parse_boot_argn("icedsp_ce", &ce, sizeof(ce));
+	ce_wanted = ce != 0;
+	PE_parse_boot_argn("icedsp_ddr", &ddr, sizeof(ddr));
+	lp0_wanted = ddr != 0;
+	if (last > 0 && cpu_to_processor(last) != PROCESSOR_NULL) {
+		thread_bind(cpu_to_processor(last));
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	sleep_ms(3000);
+	{
+		uint32_t audio = 0;
+
+		if (PE_parse_boot_argn("iceaudio", &audio, sizeof(audio)) && audio != 0) {
+			smmu_survey();          /* read only, before anything else */
+		}
+	}
+	say("stage %u (hold %u s, keep %u, crypto vote %u), on cpu %d of 0..%d\n", stage, hold_s, keep, ce, cpu_number(),
+	    last);
+
+	/* 1: RAM only */
+	mark(M_PARSE, MARK_BUSY);
+	bool have_dtb = image_find(&dtb_image), have_main = image_find(&main_image);
+
+	mark(M_PARSE, have_dtb && have_main ? MARK_OK : MARK_FAIL);
+	if ((!have_dtb || !have_main) && stage > 2) {
+		say("an image is missing: reads only (level 2)\n");
+		stage = 2;
+	}
+	if (stage < 2 || psci_smp_hvc) {
+		if (psci_smp_hvc && stage >= 2) {
+			say("PSCI is over hvc here: QEMU, not the Pad: level 1 only, no block touched\n");
+		}
+		finish(have_dtb && have_main);
+		return;
+	}
+
+	/* 2: reads */
+	if (!adsp_reads()) {
+		finish(false);
+		return;
+	}
+	if (stage < 3) {
+		finish(true);
+		return;
+	}
+	/* 3: the crypto engine's vote, then TrustZone for the dtb image (copied from level 4 on) */
+	if (!adsp_prepare(stage >= 4)) {
+		finish(false);
+		return;
+	}
+	if (stage < 4) {
+		say("icedsp=3: TrustZone took adsp_dtb.mbn's metadata and region; nothing copied, not started\n");
+		finish(true);
+		return;
+	}
+
+	/* 4, 5: the main image too, and (5) the power path; not started */
+	if (stage < 6) {
+		/*
+		 * (Not Linux's order: qcom_pas_start TZ-initialises adsp.mbn only after the dtb's auth and reset. A refusal here
+		 * says nothing about level 6, so level 5 goes on to the power path all the same.)
+		 */
+		bool main_ok = image_load(&main_image, true, M_MAIN_INIT, M_MAIN_MEM, M_MAIN_COPY);
+
+		if (!main_ok && stage < 5) {
+			finish(false);
+			return;
+		}
+		say("icedsp=4: %s; not started\n", main_ok ? "both images in place and accepted by TrustZone" :
+		    "adsp.mbn not taken before the dtb's auth (Linux never asks that early): the power path all the same");
+		if (stage == 5) {
+			bool ok;
+
+			mark(M_ITEM, MARK_BUSY);
+			ok = our_item_ready();
+			mark(M_ITEM, ok ? MARK_OK : MARK_FAIL);
+			if (ok) {
+				mark(M_AOSS_ON, MARK_BUSY);
+				ok = lpass_bus_vote(true) && qmp_send("{class: image, res: load_state, name: adsp, val: on}");
+				mark(M_AOSS_ON, ok ? MARK_OK : MARK_FAIL);
+			}
+			if (ok) {
+				mark(M_RAILS_UP, MARK_BUSY);
+				ok = rails(true);
+				mark(M_RAILS_UP, ok ? MARK_OK : MARK_FAIL);
+				sleep_ms(2000);
+			}
+			mark(M_POWER_DOWN, MARK_BUSY);
+			if (rails_held) {
+				rails(false);
+			}
+			qmp_send("{class: image, res: load_state, name: adsp, val: off}");
+			(void)lpass_bus_vote(false);
+			(void)crypto_vote(false);
+			mark(M_POWER_DOWN, MARK_OK);
+			say("icedsp=5: the power path went up and down again (%s); not started\n", ok ? "every step taken" :
+			    "NOT every step taken");
+			finish(ok && main_ok);
+			return;
+		}
+		finish(true);
+		return;
+	}
+
+	/* 6: start, as qcom_pas_start */
+	int st = adsp_start(stage >= 7);
+
+	if (st < 0) {
+		finish(false);
+		return;
+	}
+	bool up = st > 0;
+	if (stage >= 7) {
+		uint32_t glink_s = stage >= 11 ? 22 : stage >= 10 ? 12 : 8, audio = 0;
+
+		if (((PE_parse_boot_argn("iceaudio", &audio, sizeof(audio)) && audio != 0) ||
+		    (PE_parse_boot_argn("icesmmu", &audio, sizeof(audio)) && audio != 0)) && glink_s < 30) {
+			glink_s = 30;
+		}
+		if (PE_parse_boot_argn("icemic", &audio, sizeof(audio)) && audio != 0 && glink_s < 20) {
+			glink_s = 20;
+		}
+		if (ice_rec()) {        /* round 6: the microphone comes after the sound service: listen until the run's end */
+			uint32_t end = 0;
+
+			glink_s = PE_parse_boot_argn("reset-after", &end, sizeof(end)) && end > 60 ? end - 14 : 600;
+		}
+
+		PE_parse_boot_argn("icedsp_glink_s", &glink_s, sizeof(glink_s));
+		if (up && !adsp_stop_req) {
+			(void)glink_listen(stage, glink_s);
+		} else {
+			mark(M_GLINK, MARK_FAIL);
+			if (stage >= 9) {
+				mark(M_QRTR, MARK_FAIL);
+			}
+			if (stage >= 10) {
+				mark(M_GPR, MARK_FAIL);
+			}
+			if (stage >= 11) {
+				mark(M_SNS, MARK_FAIL);
+			}
+			say("GLINK: not tried (the DSP is not up)\n");
+		}
+	}
+	if (keep && !adsp_stop_req) {
+		mark(M_READY, up ? MARK_OK : MARK_FAIL);
+		image_done(&main_image);
+		image_done(&dtb_image);
+		say("icedsp_keep=1: left running (the run's end stops it: hakios_iceland_adsp_stop / _quiesce)\n");
+		mark(M_DONE, up ? MARK_OK : MARK_FAIL);
+		return;
+	}
+	for (uint32_t ms = 0; ms < hold_s * 1000 && !adsp_stop_req; ms += 50) {
+		sleep_ms(50);
+	}
+	mark(M_READY, up ? MARK_OK : MARK_FAIL);
+	say("stopping after %s\n", adsp_stop_req ? "the run's end asked" : "the hold");
+	dsp_stop();
+	if (their_words(&w)) {
+		show_words("their item after the stop", &w);
+	}
+	banks_down();           /* (bank 8 may have been left set for a late answer, or by icefrpc_keep=1) */
+	finish(up);
+}
+
+static void
+icedsp_thread(void *parameter, __unused wait_result_t result)
+{
+	icedsp_levels(parameter);
+	adsp_thread_live = 0;
+}
+
+/*
+ * ---- The speaker amplifiers (boot-arg iceamp=N, audio level A) ------------------------------------------------------
+ * The Pad's speakers: six TFA9865 ("goodix,tfa9865-iceland", the project's sound/soc/codecs/tfa9865.c), fed by LPASS
+ * PRIMARY_TDM_RX_0. Two buses (kaanapali-oneplus-iceland.dts):
+ *   i2c0  (i2c@a80000, QUP1 SE0; qup_i2c0_data_clk: SDA gpio80, SCL gpio83, bias-pull-up): TopLeft 0x34 (reset gpio2),
+ *         BottomLeft 0x36 (gpio114), MidLeft 0x37 (gpio115);
+ *   i2c22 (i2c@1a8c000, QUP4 SE3; qup_i2c22_data_clk: SDA gpio121, SCL gpio84): TopRight 0x34 (gpio160), BottomRight
+ *         0x36 (gpio116), MidRight 0x37 (gpio117);
+ * resets active low; vddio vreg_l15b_1p8. None of these pins is in the DT's gpio-reserved-ranges (36-43, 74, 119-120,
+ * 144-147). The serial engines are not used: on this SoC their FIFO interface may be disabled (DT: GPI DMA), and an
+ * unclocked serial engine must not be read -- as the touch kit does for its SPI, the two lines are driven by hand
+ * (open drain: a line is pulled low by enabling the pin's output at 0, and released by disabling it; the DT's pull-up
+ * does the rest), at about 100 kHz, clock stretching honoured, and given back to the serial engine as found.
+ * tfa9865.c: 8-bit register numbers, 16-bit values, most significant byte first (regmap default); PRODUCT 0x03 reads
+ * 0x9866 (TFA9864/65/66 told apart by 0xf3/0xf4), DEVICE_CONTROL 0x00 (bit 0 power down, bit 1 reset, bit 3 amplifier),
+ * SYS_CONTROL1 0x01 (bit 2 MANSCONF), STATUS2 0x12 (manager state, bits 0-3).
+ *   iceamp=1  read only: the six reset pins and four bus pins reported; per bus, the lines checked idle; each amplifier
+ *             addressed and PRODUCT, DEVICE_CONTROL, SYS_CONTROL1, STATUS2 read (a register read = the register number
+ *             written as the pointer, then a repeated-start read: no amplifier register is written). Nothing else.
+ *   iceamp=2  level B: + each amplifier initialised as tfa9865_i2c_probe (amp_init), left powered down and muted, read
+ *             back (amp_check); every write logged (iceamp_log=0: only failures).
+ */
+#define AMP_TLMM_PHYS           0x0f100000UL
+#define AMP_TLMM_SIZE           0xb0000UL               /* up to gpio175: ours go to gpio160 */
+#define AMP_CTL(n)              (amp_tlmm + 0x1000UL * (n))
+#define AMP_IO(n)               (amp_tlmm + 0x1000UL * (n) + 0x4)
+#define AMP_CTL_OE              (1u << 9)
+#define AMP_CTL_EGPIO_PRESENT   (1u << 11)
+#define AMP_CTL_EGPIO_ENABLE    (1u << 12)
+#define AMP_PULL_UP             3u
+
+static vm_offset_t amp_tlmm;
+static unsigned amp_sda, amp_scl;
+static volatile bool amp_thread_busy;   /* iceamp's thread owns the two buses (level D waits for it) */
+static uint32_t amp_half_ticks;         /* the half period in timebase ticks; 0: not set yet (5 us: a 100 kHz clock) */
+static uint32_t amp_ms_ticks;           /* 1 ms in timebase ticks */
+static uint32_t amp_khz = 100;
+
+/* the bus clock in timebase ticks, whatever a tick is (19.2 MHz: 96 a half period at 100 kHz; icetb24: 120) */
+static void
+amp_set_khz(uint32_t khz)
+{
+	uint64_t t = 0;
+
+	amp_khz = khz;
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &t);
+	amp_ms_ticks = (uint32_t)t;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / (2000ull * khz), &t);
+	amp_half_ticks = t ? (uint32_t)t : 1;         /* last: the waits take a half period of 0 as "not set yet" */
+}
