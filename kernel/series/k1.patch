+/*
+ * GenericARMPE: a minimal platform expert for non-Apple ARMv8 boards.
+ *
+ * On Apple hardware the platform expert comes from a closed kext
+ * (AppleARMPlatform). Without one, IOKit falls through to IOPanicPlatform
+ * ("Unable to find driver for this platform"). This class is the least that
+ * lets IOKit start on a board described by a loader-built device tree:
+ * it publishes the device-tree nodes as nubs and names the machine.
+ */
+extern "C" {
+#include <pexpert/pexpert.h>
+
+#include <pexpert/arm64/board_config.h>
+#include <kern/cpu_number.h>
+void hakios_iceland_usbcon_init(void);
+void hakios_iceland_cpu_init(void);
+void hakios_iceland_gpu_init_early(void);
+}
+#include <machine/machine_routines.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOCPU.h>
+#include <kern/clock.h>
+#include <kern/thread_call.h>
+
+#include "MiniDrivers.h"
+
+extern "C" {
+kern_return_t processor_start(processor_t processor);
+kern_return_t processor_exit(processor_t processor);
+extern uint32_t processor_avail_count;
+
+/* osfmk/arm64/psci_smp.c and gic_v3_irq.c */
+void psci_smp_init(void);
+kern_return_t psci_smp_start_cpu(int cpu);
+void psci_smp_cpu_running(void);
+void psci_smp_cpu_off(void) __dead2;
+void gic_v3_irq_signal(uint32_t phys_id);
+}
+
+/*
+ * GenericARMCPU: registers a device-tree CPU node with the kernel. The closed
+ * AppleARMCPU driver does this on Apple hardware; without it the kernel waits
+ * forever for the CPU count (ml_wait_max_cpus) and never calls
+ * cpu_machine_init() on the boot processor.
+ *
+ * The other processors are started through the firmware (PSCI CPU_ON, see
+ * osfmk/arm64/psci_smp.c) and signalled with interrupts of the GIC
+ * (osfmk/arm64/gic_v3_irq.c). How many there are is the device tree's and the
+ * boot-arg cpus=N's to say (ml_parse_cpu_topology()); with one, nothing of
+ * that is used.
+ */
+class GenericARMCPU : public IOCPU
+{
+	OSDeclareDefaultStructors(GenericARMCPU);
+
+	uint32_t physID;        /* the device tree's "reg": the low affinity fields of the core's MPIDR */
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	virtual void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	virtual kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	virtual void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	virtual void signalCPU(IOCPU * target) APPLE_KEXT_OVERRIDE;
+	virtual const OSSymbol * getCPUName(void) APPLE_KEXT_OVERRIDE;
+
+	static int cpuNumberOfNub(IOService * nub);
+	bool registerProcessor(int cpu);
+	bool takeTurn(int cpu);
+	void run(void);
+};
+
+OSDefineMetaClassAndStructors(GenericARMCPU, IOCPU);
+
+/* The kernel's number for the processor of a /cpus node, -1 if it is not to be used (boot-arg cpus=N). */
+int
+GenericARMCPU::cpuNumberOfNub(IOService * nub)
+{
+	OSData * reg = OSDynamicCast(OSData, nub->getProperty("reg"));
+
+	if (nub->getProperty("state") == NULL || reg == NULL || reg->getLength() < sizeof(uint32_t)) {
+		return -1;
+	}
+	return ml_get_cpu_number(*(const uint32_t *)reg->getBytesNoCopy());
+}
+
+/*
+ * IOKit matches this driver to the /cpus nubs itself (iokit/KernelConfigTables.cpp, IOProbeScore
+ * 2000), as UniXNU's ArmCpu is matched: a prelinked collection brings Apple's AppleARMCPU
+ * (IOPlatformDevice, IONameMatch "cpu", IOProbeScore 100, the same match category), and a driver
+ * attached by hand does not hold the category. The starts are serialized.
+ *
+ * The boot processor registers first. IOKit matches the nubs in no fixed order, each on an
+ * IOConfigThread of its own, and on xnu-12377 ml_processor_register() boots the processor it
+ * registers (processor_boot(), osfmk/arm64/machine_routines.c; processor_start() is
+ * processor_start_from_kext(), a no-op). A secondary registered first was started at once while
+ * the boot processor's cpu_data still had no cpu_id, and the boot processor's first IPI to it,
+ * PE_cpu_signal_deferred(getCpuDatap()->cpu_id, ...) (osfmk/arm/cpu_common.c), called through
+ * that NULL: a data abort at PE_cpu_signal_deferred with x0 0 (QEMU cpus=2, runs/t3-prep). The
+ * hand-attached drivers before 775d9e9 went in /cpus order, the boot processor first. As UniXNU's
+ * ArmCpu does it (github.com/UniXNU/ArmCpu d90e457, BSD-2-Clause-Patent: ArmCpu.cpp:275-278 gPending
+ * and gBootRegistered, 529-541 a secondary's start(), 578-623 the boot nub's start() and
+ * drainPending(); the same in UniXNU's pin 93a5030, which piano boots 8 CPUs with): a secondary
+ * that starts before the boot processor has registered waits in gGenericARMCPUsWaiting without
+ * blocking its thread (it must not sleep for the boot processor), and the boot processor registers
+ * it right after itself; a later one registers itself.
+ */
+static IOLock * gGenericARMCPULock;                 /* allocated by GenericARMPE::start() before the nubs exist */
+static GenericARMCPU * gGenericARMCPUs[MAX_CPUS];   /* kept: the kernel has the address as the cpu's id */
+static GenericARMCPU * gGenericARMCPUsWaiting[MAX_CPUS];    /* started before the boot processor's turn */
+static bool gGenericARMCPUsBootTurn;                /* the boot processor has had its turn */
+static unsigned int gGenericARMCPUsTried;
+static unsigned int gGenericARMCPUsRegistered;
+
+static void GenericARMCPUsRegistered(unsigned int count);
+
+/* Every processor the kernel has a number for has had its turn: the count is settled. */
+static void
+GenericARMCPUsCountTurn(void)
+{
+	if (++gGenericARMCPUsTried == ml_get_topology_info()->num_cpus) {
+		GenericARMCPUsRegistered(gGenericARMCPUsRegistered);
+	}
+}
+
+bool
+GenericARMCPU::start(IOService * provider)
+{
+	int cpu = cpuNumberOfNub(provider);
+	bool ok;
+
+	if (cpu < 0 || cpu >= MAX_CPUS || gGenericARMCPULock == NULL) {
+		return false;
+	}
+	IOLockLock(gGenericARMCPULock);
+	if (gGenericARMCPUs[cpu] != NULL || gGenericARMCPUsWaiting[cpu] != NULL) {
+		IOLockUnlock(gGenericARMCPULock);
+		return false;
+	}
+	if (!IOCPU::start(provider)) {
+		GenericARMCPUsCountTurn();
+		IOLockUnlock(gGenericARMCPULock);
+		return false;
+	}
+	physID = ml_get_topology_info()->cpus[cpu].phys_id;
+	setCPUNumber((UInt32)cpu);
+	retain();
+	if (cpu != boot_cpu_id && !gGenericARMCPUsBootTurn) {
+		/* Not before the boot processor: it registers this one right after itself. */
+		gGenericARMCPUsWaiting[cpu] = this;
+		ok = true;
+	} else {
+		ok = takeTurn(cpu);
+		if (cpu == boot_cpu_id) {
+			gGenericARMCPUsBootTurn = true;
+			for (int number = 0; number < MAX_CPUS; number++) {
+				GenericARMCPU * waiting = gGenericARMCPUsWaiting[number];
+
+				if (waiting != NULL) {
+					gGenericARMCPUsWaiting[number] = NULL;
+					waiting->takeTurn(number);
+				}
+			}
+		}
+	}
+	IOLockUnlock(gGenericARMCPULock);
+	return ok;
+}
+
+/*
+ * With the lock held: registers the processor (which boots it), but no other before the boot processor is
+ * registered, and counts the turn. The reference start() took is kept for gGenericARMCPUs or dropped.
+ */
+bool
+GenericARMCPU::takeTurn(int cpu)
+{
+	bool ok = (cpu == boot_cpu_id || gGenericARMCPUs[boot_cpu_id] != NULL) && registerProcessor(cpu);
+
+	if (ok) {
+		gGenericARMCPUs[cpu] = this;
+		gGenericARMCPUsRegistered++;
+	} else {
+		release();
+	}
+	GenericARMCPUsCountTurn();
+	return ok;
+}
+
+/* Registers the processor, and with it boots it (ml_processor_register(): processor_boot()). */
+bool
+GenericARMCPU::registerProcessor(int cpu)
+{
+	ml_processor_info_t info;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	const ml_topology_cpu_t * topology = &ml_get_topology_info()->cpus[cpu];
+
+	bzero(&info, sizeof(info));
+	info.cpu_id = (cpu_id_t)this;
+	info.log_id = getCPUNumber();
+	info.phys_id = physID;
+	info.cluster_id = topology->cluster_id;
+	info.cluster_type = topology->cluster_type;
+	/*
+	 * S7 item B: an idle latency, so short delays spin. ml_processor_register() turns it into cpu_idle_latency
+	 * (machine_routines.c:1738), which ml_delay_should_spin() compares a delay with; at 0 every delay_for_interval/IODelay,
+	 * 1 us included, blocked on the one wait queue all delaying threads share, and the idle loop asked for no early pop.
+	 * 25 us is Droid-VM ArmCpu 5265ef1's value ("each CPU reports a 25 us idle latency, so short delays spin": with 0, its
+	 * guests' polling drivers queued on that wait queue's lock until it timed out, lock-timeout panics). Not more: a
+	 * longer one makes delays spin longer.
+	 */
+	info.powergate_latency = 25 * NSEC_PER_USEC;
+	if (ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler) != KERN_SUCCESS) {
+		IOLog("GenericARMCPU: ml_processor_register failed\n");
+		return false;
+	}
+
+	setCPUState(kIOCPUStateUninitalized);
+	registerService();
+	IOLog("GenericARMCPU: cpu %u (phys id 0x%x) registered\n", (unsigned)getCPUNumber(), physID);
+	return true;
+}
+
+/*
+ * The boot processor: runs cpu_machine_init() -> initCPU(true) on it, right here.
+ * Any other: cpu_start() -> startCPU(), and the new core comes to initCPU() by itself.
+ */
+void
+GenericARMCPU::run(void)
+{
+	processor_start(machProcessor);
+}
+
+/* On the processor itself, with its interrupts off, when it joins (or rejoins) the scheduler. */
+void
+GenericARMCPU::initCPU(bool boot)
+{
+	/* The interrupt controller and timer were set up in arm_init / arm_init_cpu (pe_init_fiq). */
+	setCPUState(kIOCPUStateRunning);
+	if (ml_get_cpu_count() > 1) {
+		psci_smp_cpu_running();
+		/*
+		 * A processor takes no signals until it has handled an interrupt for one
+		 * (cpu_signal_handler() lifts SIGPdisabled), and until then it does not go to
+		 * sleep when idle either: send it its first.
+		 */
+		gic_v3_irq_signal(physID);
+	}
+}
+
+/* On the processor itself, at the end of processor_exit(): it is to stop for good. */
+void
+GenericARMCPU::quiesceCPU(void)
+{
+	if (getCPUNumber() != (UInt32)boot_cpu_id) {
+		setCPUState(kIOCPUStateStopped);
+		psci_smp_cpu_off();
+	}
+}
+
+kern_return_t
+GenericARMCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
+{
+	return psci_smp_start_cpu((int)getCPUNumber());
+}
+
+void
+GenericARMCPU::haltCPU(void)
+{
+	if (getCPUNumber() != (UInt32)boot_cpu_id) {
+		processor_exit(machProcessor);
+	}
+}
+
+void
+GenericARMCPU::signalCPU(IOCPU * target)
+{
+	gic_v3_irq_signal(((GenericARMCPU *)target)->physID);
+}
+
+const OSSymbol *
+GenericARMCPU::getCPUName(void)
+{
+	char name[32];
+	snprintf(name, sizeof(name), "Primary%u", (unsigned)getCPUNumber());
+	return OSSymbol::withCString(name);
+}
+
+/*
+ * All the processors are registered (GenericARMCPU::start(), with its lock held): that settles the
+ * CPU count. Start them, the boot processor (number boot_cpu_id: master_cpu is never set on
+ * xnu-12377 and stayed -1) first.
+ */
+static void
+GenericARMCPUsRegistered(unsigned int count)
+{
+	GenericARMCPU ** cpus = gGenericARMCPUs;
+
+	if (cpus[boot_cpu_id] != NULL) {
+		/* Unblocks everything that waits for the CPU count to be known. */
+		ml_set_max_cpus(count);
+		if (count > 1) {
+			psci_smp_init();
+		}
+		/*
+		 * The slower cores (an L2 access penalty, the loader's "small-core") are started 28 seconds
+		 * later (boot-arg small_cores_after=S; 0: at once). With all seven from the start the lock
+		 * screen came 1.5 s later than with the four big ones alone (26.5-27.0 s after the kernel
+		 * began instead of 25.3-25.5: start-up's other work shares memory and cache with
+		 * SpringBoard's), while that work as a whole was done earlier (34 s instead of 38). With
+		 * the slower cores joining once the lock screen is there: 25.3 s and 36 s.
+		 */
+		uint32_t later = 28;
+		static thread_call_t later_call;
+
+		PE_parse_boot_argn("small_cores_after", &later, sizeof(later));
+		cpus[boot_cpu_id]->run();
+		for (unsigned int number = 0; number < MAX_CPUS; number++) {
+			if (cpus[number] != NULL && number != (unsigned int)boot_cpu_id) {
+				if (later != 0 && ml_get_topology_info()->cpus[number].l2_access_penalty != 0) {
+					continue;
+				}
+				cpus[number]->run();
+			}
+		}
+		if (later != 0) {
+			uint64_t deadline;
+
+			later_call = thread_call_allocate([](thread_call_param_t, thread_call_param_t) {
+				for (unsigned int number = 0; number < MAX_CPUS; number++) {
+					if (gGenericARMCPUs[number] != NULL && ml_get_topology_info()->cpus[number].l2_access_penalty != 0) {
+						gGenericARMCPUs[number]->run();
+					}
+				}
+				IOLog("GenericARMPE: the slower cores started too: %u processors running\n", processor_avail_count);
+			}, NULL);
+			clock_interval_to_deadline(later, NSEC_PER_SEC, &deadline);
+			thread_call_enter_delayed(later_call, deadline);
+		}
+		if (count > 1) {
+			IOLog("GenericARMPE: %u of %u processors are running\n", processor_avail_count, count);
+			if (count > 2) {
+				/*
+				 * S7 item 5: the two-cluster policy for 8 cores is UniXNU's 13T one, Clutch with one processor set
+				 * (UniXNU-sm8750-common sm8750-smp.patch, 37ccfbe; oneplus13t.toml:125: two psets, one per cluster,
+				 * hit Clutch's steal callback returning with pset0's lock held and thread_select taking it again; one
+				 * pset gave "CPU reg=8 online=8"). This board is not __ARM_AMP__ (board_config.h) and has no
+				 * cluster-type in its device trees, so ml_bootstrap_processors() puts every core in the boot pset
+				 * ("Non-AMP ARM platforms only support one pset") and ml_parse_cpu_topology() makes one cluster;
+				 * sched_clutch.c keeps UniXNU's multiple_psets_enabled = FALSE for the day it is not. This line shows
+				 * the cores' psets (cpu_pset_id, set at STARTUP(SCHED)) on the tablet. 1 and 2 cores: no line.
+				 */
+				const ml_topology_info_t *topo = ml_get_topology_info();
+				uint64_t psets = 0;
+				unsigned int sets = 0;
+				for (unsigned int i = 0; i < topo->num_cpus; i++) {
+					unsigned int id = topo->cpus[i].cpu_pset_id;
+					if (id < 64 && !(psets & (1ULL << id))) {
+						psets |= 1ULL << id;
+						sets++;
+					}
+				}
+				IOLog("GenericARMPE: %u cores, %u cluster%s, %u processor set%s (mask 0x%llx): Clutch, one pset (S7 item 5)\n",
+				    topo->num_cpus, topo->num_clusters, topo->num_clusters == 1 ? "" : "s", sets, sets == 1 ? "" : "s",
+				    (unsigned long long)psets);
+			}
+			hakios_iceland_cpu_init();      /* boot-arg icecpu=N (bsd/dev/hakios_iceland_cpu.c): with the cores up, before the root */
+		}
+		hakios_iceland_gpu_init_early();        /* boot-args icegpu=N icegpu_early=1 (hakios_iceland_gpu.c, S11 g6): before the root */
+	}
+}
+
+class GenericARMPE : public IODTPlatformExpert
+{
+	OSDeclareDefaultStructors(GenericARMPE);
+
+public:
+	virtual IOService * probe(IOService * provider, SInt32 * score) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual const char * deleteList(void) APPLE_KEXT_OVERRIDE;
+	virtual const char * excludeList(void) APPLE_KEXT_OVERRIDE;
+	virtual bool getMachineName(char * name, int maxLength) APPLE_KEXT_OVERRIDE;
+	virtual long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
+	virtual void setGMTTimeOfDay(long secs) APPLE_KEXT_OVERRIDE;
+};
+
+#define super IODTPlatformExpert
+
+OSDefineMetaClassAndStructors(GenericARMPE, IODTPlatformExpert);
+
+IOService *
+GenericARMPE::probe(IOService * provider, SInt32 * score)
+{
+	/*
+	 * IODTPlatformExpert::probe() wants an IONameMatch against the root
+	 * node; this expert is the only one built in, so it takes any board.
+	 */
+	if (!IOPlatformExpert::probe(provider, score)) {
+		return NULL;
+	}
+	return this;
+}
+
+bool
+GenericARMPE::start(IOService * provider)
+{
+	/*
+	 * super::start() publishes the /cpus children as nubs, and IOKit matches a GenericARMCPU to
+	 * each one the kernel has a number for (iokit/KernelConfigTables.cpp); the last of them to
+	 * register starts the processors (GenericARMCPUsRegistered()). Their lock has to exist first.
+	 */
+	if (gGenericARMCPULock == NULL) {
+		gGenericARMCPULock = IOLockAlloc();
+	}
+	if (!super::start(provider)) {
+		return false;
+	}
+	IOLog("GenericARMPE: platform \"%s\"\n", provider->getName());
+	/*
+	 * boot-arg iceusb=N (bsd/dev/hakios_iceland_usbcon.c): the Pad's USB serial console. Here, before the cores and the
+	 * root wait, so that a boot that never reaches its root still streams; unset, it returns at its first test.
+	 */
+	hakios_iceland_usbcon_init();
+
+	/* BSD looks the platform expert up by class (IOSecureBSDRoot). */
+	registerService();
+
+	/*
+	 * Stand-ins for the closed graphics drivers that the iOS window server talks to. Not in the macOS
+	 * kernel: the prelinked collection brings Apple's own IOSurface, IOMobileGraphicsFamily,
+	 * IONetworkingFamily, AppleMobileFileIntegrity and AppleARMPlatform, and a stand-in would make those
+	 * kexts fail on the duplicate class. The key store stays in both: no SEP answers for it either way.
+	 */
+#if !defined(XNU_TARGET_OS_OSX)
+	MiniIOSurfaceStart(this);
+	MiniIOMobileFramebufferStart(this);
+	HakiosIcelandBacklightUIStart(this);    /* boot-arg icebl_ui=1: iPadOS's brightness to the Pad's backlight */
+#endif
+#if defined(XNU_TARGET_OS_OSX)
+	HakiosIcelandBacklightUIStart(this);    /* w3-keys, boot-arg icebl_ui=1: macOS's brightness (corebrightnessd) to the Pad's backlight */
+#endif
+	MiniAppleKeyStoreStart();
+#if !defined(XNU_TARGET_OS_OSX)
+	HakiosIcelandAMFIStart();      /* boot-arg iceamfi=1: AppleMobileFileIntegrity for user space (kit 29hot1) */
+	MiniIONetworkStackStart();
+#endif
+	return true;
+}
+
+/*
+ * The time of day. There is no driver for a real-time clock here; whoever started the kernel
+ * says what time it was then -- the boot-arg epoch= (seconds since 1970, put there by the
+ * host scripts) or, failing that, the property boot-epoch of /chosen (the loader, from the
+ * firmware's clock) -- and the kernel's own timer counts from there. Without either the
+ * calendar starts in 1970, as before.
+ */
+static long gBootEpoch;         /* the calendar time at which the system timer read zero */
+static bool gBootEpochKnown;
+
+static void
+findBootEpoch(void)
+{
+	uint64_t epoch = 0;
+
+	if (gBootEpochKnown) {
+		return;
+	}
+	gBootEpochKnown = true;
+	if (!PE_parse_boot_argn("epoch", &epoch, sizeof(epoch)) || epoch == 0) {
+		IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+		OSData * data = chosen ? OSDynamicCast(OSData, chosen->getProperty("boot-epoch")) : NULL;
+
+		if (data != NULL && data->getLength() == sizeof(epoch)) {
+			memcpy(&epoch, data->getBytesNoCopy(), sizeof(epoch));
+		}
+		OSSafeReleaseNULL(chosen);
+	}
+	if (epoch != 0) {
+		clock_sec_t secs;
+		clock_usec_t usecs;
+
+		clock_get_system_microtime(&secs, &usecs);
+		gBootEpoch = (long) epoch - (long) secs;
+	}
+}
+
+long
+GenericARMPE::getGMTTimeOfDay(void)
+{
+	clock_sec_t secs;
+	clock_usec_t usecs;
+
+	findBootEpoch();
+	if (gBootEpoch == 0) {
+		return 0;
+	}
+	clock_get_system_microtime(&secs, &usecs);
+	return gBootEpoch + (long) secs;
+}
+
+void
+GenericARMPE::setGMTTimeOfDay(long secs)
+{
+	clock_sec_t uptime;
+	clock_usec_t usecs;
+
+	clock_get_system_microtime(&uptime, &usecs);
+	gBootEpoch = secs - (long) uptime;
+	gBootEpochKnown = true;
+}
+
+/* Device-tree nodes to drop entirely. */
+const char *
+GenericARMPE::deleteList(void)
+{
+	return "('packages', 'psuedo-usb', 'psuedo-hid', 'multiboot', 'rtas')";
+}
+
+/* Top-level nodes that describe boot state rather than devices: no nubs for these. */
+const char *
+GenericARMPE::excludeList(void)
+{
+	return "('chosen', 'memory', 'options', 'aliases', 'defaults', 'pram', 'cpus')";
+}
+
+/*
+ * hw.machine. On Apple's devices it is the product type ("iPhone10,3"), from the device tree's
+ * "model", and iOS decides from it what kind of device it is on: with anything it does not know
+ * MobileGestalt settles for an iPod touch.
+ */
+bool
+GenericARMPE::getMachineName(char * name, int maxLength)
+{
+	uint32_t real = 1;
+
+	/*
+	 * hw.machine is the model the loader put into the device tree, "iPhone10,3". It has to
+	 * begin with "iPhone": CoreFoundation picks the device-specific variants of resources
+	 * (Something~iphone.plist, Key~iphone in an Info.plist) by this string, and for a name it
+	 * does not know it picks none at all -- Control Center, for one, then lays its modules out
+	 * without their sizes. (boot-arg machine_name=0: the plain "arm64" this used to be.)
+	 */
+	PE_parse_boot_argn("machine_name", &real, sizeof(real));
+	if (!real || !IODTPlatformExpert::getMachineName(name, maxLength) || name[0] == 0) {
+		strlcpy(name, "arm64", maxLength);
+	}
+	return true;
+}
diff --git a/iokit/Kernel/HakiosIcelandAMFI.cpp b/iokit/Kernel/HakiosIcelandAMFI.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8cc3eba8bb337045d025b841a446a33581d1b9a6
--- /dev/null
+++ b/iokit/Kernel/HakiosIcelandAMFI.cpp
@@ -0,0 +1,161 @@
+/*
+ * HakiosIcelandAMFI: an IOService named AppleMobileFileIntegrity for user space (kit 29hot1), boot-arg iceamfi=1,
+ * off without it.
+ *
+ * libkern/amfi/miniamfi.c gives the kernel AMFI's interface, but there is no AppleMobileFileIntegrity service in the
+ * I/O Registry, so a user-space query of it finds nothing. ExtensionFoundation (+[NSDictionary
+ * _EX_dictionaryWithSignedURL:]) asks AMFI's user client whether a cdhash is in the trust cache before it reads a
+ * signed extension-point cache; with no answer lsd has no extension points, MobileInstallation rejects every app
+ * extension, LaunchServices registers none -- widgets ("Unable to load a valid LSApplicationProxy" for
+ * WidgetRenderer_Default, kits 20p / 29c) and PosterBoard's poster providers among them.
+ *
+ * Here: the service on IOResources with a user client; selector 6 (the trust-cache query: a scalar and the cdhash as a
+ * structure) answers kIOReturnSuccess, "trusted"; every other selector answers kIOReturnUnsupported, which is what
+ * callers got from the missing service before. This kernel enforces no code signature and keeps no trust cache, so
+ * there is nothing to check a cdhash against. Lines "iceamfi: ..." (the loader keeps lines that begin with "ice").
+ *
+ * After IOS-26-Hot d249939 (github.com/nithinyadavamaraboina-online/IOS-26-Hot) xnu/patches-26/
+ * 0103-flame-amfi-trust-query.patch, APSL-2.0 (as this kernel): the selector and the answer; written here, off by
+ * default (theirs is on by default), with the queries logged.
+ */
+
+/*
+ * The iOS window server's view of this class is the stand-in's; the macOS kernel takes the same class
+ * from Apple's kext in the prelinked collection (com.apple.iokit.IOSurface,
+ * com.apple.iokit.IOMobileGraphicsFamily, com.apple.driver.AppleMobileFileIntegrity,
+ * com.apple.iokit.IONetworkingFamily, com.apple.driver.AppleARMPlatform), and a second registration of
+ * the class name would make that kext fail to load. So the body is built for the iOS target only; the
+ * file stays in the build (nothing but these two lines), because the hardware code that calls into it is
+ * the same in both and is gated where it calls (see RedwoodGPU.cpp, redwood_adreno.c,
+ * osfmk/arm64/loader_return.c).
+ */
+#if !defined(XNU_TARGET_OS_OSX)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+#include "MiniDrivers.h"
+
+#define kIceAMFITrustQuery      6       /* scalar: a flag / hash type; structure: the cdhash (20 bytes) */
+#define kIceAMFISaidMax         24      /* trust queries logged one by one; after that every 100th */
+
+static uint64_t gIceAMFILogged;         /* other selectors (< 64) already reported */
+static uint32_t gIceAMFIQueries;
+
+class AppleMobileFileIntegrity : public IOService
+{
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+bool
+AppleMobileFileIntegrity::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	setName("AppleMobileFileIntegrity");
+	registerService();
+	IOLog("iceamfi: AppleMobileFileIntegrity published on IOResources (29hot1): trust query (selector 6) answers trusted\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	char procname[32] = "?";
+
+	if (selector == kIceAMFITrustQuery) {
+		uint32_t n = OSIncrementAtomic((volatile SInt32 *)&gIceAMFIQueries) + 1;
+
+		if (n <= kIceAMFISaidMax) {
+			const uint8_t * h = (const uint8_t *)args->structureInput;
+			uint32_t size = args->structureInputSize;
+			char hex[17] = "-";
+
+			if (h != NULL && size >= 8) {
+				static const char digits[] = "0123456789abcdef";
+
+				for (int i = 0; i < 8; i++) {
+					hex[2 * i] = digits[h[i] >> 4];
+					hex[2 * i + 1] = digits[h[i] & 15];
+				}
+				hex[16] = 0;
+			}
+			proc_selfname(procname, sizeof(procname));
+			IOLog("iceamfi: trust query %u from %s[%d]: scalar %llu (%u in, %u out), cdhash %u bytes %s..: trusted\n",
+			    n, procname, proc_selfpid(), args->scalarInputCount > 0 ? args->scalarInput[0] : 0ULL,
+			    args->scalarInputCount, args->scalarOutputCount, size, hex);
+		} else if (n % 100 == 0) {
+			IOLog("iceamfi: %u trust queries answered trusted\n", n);
+		}
+		return kIOReturnSuccess;
+	}
+	if (selector < 64 && !(gIceAMFILogged & (1ULL << selector))) {
+		gIceAMFILogged |= 1ULL << selector;     /* (a race only repeats a log line) */
+		proc_selfname(procname, sizeof(procname));
+		IOLog("iceamfi: %s[%d] selector %u not implemented (scalars %u in, %u out; structure %u in, %u out)\n",
+		    procname, proc_selfpid(), selector, args->scalarInputCount, args->scalarOutputCount,
+		    args->structureInputSize, args->structureOutputSize);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+HakiosIcelandAMFIStart(void)
+{
+	uint32_t on = 0;
+	IOService * resources;
+	AppleMobileFileIntegrity * amfi;
+
+	if (!PE_parse_boot_argn("iceamfi", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	/* user space looks it up by class (IOServiceMatching("AppleMobileFileIntegrity")) */
+	resources = IOService::getResourceService();
+	amfi = OSTypeAlloc(AppleMobileFileIntegrity);
+	if (resources == NULL || amfi == NULL || !amfi->init() || !amfi->attach(resources)) {
+		OSSafeReleaseNULL(amfi);
+		IOLog("iceamfi: cannot create the service\n");
+		return;
+	}
+	if (!amfi->start(resources)) {
+		amfi->detach(resources);
+		IOLog("iceamfi: the service did not start\n");
+	}
+	amfi->release();
+}
+#endif /* !defined(XNU_TARGET_OS_OSX) */
diff --git a/iokit/Kernel/HakiosIcelandBacklightUI.cpp b/iokit/Kernel/HakiosIcelandBacklightUI.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9b27292b7cc4bcc38bdad6bdc4a357552c144cb7
--- /dev/null
+++ b/iokit/Kernel/HakiosIcelandBacklightUI.cpp
@@ -0,0 +1,648 @@
+/*
+ * iceland (harvest kit 18, boot-arg icebl_ui=1, needs icebl>=2): iPadOS's brightness requests to the Pad's backlight.
+ *
+ * CoreBrightness (backboardd) looks for IOServiceMatching("AppleARMBacklight") with the property
+ * "backlight-control" = true, reads "IODisplayParameters" and sets its level with IORegistryEntrySetCFProperties:
+ * "brightness" 0..65536 at the top level of the dictionary (the other keys it writes are copies or 0), and a fade time
+ * "FadePeriod" (seconds, 16.16) in the same dictionary. Found by ShueiTsuki/data-a-live (patches 0137/0138 and 0263,
+ * same SoC, iOS 16); taken here as the method, not their code. The level is mapped as theirs: level = max * f^2 / 65536^2
+ * (perceptual), max = 3542 (icebl_max's default, stock's manual range), at least 1 for any f > 0; a fade steps every
+ * 32 ms (at most 10 s). The writes are the ones icebl=2 already makes (two KTZ8869 over hand-driven I2C:
+ * hakios_iceland_backlight_set); without icebl>=2 every request is logged and refused (ENODEV).
+ *
+ * Lines "icebl: ui ..." (the first 40 requests, then one in 50): the keys asked for, the level set.
+ */
+/*
+ * The iOS window server's view of this class is the stand-in's; the macOS kernel takes the same class
+ * from Apple's kext in the prelinked collection (com.apple.iokit.IOSurface,
+ * com.apple.iokit.IOMobileGraphicsFamily, com.apple.driver.AppleMobileFileIntegrity,
+ * com.apple.iokit.IONetworkingFamily, com.apple.driver.AppleARMPlatform), and a second registration of
+ * the class name would make that kext fail to load. So the body is built for the iOS target only; the
+ * file stays in the build (nothing but these two lines), because the hardware code that calls into it is
+ * the same in both and is gated where it calls (see RedwoodGPU.cpp, redwood_adreno.c,
+ * osfmk/arm64/loader_return.c).
+ *
+ * w3-keys: macOS has its own half at the end of this file (IcelandBacklight, which answers as Apple's class instead
+ * of registering the name a second time).
+ */
+#if !defined(XNU_TARGET_OS_OSX)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include "MiniDrivers.h"
+
+extern "C" {
+int hakios_iceland_backlight_set(uint32_t level);
+uint32_t hakios_iceland_backlight_level(void);
+}
+
+#define BLUI_MAX        3542u
+#define BLUI_FULL       65536u
+
+class AppleARMBacklight : public IOService
+{
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void publish(uint32_t value);
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static IOLock *blui_lock;
+static uint32_t blui_target, blui_level, blui_fade_ms, blui_seq, blui_requests;
+static thread_t blui_thread;
+static AppleARMBacklight *blui_service;
+
+/* 0..65536 for a backlight level (the inverse of blui_map) */
+static uint32_t
+blui_value(uint32_t now)
+{
+	uint32_t value = BLUI_FULL;
+
+	if (now != 0 && now <= BLUI_MAX) {
+		uint64_t want = (uint64_t)now * BLUI_FULL * BLUI_FULL / BLUI_MAX, x = BLUI_FULL;
+		for (int i = 0; i < 30; i++) {
+			x = (x + want / x) / 2;
+		}
+		value = (uint32_t)x;
+	}
+	return value;
+}
+
+static uint32_t
+blui_map(uint32_t value)
+{
+	uint64_t f = value > BLUI_FULL ? BLUI_FULL : value;
+	uint64_t level = (uint64_t)BLUI_MAX * f * f / ((uint64_t)BLUI_FULL * BLUI_FULL);
+
+	return value != 0 && level == 0 ? 1 : (uint32_t)level;
+}
+
+static void
+blui_run(void *parameter, wait_result_t result)
+{
+	(void)parameter;
+	(void)result;
+	uint32_t done = 0;
+
+	/* the backlight driver finds its ICs later than this service starts (18i: 26 s vs 56 s): publish the real level */
+	for (int i = 0; i < 240 && blui_service != NULL; i++) {
+		uint32_t now = hakios_iceland_backlight_level();
+		if (now != 0) {
+			if (blui_seq == 0) {
+				blui_service->publish(blui_value(now));
+				IOLog("icebl: ui: level found %u published as brightness %u/65536\n", now, blui_value(now));
+			}
+			break;
+		}
+		IOSleep(500);
+	}
+	for (;;) {
+		uint32_t seq, target, from, fade;
+		bool superseded = false;
+
+		IOLockLock(blui_lock);
+		while (blui_seq == done) {
+			IOLockSleep(blui_lock, &blui_seq, THREAD_UNINT);
+		}
+		seq = blui_seq;
+		target = blui_target;
+		fade = blui_fade_ms;
+		IOLockUnlock(blui_lock);
+		from = hakios_iceland_backlight_level();        /* where the backlight is now */
+
+		uint32_t steps = fade / 32;
+		for (uint32_t s = 1; s < steps; s++) {
+			uint32_t level = (uint32_t)((int64_t)from + ((int64_t)target - (int64_t)from) * (int64_t)s / (int64_t)steps);
+			(void)hakios_iceland_backlight_set(level);
+			IOSleep(32);
+			if (__atomic_load_n(&blui_seq, __ATOMIC_ACQUIRE) != seq) {
+				superseded = true;              /* a newer request: start again from here */
+				break;
+			}
+		}
+		if (!superseded) {
+			int error = hakios_iceland_backlight_set(target);
+			if (error != 0) {
+				IOLog("icebl: ui: level %u refused (%d)\n", target, error);
+			}
+			blui_level = target;
+			done = seq;
+		}
+	}
+}
+
+void
+AppleARMBacklight::publish(uint32_t value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(2);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSDictionary *nits = OSDictionary::withCapacity(3);
+	OSNumber *n;
+
+	if (params == NULL || brightness == NULL || nits == NULL) {
+		OSSafeReleaseNULL(params);
+		OSSafeReleaseNULL(brightness);
+		OSSafeReleaseNULL(nits);
+		return;
+	}
+#define PUT(dict, key, v) do { n = OSNumber::withNumber((unsigned long long)(v), 32); if (n) { dict->setObject(key, n); n->release(); } } while (0)
+	PUT(brightness, "min", 0);
+	PUT(brightness, "max", BLUI_FULL);
+	PUT(brightness, "value", value);
+	PUT(nits, "min", 2u << 16);
+	PUT(nits, "max", 500u << 16);
+	PUT(nits, "value", (uint32_t)((uint64_t)(500u << 16) * value / BLUI_FULL));
+	params->setObject("brightness", brightness);
+	params->setObject("brightness-nits", nits);
+	setProperty("IODisplayParameters", params);
+#undef PUT
+	setProperty("user-accessible-max-nits", 500ULL, 32);
+	setProperty("edr-max-nits", 500ULL, 32);
+	params->release();
+	brightness->release();
+	nits->release();
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSNumber *value, *fade;
+	char keys[200] = "";
+	uint32_t n = __atomic_fetch_add(&blui_requests, 1, __ATOMIC_RELAXED);
+	bool say = n < 40 || n % 50 == 0;
+
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (say) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+		OSSymbol *key;
+
+		while (it != NULL && (key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+			strlcat(keys, key->getCStringNoCopy(), sizeof(keys));
+			strlcat(keys, " ", sizeof(keys));
+		}
+		OSSafeReleaseNULL(it);
+	}
+	value = OSDynamicCast(OSNumber, dict->getObject("brightness"));
+	if (value == NULL) {
+		if (say) {
+			IOLog("icebl: ui: request %u: keys %s(no brightness)\n", n, keys);
+		}
+		return kIOReturnSuccess;
+	}
+	fade = OSDynamicCast(OSNumber, dict->getObject("FadePeriod"));
+	uint32_t f = value->unsigned32BitValue(), level = blui_map(f);
+	uint32_t fade_ms = fade != NULL ? (uint32_t)(((uint64_t)fade->unsigned32BitValue() * 1000) >> 16) : 0;
+
+	if (fade_ms > 10000) {
+		fade_ms = 10000;
+	}
+	if (say) {
+		IOLog("icebl: ui: request %u: keys %sbrightness %u/65536 fade %u ms -> level %u\n", n, keys, f, fade_ms, level);
+	}
+	IOLockLock(blui_lock);
+	blui_target = level;
+	blui_fade_ms = fade_ms;
+	__atomic_fetch_add(&blui_seq, 1, __ATOMIC_RELEASE);
+	IOLockWakeup(blui_lock, &blui_seq, false);
+	IOLockUnlock(blui_lock);
+	publish(f);
+	return kIOReturnSuccess;
+}
+
+void
+HakiosIcelandBacklightUIStart(IOService *provider)
+{
+	int on = 0;
+	AppleARMBacklight *bl;
+	uint32_t now;
+
+	if (!PE_parse_boot_argn("icebl_ui", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	blui_lock = IOLockAlloc();
+	now = hakios_iceland_backlight_level();
+	blui_level = blui_target = now;
+	bl = OSTypeAlloc(AppleARMBacklight);
+	if (blui_lock == NULL || bl == NULL || !bl->init() || !bl->attach(provider)) {
+		IOLog("icebl: ui: the service could not be made\n");
+		OSSafeReleaseNULL(bl);
+		return;
+	}
+	bl->setProperty("backlight-control", true);
+	/*
+	 * 26b (31 Oct): CoreBrightness crashed backboardd (SIGSEGV, 18i / 24m) in _DisplaySliderToLogicalBrightnessInternal
+	 * (+0x169924: ldr s0, [Display+0x48] with Display+0x48 NULL; its own NULL check jumps to the same load), called by
+	 * _DisplayCreateWithCapabilitiesAndID. Display+0x48 / +0x40 are the slider's nits table and its length, read by
+	 * -[CBBacklightNode copyMarketingTable] through CBIORegistryParser loadIOFixedArray: from the backlight service's
+	 * "backlight-marketing-table" (16.16 fixed-point nits, a data property). This stand-in had none. Published here: 17
+	 * points from 2 to 500 nits, geometric (nits = 2 * 250^(i/16)), the panel's range as IODisplayParameters says.
+	 */
+	{
+		static const uint32_t marketing[17] = {
+			0x20000, 0x2d301, 0x3fcf8, 0x5a1bb, 0x7f3e5, 0xb3aec, 0xfdbbc, 0x1664d3, 0x1f9f6e, 0x2ca7b6, 0x3f0eef,
+			0x590bbe, 0x7dbe4c, 0xb19086, 0xfabe04, 0x16213ee, 0x1f40000,
+		};
+		OSData *table = OSData::withBytes(marketing, sizeof(marketing));
+		if (table != NULL) {
+			bl->setProperty("backlight-marketing-table", table);
+			table->release();
+		}
+	}
+	/* the level found, as 0..65536 (the backlight driver may not be ready yet: then full, corrected by the thread) */
+	bl->publish(blui_value(now));
+	bl->retain();
+	blui_service = bl;
+	if (kernel_thread_start(blui_run, NULL, &blui_thread) == KERN_SUCCESS) {
+		thread_deallocate(blui_thread);
+	}
+	bl->registerService();
+	IOLog("icebl: ui: AppleARMBacklight up (backlight-control, IODisplayParameters), level found %u\n", now);
+	bl->release();
+}
+#else /* XNU_TARGET_OS_OSX */
+/*
+ * w3-keys, macOS 27.3 (boot-arg icebl_ui=1, default off; the writes need icebl>=2): a backlight service for macOS's own
+ * brightness control (corebrightnessd; Control Center's slider and the brightness keys go through it).
+ *
+ * What macOS 27.3 has (read from the 26C5035r collection's names and our tablet logs; nothing of Apple's is in this file):
+ *   - the kernel collection's com.apple.driver.AppleARMPlatform carries Apple's AppleARMBacklight (its setProperties,
+ *     slider / nits / milliamp conversions, "IODisplayParameters", "BrightnessMilliNits", "IOMFBBrightnessLevel"): the
+ *     backlight of a built-in panel is that IOService, as on iPadOS, and corebrightnessd runs on the tablet (w2-login-2:
+ *     pid 101). CoreBrightness there is the same generation as iPadOS 27's (2300.60).
+ *   - WindowServer's IOMobileFramebuffer selectors 78 / 79 (refused today) are not it: their first scalar is a block number
+ *     (0x33, 0x34, 0x6c with 64 / 656 / 76 bytes), WindowServer's own calls, and corebrightnessd never appears on that
+ *     user client (merge1-1's uc-trace).
+ * So the route is UniXNU-sheng's for the same CoreBrightness on iPadOS 27 (package/AppleARMBacklight.cpp at 6880068,
+ * BSD-2-Clause-Patent, docs/drivers/sheng-backlight.md; the method and the property list, written here for icebl): a
+ * service of our own class whose getMetaClass answers Apple's AppleARMBacklight metaclass once that is registered, so
+ * IOServiceMatching("AppleARMBacklight"), IOObjectConformsTo and the sandbox's class walk all take it, with
+ * "backlight-control" and the ranges CoreBrightness reads:
+ *   IODisplayParameters { brightness {min 0, max 65536, value}, BrightnessMilliNits {min, max, value} },
+ *   backlight-marketing-table (17 points, 16.16 nits), LmaxProduct (4 bytes 16.16), LmidProduct, LminProduct,
+ *   backlight-calibration-parameters { lMin/lMid/lMax Product and Panel, 16.16 nits }.
+ * It takes "brightness-nits" (signed 16.16; 0 or less = the backlight off) and "brightness" (0..65536, with or without
+ * FadePeriod); other keys succeed with no effect. The range 2 .. 500 nits is nominal (the panel is not measured): 500 nits
+ * stands for level 3542, the level is linear in nits.
+ *
+ * install65, icebl_native=1 (built in with icebl_ui=1; both need icebl>=2): UniXNU PR #319 (dec0ac6a) and UniXNU-sheng
+ * PR #146 (aef0a0e3) found on the same 26C5035r that corebrightnessd takes VMBLControl (mode 3, every brightness dropped)
+ * because MobileGestalt's IsVirtualDevice reads kern.hv_vmm_present, which the loader's vmm-present makes 1; told 0 it takes
+ * BLControl (mode 1) and drives AppleARMBacklight. Written here for our service (no code of theirs): (a) corebrightnessd
+ * alone is told 0 (hakios_iceland_bl_no_vmm, from bsd/kern/hvg_sysctl.c, the first 4 reads logged); (b) the service
+ * carries force-brightness-control <01> (one byte of OSData: BrightnessControl's BCAppleBacklightBrtControl reads it into
+ * its override and otherwise refuses direct brightness-nits writes); (c) when the sandbox refuses a setProperties on THIS
+ * service from WindowServer or corebrightnessd, the refusal is granted (HakiosIcelandBacklightGrant, from
+ * IOUserClient.cpp; sheng's NativeSandboxGrantProcess list, as a function of ours): the refusal is computed first, so
+ * the log says whether the grant was needed at all. Nothing else is granted, no other process is told 0.
+ * Lines "icebl: native: ...". With icebl_ui=1 but no level from the backlight driver (icebl>=2 not on the line or no IC
+ * answered) the service is not published at all, so corebrightnessd never meets a backlight that cannot change.
+ *
+ * NOT PROVEN on macOS: piano (613a209 docs/drivers/backlight.md §5) records that its display is published as an external
+ * one, for which macOS shows no brightness control, and that sheng's int-236 froze the screen when backlight-control was
+ * published without the conformance (QuartzCore waits for CoreBrightness's libEDR server). Here both are published
+ * together or neither. Whether corebrightnessd takes the service for this display is what a run with icebl_ui=1 shows:
+ * every request is logged with the process that made it (the first 40, then one in 50).
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include "MiniDrivers.h"
+
+extern "C" {
+int hakios_iceland_backlight_set(uint32_t level);
+uint32_t hakios_iceland_backlight_level(void);
+void native_wait_for_launchd(const char *who);          /* iokit/Native/GopFramebuffer/NativeGopDisplayProbe.cpp */
+void proc_selfname(char *, int);
+int proc_selfpid(void);
+int hakios_iceland_bl_no_vmm(void);                     /* install65: bsd/kern/hvg_sysctl.c */
+}
+
+#define BLM_MAX_LEVEL   3542u
+#define BLM_FULL        65536u
+#define BLM_MIN_NITS    2u
+#define BLM_MID_NITS    140u
+#define BLM_MAX_NITS    500u
+
+class IcelandBacklight : public IOService
+{
+	OSDeclareDefaultStructors(IcelandBacklight);
+public:
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void publish(uint32_t level);
+};
+
+static const OSMetaClass *blm_apple_class;      /* AppleARMBacklight's, once registered */
+static volatile bool blm_answer;                /* getMetaClass answers it from here on */
+static IcelandBacklight *blm_service;
+static uint32_t blm_requests, blm_sets;
+static uint32_t blm_vmm_told, blm_grants;      /* install65: the lines said (4 and 8 at most) */
+
+/* install65: icebl_native=1 with icebl_ui=1 and icebl>=2 (each from the line or the built-in words) */
+static bool
+blm_native_on(void)
+{
+	int native = 0, ui = 0, bl = 0;
+
+	return PE_parse_boot_argn("icebl_native", &native, sizeof(native)) && native == 1 &&
+	       PE_parse_boot_argn("icebl_ui", &ui, sizeof(ui)) && ui == 1 &&
+	       PE_parse_boot_argn("icebl", &bl, sizeof(bl)) && bl >= 2;
+}
+
+/* install65: kern.hv_vmm_present's answer for this caller: 1 = tell it 0 (corebrightnessd alone) */
+int
+hakios_iceland_bl_no_vmm(void)
+{
+	char who[20] = "";
+
+	proc_selfname(who, sizeof(who));
+	if (strcmp(who, "corebrightnessd") != 0 || !blm_native_on()) {
+		return 0;
+	}
+	if (__atomic_fetch_add(&blm_vmm_told, 1, __ATOMIC_RELAXED) < 4) {
+		IOLog("icebl: native: kern.hv_vmm_present read by corebrightnessd[%d]: told 0 (BLControl; the backlight service %s)\n",
+		    proc_selfpid(), __atomic_load_n(&blm_answer, __ATOMIC_ACQUIRE) ? "is up" : "is not published yet");
+	}
+	return 1;
+}
+
+/* install65: the sandbox refused (refusal) a setProperties on entry; true = granted (our service, WindowServer / corebrightnessd) */
+extern "C" bool HakiosIcelandBacklightGrant(IORegistryEntry *entry, int refusal);
+extern "C" bool
+HakiosIcelandBacklightGrant(IORegistryEntry *entry, int refusal)
+{
+	char who[20] = "";
+	bool granted;
+	uint32_t n;
+
+	if (entry == NULL || entry != (IORegistryEntry *)blm_service || !__atomic_load_n(&blm_answer, __ATOMIC_ACQUIRE) ||
+	    !blm_native_on()) {
+		return false;
+	}
+	proc_selfname(who, sizeof(who));
+	granted = strcmp(who, "WindowServer") == 0 || strcmp(who, "corebrightnessd") == 0;
+	n = __atomic_fetch_add(&blm_grants, 1, __ATOMIC_RELAXED);
+	if (n < 8 || n % 100 == 0) {
+		IOLog("icebl: native: the sandbox refused setProperties on the backlight from %s[%d] (%d): %s (%u so far)\n", who,
+		    proc_selfpid(), refusal, granted ? "GRANTED (icebl_native=1)" : "left refused", n + 1);
+	}
+	return granted;
+}
+
+/* OSDefineMetaClassAndStructors(IcelandBacklight, IOService), with getMetaClass as described above */
+IcelandBacklight::MetaClass IcelandBacklight::gMetaClass;
+const OSMetaClass * const IcelandBacklight::metaClass = &IcelandBacklight::gMetaClass;
+const OSMetaClass * const IcelandBacklight::superClass = &IOService::gMetaClass;
+IcelandBacklight::IcelandBacklight(const OSMetaClass *meta) : IOService(meta)
+{
+}
+IcelandBacklight::~IcelandBacklight()
+{
+}
+const OSMetaClass *
+IcelandBacklight::getMetaClass() const
+{
+	return __atomic_load_n(&blm_answer, __ATOMIC_ACQUIRE) && blm_apple_class != NULL ? blm_apple_class : &gMetaClass;
+}
+OSMetaClassConstructorInit(IcelandBacklight, IOService, )
+OSDefineDefaultStructors(IcelandBacklight, IOService)
+
+static uint32_t
+blm_level_to_millinits(uint32_t level)
+{
+	return (uint32_t)((uint64_t)(level > BLM_MAX_LEVEL ? BLM_MAX_LEVEL : level) * BLM_MAX_NITS * 1000 / BLM_MAX_LEVEL);
+}
+
+/* 16.16 nits to a level: linear, at least 1 for any light at all */
+static uint32_t
+blm_nits_to_level(int32_t nits16)
+{
+	uint64_t level;
+
+	if (nits16 <= 0) {
+		return 0;
+	}
+	level = (uint64_t)nits16 * BLM_MAX_LEVEL / ((uint64_t)BLM_MAX_NITS << 16);
+	return level == 0 ? 1 : level > BLM_MAX_LEVEL ? BLM_MAX_LEVEL : (uint32_t)level;
+}
+
+static void
+blm_put(OSDictionary *dict, const char *key, uint64_t value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+
+	if (n != NULL) {
+		dict->setObject(key, n);
+		n->release();
+	}
+}
+
+void
+IcelandBacklight::publish(uint32_t level)
+{
+	OSDictionary *params = OSDictionary::withCapacity(2);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSDictionary *millinits = OSDictionary::withCapacity(3);
+
+	if (params != NULL && brightness != NULL && millinits != NULL) {
+		blm_put(brightness, "min", 0);
+		blm_put(brightness, "max", BLM_FULL);
+		blm_put(brightness, "value", (uint64_t)(level > BLM_MAX_LEVEL ? BLM_MAX_LEVEL : level) * BLM_FULL / BLM_MAX_LEVEL);
+		blm_put(millinits, "min", BLM_MIN_NITS * 1000);
+		blm_put(millinits, "max", BLM_MAX_NITS * 1000);
+		blm_put(millinits, "value", blm_level_to_millinits(level));
+		params->setObject("brightness", brightness);
+		params->setObject("BrightnessMilliNits", millinits);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(params);
+	OSSafeReleaseNULL(brightness);
+	OSSafeReleaseNULL(millinits);
+}
+
+IOReturn
+IcelandBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	uint32_t n = __atomic_fetch_add(&blm_requests, 1, __ATOMIC_RELAXED);
+	bool say = n < 40 || n % 50 == 0;
+	char keys[160] = "", who[20] = "";
+	OSNumber *nits, *value;
+	uint32_t level;
+	int error;
+
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	proc_selfname(who, sizeof(who));
+	if (say) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+		OSSymbol *key;
+
+		while (it != NULL && (key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+			strlcat(keys, key->getCStringNoCopy(), sizeof(keys));
+			strlcat(keys, " ", sizeof(keys));
+		}
+		OSSafeReleaseNULL(it);
+	}
+	nits = OSDynamicCast(OSNumber, dict->getObject("brightness-nits"));
+	value = OSDynamicCast(OSNumber, dict->getObject("brightness"));
+	if (nits != NULL) {
+		level = blm_nits_to_level((int32_t)nits->unsigned32BitValue());
+	} else if (value != NULL) {
+		uint32_t f = value->unsigned32BitValue();
+
+		f = f > BLM_FULL ? BLM_FULL : f;
+		level = (uint32_t)((uint64_t)f * BLM_MAX_LEVEL / BLM_FULL);
+		level = f != 0 && level == 0 ? 1 : level;
+	} else {
+		if (say) {
+			IOLog("icebl: ui: request %u from %s: keys %s(no brightness: accepted, nothing done)\n", n, who, keys);
+		}
+		return kIOReturnSuccess;
+	}
+	error = hakios_iceland_backlight_set(level);
+	__atomic_fetch_add(&blm_sets, 1, __ATOMIC_RELAXED);
+	if (say) {
+		IOLog("icebl: ui: request %u from %s: keys %s%s %#x -> level %u (%d)\n", n, who, keys,
+		    nits != NULL ? "brightness-nits" : "brightness", nits != NULL ? nits->unsigned32BitValue() : value->unsigned32BitValue(),
+		    level, error);
+	}
+	publish(level);
+	return kIOReturnSuccess;
+}
+
+static void
+blm_run(void *parameter, wait_result_t result)
+{
+	IOService *provider = (IOService *)parameter;
+	const OSSymbol *name = OSSymbol::withCString("AppleARMBacklight");
+	IcelandBacklight *bl;
+	uint32_t now = 0, waited;
+
+	(void)result;
+	native_wait_for_launchd("icebl: ui");
+	/* Apple's class is registered when its kext starts; the backlight driver finds its ICs about then too */
+	for (waited = 0; waited < 120; waited++) {
+		blm_apple_class = name != NULL ? OSMetaClass::getMetaClassWithName(name) : NULL;
+		now = hakios_iceland_backlight_level();
+		if (blm_apple_class != NULL && now != 0) {
+			break;
+		}
+		IOSleep(500);
+	}
+	OSSafeReleaseNULL(name);
+	if (blm_apple_class == NULL) {
+		IOLog("icebl: ui: no AppleARMBacklight class is registered after %u ms: nothing published\n", waited * 500);
+		thread_terminate(current_thread());
+		return;
+	}
+	if (now == 0) {         /* install65: no backlight that cannot change (icebl>=2 not given, or no IC answered) */
+		IOLog("icebl: ui: the backlight driver has no level after %u ms (icebl>=2 not on, or no IC): nothing published\n",
+		    waited * 500);
+		thread_terminate(current_thread());
+		return;
+	}
+	bl = OSTypeAlloc(IcelandBacklight);
+	if (bl == NULL || !bl->init() || !bl->attach(provider)) {
+		IOLog("icebl: ui: the service could not be made\n");
+		OSSafeReleaseNULL(bl);
+		thread_terminate(current_thread());
+		return;
+	}
+	{
+		/* 17 points from 2 to 500 nits, geometric (2 * 250^(i/16)), 16.16: the slider's table (as the iPadOS half) */
+		static const uint32_t marketing[17] = {
+			0x20000, 0x2d301, 0x3fcf8, 0x5a1bb, 0x7f3e5, 0xb3aec, 0xfdbbc, 0x1664d3, 0x1f9f6e, 0x2ca7b6, 0x3f0eef,
+			0x590bbe, 0x7dbe4c, 0xb19086, 0xfabe04, 0x16213ee, 0x1f40000,
+		};
+		const uint32_t lmax = BLM_MAX_NITS << 16;
+		OSData *table = OSData::withBytes(marketing, sizeof(marketing));
+		OSData *lmaxData = OSData::withBytes(&lmax, sizeof(lmax));
+		OSDictionary *calibration = OSDictionary::withCapacity(6);
+
+		if (table != NULL) {
+			bl->setProperty("backlight-marketing-table", table);
+		}
+		if (lmaxData != NULL) {
+			bl->setProperty("LmaxProduct", lmaxData);
+		}
+		bl->setProperty("LmidProduct", (unsigned long long)BLM_MID_NITS, 32);
+		bl->setProperty("LminProduct", (unsigned long long)BLM_MIN_NITS, 32);
+		if (calibration != NULL) {
+			blm_put(calibration, "lMinProduct", BLM_MIN_NITS << 16);
+			blm_put(calibration, "lMidProduct", BLM_MID_NITS << 16);
+			blm_put(calibration, "lMaxProduct", BLM_MAX_NITS << 16);
+			blm_put(calibration, "lMinPanel", BLM_MIN_NITS << 16);
+			blm_put(calibration, "lMidPanel", BLM_MID_NITS << 16);
+			blm_put(calibration, "lMaxPanel", BLM_MAX_NITS << 16);
+			bl->setProperty("backlight-calibration-parameters", calibration);
+		}
+		OSSafeReleaseNULL(table);
+		OSSafeReleaseNULL(lmaxData);
+		OSSafeReleaseNULL(calibration);
+	}
+	if (blm_native_on()) {  /* install65: BrightnessControl's override byte (UniXNU-sheng PR #146), before the service is seen */
+		const uint8_t force = 1;
+		OSData *forceData = OSData::withBytes(&force, sizeof(force));
+
+		if (forceData != NULL) {
+			bl->setProperty("force-brightness-control", forceData);
+			forceData->release();
+		}
+	}
+	bl->publish(now != 0 ? now : 1417);
+	blm_service = bl;                               /* held for the life of the system */
+	/* the conformance and backlight-control together, or neither (sheng int-236) */
+	__atomic_store_n(&blm_answer, true, __ATOMIC_RELEASE);
+	bl->setProperty("backlight-control", true);
+	bl->registerService();
+	IOLog("icebl: ui: IcelandBacklight published as %s (of %s) with backlight-control, %u ms after launchd; level %u = %u "
+	    "millinits of %u..%u\n", bl->getMetaClass()->getClassName(),
+	    blm_apple_class->getKmodName() != NULL ? blm_apple_class->getKmodName()->getCStringNoCopy() : "?", waited * 500, now,
+	    blm_level_to_millinits(now), BLM_MIN_NITS * 1000, BLM_MAX_NITS * 1000);
+	if (blm_native_on()) {
+		IOLog("icebl: native: on (icebl_native=1): force-brightness-control <01>, corebrightnessd told hv_vmm_present 0 (%u reads "
+		    "so far), the sandbox grant for WindowServer / corebrightnessd on this service\n",
+		    __atomic_load_n(&blm_vmm_told, __ATOMIC_RELAXED));
+	}
+	/* what came of it, for the log: the requests so far, at 30 s, 2 min and then every 5 */
+	for (unsigned tick = 0;; tick++) {
+		IOSleep(tick == 0 ? 30000 : tick == 1 ? 90000 : 300000);
+		IOLog("icebl: ui: %u requests so far, %u set a level; level now %u\n", __atomic_load_n(&blm_requests, __ATOMIC_RELAXED),
+		    __atomic_load_n(&blm_sets, __ATOMIC_RELAXED), hakios_iceland_backlight_level());
+	}
+}
+
+void
+HakiosIcelandBacklightUIStart(IOService *provider)
+{
+	int on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("icebl_ui", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	if (kernel_thread_start(blm_run, provider, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
