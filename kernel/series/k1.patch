+extern void hakios_iceland_net_lost(void);
+extern void hakios_iceland_net_poll(void);
+extern void hakios_iceland_net_stop(void);
+
+/*
+ * ---- kit 46cn4a "omnibus" (kernel scan237, 7 Nov 2026): dadawifi_omni=MASK (default 0x1ef), dadawifi_poll=N ms ----
+ *   0x001 A1  the driver's per-millisecond "ext irq" line counted, not printed; a counter summary every 10 s (here)
+ *   0x002 A2  a rate limiter on the driver's lines (lx_log): more than 30 lines of one shape in 10 s are counted, not
+ *             printed; the 46cn / W2 / QMIDUMP / stuck / rddm lines are never limited (they are bounded at the source)
+ *   0x004 B   WMI command / event trace, the dump at the first WMI timeout (driver, tools/ath12k-omni.py)
+ *   0x008 C   the DP ext groups polled every dadawifi_poll ms (default 5), CE / MHI every round; counters (driver)
+ *   0x010 E   (OFF) the driver's recovery queued once after the first WMI timeout dump ("46cn4a retry 1")
+ *   0x020 G1  the RDDM upload awaited 2 s at a firmware crash, its strings (the Q6-SFR reason) printed (driver)
+ *   0x040 G2  the code store check at the WMI timeout and at 120 s (driver); the arena allocation map + overlap check
+ *             once after WMI READY (here)
+ *   0x080 G4  a config write whose read-modify-write read all-ones is not written (a dead config window)
+ *   0x100 G5  with dadawifi_pcie bit 4, the runtime's MRRS 128 write (nw_pci.c) keeps MRRS 512
+ *   0x200 G6  (OFF; 46cn4b, owner's yes) lmx.lvl ARC at Peach's 384 (harvest.c); SN7 / CESTA not applicable / unverified
+ *   0x400 G7  (OFF; 46cn4b, owner's yes) the link forced to x1 as Peach: DBI 0x714 bit 5, 0x80c lanes 1, before training
+ *   0x800 G8  (OFF, NOT BUILT) the arena cacheable
+ *   0x1000 G9 (OFF; 46cn4b, owner's yes) L3K_E1 1200 mV mode 7 (harvest.c, before WLAN_EN)
+ *   0x2000 G10 (OFF, NOT BUILT) popsicle's MHI channel / event ring set
+ * G3 = dadawifi_cfgprobe (default 0: no sampler); with 1: change lines only, at most 300, stops 5 s after WMI READY
+ * unless a SYS_ERR came first (then 2 s after it).
+ */
+/*
+ * ---- 46cn4g (kernel scan241): dadawifi_grp=MASK (default 0x10; 0x34 since scan243) - the group-addressed RX tests ----
+ *   0x01 the TKIP GTK without the Michael swap (driver, nw_sta.c gtk_take)
+ *   0x02 the M3 key RSC given as the GTK's key_rsc_counter, as Peach (driver, mac.c)
+ *   0x04 native-wifi RX decap instead of Ethernet (driver, nw_sta.c; Ethernet TX encap kept)
+ *   0x08 the WPA vendor IE left out of the IEs given to the driver: no NEED_GTK_2_WAY peer flag (driver, nw_sta.c)
+ *   0x10 DHCP without the broadcast flag (the OFFER / ACK come unicast), a gratuitous ARP after the gateway's ARP answer
+ *   0x20 (46cn4m) native-wifi TX encap too (driver, nw_sta.c tx_eth_nwifi): vdev params 48 = 91 = 1, as Fedora
+ *   0x40 (w5-wifi) on 5 GHz a legacy 20 MHz association, no HT or VHT (driver, nw_sta.c: hakios-macos w5-wifi's
+ *        tools/ath12k-w5wifi.py; an older object ignores it)
+ *   0x80 (w5-wifi) on 5 GHz HT at 20 MHz, no VHT (the same)
+ *   0x100 (w5-wifi) the access point's ADDBA requests answered: receive block-ack agreements (the same; without it they
+ *        are counted and the first three logged)
+ *   0x200 (w6-conn) on 5 GHz HT at 40 MHz, no VHT (driver, nw_sta.c: hakios-macos w6-conn's tools/ath12k-w6conn.py;
+ *        0x40 / 0x80 win when set): the width half of the VHT80 A/B
+ *   0x400 (w6-conn) on 5 GHz VHT at 20 MHz (the same): the VHT half of the A/B
+ *   0x800 (w6-conn) diagnostics only: action frames counted by category, each way, and transmit completions by TQM
+ *        reason, logged with the per-second statistics while they change
+ */
+static uint32_t ice_grp = 0xffffffffu;
+int hakios_iceland_grp(int bit);
+
+int
+hakios_iceland_grp(int bit)
+{
+	if (ice_grp == 0xffffffffu) {
+		uint32_t m = 0x34;      /* 46cn4n: the proven set (46cn4k / 46cn4m): DHCP unicast + native wifi both ways */
+
+		(void)PE_parse_boot_argn("dadawifi_grp", &m, sizeof(m));
+		ice_grp = m & 0x7fffu;  /* w7-wifi: the mask is open to 0x4000 (the object's new bits are logged below) */
+		printf("icepcie: ath12k: 46cn4g dadawifi_grp %#x: 0x01 no Michael swap %u, 0x02 M3 RSC %u, 0x04 native-wifi decap %u, "
+		    "0x08 WPA IE stripped %u, 0x10 DHCP unicast + gratuitous ARP %u, 0x20 native-wifi tx encap %u, 0x40 5 GHz legacy20 %u, "
+		    "0x80 5 GHz HT20 %u, 0x100 rx BA %u, 0x200 5 GHz HT40 %u, 0x400 5 GHz VHT20 %u, 0x800 action/TQM counts %u, "
+		    "0x1000 reserved %u, 0x2000 driver tx backpressure %u, 0x4000 reserved %u\n",
+		    ice_grp, ice_grp & 1, (ice_grp >> 1) & 1, (ice_grp >> 2) & 1, (ice_grp >> 3) & 1, (ice_grp >> 4) & 1,
+		    (ice_grp >> 5) & 1, (ice_grp >> 6) & 1, (ice_grp >> 7) & 1, (ice_grp >> 8) & 1, (ice_grp >> 9) & 1,
+		    (ice_grp >> 10) & 1, (ice_grp >> 11) & 1, (ice_grp >> 12) & 1, (ice_grp >> 13) & 1, (ice_grp >> 14) & 1);
+	}
+	return (ice_grp & (uint32_t)bit) != 0;
+}
+
+#if defined(XNU_TARGET_OS_OSX)
+/* macOS (bsd/dev/hakios_iceland_pcie.c): the bring-up before the driver, and the run's end, which stops the loop */
+extern bool hakios_iceland_pcie_up(void);
+extern int hakios_iceland_pcie_stopping(void);
+extern void hakios_iceland_pcie_driver_done(void);
+#else
