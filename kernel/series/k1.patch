+		    "FSYNR1 %08x CBFRSYNRA %08x; global sCR0 %08x GFSR %08x GFAR %08x_%08x GFSYNR0 %08x GFSYNR1 %08x; SMR %u %08x S2CR "
+		    "%08x\n", when, E2A_BANK, io_rd(cb, 0), fsr, f, f ? ": " : " = none", fb, (fsr >> 9) & 3, ((fsr >> 9) & 3) == 2 ?
+		    "AArch64, not a fault" : ((fsr >> 9) & 3) == 1 ? "AArch32 long" : "AArch32 short", io_rd(cb, 0x64), io_rd(cb, 0x60),
+		    io_rd(cb, 0x68), io_rd(cb, 0x6c), e5_gr1 ? io_rd(e5_gr1, 0x400 + 4 * E2A_BANK) : 0, e5_gr0 ? io_rd(e5_gr0, 0) : 0,
+		    e5_gr0 ? io_rd(e5_gr0, 0x48) : 0, e5_gr0 ? io_rd(e5_gr0, 0x44) : 0, e5_gr0 ? io_rd(e5_gr0, 0x40) : 0,
+		    e5_gr0 ? io_rd(e5_gr0, 0x50) : 0, e5_gr0 ? io_rd(e5_gr0, 0x54) : 0, E2A_SMR,
+		    e5_gr0 ? io_rd(e5_gr0, 0x800 + 4 * E2A_SMR) : 0, e5_gr0 ? io_rd(e5_gr0, 0xc00 + 4 * E2A_SMR) : 0);
+	}
+}
