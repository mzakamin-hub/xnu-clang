+#define W_DATA                  45587712ULL     /* the data window's first block: userdata's inner GPT entry "data" */
+#define W_LOG                   61591040ULL     /* the log window's first ("log"), the data window's end */
+#define W_END                   61853184ULL     /* the log window's end */
+static volatile bool win_armed;         /* iceufs_write=1 and every check passed: WRITE may pass, inside one window */
+static uint64_t n_refusals;             /* every refusal of the whitelist, each logged ("REFUSED: ...") */
+static uint64_t n_wtest_refused;        /* the write self-test's own refusals (win_selftest) */
