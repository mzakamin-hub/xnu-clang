+static void
+check_walk(void)
+{
+	static const uint32_t want[] = { 900, 1200, 1350, 1500, 1750, 2000 };
+	const unsigned nwant = sizeof(want) / sizeof(want[0]);
+	uint32_t cur = 500, step;
+	char seen[96];
+	size_t off = 0;
+	unsigned n = 0;
+	bool pass = true;
+
+	seen[0] = '\0';
+	while ((step = icechg_next_step(cur, ICECHG_TOP_MA)) != 0) {
+		if (n >= nwant || step != want[n])
+			pass = false;
+		if (off < sizeof(seen))
+			off += (size_t)snprintf(seen + off, sizeof(seen) - off, "%s%u",
+						n != 0 ? " " : "", step);
+		n++;
+		cur = step;
+		if (n > 16)
+			break;	/* a header that never reaches 0 must not spin this */
+	}
+	if (n != nwant)
+		pass = false;
+	verdict("walk from 500 mA visits 900 1200 1350 1500 1750 2000", pass, seen);
+}
