+/*
+ * Boot-arg icelux_test=1 (without icedsp; QEMU has no DSP): the light's receive path with no hardware. Two made-up
+ * QMI indications (0x22: client id, then an SscClientResponse for a made-up light sensor uid with one measurement
+ * each: 6.5 lux as two plain floats and accuracy 3, then 1234.5 lux as a packed pair) go through ssc_qmi() as the
+ * DSP's would; kern.icelux must read 6500 and then 1234500. Nothing is sent and no register is touched; the state
+ * is put back afterwards (icelux_test=2 leaves the last value in the sysctls, for a daemon's test).
+ */
+static uint32_t
+lux_test_packet(uint8_t *q0, uint32_t bits, bool packed)
+{
+	uint8_t msg[24], body[48], pb[80], *o = msg, *q = q0;
+	uint32_t msg_len, body_len, pb_len;
+
+	if (packed) {
+		*o++ = 0x0a; *o++ = 8; o = pb_fixed(o, bits, 4); o = pb_fixed(o, 0x42c80000, 4);   /* (raw 100.0) */
+	} else {
+		*o++ = 0x0d; o = pb_fixed(o, bits, 4);
+		*o++ = 0x0d; o = pb_fixed(o, 0x42c80000, 4);
+		*o++ = 0x10; *o++ = 3;
+	}
+	msg_len = (uint32_t)(o - msg);
+	o = body;
+	*o++ = 0x0d; o = pb_fixed(o, SSC_MEASUREMENT, 4);
+	*o++ = 0x11; o = pb_fixed(o, 19200000, 8);
+	*o++ = 0x1a; *o++ = (uint8_t)msg_len;
+	memcpy(o, msg, msg_len);
+	body_len = (uint32_t)(o - body) + msg_len;
+	o = pb;
+	*o++ = 0x0a; *o++ = 18;
+	*o++ = 0x09; o = pb_fixed(o, 0x1111222233334444ull, 8);
+	*o++ = 0x11; o = pb_fixed(o, 0x5555666677778888ull, 8);
+	*o++ = 0x12; *o++ = (uint8_t)body_len;
+	memcpy(o, body, body_len);
+	pb_len = (uint32_t)(o - pb) + body_len;
+	*q++ = QMI_INDICATION;
+	q = pb_fixed(q, 0, 2);
+	q = pb_fixed(q, SSC_IND_LARGE, 2);
+	q = pb_fixed(q, 3 + 8 + 3 + 2 + pb_len, 2);
+	*q++ = 0x01; q = pb_fixed(q, 8, 2); q = pb_fixed(q, 1, 8);
+	*q++ = 0x02; q = pb_fixed(q, 2 + pb_len, 2); q = pb_fixed(q, pb_len, 2);
+	memcpy(q, pb, pb_len);
+	return (uint32_t)(q - q0) + pb_len;
+}
+
+static void
+lux_selftest(uint32_t mode)
+{
+	uint8_t qmi[160];
+	uint32_t n;
+	int first, second, acc1, seq2;
+
+	s_light = true;
+	s_light_low = 0x1111222233334444ull;
+	s_light_high = 0x5555666677778888ull;
+	n = lux_test_packet(qmi, 0x40d00000, false);            /* 6.5 */
+	ssc_qmi(qmi, n);
+	first = ice_lux;
+	acc1 = ice_lux_acc;
+	n = lux_test_packet(qmi, 0x449a5000, true);             /* 1234.5 */
+	ssc_qmi(qmi, n);
+	second = ice_lux;
+	seq2 = ice_lux_seq;
+	say("lux: selftest %s: %d and %d milli-lux (wanted 6500 and 1234500), accuracy %d (3), %d samples (2)%s\n",
+	    first == 6500 && second == 1234500 && acc1 == 3 && seq2 == 2 ? "PASS" : "FAIL", first, second, acc1, seq2,
+	    mode >= 2 ? "; the last value stays in kern.icelux" : "");
+	s_light = false;
+	s_light_low = s_light_high = 0;
+	s_light_samples = 0;
+	s_indications = 0;
+	if (mode < 2) {
+		ice_lux = ice_lux_acc = ice_lux_seq = 0;
+	}
+}
