+/*
+ * ---- kit K1 (46cn3a, 6 Nov 2026): the Peach-parity switches, one boot arg ----
+ * dadawifi_peach=MASK, default 0x3f (all on). The driver object (tools/mk-ath12k.sh 42-52, tools/ath12k-peach.py) asks
+ * for one bit at a time:
+ *   0x01 W1.1 HOST_CAP as Peach (DDR range TLV 0x1F = this arena; no MLO / on-demand / cstate / mem_cfg_mode)
+ *   0x02 W1.2 WMI connected before HTT
+ *   0x04 W1.3 shadow registers off + Peach's target CE table and service map (CE2/CE3 3520 B)
+ *   0x08 W1.4 CE0/CE3 bounce buffers in the arena + the out-of-arena guard
+ *   0x10 W1.5 cold-boot calibration (despite dadawifi_nocbc=1) + the MAC over QMI before WLAN_CFG
+ *   0x20 W2   join the private test network, DHCP, ARP, ping (this file)
+ */
+#if defined(XNU_TARGET_OS_OSX)
+#define ICE_PEACH_DEFAULT 0x08u /* macOS: the set of the last run that reached the scan (runs/p4-1: 40) without W2 */
+#else
+#define ICE_PEACH_DEFAULT 0x3fu
+#endif
+static uint32_t ice_peach = 0xffffffffu;
+
+int hakios_iceland_peach(int bit);
+unsigned long long hakios_iceland_us(void);
+void hakios_iceland_ddr(unsigned long long *start, unsigned long long *size);
+
+int
+hakios_iceland_peach(int bit)
+{
+	if (ice_peach == 0xffffffffu) {
+		uint32_t m = ICE_PEACH_DEFAULT;
+
+		(void)PE_parse_boot_argn("dadawifi_peach", &m, sizeof(m));
+#if defined(XNU_TARGET_OS_OSX)
+		{
+			uint32_t join = 0;      /* macOS: W2 (bit 0x20: join, DHCP, ARP, ping) is its own boot-arg, default off */
+
+			if (PE_parse_boot_argn("icewifi_join", &join, sizeof(join)) && join == 1) {
+				m |= 0x20u;
+			}
+			if (hakios_iceland_net_mode() == 1) {
+				m |= 0x20u;     /* w3-net: icewifi_net=1 needs the join; the frames then go to en0 (w2_net) */
+			}
+		}
+#endif
+		ice_peach = m & 0xffu;
+		printf("icepcie: ath12k: 46cn3a dadawifi_peach mask %#x: W1.1 hostcap %u, W1.2 wmi-first %u, W1.3 shadow-off+ce-table %u, "
+		    "W1.4 bounce+guard %u, W1.5 cbc+mac %u, W2 station %u\n", ice_peach, ice_peach & 1, (ice_peach >> 1) & 1,
+		    (ice_peach >> 2) & 1, (ice_peach >> 3) & 1, (ice_peach >> 4) & 1, (ice_peach >> 5) & 1);
+	}
+	return (ice_peach & (uint32_t)bit) != 0;
+}
