+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000;
+}
+
+// ---- the command lines (piano's HidInput.h rules) ---------------------------------------------------------------------------
+bool space(char c) { return c == ' ' || c == '\t'; }
+const char *skip(const char *s) { while (space(*s)) { ++s; } return s; }
+
+// One hex field; false when s holds none or it is too long.
+bool
+hex(const char *&s, uint32_t *out)
+{
+	s = skip(s);
+	uint32_t v = 0;
+	unsigned digits = 0;
+	for (;; ++s) {
+		const char c = *s;
+		unsigned d;
+		if (c >= '0' && c <= '9') {
+			d = unsigned(c - '0');
+		} else if (c >= 'a' && c <= 'f') {
+			d = unsigned(c - 'a' + 10);
+		} else if (c >= 'A' && c <= 'F') {
+			d = unsigned(c - 'A' + 10);
+		} else {
+			break;
+		}
+		if (++digits > 8) {
+			return false;
+		}
+		v = v << 4 | d;
+	}
+	if (!digits || (*s && !space(*s))) {
+		return false;
+	}
+	*out = v;
+	return true;
+}
+
+enum class Op : uint8_t { bad, keyboard, consumer, release, status, pointer };
+
+struct Command {
+	Op op = Op::bad;
+	uint8_t keyboard[kKeyboardReportBytes] = {kReportKeyboard};
+	uint16_t usage = 0;
+	bool down = false;
+	uint8_t buttons = 0;               // the pointer's
+	uint16_t x = 0, y = 0;
+};
+
+Command
+parse(const char *line)
+{
+	Command c;
+	const char *s = skip(line);
+	const char verb = *s;
+	if (verb) {
+		++s;
+	}
+	if (verb && *s && !space(*s)) {
+		return c;
+	}
+	switch (verb) {
+	case 'K': {
+		uint32_t mods = 0;
+		if (!hex(s, &mods) || mods > 0xff) {
+			return c;
+		}
+		c.keyboard[1] = uint8_t(mods);
+		unsigned keys = 0;
+		while (*skip(s)) {
+			uint32_t usage = 0;
+			if (keys == 6 || !hex(s, &usage) || usage > 0xff) {
+				return c;
+			}
+			c.keyboard[3 + keys++] = uint8_t(usage);
+		}
+		c.op = Op::keyboard;
+		c.down = mods || keys;
+		return c;
+	}
+	case 'C': {
+		uint32_t usage = 0;
+		if (!hex(s, &usage) || usage > 0x3ff || *skip(s)) {
+			return c;
+		}
+		c.usage = uint16_t(usage);
+		c.op = Op::consumer;
+		c.down = usage != 0;
+		return c;
+	}
+	case 'A': {
+		uint32_t buttons = 0, x = 0, y = 0;
+		if (!hex(s, &buttons) || buttons > 7 || !hex(s, &x) || x > kPointerMax || !hex(s, &y) || y > kPointerMax || *skip(s)) {
+			return c;
+		}
+		c.buttons = uint8_t(buttons);
+		c.x = uint16_t(x);
+		c.y = uint16_t(y);
+		c.op = Op::pointer;
+		c.down = buttons != 0;
+		return c;
+	}
+	case 'R':
+	case '?':
+		if (!*skip(s)) {
+			c.op = verb == 'R' ? Op::release : Op::status;
+		}
+		return c;
+	default:
+		return c;
+	}
+}
+
+// ---- the registry below the device: who is on it -----------------------------------------------------------------------------
+// Counts the user clients below the device (the event service's and the device's own); with say, one line an entry.
+unsigned
+describe(IORegistryEntry *entry, unsigned depth, bool say, unsigned *lines)
+{
+	unsigned clients = 0;
+	if (depth > 4) {
+		return 0;
+	}
+	const bool client = entry->metaCast("IOUserClient") != nullptr;
+	if (client) {
+		clients++;
+	}
+	if (say && *lines < 16) {
+		OSObject *creator = client ? entry->copyProperty(kIOUserClientCreatorKey) : nullptr;
+		OSString *text = OSDynamicCast(OSString, creator);
+		IOLog("icehid: tree: %u %s%s%s\n", depth, entry->getMetaClass()->getClassName(), text ? ", " : "",
+		    text ? text->getCStringNoCopy() : "");
+		OSSafeReleaseNULL(creator);
+		++*lines;
+	}
+	if (OSIterator *it = entry->getChildIterator(gIOServicePlane)) {
+		while (OSObject *child = it->getNextObject()) {
+			if (IORegistryEntry *next = OSDynamicCast(IORegistryEntry, child)) {
+				clients += describe(next, depth + 1, say, lines);
+			}
+		}
+		it->release();
+	}
+	return clients;
+}
+
+unsigned
+clients(bool say)
+{
+	unsigned lines = 0;
+	return gDevice ? describe(gDevice, 0, say, &lines) : 0;
+}
